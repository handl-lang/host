--- stack — pure-handl implementation of the `stack` container ops.
---
--- A LIFO stack is a plain array; `push` appends to the back (the top).
--- `new`/`pop`/`peek` stay native ops (see `ops/collections/seq.rs`):
--- `new` is nullary and `pop`/`peek` must raise `collection is empty` on
--- an empty stack — the language has no error-raising primitive.
do {
  len_ :: xs ~> {
    while { xs: xs, n: 0 } {
      [xs, n] ~> match xs {
        []: { out: n },
        [h, ...t]: { state: { xs: t, n: n + 1 } }
      }
    }
  }

  {
    len: xs ~> len_(xs),
    is_empty: xs ~> match xs {
      []: true,
      [h, ...t]: false
    },
    push: [c, v] ~> [...c, v]
  }
}
