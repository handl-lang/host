--- list — the `list` container, written arrow-native.
---
--- This module follows the generic arrow calculus (ADR: "Generic Arrow
--- Calculus for Any Dimension", docs/adrs/): arrows are primitive, there
--- are no lambdas, and every construct below is a typed expression.
---
---   * `>>>` is the sole composition operator. `peek` and `pop` are not
---     written independently — they are literally `uncons >>> fst` and
---     `uncons >>> snd`, projections of the one decomposition arrow.
---   * `match` is the derived form of `|||` (Choice) with pattern
---     dispatch; record/`{}` literals are structural sugar over `arr`.
---   * `len` is a feedback region: `while` is the v0.1 surface sugar over
---     the kernel `Loop` primitive (Paterson's `loop`). The state record
---     `{ ys, n }` is the hidden feedback wire `S`; the count is the
---     exit wire.
---   * Signatures are graded arrows `A ~[G]~> B` (ADR-0102 surface).
---     Grades are optional annotations carried by algebraic structures,
---     not hard-coded language features. Two algebras are used here:
---       Total — the arrow never raises; composes as `Total >>> g = g`.
---       Pop n — consumes n cells off the front; composes as
---               `Pop n >>> Pop m = Pop (n + m)`.
---
--- `new`/`from`/`to_array` stay native (see `ops/collections/seq.rs`):
--- `new` is nullary and `from` is a reserved word (cannot be a record
--- field).
---
--- @example
--- `list.push([2, 3], 1)`  -- => [1, 2, 3]
--- `list.peek([1, 2, 3])`  -- => 1
--- `list.pop([1, 2, 3])`   -- => [2, 3]

--- The public surface — graded operation declarations.
--- The grade rides in the `~[r]~>` annotation: `Total` arrows never
--- raise; `Pop 1` consumes one cell off the front. Grades compose via
--- `>>>` per the selected algebra (`Pop 1 >>> Pop 1 = Pop 2`).

cap "list.len"
op "list.len" : List(T) ~[Total]~> Nat
  guarantee: true

cap "list.is_empty"
op "list.is_empty" : List(T) ~[Total]~> Bool
  guarantee: true

cap "list.push"
op "list.push" : (List(T), T) ~[Total]~> List(T)
  guarantee: true

cap "list.peek"
op "list.peek" : List(T) ~[Total]~> T
  guarantee: true

cap "list.pop"
op "list.pop" : List(T) ~[Pop 1]~> List(T)
  guarantee: true

--- uncons — the shared cell decomposition.
--- `List(T) ~[Pop 1]~> Pair(T, List(T))`: consumes one cell; raises
--- `collection is empty` when there is nothing to consume.
uncons_ :: xs ~> match xs {
  []: error.raise("collection is empty"),
  [h, ...t]: [h, t]
}

--- fst / snd — pair projections over the destructured cell.
fst_ :: [h, ...t] ~> h
snd_ :: [h, ...t] ~> t

--- len — the feedback region.
--- `List(T) ~[Total]~> Nat`
len_ :: xs ~> while { ys: xs, n: 0 } {
  [ys, n] ~> match ys {
    []: { out: n },
    [h, ...t]: { state: { ys: t, n: n + 1 } }
  }
}

--- The exported record — the module surface. Each field is an arrow;
--- the consuming ops compose the decomposition arrow rather than
--- repeating its empty-case.
do {
  {
    len: len_,
    is_empty: xs ~> match xs {
      []: true,
      [h, ...t]: false
    },
    push: [c, v] ~> [v, ...c],
    peek: uncons_ >>> fst_,
    pop: uncons_ >>> snd_
  }
}
