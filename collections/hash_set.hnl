--- hash_set -- the `hash_set` module contract.
---
--- All ops stay native (see `ops/collections/hash_set.rs`): membership is
--- keyed on a *serialized* value (`value_key`), which distinguishes `1`
--- from `1.0` and therefore differs from handl `==` (cross-numeric
--- equality). A pure-handl port would change `from`/`unique`/`union`/
--- `intersection`/`difference`/`symmetric_difference`/`without` dedup
--- semantics on mixed int/float inputs. `unique_by` additionally takes an
--- arrow argument, which cannot cross the `HandlFunction` boundary.
op "hash_set.new" : _ -> Array
op "hash_set.from" : Array -> Array
op "hash_set.to_array" : Array -> Array
op "hash_set.len" : Array -> Number
op "hash_set.is_empty" : Array -> Bool
op "hash_set.add" : (Array * Value) -> Array
op "hash_set.remove" : (Array * Value) -> Array
op "hash_set.has" : (Array * Value) -> Bool
op "hash_set.union" : (Array * Array) -> Array
op "hash_set.intersection" : (Array * Array) -> Array
op "hash_set.difference" : (Array * Array) -> Array
op "hash_set.unique" : Array -> Array
op "hash_set.symmetric_difference" : (Array * Array) -> Array
op "hash_set.without" : (Array * Value...) -> Array
op "hash_set.unique_by" : (Array * Fn) -> Array
