--- Split an array of `[a, b]` pairs into two arrays.
---
--- Returns `[as, bs]`. Elements that are not arrays with at least two
--- elements are skipped.
---
--- @example
--- `array.unzip([[1, "x"], [2, "y"]])`
--- -- => [[1, 2], ["x", "y"]]
---
from "./reverse.hnl" import * as reverse

export unzip<A,B>: List(Pair(A,B)) ~[Total]~> Pair(List(A), List(B)) := (xs) ~> do {
  fs :: [];
  gs :: [];
  for x in xs {
    do {
      match x {
        [f, s, ...rest]: do {
          fs = [f, ...fs];
          gs = [s, ...gs]
        },
        _: null
      }
    }
  };
  [reverse.reverse(fs), reverse.reverse(gs)]
}
