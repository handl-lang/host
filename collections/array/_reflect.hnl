--- Private reflection helpers shared by the `collections/array` modules.
---
--- Not part of the advertised package surface; imported via
--- `from "./_reflect.hnl" import * as _reflect`.
from "typeof" import * as typeof

export is_arr :: (x) ~> typeof.type_of(x) == "arr"

export is_obj :: (x) ~> typeof.type_of(x) == "obj"
