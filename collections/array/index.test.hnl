from "./index" import * as array

test_array_len := assert array.len([1, 2, 3]) = 3

test_array_len_empty := assert array.len([]) = 0

test_array_reverse := assert array.reverse([1, 2, 3]) = [3, 2, 1]

test_array_contains_true := assert array.contains(["a", "b", "c"], "b") = true

test_array_contains_false := assert array.contains(["a", "b", "c"], 2) = false

test_array_zip := assert array.zip([1, 2], ["x", "y", "z"]) = [[1, "x"], [2, "y"]]

test_array_concat := assert array.concat([1, 2], [3, 4]) = [1, 2, 3, 4]

test_array_last := assert array.last([1, 2, 3]) = 3

test_array_shift := assert array.shift([1, 2, 3]) = [2, 3]

test_array_prepend := assert array.prepend([1, 2], 0) = [0, 1, 2]

test_array_take := assert array.take([1, 2, 3, 4], 2) = [1, 2]

test_array_drop := assert array.drop([1, 2, 3, 4], 2) = [3, 4]

test_array_at := assert array.at([1, 2, 3], 2) = 3

test_array_at_out_of_bounds := assert array.at([1, 2, 3], 5) = null
