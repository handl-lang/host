from "./_reflect.hnl" import is_obj
from "./reverse.hnl" import reverse
from "hash_map" import get

--- Pick the value at `key` from each object element of `xs`.
---
--- For each element, returns `null` if it is not an object or lacks `key`.
---
--- @example
--- `array.pluck([{ name: "a" }, { name: "b" }, 7], "name")`
--- -- => ["a", "b", null]
---
export pluck<T>: (List(T), String) ~[1]~> List(T) := (xs, key) ~> do {
  out := []
  for x in xs {
    do {
      v := if is_obj(x) { get(x, key) } else { null }
      out := [v, ...out]
    }
  }
  reverse(out)
}
