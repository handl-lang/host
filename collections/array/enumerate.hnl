from "./reverse.hnl" import reverse

--- Pair each element of `xs` with its index.
---
--- Returns an array of `[index, value]` pairs.
---
--- @example
--- `array.enumerate(["a", "b"])`
--- -- => [[0, "a"], [1, "b"]]
---
export enumerate<T>: List(T) ~[Total]~> List(Pair(Nat, T)) := (xs) ~> do {
  out := []
  k := 0
  for x in xs {
    do {
      out := [[k, x], ...out]
      k := k + 1
    }
  }
  reverse(out)
}
