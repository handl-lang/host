from "./len.hnl" import len
from "./at.hnl" import at
from "./reverse.hnl" import reverse

--- Pair up the elements of two arrays.
---
--- Returns `[[a0, b0], [a1, b1], ...]`. The shorter array determines the length.
---
--- @example
--- `array.zip([1, 2], ["x", "y", "z"])`
--- -- => [[1, "x"], [2, "y"]]
---
export zip<A, B>: (List(A), List(B)) ~[1]~> List(Pair(A, B)) := (a, b) ~> do {
  blen := len(b)
  out := []
  k := 0
  for x in a {
    if k < blen { out := [[x, at(b, k)], ...out] };
    k := k + 1
  }
  reverse(out)
}
