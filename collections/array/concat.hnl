--- Concatenate two arrays into one.
---
--- Returns `[...a, ...b]`. The original arrays are unchanged.
---
--- @example
--- `array.concat([1, 2], [3, 4])`
--- -- => [1, 2, 3, 4]
---
export concat :: (a, b) ~> do {
  rev :: (ys) ~> do {
    r :: []
    for x in ys {
      r = [x, ...r]
    }
    r
  }
  r :: []
  for x in a {
    r = [x, ...r]
  }
  for y in b {
    r = [y, ...r]
  }
  rev(r)
}