--- Flatten a single level of nested arrays.
---
--- Each element of `xs` that is itself an array has its elements appended
--- directly; non-array elements are kept as-is.
---
--- @example
--- `array.flatten([[1, 2], 3, [4]])`
--- -- => [1, 2, 3, 4]
---
from "typeof" import * as typeof

export flatten :: (xs) ~> do {
  is_arr :: (x) ~> typeof.type_of(x) == "arr"
  cat :: (a, b) ~> do {
    r :: []
    for x in a {
      r = [x, ...r]
    }
    for y in b {
      r = [y, ...r]
    }
    out :: []
    for v in r {
      out = [v, ...out]
    }
    out
  }
  out :: []
  for x in xs {
    if is_arr(x) {
      out = cat(out, x)
    } else {
      out = cat(out, [x])
    }
  }
  out
}