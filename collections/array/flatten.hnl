--- Flatten a single level of nested arrays.
---
--- Each element of `xs` that is itself an array has its elements appended
--- directly; non-array elements are kept as-is.
---
--- @example
--- `array.flatten([[1, 2], 3, [4]])`
--- -- => [1, 2, 3, 4]
---
from "./_reflect.hnl" import is_arr
from "./concat.hnl" import concat

export flatten<T>: List(T) ~[1]~> List(T) := (xs) ~> do {
  out := []
  for x in xs {
    if is_arr(x) {
      out := concat(out, x)
    } else {
      out := concat(out, [x])
    }
  }
  out
}
