--- Flatten all levels of nesting in `xs`.
---
--- Recursively flattens nested arrays into a single flat array.
---
--- @example
--- `array.deep_flatten([[1, [2]], 3, [[[4]]]])`
--- -- => [1, 2, 3, 4]
---
from "./_reflect.hnl" import * as _reflect
from "./concat.hnl" import * as concat

export deep_flatten<T>: List(T) ~[Total]~> List(T) := (xs) ~> do {
  go :: (self, ys) ~> do {
    out :: []
    for x in ys {
      if _reflect.is_arr(x) {
        out = concat.concat(out, self(self, x))
      } else {
        out = concat.concat(out, [x])
      }
    }
    out
  }
  go(go, xs)
}
