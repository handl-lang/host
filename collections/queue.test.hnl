from "./queue.hnl" import * as queue

test_queue_len := assert queue.len([1, 2, 3]) = 3

test_queue_is_empty := assert queue.is_empty([]) = true

test_queue_enqueue := assert queue.enqueue([1, 2], 3) = [1, 2, 3]

test_queue_dequeue := assert queue.dequeue([1, 2, 3]) = [2, 3]

test_queue_peek := assert queue.peek([1, 2, 3]) = 1
