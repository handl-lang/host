--- vec -- pure-handl implementation of the `vec` container ops.
---
--- A vec is a plain array; `len`/`is_empty`/`push`/`pop`/`peek` are
--- expressible directly over array values. `pop`/`peek` raise
--- `collection is empty` on an empty vec via the `error.raise`
--- primitive (the ADR-0092 error-raising gap is closed). `new`/`from`/
--- `to_array` stay native (see `ops/collections/seq.rs`): `new` is
--- nullary and `from` is a reserved word (cannot be a record field).
do {
  len_ := xs ~> {
    while { xs: xs, n: 0 } {
      [xs, n]~> match xs {
        []: { out: n },
        [h, ...t]: { state: { xs: t, n: n + 1 } }
      }
    }
  }

  rev_ := xs ~> {
    while { xs: xs, acc: [] } {
      [xs, acc]~> match xs {
        []: { out: acc },
        [h, ...t]: { state: { xs: t, acc: [h, ...acc] } }
      }
    }
  }

  {
    len: xs ~> len_(xs),
    is_empty: xs ~> match xs {
      []: true,
      [h, ...t]: false
    },
    push: [c, v]~> [...c, v],
    pop: c ~> match c {
      []: error.raise("collection is empty"),
      [h, ...t]: match rev_(c) {
        []: [],
        [h2, ...t2]: rev_(t2)
      }
    },
    peek: c ~> match rev_(c) {
      []: error.raise("collection is empty"),
      [h, ...t]: h
    }
  }
}
