--- Peek at the front cell of `xs` without consuming the list.
---
--- Composes the shared cell decomposition: `uncons >>> fst`. Raises
--- `collection is empty` when `xs` is empty.
---
--- @example
--- `list.peek([1, 2, 3])`
--- -- => 1
---
-- TODO(n-dim): effect row
export peek<T>: List(T) ~[1]~> T := xs ~> match xs {
  []: error.raise("collection is empty"),
  [h, ...t]: h
}
