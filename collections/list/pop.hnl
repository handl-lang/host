--- Remove and return the front cell of `xs`, yielding the tail.
---
--- Composes the shared cell decomposition: `uncons >>> snd`. Raises
--- `collection is empty` when the list is empty.
---
--- @example
--- `list.pop([1, 2, 3])`
--- -- => [2, 3]
---
export pop<T>: List(T) ~[Pop 1]~> List(T) := xs ~> match xs {
  []: error.raise("collection is empty"),
  [h, ...t]: t
}
