--- list -- the `list` container, written arrow-native.
---
--- This module is an **aggregator**: each arrow lives in its own
--- `collections/list/<name>.hnl` file (one arrow per file, `export
--- <name><T>: Type ~> Grade := ...`, with its own doc comment).
--- This file imports them and assembles the `list.*` record the runtime
--- exposes.
---
--- This module follows the generic arrow calculus (ADR: "Generic Arrow
--- Calculus for Any Dimension", docs/adrs/): arrows are primitive, there
--- are no lambdas, and every construct below is a typed expression.
---
---   * `>>>` is the sole composition operator. `peek` and `pop` are not
---     written independently -- they are literally `uncons >>> fst` and
---     `uncons >>> snd`, projections of the one decomposition arrow.
---   * `match` is the derived form of `|||` (Choice) with pattern
---     dispatch; record/`{}` literals are structural sugar over `arr`.
---   * `len` is a feedback region: `while` is the v0.1 surface sugar over
---     the kernel `Loop` primitive (Paterson's `loop`). The state record
---     `{ ys, n }` is the hidden feedback wire `S`; the count is the
---     exit wire.
---   * Signatures are graded arrows `A ~[1]~> B` (ADR-0102 surface).
---     Grades are optional annotations carried by algebraic structures,
---     not hard-coded language features. Two algebras are used here:
---       Total -- the arrow never raises; composes as `Total >>> g := g`.
---       Pop n -- consumes n cells off the front; composes as
---               `Pop n >>> Pop m := Pop (n + m)`.
---
--- `new`/`from`/`to_array` stay native (see `ops/collections/seq.rs`):
--- `new` is nullary and `from` is a reserved word (cannot be a record
--- field).
---
--- @example
--- `list.push([2, 3], 1)`  -- => [1, 2, 3]
--- `list.peek([1, 2, 3])`  -- => 1
--- `list.pop([1, 2, 3])`   -- => [2, 3]

from "list_len" import len
from "list_is_empty" import is_empty
from "list_push" import push
from "list_peek" import peek
from "list_pop" import pop

{
  len: len,
  is_empty: is_empty,
  push: push,
  peek: peek,
  pop: pop
}
