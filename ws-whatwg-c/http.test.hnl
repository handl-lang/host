--- Tests for ws-whatwg-c/http -- the pure handshake helpers.
---
--- RFC 6455 section 1.3 accept-key vector, the upgrade-request wire
--- image, response-head parsing, the `\r\n\r\n` terminator scan, the
--- `ws://` URL reader, and the pure hex/base64 codecs.

from "./http" import * as http
from "bytes" import * as bytes

-- The exact request bytes for a known nonce.
test_upgrade_req := assert http.upgrade_req(
  { host: "127.0.0.1", port: 8080, path: "/chat" },
  "dGhlIHNhbXBsZSBub25jZQ==") = (
  "GET /chat HTTP/1.1\r\n" +
  "Host: 127.0.0.1:8080\r\n" +
  "Upgrade: websocket\r\n" +
  "Connection: Upgrade\r\n" +
  "Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n" +
  "Sec-WebSocket-Version: 13\r\n" +
  "\r\n"
)

-- RFC 6455 section 1.3: the sample nonce maps to this accept value.
test_accept_key_rfc := assert http.accept_key("dGhlIHNhbXBsZSBub25jZQ==") = "s3pPLMBiTxaQ9kYGzzhZRbK+xOo="

-- The same vector through the pure codec halves: sha1 hex decodes to
-- the 20 digest bytes that base64-encode to the accept value.
test_hex_decode := assert http.hex_decode(
  "b37a4f2cc0624f1690f64606cf385945b2bec4ea") = [
  179, 122, 79, 44, 192, 98, 79, 22, 144, 246, 70, 6, 207, 56, 89, 69,
  178, 190, 196, 234
]

test_b64_hello := assert http.b64_encode([72, 101, 108, 108, 111]) = "SGVsbG8="

test_b64_pad2 := assert http.b64_encode([72, 101, 108, 108]) = "SGVsbA=="

test_b64_pad1 := assert http.b64_encode([72, 101, 108]) = "SGVs"

test_b64_empty := assert http.b64_encode([]) = ""

test_parse_head := assert(do {
  p :: http.parse_head(
    "HTTP/1.1 101 Switching Protocols\r\n" +
    "Upgrade: websocket\r\n" +
    "Connection: Upgrade\r\n" +
    "Sec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\n" +
    "\r\n")
  { status: p.status,
    upgrade: http.header_get(p.headers, "Upgrade"),
    accept: http.header_get(p.headers, "sec-websocket-accept"),
    missing: http.header_get(p.headers, "x-nope") }
}) = { status: 101,
       upgrade: "websocket",
       accept: "s3pPLMBiTxaQ9kYGzzhZRbK+xOo=",
       missing: null }

test_parse_head_reject := assert(do {
  p :: http.parse_head("HTTP/1.1 403 Forbidden\r\nContent-Length: 0\r\n\r\n")
  p.status
}) = 403

test_head_end := assert http.head_end(bytes.utf8_encode("abc\r\n\r\nrest")) = 7

test_head_end_none := assert http.head_end(bytes.utf8_encode("abc\r\n\rX")) = (0 - 1)

test_parse_url_full := assert http.parse_url("ws://127.0.0.1:8080/chat") = {
  host: "127.0.0.1", port: 8080, path: "/chat"
}

test_parse_url_defaults := assert http.parse_url("ws://127.0.0.1") = {
  host: "127.0.0.1", port: 80, path: "/"
}

test_parse_url_root := assert http.parse_url("ws://10.0.0.2:90/") = {
  host: "10.0.0.2", port: 90, path: "/"
}

test_parse_url_wss := assert tag.tag_of(
  error.try((x) ~> http.parse_url("wss://127.0.0.1/"))) = "err"

test_parse_url_badport := assert tag.tag_of(
  error.try((x) ~> http.parse_url("ws://127.0.0.1:abc/"))) = "err"
