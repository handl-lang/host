--- ws-whatwg-c/server -- the `accept` half of a WebSocket server:
--- `listen` on an IPv4 socket, `accept` a TCP peer, and run the
--- server side of the RFC 6455 handshake.
---
--- @details
--- `listen` is a thin `socket`/`bind`/`listen` sequence over the
--- generated libc adapters (host must be an IPv4 literal -- the pure
--- `sockaddr_in` pack path, no DNS). `accept` takes the listening fd,
--- accepts one peer (blocking), reads its HTTP upgrade request head,
--- pulls out `Sec-WebSocket-Key`, answers with the `101` response
--- `http.build_101_resp` builds, and hands back a `Conn` with
--- `server: true` -- the flag that makes `send`/`close` emit unmasked
--- frames (RFC 6455 section 5.1: only clients mask).
---
--- TLS serving: `listen_tls` takes PEM certificate-chain and
--- private-key file paths, builds one server `SSL_CTX`
--- (`TLS_server_method` + the ctx-level cert/key loaders), and returns
--- a `Listener` record `{fd, ssl_ctx}` for `accept_tls`. The listener
--- owns the ctx -- accepted conns carry `ssl_ctx: null` so `conn.close`
--- releases only their session; `close_listener` frees the ctx and the
--- listen fd. `accept_tls` wraps the accepted fd in `SSL_new` +
--- `SSL_set_fd` + `SSL_accept` before the request head is read inside
--- the TLS channel -- after that, plain and TLS accepts share the same
--- upgrade-validation path (`accept_conn`).
---
--- All arrows are `~[1]~>`; every libc failure propagates its `err`
--- unchanged, and a request head that fails the upgrade validation
--- (non-`GET` method, no `Upgrade: websocket` header, `Connection`
--- lacking an `upgrade` token, no `Sec-WebSocket-Key`) maps to
--- `err(ECONNABORTED)` like a refused client handshake. TLS setup and
--- `SSL_accept` failures classify the same way, mirroring the client.
---
--- Blocking model: `accept` parks the caller in `accept(2)` and a
--- blocking head read -- the run-time is single-threaded, so a
--- listener can serve exactly one handshake at a time. Concurrency is
--- out of scope for v1 (see the `concurrent`/`concurrent-epoll`
--- packages for the cooperative scheduler this could slot into).

from "bytes" import * as bytes
from "str" import * as str
from "result" import { Result, ok, err }
from "ffi" import { Errno }
from "../generated/libc-c-linux-x86_64/socket" import * as socket
from "../generated/libc-c-linux-x86_64/unistd" import * as unistd
from "../generated/libc-c-linux-x86_64/errno" import * as errno
from "../generated/libssl-c-linux-x86_64/ssl" import * as ssl
from "./index" import { Conn, Listener }
from "./sockaddr" import * as sockaddr
from "./http" import * as http
from "./conn" import * as conn

--- listen -- create a listening TCP socket bound to `host:port`.
--- @param {host} - an IPv4 literal (`"0.0.0.0"`, `"127.0.0.1"`, ...)
--- @param {port} - the TCP port; 0 asks the kernel for a free one
---   (read it back with `socket.getsockname` + `sockaddr_out`)
--- @returns {Result<Int, Errno> - the listening fd, or the errno}
--- @details Pure pack path only -- a non-literal `host` raises in
--- `sockaddr_in`. `SO_REUSEADDR` is set before `bind` so a restarted
--- listener can retake its port while a peer lingers in TIME_WAIT.
--- Backlog is 128. On `setsockopt`/`bind`/`listen` failure the fd is
--- closed before the err propagates.
export listen: (String, Int) ~[1]~> Result<Int, Errno> := (host, port) ~> do {
  sa :: sockaddr.sockaddr_in(port, host)
  s :: socket.socket(socket.AF_INET, socket.SOCK_STREAM, 0)
  if tag.tag_of(s) == "err" {
    s
  } else {
    do {
      fd :: tag.untag(s).value
      o :: socket.setsockopt(
        fd, socket.SOL_SOCKET, socket.SO_REUSEADDR,
        bytes.from_list([1, 0, 0, 0]))
      if tag.tag_of(o) == "err" {
        do {
          dropped :: unistd.close(fd)
          o
        }
      } else {
        do {
          b :: socket.bind(fd, sa)
          if tag.tag_of(b) == "err" {
            do {
              dropped :: unistd.close(fd)
              b
            }
          } else {
            do {
              l :: socket.listen(fd, 128)
              if tag.tag_of(l) == "err" {
                do {
                  dropped :: unistd.close(fd)
                  l
                }
              } else {
                ok(fd)
              }
            }
          }
        }
      }
    }
  }
}

--- tls_server_ctx -- build the shared server `SSL_CTX` a `wss`
--- listener serves every session from: `TLS_server_method` ->
--- `SSL_CTX_new` -> `SSL_CTX_use_certificate_chain_file` ->
--- `SSL_CTX_use_PrivateKey_file` (PEM) -> `SSL_CTX_check_private_key`.
--- Any failing step frees the ctx built so far and propagates its
--- `err`; a non-1 success return maps to `err(ECONNABORTED)` like the
--- client's `ssl_wrap`.
--- @param {cert} - PEM certificate chain file path
--- @param {key} - PEM private key file path
--- @returns {Result<Value, Errno> - the SSL_CTX handle, or the errno}
export tls_server_ctx: (String, String) ~[1]~> Result<Value, Errno> := (cert, key) ~> do {
  m :: ssl.TLS_server_method()
  if tag.tag_of(m) == "err" {
    m
  } else {
    do {
      c :: ssl.SSL_CTX_new(tag.untag(m).value)
      if tag.tag_of(c) == "err" {
        c
      } else {
        do {
          ctx :: tag.untag(c).value
          cf :: ssl.SSL_CTX_use_certificate_chain_file(ctx, cert)
          if tag.tag_of(cf) == "err" {
            do {
              f :: ssl.SSL_CTX_free(ctx)
              cf
            }
          } else if tag.untag(cf).value != 1 {
            do {
              f :: ssl.SSL_CTX_free(ctx)
              err(errno.ECONNABORTED)
            }
          } else {
            do {
              kf :: ssl.SSL_CTX_use_PrivateKey_file(
                ctx, key, ssl.SSL_FILETYPE_PEM)
              if tag.tag_of(kf) == "err" {
                do {
                  f :: ssl.SSL_CTX_free(ctx)
                  kf
                }
              } else if tag.untag(kf).value != 1 {
                do {
                  f :: ssl.SSL_CTX_free(ctx)
                  err(errno.ECONNABORTED)
                }
              } else {
                do {
                  ck :: ssl.SSL_CTX_check_private_key(ctx)
                  if tag.tag_of(ck) == "err" {
                    do {
                      f :: ssl.SSL_CTX_free(ctx)
                      ck
                    }
                  } else if tag.untag(ck).value != 1 {
                    do {
                      f :: ssl.SSL_CTX_free(ctx)
                      err(errno.ECONNABORTED)
                    }
                  } else {
                    ok(ctx)
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

--- listen_tls -- `listen` plus a server `SSL_CTX`: binds `host:port`
--- exactly like `listen`, but returns a `Listener` record carrying the
--- fd and the ctx `accept_tls` creates sessions from. The ctx is
--- built first (it needs no socket); a `listen` failure frees it
--- before the err propagates.
--- @param {host} - an IPv4 literal (`"0.0.0.0"`, `"127.0.0.1"`, ...)
--- @param {port} - the TCP port; 0 asks the kernel for a free one
--- @param {cert} - PEM certificate chain file path
--- @param {key} - PEM private key file path
--- @returns {Result<Listener, Errno> - the listener, or the errno}
export listen_tls: (String, Int, String, String) ~[1]~> Result<Listener, Errno> := (host, port, cert, key) ~> do {
  c :: tls_server_ctx(cert, key)
  if tag.tag_of(c) == "err" {
    c
  } else {
    do {
      ctx :: tag.untag(c).value
      l :: listen(host, port)
      if tag.tag_of(l) == "err" {
        do {
          f :: ssl.SSL_CTX_free(ctx)
          l
        }
      } else {
        ok({ fd: tag.untag(l).value, ssl_ctx: ctx })
      }
    }
  }
}

--- close_listener -- release a `listen_tls` listener: `SSL_CTX_free`
--- the shared server ctx, then `close` the listen fd. Best-effort: the
--- ctx free runs even when the fd close fails, then the first `err`
--- propagates. Open conns must be `conn.close`d first -- their
--- sessions reference the shared ctx.
--- @param {listener} - a Listener from `listen_tls`
--- @returns {Result<Int, Errno> - the close result, or the first errno}
export close_listener: (Listener) ~[1]~> Result<Int, Errno> := (listener) ~> do {
  f :: ssl.SSL_CTX_free(listener.ssl_ctx)
  c :: unistd.close(listener.fd)
  if tag.tag_of(f) == "err" {
    f
  } else {
    c
  }
}

--- accept_fail -- teardown after a failed `accept`/`accept_tls` step:
--- `SSL_free` the session when one exists, then `close(fd)`. The
--- listener's shared ctx is never touched -- it outlives the failed
--- accept. Returns `e` unchanged.
--- @param {fd} - the accepted peer fd to close
--- @param {s} - the SSL session handle, or null
--- @param {e} - the Result to return after cleanup
accept_fail := (fd, s, e) ~> do {
  f :: if s == null { ok(null) } else { ssl.SSL_free(s) }
  dropped :: unistd.close(fd)
  e
}

--- accept_conn -- the post-`accept(2)` handshake both accept paths
--- share: read the request head (inside the TLS channel when `s` is a
--- session), validate the upgrade, write the `101`, return the Conn.
--- @param {fd} - the accepted peer fd
--- @param {s} - the negotiated SSL session, or null for plain `ws`
--- @returns {Result<Conn, Errno> - the server conn, or the errno}
accept_conn := (fd, s) ~> do {
  h :: conn.read_head_io(fd, s)
  if tag.tag_of(h) == "err" {
    accept_fail(fd, s, h)
  } else {
    do {
      hr :: tag.untag(h).value
      p :: http.parse_req_head(hr.head)
      up :: http.header_get(p.headers, "upgrade")
      conn_up :: http.header_has_token(p.headers, "connection", "upgrade")
      key :: http.header_get(p.headers, "sec-websocket-key")
      bad :: (p.method != "GET" ||
              up == null || str.lower(up) != "websocket" ||
              conn_up == false ||
              key == null)
      if bad {
        accept_fail(fd, s, err(errno.ECONNABORTED))
      } else {
        do {
          conn0 :: {
            fd: fd, rbuf: bytes.from_list([]),
            ssl: s, ssl_ctx: null, server: true }
          w :: conn.io_write_all(conn0, bytes.utf8_encode(http.build_101_resp(key)))
          if tag.tag_of(w) == "err" {
            accept_fail(fd, s, w)
          } else {
            ok({ ...conn0, rbuf: hr.rest })
          }
        }
      }
    }
  }
}

--- accept -- accept one peer on `listen_fd` and run the server half
--- of the RFC 6455 handshake: blocking `accept(2)`, the request head,
--- `Sec-WebSocket-Key`, then the `101` response. The returned `Conn`
--- has `server: true` and `rbuf` holding any frame bytes that
--- arrived with the request head.
--- @param {listen_fd} - a listening fd from `listen`
--- @returns {Result<Conn, Errno> - the server conn, or the errno}
--- @details The request head is validated as a WebSocket upgrade: a
--- `GET` request line, an `Upgrade: websocket` header (value compared
--- case-insensitively), a `Connection` token list containing `upgrade`,
--- and a present `Sec-WebSocket-Key`. Anything else maps to
--- `err(ECONNABORTED)` like a refused client handshake. On any failure
--- after `accept(2)` the peer fd is closed before propagating.
export accept: (Int) ~[1]~> Result<Conn, Errno> := (listen_fd) ~> do {
  a :: socket.accept(listen_fd)
  if tag.tag_of(a) == "err" {
    a
  } else {
    accept_conn(tag.untag(a).value.ret, null)
  }
}

--- accept_tls -- `accept` for a `listen_tls` listener: `accept(2)`,
--- then `SSL_new` over the shared ctx, `SSL_set_fd`, and a blocking
--- `SSL_accept` before the upgrade handshake runs inside the TLS
--- channel (`accept_conn`). The returned `Conn` has `ssl` set and
--- `ssl_ctx: null` -- the listener owns the shared ctx
--- (`close_listener` frees it), so `conn.close` releases only the
--- session.
--- @param {listener} - a Listener from `listen_tls`
--- @returns {Result<Conn, Errno> - the server conn, or the errno}
--- @details `SSL_accept` must return exactly 1; any other outcome --
--- and any `SSL_new`/`SSL_set_fd` failure -- maps to
--- `err(ECONNABORTED)` or propagates the adapter's `err`, mirroring
--- the client's `ssl_wrap`. On failure the session and peer fd are
--- released; the listener ctx is untouched.
export accept_tls: (Listener) ~[1]~> Result<Conn, Errno> := (listener) ~> do {
  a :: socket.accept(listener.fd)
  if tag.tag_of(a) == "err" {
    a
  } else {
    do {
      fd :: tag.untag(a).value.ret
      s :: ssl.SSL_new(listener.ssl_ctx)
      if tag.tag_of(s) == "err" {
        accept_fail(fd, null, s)
      } else {
        do {
          sv :: tag.untag(s).value
          sf :: ssl.SSL_set_fd(sv, fd)
          if tag.tag_of(sf) == "err" {
            accept_fail(fd, sv, sf)
          } else if tag.untag(sf).value <= 0 {
            accept_fail(fd, sv, err(errno.ECONNABORTED))
          } else {
            do {
              hs :: ssl.SSL_accept(sv)
              if tag.tag_of(hs) == "err" {
                accept_fail(fd, sv, hs)
              } else if tag.untag(hs).value != 1 {
                accept_fail(fd, sv, err(errno.ECONNABORTED))
              } else {
                accept_conn(fd, sv)
              }
            }
          }
        }
      }
    }
  }
}
