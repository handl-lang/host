--- type_model.hnl
---
--- ADR-0103: "The Kernel is the Evaluator, Not the Calculus".
---
--- This is the *type model* — the HoTT interpretation of the arrow-calculus
--- tags as type/proof judgments. It is Handl code (data) compiled to bytecode
--- and run on the VM; the kernel runs models, models are data. This file is
--- data that the kernel evaluates, exactly like `arrow_model.hnl`.
---
--- Homotopy Type Theory (HoTT) is the semantic foundation of the type model:
---   - Types are spaces (fibrant types, universes).
---   - Values are points (inhabitants of a space).
---   - Equality is paths (`Path a b` is the identity type `Id_A(a, b)`).
---   - Equivalence is bijection + paths.
---   - Rewrites are 2-cells.
---   - Refinement is a proposition over a type.
---   - Grades are coeffects.
---
--- The type model doesn't "also handle HoTT" — it *is* the HoTT
--- interpretation. Every `Term` tag is read as a type/proof judgment, not as
--- an executable combinator (that is `arrow_model.hnl`'s job). The host
--- serializes a `Term` as a JSON object and invokes `run(term, incoming,
--- ctx)`; `incoming` is the type being synthesized / the ambient type
--- context. Implemented cases recurse via an explicit `self` parameter
--- (the standard Handl recursion pattern), so the model is itself a
--- first-class, serializable arrow.
---
--- Tag interpretations (type/proof judgments):
---   `Arr`        — constant type: the value IS the type (in HoTT, types are
---                  values), so the type of a pure value is the value itself.
---   `Const`      — constant type (alias of `Arr`).
---   `Seq`        — type composition: the composite type `b ∘ a`
---                  (`compose_type`).
---   `First`      — act on the first component of a pair type, threading the
---                  second (type-level `first`).
---   `Choice`     — sum type: tagged union of the two branch types
---                  (`sum_type`).
---   `Loop`       — fixpoint type: the type of the loop body's fixpoint.
---   `App`        — type-level application: dependent function application
---                  of the callee type to the evaluated argument types.
---   `Handle`     — handler type installation: push the handler type onto
---                  the context stack, evaluate the body type, attach the
---                  effect row.
---   `Op`         — graded operation signature: the type of an operation is
---                  its graded signature (name + argument types), unless a
---                  handler is in scope, in which case the handler's type is
---                  used.
---   `Iter`       — iteration type: the state type carried by the iteration.
---   `Child`      — TypeError: AST recursion is the exec model's job, not
---                  the type model's.
---   `Rewrite`    — evaluate the target: rewrites are 2-cells, so the type
---                  of a rewrite is the type of its target.
---   `Path`       — identity type `Id_A(a, b)` (`identity_type`).
---   `Equiv`      — equivalence type: a proposition (Bool) witnessing that
---                  `a ≃ b` (`equivalence_type`).
---   `Refine`     — subtype / refinement: a proposition over a type; yields
---                  the incoming type when the predicate holds
---                  (`refine_type`).
---   `Cobind`     — graded type (coeffect): attach the `__coeffects__` field
---                  to the body type (`graded_type`).
---   `Univalence` — univalence axiom: produce a `Path` from an `Equiv`.
---   `Glue`       — glue a family along a path: returns the family type.
---   `Fibrant`    — fibrant replacement: returns the base type.
---   `JElim`      — J-elimination: path-based motive dispatch.
---   `Src`        — source face of a 2-cell type.
---   `Tgt`        — target face of a 2-cell type.
---   `CellId`     — identity cell: source = target = the arrow (the arrow
---                  itself).
---   `CellCompV`  — vertical composition of 2-cells.
---   `Whisker`    — whiskering of a 2-cell by an arrow.
---   `RecordProj` — record type field projection.
---   `RecordWith` — record type field update.
---   `Tag`        — tagged type construction: wrap the evaluated value with
---                  the `__tag__` field.
---
--- This module depends on the host `tag` capability and on the runtime
--- `hash_map`, `array`, and `typeof` modules.

do {
  --- tget: field access with a null default (total projection).
  --- Used everywhere the ADR spec writes `getfield(term, "field")`.
  tget :: [obj, key] ~> hash_map.get(obj, key, null)

  --- is_obj: true iff `v` is a runtime object (hash map) value.
  is_obj :: v ~> if typeof.type_of(v) == "obj" { true } else { false }

  --- is_pair: true iff `v` is a serialized pair (`__pair__` marker).
  is_pair :: v ~> if is_obj(v) {
    if hash_map.get_or(v, "__pair__", null) != null { true } else { false }
  } else {
    false
  }

  --- pair_fst / pair_snd: destructure a serialized pair.
  pair_fst :: v ~> array.first(hash_map.get_or(v, "__pair__", []))
  pair_snd :: v ~> array.at(hash_map.get_or(v, "__pair__", []), 1)

  --- is_either: true iff `v` is a serialized Either (`__either__` marker).
  is_either :: v ~> if is_obj(v) {
    if hash_map.get_or(v, "__either__", null) != null { true } else { false }
  } else {
    false
  }

  --- either_value: the carried value of an Either.
  either_value :: v ~> hash_map.get_or(v, "value", null)

  --- pair: construct a serialized pair.
  pair :: [a, b] ~> hash_map.set({}, "__pair__", [a, b])

  --- arrow_compose: build a tagged `Arrow` cell from two sub-arrows.
  --- Used by 2-cell whiskering to compose faces.
  arrow_compose :: [a, b] ~> tag.tag("Arrow", hash_map.set(hash_map.set({}, "first", a), "second", b))

  --- eval_args: evaluate a list of argument sub-terms against `incoming`
  --- and `ctx`, collecting the results. A `while` fold over the remaining
  --- args, threading an accumulator.
  eval_args :: [self, args, incoming, ctx] ~> while { result: [], remaining: args } {
    [state] ~> if array.is_empty(state.remaining) {
      { out: state.result }
    } else {
      do {
        head_val :: self(self, array.first(state.remaining), incoming, ctx)
        { state: { result: [...state.result, head_val], remaining: array.drop(state.remaining, 1) } }
      }
    }
  }

  --- grades_overlap: true iff any grade in `glist` appears in `inc_grades`.
  --- Used by handler dispatch to match an operation's incoming grades
  --- against a handler's declared grades (coeffect grading).
  grades_overlap :: [glist, inc_grades] ~> while glist {
    xs ~> if array.is_empty(xs) {
      { out: false }
    } else {
      if array.contains(inc_grades, array.first(xs)) {
        { out: true }
      } else {
        { state: array.drop(xs, 1) }
      }
    }
  }

  --- handler_matches: true iff handler `h` implements `op_name` and its
  --- grades overlap with the incoming value's grades.
  handler_matches :: [h, op_name, incoming] ~> do {
    impls :: hash_map.get_or(h, "impls", {})
    has_op :: if is_obj(impls) { hash_map.has(impls, op_name) } else { false }
    if has_op {
      inc_grades :: if is_obj(incoming) { hash_map.get_or(incoming, "grades", []) } else { [] }
      h_grades :: hash_map.get_or(h, "grades", [])
      grades_overlap(h_grades, inc_grades)
    } else {
      false
    }
  }

  --- find_handler: walk the handler stack (innermost-first) and return the
  --- first handler implementation matching `op_name` and the incoming
  --- grades, or null if none matches.
  find_handler :: [stack, op_name, incoming] ~> while stack {
    xs ~> if array.is_empty(xs) {
      { out: null }
    } else {
      do {
        h :: array.first(xs)
        if handler_matches(h, op_name, incoming) {
          { out: hash_map.get(hash_map.get_or(h, "impls", {}), op_name, null) }
        } else {
          { state: array.drop(xs, 1) }
        }
      }
    }
  }

  --- compose_type: type composition. The composite type `b ∘ a` — in HoTT
  --- this is function composition at the type level. If `b` is a
  --- type-level function (a value of function kind), apply it to `a`'s
  --- result; otherwise construct a tagged composite type. (Returns b
  --- applied to a's result.)
  compose_type :: [a, b] ~> if typeof.type_of(b) == "fn" {
    b(a)
  } else {
    tag.tag("Compose", hash_map.set(hash_map.set({}, "fst", a), "snd", b))
  }

  --- sum_type: sum type construction (tagged union). The type of a
  --- `Choice` is the coproduct of the two branch types: `l + r`.
  sum_type :: [l, r] ~> tag.tag("Sum", hash_map.set(hash_map.set({}, "left", l), "right", r))

  --- identity_type: the identity type `Id_A(a, b)`. In HoTT, `Path a b` is
  --- the identity type family; the type model constructs a `Path`-tagged
  --- type witnessing that `from` and `to` are equal points.
  identity_type :: [frm, to] ~> tag.tag("Path", hash_map.set(hash_map.set({}, "from", frm), "to", to))

  --- equivalence_type: the equivalence type. An equivalence `a ≃ b` is a
  --- proposition (bijection + paths), so its type is `Bool` carrying the
  --- propositional witness `a == b`.
  equivalence_type :: [a, b] ~> tag.tag("type.bool", hash_map.set({}, "value", a == b))

  --- refine_type: refinement type (subtype). A refinement is a proposition
  --- over a type: when the predicate holds, the incoming type is the
  --- refined type; otherwise it is a type error.
  refine_type :: [predicate, incoming] ~> if predicate {
    incoming
  } else {
    tag.tag("TypeError", hash_map.set({}, "message", "Refine: predicate not satisfied"))
  }

  --- graded_type: graded type with coeffects. Attaches the `__coeffects__`
  --- field (the grade) to the body type, recording the coeffect grading of
  --- the type. In HoTT, grades are coeffects.
  graded_type :: [body, grd] ~> do {
    base :: if is_obj(body) { body } else { hash_map.set({}, "__type__", body) }
    hash_map.set(base, "__coeffects__", [hash_map.set({}, "grade", grd)])
  }

  --- transport: HoTT transport along a path. Maps a value of type A to a
  --- value of type B along a path `p : A = B`. If `path` is a `Path`-tagged
  --- value, transport carries `value` to the `to` endpoint; otherwise the
  --- value is unchanged (reflexivity).
  transport :: [path, value] ~> if is_obj(path) {
    if hash_map.get_or(path, "__tag__", "") == "Path" {
      hash_map.get_or(path, "to", value)
    } else {
      value
    }
  } else {
    value
  }

  --- ====================================================================
  --- Judgment-level HoTT operations
  --- ====================================================================
  ---
  --- These are the judgment-level HoTT operations needed by the typecheck
  --- driver (typecheck_model.hnl). They operate on type values (tagged
  --- objects) and metavariables, providing the HoTT semantics for
  --- unification (path equality), dependent type construction, equality
  --- types, universe management, and membership.
  ---
  --- Metavariables are serialized as `{__meta__: <id>}` objects. The
  --- `metas` array is a solution table indexed by meta id.

  --- is_meta: true iff `v` is a metavariable (`__meta__` marker only).
  is_meta :: v ~> if is_obj(v) {
    if hash_map.has(v, "__meta__") {
      if array.len(hash_map.keys(v)) == 1 { true } else { false }
    } else {
      false
    }
  } else {
    false
  }

  --- meta_id: extract the id of a metavariable.
  meta_id :: v ~> hash_map.get_or(v, "__meta__", 0)

  --- meta_value: construct a metavariable with the given id.
  meta_value :: id ~> hash_map.set({}, "__meta__", id)

  --- metas_solve: solve metavariable `id` with value `val` in the metas
  --- array. Returns a new metas array with the solution at index `id`.
  metas_solve :: [metas, id, val] ~> while { result: [], idx: 0 } {
    [state] ~> if state.idx >= array.len(metas) {
      { out: state.result }
    } else {
      do {
        new_val :: if state.idx == id { val } else { array.at(metas, state.idx) }
        { state: { result: [...state.result, new_val], idx: state.idx + 1 } }
      }
    }
  }

  --- metas_lookup: look up the solution for metavariable `id`.
  --- Returns null if no solution is recorded.
  metas_lookup :: [metas, id] ~> if id < array.len(metas) {
    array.at(metas, id)
  } else {
    null
  }

  --- occurs_in: true iff metavariable `target_id` occurs in `v`. This
  --- is the occurs check for metavariable solving — it prevents
  --- infinite solutions like `?x := f(?x)`.
  occurs_in :: [target_id, v] ~> if is_meta(v) {
    meta_id(v) == target_id
  } else {
    if is_obj(v) {
      while { found: false, remaining: hash_map.values(v) } {
        [state] ~> if state.found {
          { out: true }
        } else {
          if array.is_empty(state.remaining) {
            { out: false }
          } else {
            do {
              head_val :: array.first(state.remaining)
              if occurs_in(target_id, head_val) {
                { out: true }
              } else {
                { state: { found: false, remaining: array.drop(state.remaining, 1) } }
              }
            }
          }
        }
      }
    } else {
      if typeof.type_of(v) == "arr" {
        while { found: false, remaining: v } {
          [state] ~> if state.found {
            { out: true }
          } else {
            if array.is_empty(state.remaining) {
              { out: false }
            } else {
              do {
                head_val :: array.first(state.remaining)
                if occurs_in(target_id, head_val) {
                  { out: true }
                } else {
                  { state: { found: false, remaining: array.drop(state.remaining, 1) } }
                }
              }
            }
          }
        }
      } else {
        false
      }
    }
  }

  --- type_tag: extract the `__tag__` field of a value, or "" if the
  --- value is not an object.
  type_tag :: v ~> if is_obj(v) { hash_map.get_or(v, "__tag__", "") } else { "" }

  --- unify_fields: recursively unify the fields of two same-tagged
  --- objects. Skips structural keys (`__tag__`, `__registry__`,
  --- `body_closure`). Returns `{ok, metas, path}` — a Path witness on
  --- success.
  unify_fields :: [self, a, b, metas, keys] ~> if array.is_empty(keys) {
    { ok: true, metas: metas, path: tag.tag("Path", hash_map.set(hash_map.set({}, "from", a), "to", b)) }
  } else {
    do {
      key :: array.first(keys)
      rest_keys :: array.drop(keys, 1)
      is_structural :: key == "__tag__" || key == "__registry__" || key == "body_closure"
      if is_structural {
        unify_fields(self, a, b, metas, rest_keys)
      } else {
        do {
          val_a :: hash_map.get_or(a, key, null)
          val_b :: hash_map.get_or(b, key, null)
          result :: self(self, val_a, val_b, metas)
          if result.ok {
            unify_fields(self, a, b, result.metas, rest_keys)
          } else {
            { ok: false, metas: metas, path: null }
          }
        }
      }
    }
  }

  --- unify_: the recursive HoTT unification engine.
  ---
  --- HoTT unification is path equality: `unify(a, b)` tries to construct
  --- a `Path_A(a, b)` witness. If `a == b` (definitional equality), the
  --- path is reflexivity. If one side is a metavariable, it is solved
  --- (with an occurs check). If both sides are same-tagged objects,
  --- their fields are unified recursively. Otherwise, unification fails
  --- (the path is deferred — there is no decidable structural equality
  --- in HoTT, only path equality).
  unify_ :: [self, a, b, metas] ~> if a == b {
    { ok: true, metas: metas, path: tag.tag("Path", hash_map.set(hash_map.set({}, "from", a), "to", b)) }
  } else {
    if is_meta(a) {
      do {
        a_id :: meta_id(a)
        if occurs_in(a_id, b) {
          { ok: false, metas: metas, path: null }
        } else {
          { ok: true, metas: metas_solve(metas, a_id, b), path: tag.tag("Path", hash_map.set(hash_map.set({}, "from", a), "to", b)) }
        }
      }
    } else {
      if is_meta(b) {
        do {
          b_id :: meta_id(b)
          if occurs_in(b_id, a) {
            { ok: false, metas: metas, path: null }
          } else {
            { ok: true, metas: metas_solve(metas, b_id, a), path: tag.tag("Path", hash_map.set(hash_map.set({}, "from", a), "to", b)) }
          }
        }
      } else {
        do {
          tag_a :: type_tag(a)
          tag_b :: type_tag(b)
          if tag_a != "" && tag_a == tag_b {
            unify_fields(self, a, b, metas, hash_map.keys(a))
          } else {
            { ok: false, metas: metas, path: null }
          }
        }
      }
    }
  }

  --- unify: HoTT path-equality unification. Try to construct a
  --- `Path_A(a, b)` witness. Returns `{ok, metas, path}` where `ok` is
  --- true iff the path was constructed (reflexivity, meta-solving, or
  --- recursive field unification). This is NOT structural decidable
  --- equality — it is path equality in the HoTT sense.
  unify :: [a, b, metas] ~> unify_(unify_, a, b, metas)

  --- construct_pi: construct a dependent function type `Pi(x:A, B(x))`.
  --- Takes a domain type `A` and a codomain `B`. If `B` is a runtime
  --- function, the Pi type is truly dependent (the codomain depends on
  --- the argument); otherwise it is a non-dependent function type. In
  --- HoTT, `Pi(x:A, B(x))` is the type of dependent functions (the
  --- dependent product).
  construct_pi :: [domain, codomain] ~> tag.tag("type.pi", hash_map.set(hash_map.set({}, "param", domain), "body", codomain))

  --- pi_apply: apply a Pi-type to an argument. If the codomain is a
  --- runtime function (dependent case), substitute the argument by
  --- application; otherwise return the codomain unchanged
  --- (non-dependent case). This is the elimination rule for Pi types.
  pi_apply :: [pi_type, arg] ~> do {
    codomain :: hash_map.get_or(pi_type, "body", null)
    if typeof.type_of(codomain) == "fn" {
      codomain(arg)
    } else {
      codomain
    }
  }

  --- construct_sigma: construct a dependent pair type
  --- `Sigma(x:A, B(x))`. Takes a domain type `A` and a codomain `B`.
  --- In HoTT, `Sigma(x:A, B(x))` is the type of dependent pairs (the
  --- dependent sum) — the first component has type `A`, and the second
  --- component has type `B(first)`.
  construct_sigma :: [domain, codomain] ~> tag.tag("type.sigma", hash_map.set(hash_map.set({}, "param", domain), "body", codomain))

  --- construct_forall: construct a forall type `Forall(x:K, B(x))`.
  --- Takes a kind `K` (the kind of the type parameter) and a codomain
  --- `B`. In HoTT, `Forall` is parametric polymorphism — the parameter
  --- is a type, not a value. This mirrors `Pi` but at the type level.
  construct_forall :: [kind, codomain] ~> tag.tag("type.forall", hash_map.set(hash_map.set({}, "kind", kind), "body", codomain))

  --- forall_apply: instantiate a Forall type with a type argument.
  --- If the codomain is a runtime function, substitute by application;
  --- otherwise return the codomain unchanged. This is the elimination
  --- rule for Forall types (type application).
  forall_apply :: [forall_type, arg] ~> do {
    codomain :: hash_map.get_or(forall_type, "body", null)
    if typeof.type_of(codomain) == "fn" {
      codomain(arg)
    } else {
      codomain
    }
  }

  --- construct_vau: construct a vau (fexpr) type `Vau(x:A, B(x))`.
  --- Like Pi but the parameter is NOT evaluated before substitution
  --- (call-by-name). In HoTT, this is a non-evaluating dependent
  --- function type — the argument is passed unevaluated.
  construct_vau :: [domain, codomain] ~> tag.tag("type.vau", hash_map.set(hash_map.set({}, "param", domain), "body", codomain))

  --- vau_apply: apply a Vau-type to an argument. Mirrors `pi_apply` —
  --- if the codomain is a runtime function, substitute by application;
  --- otherwise return the codomain unchanged.
  vau_apply :: [vau_type, arg] ~> do {
    codomain :: hash_map.get_or(vau_type, "body", null)
    if typeof.type_of(codomain) == "fn" {
      codomain(arg)
    } else {
      codomain
    }
  }

  --- construct_eq: construct an identity type `Id_A(a, b)`. In HoTT,
  --- the identity type is the type of paths between `a` and `b`. It is
  --- inhabited (by `refl`) iff `a` and `b` are definitionally equal.
  --- This is the propositional equality, not the judgmental equality.
  construct_eq :: [lhs, rhs] ~> tag.tag("type.eq", hash_map.set(hash_map.set({}, "left", lhs), "right", rhs))

  --- construct_empty: construct the empty type (contradiction / False).
  --- In HoTT, the empty type is uninhabited — it has no constructors.
  --- It is used as the result when equality or membership fails.
  construct_empty :: unit ~> tag.tag("type.empty", {})

  --- check_refl: check if `refl` is a valid proof of the identity type.
  --- Returns `type.refl` if `left == right` (reflexivity holds — the
  --- two sides are definitionally equal); otherwise returns
  --- `type.empty` (reflexivity cannot be proven — the sides differ).
  check_refl :: [eq_type] ~> do {
    lhs :: hash_map.get_or(eq_type, "left", null)
    rhs :: hash_map.get_or(eq_type, "right", null)
    if lhs == rhs {
      tag.tag("type.refl", {})
    } else {
      tag.tag("type.empty", {})
    }
  }

  --- eq_reduce: reduce an identity type `Id_A(a, b)`. If `a == b`
  --- (definitional equality), returns `type.refl` (the inhabited case
  --- — the identity type is provable by reflexivity). Otherwise returns
  --- `type.empty` (the uninhabited case — the identity type is empty,
  --- no proof exists). This is the computation rule for identity types.
  eq_reduce :: [eq_type] ~> do {
    lhs :: hash_map.get_or(eq_type, "left", null)
    rhs :: hash_map.get_or(eq_type, "right", null)
    if lhs == rhs {
      tag.tag("type.refl", {})
    } else {
      tag.tag("type.empty", {})
    }
  }

  --- construct_universe: construct a universe type `Type_n`. The
  --- universe `Type_n` is the type of all types at level < n. The
  --- cumulative hierarchy is `Type_0 ⊆ Type_1 ⊆ ...` (universe
  --- cumulativity, ADR-0054). The level is a natural number.
  construct_universe :: [level] ~> tag.tag("type.universe", hash_map.set({}, "level", level))

  --- universe_level: extract the universe level of a type value. For a
  --- `type.universe` value, returns its `level` field. For other type
  --- values (base types like `type.number`), returns 0 (base types
  --- live in `Type_0`).
  universe_level :: [type_val] ~> if type_tag(type_val) == "type.universe" {
    hash_map.get_or(type_val, "level", 0)
  } else {
    0
  }

  --- universe_max: compute the max of two universe levels. Used by
  --- Pi/Sigma rules to compute the result universe as
  --- `max(param_universe, body_universe)` — the dependent product lives
  --- in the larger of the two universes.
  universe_max :: [level_a, level_b] ~> if level_a > level_b { level_a } else { level_b }

  --- construct_membership: construct a membership type
  --- `value ∈ collection`. In HoTT, this is the proposition that
  --- `value` is a member of the collection type. The collection is a
  --- tagged type value (e.g. `type.number`, `type.string`).
  construct_membership :: [value, collection] ~> tag.tag("type.membership", hash_map.set(hash_map.set({}, "value", value), "collection", collection))

  --- is_marshalable: check if a type is FFI-marshalable (can cross the
  --- foreign function interface). Returns true for primitive FFI types
  --- (cstr, i32, i64, f64, buf, ptr, void, handle); false otherwise.
  --- Non-marshalable types cannot be used in foreign function
  --- signatures.
  is_marshalable :: [type_val] ~> do {
    tag_name :: type_tag(type_val)
    match tag_name {
      "type.cstr": true,
      "type.i32": true,
      "type.i64": true,
      "type.f64": true,
      "type.buf": true,
      "type.ptr": true,
      "type.void": true,
      "type.handle": true,
      _: false
    }
  }

  --- run_: the recursive HoTT type-model interpreter.
  ---
  --- Dispatches on `term.__tag__`, interpreting each tag as a type/proof
  --- judgment under HoTT semantics. The HoTT-specific tags (`Path`,
  --- `Equiv`, `Refine`, `Cobind`, `Univalence`, `Glue`, `Fibrant`,
  --- `JElim`) and the 2-cell tags (`Src`, `Tgt`, `CellId`, `CellCompV`,
  --- `Whisker`) mirror the existing Rust typechecker arms; the core
  --- arrow-calculus tags are read as type-level constructions
  --- (`compose_type`, `sum_type`, fixpoint type, dependent application,
  --- graded signature). Recursion is explicit via the `self` parameter
  --- (the standard Handl recursion pattern), keeping the model point-free
  --- and serializable.
  run_ :: [self, term, incoming, ctx] ~> match tget(term, "__tag__") {
    "Arr": tget(term, "value"),
    "Const": tget(term, "value"),
    "Seq": compose_type(
      self(self, tget(term, "fst"), incoming, ctx),
      self(self, tget(term, "snd"), incoming, ctx)
    ),
    "First": pair(
      self(self, tget(term, "inner"), pair_fst(incoming), ctx),
      pair_snd(incoming)
    ),
    "Choice": sum_type(
      self(self, tget(term, "l"), incoming, ctx),
      self(self, tget(term, "r"), incoming, ctx)
    ),
    "Loop": while { state: incoming, count: 0 } {
      [state, count] ~> if count > 100000 {
        { out: tag.tag("TypeError", hash_map.set({}, "message", "Loop: exceeded max iterations")) }
      } else {
        do {
          body_val :: self(self, tget(term, "body"), state, ctx)
          if is_pair(body_val) {
            { out: pair_fst(body_val) }
          } else {
            if is_either(body_val) {
              if hash_map.get_or(body_val, "__either__", "") == "left" {
                { out: either_value(body_val) }
              } else {
                { state: { state: either_value(body_val), count: count + 1 } }
              }
            } else {
              { out: tag.tag("TypeError", hash_map.set({}, "message", "Loop: body did not return a pair or Either")) }
            }
          }
        }
      }
    },
    "App": do {
      callee_val :: self(self, tget(term, "callee"), incoming, ctx)
      arg_vals :: eval_args(self, tget(term, "args"), incoming, ctx)
      match arg_vals {
        []: callee_val(),
        [a]: callee_val(a),
        [a, b]: callee_val(a, b),
        [a, b, c]: callee_val(a, b, c),
        _: tag.tag("TypeError", hash_map.set({}, "message", "App: too many arguments"))
      }
    },
    "Iter": do {
      fuel_val :: self(self, tget(term, "fuel"), incoming, ctx)
      init_val :: self(self, tget(term, "initial"), incoming, ctx)
      while { fuel: fuel_val, value: init_val } {
        [fuel, value] ~> if fuel <= 0 {
          { out: value }
        } else {
          do {
            pred_val :: self(self, tget(term, "predicate"), value, ctx)
            if pred_val {
              step_val :: self(self, tget(term, "step"), value, ctx)
              { state: { fuel: fuel - 1, value: step_val } }
            } else {
              { out: value }
            }
          }
        }
      }
    },
    "Child": tag.tag("TypeError", hash_map.set({}, "message", "Child: AST recursion is the exec model's job, not the type model's")),
    "Handle": do {
      handler_val :: self(self, tget(term, "impl_"), incoming, ctx)
      new_stack :: array.concat(hash_map.get_or(ctx, "handler_stack", []), [handler_val])
      new_ctx :: hash_map.set(ctx, "handler_stack", new_stack)
      body_val :: self(self, tget(term, "body"), incoming, new_ctx)
      if is_obj(body_val) {
        hash_map.set(body_val, "effects", hash_map.get_or(handler_val, "grades", []))
      } else {
        body_val
      }
    },
    "Rewrite": self(self, tget(term, "target"), incoming, ctx),
    "Path": identity_type(
      self(self, tget(term, "from"), incoming, ctx),
      self(self, tget(term, "to"), incoming, ctx)
    ),
    "Equiv": equivalence_type(
      self(self, tget(term, "a"), incoming, ctx),
      self(self, tget(term, "b"), incoming, ctx)
    ),
    "Refine": refine_type(
      self(self, tget(term, "predicate"), incoming, ctx),
      incoming
    ),
    "Cobind": graded_type(
      self(self, tget(term, "body"), incoming, ctx),
      tget(term, "grade")
    ),
    "Src": do {
      cell_val :: self(self, tget(term, "cell"), incoming, ctx)
      if is_obj(cell_val) { hash_map.get_or(cell_val, "__src__", cell_val) } else { cell_val }
    },
    "Tgt": do {
      cell_val :: self(self, tget(term, "cell"), incoming, ctx)
      if is_obj(cell_val) { hash_map.get_or(cell_val, "__tgt__", cell_val) } else { cell_val }
    },
    "CellId": do {
      arrow_val :: self(self, tget(term, "arrow"), incoming, ctx)
      tag.tag("Cell2", hash_map.set(hash_map.set(hash_map.set({}, "__src__", arrow_val), "__tgt__", arrow_val), "value", arrow_val))
    },
    "CellCompV": do {
      first_val :: self(self, tget(term, "first"), incoming, ctx)
      second_val :: self(self, tget(term, "second"), incoming, ctx)
      src :: if is_obj(first_val) { hash_map.get_or(first_val, "__src__", first_val) } else { first_val }
      tgt :: if is_obj(second_val) { hash_map.get_or(second_val, "__tgt__", second_val) } else { second_val }
      value :: if is_obj(second_val) { hash_map.get_or(second_val, "value", second_val) } else { second_val }
      tag.tag("Cell2", hash_map.set(hash_map.set(hash_map.set({}, "__src__", src), "__tgt__", tgt), "value", value))
    },
    "Whisker": do {
      arrow_val :: self(self, tget(term, "arrow"), incoming, ctx)
      cell_val :: self(self, tget(term, "cell"), incoming, ctx)
      src :: if is_obj(cell_val) { hash_map.get_or(cell_val, "__src__", cell_val) } else { cell_val }
      tgt :: if is_obj(cell_val) { hash_map.get_or(cell_val, "__tgt__", cell_val) } else { cell_val }
      value :: if is_obj(cell_val) { hash_map.get_or(cell_val, "value", cell_val) } else { cell_val }
      new_src :: if tget(term, "side") == "Right" {
        arrow_compose(src, arrow_val)
      } else {
        arrow_compose(arrow_val, src)
      }
      new_tgt :: if tget(term, "side") == "Right" {
        arrow_compose(tgt, arrow_val)
      } else {
        arrow_compose(arrow_val, tgt)
      }
      tag.tag("Cell2", hash_map.set(hash_map.set(hash_map.set({}, "__src__", new_src), "__tgt__", new_tgt), "value", value))
    },
    "Univalence": do {
      equiv_val :: self(self, tget(term, "equiv"), incoming, ctx)
      if is_obj(equiv_val) {
        if hash_map.get_or(equiv_val, "__tag__", "") == "Equiv" {
          tag.tag("Path", hash_map.set(
            hash_map.set(
              hash_map.set({}, "a", hash_map.get_or(equiv_val, "a", null)),
              "b",
              hash_map.get_or(equiv_val, "b", null)
            ),
            "path",
            hash_map.get_or(equiv_val, "path", null)
          ))
        } else {
          equiv_val
        }
      } else {
        equiv_val
      }
    },
    "Glue": do {
      path_val :: self(self, tget(term, "path"), incoming, ctx)
      family_val :: self(self, tget(term, "family"), incoming, ctx)
      family_val
    },
    "Fibrant": do {
      family_val :: self(self, tget(term, "family"), incoming, ctx)
      base_val :: self(self, tget(term, "base"), incoming, ctx)
      base_val
    },
    "JElim": do {
      path_val :: self(self, tget(term, "path"), incoming, ctx)
      base_val :: self(self, tget(term, "base"), incoming, ctx)
      path_tag :: if is_obj(path_val) { hash_map.get_or(path_val, "__tag__", "") } else { "" }
      if path_tag == "Path" {
        self(self, tget(term, "motive"), base_val, ctx)
      } else {
        if path_tag == "Rewrite" {
          self(self, tget(term, "motive"), base_val, ctx)
        } else {
          base_val
        }
      }
    },
    "RecordProj": do {
      record_val :: self(self, tget(term, "record"), incoming, ctx)
      if is_obj(record_val) {
        hash_map.get_or(record_val, tget(term, "field"), null)
      } else {
        null
      }
    },
    "RecordWith": do {
      record_val :: self(self, tget(term, "record"), incoming, ctx)
      value_val :: self(self, tget(term, "value"), incoming, ctx)
      base :: if is_obj(record_val) { record_val } else { {} }
      hash_map.set(base, tget(term, "field"), value_val)
    },
    "Tag": tag.tag(tget(term, "tag"), self(self, tget(term, "value"), incoming, ctx)),
    "Op": do {
      arg_vals :: eval_args(self, tget(term, "args"), incoming, ctx)
      op_name :: tget(term, "name")
      handler_impl :: find_handler(hash_map.get_or(ctx, "handler_stack", []), op_name, incoming)
      if handler_impl != null {
        do {
          handler_in :: if array.len(arg_vals) == 0 {
            incoming
          } else {
            hash_map.set({}, "__pair__", [incoming, arg_vals])
          }
          handler_term :: hash_map.set(hash_map.get_or(handler_impl, "Op", handler_impl), "__tag__", "Op")
          self(self, handler_term, handler_in, ctx)
        }
      } else {
        tag.tag("OpSig", hash_map.set(hash_map.set({}, "name", op_name), "args", arg_vals))
      }
    },
    _: tag.tag("TypeError", hash_map.set({}, "message", "unknown tag: " + tget(term, "__tag__")))
  }

  {
    run: [term, incoming, ctx] ~> run_(run_, term, incoming, ctx),
    unify: [a, b, metas] ~> unify_(unify_, a, b, metas),
    construct_pi: construct_pi,
    pi_apply: pi_apply,
    construct_sigma: construct_sigma,
    construct_forall: construct_forall,
    forall_apply: forall_apply,
    construct_vau: construct_vau,
    vau_apply: vau_apply,
    construct_eq: construct_eq,
    construct_empty: construct_empty,
    check_refl: check_refl,
    eq_reduce: eq_reduce,
    construct_universe: construct_universe,
    universe_level: universe_level,
    universe_max: universe_max,
    construct_membership: construct_membership,
    is_marshalable: is_marshalable
  }
}
