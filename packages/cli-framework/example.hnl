verbose_flag = {
  name: "verbose",
  short: "v",
  description: "Enable verbose output",
  default: "false",
  required: false
};

output_flag = {
  name: "output",
  short: "o",
  description: "Output file path",
  default: "stdout",
  required: false
};

config_flag = {
  name: "config",
  short: "c",
  description: "Path to config file",
  default: ".handl.toml",
  required: false
};

build_cmd = {
  name: "build",
  description: "Build the project",
  flags: [verbose_flag, output_flag, config_flag],
  subcommands: [],
  handler: "build"
};

init_cmd = {
  name: "init",
  description: "Initialize a new project",
  flags: [config_flag],
  subcommands: [],
  handler: "init"
};

test_cmd = {
  name: "test",
  description: "Run tests",
  flags: [verbose_flag],
  subcommands: [],
  handler: "test"
};

root_cmd = {
  name: "hnl",
  description: "handl language CLI tool",
  flags: [verbose_flag, config_flag],
  subcommands: [build_cmd, init_cmd, test_cmd],
  handler: ""
};

usage_text = str.concat("Usage: ", str.concat(root_cmd.name, " [options] <command>"));

help_text =
  usage_text
  |> (s) -> str.concat(s, "\n\n")
  |> (s) -> str.concat(s, str.concat(root_cmd.description, "\n\nOptions:\n"))
  |> (s) -> str.concat(s, "  --verbose, -v    Enable verbose output (default: false)\n")
  |> (s) -> str.concat(s, "  --config, -c     Path to config file (default: .handl.toml)\n")
  |> (s) -> str.concat(s, "\nCommands:\n")
  |> (s) -> str.concat(s, "  build    Build the project\n")
  |> (s) -> str.concat(s, "  init     Initialize a new project\n")
  |> (s) -> str.concat(s, "  test     Run tests");

help_text
