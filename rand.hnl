--- rand.int — generate a random integer. rand.int(max) or rand.int(min, max).
--- rand.float — generate a random float in [0, 1). rand.float(max) or rand.float(min, max).
--- rand.bool — generate a random boolean.
--- rand.pick — pick a random element from an array.
--- rand.choice — choose count elements from an array (with replacement).
--- rand.sample — sample count elements from an array (without replacement).
--- rand.shuffle — shuffle an array in random order.
--- rand.weighted_pick — pick an element from items using corresponding weights.
--- rand.string — generate a random string of given length from a charset.
--- rand.bytes — generate an array of random bytes (0-255) of given length.
--- rand.uuid — generate a version-4 UUID string.
--- rand.gauss — generate a random float from a Gaussian distribution with given mean and stddev.
--- rand.exponential — generate a random float from an exponential distribution with given lambda.
--- rand.poisson — generate a random integer from a Poisson distribution with given lambda.
--- rand.binomial — generate a random integer from a binomial distribution with n trials and probability p.
--- rand.perlin_1d — compute Perlin noise for a 1D coordinate.
--- rand.perlin_2d — compute Perlin noise for a 2D coordinate.
--- rand.perlin_3d — compute Perlin noise for a 3D coordinate.
--- rand.simplex_2d — compute simplex noise for a 2D coordinate.
--- rand.simplex_3d — compute simplex noise for a 3D coordinate.
--- rand.seeded_int — generate a seeded random integer. Deterministic for same seed + args.
--- rand.seeded_float — generate a seeded random float. Deterministic for same seed + args.
--- rand.seeded_bool — generate a seeded random boolean. Deterministic for same seed.
--- rand.seeded_pick — pick a seeded random element from an array. Deterministic.
--- rand.seeded_choice — choose seeded count elements from an array (with replacement). Deterministic.
--- rand.seeded_sample — sample seeded count elements from an array (without replacement). Deterministic.
--- rand.seeded_shuffle — shuffle an array with a seeded RNG. Deterministic.
--- rand.seeded_string — generate a seeded random string. Deterministic.
--- rand.seeded_gauss — generate a seeded random float from a Gaussian distribution. Deterministic.
---
--- Laws use the `Pred` vocabulary of `plugin-ext-refinement`
--- (True/False/Sorted/LengthEq/LengthLe/AllSatisfy/Le/HeadOf/
--- LengthPlusOne/LengthSubOne/IsPerm/IsSuccess/IsError, &&, ||, ==>,
--- forall). Two recurring properties are NOT expressible in that
--- vocabulary yet and are stated as `-- LAW:` comments:
---
---   IsString(output)   output is a string          (no type predicate)
---   Deterministic      same seed + same args ⇒ same output, for every
---                      `rand.seeded_*` op           (needs a `data Pred`
---                      refactor — tracked in project/BACKLOG.md)
---
--- All unseeded ops are effectful (each call draws fresh entropy), so every
--- op sits behind a `cap` declaration (ADR-0055). Seeded ops are pure
--- functions of (seed, args) but share the same capability boundary.
cap "rand.int"
cap "rand.float"
cap "rand.bool"
cap "rand.pick"
cap "rand.choice"
cap "rand.sample"
cap "rand.shuffle"
cap "rand.weighted_pick"
cap "rand.string"
cap "rand.bytes"
cap "rand.uuid"
cap "rand.gauss"
cap "rand.exponential"
cap "rand.poisson"
cap "rand.binomial"
cap "rand.perlin_1d"
cap "rand.perlin_2d"
cap "rand.perlin_3d"
cap "rand.simplex_2d"
cap "rand.simplex_3d"
cap "rand.seeded_int"
cap "rand.seeded_float"
cap "rand.seeded_bool"
cap "rand.seeded_pick"
cap "rand.seeded_choice"
cap "rand.seeded_sample"
cap "rand.seeded_shuffle"
cap "rand.seeded_string"
cap "rand.seeded_gauss"
op "rand.int" : Value... -> Number
  guarantee: True
op "rand.float" : Value... -> Number
-- LAW: Le(0, output) for the nullary form (output in [0, 1)); the
-- ranged forms may legitimately return negatives, so the weakest uniform
-- bound is True.
  guarantee: True
op "rand.bool" : () -> Bool
  guarantee: True
op "rand.pick" : Array -> Value
-- LAW: output is an element of input (IsElem not in the Pred vocabulary).
  guarantee: True
op "rand.choice" : (Array, Number) -> Array
-- LAW: LengthEq(output, input.1) — count elements drawn. Not expressible:
-- input.1 is a count, not a list, and LengthEq compares list lengths.
  guarantee: True
op "rand.sample" : (Array, Number) -> Array
-- LAW: output contains distinct elements of input.0; LengthLe(output, input.0)
-- (cannot sample more than the population without replacement).
  guarantee: LengthLe(output, input.0)
op "rand.shuffle" : Array -> Array
-- LAW: IsPerm(output, input) && LengthEq(output, input)
  guarantee: LengthEq(output, input) && IsPerm(output, input)
op "rand.weighted_pick" : (Array, Array) -> Value
-- LAW: output is an element of input.0 (IsElem not in the Pred vocabulary).
  guarantee: True
op "rand.string" : Value... -> String
-- LAW: IsString(output) — no type predicate in the Pred vocabulary.
  guarantee: True
op "rand.bytes" : Number -> Array
-- LAW: every element of output is an integer in [0, 255]
-- (AllSatisfy needs a named element predicate not in the vocabulary).
  guarantee: True
op "rand.uuid" : () -> String
-- LAW: IsString(output) && IsUuidV4(output) — neither is in the Pred vocabulary.
  guarantee: True
op "rand.gauss" : (Number, Number) -> Number
  guarantee: True
op "rand.exponential" : Number -> Number
-- LAW: output >= 0 for lambda > 0.
  guarantee: Le(0, output)
op "rand.poisson" : Number -> Number
  guarantee: Le(0, output)
op "rand.binomial" : (Number, Number) -> Number
-- LAW: output <= input.0 (at most n successes in n trials).
  guarantee: Le(0, output)
op "rand.perlin_1d" : Number -> Number
-- LAW: Deterministic — same input ⇒ same output (fixed permutation table).
-- LAW: -1 <= output && output <= 1 — range bound not expressible (Le is
-- only defined over variable names, and a two-sided bound needs Ge).
  guarantee: True
op "rand.perlin_2d" : (Number, Number) -> Number
-- LAW: Deterministic — same input ⇒ same output (fixed permutation table).
-- LAW: -1 <= output && output <= 1 (see perlin_1d).
  guarantee: True
op "rand.perlin_3d" : (Number, Number, Number) -> Number
-- LAW: Deterministic — same input ⇒ same output (fixed permutation table).
-- LAW: -1 <= output && output <= 1 (see perlin_1d).
  guarantee: True
op "rand.simplex_2d" : (Number, Number) -> Number
-- LAW: Deterministic — same input ⇒ same output (fixed permutation table).
-- LAW: -1 <= output && output <= 1 (see perlin_1d).
  guarantee: True
op "rand.simplex_3d" : (Number, Number, Number) -> Number
-- LAW: Deterministic — same input ⇒ same output (fixed permutation table).
-- LAW: -1 <= output && output <= 1 (see perlin_1d).
  guarantee: True
op "rand.seeded_int" : (Number, Number, Number) -> Number
-- LAW: Deterministic — same seed + args ⇒ same output.
-- LAW: output is in [input.1, input.2] — interval membership not expressible.
  guarantee: True
op "rand.seeded_float" : (Number, Number, Number) -> Number
-- LAW: Deterministic — same seed + args ⇒ same output.
-- LAW: output is in [input.1, input.2) — interval membership not expressible.
  guarantee: True
op "rand.seeded_bool" : Number -> Bool
-- LAW: Deterministic — same seed ⇒ same output.
  guarantee: True
op "rand.seeded_pick" : (Number, Array) -> Value
-- LAW: Deterministic — same seed + args ⇒ same output.
-- LAW: output is an element of input.1 (IsElem not in the Pred vocabulary).
  guarantee: True
op "rand.seeded_choice" : (Number, Array, Number) -> Array
-- LAW: Deterministic — same seed + args ⇒ same output.
-- LAW: LengthEq(output, input.2) — see rand.choice (count arg, not a list).
  guarantee: True
op "rand.seeded_sample" : (Number, Array, Number) -> Array
-- LAW: Deterministic — same seed + args ⇒ same output.
  guarantee: LengthLe(output, input.1)
op "rand.seeded_shuffle" : (Number, Array) -> Array
-- LAW: Deterministic — same seed + args ⇒ same output.
  guarantee: LengthEq(output, input.1) && IsPerm(output, input.1)
op "rand.seeded_string" : (Number, Number) -> String
-- LAW: Deterministic — same seed + args ⇒ same output.
-- LAW: IsString(output) — no type predicate in the Pred vocabulary.
  guarantee: True
op "rand.seeded_gauss" : (Number, Number, Number) -> Number
-- LAW: Deterministic — same seed + args ⇒ same output.
  guarantee: True

handl "rand.int" = rust_rand_int
handl "rand.float" = rust_rand_float
handl "rand.bool" = rust_rand_bool
handl "rand.pick" = rust_rand_pick
handl "rand.choice" = rust_rand_choice
handl "rand.sample" = rust_rand_sample
handl "rand.shuffle" = rust_rand_shuffle
handl "rand.weighted_pick" = rust_rand_weighted_pick
handl "rand.string" = rust_rand_string
handl "rand.bytes" = rust_rand_bytes
handl "rand.uuid" = rust_rand_uuid
handl "rand.gauss" = rust_rand_gauss
handl "rand.exponential" = rust_rand_exponential
handl "rand.poisson" = rust_rand_poisson
handl "rand.binomial" = rust_rand_binomial
handl "rand.perlin_1d" = rust_rand_perlin_1d
handl "rand.perlin_2d" = rust_rand_perlin_2d
handl "rand.perlin_3d" = rust_rand_perlin_3d
handl "rand.simplex_2d" = rust_rand_simplex_2d
handl "rand.simplex_3d" = rust_rand_simplex_3d
handl "rand.seeded_int" = rust_rand_seeded_int
handl "rand.seeded_float" = rust_rand_seeded_float
handl "rand.seeded_bool" = rust_rand_seeded_bool
handl "rand.seeded_pick" = rust_rand_seeded_pick
handl "rand.seeded_choice" = rust_rand_seeded_choice
handl "rand.seeded_sample" = rust_rand_seeded_sample
handl "rand.seeded_shuffle" = rust_rand_seeded_shuffle
handl "rand.seeded_string" = rust_rand_seeded_string
handl "rand.seeded_gauss" = rust_rand_seeded_gauss
