--- Pure-handl assertion helpers (ADR-0092).
---
--- All helpers build `ok`/`err` result values directly; they do not use
--- the engine's `assert` keyword and never raise.

from "serialize" import { serialize }

cap "assert.equal"
cap "assert.not_equal"
cap "assert.true"
cap "assert.false"
cap "assert.contains"

op "assert.equal" : (Value, Value) -> Value

op "assert.not_equal" : (Value, Value) -> Value

op "assert.true" : Value -> Value

op "assert.false" : Value -> Value

op "assert.contains" : (Array, Value) -> Value

{
  equal: [a, b] ~> if a == b {
    tag.tag("ok", { value: b })
  } else {
    tag.tag("err", { value: {
      message: "assertion failed: " + serialize(a, "json") + " != " + serialize(b, "json"),
      assertion: "equal",
      expected: serialize(b, "json"),
      actual: serialize(a, "json")
    }})
  },

  not_equal: [a, b] ~> if a != b {
    tag.tag("ok", { value: b })
  } else {
    tag.tag("err", { value: {
      message: "assertion failed: " + serialize(a, "json") + " == " + serialize(b, "json"),
      assertion: "not_equal",
      expected: "values to differ",
      actual: serialize(a, "json")
    }})
  },

  "true": x ~> if x == true {
    tag.tag("ok", { value: x })
  } else {
    tag.tag("err", { value: {
      message: "assertion failed: expected true",
      assertion: "true",
      actual: serialize(x, "json")
    }})
  },

  "false": x ~> if x == false {
    tag.tag("ok", { value: x })
  } else {
    tag.tag("err", { value: {
      message: "assertion failed: expected false",
      assertion: "false",
      actual: serialize(x, "json")
    }})
  },

  contains: [xs, x] ~> if array.contains(xs, x) {
    tag.tag("ok", { value: x })
  } else {
    tag.tag("err", { value: {
      message: "assertion failed: " + serialize(x, "json") + " not in " + serialize(xs, "json"),
      assertion: "contains",
      expected: serialize(x, "json"),
      actual: serialize(xs, "json")
    }})
  }
}