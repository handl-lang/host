--- Test framework — suite execution (ADR-0092).
---
--- `test.run` executes an array of test cases and returns a report.
--- Each case is `{ name, body, args? }`; the body is a function value
--- and must return a non-`err` value to pass.  An `err`-tagged result
--- is treated as a failure and its payload is serialized into the
--- `error` field.

from "serialize" import { serialize }

cap "test.run"

op "test.run" : Array -> Value

handl "test.run" = run

do {
  run_case :: [c, t, i, results, passed, failed] ~> {
    name :: if c.name == null { "case " + type.to_string(i) } else { c.name }
    body :: c.body
    args :: if c.args == null { [] } else { c.args }
    result :: combinators.apply(body, args)
    pass :: tag.tag_of(result) != "err"
    error :: if pass { null } else { serialize(tag.untag(result).value, "json") }
    new_results :: [...results, { name: name, pass: pass, error: error }]
    new_passed :: if pass { passed + 1 } else { passed }
    new_failed :: if pass { failed } else { failed + 1 }
    { state: {
      xs: t,
      i: i + 1,
      results: new_results,
      passed: new_passed,
      failed: new_failed
    }}
  }

  {
    run: [suite] ~> {
      while { xs: suite, i: 0, results: [], passed: 0, failed: 0 } {
        [xs, i, results, passed, failed] ~> match xs {
          []: { out: {
            total: passed + failed,
            passed: passed,
            failed: failed,
            results: results
          }},
          [c, ...t]: run_case(c, t, i, results, passed, failed)
        }
      }
    }
  }
}