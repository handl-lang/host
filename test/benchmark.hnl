--- Benchmarking (ADR-0092).
---
--- `benchmark.run` runs the function `iterations` times and reports
--- elapsed wall-clock time in milliseconds.

from "serialize" import { serialize }

cap "benchmark.run"

op "benchmark.run" : (Function, Number, Array) -> Value

handle "benchmark.run" with run

{
  run: [f, iterations, args] ~> {
    inputs :: if args == null { [] } else { args }
    if iterations <= 0 {
      tag.tag("err", { value: { message: "iterations must be positive" } })
    } else {
      start :: time.instant_ns()
      last :: while { i: 0, r: null } {
        [i, r] ~> if i == iterations {
          { out: r }
        } else {
          { state: { i: i + 1, r: combinators.apply(f, inputs) } }
        }
      }
      end :: time.instant_ns()
      total_ms :: (end - start) / 1000000.0
      if tag.tag_of(last) == "err" {
        tag.tag("err", { value: {
          message: "benchmark function failed",
          cause: serialize(tag.untag(last).value, "json")
        }})
      } else {
        {
          iterations: iterations,
          total_ms: total_ms,
          mean_ms: total_ms / iterations,
          result: last
        }
      }
    }
  }
}