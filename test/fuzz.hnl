--- Fuzz testing (ADR-0092).
---
--- `fuzz.run` invokes the function `count` times with random inputs.
--- Functions should return an `err`-tagged result on failure; the
--- report counts `err` results and records the first failure payload.

cap "fuzz.run"

op "fuzz.run" : (Function, Number, Number) -> Value

handl "fuzz.run" = run

do {
  generate_inputs :: [f, s, i] ~> {
    while { j: 0, acc: [] } {
      [j, acc] ~> if j == array.len(f.params) {
        { out: acc }
      } else {
        { state: {
          j: j + 1,
          acc: [...acc, rand.seeded_float(s + i * 1000 + j, 0, 1)]
        }}
      }
    }
  }

  {
    run: [f, count, seed] ~> {
      s :: if seed == null { 0 } else { seed }
      if count <= 0 {
        tag.tag("err", { value: { message: "count must be positive" } })
      } else {
        while { i: 0, failures: 0, first_error: null } {
          [i, failures, first_error] ~> {
            inputs :: generate_inputs(f, s, i)
            r :: combinators.apply(f, inputs)
            is_err :: tag.tag_of(r) == "err"
            new_failures :: if is_err { failures + 1 } else { failures }
            new_first :: if is_err {
              if first_error == null { json.stringify(tag.untag(r).value) } else { first_error }
            } else {
              first_error
            }
            if i == count {
              { out: { runs: count, failures: new_failures, first_error: new_first } }
            } else {
              { state: { i: i + 1, failures: new_failures, first_error: new_first } }
            }
          }
        }
      }
    }
  }
}
