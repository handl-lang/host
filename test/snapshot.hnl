--- Snapshot formatting and matching (ADR-0092).
---
--- `snapshot.format` serializes a value to JSON; `snapshot.match`
--- compares an actual value to an expected snapshot and returns an
--- `ok` result on a match or an `err` result describing the mismatch.

from "serialize" import { serialize }

cap "snapshot.format"
cap "snapshot.match"

op "snapshot.format" : Value -> String

op "snapshot.match" : (String, Value, Value) -> Value

handle "snapshot.format" with format
handle "snapshot.match" with match

{
  format: [v] ~> serialize(v, "json"),

  match: [name, actual, expected] ~> if actual == expected {
    tag.tag("ok", { value: true })
  } else {
    tag.tag("err", { value: {
      message: "snapshot " + name + " mismatch",
      assertion: "snapshot",
      expected: serialize(expected, "json"),
      actual: serialize(actual, "json")
    }})
  }
}