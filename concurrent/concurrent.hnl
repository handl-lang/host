--- concurrent -- cooperative concurrency contract (step-arrow model).
---
--- Non-determinism is externalized to the event stream (ADR-0072): the
--- graph is deterministic dataflow, and which events arrive is the
--- scheduler's input. A `Task` is an arrow `S ~> Step` — a
--- defunctionalized state machine whose state `S` is a user record
--- carried between invocations. `Step` is the free-algebra node:
---
---   { state: S }             -- runnable: re-invoke the task with S
---   { out: V }               -- finished with result V
---   { call: Op, state: S }   -- request Op; resume with S.result = R
---
--- `{call}` is the suspension point: `state` is the continuation input
--- (the task's `k` as data, per Sanada's free-A-algebra reading) and
--- `name` selects the request. A backend scheduler resolves ops inline
--- (channels, atomics, spawn) or parks the task on fd readiness
--- (epoll), a timer deadline, or another task's completion.
---
--- ## Op vocabulary (`name` selects; other fields are per-op args)
---
---   scheduling
---     { name: "yield" }                        -- requeue, resume null
---     { name: "spawn", task, init, token? }    -- resume task id (Int)
---     { name: "await", task }                  -- resume task's result V
---     { name: "await_timeout", task, ms }      -- resume { done: V } | { timeout: task }
---     { name: "sleep", ms }                    -- resume null after ms
---     { name: "enter", arrow, init }           -- run arrow as a sub-task; its { out: v }
---                                            -- resumes the caller's state with result v
---
---   channels (cap 0 = rendezvous; cap n = bounded queue)
---     { name: "chan_new", cap }                -- resume chan id
---     { name: "chan_send", chan, value }       -- resume { sent: true }
---     { name: "chan_recv", chan }              -- resume the value
---     { name: "chan_select", chans: [id] }     -- resume { chan: id, value: v }
---
---   synchronization (cooperative: no preemption inside a step)
---     { name: "mutex_new" }                    -- resume mutex id
---     { name: "mutex_lock", mutex }            -- resume { acquired: true }
---     { name: "mutex_unlock", mutex }          -- resume { released: true }
---     { name: "rwlock_new" }                   -- resume rwlock id
---     { name: "read_lock", rwlock }            -- resume { acquired: true }
---     { name: "write_lock", rwlock }           -- resume { acquired: true }
---     { name: "rw_unlock", rwlock }            -- resume { released: true }
---     { name: "sem_new", n }                   -- resume sem id
---     { name: "sem_acquire", sem }             -- resume { acquired: true }
---     { name: "sem_release", sem }             -- resume { released: true }
---     { name: "atomic_new", value }            -- resume atomic id
---     { name: "atomic_read", atomic }          -- resume value
---     { name: "atomic_write", atomic, value }  -- resume previous value
---     { name: "atomic_cas", atomic, expect, value }
---                                            -- resume Bool
---
---   cancellation
---     { name: "token_new" }                    -- resume token id
---     { name: "cancel", token }                -- resume { cancelled: true }
---     { name: "cancelled", token }             -- resume Bool
---   A task spawned with `token` finishes early with result
---   { cancelled: true } if the token is set before its next step.
---
---   nonblocking fd I/O (fds must be O_NONBLOCK; see tcp_* helpers)
---     { name: "recv", fd }                     -- resume Bytes | { err: errno }
---     { name: "send", fd, buf }                -- resume { sent: n } | { err: errno }
---     { name: "accept", fd }                   -- resume conn fd | { err: errno }
---     { name: "connect_wait", fd }             -- resume { err: 0|errno }
---     { name: "close", fd }                    -- resume null
---
--- `~[1]~>` on `Run` marks scheduling as effectful: backends reach the
--- OS through ffi (epoll, sockets, clocks).

export Task := (Value) ~> Value

--- A backend's entry point: drive `task(init)` and every spawned
--- descendant to completion. Returns `{ main: v, results: [{id, v}] }`
--- on success or `{ deadlock: [id] }` when live tasks can never wake.
export Run := (Task, Value) ~[1]~> Value

--- A finished task runs to its result: running `(s) ~> { out: v }`
--- hands `v` back as the main result. Quantified over backends so any
--- conforming scheduler can be checked against it.
export run_done := (run: Run) ~> (v) ~> hash_map.get_or(
  run((s) ~> { out: v }, null), "main", null) ~[2]~> (v) ~> v
