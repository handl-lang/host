--- Axioms and laws for the string library.
---
--- This is the abstraction contract for `str`: the irreducible interface that
--- every implementation (the FFI `str` in `utils/str.hnl`, the pure-handl
  --- `str-handl/str-handl.hnl`, or any future backend) must satisfy. It carries
--- real semantic content so the inference engine can derive non-trivial
--- guarantees — length preservation, length bounds, idempotence, monotonicity
--- — rather than just `True`.
---
--- Types are symbolic: `String` and `Float` are treated as type variables by
--- the contract parser (only `Int`, `Bool`, and `List T` are base types).
--- Char length is counted in Unicode scalar values, matching the FFI
--- semantics in `plugin-lib-utils/src/str/ops.rs`.
---
--- Predicate vocabulary available to the contract engine today:
---   LengthEq(a, b)   |a| = |b|            LengthLe(a, b)   |a| <= |b|
---   LengthPlusOne    |a| = |b| + 1        LengthSubOne      |a| = |b| - 1
---   Le(a, b)         a <= b               IsPerm(a, b)      a permutes b
---   AllSatisfy(l, p) forall x in l, p(x)  True / False
---   &&  ||  ==>  (parens for grouping)
---
--- The ideal str-specific predicates (IsUpper, IsTrimmed, IsEmpty, IsPrefix,
  --- NoOccurrence, IsSlug, IsReversed, EditDistance, Similarity, CountEq,
  --- CharEq, LengthGe) are documented inline as the intended laws but cannot be
--- expressed yet — they require extending `Pred` in `plugin-ext-refinement`.
--- Each such law is written as a `-- LAW:` comment; the `guarantee:` line
--- states the strongest *parseable* approximation.

-- ---------------------------------------------------------------------------
-- Basic transforms
-- ---------------------------------------------------------------------------

axiom str.upper : String -> String
-- LAW: IsUpper(output) && LengthEq(output, input)
guarantee: LengthEq(output, input)

axiom str.lower : String -> String
-- LAW: IsLower(output) && LengthEq(output, input)
guarantee: LengthEq(output, input)

axiom str.trim : String -> String
-- LAW: IsTrimmed(output) && LengthLe(output, input)
guarantee: LengthLe(output, input)

axiom str.trim_start : String -> String
-- LAW: IsTrimmedStart(output) && LengthLe(output, input)
guarantee: LengthLe(output, input)

axiom str.trim_end : String -> String
-- LAW: IsTrimmedEnd(output) && LengthLe(output, input)
guarantee: LengthLe(output, input)

axiom str.trim_matches : (String * String) -> String
-- LAW: IsTrimmed(output) && LengthLe(output, input.0)
guarantee: LengthLe(output, input.0)

axiom str.reverse : String -> String
-- LAW: IsReversed(output, input) && IsPerm(output, input)
guarantee: LengthEq(output, input) && IsPerm(output, input)

axiom str.length : String -> Int
guarantee: Le(0, output)

axiom str.concat : (String * String) -> String
-- LAW: LengthEq(output, input.0 + input.1)
-- (sum not expressible; length is monotone in each part)
guarantee: LengthLe(input.0, output) && LengthLe(input.1, output)

axiom str.is_empty : String -> Bool
-- LAW: output <=> IsEmpty(input)
guarantee: True

axiom str.equals : (String * String) -> Bool
-- LAW: output <=> CharEq(input.0, input.1)
guarantee: True

axiom str.is_alpha : String -> Bool
-- LAW: output <=> AllSatisfy(input, IsAlpha)
guarantee: True

axiom str.is_numeric : String -> Bool
-- LAW: output <=> AllSatisfy(input, IsNumeric)
guarantee: True

axiom str.is_alphanumeric : String -> Bool
-- LAW: output <=> AllSatisfy(input, IsAlnum)
guarantee: True

-- ---------------------------------------------------------------------------
-- Case conversion
-- ---------------------------------------------------------------------------

axiom str.capitalize : String -> String
guarantee: LengthEq(output, input)

axiom str.title_case : String -> String
guarantee: LengthEq(output, input)

axiom str.snake_case : String -> String
guarantee: True

axiom str.camel_case : String -> String
guarantee: True

axiom str.pascal_case : String -> String
guarantee: True

axiom str.kebab_case : String -> String
guarantee: True

-- ---------------------------------------------------------------------------
-- Search
-- ---------------------------------------------------------------------------

axiom str.contains : (String * String) -> Bool
guarantee: True

axiom str.starts_with : (String * String) -> Bool
-- LAW: output <=> IsPrefix(input.1, input.0)
guarantee: True

axiom str.ends_with : (String * String) -> Bool
-- LAW: output <=> IsSuffix(input.1, input.0)
guarantee: True

axiom str.count : (String * String) -> Int
-- LAW: Le(0, output) && CountEq(input.0, input.1, output)
guarantee: Le(0, output)

axiom str.find : (String * String) -> Int
guarantee: True

axiom str.rfind : (String * String) -> Int
guarantee: True

axiom str.levenshtein : (String * String) -> Int
-- LAW: Le(0, output) && EditDistance(input.0, input.1, output)
guarantee: Le(0, output)

axiom str.similarity : (String * String) -> Int
-- LAW: Le(0, output) && Le(output, 1) && Similarity(input.0, input.1, output)
-- (typed Int since Float is not a base type; ratio in [0, 1])
guarantee: Le(0, output) && Le(output, 1)

-- ---------------------------------------------------------------------------
-- Transform
-- ---------------------------------------------------------------------------

axiom str.split : (String * String) -> List String
guarantee: True

axiom str.join : (List String * String) -> String
guarantee: True

axiom str.replace : (String * (String * String)) -> String
-- LAW: NoOccurrence(output, input.1.0)
guarantee: True

axiom str.replace_first : (String * (String * String)) -> String
-- LAW: CountEq(output, input.1.0, Count(input, input.1.0) - 1)
guarantee: True

axiom str.repeat : (String * Int) -> String
requires: Le(0, input.1)
-- LAW: LengthEq(output, input.0 * input.1)
-- (product not expressible; monotone in count)
guarantee: Le(0, input.1)

axiom str.char_at : (String * Int) -> String
requires: Le(0, input.1) && Le(input.1, input.0)
-- LAW: LengthEq(output, 1)
guarantee: True

axiom str.slice : (String * (Int * Int)) -> String
requires: Le(0, input.1.0) && Le(input.1.0, input.1.1)
-- LAW: LengthEq(output, input.1.1 - input.1.0)
guarantee: LengthLe(output, input.1.1)

axiom str.pad_left : (String * (Int * String)) -> String
requires: Le(0, input.1.0)
-- LAW: LengthEq(output, input.1.0) || LengthGe(output, input.0)
guarantee: True

axiom str.pad_right : (String * (Int * String)) -> String
requires: Le(0, input.1.0)
-- LAW: LengthEq(output, input.1.0) || LengthGe(output, input.0)
guarantee: True

axiom str.strip_prefix : (String * String) -> String
guarantee: LengthLe(output, input.0)

axiom str.strip_suffix : (String * String) -> String
guarantee: LengthLe(output, input.0)

axiom str.lines : String -> List String
guarantee: True

axiom str.split_at : (String * Int) -> List String
requires: Le(0, input.1)
-- LAW: LengthEq(output.0 + output.1, input.0)
guarantee: True

axiom str.split_whitespace : String -> List String
guarantee: True

axiom str.truncate : (String * Int) -> String
requires : Le(0, input.1)
guarantee: LengthLe(output, input.1)

axiom str.slugify : String -> String
-- LAW: IsSlug(output)
guarantee: True

axiom str.word_wrap : (String * Int) -> String
requires : Le(1, input.1)
guarantee: True
