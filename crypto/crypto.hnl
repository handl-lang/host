--- crypto.sha256 -- compute the SHA-256 hash of a string or byte array, returning a hex-encoded digest.
--- crypto.md5 -- compute the MD5 hash of a string or byte array, returning a hex-encoded digest.
cap "crypto.sha256"
cap "crypto.md5"
op "crypto.sha256" : Value -> String
  guarantee: IsHex(output)
op "crypto.md5" : Value -> String
  guarantee: IsHex(output)

handle "crypto.sha256" with rust_crypto_sha256
handle "crypto.md5" with rust_crypto_md5
