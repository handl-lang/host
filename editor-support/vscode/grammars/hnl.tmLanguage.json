{
  "patterns": [
    {
      "include": "#doc_comments"
    },
    {
      "include": "#doc_block_comment"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#block_comment"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#booleans"
    },
    {
      "include": "#nulls"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#delimiters"
    },
    {
      "include": "#function_calls"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "block_comment": {
      "begin": "\\/\\*",
      "end": "\\*\\/",
      "name": "comment.block",
      "patterns": []
    },
    "booleans": {
      "match": "\\b(true|false)\\b",
      "name": "constant.language.boolean"
    },
    "comments": {
      "match": "\\/\\/.*",
      "name": "comment.line"
    },
    "delimiters": {
      "match": "[\\(|\\)|\\[|\\]|\\{|\\}|,|:|\\.|;]",
      "name": "punctuation"
    },
    "doc_block_comment": {
      "begin": "\\/\\*\\*",
      "end": "\\*\\/",
      "name": "comment.documentation.block",
      "patterns": []
    },
    "doc_comments": {
      "match": "\\/\\/\\/.*",
      "name": "comment.documentation"
    },
    "function_calls": {
      "captures": {
        "1": {
          "name": "entity.name.function"
        },
        "2": {
          "name": "punctuation"
        }
      },
      "match": "([a-zA-Z_.][a-zA-Z0-9_.]*)\\s*(\\()"
    },
    "identifiers": {
      "match": "[a-zA-Z_.][a-zA-Z0-9_.]*",
      "name": "variable"
    },
    "keywords": {
      "match": "\\b(match|handle|as|typeof|not|import|export|module)\\b",
      "name": "keyword"
    },
    "nulls": {
      "match": "\\b(null)\\b",
      "name": "constant.language.null"
    },
    "numbers": {
      "match": "-?\\d+(\\.\\d+)?([eE][+-]?\\d+)?",
      "name": "constant.numeric"
    },
    "operators": {
      "match": "(\\|>|->|=|\\+|-|\\*|\\/|<|>)",
      "name": "keyword.operator"
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted",
          "patterns": []
        },
        {
          "begin": "'",
          "end": "'",
          "name": "string.quoted",
          "patterns": []
        }
      ]
    }
  },
  "scopeName": "source.handl"
}