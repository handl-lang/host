{
  "patterns": [
    {
      "include": "#doc_comments"
    },
    {
      "include": "#doc_block_comment"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#block_comment"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#booleans"
    },
    {
      "include": "#nulls"
    },
    {
      "include": "#keyword_as"
    },
    {
      "include": "#keyword_handle"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#delimiters"
    },
    {
      "include": "#type_references"
    },
    {
      "include": "#type_names"
    },
    {
      "include": "#binding_declarations"
    },
    {
      "include": "#property_names"
    },
    {
      "include": "#function_calls"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "binding_declarations": {
      "captures": {
        "1": {
          "name": "variable.other.binding"
        }
      },
      "match": "^([a-zA-Z_.][a-zA-Z0-9_.]*)\\s*[:=]"
    },
    "block_comment": {
      "begin": "\\/\\*",
      "end": "\\*\\/",
      "name": "comment.block"
    },
    "booleans": {
      "match": "\\b(true|false)\\b",
      "name": "constant.language.boolean"
    },
    "comments": {
      "match": "\\/\\/.*",
      "name": "comment.line"
    },
    "delimiters": {
      "match": "[\\(|\\)|\\[|\\]|\\{|\\}|,|:|\\.|;]",
      "name": "punctuation"
    },
    "doc_block_comment": {
      "begin": "\\/\\*\\*",
      "end": "\\*\\/",
      "name": "comment.documentation.block"
    },
    "doc_comments": {
      "match": "\\/\\/\\/.*",
      "name": "comment.documentation"
    },
    "function_calls": {
      "captures": {
        "1": {
          "name": "entity.name.function"
        },
        "2": {
          "name": "punctuation"
        }
      },
      "match": "([a-zA-Z_.][a-zA-Z0-9_.]*)\\s*(\\()"
    },
    "identifiers": {
      "match": "[a-zA-Z_.][a-zA-Z0-9_.]*",
      "name": "variable"
    },
    "keyword_as": {
      "match": "\\b(as)\\b",
      "name": "keyword"
    },
    "keyword_handle": {
      "match": "\\b(handle)\\b",
      "name": "keyword"
    },
    "keywords": {
      "match": "\\b(proc|loop|if|then|else|match|where|in|typeof|not|import|export|module)\\b",
      "name": "keyword"
    },
    "nulls": {
      "match": "\\b(null)\\b",
      "name": "constant.language.null"
    },
    "numbers": {
      "match": "-?\\d+(\\.\\d+)?([eE][+-]?\\d+)?",
      "name": "constant.numeric"
    },
    "operators": {
      "match": "(\\|>|->|=|\\+|-|\\*|\\/|<|>)",
      "name": "keyword.operator"
    },
    "property_names": {
      "captures": {
        "1": {
          "name": "variable.other.property"
        }
      },
      "match": "([a-zA-Z_.][a-zA-Z0-9_.]*)\\s*:"
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted"
        },
        {
          "begin": "'",
          "end": "'",
          "name": "string.quoted"
        }
      ]
    },
    "type_names": {
      "match": "\\b[A-Z][a-zA-Z0-9_]+\\b",
      "name": "entity.name.type"
    },
    "type_references": {
      "captures": {
        "1": {
          "name": "entity.name.type"
        }
      },
      "match": "\\btype\\.([a-zA-Z_][a-zA-Z0-9_]*)"
    }
  },
  "scopeName": "source.handl"
}
