{
  "patterns": [
    { "include": "#doc_comments" },
    { "include": "#doc_block_comment" },
    { "include": "#comments" },
    { "include": "#block_comment" },
    { "include": "#strings" },
    { "include": "#template_strings" },
    { "include": "#numbers" },
    { "include": "#booleans" },
    { "include": "#nulls" },
    { "include": "#keywords" },
    { "include": "#spread" },
    { "include": "#arrow" },
    { "include": "#arrow_operators" },
    { "include": "#operators" },
    { "include": "#type_references" },
    { "include": "#type_names" },
    { "include": "#object_keys" },
    { "include": "#binding_declarations" },
    { "include": "#property_access" },
    { "include": "#function_calls" },
    { "include": "#brackets" },
    { "include": "#braces" },
    { "include": "#parens" },
    { "include": "#delimiters" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "binding_declarations": {
      "captures": {
        "1": { "name": "variable.other.readwrite" }
      },
      "match": "^\\s*([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?::|=)"
    },
    "block_comment": {
      "begin": "/\\*",
      "end": "\\*/",
      "name": "comment.block"
    },
    "booleans": {
      "match": "\\b(true|false)\\b",
      "name": "constant.language.boolean"
    },
    "brackets": {
      "match": "[\\[\\]]",
      "name": "meta.brace.square"
    },
    "braces": {
      "match": "[{}]",
      "name": "meta.brace.curly"
    },
    "comments": {
      "match": "--.*",
      "name": "comment.line"
    },
    "delimiters": {
      "match": "[,;|]",
      "name": "punctuation.separator"
    },
    "doc_block_comment": {
      "begin": "/\\*\\*",
      "end": "\\*/",
      "name": "comment.documentation.block"
    },
    "doc_comments": {
      "match": "---.*",
      "name": "comment.documentation"
    },
    "arrow": {
      "match": "~>",
      "name": "keyword.operator.arrow"
    },
    "arrow_operators": {
      "match": ">>>|\\|\\|\\||-<|<-",
      "name": "keyword.operator.arrow"
    },
    "spread": {
      "match": "\\.\\.\\.",
      "name": "keyword.operator.spread"
    },
    "function_calls": {
      "captures": {
        "1": { "name": "entity.name.function" },
        "2": { "name": "meta.brace.paren" }
      },
      "match": "([a-zA-Z_][a-zA-Z0-9_]*)\\s*(\\()"
    },
    "identifiers": {
      "match": "[a-zA-Z_][a-zA-Z0-9_]*",
      "name": "variable.other.readwrite"
    },
    "keywords": {
      "match": "\\b(loop|if|then|else|match|where|in|typeof|not|import|export|module|axiom|do|returnA|let|const|is|may|must|when|handle|as)\\b",
      "name": "keyword.control"
    },
    "nulls": {
      "match": "\\b(null)\\b",
      "name": "constant.language.null"
    },
    "numbers": {
      "match": "-?\\d+(\\.\\d+)?([eE][+-]?\\d+)?",
      "name": "constant.numeric"
    },
    "object_keys": {
      "captures": {
        "1": { "name": "support.type.property-name" }
      },
      "match": "(?<=\\{|,)\\s*([a-zA-Z_][a-zA-Z0-9_]*)\\s*:"
    },
    "operators": {
      "match": "(=|\\+|-|\\*|\\/|<|>|<=|>=|==|!=|&&|\\|\\||!|\\?|\\^|%)",
      "name": "keyword.operator"
    },
    "parens": {
      "match": "[()]",
      "name": "meta.brace.paren"
    },
    "property_access": {
      "captures": {
        "1": { "name": "punctuation.accessor" },
        "2": { "name": "variable.other.property" }
      },
      "match": "\\.([a-zA-Z_][a-zA-Z0-9_]*)"
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double"
        },
        {
          "begin": "'",
          "end": "'",
          "name": "string.quoted.single"
        }
      ]
    },
    "template_strings": {
      "begin": "`",
      "end": "`",
      "name": "string.template",
      "patterns": [
        {
          "match": "\\$\\{[^}]*\\}",
          "name": "variable.other.readwrite"
        }
      ]
    },
    "type_names": {
      "match": "\\b[A-Z][a-zA-Z0-9_]*\\b",
      "name": "entity.name.type"
    },
    "type_references": {
      "captures": {
        "1": { "name": "entity.name.type" }
      },
      "match": "\\btype\\.([a-zA-Z_][a-zA-Z0-9_]*)"
    }
  },
  "scopeName": "source.handl"
}
