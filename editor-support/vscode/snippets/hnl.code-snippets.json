{
  "arrow (single arg)": {
    "prefix": "~>",
    "body": [
      "${1:pattern} ~> ${2:body}"
    ],
    "description": "An arrow: pattern ~> body"
  },
  "arrow (multi arg)": {
    "prefix": "~>args",
    "body": [
      "[${1:args}] ~> ${2:body}"
    ],
    "description": "A multi-arg arrow: [args] ~> body (no currying, ID.2)"
  },
  "rec block": {
    "prefix": "rec",
    "body": [
      "rec {",
      "  ${1:// state bindings}",
      "  ${2:// match or if to exit/continue}",
      "}"
    ],
    "description": "A rec block for feedback loops (replaces loop)"
  },
  "rec with match": {
    "prefix": "rec-match",
    "body": [
      "rec {",
      "  remaining = ${1:input},",
      "  acc = ${2:[]},",
      "  match remaining {",
      "    []: return acc,",
      "    [h, ...t]: {",
      "      ${3:// process h}",
      "      remaining = t,",
      "      acc = ${4:// update acc}",
      "    }",
      "  }",
      "}"
    ],
    "description": "A rec block with match on a list (common fold pattern)"
  },
  "while loop": {
    "prefix": "while",
    "body": [
      "while ${1:cond} {",
      "  ${2:// body}",
      "}"
    ],
    "description": "A while loop: while cond { body }"
  },
  "do while": {
    "prefix": "do-while",
    "body": [
      "do {",
      "  ${1:// body}",
      "} while ${2:cond}"
    ],
    "description": "A do-while loop: do { body } while cond"
  },
  "for map": {
    "prefix": "for",
    "body": [
      "for ${1:x} in ${2:xs} {",
      "  ${3:// body}",
      "}"
    ],
    "description": "A for map: for x in xs { body }"
  },
  "for fold": {
    "prefix": "for-fold",
    "body": [
      "for ${1:x} in ${2:xs}, ${3:acc} = ${4:init} {",
      "  ${5:// body}",
      "}"
    ],
    "description": "A for fold: for x in xs, acc = init { body }"
  },
  "if else": {
    "prefix": "if",
    "body": [
      "if ${1:cond} {",
      "  ${2:// then branch}",
      "} else {",
      "  ${3:// else branch}",
      "}"
    ],
    "description": "An if/else expression: if cond { then } else { else }"
  },
  "match block": {
    "prefix": "match",
    "body": [
      "match ${1:expr} {",
      "  ${2:pat}: ${3:body}",
      "}"
    ],
    "description": "A match expression: match expr { pat: body }"
  },
  "match list": {
    "prefix": "match-list",
    "body": [
      "match ${1:xs} {",
      "  []: ${2:// base case},",
      "  [h, ...t]: ${3:// recursive case}",
      "}"
    ],
    "description": "A match on a list with empty and cons patterns"
  },
  "return": {
    "prefix": "return",
    "body": [
      "return ${1:expr}"
    ],
    "description": "Return a value from a rec block"
  },
  "sequence": {
    "prefix": "seq",
    "body": [
      "${1:first} >>> ${2:second}"
    ],
    "description": "Sequential composition: a >>> b"
  },
  "product": {
    "prefix": "prod",
    "body": [
      "${1:left} *** ${2:right}"
    ],
    "description": "Parallel product: a *** b"
  },
  "fanout": {
    "prefix": "fan",
    "body": [
      "${1:left} &&& ${2:right}"
    ],
    "description": "Fan-out: a &&& b"
  },
  "choice": {
    "prefix": "choice",
    "body": [
      "${1:left} ||| ${2:right}"
    ],
    "description": "Choice: a ||| b"
  },
  "nullish": {
    "prefix": "nullish",
    "body": [
      "${1:expr} ?? ${2:default}"
    ],
    "description": "Nullish coalescing: expr ?? default"
  },
  "optional chain": {
    "prefix": "opt-chain",
    "body": [
      "${1:expr}?.${2:field}"
    ],
    "description": "Optional chaining: expr?.field"
  },
  "spread": {
    "prefix": "spread",
    "body": [
      "...${1:expr}"
    ],
    "description": "Spread: ...expr"
  },
  "record": {
    "prefix": "record",
    "body": [
      "{",
      "  ${1:field}: ${2:value}",
      "}"
    ],
    "description": "A record literal: { field: value }"
  },
  "tuple": {
    "prefix": "tuple",
    "body": [
      "[${1:items}]"
    ],
    "description": "A tuple/positional: [items]"
  },
  "binding": {
    "prefix": "binding",
    "body": [
      "${1:name} = ${2:expr}"
    ],
    "description": "A binding: name = expr"
  },
  "typed binding": {
    "prefix": "binding-typed",
    "body": [
      "${1:name}: ${2:Type} = ${3:expr}"
    ],
    "description": "A typed binding: name: Type = expr"
  },
  "import": {
    "prefix": "import",
    "body": [
      "import ${1:name} from \"${2:path}\""
    ],
    "description": "An import: import name from \"path\""
  },
  "law": {
    "prefix": "law",
    "body": [
      "law ${1:name} : ${2:Type}",
      "  guarantee: ${3:True}"
    ],
    "description": "A law declaration (replaces axiom)"
  },
  "infer": {
    "prefix": "infer",
    "body": [
      "infer ${1:name}"
    ],
    "description": "Infer a name: infer name"
  },
  "doc comment": {
    "prefix": "doc",
    "body": [
      "/// ${1:name}: ${2:description}",
      "///",
      "/// ${3:details}"
    ],
    "description": "A doc comment block"
  }
}
