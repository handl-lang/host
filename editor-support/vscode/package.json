{
  "name": "handl",
  "displayName": "handl",
  "version": "0.1.0",
  "description": "Language support for handl: syntax highlighting, refinement inference, code navigation, formatting, and more for .hnl files",
  "categories": [
    "Programming Languages"
  ],
  "publisher": "handl-lang",
  "main": "./dist/extension.js",
  "icon": "logo.png",
  "readme": "README.md",
  "scripts": {
    "gen-grammar": "node scripts/gen-grammar.mjs",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "build": "npm run gen-grammar && vite build",
    "watch": "vite build --watch",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "package": "npm run build && vsce package",
    "install-local": "code --install-extension handl-*.vsix --force",
    "dev": "npm run package && code --install-extension handl-*.vsix --force"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "handl",
        "extensions": [
          ".hnl"
        ],
        "aliases": [
          "handl"
        ]
      }
    ],
    "grammars": [
      {
        "language": "handl",
        "scopeName": "source.handl",
        "path": "./grammars/hnl.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "handl",
        "path": "./snippets/hnl.code-snippets.json"
      }
    ],
    "configurationDefaults": {
      "[handl]": {
        "editor.defaultFormatter": "handl-lang.handl",
        "editor.formatOnSave": true
      }
    },
    "configuration": {
      "title": "handl",
      "properties": {
        "handl.server.path": {
          "type": "string",
          "default": "",
          "description": "Path to the handl-host-lsp binary. If empty, looks for it in the workspace target/debug directory."
        },
        "handl.enableInlayHints": {
          "type": "boolean",
          "default": true,
          "description": "Show inferred refinement types as inlay hints next to bindings."
        },
        "handl.enableCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show inferred contract summaries as code lenses at the top of arrow files."
        },
        "handl.enableRefinementDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Show refinement inference errors as diagnostics."
        },
        "handl.enableSemanticHighlighting": {
          "type": "boolean",
          "default": true,
          "description": "Enable semantic token-based syntax highlighting."
        }
      }
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "engines": {
    "vscode": "^1.80.0"
  }
}
