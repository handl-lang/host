{
  "name": "handl",
  "displayName": "handl",
  "version": "0.1.0",
  "description": "Language support for handl: syntax highlighting, refinement inference, code navigation, formatting, and more for .hnl files",
  "categories": [
    "Programming Languages"
  ],
  "publisher": "handl-lang",
  "main": "./dist/extension.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "build": "vite build",
    "watch": "vite build --watch",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "package": "npm run build && vsce package",
    "install-local": "code --install-extension handl-*.vsix --force",
    "dev": "npm run package && code --install-extension handl-*.vsix --force"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "handl",
        "extensions": [
          ".hnl"
        ],
        "aliases": [
          "handl"
        ]
      }
    ],
    "configurationDefaults": {
      "[handl]": {
        "editor.defaultFormatter": "handl-lang.handl",
        "editor.formatOnSave": true
      }
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "icon": "logo.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "readme": "README.md"
}
