{
  "name": "handl-lsp",
  "displayName": "handl Language Support",
  "version": "0.2.0",
  "description": "Syntax highlighting and LSP semantic tokens for .hnl files",
  "categories": [
    "Programming Languages"
  ],
  "publisher": "handl-lang",
  "main": "./dist/extension.js",
  "scripts": {
    "gen-grammar": "node scripts/gen-grammar.mjs",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "build": "npm run gen-grammar && vite build",
    "watch": "vite build --watch",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "package": "npm run build && vsce package",
    "install-local": "code --install-extension handl-lsp-*.vsix --force",
    "dev": "npm run package && code --install-extension handl-lsp-*.vsix --force"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "handl",
        "extensions": [
          ".hnl"
        ],
        "aliases": [
          "handl"
        ]
      }
    ],
    "grammars": [
      {
        "language": "handl",
        "scopeName": "source.handl",
        "path": "./grammars/hnl.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "handl LSP",
      "properties": {
        "handl-lsp.server.path": {
          "type": "string",
          "default": "",
          "description": "Path to the handl-host-lsp binary. If empty, looks for it in the workspace target/debug directory."
        }
      }
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "engines": {
    "vscode": "^1.80.0"
  }
}
