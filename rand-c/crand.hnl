--- Low-level libc `rand` reader.
---
--- Calls `rand` in `libc.so.6` through the generic `ffi` host
--- capability and returns a raw 31-bit non-negative integer.

from "../grade" import { Effect }

--- Read a raw 31-bit non-negative integer from `libc` `rand`.
--- @returns {Number - a value in `[0, 2147483647]`}
--- @example
--- ```hnl
--- from "crand" import { next_i32 }
--- next_i32()
--- ```
export next_i32: () ~[Effect]~> Number := () ~> do {
  ffi.call("libc.so.6", "rand", [], [], "i32", false)
}
