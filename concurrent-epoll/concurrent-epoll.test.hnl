--- Smoke tests for the epoll `concurrent` backend: spawn/await,
--- rendezvous channels, mutex+atomic, sleep, and a loopback TCP echo.

from "./concurrent-epoll" import { run, tcp_listen, tcp_connect }
from "bytes" import { utf8_encode, utf8_decode }

-- ---------------------------------------------------------------
-- channel + spawn + await
-- ---------------------------------------------------------------

worker := (s) ~> match s.phase {
  "start": { state: { phase: "mid", n: 40 } },
  "mid": { out: s.n + 2 }
}

producer := (s) ~> match s.phase {
  "p1": {
    call: { name: "chan_send", chan: s.ch, value: 7 },
    state: { phase: "p2", ch: s.ch }
  },
  "p2": {
    call: { name: "chan_send", chan: s.ch, value: 35 },
    state: { phase: "done" }
  },
  "done": { out: null }
}

consumer := (s) ~> match s.phase {
  "c1": {
    call: { name: "chan_recv", chan: s.ch },
    state: { phase: "c2", ch: s.ch }
  },
  "c2": {
    call: { name: "chan_recv", chan: s.ch },
    state: { phase: "done", acc: s.result }
  },
  "done": { out: s.acc + s.result }
}

chan_main := (s) ~> match s.phase {
  "new": {
    call: { name: "chan_new", cap: 0 },
    state: { phase: "spawn_c" }
  },
  "spawn_c": {
    call: { name: "spawn", task: consumer, init: { phase: "c1", ch: s.result } },
    state: { phase: "spawn_p", ch: s.result }
  },
  "spawn_p": {
    call: { name: "spawn", task: producer, init: { phase: "p1", ch: s.ch } },
    state: { phase: "await_c", cons: s.result }
  },
  "await_c": {
    call: { name: "await", task: s.cons },
    state: { phase: "spawn_w" }
  },
  "spawn_w": {
    call: { name: "spawn", task: worker, init: { phase: "start" } },
    state: { phase: "await_w", sum: s.result }
  },
  "await_w": {
    call: { name: "await", task: s.result },
    state: { phase: "done", sum: s.sum }
  },
  "done": { out: { chan_sum: s.sum, worker: s.result } }
}

r1 := run(chan_main, {})

test_chan_sum := assert r1.main.chan_sum := 42

test_spawn_await := assert r1.main.worker := 42

-- ---------------------------------------------------------------
-- mutex + atomic: two tasks increment a shared counter under a lock
-- ---------------------------------------------------------------

counter := (s) ~> match s.phase {
  "lock": {
    call: { name: "mutex_lock", mutex: s.m },
    state: { phase: "read", m: s.m, a: s.a }
  },
  "read": {
    call: { name: "atomic_read", atomic: s.a },
    state: { phase: "write", m: s.m, a: s.a }
  },
  "write": {
    call: { name: "atomic_write", atomic: s.a, value: s.result + 1 },
    state: { phase: "unlock", m: s.m, a: s.a }
  },
  "unlock": {
    call: { name: "mutex_unlock", mutex: s.m },
    state: { phase: "done" }
  },
  "done": { out: null }
}

mutex_main := (s) ~> match s.phase {
  "mutex": {
    call: { name: "mutex_new" },
    state: { phase: "atomic" }
  },
  "atomic": {
    call: { name: "atomic_new", value: 0 },
    state: { phase: "spawn1", m: s.result }
  },
  "spawn1": {
    call: { name: "spawn", task: counter, init: { phase: "lock", m: s.m, a: s.result } },
    state: { phase: "spawn2", m: s.m, a: s.result }
  },
  "spawn2": {
    call: { name: "spawn", task: counter, init: { phase: "lock", m: s.m, a: s.a } },
    state: { phase: "await1", a: s.a, t1: s.result }
  },
  "await1": {
    call: { name: "await", task: s.t1 },
    state: { phase: "await2", a: s.a, t2: s.result }
  },
  "await2": {
    call: { name: "await", task: s.t2 },
    state: { phase: "read", a: s.a }
  },
  "read": {
    call: { name: "atomic_read", atomic: s.a },
    state: { phase: "done" }
  },
  "done": { out: s.result }
}

test_mutex := assert run(mutex_main, {}).main := 2

-- ---------------------------------------------------------------
-- sleep
-- ---------------------------------------------------------------

sleeper := (s) ~> match s.phase {
  "go": { call: { name: "sleep", ms: 1 }, state: { phase: "done" } },
  "done": { out: "slept" }
}

test_sleep := assert run(sleeper, { phase: "go" }).main := "slept"

-- ---------------------------------------------------------------
-- TCP loopback: listen + connect + echo
-- ---------------------------------------------------------------

echo_conn := (s) ~> match s.phase {
  "recv": {
    call: { name: "recv", fd: s.fd },
    state: { phase: "send", fd: s.fd }
  },
  "send": {
    call: { name: "send", fd: s.fd, buf: s.result },
    state: { phase: "close", fd: s.fd }
  },
  "close": {
    call: { name: "close", fd: s.fd },
    state: { phase: "done" }
  },
  "done": { out: null }
}

listener := (s) ~> match s.phase {
  "accept": {
    call: { name: "accept", fd: s.lfd },
    state: { phase: "spawned", lfd: s.lfd }
  },
  "spawned": {
    call: { name: "spawn", task: echo_conn, init: { phase: "recv", fd: s.result } },
    state: { phase: "done" }
  },
  "done": { out: null }
}

connector := (s) ~> match s.phase {
  "wait": {
    call: { name: "connect_wait", fd: s.fd },
    state: { phase: "send", fd: s.fd, msg: s.msg }
  },
  "send": {
    call: { name: "send", fd: s.fd, buf: s.msg },
    state: { phase: "recv", fd: s.fd }
  },
  "recv": {
    call: { name: "recv", fd: s.fd },
    state: { phase: "close", fd: s.fd, got: s.result }
  },
  "close": {
    call: { name: "close", fd: s.fd },
    state: { phase: "done", got: s.got }
  },
  "done": { out: s.got }
}

tcp_main := (s) ~> match s.phase {
  "spawn_l": {
    call: { name: "spawn", task: listener, init: { phase: "accept", lfd: s.lfd } },
    state: { phase: "spawn_c" }
  },
  "spawn_c": {
    call: { name: "spawn", task: connector, init: s.cinit },
    state: { phase: "await_c", lid: s.result }
  },
  "await_c": {
    call: { name: "await", task: s.result },
    state: { phase: "await_l", lid: s.lid }
  },
  "await_l": {
    call: { name: "await", task: s.lid },
    state: { phase: "done", got: s.result }
  },
  "done": { out: { echoed: s.got } }
}

lfd := tcp_listen({ host: "127.0.0.1", port: 18347 })

c := tcp_connect({ host: "127.0.0.1", port: 18347 })

r2 := run(tcp_main, {
  lfd: lfd,
  cinit: { phase: "wait", fd: c.fd, msg: utf8_encode("ping") }
})

test_tcp_echo := assert utf8_decode(r2.main.echoed) := "ping"
