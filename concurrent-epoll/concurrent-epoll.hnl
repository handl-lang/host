--- concurrent-epoll -- epoll backend for the `concurrent` contract.
---
--- A cooperative scheduler for step-arrow tasks (see `concurrent.hnl`
--- for the Step protocol). The scheduler itself is a `while` loop over
--- a record of queues — deterministic dataflow threaded through
--- `epoll_wait` (ADR-0072: the non-determinism lives in the event
--- stream, not the graph). No preemption: a task holds the machine for
--- exactly one arrow invocation.
---
--- Scheduler state:
---   runq    runnable entries  { id, arrow, input, stack, token }
---   fdw     fd waiters        { id, arrow, fd, events, req, state, stack, token }
---   cw      channel waiters   { chan, select, kind, id, arrow, state, stack, token, value }
---   tw      task waiters      { task, id, arrow, state, stack, token }
---   timers  sleeps+timeouts   { deadline, id, arrow, state, stack, token, await_task }
---   chans   { id, cap, queue }  mutexes/rwlocks/sems/atomics/tokens
---   live    ids of unfinished tasks   results  { id, value } pairs
---
--- `stack` is the `enter` frame stack: running `{ call: { name: "enter",
--- arrow, init } }` pushes `{ arrow, state }` and continues the task
--- under the task arrow; a nested `{ out: v }` pops the frame and
--- resumes the caller's state with `result = v`.

from "../concurrent" import { Task, Run }
from "bytes" import { at, concat, slice, from_list }
from "../generated/libc-c-linux-x86_64/socket" import { socket, bind, connect, listen, accept4, recv, send, setsockopt, getsockopt, shutdown, AF_INET, SOCK_STREAM, SOCK_NONBLOCK, SOCK_CLOEXEC, SOL_SOCKET, SO_REUSEADDR, SOMAXCONN, MSG_NOSIGNAL, SO_ERROR }
from "../generated/libc-c-linux-x86_64/epoll" import { epoll_create1, epoll_ctl, epoll_wait, EPOLL_CLOEXEC, EPOLLIN, EPOLLOUT, EPOLL_CTL_ADD, EPOLL_CTL_DEL, EPOLL_CTL_MOD }
from "../generated/libc-c-linux-x86_64/fcntl" import { fcntl, F_GETFL, F_SETFL, O_NONBLOCK }
from "../generated/curl-c-linux-x86_64/curl" import { curl_multi_init, curl_multi_add_handle, curl_multi_remove_handle, curl_multi_perform, curl_multi_fdset, curl_multi_timeout, curl_multi_info_read, curl_multi_cleanup, CURLM_OK, CURLMSG_DONE }
from "../generated/libc-c-linux-x86_64/unistd" import { close }
from "../generated/libc-c-linux-x86_64/errno" import { EAGAIN, EWOULDBLOCK, EINPROGRESS, EBADF }
from "../generated/libc-c-linux-x86_64/time" import { clock_gettime, CLOCK_MONOTONIC }
from "../generated/libc-c-linux-x86_64/inet" import { inet_pton }
from "math" import * as math
from "../tls-libssl/tls-libssl" import * as tlsp
from "../ws-c/ws-c" import * as wsc

--- local aliases: a task arrow's serialized env keeps ` := ` bindings
--- but drops `import` bindings, so the TLS/WebSocket steps must be
--- reached through a local binding (same workaround as fetch-c).
tls_step := tlsp.handshake_step

tls_read_step := tlsp.read_step

tls_write_step := tlsp.write_step

tls_close_ssl := tlsp.close

ws_recv_step := wsc.recv_step

ws_send_step := wsc.send_step

ws_close_conn := wsc.close

-- ---------------------------------------------------------------
-- small utilities
-- ---------------------------------------------------------------

is_err := (r) ~> tag.tag_of(r) == "err"

err_of := (r) ~> tag.untag(r).value

val_of := (r) ~> tag.untag(r).value

unwrap := (r, what) ~> do {
  if is_err(r) {
    error.raise("concurrent-epoll: " + what + " failed")
  } else {
    val_of(r)
  }
}

--- monotonic clock in ms (timer deadlines)
now_ms := (_u) ~> do {
  t := unwrap(clock_gettime(CLOCK_MONOTONIC), "clock_gettime")
  t.buf.tv_sec * 1000 + t.buf.tv_nsec / 1000000
}

--- decode a little-endian u32 at byte offset `o` of `buf`
u32le := (buf, o) ~> do {
  at(buf, o) + at(buf, o + 1) * 256 +
  at(buf, o + 2) * 65536 + at(buf, o + 3) * 16777216
}

--- decode a little-endian u64 (epoll_event.data) at byte offset `o`
u64le := (buf, o) ~> do {
  u32le(buf, o) + u32le(buf, o + 4) * 4294967296
}

--- list helpers (kept local: the collections modules aggregate through
--- the host chain, these are tiny anyway)
alen := (xs) ~> while { xs: xs, n: 0 } {
  (xs, n) ~> match xs {
    []: { out: n },
    [h, ...t]: { state: { xs: t, n: n + 1 } }
  }
}

afirst := (xs) ~> match xs {
  []: null,
  [h, ...t]: h
}

--- epoll data tag for curl-owned sockets: task ids stay small, so
--- `data >= CURL_TAG` decodes as `curl fd = data - CURL_TAG`.
CURL_TAG := 1099511627776

adrop := (xs, n) ~> while { xs: xs, n: n } {
  (xs, n) ~> if n <= 0 {
    { out: xs }
  } else {
    match xs {
      []: { out: [] },
      [h, ...t]: { state: { xs: t, n: n - 1 } }
    }
  }
}

find_where := (xs, p) ~> while xs {
  (xs) ~> match xs {
    []: { out: null },
    [h, ...t]: if p(h) { { out: h } } else { { state: t } }
  }
}

acontains := (xs, v) ~> find_where(xs, (x) ~> x == v) != null

ais_empty := (xs) ~> xs == []

has_field := (m, k) ~> acontains(obj.keys(m), k)

drop_where := (xs, p) ~> while { xs: xs, acc: [] } {
  (xs, acc) ~> match xs {
    []: { out: acc },
    [h, ...t]: if p(h) {
      { state: { xs: t, acc: acc } }
    } else {
      { state: { xs: t, acc: [...acc, h] } }
    }
  }
}

-- ---------------------------------------------------------------
-- task entries
-- ---------------------------------------------------------------

--- push a parked frame back onto the runq, `result` merged into state
resume := (s, e, st, v) ~> hash_map.set(s, "runq", [...s.runq, {
    id: e.id, arrow: e.arrow,
    input: hash_map.set(st, "result", v),
    stack: e.stack, token: e.token
  }])

--- task finished with value v: record the result, drop it from live,
--- and wake anyone parked in `tw` on its id (clearing their paired
--- await_timeout timers).
finish_task := (s, e, v) ~> do {
  s1 := hash_map.set(s, "results", [...s.results, { id: e.id, value: v }])
  s2 := hash_map.set(s1, "live", drop_where(s1.live, (i) ~> i == e.id))
  ws := drop_where(s2.tw, (w) ~> w.task == e.id)
  mine := drop_where(s2.tw, (w) ~> w.task != e.id)
  s3 := hash_map.set(s2, "tw", ws)
  s4 := hash_map.set(s3, "timers",
    drop_where(s3.timers, (t) ~> t.await_task == e.id &&
      find_where(mine, (w) ~> w.id == t.id) != null))
  while { xs: mine, s: s4 } {
    (xs, s) ~> match xs {
      []: { out: s },
      [w, ...t]: {
        state: { xs: t, s: resume(s, w, w.state,
          if hash_map.get_or(w, "timeout", false) { { done: v } } else { v }) }
      }
    }
  }
}

token_set := (s, tok) ~> do {
  t := if tok == null { null } else {
    find_where(s.tokens, (x) ~> x.id == tok)
  }
  t != null && t.cancelled
}

-- ---------------------------------------------------------------
-- socket helpers (usable before `run`, or inside tasks via
-- synchronous setup calls -- they never block the scheduler)
-- ---------------------------------------------------------------

--- pack a sockaddr_in for AF_INET: family u16 native (LE on x86_64),
--- port u16 and addr u32 big-endian, 8 zero pad bytes.
sockaddr_in := (port, addr4) ~> do {
  hi := port / 256
  lo := port - hi * 256
  head := from_list([AF_INET, 0, hi, lo])
  concat(concat(head, addr4), from_list([0, 0, 0, 0, 0, 0, 0, 0]))
}

--- resolve a dotted-quad to 4 network-order bytes
resolve4 := (host) ~> do {
  if host == "0.0.0.0" {
    from_list([0, 0, 0, 0])
  } else {
    slice(unwrap(inet_pton(AF_INET, host), "inet_pton").buf, 0, 4)
  }
}

--- a nonblocking, close-on-exec TCP socket
tcp_socket := (_u) ~> unwrap(
  socket(AF_INET, SOCK_STREAM + SOCK_NONBLOCK + SOCK_CLOEXEC, 0),
  "socket")

--- mark an existing fd nonblocking (for fds not created here)
set_nonblock := (fd) ~> do {
  fl := unwrap(fcntl(fd, F_GETFL, 0), "fcntl(F_GETFL)")
  unwrap(fcntl(fd, F_SETFL, fl + O_NONBLOCK), "fcntl(F_SETFL)")
}

--- bind+listen. `addr` = { host: "0.0.0.0"|dotted-quad, port: Int }.
export tcp_listen := (addr) ~> do {
  fd := tcp_socket(null)
  _ := unwrap(setsockopt(fd, SOL_SOCKET, SO_REUSEADDR,
    from_list([1, 0, 0, 0])), "setsockopt")
  _ := unwrap(bind(fd, sockaddr_in(addr.port, resolve4(addr.host))), "bind")
  _ := unwrap(listen(fd, SOMAXCONN), "listen")
  fd
}

--- initiate a nonblocking connect. Returns { fd, pending } -- when
--- `pending` is true the handshake is in flight; a task completes it
--- with { call: { name: "connect_wait", fd } }.
export tcp_connect := (addr) ~> do {
  fd := tcp_socket(null)
  r := connect(fd, sockaddr_in(addr.port, resolve4(addr.host)))
  if is_err(r) {
    e := err_of(r)
    if e == EINPROGRESS {
      { fd: fd, pending: true }
    } else {
      _ := close(fd)
      error.raise("concurrent-epoll: connect failed")
    }
  } else {
    { fd: fd, pending: false }
  }
}

export tcp_close := (fd) ~> close(fd)

-- ---------------------------------------------------------------
-- fd waiters
-- ---------------------------------------------------------------

--- one TLS attempt. Returns { ready, value } | { want: "read"|"write" }
--- | { err: SSL_ERROR_* }. The `want` direction comes from
--- SSL_get_error, so the caller parks on the matching epoll event.
tls_attempt := (req) ~> do {
  r := match req.name {
    "tls_accept": tls_step(req.ssl, true),
    "tls_connect": tls_step(req.ssl, false),
    "tls_recv": tls_read_step(req.ssl),
    "tls_send": tls_write_step(req.ssl, req.buf),
    _: { err: -1 }
  }
  if hash_map.has(r, "want") {
    { want: r.want }
  } else if hash_map.get_or(r, "done", false) {
    { ready: true, value: null }
  } else if hash_map.has(r, "data") {
    { ready: true, value: r.data }
  } else if hash_map.get_or(r, "eof", false) {
    { ready: true, value: from_list([]) }
  } else if hash_map.has(r, "sent") {
    { ready: true, value: { sent: r.sent } }
  } else {
    { err: hash_map.get_or(r, "err", -1) }
  }
}

--- one WebSocket attempt. Returns { ready, value } | { again: true } |
--- { err: CURLcode }. `again` (CURLE_AGAIN) means the socket needs to
--- become readable/writable -- the caller parks on it like any fd op.
ws_attempt := (req) ~> do {
  r := match req.name {
    "ws_recv": ws_recv_step(req.h),
    "ws_send": ws_send_step(req.h, req.buf, req.flags),
    _: { err: -1 }
  }
  if hash_map.get_or(r, "again", false) {
    { again: true }
  } else if hash_map.has(r, "frame") {
    { ready: true, value: r.frame }
  } else if hash_map.has(r, "sent") {
    { ready: true, value: { sent: r.sent } }
  } else {
    { err: hash_map.get_or(r, "err", -1) }
  }
}

--- one syscall attempt for an fd request. Returns { ready, value } |
--- { again: true } | { err: errno }.
raw_attempt := (req) ~> do {
  r := match req.name {
    "recv": recv(req.fd, 0),
    "send": send(req.fd, req.buf, MSG_NOSIGNAL),
    "accept": accept4(req.fd, SOCK_NONBLOCK + SOCK_CLOEXEC),
    _: error.raise("concurrent-epoll: unknown fd req " + req.name)
  }
  if is_err(r) {
    e := err_of(r)
    if e == EAGAIN || e == EWOULDBLOCK {
      { again: true }
    } else {
      { err: e }
    }
  } else {
    v := val_of(r)
    if req.name == "send" {
      { ready: true, value: { sent: v } }
    } else if req.name == "accept" {
      { ready: true, value: v.ret }
    } else {
      { ready: true, value: v }
    }
  }
}

--- one attempt for any fd request: TLS ops report a wait direction,
--- WebSocket ops and plain socket ops report `{ again }`.
fd_attempt := (req) ~> if req.name == "tls_accept" || req.name == "tls_connect"
    || req.name == "tls_recv" || req.name == "tls_send" {
  tls_attempt(req)
} else if req.name == "ws_recv" || req.name == "ws_send" {
  ws_attempt(req)
} else {
  raw_attempt(req)
}

--- create the epoll instance on first fd interest; CPU-only workloads
--- (channels, spawn, locks, timers-only) never touch it.
ensure_epfd := (s) ~> do {
  if s.epfd == null {
    hash_map.set(s, "epfd", unwrap(epoll_create1(EPOLL_CLOEXEC), "epoll_create1"))
  } else {
    s
  }
}

--- drop an fd's epoll interest when the instance exists
drop_interest := (s, fd) ~> do {
  if s.epfd == null {
    0
  } else {
    epoll_ctl(s.epfd, EPOLL_CTL_DEL, fd, { events: 0, data: 0 })
  }
}

--- park the task on `fd` readiness (`events` = EPOLLIN/EPOLLOUT)
park_fd := (s, e, req, st, events) ~> do {
  s1 := ensure_epfd(s)
  _ := unwrap(epoll_ctl(s1.epfd, EPOLL_CTL_ADD, req.fd,
    { events: events, data: e.id }), "epoll_ctl")
  hash_map.set(s1, "fdw", [...s1.fdw, {
    id: e.id, arrow: e.arrow, fd: req.fd, events: events,
    req: req, state: st, stack: e.stack, token: e.token
  }])
}

--- drive a TLS op: resume on completion, park on the direction
--- SSL_get_error asked for, resume with { err } on hard failure.
tls_try := (s, e, req, st) ~> do {
  r := tls_attempt(req)
  if hash_map.get_or(r, "ready", false) {
    resume(s, e, st, r.value)
  } else if hash_map.has(r, "want") {
    park_fd(s, e, req, st, if r.want == "read" { EPOLLIN } else { EPOLLOUT })
  } else {
    resume(s, e, st, { err: r.err })
  }
}

--- try the op once; park on `events` readiness when the fd isn't ready
try_fd := (s, e, req, st, events) ~> do {
  r := fd_attempt(req)
  if hash_map.get_or(r, "ready", false) {
    resume(s, e, st, r.value)
  } else if hash_map.get_or(r, "again", false) {
    park_fd(s, e, req, st, events)
  } else {
    resume(s, e, st, { err: r.err })
  }
}

--- an fd fired. Re-attempt its op; on success (or hard error) drop the
--- epoll interest and the waiter, else leave both in place (level-
--- triggered: interest stays until the op resolves).
wake_fd := (s, w) ~> do {
  if w.req.name == "connect_wait" {
    _ := drop_interest(s, w.fd)
    r := getsockopt(w.fd, SOL_SOCKET, SO_ERROR)
    s1 := hash_map.set(s, "fdw", drop_where(s.fdw, (x) ~> x.id == w.id))
    if is_err(r) {
      resume(s1, w, w.state, { err: err_of(r) })
    } else {
      resume(s1, w, w.state, { err: u32le(val_of(r).buf, 0) })
    }
  } else {
    r := fd_attempt(w.req)
    if hash_map.get_or(r, "ready", false) {
      _ := drop_interest(s, w.fd)
      s1 := hash_map.set(s, "fdw", drop_where(s.fdw, (x) ~> x.id == w.id))
      resume(s1, w, w.state, r.value)
    } else if hash_map.get_or(r, "again", false) {
      s
    } else if hash_map.has(r, "want") {
      -- TLS asked for the other direction: re-park on it (level
      -- triggered, so the interest stays until the op resolves).
      ev := if r.want == "read" { EPOLLIN } else { EPOLLOUT }
      if ev == w.events {
        s
      } else {
        -- re-register for the other direction (epoll_ctl ADD on a live
        -- registration would fail with EEXIST)
        _ := drop_interest(s, w.fd)
        s1 := hash_map.set(s, "fdw", drop_where(s.fdw, (x) ~> x.id == w.id))
        park_fd(s1, w, w.req, w.state, ev)
      }
    } else {
      _ := drop_interest(s, w.fd)
      s1 := hash_map.set(s, "fdw", drop_where(s.fdw, (x) ~> x.id == w.id))
      resume(s1, w, w.state, { err: r.err })
    }
  }
}

-- ---------------------------------------------------------------
-- curl multi (async fetch): the task sends `curl_perform` with an
-- already-configured easy handle; we add it to a lazily-created CURLM
-- and drive it from epoll. Curl's socket fds come from
-- curl_multi_fdset (fd_sets, no socket callback needed) and are synced
-- into our epoll tagged with CURL_TAG; completions are drained via
-- curl_multi_info_read and resume the owning task with
-- `{ code: CURLcode }`.
-- ---------------------------------------------------------------

ensure_multi := (s) ~> do {
  if s.multi == null {
    hash_map.set(s, "multi", unwrap(curl_multi_init(), "curl_multi_init"))
  } else {
    s
  }
}

--- bit `j` of byte `b`
bit_set := (b, j) ~> math.bit_and(b, math.shl(1, j)) != 0

--- EPOLL mask wanted for `fd` from the read/write fd_sets
fd_wanted := (rset, wset, fd) ~> do {
  i := math.floor_div(fd, 8)
  m := fd - i * 8
  ev := if bit_set(at(rset, i), m) { EPOLLIN } else { 0 }
  if bit_set(at(wset, i), m) { ev + EPOLLOUT } else { ev }
}

--- {fd, events} for every fd set in rset/wset up to maxfd
wanted_fds := (rset, wset, maxfd) ~> while { fd: 0, acc: [] } {
  (fd, acc) ~> if fd > maxfd {
    { out: acc }
  } else {
    do {
      ev := fd_wanted(rset, wset, fd)
      if ev == 0 {
        { state: { fd: fd + 1, acc: acc } }
      } else {
        { state: { fd: fd + 1, acc: [...acc, { fd: fd, events: ev }] } }
      }
    }
  }
}

--- diff `wanted` into epoll: ADD new fds, MOD changed masks, DEL stale
sync_cfds := (s, wanted) ~> do {
  s1 := ensure_epfd(s)
  _ := while { xs: wanted } {
    (st) ~> match st.xs {
      []: { out: null },
      [w, ...t]: do {
        old := find_where(s.cfds, (c) ~> c.fd == w.fd)
        _ := if old == null {
          epoll_ctl(s1.epfd, EPOLL_CTL_ADD, w.fd,
            { events: w.events, data: CURL_TAG + w.fd })
        } else if old.events != w.events {
          epoll_ctl(s1.epfd, EPOLL_CTL_MOD, w.fd,
            { events: w.events, data: CURL_TAG + w.fd })
        } else {
          0
        }
        { state: { xs: t } }
      }
    }
  }
  stale := drop_where(s.cfds,
    (c) ~> find_where(wanted, (w) ~> w.fd == c.fd) == null)
  _ := while { xs: stale } {
    (st) ~> match st.xs {
      []: { out: null },
      [c, ...t]: do {
        _ := epoll_ctl(s1.epfd, EPOLL_CTL_DEL, c.fd, { events: 0, data: 0 })
        { state: { xs: t } }
      }
    }
  }
  hash_map.set(s1, "cfds", wanted)
}

--- drain CURLMSG_DONE queue: remove the easy handle and resume its task
drain_multi := (s) ~> while { s: s, go: true } {
  (s, go) ~> do {
    r := curl_multi_info_read(s.multi, 0)
    if go == false || is_err(r) || val_of(r).ret == 0 {
      { out: s }
    } else {
      do {
        msg := ffi.read(val_of(r).ret,
          "rec:{msg:i32,easy_handle:ptr,result:i32}")
        w := find_where(s.mwait, (x) ~> x.easy == msg.easy_handle)
        _ := curl_multi_remove_handle(s.multi, msg.easy_handle)
        s1 := hash_map.set(s, "mwait",
          drop_where(s.mwait, (x) ~> x.easy == msg.easy_handle))
        s2 := if w == null {
          s1
        } else {
          resume(s1, w, w.state, { code: msg.result })
        }
        { state: { s: s2, go: true } }
      }
    }
  }
}

--- run curl's state machines, refresh fd interest, drain completions
multi_drive := (s) ~> do {
  if s.multi == null {
    s
  } else {
    s1 := ensure_epfd(s)
    r := curl_multi_perform(s1.multi, 0)
    s2 := if is_err(r) {
      s1
    } else {
      do {
        f := curl_multi_fdset(s1.multi, 0)
        if is_err(f) {
          s1
        } else {
          v := val_of(f)
          sync_cfds(s1, wanted_fds(v.outs[0], v.outs[1], v.vals[0]))
        }
      }
    }
    drain_multi(s2)
  }
}

--- park the task until its easy handle reports CURLMSG_DONE
park_multi := (s, e, req, st) ~> do {
  s1 := ensure_multi(s)
  rc := curl_multi_add_handle(s1.multi, req.easy)
  if is_err(rc) || val_of(rc) != CURLM_OK {
    resume(s1, e, st, { code: -1 })
  } else {
    s2 := hash_map.set(s1, "mwait", [...s1.mwait, {
      easy: req.easy, id: e.id, arrow: e.arrow,
      state: st, stack: e.stack, token: e.token
    }])
    multi_drive(s2)
  }
}

-- ---------------------------------------------------------------
-- channels / synchronization
-- ---------------------------------------------------------------

--- does this parked channel waiter match (chan, kind)?
cw_match := (w, chan, kind) ~> w.kind == kind && (w.chan == chan ||
  (w.select != null && acontains(w.select, chan)))

--- wake one parked entry (channel/mutex/sem queues share the shape)
wake_entry := (s, w, v) ~> resume(s, w, w.state, v)

--- wake the first queued taker of a sync object, keeping its permit
--- handed over (the queue lives inside the object record field `k`).
pop_waiter := (s, w, v) ~> resume(s, w, w.state, v)

chan_of := (s, id) ~> find_where(s.chans, (c) ~> c.id == id)

set_chan := (s, ch) ~> hash_map.set(s, "chans",
  [...drop_where(s.chans, (c) ~> c.id == ch.id), ch])

v_of_select := (w, chan, v) ~> do {
  if w.select == null {
    v
  } else {
    { chan: chan, value: v }
  }
}

recv_val := (select, chan, v) ~> do {
  if select {
    { chan: chan, value: v }
  } else {
    v
  }
}

--- hand `req.value` to a parked receiver if any; else queue it; else
--- park the sender.
chan_send := (s, e, req, st) ~> do {
  ch := chan_of(s, req.chan)
  w := find_where(s.cw, (x) ~> cw_match(x, req.chan, "recv"))
  if w != null {
    s1 := hash_map.set(s, "cw", drop_where(s.cw, (x) ~> x.id == w.id))
    s2 := resume(s1, w, w.state, v_of_select(w, req.chan, req.value))
    resume(s2, e, st, { sent: true })
  } else if alen(ch.queue) < ch.cap {
    s1 := set_chan(s, hash_map.set(ch, "queue", [...ch.queue, req.value]))
    resume(s1, e, st, { sent: true })
  } else {
    hash_map.set(s, "cw", [...s.cw, {
      chan: req.chan, select: null, kind: "send",
      id: e.id, arrow: e.arrow, state: st,
      stack: e.stack, token: e.token, value: req.value
    }])
  }
}

--- take from the first ready channel in `chans` (nonempty queue or a
--- parked sender); `select` shapes the resumed value as {chan, value}.
chan_recv := (s, e, req, st, chans, select) ~> do {
  ready := find_where(chans, (id) ~> do {
    ch := chan_of(s, id)
    alen(ch.queue) > 0 ||
      find_where(s.cw, (x) ~> cw_match(x, id, "send")) != null
  })
  if ready == null {
    sel := if select { chans } else { null }
    hash_map.set(s, "cw", [...s.cw, {
      chan: afirst(chans), select: sel, kind: "recv",
      id: e.id, arrow: e.arrow, state: st,
      stack: e.stack, token: e.token, value: null
    }])
  } else {
    ch := chan_of(s, ready)
    w := find_where(s.cw, (x) ~> cw_match(x, ready, "send"))
    if alen(ch.queue) > 0 {
      v := afirst(ch.queue)
      ch1 := hash_map.set(ch, "queue", adrop(ch.queue, 1))
      if w == null {
        s1 := set_chan(s, ch1)
        resume(s1, e, st, recv_val(select, ready, v))
      } else {
        -- parked sender refills the slot and completes
        ch2 := hash_map.set(ch1, "queue", [...ch1.queue, w.value])
        s1 := set_chan(s, ch2)
        s2 := hash_map.set(s1, "cw", drop_where(s1.cw, (x) ~> x.id == w.id))
        s3 := resume(s2, w, w.state, { sent: true })
        resume(s3, e, st, recv_val(select, ready, v))
      }
    } else {
      -- empty queue, parked sender: rendezvous directly
      s1 := hash_map.set(s, "cw", drop_where(s.cw, (x) ~> x.id == w.id))
      s2 := resume(s1, w, w.state, { sent: true })
      resume(s2, e, st, recv_val(select, ready, w.value))
    }
  }
}

sync_of := (xs, id) ~> find_where(xs, (x) ~> x.id == id)

set_in := (s, key, xs, x) ~> hash_map.set(s, key,
  [...drop_where(xs, (y) ~> y.id == x.id), x])

mutex_lock := (s, e, req, st) ~> do {
  m := sync_of(s.mutexes, req.mutex)
  if m.held {
    s1 := set_in(s, "mutexes", s.mutexes,
      hash_map.set(m, "queue", [...m.queue, {
        id: e.id, arrow: e.arrow, state: st,
        stack: e.stack, token: e.token, value: null
      }]))
    s1
  } else {
    s1 := set_in(s, "mutexes", s.mutexes, hash_map.set(m, "held", true))
    resume(s1, e, st, { acquired: true })
  }
}

mutex_unlock := (s, e, req, st) ~> do {
  m := sync_of(s.mutexes, req.mutex)
  if alen(m.queue) > 0 {
    w := afirst(m.queue)
    m1 := hash_map.set(m, "queue", adrop(m.queue, 1))
    s1 := set_in(s, "mutexes", s.mutexes, m1)
    s2 := resume(s1, w, w.state, { acquired: true })
    resume(s2, e, st, { released: true })
  } else {
    s1 := set_in(s, "mutexes", s.mutexes, hash_map.set(m, "held", false))
    resume(s1, e, st, { released: true })
  }
}

rw_lock := (s, e, req, st, write) ~> do {
  l := sync_of(s.rwlocks, req.rwlock)
  waiters := if write { l.wq } else { l.rq }
  can := if write {
    l.writer == 0 && l.readers == 0
  } else {
    l.writer == 0 && alen(l.wq) == 0
  }
  if can {
    l1 := if write {
      hash_map.set(l, "writer", e.id)
    } else {
      hash_map.set(l, "readers", l.readers + 1)
    }
    s1 := set_in(s, "rwlocks", s.rwlocks, l1)
    resume(s1, e, st, { acquired: true })
  } else {
    key := if write { "wq" } else { "rq" }
    s1 := set_in(s, "rwlocks", s.rwlocks, hash_map.set(l, key, [...waiters, {
      id: e.id, arrow: e.arrow, state: st,
      stack: e.stack, token: e.token, value: null
    }]))
    s1
  }
}

rw_unlock := (s, e, req, st) ~> do {
  l := sync_of(s.rwlocks, req.rwlock)
  l1 := if l.writer == e.id {
    hash_map.set(l, "writer", 0)
  } else {
    hash_map.set(l, "readers", l.readers - 1)
  }
  -- hand off: waiting writers first when readers drain, else all readers
  if l1.writer == 0 && l1.readers == 0 && alen(l1.wq) > 0 {
    w := afirst(l1.wq)
    l2 := hash_map.set(l1, "wq", adrop(l1.wq, 1))
    l3 := hash_map.set(l2, "writer", w.id)
    s1 := set_in(s, "rwlocks", s.rwlocks, l3)
    s2 := resume(s1, w, w.state, { acquired: true })
    resume(s2, e, st, { released: true })
  } else if l1.writer == 0 && alen(l1.rq) > 0 {
    s1 := set_in(s, "rwlocks", s.rwlocks, hash_map.set(l1, "rq", []))
    s2 := while { xs: l1.rq, s: s1 } {
      (xs, s) ~> match xs {
        []: { out: s },
        [w, ...t]: do {
          l2 := sync_of(s.rwlocks, req.rwlock)
          s3 := set_in(s, "rwlocks", s.rwlocks,
            hash_map.set(l2, "readers", l2.readers + 1))
          { state: { xs: t, s: resume(s3, w, w.state, { acquired: true }) } }
        }
      }
    }
    resume(s2, e, st, { released: true })
  } else {
    s1 := set_in(s, "rwlocks", s.rwlocks, l1)
    resume(s1, e, st, { released: true })
  }
}

sem_op := (s, e, req, st, acquire) ~> do {
  m := sync_of(s.sems, req.sem)
  if acquire {
    if m.count > 0 {
      s1 := set_in(s, "sems", s.sems, hash_map.set(m, "count", m.count - 1))
      resume(s1, e, st, { acquired: true })
    } else {
      set_in(s, "sems", s.sems, hash_map.set(m, "queue", [...m.queue, {
        id: e.id, arrow: e.arrow, state: st,
        stack: e.stack, token: e.token, value: null
      }]))
    }
  } else {
    if alen(m.queue) > 0 {
      w := afirst(m.queue)
      s1 := set_in(s, "sems", s.sems,
        hash_map.set(m, "queue", adrop(m.queue, 1)))
      s2 := resume(s1, w, w.state, { acquired: true })
      resume(s2, e, st, { released: true })
    } else {
      s1 := set_in(s, "sems", s.sems, hash_map.set(m, "count", m.count + 1))
      resume(s1, e, st, { released: true })
    }
  }
}

-- ---------------------------------------------------------------
-- op dispatch
-- ---------------------------------------------------------------

perform := (s, e, req, st) ~> match req.name {
  "yield": resume(s, e, st, null),
  "spawn": do {
    id := s.next_id
    s1 := hash_map.set(s, "next_id", id + 1)
    s2 := hash_map.set(s1, "live", [...s1.live, id])
    s3 := hash_map.set(s2, "runq", [...s2.runq, {
      id: id, arrow: req.task, input: req.init,
      stack: [], token: hash_map.get_or(req, "token", null)
    }])
    resume(s3, e, st, id)
  },
  "await": do {
    r := find_where(s.results, (x) ~> x.id == req.task)
    if r != null {
      resume(s, e, st, r.value)
    } else {
      hash_map.set(s, "tw", [...s.tw, {
        task: req.task, id: e.id, arrow: e.arrow, state: st,
        stack: e.stack, token: e.token
      }])
    }
  },
  "await_timeout": do {
    r := find_where(s.results, (x) ~> x.id == req.task)
    if r != null {
      resume(s, e, st, { done: r.value })
    } else {
      s1 := hash_map.set(s, "tw", [...s.tw, {
        task: req.task, id: e.id, arrow: e.arrow, state: st,
        stack: e.stack, token: e.token, timeout: true
      }])
      hash_map.set(s1, "timers", [...s1.timers, {
        deadline: now_ms(null) + req.ms, id: e.id, arrow: e.arrow,
        state: st, stack: e.stack, token: e.token, await_task: req.task
      }])
    }
  },
  "sleep": hash_map.set(s, "timers", [...s.timers, {
    deadline: now_ms(null) + req.ms, id: e.id, arrow: e.arrow,
    state: st, stack: e.stack, token: e.token, await_task: 0
  }]),
  "enter": hash_map.set(s, "runq", [...s.runq, {
    id: e.id, arrow: req.arrow, input: req.init,
    stack: [...e.stack, { arrow: e.arrow, state: st }], token: e.token
  }]),
  "recv": try_fd(s, e, req, st, EPOLLIN),
  "send": try_fd(s, e, req, st, EPOLLOUT),
  "accept": try_fd(s, e, req, st, EPOLLIN),
  "connect_wait": park_fd(s, e, req, st, EPOLLOUT),
  "curl_perform": park_multi(s, e, req, st),
  "tls_accept": tls_try(s, e, req, st),
  "tls_connect": tls_try(s, e, req, st),
  "tls_recv": tls_try(s, e, req, st),
  "tls_send": tls_try(s, e, req, st),
  "tls_close": do {
    _ := drop_interest(s, req.fd)
    _ := tls_close_ssl(req.ssl)
    _ := close(req.fd)
    s1 := hash_map.set(s, "fdw",
      drop_where(s.fdw, (w) ~> w.fd == req.fd))
    resume(s1, e, st, null)
  },
  "ws_recv": try_fd(s, e, req, st, EPOLLIN),
  "ws_send": try_fd(s, e, req, st, EPOLLOUT),
  "ws_close": do {
    _ := drop_interest(s, req.fd)
    _ := ws_close_conn(req.h)
    s1 := hash_map.set(s, "fdw",
      drop_where(s.fdw, (w) ~> w.fd == req.fd))
    resume(s1, e, st, null)
  },
  "close": do {
    _ := drop_interest(s, req.fd)
    _ := close(req.fd)
    stranded := drop_where(s.fdw, (w) ~> w.fd != req.fd)
    s1 := hash_map.set(s, "fdw", drop_where(s.fdw, (w) ~> w.fd == req.fd))
    s2 := while { xs: stranded, s: s1 } {
      (xs, s) ~> match xs {
        []: { out: s },
        [w, ...t]: {
          state: { xs: t, s: resume(s, w, w.state, { err: EBADF }) }
        }
      }
    }
    resume(s2, e, st, null)
  },
  "chan_new": do {
    id := s.next_chan
    s1 := hash_map.set(s, "next_chan", id + 1)
    s2 := hash_map.set(s1, "chans", [...s1.chans, { id: id, cap: req.cap, queue: [] }])
    resume(s2, e, st, id)
  },
  "chan_send": chan_send(s, e, req, st),
  "chan_recv": chan_recv(s, e, req, st, [req.chan], false),
  "chan_select": chan_recv(s, e, req, st, req.chans, true),
  "mutex_new": do {
    id := s.next_mutex
    s1 := hash_map.set(s, "next_mutex", id + 1)
    s2 := hash_map.set(s1, "mutexes", [...s1.mutexes,
      { id: id, held: false, queue: [] }])
    resume(s2, e, st, id)
  },
  "mutex_lock": mutex_lock(s, e, req, st),
  "mutex_unlock": mutex_unlock(s, e, req, st),
  "rwlock_new": do {
    id := s.next_rw
    s1 := hash_map.set(s, "next_rw", id + 1)
    s2 := hash_map.set(s1, "rwlocks", [...s1.rwlocks,
      { id: id, readers: 0, writer: 0, rq: [], wq: [] }])
    resume(s2, e, st, id)
  },
  "read_lock": rw_lock(s, e, req, st, false),
  "write_lock": rw_lock(s, e, req, st, true),
  "rw_unlock": rw_unlock(s, e, req, st),
  "sem_new": do {
    id := s.next_sem
    s1 := hash_map.set(s, "next_sem", id + 1)
    s2 := hash_map.set(s1, "sems", [...s1.sems,
      { id: id, count: req.n, queue: [] }])
    resume(s2, e, st, id)
  },
  "sem_acquire": sem_op(s, e, req, st, true),
  "sem_release": sem_op(s, e, req, st, false),
  "atomic_new": do {
    id := s.next_atomic
    s1 := hash_map.set(s, "next_atomic", id + 1)
    s2 := hash_map.set(s1, "atomics", [...s1.atomics, { id: id, value: req.value }])
    resume(s2, e, st, id)
  },
  "atomic_read": resume(s, e, st,
    hash_map.get_or(sync_of(s.atomics, req.atomic), "value", null)),
  "atomic_write": do {
    a := sync_of(s.atomics, req.atomic)
    s1 := set_in(s, "atomics", s.atomics, hash_map.set(a, "value", req.value))
    resume(s1, e, st, a.value)
  },
  "atomic_cas": do {
    a := sync_of(s.atomics, req.atomic)
    if a.value == req.expect {
      s1 := set_in(s, "atomics", s.atomics, hash_map.set(a, "value", req.value))
      resume(s1, e, st, true)
    } else {
      resume(s, e, st, false)
    }
  },
  "token_new": do {
    id := s.next_token
    s1 := hash_map.set(s, "next_token", id + 1)
    s2 := hash_map.set(s1, "tokens", [...s1.tokens, { id: id, cancelled: false }])
    resume(s2, e, st, id)
  },
  "cancel": do {
    t := sync_of(s.tokens, req.token)
    s1 := set_in(s, "tokens", s.tokens, hash_map.set(t, "cancelled", true))
    resume(s1, e, st, { cancelled: true })
  },
  "cancelled": resume(s, e, st, token_set(s, req.token)),
  _: error.raise("concurrent-epoll: unknown req " + req.name)
}

-- ---------------------------------------------------------------
-- the loop
-- ---------------------------------------------------------------

--- one runnable task takes one step
tick := (s) ~> do {
  e := afirst(s.runq)
  s1 := hash_map.set(s, "runq", adrop(s.runq, 1))
  if token_set(s1, e.token) {
    finish_task(s1, e, { cancelled: true })
  } else {
    f := e.arrow
    step := f(e.input)
    if has_field(step, "out") {
      if ais_empty(e.stack) {
        finish_task(s1, e, step.out)
      } else {
        fr := afirst(e.stack)
        hash_map.set(s1, "runq", [...s1.runq, {
          id: e.id, arrow: fr.arrow,
          input: hash_map.set(fr.state, "result", step.out),
          stack: adrop(e.stack, 1), token: e.token
        }])
      }
    } else if has_field(step, "call") {
      perform(s1, e, step.call, step.state)
    } else {
      hash_map.set(s1, "runq", [...s1.runq, {
        id: e.id, arrow: e.arrow, input: step.state,
        stack: e.stack, token: e.token
      }])
    }
  }
}

--- fire every expired timer; resumes with { timeout: task } for
--- await_timeout pairs (their `tw` entry is dropped) and null for sleep
fire_timers := (s) ~> do {
  if ais_empty(s.timers) {
    s
  } else {
    now := now_ms(null)
    due := drop_where(s.timers, (t) ~> t.deadline <= now)
    fired := drop_where(s.timers, (t) ~> t.deadline > now)
    s1 := hash_map.set(s, "timers", due)
    while { xs: fired, s: s1 } {
      (xs, s) ~> match xs {
        []: { out: s },
        [t, ...rest]: do {
          s2 := if t.await_task > 0 {
            hash_map.set(s, "tw",
              drop_where(s.tw, (w) ~> w.id == t.id && w.task == t.await_task))
          } else {
            s
          }
          v := if t.await_task > 0 { { timeout: t.await_task } } else { null }
          { state: { xs: rest, s: resume(s2, t, t.state, v) } }
        }
      }
    }
  }
}

--- ms until the next deadline; -1 when no timers are armed. When curl
--- multi transfers are in flight, curl's own timeout caps it.
next_timeout := (s) ~> do {
  base := if ais_empty(s.timers) {
    -1
  } else {
    do {
      d := while { xs: s.timers, d: afirst(s.timers).deadline } {
        (xs, d) ~> match xs {
          []: { out: d },
          [t, ...rest]: if t.deadline < d {
            { state: { xs: rest, d: t.deadline } }
          } else {
            { state: { xs: rest, d: d } }
          }
        }
      }
      dt := d - now_ms(null)
      if dt < 0 { 0 } else { dt }
    }
  }
  if ais_empty(s.mwait) {
    base
  } else if ais_empty(s.cfds) {
    -- curl has no sockets for us to wait on (between states or about
    -- to create them): poll briefly so multi_drive runs again instead
    -- of blocking forever on an empty fd set.
    if base < 0 || base > 20 { 20 } else { base }
  } else {
    do {
      t := curl_multi_timeout(s.multi, 0)
      cto := if is_err(t) { -1 } else { val_of(t).vals[0] }
      eff := if cto < 0 {
        base
      } else if base < 0 {
        cto
      } else if cto < base {
        cto
      } else {
        base
      }
      -- never block indefinitely while transfers are in flight: if a
      -- registered fd is dropped or curl stalls, re-drive every ~1s.
      if eff < 0 || eff > 1000 { 1000 } else { eff }
    }
  }
}

--- runq is empty: block in epoll_wait until an fd fires or a timer
--- expires, then wake what arrived.
poll_block := (s) ~> do {
  s1 := ensure_epfd(s)
  w := unwrap(epoll_wait(s1.epfd, 32, next_timeout(s)), "epoll_wait")
  ids := while { i: 0, acc: [] } {
    (i, acc) ~> if i < w.ret {
      { state: { i: i + 1, acc: [...acc, u64le(w.buf, i * 12 + 4)] } }
    } else {
      { out: acc }
    }
  }
  s2 := while { xs: ids, s: s1 } {
    (xs, s) ~> match xs {
      []: { out: s },
      [id, ...rest]: do {
        s2 := if id >= CURL_TAG {
          s
        } else {
          do {
            f := find_where(s.fdw, (x) ~> x.id == id)
            if f == null { s } else { wake_fd(s, f) }
          }
        }
        { state: { xs: rest, s: s2 } }
      }
    }
  }
  -- a curl fd event or a timer-cap expiry both want a multi drive;
  -- info_read drains completions either way
  if ais_empty(s2.mwait) { s2 } else { multi_drive(s2) }
}

new_sched := (task, init) ~> ({
  epfd: null,
  multi: null, mwait: [], cfds: [],
  runq: [{ id: 1, arrow: task, input: init, stack: [], token: null }],
  fdw: [], cw: [], tw: [], timers: [],
  chans: [], mutexes: [], rwlocks: [], sems: [], atomics: [], tokens: [],
  live: [1], results: [],
  next_id: 2, next_chan: 1, next_mutex: 1, next_rw: 1,
  next_sem: 1, next_atomic: 1, next_token: 1
})

final := (s) ~> ({
  main: hash_map.get_or(
    find_where(s.results, (r) ~> r.id == 1), "value", null),
  results: s.results
})

--- run tasks until the main task (id 1) completes: drain the runq;
--- when it empties fire due timers; when nothing can wake the parked
--- tasks that's a deadlock; otherwise block in epoll_wait. Spawned
--- daemon tasks (e.g. an accept loop) may still be live when main
--- finishes -- run abandons them.
export run := (task, init) ~> do {
  fin := while new_sched(task, init) {
    (s) ~> do {
      if alen(s.runq) > 0 {
        { state: tick(s) }
      } else {
        s1 := fire_timers(s)
        if alen(s1.runq) > 0 {
          { state: s1 }
        } else if ais_empty(s1.live)
            || find_where(s1.results, (r) ~> r.id == 1) != null {
          { out: s1 }
        } else if ais_empty(s1.fdw) && ais_empty(s1.timers)
            && ais_empty(s1.mwait) {
          { out: s1 }
        } else {
          { state: poll_block(s1) }
        }
      }
    }
  }
  _ := if fin.epfd == null { null } else { close(fin.epfd) }
  _ := if fin.multi == null { null } else { curl_multi_cleanup(fin.multi) }
  if ais_empty(fin.live)
      || find_where(fin.results, (r) ~> r.id == 1) != null {
    final(fin)
  } else {
    { deadlock: fin.live }
  }
}
