--- intl-c -- `intl` contract backend over the system ICU4C libraries.
---
--- Implements the `intl.*` surface declared in `handl-packages/intl/intl.hnl`
--- on the host's `libicui18n` + `libicuuc` via the sdkgen-generated bindings
--- in `handl-packages/generated/icu-c-linux-x86_64/` and
--- `handl-packages/generated/icu-uc-c-linux-x86_64/` (produced by
--- `generated/icu.sdkgen.yaml` / `generated/icu-uc.sdkgen.yaml`; regenerate
--- on ICU major-version bumps —
--- symbol names carry the `urename.h` suffix, e.g. `ucol_open_78`).
---
--- The handwritten layer keeps what generation cannot express:
---
--- - sonames probed bare, then `.<major>` 99..50 via `ffi.load`, and the ICU
---   symbol-version suffix discovered by probing `u_getVersion_N` (drives the
---   `available`/`icu_version` exports);
--- - strings marshal as little-endian UTF-16 (`UChar`) byte buffers, with
---   unit-count (not byte-count) lengths;
--- - `UErrorCode*` status words ride `io_scalar:i32` readbacks — generated
---   bindings report `ok {ret, vals}` and this layer interprets `vals[last]`;
--- - list formatting composes CLDR `listPattern` resources in handl — the
---   `ulistfmt_format` C API needs a `UChar*[]` the ffi descriptors cannot
---   express;
--- - ISO date strings parse to epoch ms in handl (civil→days) so callers can
---   pass "YYYY-MM-DD[THH:mm[:ss][Z|±hh:mm]]" as well as raw ms.
---
--- Every public arrow returns `ok v` / `err msg`: expected backend failures
--- (missing ICU, failing status codes, bad locales) are values, never raises.

-- `ffi`, `char`, `type`, `tag` are not package-table modules: they resolve
-- through the host module chain, so their members are reached by qualified
-- call (`ffi.call`, `char.chars`, ...) with no import line — the same way
-- `compress-gzip-c` reaches `tag.*`/`error.*`.

from "result" import { ok, err }
from "bytes" import * as bytes

-- sdkgen-generated ICU4C adapters (libicui18n) — `from "../generated/..."
-- resolves by path under the file loader and basename-normalizes to the
-- `ucol`/`unum`/... table modules under the stdlib chain.
from "../generated/icu-c-linux-x86_64/ucol" import * as ucol
from "../generated/icu-c-linux-x86_64/unum" import * as unum
from "../generated/icu-c-linux-x86_64/upluralrules" import * as upluralrules
from "../generated/icu-c-linux-x86_64/ureldatefmt" import * as ureldatefmt
from "../generated/icu-c-linux-x86_64/udat" import * as udat
from "../generated/icu-c-linux-x86_64/ufieldpositer" import * as ufieldpositer
from "../generated/icu-c-linux-x86_64/unumberformatter" import * as unumf
from "../generated/icu-c-linux-x86_64/uformattednumber" import * as ufnum

-- sdkgen-generated ICU4C adapters (libicuuc).
from "../generated/icu-uc-c-linux-x86_64/ubrk" import * as ubrk
from "../generated/icu-uc-c-linux-x86_64/uloc" import * as uloc
from "../generated/icu-uc-c-linux-x86_64/uldnames" import * as uldnames
from "../generated/icu-uc-c-linux-x86_64/ures" import * as ures

-- NOTE: exports are intentionally untyped (`export f := ...`, not
-- `export f: CompareStrings := ...`). The `hnl test` file-loader treats an
-- export's type annotation as a callee (`Type(value)`), which fails for
-- imported arrow types — a module_prep limitation shared by all `*-c`
-- packages. Conformance to the `intl` contract stays nominal.

-- ffi result probing ---------------------------------------------------------

-- `ffi.load`/`ffi.sym` return `{__tag__: "ok"}` / `{__tag__: "err", ...}`.
is_ok := (r) ~> if r == null { false } else { r.__tag__ == "ok" }

try_load := (name) ~> if is_ok(ffi.load(name)) { name } else { null }

-- `stem` is e.g. "libicui18n.so"; probe the bare soname, then `stem.<major>`.
find_lib := (stem) ~> do {
  hit = try_load(stem)
  if hit != null { hit } else {
    while { v: 99, found: null } {
      (v, found) ~> if found != null || v < 50 {
        { out: found }
      } else {
        { state: { v: v - 1, found: try_load(stem + "." + type.to_string(v)) } }
      }
    }
  }
}

-- ICU renames exported symbols with the library major (`ucol_open_78`).
-- Probe `u_getVersion_N` to discover N.
find_version := (lib) ~> while { v: 99, found: 0 } {
  (v, found) ~> if found > 0 || v < 50 {
    { out: found }
  } else {
    { state: { v: v - 1, found: if is_ok(ffi.sym(lib, "u_getVersion_" + type.to_string(v))) { v } else { 0 } } }
  }
}

-- NOTE: every call into this module re-evaluates these privates; `ffi.load`
-- / `ffi.sym` hits are cached in the runtime so re-probing is cheap.
i18n := find_lib("libicui18n.so")

uc := find_lib("libicuuc.so")

icu_ver := if i18n == null { 0 } else { find_version(i18n) }

sfx := "_" + type.to_string(icu_ver)

avail := i18n != null && uc != null && icu_ver > 0

-- UTF-16 codec ---------------------------------------------------------------

-- UTF-8 decode over integer bytes: continuation bytes contribute 6 bits.
-- `bytes.to_list` yields real ints; `math.shl`/`bit_*` keep them ints —
-- `char.code_point` returns floats which the FFI byte marshal rejects.
u8_cp1 := (b, t) ~> match t {
  [b1, ...t1]: { cp: math.bit_or(math.shl(math.bit_and(b, 31), 6), math.bit_and(b1, 63)), rest: t1 },
  _: { cp: 65533, rest: t }
}

u8_cp2 := (b, t) ~> match t {
  [b1, b2, ...t2]: {
    cp: math.bit_or(math.bit_or(math.shl(math.bit_and(b, 15), 12), math.shl(math.bit_and(b1, 63), 6)), math.bit_and(b2, 63)),
    rest: t2
  },
  _: { cp: 65533, rest: [] }
}

u8_cp3 := (b, t) ~> match t {
  [b1, b2, b3, ...t3]: {
    cp: math.bit_or(math.bit_or(math.shl(math.bit_and(b, 7), 18), math.shl(math.bit_and(b1, 63), 12)), math.bit_or(math.shl(math.bit_and(b2, 63), 6), math.bit_and(b3, 63))),
    rest: t3
  },
  _: { cp: 65533, rest: [] }
}

-- cp >= 0x10000 -> surrogate pair. Returns LE bytes, lead surrogate first.
enc_pair := (u) ~> do {
  hi = 55296 + math.shr(u, 10)
  lo = 56320 + math.bit_and(u, 1023)
  [math.bit_and(hi, 255), math.shr(hi, 8), math.bit_and(lo, 255), math.shr(lo, 8)]
}

enc_cp := (cp) ~> if cp < 65536 {
  [math.bit_and(cp, 255), math.shr(cp, 8)]
} else {
  enc_pair(cp - 65536)
}

-- one UTF-8 step: decode the head byte's class and append its LE u16 bytes
u8_step := (b, t, acc) ~> if b < 128 {
  { state: { bs: t, acc: [...acc, ...enc_cp(b)] } }
} else if b < 224 {
  s = u8_cp1(b, t)
  { state: { bs: s.rest, acc: [...acc, ...enc_cp(s.cp)] } }
} else if b < 240 {
  s = u8_cp2(b, t)
  { state: { bs: s.rest, acc: [...acc, ...enc_cp(s.cp)] } }
} else {
  s = u8_cp3(b, t)
  { state: { bs: s.rest, acc: [...acc, ...enc_cp(s.cp)] } }
}

list_len := (xs) ~> while { xs: xs, n: 0 } {
  (xs, n) ~> match xs {
    []: { out: n },
    [_, ...t]: { state: { xs: t, n: n + 1 } }
  }
}

-- string -> { bytes: Bytes, len: <u16 unit count> }
utf16_enc := (s) ~> while { bs: bytes.to_list(bytes.utf8_encode(s)), acc: [] } {
  (bs, acc) ~> match bs {
    []: { out: { bytes: bytes.from_list(acc), len: math.shr(list_len(acc), 1) } },
    [b, ...t]: u8_step(b, t, acc)
  }
}

-- LE byte list -> u16 unit list
to_units := (bs) ~> while { bs: bs, acc: [] } {
  (bs, acc) ~> match bs {
    []: { out: acc },
    [lo]: { out: [...acc, lo] },
    [lo, hi, ...t]: { state: { bs: t, acc: [...acc, lo + hi * 256] } }
  }
}

-- combine a lead surrogate `hi` with the next unit of `us`; `n`/`acc` are
-- the decode loop's remaining-unit budget and char accumulator
dec_rest := (hi, us, n, acc) ~> match us {
  []: { out: char.from_chars(acc) },
  [lo, ...t]: { state: { us: t, n: n - 2, acc: [...acc, char.from_code_point(65536 + (hi - 55296) * 1024 + lo - 56320)] } }
}

-- one decode step: BMP unit, or a surrogate pair consuming two units
dec_step := (u, t, n, acc) ~> if u >= 55296 && u < 56320 {
  dec_rest(u, t, n, acc)
} else {
  { state: { us: t, n: n - 1, acc: [...acc, char.from_code_point(u)] } }
}

-- decode only the first `n` of unit list `us` (`unum_formatDouble` reports
-- the written length in `ret`; `out_ptr` returns the whole capacity)
utf16_dec := (us, n) ~> while { us: us, n: n, acc: [] } {
  (us, n, acc) ~> match us {
    []: { out: char.from_chars(acc) },
    [u, ...t]: if n <= 0 {
      { out: char.from_chars(acc) }
    } else {
      dec_step(u, t, n, acc)
    }
  }
}

-- shared helpers ---------------------------------------------------------------

-- Generated bindings return `Result<payload, Errno>`; payloads carry the
-- raw `{ret, buf, vals}` record. `vals[last]` is the `UErrorCode` for
-- status-tail functions (0 = OK, <0 = warning, >0 = failure). ICU ""
-- locale = root, the deterministic default.
loc_or_root := (locale) ~> if locale == null { "" } else { locale }

payload := (r) ~> if tag.tag_of(r) == "err" { null } else { tag.untag(r).value }

-- decode a formatted UTF-16 buffer (`ret` units written into `buf`)
rd16 := (v) ~> utf16_dec(to_units(bytes.to_list(v.buf)), v.ret)

-- `v` unless null → `d` (option-field default)
nz := (v, d) ~> if v == null { d } else { v }

-- options arg → record; non-record (null/string/number) degrades to {}
opt_rec := (o) ~> if type.of(o) == "object" { o } else { {} }

-- list / char-list helpers -----------------------------------------------------

take := (xs, n) ~> while { xs: xs, n: n, acc: [] } {
  (xs, n, acc) ~> if n <= 0 { { out: acc } } else {
    match xs {
      []: { out: acc },
      [h, ...t]: { state: { xs: t, n: n - 1, acc: [...acc, h] } }
    }
  }
}

drop := (xs, n) ~> while { xs: xs, n: n } {
  (xs, n) ~> if n <= 0 { { out: xs } } else {
    match xs {
      []: { out: xs },
      [_, ...t]: { state: { xs: t, n: n - 1 } }
    }
  }
}

at := (xs, i) ~> match drop(xs, i) {
  [h, ..._]: h,
  _: null
}

-- unwrap a `{ret, buf, vals}` result into `ok v` / `err "<what> failed…"`.
statused := (r, what) ~> do {
  v = payload(r)
  if type.of(v) != "object" {
    err(what)
  } else {
    vs = nz(v.vals, [])
    st = nz(at(vs, list_len(vs) - 1), 0)
    if st > 0 {
      err(what + " code " + type.to_string(st))
    } else {
      ok(v)
    }
  }
}

map_list := (xs, f) ~> while { xs: xs, acc: [] } {
  (xs, acc) ~> match xs {
    []: { out: acc },
    [h, ...t]: { state: { xs: t, acc: [...acc, f(h)] } }
  }
}

imin := (a, b) ~> if a < b { a } else { b }

list_has := (xs, v) ~> while { xs: xs, hit: false } {
  (xs, hit) ~> if hit { { out: true } } else {
    match xs {
      []: { out: false },
      [h, ...t]: { state: { xs: t, hit: h == v } }
    }
  }
}

-- unit slice [i, j) of a UTF-16 unit list
uslice := (us, i, j) ~> take(drop(us, i), j - i)

-- NUL-terminated cstr readback: bytes up to the first 0
cstr_of := (buf) ~> do {
  bs = bytes.to_list(buf)
  i = while { i: 0 } {
    (st) ~> if st.i >= list_len(bs) || at(bs, st.i) == 0 {
      { out: st.i }
    } else {
      { state: { i: st.i + 1 } }
    }
  }
  bytes.utf8_decode(bytes.from_list(take(bs, i)))
}

-- string prefix test via char lists
starts_with := (s, p) ~> do {
  cs = char.chars(s)
  ps = char.chars(p)
  if list_len(ps) > list_len(cs) { false } else { take(cs, list_len(ps)) == ps }
}

-- first index of `needle` in `s` (char units), or -1
find_sub := (s, needle) ~> do {
  cs = char.chars(s)
  ns = char.chars(needle)
  nn = list_len(ns)
  while { i: 0, hit: -1 } {
    (i, hit) ~> if hit >= 0 || i + nn > list_len(cs) {
      { out: hit }
    } else {
      { state: { i: i + 1, hit: if take(drop(cs, i), nn) == ns { i } else { -1 } } }
    }
  }
}

-- replace the first occurrence of `needle` in `s` with `repl`
sub_first := (s, needle, repl) ~> do {
  cs = char.chars(s)
  i = find_sub(s, needle)
  if i < 0 { s } else {
    char.from_chars([...take(cs, i), ...char.chars(repl), ...drop(cs, i + list_len(char.chars(needle)))])
  }
}

-- replace every occurrence of `needle` in `s` (bounded guard)
sub_all := (s, needle, repl) ~> while { s: s, guard: 100 } {
  (s, guard) ~> if guard <= 0 || find_sub(s, needle) < 0 {
    { out: s }
  } else {
    { state: { s: sub_first(s, needle, repl), guard: guard - 1 } }
  }
}

-- "{0}→a, {1}→b" — CLDR list-pattern substitution
fmt2 := (pat, a, b) ~> sub_first(sub_first(pat, "{0}", a), "{1}", b)

-- ISO date parsing ---------------------------------------------------------------

dig := (c) ~> char.code_point(c) - 48

-- `n` digits of char list `cs` starting at `i` → int
ndig := (cs, i, n) ~> while { j: 0, acc: 0 } {
  (j, acc) ~> if j >= n {
    { out: acc }
  } else {
    { state: { j: j + 1, acc: acc * 10 + dig(at(cs, i + j)) } }
  }
}

-- days since 1970-01-01 for a civil y/m/d (Hinnant's days_from_civil)
days_from_civil := (y, m, d) ~> do {
  yy = if m <= 2 { y - 1 } else { y }
  era = if yy >= 0 { math.floor_div(yy, 400) } else { math.floor_div(yy - 399, 400) }
  yoe = yy - era * 400
  doy = math.floor_div(153 * (if m > 2 { m - 3 } else { m + 9 }) + 2, 5) + d - 1
  doe = yoe * 365 + math.floor_div(yoe, 4) - math.floor_div(yoe, 100) + doy
  era * 146097 + doe - 719468
}

-- "YYYY-MM-DD[ T]HH:mm[:ss[.sss]][Z|±hh[:mm|mm]]" → epoch ms, or null.
-- Strict digit positions; zone defaults to UTC; date-only → UTC midnight.
parse_iso_ms := (s) ~> do {
  cs = char.chars(s)
  n = list_len(cs)
  if n < 10 || at(cs, 4) != "-" || at(cs, 7) != "-" {
    null
  } else {
    y = ndig(cs, 0, 4)
    mo = ndig(cs, 5, 2)
    d = ndig(cs, 8, 2)
    -- first zone marker ('Z', '+', '-') at index ≥ 10; time ends there
    zi = while { i: 10, z: -1 } {
      (i, z) ~> if z >= 0 || i >= n {
        { out: z }
      } else {
        c = at(cs, i)
        { state: { i: i + 1, z: if c == "Z" || c == "+" || c == "-" { i } else { -1 } } }
      }
    }
    tend = if zi < 0 { n } else { zi }
    has_time = tend > 11 && (at(cs, 10) == "T" || at(cs, 10) == " ")
    if has_time && (tend < 16 || at(cs, 13) != ":") {
      null
    } else {
      hh = if has_time { ndig(cs, 11, 2) } else { 0 }
      mm = if has_time { ndig(cs, 14, 2) } else { 0 }
      ss = if has_time && tend >= 19 && at(cs, 16) == ":" { ndig(cs, 17, 2) } else { 0 }
      fk = if has_time && tend > 20 && at(cs, 19) == "." { imin(3, tend - 20) } else { 0 }
      fms = if fk == 0 { 0 } else { ndig(cs, 20, fk) * (if fk == 1 { 100 } else if fk == 2 { 10 } else { 1 }) }
      off = if zi < 0 || at(cs, zi) == "Z" { 0 } else {
        sgn = if at(cs, zi) == "-" { -1 } else { 1 }
        oh = ndig(cs, zi + 1, 2)
        om = if n >= zi + 6 && at(cs, zi + 3) == ":" { ndig(cs, zi + 4, 2) } else if n >= zi + 5 { ndig(cs, zi + 3, 2) } else { 0 }
        sgn * (oh * 60 + om) * 60000
      }
      days_from_civil(y, mo, d) * 86400000 + hh * 3600000 + mm * 60000 + ss * 1000 + fms - off
    }
  }
}

-- collation --------------------------------------------------------------------

-- `ucol_strcoll` → UCollationResult (-1/0/1); closes `coll` first.
cmp_finish := (coll, a, b) ~> do {
  ea = utf16_enc(a)
  eb = utf16_enc(b)
  rc = ucol.ucol_strcoll_78(coll, ea.bytes, ea.len, eb.bytes, eb.len)
  _ = ucol.ucol_close_78(coll)
  if tag.tag_of(rc) == "err" {
    err("ucol_strcoll failed")
  } else {
    ok(tag.untag(rc).value)
  }
}

-- option attributes: sensitivity (UCOL_STRENGTH=5 + CASE_LEVEL=3 for "case"),
-- caseFirst (UCOL_CASE_FIRST=2), numeric (UCOL_NUMERIC_COLLATION=7)
cmp_attrs := (coll, o) ~> do {
  _s = match o.sensitivity {
    "base": ucol.ucol_setAttribute_78(coll, 5, 0, 0),
    "accent": ucol.ucol_setAttribute_78(coll, 5, 1, 0),
    "case": do {
      _1 = ucol.ucol_setAttribute_78(coll, 5, 0, 0)
      ucol.ucol_setAttribute_78(coll, 3, 17, 0)
    },
    _: ucol.ucol_setAttribute_78(coll, 5, 2, 0)
  }
  _c = match o.caseFirst {
    "upper": ucol.ucol_setAttribute_78(coll, 2, 25, 0),
    "lower": ucol.ucol_setAttribute_78(coll, 2, 24, 0),
    "false": ucol.ucol_setAttribute_78(coll, 2, 16, 0),
    _: 0
  }
  _n = if nz(o.numeric, false) { ucol.ucol_setAttribute_78(coll, 7, 17, 0) } else { 0 }
  coll
}

cmp_open := (a, b, locale, opts) ~> do {
  r = statused(ucol.ucol_open_78(loc_or_root(locale), 0), "ucol_open")
  if tag.tag_of(r) == "err" {
    r
  } else {
    coll = cmp_attrs(tag.untag(r).value.ret, opt_rec(opts))
    cmp_finish(coll, a, b)
  }
}

-- number formatting --------------------------------------------------------------

-- UNumberFormatStyle for opts.style (decimal=1 default)
num_style := (o) ~> match o.style {
  "currency": 2, "percent": 3, "scientific": 4, "spellout": 5,
  "ordinal": 6, "duration": 7, _: 1
}

-- option attributes after unum_open: currency code (UNUM_CURRENCY_CODE=5,
-- UTF-16 text), fraction/integer digit limits, grouping off
num_attrs := (fmt, o) ~> do {
  _c = if o.currency == null { 0 } else { do {
    e = utf16_enc(o.currency)
    unum.unum_setTextAttribute_78(fmt, 5, e.bytes, e.len, 0)
  } }
  _a = if o.minimumFractionDigits == null { 0 } else { unum.unum_setAttribute_78(fmt, 7, o.minimumFractionDigits, 0) }
  _b = if o.maximumFractionDigits != null { unum.unum_setAttribute_78(fmt, 6, o.maximumFractionDigits, 0) } else if o.style == "scientific" { unum.unum_setAttribute_78(fmt, 6, 3, 0) } else { 0 }
  -- ECMA-402 rounds half away from zero ("1.2345" → "1.235"); ICU defaults
  -- to half-even. UNUM_ROUNDING_MODE=11, UNUM_ROUND_HALFUP=6.
  _r = unum.unum_setAttribute_78(fmt, 11, 6, 0)
  _d = if o.minimumIntegerDigits == null { 0 } else { unum.unum_setAttribute_78(fmt, 4, o.minimumIntegerDigits, 0) }
  _e = if o.maximumIntegerDigits == null { 0 } else { unum.unum_setAttribute_78(fmt, 3, o.maximumIntegerDigits, 0) }
  _g = if nz(o.useGrouping, true) { 0 } else { unum.unum_setAttribute_78(fmt, 1, 0, 0) }
  fmt
}

num_run := (fmt, n) ~> do {
  r = statused(unum.unum_formatDouble_78(fmt, n, 256, 0, 0), "unum_formatDouble")
  _ = unum.unum_close_78(fmt)
  if tag.tag_of(r) == "err" { r } else { ok(rd16(tag.untag(r).value)) }
}

-- UNUM field id → part type; UNUM_SIGN=10 falls to `_` and `seg` decides
num_part_type := (f, seg) ~> match f {
  0: "integer", 1: "fraction", 2: "decimal", 3: "exponentSeparator",
  4: if seg == "-" { "exponentMinusSign" } else if seg == "+" { "exponentPlusSign" } else { "exponentSign" },
  5: "exponentInteger", 6: "group", 7: "currency",
  8: "percentSign", 9: "permilleSign", 11: "unit", 12: "compact",
  13: "approximatelySign",
  _: if seg == "-" { "minusSign" } else if seg == "+" { "plusSign" } else { "sign" }
}

-- walk UFieldPositionIterator until done (-1) → [{field, b, e}]
iter_fields := (iter) ~> while { acc: [], done: false } {
  (acc, done) ~> if done { { out: acc } } else { do {
    v = payload(ufieldpositer.ufieldpositer_next_78(iter, 0, 0))
    if v == null || v.ret < 0 {
      { out: acc }
    } else {
      { state: { acc: [...acc, { field: v.ret, b: at(v.vals, 0), e: at(v.vals, 1) }], done: false } }
    }
  } }
}

-- innermost field covering unit i: nested spans (e.g. a group separator
-- inside an integer run) win by smallest extent; uncovered → null
field_at := (spans, i) ~> while { ss: spans, best: null, bw: 0 } {
  (ss, best, bw) ~> match ss {
    []: { out: best },
    [s, ...t]: do {
      w = s.e - s.b
      if s.b <= i && i < s.e && (best == null || w < bw) {
        { state: { ss: t, best: s.field, bw: w } }
      } else {
        { state: { ss: t, best: best, bw: bw } }
      }
    }
  }
}

emit_part := (units, f, a, b, namer) ~> if b <= a { null } else {
  seg = utf16_dec(uslice(units, a, b), b - a)
  { type: if f == null { "literal" } else { namer(f, seg) }, value: seg }
}

-- field spans → [{type, value}]. ICU reports nested spans (UNUM_INTEGER
-- covers the whole run including its UNUM_GROUPING_SEPARATOR spans), so
-- partition the string per-unit by innermost covering field; uncovered
-- runs become "literal".
parts_fill := (units, len, spans, namer) ~> while { i: 0, cur: null, a0: 0, acc: [] } {
  (i, cur, a0, acc) ~> if i >= len {
    p = emit_part(units, cur, a0, len, namer)
    { out: if p == null { acc } else { [...acc, p] } }
  } else {
    f = field_at(spans, i)
    if f == cur {
      { state: { i: i + 1, cur: cur, a0: a0, acc: acc } }
    } else {
      p = emit_part(units, cur, a0, i, namer)
      { state: { i: i + 1, cur: f, a0: i, acc: if p == null { acc } else { [...acc, p] } } }
    }
  }
}

num_parts_run := (fmt, n) ~> do {
  fi = statused(ufieldpositer.ufieldpositer_open_78(0), "ufieldpositer_open")
  if tag.tag_of(fi) == "err" {
    _ = unum.unum_close_78(fmt)
    fi
  } else {
    iter = tag.untag(fi).value.ret
    r = statused(unum.unum_formatDoubleForFields_78(fmt, n, 256, iter, 0), "unum_formatDoubleForFields")
    spans = iter_fields(iter)
    _1 = ufieldpositer.ufieldpositer_close_78(iter)
    _2 = unum.unum_close_78(fmt)
    if tag.tag_of(r) == "err" { r } else {
      v = tag.untag(r).value
      ok(parts_fill(to_units(bytes.to_list(v.buf)), v.ret, spans, num_part_type))
    }
  }
}

-- `parts` picks formatDouble vs formatDoubleForFields
num_with := (n, locale, opts, parts) ~> do {
  o = opt_rec(opts)
  r = statused(unum.unum_open_78(num_style(o), 0, 0, loc_or_root(locale), 0, 0), "unum_open")
  if tag.tag_of(r) == "err" { r } else {
    fmt = num_attrs(tag.untag(r).value.ret, o)
    if parts { num_parts_run(fmt, n) } else { num_run(fmt, n) }
  }
}

-- plural selection -----------------------------------------------------------------

select_plural_impl := (n, locale, opts) ~> do {
  o = opt_rec(opts)
  ptype = if o.type == "ordinal" { 1 } else { 0 }
  r = statused(upluralrules.uplrules_openForType_78(loc_or_root(locale), ptype, 0), "uplrules_open")
  if tag.tag_of(r) == "err" { r } else {
    rules = tag.untag(r).value.ret
    s = statused(upluralrules.uplrules_select_78(rules, n, 64, 0), "uplrules_select")
    _ = upluralrules.uplrules_close_78(rules)
    if tag.tag_of(s) == "err" { s } else { ok(rd16(tag.untag(s).value)) }
  }
}

-- relative time ----------------------------------------------------------------------

rel_unit := (u) ~> match u {
  "year": 0, "years": 0, "quarter": 1, "quarters": 1, "month": 2, "months": 2,
  "week": 3, "weeks": 3, "day": 4, "days": 4, "hour": 5, "hours": 5,
  "minute": 6, "minutes": 6, "second": 7, "seconds": 7, _: -1
}

format_relative_time_impl := (n, unit, locale, opts) ~> do {
  o = opt_rec(opts)
  u = rel_unit(unit)
  if u < 0 { err("unsupported relative-time unit: " + type.to_string(unit)) } else {
    width = match o.style { "short": 1, "narrow": 2, _: 0 }
    r = statused(ureldatefmt.ureldatefmt_open_78(loc_or_root(locale), 0, width, 256, 0), "ureldatefmt_open")
    if tag.tag_of(r) == "err" { r } else {
      fmt = tag.untag(r).value.ret
      f = if o.numeric == "always" {
        ureldatefmt.ureldatefmt_formatNumeric_78(fmt, n, u, 256, 0)
      } else {
        ureldatefmt.ureldatefmt_format_78(fmt, n, u, 256, 0)
      }
      s = statused(f, "ureldatefmt_format")
      _ = ureldatefmt.ureldatefmt_close_78(fmt)
      if tag.tag_of(s) == "err" { s } else { ok(rd16(tag.untag(s).value)) }
    }
  }
}

-- date formatting -----------------------------------------------------------------------

-- UDAT style numbers: full=0 long=1 medium=2 short=3, -1 = NONE/absent
date_style_num := (v) ~> match v { "full": 0, "long": 1, "medium": 2, "short": 3, _: -1 }

-- {ds, ts} for udat_open; neither given → medium date, no time
date_styles := (o) ~> do {
  ds = date_style_num(o.dateStyle)
  ts = date_style_num(o.timeStyle)
  if ds < 0 && ts < 0 { { ds: 2, ts: -1 } } else { { ds: ds, ts: ts } }
}

date_ms_of := (v) ~> if type.of(v) == "number" { v } else if type.of(v) == "string" { parse_iso_ms(v) } else { null }

date_run := (fmt, ms) ~> do {
  r = statused(udat.udat_format_78(fmt, ms, 256, 0, 0), "udat_format")
  _ = udat.udat_close_78(fmt)
  if tag.tag_of(r) == "err" { r } else { ok(rd16(tag.untag(r).value)) }
}

-- UDateFormatField → part type
date_part_type := (f, _seg) ~> match f {
  0: "era", 1: "year", 2: "month", 3: "day", 4: "hour", 5: "hour",
  6: "minute", 7: "second", 8: "fractionalSecond", 9: "weekday",
  10: "dayOfYear", 14: "dayPeriod", 15: "hour", 16: "hour",
  17: "timeZoneName", 18: "year", 19: "weekday", 20: "year",
  _: "literal"
}

date_parts_run := (fmt, ms) ~> do {
  fi = statused(ufieldpositer.ufieldpositer_open_78(0), "ufieldpositer_open")
  if tag.tag_of(fi) == "err" {
    _ = udat.udat_close_78(fmt)
    fi
  } else {
    iter = tag.untag(fi).value.ret
    r = statused(udat.udat_formatForFields_78(fmt, ms, 256, iter, 0), "udat_formatForFields")
    spans = iter_fields(iter)
    _1 = ufieldpositer.ufieldpositer_close_78(iter)
    _2 = udat.udat_close_78(fmt)
    if tag.tag_of(r) == "err" { r } else {
      v = tag.untag(r).value
      ok(parts_fill(to_units(bytes.to_list(v.buf)), v.ret, spans, date_part_type))
    }
  }
}

date_with := (v, locale, opts, parts) ~> do {
  ms = date_ms_of(v)
  if ms == null { err("unsupported date value: " + type.to_string(v)) } else {
    o = opt_rec(opts)
    st = date_styles(o)
    tz = if o.timeZone == null {
      { bytes: bytes.from_list([]), len: 0 }
    } else {
      utf16_enc(o.timeZone)
    }
    r = statused(udat.udat_open_78(st.ts, st.ds, loc_or_root(locale), tz.bytes, tz.len, 0, 0, 0), "udat_open")
    if tag.tag_of(r) == "err" { r } else {
      fmt = tag.untag(r).value.ret
      if parts { date_parts_run(fmt, ms) } else { date_run(fmt, ms) }
    }
  }
}

-- list formatting (CLDR listPattern via ures — no UChar*[] ffi needed) ------------

-- ECMA type "conjunction"|"disjunction"|"unit" → CLDR listPattern key
-- ("standard"|"or"|"unit"); style "long"|"short"|"narrow" → ""|"-short"|"-narrow"
listpat_key := (o) ~> do {
  base = match o.type { "disjunction": "or", "unit": "unit", _: "standard" }
  base + match o.style { "short": "-short", "narrow": "-narrow", _: "" }
}

res_child := (parent, key, what) ~> statused(ures.ures_getByKey_78(parent, key, 0, 0), what)

-- ures_getByKeyWithFallback is ICU-internal (no installed header decl)
-- but exported — call it through generic ffi directly. Missing keys fall
-- back through the bundle's parent chain: trimmed locales (de carries
-- only `2`/`end` in listPattern tables) resolve start/middle from root.
res_child_fb := (parent, key, what) ~> statused(ok(ffi.call(
  "libicuuc.so", "ures_getByKeyWithFallback_78",
  [parent, key, 0, 0],
  ["handle", "cstr", "ptr", "io_scalar:i32"], "handle", false)), what)

-- read a string resource under `parent` at `key`; closes the child handle
res_str := (parent, key) ~> do {
  c = res_child_fb(parent, key, "ures_getByKey")
  if tag.tag_of(c) == "err" { c } else {
    h = tag.untag(c).value.ret
    s = statused(ures.ures_getUTF8String_78(h, 256, 1, 0), "ures_getUTF8String")
    _ = ures.ures_close_78(h)
    if tag.tag_of(s) == "err" { s } else {
      v = tag.untag(s).value
      ok(bytes.utf8_decode(bytes.from_list(take(bytes.to_list(v.buf), at(v.vals, 0)))))
    }
  }
}

list_patterns_key := (locale, key) ~> do {
  r0 = statused(ures.ures_open_78(0, loc_or_root(locale), 0), "ures_open")
  if tag.tag_of(r0) == "err" { r0 } else {
    h0 = tag.untag(r0).value.ret
    r1 = res_child(h0, "listPattern", "listPattern")
    if tag.tag_of(r1) == "err" {
      _ = ures.ures_close_78(h0)
      r1
    } else {
      h1 = tag.untag(r1).value.ret
      r2 = res_child(h1, key, "listPattern." + key)
      if tag.tag_of(r2) == "err" {
        _1 = ures.ures_close_78(h1)
        _2 = ures.ures_close_78(h0)
        r2
      } else {
        h2 = tag.untag(r2).value.ret
        p_start = res_str(h2, "start")
        p_mid = res_str(h2, "middle")
        p_end = res_str(h2, "end")
        p_two = res_str(h2, "2")
        _1 = ures.ures_close_78(h2)
        _2 = ures.ures_close_78(h1)
        _3 = ures.ures_close_78(h0)
        -- `two` is the only required pattern; trimmed bundles may lack
        -- start/middle/end, which list_join then falls back to `two` for
        if tag.tag_of(p_two) == "err" { p_two } else {
          pv = (p) ~> if tag.tag_of(p) == "err" { null } else { tag.untag(p).value }
          ok({
            start: pv(p_start), middle: pv(p_mid),
            end: pv(p_end), two: tag.untag(p_two).value
          })
        }
      }
    }
  }
}

-- {start, middle, end, two} CLDR list patterns for locale+opts
list_patterns := (locale, o) ~> list_patterns_key(locale, listpat_key(o))

-- CLDR composition: n==1 → item; n==2 → "2"; else start(x0, middle…(end(x[n-2], x[n-1])))
list_join := (xs, pats) ~> do {
  n = list_len(xs)
  if n == 0 { "" } else if n == 1 { at(xs, 0) } else if n == 2 {
    fmt2(pats.two, at(xs, 0), at(xs, 1))
  } else {
    tail = while { i: n - 3, acc: fmt2(nz(pats.end, pats.two), at(xs, n - 2), at(xs, n - 1)) } {
      (i, acc) ~> if i < 1 {
        { out: acc }
      } else {
        { state: { i: i - 1, acc: fmt2(nz(pats.middle, pats.two), at(xs, i), acc) } }
      }
    }
    fmt2(nz(pats.start, pats.two), at(xs, 0), tail)
  }
}

format_list_impl := (items, locale, opts) ~> if type.of(items) == "array" {
  p = list_patterns(locale, opt_rec(opts))
  if tag.tag_of(p) == "err" { p } else { ok(list_join(items, tag.untag(p).value)) }
} else {
  err("format_list expects a list of strings")
}

-- duration (Intl.DurationFormat) -------------------------------------------------------

-- spec field order → CLDR `units/<length>/duration-<unit>` resource stems
dur_unit_res := ["duration-year", "duration-month", "duration-week", "duration-day",
  "duration-hour", "duration-minute", "duration-second", "duration-millisecond",
  "duration-microsecond", "duration-nanosecond"]

-- ToDurationRecord: every present field must be an integer (nested ifs — && is
-- eager and math.is_integer throws on non-numbers)
dur_field_int := (v) ~> if v == null { true } else if type.of(v) != "number" { false } else {
  math.is_integer(v)
}

dur_rec_ok := (o) ~> (dur_field_int(o.years) && dur_field_int(o.months) &&
  dur_field_int(o.weeks) && dur_field_int(o.days) && dur_field_int(o.hours) &&
  dur_field_int(o.minutes) && dur_field_int(o.seconds) && dur_field_int(o.milliseconds) &&
  dur_field_int(o.microseconds) && dur_field_int(o.nanoseconds))

dur_any := (o) ~> ((o.years != null) || (o.months != null) || (o.weeks != null) ||
  (o.days != null) || (o.hours != null) || (o.minutes != null) || (o.seconds != null) ||
  (o.milliseconds != null) || (o.microseconds != null) || (o.nanoseconds != null))

-- duration record → values in spec order
dur_vals := (o) ~> [nz(o.years, 0), nz(o.months, 0), nz(o.weeks, 0), nz(o.days, 0),
  nz(o.hours, 0), nz(o.minutes, 0), nz(o.seconds, 0), nz(o.milliseconds, 0),
  nz(o.microseconds, 0), nz(o.nanoseconds, 0)]

-- number input = elapsed seconds (extension over spec records); decompose the
-- magnitude into h/m/s so digital gives "1:01:01" and textual "1 hr, …"
dur_of_num := (v) ~> do {
  s = if v < 0 { -1 } else { 1 }
  a = math.abs(v)
  h = math.floor_div(a, 3600)
  m = math.floor_div(a - h * 3600, 60)
  r = [0, 0, 0, 0, s * h, s * m, s * (a - h * 3600 - m * 60), 0, 0, 0]
  r
}

dur_vals_of := (v) ~> if type.of(v) == "number" {
  dur_of_num(v)
} else if type.of(v) == "object" {
  if dur_any(v) && dur_rec_ok(v) { dur_vals(v) } else { null }
} else {
  null
}

-- DurationSign: sign of the most significant non-zero field (0 if all zero)
dur_sign := (vs) ~> while { xs: vs, s: 0 } {
  (xs, s) ~> match xs {
    []: { out: s },
    [h, ...t]: { state: { xs: t, s: if(s == 0) && (h != 0) { if h < 0 { -1 } else { 1 } } else { s } } }
  }
}

-- IsValidDuration: all non-zero fields share a sign
dur_sign_ok := (vs) ~> while { xs: vs, s: 0, ok_so_far: true } {
  (xs, s, ok_so_far) ~> if !ok_so_far { { out: false } } else {
    match xs {
      []: { out: true },
      [h, ...t]: do {
        sh = if h == 0 { 0 } else if h < 0 { -1 } else { 1 }
        if(s != 0) && (sh != 0) && (sh != s) {
          { out: false }
        } else {
          { state: { xs: t, s: if s == 0 { sh } else { s }, ok_so_far: true } }
        }
      }
    }
  }
}

-- Intl style → NumberFormatter `unit-width` token
dur_width := (s) ~> match s {
  "long": "full-name",
  "narrow": "narrow",
  _: "short"
}

-- "measure-unit/duration-<unit> unit-width-<w>" skeleton → localized "N unit"
-- ("1 hour", "5 hr", "9ns" — plural + number handled by the formatter)
dur_unit_str := (resname, width, n, locale) ~> do {
  skel = utf16_enc("measure-unit/" + resname + " unit-width-" + width)
  r = statused(unumf.unumf_openForSkeletonAndLocale_78(skel.bytes, skel.len, loc_or_root(locale), 0), "unumf_open")
  if tag.tag_of(r) == "err" { r } else {
    fmt = tag.untag(r).value.ret
    rr = statused(ufnum.unumf_openResult_78(0), "unumf_openResult")
    if tag.tag_of(rr) == "err" {
      _ = unumf.unumf_close_78(fmt)
      rr
    } else {
      res = tag.untag(rr).value.ret
      f0 = statused(unumf.unumf_formatDouble_78(fmt, n, res, 0), "unumf_formatDouble")
      s = if tag.tag_of(f0) == "err" { f0 } else {
        statused(ufnum.unumf_resultToString_78(res, 128, 0), "unumf_resultToString")
      }
      _1 = ufnum.unumf_closeResult_78(res)
      _2 = unumf.unumf_close_78(fmt)
      if tag.tag_of(s) == "err" { s } else { ok(rd16(tag.untag(s).value)) }
    }
  }
}

-- nonzero units vals[lo..hi) appended to `acc0` as localized "N unit" strings;
-- `zi` is a fallback unit index formatted at 0 when nothing was emitted
-- (-1 = none)
dur_units_str := (vals, locale, width, lo, hi, zi, acc0) ~> do {
  res0 = while { i: lo, acc: acc0, bad: null } {
    (i, acc, bad) ~> if(bad != null) || (i >= hi) {
      { out: if bad == null { ok(acc) } else { bad } }
    } else {
      n = at(vals, i)
      if n == 0 {
        { state: { i: i + 1, acc: acc, bad: bad } }
      } else {
        s = dur_unit_str(at(dur_unit_res, i), width, n, locale)
        if tag.tag_of(s) == "err" {
          { state: { i: i + 1, acc: acc, bad: s } }
        } else {
          { state: { i: i + 1, acc: [...acc, tag.untag(s).value], bad: bad } }
        }
      }
    }
  }
  if(tag.tag_of(res0) == "ok") && (list_len(tag.untag(res0).value) == 0) && (zi >= 0) {
    z = dur_unit_str(at(dur_unit_res, zi), width, 0, locale)
    if tag.tag_of(z) == "err" { z } else { ok([tag.untag(z).value]) }
  } else {
    res0
  }
}

-- duration join: `listPattern.unit` isn't present in every locale bundle —
-- fall back through unit → unit-short → standard (+ narrow variants)
dur_pats := (locale, list_style) ~> do {
  keys = if list_style == "narrow" {
    ["unit-narrow", "unit-short", "unit", "standard-narrow", "standard-short", "standard"]
  } else {
    ["unit", "unit-short", "standard", "unit-narrow", "standard-short", "standard-narrow"]
  }
  while { ks: keys, hit: null } {
    (ks, hit) ~> if(hit != null) || (match ks { []: true, _: false }) {
      { out: hit }
    } else {
      p = list_patterns_key(locale, at(ks, 0))
      if tag.tag_of(p) == "ok" {
        { state: { ks: ks, hit: p } }
      } else {
        { state: { ks: drop(ks, 1), hit: hit } }
      }
    }
  }
}

-- join unit strings with the CLDR `unit` list pattern for the style
dur_join := (parts, locale, list_style) ~> do {
  p = dur_pats(locale, list_style)
  if(tag.tag_of(p) == "err") || (p == null) { err("listPattern") } else {
    ok(list_join(parts, tag.untag(p).value))
  }
}

-- "digital": units ≥day format in "short" style; the h:m:s clock is always
-- emitted as h:mm:ss (hours unpadded, minutes/seconds 2-digit), with ms/μs/ns
-- folded into the seconds fraction (fractionalDigits opt, else up-to-9
-- trimmed). Negative durations sign the whole string.
dur_digital := (vals, locale, o) ~> do {
  neg = dur_sign(vals) < 0
  vs = if neg { map_list(vals, (x) ~> math.abs(x)) } else { vals }
  h = at(vs, 4)
  m = at(vs, 5)
  s = at(vs, 6)
  frac = (s - math.trunc(s)) + math.div(at(vs, 7) * 1000000 + at(vs, 8) * 1000 + at(vs, 9), 1000000000)
  secv = math.trunc(s) + frac
  big = dur_units_str(vs, locale, "short", 0, 4, -1, [])
  if tag.tag_of(big) == "err" { big } else {
    bp = tag.untag(big).value
    fd = o.fractionalDigits
    fo = if fd == null {
      { minimumIntegerDigits: 2, maximumFractionDigits: 9, useGrouping: false }
    } else {
      { minimumIntegerDigits: 2, minimumFractionDigits: fd, maximumFractionDigits: fd, useGrouping: false }
    }
    ss = payload(num_with(secv, locale, fo, false))
    mm = payload(num_with(m, locale, { minimumIntegerDigits: 2, useGrouping: false }, false))
    hh = payload(num_with(h, locale, { useGrouping: false }, false))
    if(ss == null) || (mm == null) || (hh == null) {
      err("unum_formatDouble")
    } else {
      j = dur_join([...bp, hh + ":" + mm + ":" + ss], locale, "short")
      if tag.tag_of(j) == "err" { j } else {
        ok(if neg { "-" + tag.untag(j).value } else { tag.untag(j).value })
      }
    }
  }
}

format_duration_impl := (v, locale, opts) ~> do {
  o = opt_rec(opts)
  style = nz(o.style, "short")
  vs = dur_vals_of(v)
  fd = o.fractionalDigits
  fd_ok = if fd == null { true } else if type.of(fd) != "number" { false } else {
    math.is_integer(fd) && (fd >= 0) && (fd <= 9)
  }
  if(style != "digital") && (style != "long") && (style != "short") && (style != "narrow") {
    err("unsupported duration style: " + type.to_string(o.style))
  } else if vs == null {
    err("invalid duration value")
  } else if !dur_sign_ok(vs) {
    err("invalid duration value")
  } else if !fd_ok {
    err("fractionalDigits must be an integer 0-9")
  } else if style == "digital" {
    dur_digital(vs, locale, o)
  } else {
    -- textual styles: nonzero units only; sign goes on the whole string
    -- ("-2 hr, 30 min"), an all-zero duration formats as ""
    neg = dur_sign(vs) < 0
    avs = if neg { map_list(vs, (x) ~> math.abs(x)) } else { vs }
    r = dur_units_str(avs, locale, dur_width(style), 0, 10, -1, [])
    if tag.tag_of(r) == "err" { r } else {
      j = dur_join(tag.untag(r).value, locale, style)
      if tag.tag_of(j) == "err" { j } else {
        ok(if neg { "-" + tag.untag(j).value } else { tag.untag(j).value })
      }
    }
  }
}

-- display names -------------------------------------------------------------------------

-- ECMA display-name type → unicode extension key. Canonicalizing a
-- synthetic `und-u-<key>-<code>` locale resolves the code's ICU-internal
-- keyword/value pair (ECMA "gregory" → ICU "calendar=gregorian").
dname_ukey := (t) ~> match t {
  "calendar": "ca", "collation": "co", "currency": "cu",
  "numberingSystem": "nu", _: null
}

-- {k, v}: canonical ICU keyword + value for a unicode-extension code
dname_kv := (uk, code) ~> do {
  r = payload(statused(uloc.uloc_canonicalize_78("und-u-" + uk + "-" + code, 128, 0), "uloc_canonicalize"))
  if r == null { { k: uk, v: code } } else {
    s = cstr_of(r.buf)
    i = find_sub(s, "@")
    j = find_sub(s, "=")
    if i < 0 || j < 0 { { k: uk, v: code } } else {
      cs = char.chars(s)
      {
        k: char.from_chars(take(drop(cs, i + 1), j - i - 1)),
        v: char.from_chars(drop(cs, j + 1))
      }
    }
  }
}

display_name_impl := (code, name_type, locale, _opts) ~> do {
  r = statused(uldnames.uldn_open_78(loc_or_root(locale), 0, 0), "uldn_open")
  if tag.tag_of(r) == "err" { r } else {
    ldn = tag.untag(r).value.ret
    uk = dname_ukey(name_type)
    kv = if uk == null { { k: name_type, v: code } } else { dname_kv(uk, code) }
    f = match name_type {
      "language": uldnames.uldn_languageDisplayName_78(ldn, code, 256, 0),
      "region": uldnames.uldn_regionDisplayName_78(ldn, code, 256, 0),
      "script": uldnames.uldn_scriptDisplayName_78(ldn, code, 256, 0),
      "locale": uldnames.uldn_localeDisplayName_78(ldn, code, 256, 0),
      "key": uldnames.uldn_keyDisplayName_78(ldn, code, 256, 0),
      _: uldnames.uldn_keyValueDisplayName_78(ldn, kv.k, kv.v, 256, 0)
    }
    s = statused(f, "uldn_displayName")
    _ = uldnames.uldn_close_78(ldn)
    if tag.tag_of(s) == "err" { s } else { ok(rd16(tag.untag(s).value)) }
  }
}

-- segmentation ----------------------------------------------------------------------------

seg_type := (g) ~> match g { "word": 1, "line": 2, "sentence": 3, _: 0 }

brk_int := (r) ~> do {
  v = payload(r)
  if v == null { -1 } else { v }
}

brk_status := (bi) ~> do {
  v = payload(ubrk.ubrk_getRuleStatus_78(bi))
  if v == null { 0 } else { v }
}

-- word granularity adds isWordLike (ruleStatus ≥ UBRK_WORD_*=100 range)
seg_obj := (pos, seg, status, g) ~> if g == 1 {
  { index: pos, segment: seg, isWordLike: status >= 100 }
} else {
  { index: pos, segment: seg }
}

-- ubrk_open borrows the text pointer for the iterator's lifetime, so the
-- UTF-16 buffer must stay valid until ubrk_close — an `in_ptr` arg buffer
-- is freed when ffi.call returns. malloc + memcpy the text, free after close.
libc_malloc := (n) ~> ffi.call("libc.so.6", "malloc", [n], ["i64"], "ptr", false)

libc_free := (p) ~> ffi.call("libc.so.6", "free", [p], ["ptr"], "void", false)

libc_memcpy := (dst, src, n) ~> ffi.call("libc.so.6", "memcpy", [dst, src, n], ["ptr", "in_ptr", "i64"], "ptr", false)

segment_impl := (text, granularity, locale, _opts) ~> do {
  g = seg_type(granularity)
  e = utf16_enc(text)
  nb = e.len * 2
  p = libc_malloc(nb)
  if p == 0 { err("malloc failed") } else { do {
    _m = libc_memcpy(p, e.bytes, nb)
    r = statused(ubrk.ubrk_open_78(g, loc_or_root(locale), p, e.len, 0), "ubrk_open")
    if tag.tag_of(r) == "err" {
      _f = libc_free(p)
      r
    } else {
      bi = tag.untag(r).value.ret
      units = to_units(bytes.to_list(e.bytes))
      segs = while { pos: brk_int(ubrk.ubrk_first_78(bi)), acc: [] } {
        (pos, acc) ~> if pos < 0 { { out: acc } } else { do {
          nx = brk_int(ubrk.ubrk_next_78(bi))
          if nx < 0 {
            { out: acc }
          } else {
            seg = utf16_dec(uslice(units, pos, nx), nx - pos)
            { state: { pos: nx, acc: [...acc, seg_obj(pos, seg, brk_status(bi), g)] } }
          }
        } }
      }
      _c = ubrk.ubrk_close_78(bi)
      _f = libc_free(p)
      ok(segs)
    }
  } }
}

-- locale utilities ----------------------------------------------------------------------------

-- component extraction; absent component → "" (empty cstr)
loc_field := (lid, which) ~> do {
  f = match which {
    "language": uloc.uloc_getLanguage_78(lid, 64, 0),
    "script": uloc.uloc_getScript_78(lid, 64, 0),
    "region": uloc.uloc_getCountry_78(lid, 64, 0),
    "variant": uloc.uloc_getVariant_78(lid, 64, 0),
    _: uloc.uloc_getName_78(lid, 128, 0)
  }
  v = payload(f)
  if v == null { "" } else { cstr_of(v.buf) }
}

canon_tag := (lid) ~> do {
  v = payload(uloc.uloc_toLanguageTag_78(lid, 128, 1, 0))
  if v == null { lid } else { cstr_of(v.buf) }
}

-- CLDR alias lookup under an open `metadata/alias` handle:
-- <kind>/<code>/replacement → replacement string or null. Missing keys
-- set U_MISSING_RESOURCE_ERROR (still an ok() Result) — `statused` folds
-- that to null so absent aliases never yield a dangling 0 handle.
alias_get := (a, kind, code) ~> do {
  k = payload(statused(ures.ures_getByKey_78(a, kind, 0, 0), "alias"))
  c = if k == null { null } else { payload(statused(ures.ures_getByKey_78(k.ret, code, 0, 0), "alias")) }
  rp = if c == null { null } else { payload(statused(ures.ures_getByKey_78(c.ret, "replacement", 0, 0), "alias")) }
  s = if rp == null { null } else { payload(statused(ures.ures_getUTF8String_78(rp.ret, 256, 1, 0), "alias")) }
  _1 = if rp == null { 0 } else { ures.ures_close_78(rp.ret) }
  _2 = if c == null { 0 } else { ures.ures_close_78(c.ret) }
  _3 = if k == null { 0 } else { ures.ures_close_78(k.ret) }
  if s == null { null } else { s.ret }
}

-- CLDR alias table: metadata/alias — locale-invariant, so it's opened
-- with ures_openDirect (no fallback). `f` receives the alias table handle
-- and returns the result; all handles are closed on the way out.
with_aliases := (f) ~> do {
  o = payload(statused(ures.ures_openDirect_78(0, "metadata", 0), "metadata"))
  if o == null { f(null) } else { do {
    h0 = o.ret
    a = payload(statused(ures.ures_getByKey_78(h0, "alias", 0, 0), "alias"))
    r = f(if a == null { null } else { a.ret })
    _1 = if a == null { 0 } else { ures.ures_close_78(a.ret) }
    _2 = ures.ures_close_78(h0)
    r
  } }
}

-- text up to the first space — territory replacements can be
-- space-separated lists ("SU" → "RU AM AZ …"); ECMA-402 keeps the first
first_word := (s) ~> do {
  i = find_sub(s, " ")
  if i < 0 { s } else { char.from_chars(take(char.chars(s), i)) }
}

-- apply CLDR aliases to the base subtags of a canonical ICU locale id:
-- language alias on the first subtag ("cmn"→"zh"), territory alias on
-- 2-3-alpha / 3-digit subtags after it ("BU"→"MM"). `@key=value`
-- extension keywords pass through untouched.
alias_lid := (lid) ~> do {
  i = find_sub(lid, "@")
  base = if i < 0 { lid } else { char.from_chars(take(char.chars(lid), i)) }
  ext = if i < 0 { "" } else { char.from_chars(drop(char.chars(lid), i)) }
  ps = str.split(base, "_")
  aliased = with_aliases((a) ~> while { xs: ps, i: 0, acc: [] } {
    (xs, i, acc) ~> match xs {
      []: { out: acc },
      [h, ...t]: do {
        n = list_len(char.chars(h))
        rep = if a == null { null }
              else if i == 0 { alias_get(a, "language", h) }
              else if(n == 2 || n == 3) && str.is_alpha(h) || n == 3 && str.is_numeric(h) { alias_get(a, "territory", h) }
              else { null }
        { state: { xs: t, i: i + 1, acc: [...acc, if rep == null { h } else { first_word(rep) }] } }
      }
    }
  })
  str.join(aliased, "_") + ext
}

-- BCP-47 tag → canonical tag ("EN_us" → "en-US"); falls back to input.
-- `_` is normalized to `-` first — ICU's forLanguageTag is strict BCP-47
-- and returns "und" for underscore separators. uloc_canonicalize fixes
-- casing/order and keyword-value aliases ("gregory"→"gregorian");
-- alias_lid then applies CLDR subtag aliases ("cmn"→"zh") that
-- canonicalize leaves alone.
canon := (t) ~> do {
  r = payload(uloc.uloc_forLanguageTag_78(str.replace(t, "_", "-"), 128, 0, 0))
  if r == null { t } else {
    lid = cstr_of(r.buf)
    cl = payload(statused(uloc.uloc_canonicalize_78(lid, 128, 0), "uloc_canonicalize"))
    canon_tag(alias_lid(if cl == null { lid } else { cstr_of(cl.buf) }))
  }
}

locale_impl := (t, _opts) ~> do {
  r = statused(uloc.uloc_forLanguageTag_78(str.replace(t, "_", "-"), 128, 0, 0), "uloc_forLanguageTag")
  if tag.tag_of(r) == "err" { r } else {
    lid = cstr_of(tag.untag(r).value.buf)
    cl = payload(statused(uloc.uloc_canonicalize_78(lid, 128, 0), "uloc_canonicalize"))
    clid = alias_lid(if cl == null { lid } else { cstr_of(cl.buf) })
    bi = find_sub(clid, "@")
    base_lid = if bi < 0 { clid } else { char.from_chars(take(char.chars(clid), bi)) }
    ok({
      tag: t,
      locale_id: lid,
      base_name: canon_tag(base_lid),
      language: loc_field(clid, "language"),
      script: loc_field(clid, "script"),
      region: loc_field(clid, "region"),
      variant: loc_field(clid, "variant"),
      canonical: canon_tag(clid)
    })
  }
}

get_canonical_locales_impl := (v) ~> if type.of(v) == "array" {
  ok(map_list(v, canon))
} else if type.of(v) == "string" {
  ok(canon(v))
} else {
  err("expected a locale tag or list of tags")
}

-- locale-id list of everything ICU ships ("en_US" style)
avail_locales := () ~> do {
  n = payload(uloc.uloc_countAvailable_78())
  while { i: 0, acc: [] } {
    (i, acc) ~> if n == null || i >= n { { out: acc } } else { do {
      v = payload(uloc.uloc_getAvailable_78(i))
      { state: { i: i + 1, acc: if v == null { acc } else { [...acc, v] } } }
    } }
  }
}

-- req ("en_US") covered by an available id — exact or prefix parent/child
locale_covers := (avail_id, req) ~> avail_id == req || starts_with(req, avail_id + "_") || starts_with(avail_id, req + "_")

supported_any := (avails, req) ~> while { xs: avails, hit: false } {
  (xs, hit) ~> if hit { { out: true } } else {
    match xs {
      []: { out: false },
      [h, ...t]: { state: { xs: t, hit: locale_covers(h, req) } }
    }
  }
}

supported_locales_of_impl := (requested, _opts) ~> do {
  reqs = if type.of(requested) == "array" { requested } else if type.of(requested) == "string" { [requested] } else { null }
  if reqs == null { err("expected a locale tag or list of tags") } else {
    avs = avail_locales()
    canon_reqs = map_list(reqs, canon)
    kept = while { xs: canon_reqs, acc: [] } {
      (xs, acc) ~> match xs {
        []: { out: acc },
        [h, ...t]: { state: { xs: t, acc: if supported_any(avs, sub_all(h, "-", "_")) && !list_has(acc, h) { [...acc, h] } else { acc } } }
      }
    }
    ok(kept)
  }
}

-- exports --------------------------------------------------------------------

export available := avail
export icu_version := icu_ver

--- Compare two strings under `locale` collation (null = ICU default).
--- `opts`: { sensitivity: "base"|"accent"|"case"|"variant",
---           caseFirst: "upper"|"lower"|"false", numeric: bool }.
--- @returns {Result<Number, String>} — `ok -1 | 0 | 1`, or `err msg`.
export compare_strings := (a, b, locale, opts) ~> if avail {
  cmp_open(a, b, locale, opts)
} else {
  err("icu-unavailable")
}

--- Format `n` under `locale` (null = ICU default).
--- `opts`: { style: "decimal"|"currency"|"percent"|"scientific"|"spellout"|
---           "ordinal"|"duration", currency: "EUR", useGrouping: bool,
---           minimum/maximumFractionDigits, minimum/maximumIntegerDigits }.
--- @returns {Result<String, String>} — `ok "1,234.5"`, or `err msg`.
export format_number := (n, locale, opts) ~> if avail {
  num_with(n, locale, opts, false)
} else {
  err("icu-unavailable")
}

--- Like `format_number` but returns `[{type, value}]` parts
--- (integer, fraction, group, currency, percentSign, minusSign, literal, …).
export format_number_to_parts := (n, locale, opts) ~> if avail {
  num_with(n, locale, opts, true)
} else {
  err("icu-unavailable")
}

--- Plural category of `n` in `locale`; `opts`: { type: "cardinal"|"ordinal" }.
--- @returns {Result<String, String>} — `ok "one" | "few" | "other" | …`.
export select_plural := (n, locale, opts) ~> if avail {
  select_plural_impl(n, locale, opts)
} else {
  err("icu-unavailable")
}

--- Format a list of strings ("a, b, and c") via CLDR listPattern data.
--- `opts`: { type: "and"|"or"|"unit", style: "wide"|"short"|"narrow" }.
export format_list := (items, locale, opts) ~> if avail {
  format_list_impl(items, locale, opts)
} else {
  err("icu-unavailable")
}

--- `n` of `unit` ("day", "hour", …) as relative time ("3 days ago").
--- `opts`: { style: "long"|"short"|"narrow", numeric: "auto"|"always" }.
export format_relative_time := (n, unit, locale, opts) ~> if avail {
  format_relative_time_impl(n, unit, locale, opts)
} else {
  err("icu-unavailable")
}

--- Format a date — epoch-ms number or "YYYY-MM-DD[THH:mm[:ss][Z|±hh:mm]]".
--- `opts`: { dateStyle, timeStyle: "full"|"long"|"medium"|"short",
---           timeZone: "UTC" }.
export format_date := (v, locale, opts) ~> if avail {
  date_with(v, locale, opts, false)
} else {
  err("icu-unavailable")
}

--- Like `format_date` but returns `[{type, value}]` parts
--- (year, month, day, weekday, dayPeriod, timeZoneName, literal, …).
export format_date_to_parts := (v, locale, opts) ~> if avail {
  date_with(v, locale, opts, true)
} else {
  err("icu-unavailable")
}

--- Intl.DurationFormat: `v` is a {years,…,nanoseconds} record (integer fields,
--- consistent sign) or an elapsed-seconds number (extension).
--- `opts`: { style: "long"|"short"|"narrow"|"digital" (default "short"),
---           fractionalDigits: 0-9 } — "digital" gives "1:46:40", textual
--- styles give "1 hr, 46 min and 40 sec" via CLDR unit + list patterns.
export format_duration := (v, locale, opts) ~> if avail {
  format_duration_impl(v, locale, opts)
} else {
  err("icu-unavailable")
}

--- Display name for `code` of `name_type` ("language", "region", "script",
--- "locale", "key", or a unicode key like "currency"/"calendar") in `locale`.
export display_name := (code, name_type, locale, opts) ~> if avail {
  display_name_impl(code, name_type, locale, opts)
} else {
  err("icu-unavailable")
}

--- Segment `text` by `granularity` ("grapheme", "word", "sentence", "line")
--- → `[{index, segment}]`; "word" adds `isWordLike`. Indices are UTF-16 units.
export segment := (text, granularity, locale, opts) ~> if avail {
  segment_impl(text, granularity, locale, opts)
} else {
  err("icu-unavailable")
}

--- Parse a BCP-47 `tag` → {tag, locale_id, base_name, language, script,
--- region, variant, canonical}.
export locale := (t, opts) ~> if avail {
  locale_impl(t, opts)
} else {
  err("icu-unavailable")
}

--- Canonicalize a tag or list of tags → same shape back.
export get_canonical_locales := v ~> if avail {
  get_canonical_locales_impl(v)
} else {
  err("icu-unavailable")
}

--- Filter requested tag(s) to those covered by ICU's locale data
--- (canonicalized; prefix fallback counts — "en" covers "en-US").
export supported_locales_of := (requested, opts) ~> if avail {
  supported_locales_of_impl(requested, opts)
} else {
  err("icu-unavailable")
}
