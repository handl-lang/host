  [{ type: "integer", value: "1" }, { type: "group", value: "," }, { type: "integer", value: "234" }, { type: "decimal", value: "." }, { type: "fraction", value: "56" }]
}) = [{ type: "integer", value: "1" }, { type: "group", value: "," }, { type: "integer", value: "234" }, { type: "decimal", value: "." }, { type: "fraction", value: "56" }]

