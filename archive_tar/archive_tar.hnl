--- tar.pack -- pack an array of {path, contents} objects into a base64 tar archive string.
--- tar.unpack -- unpack a base64 tar archive string into an array of {path, contents} objects.
cap "tar.pack"
cap "tar.unpack"
op "tar.pack" : Array -> String
  guarantee: IsBase64(output)
op "tar.unpack" : String -> Array
  guarantee: True
