-- Time contract axioms.
-- These describe the surface types of the three clock arrows provided by
-- every `time` backend (e.g. `time-c`, `time-stub`).

axiom time.now_ms : a -> Nat
  guarantee: True

axiom time.instant_ns : a -> Nat
  guarantee: True

axiom time.elapsed_ns : Nat -> Nat
  guarantee: True
