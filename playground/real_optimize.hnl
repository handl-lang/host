-- real_optimize.hnl -- Optimize a JSON-over-HTTP pipeline using real HTTP and JSON.
--
-- No explicit FFI here; `fs` and `json_lib` packages hide the OS helpers.

from "http_client_std" import * as http
from "fs" import { read_file }
from "json_lib" import { parse, serialize }

-- Toggle to use the real network call.  Disabled by default so `hnl run`
-- works in offline environments and falls back to a built-in JSON value.
use_http := false

url := "https://httpbin.org/json"

-- Local fallback value (matches playground/test.json).
local_json := {
  "slideshow": {
    "author": "Yours Truly",
    "date": "date of publication",
    "slides": [
      { "title": "Wake up to WonderWidgets!", "type": "all" },
      { "title": "Overview", "type": "all", "items": ["Why <em>WonderWidgets</em> are great", "Who <em>buys</em> WonderWidgets"] }
    ],
    "title": "Sample Slide Show"
  }
}

-- Real HTTP 1-cell.
fetch := (url) ~> http.get(url)

-- Fetch with offline fallback.  `http.get` already returns a parsed Value,
-- so the fallback is the same JSON loaded from a `{...}` literal.
fetched := if use_http { fetch(url) } else { local_json }

-- Identity 1-cell, used in the rewrite rules.
id := x ~> x

-- 1-cell pipeline (source-level string) to optimize.
round_trip := "fetch >>> serialize >>> parse"

-- 2-cell rewrite rules as string rewrites between 1-cell pipeline strings.
-- The left string is the sub-pipeline to match; the right is the replacement.
parse_after_serialize := "serialize >>> parse" ~[2]~> "id"

dedupe_fetch := "fetch >>> fetch" ~[2]~> "fetch"

right_identity := "fetch >>> id" ~[2]~> "fetch"

-- Show the real JSON parser running on the local file.
file_text := read_file("playground/test.json")

file_parsed := parse(file_text)

json_round_trip := serialize(file_parsed)

round_trip
