-- N-dimensional arrow calculus: the same arrow syntax works at every level.
--
--   A ~[1]~> B  (or A ~> B)  : 1-cell, an ordinary program from A to B
--   A ~[2]~> B              : 2-cell, a transformation / rewrite rule between 1-cells
--   A ~[3]~> B              : 3-cell, a transformation between 2-cells  (same syntax)
--
-- Everything is an arrow.  `law`, `rewrite`, and `axiom` are not keywords;
-- they are just named bindings whose value is a higher-dimensional arrow.

-- A 1-cell program.  `~>` is shorthand for `~[1]~>.
-- `id` takes a value and returns it unchanged.
id := x ~> x

-- A 2-cell rewrite rule.  It is an ordinary binding `id_left` whose value is a 2-cell.
-- Source: `id >>> id`    (compose two identity programs)
-- Target: `id`           (the single identity program)
-- Meaning: `id >>> id` rewrites to `id`.
id_left := (id >>> id) ~[2]~> id

-- A 3-cell uses the same surface syntax with `~[3]~>`.
-- Source: `id_left >>> id_left` (vertical composition of the 2-cell with itself)
-- Target: `id_left`
-- Meaning: `id_left >>> id_left` rewrites to `id_left`.
id_left_again := (id_left >>> id_left) ~[3]~> id_left

-- Return a human-readable record that proves this is a 3-cell.
{
  rule: "id_left_again",
  meaning: "id_left >>> id_left rewrites to id_left",
  dimension: 3
}
