-- playground/effects.hnl
--
-- Runnable `op` / `handler` / `handle ... in ...` effect demo.
-- The `op` declarations name the capabilities used under the hood in
-- `real_optimize.hnl`; the `handler` blocks show how to cache, dedupe, and
-- fuse those effects.  Real package helpers keep it FFI-free.

from "http_client_std" import * as http
from "fs" import { read_file }
from "json_lib" import { parse, serialize }

-- Network toggle.  Disabled so `hnl run` is safe offline.
use_http := false

url := "https://httpbin.org/json"

-- 1-cell implementations of the declared ops, backed by real packages.
-- These are the arrows the 2-cell laws compare.
HttpGet := url ~> serialize(http.get(url))
JsonParse := s ~> parse(s)
JsonSerialize := v ~> serialize(v)
ReadFile := p ~> read_file(p)

-- The `op` declarations give a graded-theory signature for each capability.
-- In the current runtime the `op` / `arr` dispatch is still coming online,
-- so the 2-cell laws below are written as runnable string rewrites between
-- the 1-cell names (exactly as in `real_optimize.hnl`) while the live 1-cells
-- above call the real package helpers directly.
op HttpGet : String ~> String
op JsonParse : String ~> Value
op JsonSerialize : Value ~> String
op ReadFile : String ~> String

id := x ~> x

-- 2-cell cache / dedupe / fusion laws.  The left and right sides are 1-cell
-- pipeline strings; the `~[2]~>` arrow is a rewrite rule between them.
parse_after_serialize := "JsonSerialize >>> JsonParse" ~[2]~> "id"
dedupe_http := "HttpGet >>> HttpGet" ~[2]~> "HttpGet"
cache_read := "ReadFile >>> ReadFile" ~[2]~> "ReadFile"

-- Handlers model each capability with a record mapping op name to arrow.
HttpGetHandler := { HttpGet: HttpGet }
JsonParseHandler := { JsonParse: JsonParse }
JsonSerializeHandler := { JsonSerialize: JsonSerialize }
ReadFileHandler := { ReadFile: ReadFile }

handler HttpGetHandler = { HttpGet: HttpGet }
handler JsonParseHandler = { JsonParse: JsonParse }
handler JsonSerializeHandler = { JsonSerialize: JsonSerialize }
handler ReadFileHandler = { ReadFile: ReadFile }

-- Effect-handler blocks.  They are thunks so `hnl run` does not trigger
-- the not-yet-wired `arr` dispatch and stays offline-safe.
-- `with <handler> do <body>` installs the handler for the body.
demo_http := () ~> with HttpGetHandler do (arr HttpGet)(url)
demo_parse := () ~> with JsonParseHandler do (arr JsonParse)((arr ReadFile)("playground/test.json"))
demo_serialize := () ~> with JsonSerializeHandler do (arr JsonSerialize)((arr JsonParse)((arr ReadFile)("playground/test.json")))

-- `with <handler> do <body>` installs the handler for one op.
demo_cache := () ~> with ReadFileHandler do (arr ReadFile)("playground/test.json")
demo_dedupe := () ~> with HttpGetHandler do (arr HttpGet)(url)
demo_fuse := () ~> with JsonSerializeHandler do (arr JsonParse)((arr JsonSerialize)({slideshow: {title: "demo"}}))

-- Concrete, offline-safe samples using the real package helpers.
file_text := read_file("playground/test.json")
file_parsed := parse(file_text)
file_round_trip := serialize(file_parsed)

-- Human-readable output record.
{
  use_http: use_http,
  url: url,
  original: "HttpGet >>> JsonSerialize >>> JsonParse",
  dimension: 2,
  rules: [
    { name: "parse_after_serialize", from: "JsonSerialize >>> JsonParse", to: "id", dimension: 2 },
    { name: "dedupe_http", from: "HttpGet >>> HttpGet", to: "HttpGet", dimension: 2 },
    { name: "cache_read", from: "ReadFile >>> ReadFile", to: "ReadFile", dimension: 2 }
  ],
  handlers: [
    { name: "HttpGetHandler", op: "HttpGet" },
    { name: "JsonParseHandler", op: "JsonParse" },
    { name: "JsonSerializeHandler", op: "JsonSerialize" },
    { name: "ReadFileHandler", op: "ReadFile" }
  ],
  samples: {
    file_text: file_text,
    file_parsed: file_parsed,
    file_round_trip: file_round_trip
  },
  note: "op declarations give the capability signature; handler blocks install implementations; the ~[2]~> arrows are cache/dedupe/fusion laws; thunks keep arr dispatch offline-safe."
}
