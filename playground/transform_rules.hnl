-- 1-cell building blocks used in the rewrite rules.
-- These are intentionally pure (effect-free) for the categorical demo.
id := x ~> x

fetch := x ~> x

serialize := x ~> x

parse := x ~> x

-- 2-cell categorical rewrite rules.
parse_after_serialize := (serialize >>> parse) ~[2]~> id

dedupe_fetch := (fetch >>> fetch) ~[2]~> fetch

right_identity := (fetch >>> id) ~[2]~> fetch

-- Export the 2-cell rules as the module value.
{
  parse_after_serialize: parse_after_serialize,
  dedupe_fetch: dedupe_fetch,
  right_identity: right_identity
}
