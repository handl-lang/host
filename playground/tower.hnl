-- A tower of identity arrows, one per dimension.
-- Each cell proves that composing the previous cell with itself is the same cell.

-- 1-cell: ordinary program
id_1 := x ~> x

-- 2-cell: rewrite rule about 1-cells
id_2 := (id_1 >>> id_1) ~[2]~> id_1

-- 3-cell: rewrite rule about 2-cells
id_3 := (id_2 >>> id_2) ~[3]~> id_2

-- 4-cell: rewrite rule about 3-cells
id_4 := (id_3 >>> id_3) ~[4]~> id_3

-- 5-cell: rewrite rule about 4-cells
id_5 := (id_4 >>> id_4) ~[5]~> id_4

-- Show the tower.  Same syntax at every level.
{
  name: "tower",
  top_dimension: 5
}
