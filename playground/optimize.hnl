-- A concrete, practical 2-cell rewrite: optimizing a JSON over HTTP pipeline.
--
--   1-cells : pretend operations (HTTP fetch, JSON parse, JSON serialize)
--   2-cells : real compiler-style rewrite rules that explain why the pipeline shrinks

-- 1-cell: identity, the universal no-op
id := x ~> x

-- 1-cell: pretend HTTP GET
fetch := x ~> x

-- 1-cell: pretend JSON parse
parse := x ~> x

-- 1-cell: pretend JSON serialize
serialize := x ~> x

-- 1-cell: original program fetches, serializes, then parses
round_trip := fetch >>> serialize >>> parse

-- 2-cell: for well-formed JSON, `serialize >>> parse` is a no-op.
parse_after_serialize := "serialize >>> parse" ~[2]~> "id"

-- 2-cell: two identical fetches in a row can be fused into one.
dedupe_fetch := "fetch >>> fetch" ~[2]~> "fetch"

-- 2-cell: right identity -- composing with `id` on the right is a no-op.
right_identity := "fetch >>> id" ~[2]~> "fetch"

-- Apply the 2-cell rules to the 1-cell program string and report before/after.
before := "fetch >>> serialize >>> parse"

stage1 := match(before) { "fetch >>> serialize >>> parse": "fetch >>> id", _: before }

after := match(stage1) { "fetch >>> id": "fetch", _: stage1 }

-- Human-readable summary, reusing the 2-cell values as the rule descriptions.
{
  domain: "json_http_pipeline",
  original: before,
  optimized: after,
  rules: [
    { name: "parse_after_serialize", from: parse_after_serialize.inputs, to: parse_after_serialize.output, dimension: 2 },
    { name: "dedupe_fetch", from: dedupe_fetch.inputs, to: dedupe_fetch.output, dimension: 2 },
    { name: "right_identity", from: right_identity.inputs, to: right_identity.output, dimension: 2 }
  ]
}
