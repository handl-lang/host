--- Dependent-type demo for array.take.
---
--- `array.take` returns `List(T, math.min(n, array.len(xs)))`, so the
--- result length is tracked in the type.

from "../handl-packages/collections/array/index" import * as array

do {
  xs = [1, 2, 3, 4, 5]
  taken = array.take(xs, 2)
  { taken: taken, length: array.len(taken) }
}
