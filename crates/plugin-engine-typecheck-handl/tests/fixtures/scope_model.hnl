--- scope_model.hnl
---
--- ADR-0103: "The Kernel is the Evaluator, Not the Calculus".
---
--- This is the module-level scope checker — the Handl-authored replacement
--- for the Rust bootstrap checker (ADR-0105). It is Handl code (data)
--- compiled to bytecode and run on the VM.
---
--- The scope checker implements three phases:
--- 1. Source splitting — split source into top-level statements.
--- 2. Binding collection — walk top-level AST nodes, collecting imports,
---    exports, bindings, and data constructor names.
--- 3. Module-level checks — exports bound, imports used, no duplicates,
---    and unbound-wire detection.
---
--- Diagnostics are records { severity, message, span }.
--- Recursion uses the standard Handl self-passing pattern.
---
--- Parser constraint: inside a do { } block, if/else branches cannot
--- contain do { } with :: bindings. All :: bindings must be at the top
--- level of the do { } block, or inside a while body.

do {
  --- tget: field access with a null default.
  tget :: [obj, key] ~> hash_map.get(obj, key, null)

  --- is_obj: true iff v is a runtime object (hash map) value.
  is_obj :: v ~> if typeof.type_of(v) == "obj" { true } else { false }

  --- make_diag: construct a diagnostic record.
  make_diag :: [severity, message, span] ~> { severity: severity, message: message, span: span }

  --- make_span: construct a span record from byte offsets.
  make_span :: [start, end] ~> { start: start, end: end }

  --- chunk_span_: best-effort span for a statement chunk.
  chunk_span_ :: [stmt, fallback] ~> do {
    off :: tget(stmt, "offset")
    txt :: tget(stmt, "text")
    if off != null && txt != null {
      make_span(off, off + char.length(txt))
    } else {
      make_span(0, 0)
    }
  }

  --- ast_at: look up a node in the AST arena by index.
  ast_at :: [ast, idx] ~> array.at(ast, idx)

  --- ast_len: number of nodes in the AST arena.
  ast_len :: [ast] ~> array.len(ast)

  --- children_of: extract the children index array from a node.
  children_of :: [node] ~> do {
    payload :: tget(node, "payload")
    if is_obj(payload) {
      hash_map.get_or(payload, "children", [])
    } else {
      []
    }
  }

  --- var_name: extract the name from a var node.
  var_name :: [node] ~> tget(node, "payload")

  --- child_role_index: look up a named child role in the language's
  --- AST shape definitions (ADR-0081).
  child_role_index :: [lang, kind, role] ~> do {
    ast_shapes :: tget(lang, "ast")
    shape :: if is_obj(ast_shapes) { tget(ast_shapes, kind) } else { null }
    if shape != null {
      find_role_idx_(find_role_idx_, tget(shape, "children"), role, 0)
    } else {
      null
    }
  }

  --- find_role_idx_: recursive helper for child_role_index.
  find_role_idx_ :: [self, roles, target, idx] ~> if array.is_empty(roles) {
    null
  } else {
    if tget(array.first(roles), "name") == target {
      idx
    } else {
      self(self, array.drop(roles, 1), target, idx + 1)
    }
  }

  --- skip_string_: advance past a string literal.
  skip_string_ :: [src, i, len] ~> while { i: i } {
    [st] ~> if st.i >= len {
      { out: st.i }
    } else {
      do {
        c :: char.slice(src, st.i, st.i + 1)
        if c == "\\" {
          { state: { i: st.i + 2 } }
        } else {
          if c == "\"" {
            { out: st.i + 1 }
          } else {
            { state: { i: st.i + 1 } }
          }
        }
      }
    }
  }

  --- skip_comment_: advance past a comment to end of line.
  skip_comment_ :: [src, i, len] ~> while { i: i } {
    [st] ~> if st.i >= len {
      { out: st.i }
    } else {
      if char.slice(src, st.i, st.i + 1) == "\n" {
        { out: st.i }
      } else {
        { state: { i: st.i + 1 } }
      }
    }
  }

  --- is_whitespace_only_: true if the slice is all whitespace.
  is_whitespace_only_ :: [src, start, end] ~> str.is_empty(str.trim(char.slice(src, start, end)))

  --- push_chunk_: append a statement chunk if non-empty and not a comment.
  push_chunk_ :: [src, chunks, start, end] ~> do {
    slice :: char.slice(src, start, end)
    trimmed :: str.trim(slice)
    t_len :: char.length(trimmed)
    if t_len == 0 {
      chunks
    } else {
      if t_len >= 2 && char.slice(trimmed, 0, 1) == "-" && char.slice(trimmed, 1, 2) == "-" {
        chunks
      } else {
        do {
          lead :: char.length(slice) - char.length(str.trim_start(slice))
          [...chunks, { text: trimmed, offset: start + lead }]
        }
      }
    }
  }

  --- split_statements: split source into top-level statement chunks.
  split_statements :: src ~> do {
    len :: char.length(src)
    while { i: 0, start: 0, depth: 0, chunks: [] } {
      [st] ~> if st.i >= len {
        { out: push_chunk_(src, st.chunks, st.start, len) }
      } else {
        do {
          c :: char.slice(src, st.i, st.i + 1)
          if c == "\"" {
            do {
              new_i :: skip_string_(src, st.i + 1, len)
              { state: { i: new_i, start: st.start, depth: st.depth, chunks: st.chunks } }
            }
          } else {
            if c == "-" && st.i + 1 < len && char.slice(src, st.i + 1, st.i + 2) == "-" {
              do {
                new_i :: skip_comment_(src, st.i, len)
                new_start :: if is_whitespace_only_(src, st.start, st.i) { new_i } else { st.start }
                { state: { i: new_i, start: new_start, depth: st.depth, chunks: st.chunks } }
              }
            } else {
              if c == "(" || c == "[" || c == "{" {
                { state: { i: st.i + 1, start: st.start, depth: st.depth + 1, chunks: st.chunks } }
              } else {
                if c == ")" || c == "]" || c == "}" {
                  { state: { i: st.i + 1, start: st.start, depth: st.depth - 1, chunks: st.chunks } }
                } else {
                  if st.depth == 0 && (c == "\n" || c == ";") {
                    do {
                      new_chunks :: push_chunk_(src, st.chunks, st.start, st.i)
                      { state: { i: st.i + 1, start: st.i + 1, depth: 0, chunks: new_chunks } }
                    }
                  } else {
                    { state: { i: st.i + 1, start: st.start, depth: st.depth, chunks: st.chunks } }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  --- parse_chunk_: parse a statement chunk into an AST arena via FFI.
  --- TODO: error handling.
  parse_chunk_ :: [lang, text] ~> ffi("parse", "parse_chunk", [lang, text])

  --- is_bare_module_name_: whether a module specifier is a bare name.
  is_bare_module_name_ :: spec ~> do {
    len :: char.length(spec)
    if len == 0 {
      false
    } else {
      do {
        head_char :: char.slice(spec, 0, 1)
        (char.is_alpha(head_char) || head_char == "_") && all_valid_module_chars_(spec, 0)
      }
    }
  }

  --- all_valid_module_chars_: true if all chars are alnum, _, or -.
  all_valid_module_chars_ :: [spec, start] ~> while { i: start, ok: true } {
    [st] ~> if !st.ok || st.i >= char.length(spec) {
      { out: st.ok }
    } else {
      do {
        c :: char.slice(spec, st.i, st.i + 1)
        if char.is_alnum(c) || c == "_" || c == "-" {
          { state: { i: st.i + 1, ok: true } }
        } else {
          { out: false }
        }
      }
    }
  }

  --- stmt_imp_bound_names_: names bound by a stmt.import node.
  stmt_imp_bound_names_ :: [ast, node] ~> do {
    children :: children_of(node)
    payload :: tget(node, "payload")
    bound1 :: if array.is_empty(children) {
      []
    } else {
      do {
        child :: ast_at(ast, array.first(children))
        if tget(child, "kind") == "var" {
          [var_name(child)]
        } else {
          []
        }
      }
    }
    alias :: if is_obj(payload) { tget(payload, "alias") } else { null }
    names :: if is_obj(payload) { tget(payload, "names") } else { null }
    path :: if is_obj(payload) { tget(payload, "path") } else { null }
    bound2 :: if alias != null && alias != "" {
      [alias]
    } else {
      if names != null && names != "" {
        [names]
      } else {
        if path != null && is_bare_module_name_(path) {
          [path]
        } else {
          []
        }
      }
    }
    [...bound1, ...bound2]
  }

  --- binding_target_name_: extract the name bound by an assign target.
  binding_target_name_ :: [self, lang, ast, node_ref] ~> do {
    node :: ast_at(ast, node_ref)
    kind :: tget(node, "kind")
    if kind == "var" {
      var_name(node)
    } else {
      if kind == "type-annot" {
        do {
          children :: children_of(node)
          subject_idx :: child_role_index(lang, kind, "subject")
          idx :: if subject_idx != null { subject_idx } else { 0 }
          if idx < array.len(children) {
            self(self, lang, ast, array.at(children, idx))
          } else {
            null
          }
        }
      } else {
        null
      }
    }
  }

  --- collect_data_ctors_: collect constructor names from a data node.
  collect_data_ctors_ :: [lang, ast, node] ~> do {
    children :: children_of(node)
    ctors_idx :: child_role_index(lang, tget(node, "kind"), "constructors")
    if ctors_idx != null && ctors_idx < array.len(children) {
      do {
        ctors_ref :: array.at(children, ctors_idx)
        ctors_node :: ast_at(ast, ctors_ref)
        collect_ctor_names_(collect_ctor_names_, ast, children_of(ctors_node), [])
      }
    } else {
      []
    }
  }

  --- collect_ctor_names_: walk constructor children and collect var names.
  collect_ctor_names_ :: [self, ast, children, acc] ~> if array.is_empty(children) {
    acc
  } else {
    do {
      child_node :: ast_at(ast, array.first(children))
      if tget(child_node, "kind") == "var" {
        self(self, ast, array.drop(children, 1), [...acc, var_name(child_node)])
      } else {
        self(self, ast, array.drop(children, 1), acc)
      }
    }
  }

  --- add_seen_: add names to the seen map, detecting duplicates.
  add_seen_ :: [self, seen, names, idx] ~> if array.is_empty(names) {
    seen
  } else {
    do {
      nm :: array.first(names)
      existing :: hash_map.get(seen, nm, null)
      new_seen :: if existing != null {
        do {
          dups :: hash_map.get_or(seen, "__dups__", [])
          hash_map.set(seen, "__dups__", [...dups, { name: nm, first_idx: existing, dup_idx: idx }])
        }
      } else {
        hash_map.set(seen, nm, idx)
      }
      self(self, new_seen, array.drop(names, 1), idx)
    }
  }

  --- walk_pattern_children_: collect pattern-bound names.
  walk_pattern_children_ :: [self, ast, children, acc] ~> if array.is_empty(children) {
    acc
  } else {
    do {
      child_node :: ast_at(ast, array.first(children))
      ckind :: tget(child_node, "kind")
      if ckind == "var" {
        do {
          vname :: var_name(child_node)
          if vname == "_" {
            self(self, ast, array.drop(children, 1), acc)
          } else {
            self(self, ast, array.drop(children, 1), [...acc, vname])
          }
        }
      } else {
        do {
          sub_names :: self(self, ast, children_of(child_node), [])
          self(self, ast, array.drop(children, 1), [...acc, ...sub_names])
        }
      }
    }
  }

  --- pattern_bound_names_: collect names bound by a pattern node.
  pattern_bound_names_ :: [lang, ast, node] ~> walk_pattern_children_(walk_pattern_children_, ast, children_of(node), [])

  --- bind_names_: add an array of names to a scope (hash map).
  bind_names_ :: [scope, names] ~> if array.is_empty(names) {
    scope
  } else {
    bind_names_(hash_map.set(scope, array.first(names), true), array.drop(names, 1))
  }

  --- walk_children_: walk a node's children and check each expression.
  walk_children_ :: [self, lang, ast, children, scope, stmt, state] ~> if array.is_empty(children) {
    state
  } else {
    do {
      new_state :: self(self, lang, ast, array.first(children), scope, stmt, state)
      self(self, lang, ast, array.drop(children, 1), scope, stmt, new_state)
    }
  }

  --- walk_statements_: walk statement children with sequential scope.
  walk_statements_ :: [self, lang, ast, children, scope, stmt, state] ~> if array.is_empty(children) {
    state
  } else {
    do {
      child_ref :: array.first(children)
      child_node :: ast_at(ast, child_ref)
      ckind :: tget(child_node, "kind")
      new_scope :: if ckind == "assign" {
        do {
          cc :: children_of(child_node)
          target_ref :: if array.is_empty(cc) { null } else { array.first(cc) }
          tname :: if target_ref != null { binding_target_name_(binding_target_name_, lang, ast, target_ref) } else { null }
          if tname != null { hash_map.set(scope, tname, true) } else { scope }
        }
      } else {
        if ckind == "stmt.import" {
          bind_names_(scope, stmt_imp_bound_names_(ast, child_node))
        } else {
          scope
        }
      }
      new_state :: self(self, lang, ast, child_ref, new_scope, stmt, state)
      self(self, lang, ast, array.drop(children, 1), new_scope, stmt, new_state)
    }
  }

  --- check_expr_: bottom-up expression scope check.
  --- Returns updated state { diags, refs }.
  --- TODO: rec fixpoint convergence and type inference are deferred.
  check_expr_ :: [self, lang, ast, node_ref, scope, stmt, state] ~> do {
    node :: ast_at(ast, node_ref)
    kind :: tget(node, "kind")
    if kind == "var" {
      do {
        vname :: var_name(node)
        if vname == "_" {
          state
        } else {
          if hash_map.has(scope, vname) {
            do {
              new_refs :: hash_map.set(tget(state, "refs"), vname, true)
              { diags: tget(state, "diags"), refs: new_refs }
            }
          } else {
            do {
              sp :: chunk_span_(stmt, stmt)
              diag :: make_diag("error", "unbound-wire: " + vname, sp)
              new_diags :: [...tget(state, "diags"), diag]
              new_refs :: hash_map.set(tget(state, "refs"), vname, true)
              { diags: new_diags, refs: new_refs }
            }
          }
        }
      }
    } else {
      if kind == "assign" {
        do {
          children :: children_of(node)
          target_idx :: child_role_index(lang, kind, "target")
          t_idx :: if target_idx != null { target_idx } else { 0 }
          value_idx :: child_role_index(lang, kind, "value")
          v_idx :: if value_idx != null { value_idx } else { 1 }
          target_ref :: if t_idx < array.len(children) { array.at(children, t_idx) } else { null }
          value_ref :: if v_idx < array.len(children) { array.at(children, v_idx) } else { null }
          tname :: if target_ref != null { binding_target_name_(binding_target_name_, lang, ast, target_ref) } else { null }
          new_scope :: if tname != null { hash_map.set(scope, tname, true) } else { scope }
          if value_ref != null {
            self(self, lang, ast, value_ref, new_scope, stmt, state)
          } else {
            state
          }
        }
      } else {
        if kind == "block" || kind == "do" {
          do {
            children :: children_of(node)
            stmts_idx :: child_role_index(lang, kind, "statements")
            s_idx :: if stmts_idx != null { stmts_idx } else { 0 }
            stmt_children :: if s_idx < array.len(children) {
              do {
                stmts_node :: ast_at(ast, array.at(children, s_idx))
                children_of(stmts_node)
              }
            } else {
              children
            }
            inner_scope :: if kind == "block" { hash_map.set({}, "__parent__", scope) } else { scope }
            walk_statements_(self, lang, ast, stmt_children, inner_scope, stmt, state)
          }
        } else {
          if kind == "fn" || kind == "arrow" || kind == "lambda" {
            do {
              children :: children_of(node)
              params_idx :: child_role_index(lang, kind, "params")
              p_idx :: if params_idx != null { params_idx } else { 0 }
              body_idx :: child_role_index(lang, kind, "body")
              b_idx :: if body_idx != null { body_idx } else { 1 }
              params_ref :: if p_idx < array.len(children) { array.at(children, p_idx) } else { null }
              body_ref :: if b_idx < array.len(children) { array.at(children, b_idx) } else { null }
              param_names :: if params_ref != null {
                pattern_bound_names_(lang, ast, ast_at(ast, params_ref))
              } else {
                []
              }
              inner_scope :: bind_names_(scope, param_names)
              if body_ref != null {
                self(self, lang, ast, body_ref, inner_scope, stmt, state)
              } else {
                state
              }
            }
          } else {
            if kind == "data" {
              state
            } else {
              walk_children_(self, lang, ast, children_of(node), scope, stmt, state)
            }
          }
        }
      }
    }
  }

  --- collect_all_bound_names_: gather all bound names from bindings.
  collect_all_bound_names_ :: [bindings] ~> do {
    assign_names :: collect_assign_names_(tget(bindings, "assigns"))
    ctor_names :: collect_ctor_list_names_(tget(bindings, "ctors"))
    [...assign_names, ...ctor_names]
  }

  --- collect_assign_names_: extract names from assign binding records.
  collect_assign_names_ :: [assigns] ~> if array.is_empty(assigns) {
    []
  } else {
    [tget(array.first(assigns), "name"), ...collect_assign_names_(array.drop(assigns, 1))]
  }

  --- collect_ctor_list_names_: extract names from ctor binding records.
  collect_ctor_list_names_ :: [ctors] ~> if array.is_empty(ctors) {
    []
  } else {
    do {
      names :: tget(array.first(ctors), "names")
      [...names, ...collect_ctor_list_names_(array.drop(ctors, 1))]
    }
  }

  --- collect_imp_names_: extract all names from import binding records.
  collect_imp_names_ :: [imps] ~> if array.is_empty(imps) {
    []
  } else {
    do {
      names :: tget(array.first(imps), "names")
      [...names, ...collect_imp_names_(array.drop(imps, 1))]
    }
  }

  --- any_name_used_: true if any name in the list is in the refs set.
  any_name_used_ :: [names, refs] ~> if array.is_empty(names) {
    false
  } else {
    if hash_map.has(refs, array.first(names)) {
      true
    } else {
      any_name_used_(array.drop(names, 1), refs)
    }
  }

  --- report_dups_: report each duplicate binding.
  report_dups_ :: [dups, diags, src] ~> if array.is_empty(dups) {
    diags
  } else {
    do {
      dup :: array.first(dups)
      diag :: make_diag("error", "duplicate-binding: " + tget(dup, "name"), make_span(0, 0))
      report_dups_(array.drop(dups, 1), [...diags, diag], src)
    }
  }

  --- check_exports_bound_: verify every exported name is bound.
  check_exports_bound_ :: [exports, bindings, diags, src] ~> if array.is_empty(exports) {
    diags
  } else {
    do {
      exp :: array.first(exports)
      ename :: tget(exp, "name")
      all_names :: collect_all_bound_names_(bindings)
      if !array.contains(all_names, ename) {
        do {
          diag :: make_diag("error", "unbound-export: " + ename, make_span(0, 0))
          check_exports_bound_(array.drop(exports, 1), bindings, [...diags, diag], src)
        }
      } else {
        check_exports_bound_(array.drop(exports, 1), bindings, diags, src)
      }
    }
  }

  --- check_unused_imps_: verify every import projection is used.
  check_unused_imps_ :: [imps, refs, stmts, diags, src] ~> if array.is_empty(imps) {
    diags
  } else {
    do {
      imp :: array.first(imps)
      if !any_name_used_(tget(imp, "names"), refs) {
        do {
          diag :: make_diag("warning", "unused-import", make_span(0, 0))
          check_unused_imps_(array.drop(imps, 1), refs, stmts, [...diags, diag], src)
        }
      } else {
        check_unused_imps_(array.drop(imps, 1), refs, stmts, diags, src)
      }
    }
  }

  --- collect_decl_idxs_: collect statement indices that are declarations.
  collect_decl_idxs_ :: [stmts_info, acc] ~> if array.is_empty(stmts_info) {
    acc
  } else {
    do {
      info :: array.first(stmts_info)
      ikind :: tget(info, "kind")
      is_decl :: ikind == "import" || ikind == "export" || ikind == "data"
      new_acc :: if is_decl { [...acc, tget(info, "stmt_idx")] } else { acc }
      collect_decl_idxs_(array.drop(stmts_info, 1), new_acc)
    }
  }

  --- build_decl_set_: build a hash map set from an array of indices.
  build_decl_set_ :: [idxs, acc] ~> if array.is_empty(idxs) {
    acc
  } else {
    build_decl_set_(array.drop(idxs, 1), hash_map.set(acc, array.first(idxs), true))
  }

  --- build_module_scope_: build the module-level scope from bindings.
  build_module_scope_ :: [bindings] ~> do {
    imp_names :: collect_imp_names_(tget(bindings, "imports"))
    assign_names :: collect_assign_names_(tget(bindings, "assigns"))
    ctor_names :: collect_ctor_list_names_(tget(bindings, "ctors"))
    bind_names_({}, [...imp_names, ...assign_names, ...ctor_names])
  }

  --- collect_bindings_: walk top-level statements and collect bindings.
  --- Returns { imports, exports, assigns, ctors, seen, stmts_info }.
  collect_bindings_ :: [lang, stmts, src] ~> do {
    result :: while { idx: 0, state: { imports: [], exports: [], assigns: [], ctors: [], seen: {}, stmts_info: [] } } {
      [st] ~> if st.idx >= array.len(stmts) {
        { out: st.state }
      } else {
        do {
          chunk :: array.at(stmts, st.idx)
          ast :: parse_chunk_(lang, tget(chunk, "text"))
          root :: ast_at(ast, ast_len(ast) - 1)
          kind :: tget(root, "kind")
          if kind == "stmt.import" {
            do {
              names :: stmt_imp_bound_names_(ast, root)
              new_seen :: add_seen_(add_seen_, st.state.seen, names, st.idx)
              { state: { idx: st.idx + 1, state: {
                imports: [...st.state.imports, { names: names, stmt_idx: st.idx }],
                exports: st.state.exports,
                assigns: st.state.assigns,
                ctors: st.state.ctors,
                seen: new_seen,
                stmts_info: [...st.state.stmts_info, { kind: "import", stmt_idx: st.idx, names: names }]
              } } }
            }
          } else {
            if kind == "stmt.export" {
              do {
                children :: children_of(root)
                child_ref :: if array.is_empty(children) { null } else { array.first(children) }
                cname :: if child_ref != null { var_name(ast_at(ast, child_ref)) } else { null }
                if cname != null {
                  do {
                    new_seen :: st.state.seen
                    { state: { idx: st.idx + 1, state: {
                      imports: st.state.imports,
                      exports: [...st.state.exports, { name: cname, stmt_idx: st.idx }],
                      assigns: st.state.assigns,
                      ctors: st.state.ctors,
                      seen: new_seen,
                      stmts_info: [...st.state.stmts_info, { kind: "export", stmt_idx: st.idx, names: [cname] }]
                    } } }
                  }
                } else {
                  { state: { idx: st.idx + 1, state: st.state } }
                }
              }
            } else {
              if kind == "assign" {
                do {
                  children :: children_of(root)
                  child_ref :: if array.is_empty(children) { null } else { array.first(children) }
                  bname :: if child_ref != null { binding_target_name_(binding_target_name_, lang, ast, child_ref) } else { null }
                  if bname != null {
                    do {
                      new_seen :: add_seen_(add_seen_, st.state.seen, [bname], st.idx)
                      { state: { idx: st.idx + 1, state: {
                        imports: st.state.imports,
                        exports: st.state.exports,
                        assigns: [...st.state.assigns, { name: bname, stmt_idx: st.idx }],
                        ctors: st.state.ctors,
                        seen: new_seen,
                        stmts_info: [...st.state.stmts_info, { kind: "assign", stmt_idx: st.idx, names: [bname] }]
                      } } }
                    }
                  } else {
                    { state: { idx: st.idx + 1, state: st.state } }
                  }
                }
              } else {
                if kind == "data" {
                  do {
                    ctors :: collect_data_ctors_(lang, ast, root)
                    new_seen :: add_seen_(add_seen_, st.state.seen, ctors, st.idx)
                    { state: { idx: st.idx + 1, state: {
                      imports: st.state.imports,
                      exports: st.state.exports,
                      assigns: st.state.assigns,
                      ctors: [...st.state.ctors, { names: ctors, stmt_idx: st.idx }],
                      seen: new_seen,
                      stmts_info: [...st.state.stmts_info, { kind: "data", stmt_idx: st.idx, names: ctors }]
                    } } }
                  }
                } else {
                  { state: { idx: st.idx + 1, state: st.state } }
                }
              }
            }
          }
        }
      }
    }
    result
  }

  --- check_module_: main entry point for module-level scope checking.
  check_module_ :: [self, lang, src] ~> do {
    stmts :: split_statements(src)
    bindings :: collect_bindings_(lang, stmts, src)
    imps :: tget(bindings, "imports")
    exports :: tget(bindings, "exports")
    seen :: tget(bindings, "seen")
    stmts_info :: tget(bindings, "stmts_info")

    dup_diags :: report_dups_(hash_map.get_or(seen, "__dups__", []), [], src)
    export_diags :: check_exports_bound_(exports, bindings, dup_diags, src)
    module_scope :: build_module_scope_(bindings)
    decl_set :: build_decl_set_(collect_decl_idxs_(stmts_info, []), {})

    expr_state :: while { idx: 0, state: { diags: export_diags, refs: {} } } {
      [st] ~> if st.idx >= array.len(stmts) {
        { out: st.state }
      } else {
        do {
          is_decl :: hash_map.has(decl_set, st.idx)
          if is_decl {
            { state: { idx: st.idx + 1, state: st.state } }
          } else {
            do {
              chunk :: array.at(stmts, st.idx)
              ast :: parse_chunk_(lang, tget(chunk, "text"))
              new_state :: check_expr_(check_expr_, lang, ast, ast_len(ast) - 1, module_scope, chunk, st.state)
              { state: { idx: st.idx + 1, state: new_state } }
            }
          }
        }
      }
    }

    expr_state2 :: while { remaining: stmts_info, state: expr_state } {
      [st] ~> if array.is_empty(st.remaining) {
        { out: st.state }
      } else {
        do {
          info :: array.first(st.remaining)
          ikind :: tget(info, "kind")
          if ikind == "import" || ikind == "export" || ikind == "data" {
            { state: { remaining: array.drop(st.remaining, 1), state: st.state } }
          } else {
            do {
              stmt_idx :: tget(info, "stmt_idx")
              chunk :: array.at(stmts, stmt_idx)
              ast :: parse_chunk_(lang, tget(chunk, "text"))
              root :: ast_at(ast, ast_len(ast) - 1)
              root_kind :: tget(root, "kind")
              effective_root :: if root_kind == "stmt.export" {
                do {
                  rc :: children_of(root)
                  if array.is_empty(rc) { ast_len(ast) - 1 } else { array.first(rc) }
                }
              } else {
                ast_len(ast) - 1
              }
              eff_node :: ast_at(ast, effective_root)
              eff_kind :: tget(eff_node, "kind")
              eff_children :: children_of(eff_node)
              v_idx :: child_role_index(lang, eff_kind, "value")
              value_idx :: if v_idx != null { v_idx } else { 1 }
              new_state :: if value_idx < array.len(eff_children) {
                check_expr_(check_expr_, lang, ast, array.at(eff_children, value_idx), module_scope, chunk, st.state)
              } else {
                st.state
              }
              { state: { remaining: array.drop(st.remaining, 1), state: new_state } }
            }
          }
        }
      }
    }

    final_refs :: tget(expr_state2, "refs")
    expr_diags :: tget(expr_state2, "diags")
    check_unused_imps_(imps, final_refs, stmts, expr_diags, src)
  }

  {
    check_module: [lang, src] ~> check_module_(check_module_, lang, src),

    collect_bindings: [lang, stmts, src] ~> collect_bindings_(lang, stmts, src),

    check_unbound_wires: [lang, ast, node_ref, scope, stmt] ~>
      check_expr_(check_expr_, lang, ast, node_ref, scope, stmt, { diags: [], refs: {} })
  }
}
