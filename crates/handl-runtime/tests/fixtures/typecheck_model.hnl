--- typecheck_model.hnl
---
--- ADR-0105: "Delete the Rust NBE Typechecker, Replace with Handl-Authored
--- Models".
---
--- This is the typechecker driver. It walks the AST, manages the typing
--- context Gamma, performs unification, and dispatches tag interpretation
--- to type_model.hnl (which handles HoTT tag-to-judgment interpretation).
---
--- Homotopy Type Theory (HoTT) is the semantic foundation:
---   Types are spaces, values are points, equality is paths.
---   Unification is path equality: unify(a, b) constructs a Path_A(a, b)
---   witness, not structural decidable equality.
---   Rewrites are 2-cells, refinements are propositions, grades are coeffects.
---
--- The driver does NOT interpret HoTT tags itself; that is type_model.hnl's
--- job. When a type-rule scheme contains a Term tag (Arr, Seq, First,
--- Choice, Loop, App, Handle, Op, Path, Equiv, Refine, etc.), the driver
--- delegates to type_model.hnl's run function.
---
--- Judgment ops (the ~50 ops from eval_judgment in the NBE engine):
---   synth_child, check_child, eval_child, proj_child, unify, subtype,
---   bind, result, eval_scheme, fresh_meta, solve_meta, lookup, extend,
---   check, synth, construct, match_type, node_payload, payload_field,
---   json_type_construct, field, make_array, type_field, synth_last_child,
---   synth_block, check_block, check_all_children, synth_match_arms,
---   synth_rec, synth_function, synth_type_annot, record_field_type,
---   array_element_type, synth_object_record, check_object_record,
---   construct_pi, pi_apply, unify_pi, check_pi_body, construct_sigma,
---   construct_forall, forall_apply, unify_forall, construct_vau, vau_apply,
---   unify_vau, construct_eq, construct_empty, check_refl, eq_reduce,
---   transport, synth_transport, synth_j,
---   construct_universe, universe_level, universe_max, construct_membership,
---   check_membership, eval_membership, construct_collection, marshalable,
---   foreign_type, quote, normalize.
---
--- This module depends on the host tag capability and on the runtime
--- hash_map, array, and typeof modules, and on type_model.hnl for HoTT
--- tag interpretation.
---
--- Mutual recursion: synth_node_, check_node_, eval_scheme_, and
--- eval_judgment_ form a cycle (synth → eval_scheme → eval_judgment →
--- synth). In a `do` block, later bindings are invisible to earlier
--- ones, so direct references like `eval_scheme_(eval_scheme_, ...)` fail
--- when the callee is defined after the caller. The cycle is broken by
--- passing a `funcs` record as the first parameter to each function.
--- Each function looks up siblings via `funcs.fn_name(funcs, ...)` instead
--- of direct references. The `funcs` record is created after all four
--- functions are defined.

do {
  tget :: [obj, key]~> get_or(obj, key, null)

  is_obj :: v ~> if type_of(v) == "obj" {
    if v.__tag__ == null
       && v.__arrow__ == null
       && v.__pair__ == null
       && v.__either__ == null
       && v.__meta__ == null { true } else { false }
  } else {
    false
  }

  is_pair :: v ~> if type_of(v) == "obj" {
    if v.__pair__ != null { true } else { false }
  } else {
    false
  }

  is_empty :: [xs]~> match xs {
    []: true,
    [h, ...t]: false
  }

  len :: [xs]~> do {
    n :: 0
    for x in xs {
      n = n + 1
    }
    n
  }

  rev :: [ys]~> do {
    r :: []
    for x in ys {
      r = [x, ...r]
    }
    r
  }

  at :: [xs, i]~> if type_of(i) != "num" {
    null
  } else {
    if i < 0 {
    null
  } else {
    do {
      out :: null
      k :: 0
      for x in xs {
        do {
          if k == i { out = x };
          k = k + 1
        }
      }
      out
    }
  }
  }

  concat :: [a, b]~> do {
    r :: []
    for x in a {
      r = [x, ...r]
    }
    for y in b {
      r = [y, ...r]
    }
    rev(r)
  }

  drop :: [xs, n]~> do {
    r :: []
    k :: 0
    for x in xs {
      do {
        if k >= n { r = [x, ...r] };
        k = k + 1
      }
    }
    rev(r)
  }

  slice :: [xs, start, n]~> do {
    r :: []
    k :: 0
    for x in xs {
      do {
        if k >= start && k < start + n { r = [x, ...r] };
        k = k + 1
      }
    }
    rev(r)
  }

  take :: [xs, n]~> slice(xs, 0, n)

  last :: [xs]~> do {
    out :: null
    for x in xs {
      out = x
    }
    out
  }

  first_value :: [xs]~> match xs {
    []: null,
    [h, ...t]: h
  }

  pair_fst :: v ~> if v.__pair__ == null { null } else { first_value(v.__pair__) }
  pair_snd :: v ~> if v.__pair__ == null { null } else { at(v.__pair__, 1) }

  pair :: [a, b]~> set({}, "__pair__", [a, b])

  is_either :: v ~> if type_of(v) == "obj" {
    if v.__either__ != null { true } else { false }
  } else {
    false
  }

  either_value :: v ~> if v == null { null } else { v.value }

  is_meta :: v ~> if type_of(v) == "obj" {
    do {
      id :: v.__meta__
      if type_of(id) == "num" { id != 0 } else { false }
    }
  } else {
    false
  }

  meta_id :: v ~> if type_of(v) == "obj" {
    id :: v.__meta__
    if type_of(id) == "num" { id } else { 0 }
  } else { 0 }

  meta_value :: id ~> set({}, "__meta__", id)

  --- ADR-0106 Phase 2/4: nominal (`{"__sym__": ...}`) readers. These mirror
  --- the defensive style of `is_meta`/`meta_id` — every field read is
  --- type-guarded before use, and any malformed shape yields `null` so the
  --- caller can fall back (see the `subtype` rule below).
  ---
  --- NB: a well-formed nominal is decoded by the engine into a distinct
  --- `sym` value, so `v.__sym__` (engine field access) would fail; reads go
  --- through `tget` (a host op that sees the serialized `{"__sym__": ...}`
  --- object).

  --- The `handle` of a well-formed nominal, or `null` when `v` is not a
  --- nominal / `__sym__` is missing or not an object / `handle` is missing,
  --- non-numeric, or zero (identity handles are minted from 1).
  sym_handle :: v ~> if type_of(v) == "obj" {
    do {
      inner :: tget(v, "__sym__")
      if type_of(inner) == "obj" {
        do {
          h :: tget(inner, "handle")
          if type_of(h) == "num" { if h != 0 { h } else { null } } else { null }
        }
      } else {
        null
      }
    }
  } else {
    null
  }

  --- The nominal parent of `v` (a nominal or `null`), or `null` when `v` is
  --- not a nominal. A present-but-malformed `parent` is caught by
  --- `sym_chain`, which rejects the whole chain.
  sym_parent :: v ~> if type_of(v) == "obj" {
    do {
      inner :: tget(v, "__sym__")
      if type_of(inner) == "obj" { tget(inner, "parent") } else { null }
    }
  } else {
    null
  }

  --- `sym_chain(v)` — the ADR-0106 Phase 2 encoding is
  --- `{"__sym__": {"handle": n, "name": "...", "parent": <sym or null>}}`.
  --- Returns the handle chain as an array of numbers, outermost-first (the
  --- nominal's own handle at index 0), or `null` when `v` is not a
  --- well-formed nominal (missing `__sym__`, missing/non-numeric/zero
  --- `handle`, or malformed `parent`). Walks iteratively (no deep
  --- interpreter recursion) and returns `null` at any well-formedness
  --- failure, so a malformed node rejects the whole chain.
  sym_chain :: v ~> while { out: [], cur: v } {
    [st]~> do {
      h :: sym_handle(st.cur)
      if h == null {
        { out: null }
      } else {
        parent :: sym_parent(st.cur)
        new_out :: [...st.out, h]
        if parent == null {
          { out: new_out }
        } else {
          { state: { out: new_out, cur: parent } }
        }
      }
    }
  }

  --- Membership over a chain (both are small arrays of handles).
  chain_has :: [xs, h]~> do {
    found :: false
    for x in xs {
      if x == h { found = true }
    }
    found
  }

  type_tag :: v ~> if type_of(v) == "obj" {
    tag :: v.__tag__
    if tag == null { "" } else { tag }
  } else { "" }

  make_type :: [tag_name, payload]~> do {
    base :: if is_obj(payload) { payload } else { set({}, "__value__", payload) }
    tagged :: set(base, "__tag__", tag_name)
    set(tagged, "__registry__", "handl.canonical")
  }

  gamma_new :: unit ~> []

  gamma_extend :: [gamma, name, typ]~> concat(gamma, [set(set({}, "name", name), "type", typ)])

  gamma_lookup :: [gamma, name]~> while { found: null, remaining: gamma } {
    [s]~> if is_empty(s.remaining) {
      { out: s.found }
    } else {
      do {
        entry :: last(s.remaining)
        entry_name :: get_or(entry, "name", "")
        if entry_name == name {
          { out: get_or(entry, "type", null) }
        } else {
          { state: { found: s.found, remaining: take(s.remaining, len(s.remaining) - 1) } }
        }
      }
    }
  }

  gamma_lookup_index :: [gamma, idx]~> do {
    entry :: at(gamma, idx)
    get_or(entry, "type", null)
  }

  gamma_mark :: gamma ~> len(gamma)

  gamma_restore :: [gamma, mark]~> slice(gamma, 0, mark)

  metas_new :: unit ~> []

  metas_solve :: [metas, id, val]~> if type_of(metas) != "arr" { [] } else {
    if type_of(id) == "num" { concat(concat(take(metas, id), [val]), drop(metas, id + 1)) } else { metas }
  }

  metas_lookup :: [metas, id]~> if type_of(metas) != "arr" {
    null
  } else {
    if type_of(id) == "num" { if id < len(metas) { at(metas, id) } else { null } } else { null }
  }

  zonk_fields :: [self, zonk, val, metas, ks, result]~> if is_empty(ks) {
    result
  } else {
    do {
      key :: first_value(ks)
      field_val :: get_or(val, key, null)
      zonked :: zonk(field_val, metas)
      new_result :: set(result, key, zonked)
      self(self, zonk, val, metas, drop(ks, 1), new_result)
    }
  }

  zonk_list :: [self, zonk, metas, xs, result]~> if is_empty(xs) {
    result
  } else {
    do {
      head_val :: first_value(xs)
      zonked :: zonk(head_val, metas)
      self(self, zonk, metas, drop(xs, 1), [...result, zonked])
    }
  }

  zonk :: [self, val, metas]~> if is_meta(val) {
    do {
      id :: meta_id(val)
      solved :: metas_lookup(metas, id)
      if solved == null {
        val
      } else {
        self(self, solved, metas)
      }
    }
  } else {
    if is_obj(val) {
      zonk_fields(zonk_fields, self, val, metas, keys(val), {})
    } else {
      if type_of(val) == "arr" {
        zonk_list(zonk_list, self, metas, val, [])
      } else {
        val
      }
    }
  }

  occurs_in :: [self, target_meta_id, v]~> if is_meta(v) {
    meta_id(v) == target_meta_id
  } else {
    false
  }

  total_eval_ :: [callee, args]~> do {
    ctag :: type_tag(callee)
    if ctag == "RecordProj" {
      do {
        record_term :: get_or(callee, "record", null)
        field :: get_or(callee, "field", "")
        record_name :: if type_of(record_term) == "str" {
          record_term
        } else {
          if type_tag(record_term) == "Const" {
            get_or(record_term, "value", "")
          } else {
            if type_tag(record_term) == "var" {
              get_or(record_term, "name", "")
            } else {
              ""
            }
          }
        }
        if record_name == "math" && field == "min" && len(args) == 2 {
          if type_of(at(args, 0)) == "num" && type_of(at(args, 1)) == "num" {
            if at(args, 0) < at(args, 1) { at(args, 0) } else { at(args, 1) }
          } else { null }
        } else {
          if record_name == "array" && field == "len" && len(args) == 1 {
            do {
              a :: at(args, 0)
              if type_of(a) == "arr" {
                len(a)
              } else {
                if type_tag(a) == "List" || type_tag(a) == "list" {
                  get_or(a, "length", null)
                } else {
                  null
                }
              }
            }
          } else { null }
        }
      }
    } else {
      if ctag == "var" {
        do {
          vname :: get_or(callee, "name", "")
          if vname == "len" && len(args) == 1 && type_of(at(args, 0)) == "arr" { len(at(args, 0)) } else { null }
        }
      } else {
        null
      }
    }
  }

  --- Helpers for total normalization of List length indices.  We reduce
  --- handl arrow applications (math.min, array.len, ...) to concrete numbers
  --- when the arguments are themselves concrete, and leave expressions
  --- untouched when they still contain unresolved variables.

  eval_args_ :: [self, funcs, env, terms]~> while { result: [], remaining: terms } {
    [st]~> if is_empty(st.remaining) {
      { out: st.result }
    } else {
      do {
        t :: first_value(st.remaining)
        v :: self(self, funcs, env, t)
        { state: { result: concat(st.result, [v]), remaining: drop(st.remaining, 1) } }
      }
    }
  }

  is_host_arrow_ :: v ~> if type_of(v) == "obj" {
    get_or(v, "__arrow__", false) == true
  } else {
    false
  }

  normalize_value_ :: [self, funcs, env, v]~> if type_of(v) == "num" {
    v
  } else {
    if type_tag(v) == "var" {
      do {
        vname :: get_or(v, "name", "")
        resolved :: if vname != "" && env != null && env != {} {
          tc_lookup(env, vname)
        } else {
          null
        }
        if resolved != null && (type_tag(resolved) == "List" || type_tag(resolved) == "list") {
          resolved
        } else {
          v
        }
      }
    } else {
      if type_tag(v) == "type.number" {
        do {
          inner :: get_or(v, "__value__", null)
          if type_of(inner) == "num" { inner } else { self(self, funcs, env, inner) }
        }
      } else {
        if type_tag(v) == "Arr" || type_tag(v) == "Const" {
          do {
            evaled :: funcs.eval_scheme_(funcs, {}, 0, v, null).val
            self(self, funcs, env, evaled)
          }
        } else {
          if type_tag(v) == "App" {
            do {
              callee_term :: get_or(v, "callee", null)
              arg_terms :: get_or(v, "args", [])
              callee_val :: self(self, funcs, env, callee_term)
              arg_vals :: eval_args_(self, funcs, env, arg_terms)
              total :: total_eval_(callee_term, arg_vals)
              if type_of(total) == "num" {
                total
              } else {
                if is_host_arrow_(callee_val) {
                  if type_of(arg_vals) == "arr" {
                    if len(arg_vals) <= len(get_or(callee_val, "params", [])) {
                    do {
                      raw :: if len(arg_vals) == 0 {
                        callee_val()
                      } else {
                        if len(arg_vals) == 1 {
                          callee_val(at(arg_vals, 0))
                        } else {
                          if len(arg_vals) == 2 {
                            callee_val(at(arg_vals, 0), at(arg_vals, 1))
                          } else {
                            if len(arg_vals) == 3 {
                              callee_val(at(arg_vals, 0), at(arg_vals, 1), at(arg_vals, 2))
                            } else {
                              v
                            }
                          }
                        }
                      }
                      self(self, funcs, env, raw)
                    }
                    } else {
                      v
                    }
                  } else {
                    v
                  }
                } else {
                  v
                }
              }
            }
          } else {
            if is_host_arrow_(v) {
              do {
                params :: get_or(v, "params", [])
                if len(params) == 0 {
                  do {
                    raw :: v()
                    self(self, funcs, env, raw)
                  }
                } else {
                  v
                }
              }
            } else {
              v
            }
          }
        }
      }
    }
  }

  normalize_type_ :: [self, funcs, env, typ]~> if type_tag(typ) == "List" || type_tag(typ) == "list" {
    do {
      element :: get_or(typ, "element", null)
      length :: get_or(typ, "length", null)
      norm_element :: if type_tag(element) == "List" || type_tag(element) == "list" { self(self, funcs, env, element) } else { element }
      norm_length :: normalize_value_(normalize_value_, funcs, env, length)
      set(set(typ, "element", norm_element), "length", norm_length)
    }
  } else {
    typ
  }

  unify_fields :: [self, funcs, a, b, metas, keys]~> if is_empty(keys) {
    { ok: true, metas: metas, path: funcs.make_type("Path", set(set({}, "frm", a), "to", b)) }
  } else {
    do {
      key :: first_value(keys)
      rest_keys :: drop(keys, 1)
      --- `param_name` is alpha-level bookkeeping (the bound name is not
      --- part of the function type's identity); `ctor` is constructor-
      --- signature provenance from `synth_data`; `via` is the `Path`
      --- witness recorded by transport (proof-relevant provenance —
      --- ADR-0120). None participates in type equality.
      is_structural :: key == "__tag__" || key == "__registry__" || key == "body_closure" || key == "param_name" || key == "ctor" || key == "via"
      if is_structural {
        unify_fields(self, funcs, a, b, metas, rest_keys)
      } else {
        do {
          val_a :: get_or(a, key, null)
          val_b :: get_or(b, key, null)
          result :: self(self, funcs, val_a, val_b, metas)
          if result.ok {
            unify_fields(self, funcs, a, b, result.metas, rest_keys)
          } else {
            { ok: false, metas: metas, path: null, decided: get_or(result, "decided", false) }
          }
        }
      }
    }
  }

  --- Element-wise unification for arrays (index lists, `type.array`
  --- elements, `family_app` arg tuples): same length required, then
  --- pairwise `unify` accumulating the meta solution. Before this,
  --- arrays only compared by `==`, so a metavariable nested inside an
  --- array could never solve. `self` is `unify_` — element recursion
  --- goes through full unification.
  unify_list_ :: [self, funcs, xs, ys, metas]~> if len(xs) != len(ys) {
    { ok: false, metas: metas, path: null, decided: false }
  } else {
    do {
      walk :: while { ok: true, metas: metas, decided: false, remaining: xs, rest: ys } {
        [st]~> if is_empty(st.remaining) || !st.ok {
          { out: { ok: st.ok, metas: st.metas, decided: st.decided } }
        } else {
          do {
            r :: self(self, funcs, first_value(st.remaining), first_value(st.rest), st.metas)
            { state: { ok: r.ok, metas: r.metas, decided: if r.ok { st.decided } else { get_or(r, "decided", false) }, remaining: drop(st.remaining, 1), rest: drop(st.rest, 1) } }
          }
        }
      }
      { ok: walk.ok, metas: walk.metas, decided: walk.decided, path: funcs.make_type("Path", set(set({}, "frm", xs), "to", ys)) }
    }
  }

  --- Exact integer power by repeated multiplication — used by the
  --- nonlinear solver and by `closed_num_` for `binary.pow` terms
  --- (`**` computes on `num` in this evaluator, so `i^e` with a Nat
  --- exponent is exact).
  ipow_ :: [base, exp]~> while { result: 1, i: 0 } {
    [st]~> if st.i >= exp {
      { out: st.result }
    } else {
      { state: { result: st.result * base, i: st.i + 1 } }
    }
  }

  --- The `i ≥ 0` with `i^e == n`, or `null` when no integer root
  --- exists. `i^e ≥ i` for `e ≥ 1`, so the search is bounded by `n`
  --- (plus a monotone overshoot stop) and its failure is *decided* —
  --- not stuck.
  iroot_ :: [n, e]~> while { i: 0, over: false } {
    [st]~> if st.over || st.i > n {
      { out: null }
    } else {
      do {
        p :: ipow_(st.i, e)
        if p == n {
          { out: st.i }
        } else {
          { state: { i: st.i + 1, over: p > n } }
        }
      }
    }
  }

  --- Evaluate a *closed* index term to a number: a nested `Bin`/`Un`
  --- over literals — e.g. a product `Bin{mul, 2, 3}` that survived as
  --- opaque, or a chain that zonks closed — counts as a *known*
  --- operand for the solver. Returns `null` while any leaf is symbolic
  --- (`var`, unsolved meta, `App`, …) — unknown, not zero.
  closed_num_ :: [self, t]~> if type_of(t) == "num" {
    t
  } else {
    if type_tag(t) == "Bin" {
      do {
        l :: self(self, get_or(t, "l", null))
        r :: self(self, get_or(t, "r", null))
        if l == null || r == null {
          null
        } else {
          bop :: get_or(t, "op", "")
          if bop == "binary.add" {
            l + r
          } else {
            if bop == "binary.sub" {
              l - r
            } else {
              if bop == "binary.mul" {
                l * r
              } else {
                if bop == "binary.div" {
                  if r != 0 { if l % r == 0 { l / r } else { null } } else { null }
                } else {
                  if bop == "binary.mod" {
                    if r != 0 { l % r } else { null }
                  } else {
                    if bop == "binary.pow" {
                      if r >= 0 { if r % 1 == 0 { ipow_(l, r) } else { null } } else { null }
                    } else {
                      null
                    }
                  }
                }
              }
            }
          }
        }
      }
    } else {
      if type_tag(t) == "Un" {
        do {
          v :: self(self, get_or(t, "operand", null))
          if v == null {
            null
          } else {
            if get_or(t, "op", "") == "unary.neg" { 0 - v } else { null }
          }
        }
      } else {
        null
      }
    }
  }

  --- Index-equation solving: an opaque `Bin` index term against a
  --- numeric target. This is definitional equality for the decidable
  --- fragment of index arithmetic — `Vec(n + 1)` accepts a `Vec(4)`
  --- scrutinee index by solving `n := 3`.
  ---
  ---   * linear shapes solve directly — `X + c = t`, `X - c = t`,
  ---     `c - X = t`, `X * c = t` (and mirrors, via commutative
  ---     canonicalization); nested `Bin`s recurse, so `(X - 1) + 1 = t`
  ---     resolves through the canonical form;
  ---   * bounded nonlinear shapes — `X * c = t` solves by EXACT
  ---     division: a non-divisible target has no Nat solution and is a
  ---     *decided* failure, not stuck; `X * 0 = t` collapses to the
  ---     `0 = t` numeral comparison; `X * X = t` (structurally equal
  ---     operands — `?k * ?k`) solves by integer square root, and
  ---     `X ** k = t` for a literal `k ≥ 1` solves by `iroot_` — no
  ---     integer root is again decided, not stuck;
  ---   * operands that are themselves closed `Bin`/`Un` terms compute
  ---     via `closed_num_` first, so `X * (2 + 1) = t` and zonked-meta
  ---     products behave like literal coefficients.
  ---
  --- Everything else is *stuck* — `{ok: false, decided: false}` — a
  --- structural shadow does not pretend to a full arithmetic solver.
  --- `decided: true` marks proven unsatisfiability (distinct numerals,
  --- non-divisible products, absent roots, occurs violations), which
  --- `refine_scrutinee_` reads to mark a match arm impossible — or to
  --- accept an `absurd` one.
  solve_index_ :: [self, term, target, metas]~> do {
    t :: zonk(zonk, term, metas)
    if type_of(t) == "num" {
      { ok: t == target, metas: metas, decided: t != target }
    } else {
      if is_meta(t) {
        do {
          tid :: meta_id(t)
          if occurs_in(occurs_in, tid, target) {
            { ok: false, metas: metas, decided: true }
          } else {
            { ok: true, metas: metas_solve(metas, tid, target), decided: false }
          }
        }
      } else {
        closed :: closed_num_(closed_num_, t)
        if closed != null {
          { ok: closed == target, metas: metas, decided: closed != target }
        } else {
          if type_tag(t) == "Bin" {
            do {
              bop :: get_or(t, "op", "")
              l :: zonk(zonk, get_or(t, "l", null), metas)
              r :: zonk(zonk, get_or(t, "r", null), metas)
              l_known :: closed_num_(closed_num_, l)
              r_known :: closed_num_(closed_num_, r)
              if bop == "binary.add" {
                if r_known != null { self(self, l, target - r_known, metas) } else { if l_known != null { self(self, r, target - l_known, metas) } else { { ok: false, metas: metas, decided: false } } }
              } else {
                if bop == "binary.sub" {
                  if r_known != null { self(self, l, target + r_known, metas) } else { if l_known != null { self(self, r, l_known - target, metas) } else { { ok: false, metas: metas, decided: false } } }
                } else {
                  if bop == "binary.mul" {
                    if r_known != null {
                      if r_known == 0 {
                        { ok: target == 0, metas: metas, decided: target != 0 }
                      } else {
                        if target % r_known == 0 { self(self, l, target / r_known, metas) } else { { ok: false, metas: metas, decided: true } }
                      }
                    } else {
                      if l_known != null {
                        if l_known == 0 {
                          { ok: target == 0, metas: metas, decided: target != 0 }
                        } else {
                          if target % l_known == 0 { self(self, r, target / l_known, metas) } else { { ok: false, metas: metas, decided: true } }
                        }
                      } else {
                        if l == r {
                          do {
                            sq :: iroot_(target, 2)
                            if sq == null { { ok: false, metas: metas, decided: true } } else { self(self, l, sq, metas) }
                          }
                        } else {
                          { ok: false, metas: metas, decided: false }
                        }
                      }
                    }
                  } else {
                    if bop == "binary.pow" && r_known != null {
                      if r_known == 0 {
                        { ok: target == 1, metas: metas, decided: target != 1 }
                      } else {
                        do {
                          root :: iroot_(target, r_known)
                          if root == null { { ok: false, metas: metas, decided: true } } else { self(self, l, root, metas) }
                        }
                      }
                    } else {
                      { ok: false, metas: metas, decided: false }
                    }
                  }
                }
              }
            }
          } else {
            { ok: false, metas: metas, decided: false }
          }
        }
      }
    }
  }

  unify_ :: [self, funcs, a, b, metas]~> do {
    a_norm :: normalize_type_(normalize_type_, funcs, null, a)
    b_norm :: normalize_type_(normalize_type_, funcs, null, b)
    if a_norm == b_norm {
      { ok: true, metas: metas, path: funcs.make_type("Path", set(set({}, "frm", a_norm), "to", b_norm)) }
    } else {
      --- `type.unknown` is the open type: names bound by imports are
      --- opaque across module boundaries, and error-recovery positions
      --- carry it so a single failure does not cascade. It unifies with
      --- everything — the same "open operand" treatment `flow` and
      --- `axis_flow` composition already give it.
      if type_tag(a_norm) == "type.unknown" || type_tag(b_norm) == "type.unknown" {
        { ok: true, metas: metas, path: funcs.make_type("Path", set(set({}, "frm", a_norm), "to", b_norm)) }
      } else {
      if is_meta(a_norm) {
        do {
          a_id :: meta_id(a_norm)
          if occurs_in(occurs_in, a_id, b_norm) {
            { ok: false, metas: metas, path: null }
          } else {
            { ok: true, metas: metas_solve(metas, a_id, b_norm), path: funcs.make_type("Path", set(set({}, "frm", a_norm), "to", b_norm)) }
          }
        }
      } else {
        if is_meta(b_norm) {
          do {
            b_id :: meta_id(b_norm)
            if occurs_in(occurs_in, b_id, a_norm) {
              { ok: false, metas: metas, path: null }
            } else {
              { ok: true, metas: metas_solve(metas, b_id, a_norm), path: funcs.make_type("Path", set(set({}, "frm", a_norm), "to", b_norm)) }
            }
          }
        } else {
          do {
            tag_a :: type_tag(a_norm)
            tag_b :: type_tag(b_norm)
            if tag_a != "" && tag_a == tag_b {
              if tag_a == "List" || tag_a == "list" {
                do {
                  len_a :: get_or(a_norm, "length", null)
                  len_b :: get_or(b_norm, "length", null)
                  len_a_num :: type_of(len_a) == "num"
                  len_b_num :: type_of(len_b) == "num"
                  len_a_meta :: is_meta(len_a)
                  len_b_meta :: is_meta(len_b)
                  len_a_concrete :: len_a_num || len_a_meta
                  len_b_concrete :: len_b_num || len_b_meta
                  if(len_a_num && !len_b_concrete) || (!len_a_concrete && len_b_num) || (len_a_num && len_b_num && len_a != len_b) {
                    { ok: false, metas: metas, path: null, decided: len_a_num && len_b_num && len_a != len_b }
                  } else {
                    unify_fields(self, funcs, a_norm, b_norm, metas, ["element"])
                  }
                }
              } else {
                do {
                  ks :: if is_obj(a_norm) && is_obj(b_norm) { keys(a_norm) } else { [] }
                  unify_fields(self, funcs, a_norm, b_norm, metas, ks)
                }
              }
            } else {
              --- Different tags (or untagged values): arrays unify
              --- element-wise, and an opaque `Bin` index term solves
              --- against a numeric literal via `solve_index_` — the
              --- definitional-equality fragment documented on
              --- `eval_bin_`, now covering the bounded nonlinear cases
              --- (exact division, integer roots).
              if type_of(a_norm) == "arr" && type_of(b_norm) == "arr" {
                unify_list_(self, funcs, a_norm, b_norm, metas)
              } else {
                if tag_a == "Bin" && type_of(b_norm) == "num" {
                  do {
                    r :: solve_index_(solve_index_, a_norm, b_norm, metas)
                    { ok: r.ok, metas: r.metas, decided: r.decided, path: if r.ok { funcs.make_type("Path", set(set({}, "frm", a_norm), "to", b_norm)) } else { null } }
                  }
                } else {
                  if tag_b == "Bin" && type_of(a_norm) == "num" {
                    do {
                      r :: solve_index_(solve_index_, b_norm, a_norm, metas)
                      { ok: r.ok, metas: r.metas, decided: r.decided, path: if r.ok { funcs.make_type("Path", set(set({}, "frm", a_norm), "to", b_norm)) } else { null } }
                    }
                  } else {
                    --- Distinct numerals are a *decided* failure (no
                    --- solution exists); anything else is stuck.
                    { ok: false, metas: metas, path: null, decided: type_of(a_norm) == "num" && type_of(b_norm) == "num" }
                  }
                }
              }
            }
          }
        }
      }
      }
    }
  }

  unify :: [funcs, a, b, metas]~> unify_(unify_, funcs, a, b, metas)

  ast_node :: [ast, idx]~> do {
    i :: if type_of(idx) == "arr" { at(idx, 0) } else { idx }
    at(ast, i)
  }

  node_kind :: node ~> get_or(node, "kind", "")

  node_children :: node ~> do {
    payload :: get_or(node, "payload", {})
    if type_of(payload) == "obj" { get_or(payload, "children", []) } else { [] }
  }

  node_payload :: node ~> get_or(node, "payload", {})

  child_ref :: [ast, node_idx, idx]~> do {
    node :: ast_node(ast, node_idx)
    children :: node_children(node)
    at(children, idx)
  }

  try_child_ref :: [ast, node_idx, idx]~> do {
    node :: ast_node(ast, node_idx)
    children :: node_children(node)
    if type_of(idx) == "num" {
      if idx < len(children) { at(children, idx) } else { null }
    } else {
      null
    }
  }

  index_type_rules :: [types_arr]~> while { idx: 0, result: {} } {
    [st]~> if st.idx >= len(types_arr) {
      { out: st.result }
    } else {
      do {
        rule :: at(types_arr, st.idx)
        kind :: get_or(rule, "node_kind", "")
        new_result :: if kind != "" { set(st.result, kind, rule) } else { st.result }
        { state: { idx: st.idx + 1, result: new_result } }
      }
    }
  }

  lang_type_rule :: [s, kind]~> get_or(get_or(s, "type_index", {}), kind, null)

  lang_ast_shape :: [s, kind]~> get_or(get_or(s, "ast_index", {}), kind, null)

  child_role_index_ :: [self, children, role, idx]~> if idx >= len(children) {
    null
  } else {
    do {
      spec :: at(children, idx)
      if get_or(spec, "role", "") == role {
        idx
      } else {
        self(self, children, role, idx + 1)
      }
    }
  }

  child_role_index :: [s, kind, role]~> do {
    shape :: lang_ast_shape(s, kind)
    if shape == null {
      null
    } else {
      do {
        children :: get_or(shape, "children", [])
        child_role_index_(child_role_index_, children, role, 0)
      }
    }
  }

  tc_new :: [ast, type_index, ast_index, prelude, globals]~> ({
    ast: ast,
    type_index: type_index,
    ast_index: ast_index,
    gamma: [],
    metas: [null],
    results: {},
    node_types: [],
    diagnostics: [],
    fuel: 50000,
    exhausted: false,
    prelude: if prelude == null { [] } else { prelude },
    globals: if globals == null { {} } else { globals }
  })

  prelude_contains :: [prelude, name]~> while { found: false, idx: 0 } {
    [st]~> if st["found"] || st["idx"] >= len(prelude) {
      { out: st["found"] }
    } else {
      do {
        new_found :: if at(prelude, st["idx"]) == name { true } else { st["found"] }
        { state: { found: new_found, idx: st["idx"] + 1 } }
      }
    }
  }

  tc_burn_fuel :: s ~> if s.fuel > 0 {
    set(s, "fuel", s.fuel - 1)
  } else {
    set(s, "exhausted", true)
  }

  tc_fuel_exhausted :: s ~> get_or(s, "exhausted", false)

  tc_extend :: [s, name, typ]~> do {
    new_gamma :: gamma_extend(s.gamma, name, typ)
    set(s, "gamma", new_gamma)
  }

  tc_lookup :: [s, name]~> gamma_lookup(s.gamma, name)

  tc_fresh_meta :: s ~> do {
    id :: len(s.metas)
    new_metas :: concat(s.metas, [null])
    { id: id, state: set(s, "metas", new_metas) }
  }

  tc_solve_meta :: [s, id, val]~> do {
    new_metas :: metas_solve(s.metas, id, val)
    set(s, "metas", new_metas)
  }

  tc_bind_result :: [s, name, val]~> do {
    new_results :: set(s.results, name, val)
    set(s, "results", new_results)
  }

  tc_lookup_result :: [s, name]~> get_or(s.results, name, null)

  tc_mark :: s ~> gamma_mark(s.gamma)

  tc_restore :: [s, mark]~> do {
    new_gamma :: gamma_restore(s.gamma, mark)
    set(s, "gamma", new_gamma)
  }

  tc_record_node_type :: [s, node_idx, typ]~> do {
    raw_i :: if type_of(node_idx) == "arr" { at(node_idx, 0) } else { node_idx }
    i :: typeof.to_number(raw_i)
    while { result: s.node_types, idx: 0 } {
      [st]~> if st.idx >= i {
        { out: set(s, "node_types", concat(concat(slice(st.result, 0, i), [typ]), drop(st.result, i + 1))) }
      } else {
      do {
        new_result :: if st.idx < len(st.result) {
          st.result
        } else {
          concat(st.result, [null])
        }
        new_idx :: typeof.to_number(st.idx) + 1
        { state: { result: new_result, idx: new_idx } }
      }
    }
  }
}

  tc_add_diagnostic :: [s, severity, message]~> do {
    diag :: set(set({}, "severity", severity), "message", message)
    new_diags :: [...get_or(s, "diagnostics", []), diag]
    set(s, "diagnostics", new_diags)
  }

  --- Non-recursive helpers (defined before the mutually-recursive group) ---

  defer_to_type_model :: [s, term, incoming]~> ({ val: incoming, state: s })

  apply_type_closure :: [funcs, type_val, arg_type, s]~> do {
    closure :: get_or(type_val, "body_closure", {})
    var_name :: get_or(closure, "var_name", "x")
    body_child_idx :: get_or(closure, "body_child_idx", 0)
    mark :: tc_mark(s)
    extended :: tc_extend(s, var_name, arg_type)
    body_result :: funcs.synth_node_(funcs, extended, body_child_idx)
    restored :: tc_restore(body_result["state"], mark)
    { val: body_result.typ, state: restored }
  }

  eval_arg_type :: [funcs, s, node_idx, args, incoming]~> do {
    has_arg :: len(args) > 1
    arg_result :: if has_arg { funcs.eval_scheme_(funcs, s, node_idx, at(args, 1), incoming) } else { null }
    arg_val :: if has_arg { arg_result.val } else { incoming }
    { val: arg_val, state: if has_arg { arg_result["state"] } else { s } }
  }

  eval_first_arg :: [funcs, s, node_idx, args, incoming]~> do {
    has_arg :: !is_empty(args)
    arg_result :: if has_arg { funcs.eval_scheme_(funcs, s, node_idx, first_value(args), incoming) } else { null }
    arg_val :: if has_arg { arg_result.val } else { incoming }
    { val: arg_val, state: if has_arg { arg_result["state"] } else { s } }
  }

  eval_arg_at :: [funcs, s, node_idx, args, incoming, arg_idx]~> do {
    has_arg :: len(args) > arg_idx
    arg_result :: if has_arg { funcs.eval_scheme_(funcs, s, node_idx, at(args, arg_idx), incoming) } else { null }
    arg_val :: if has_arg { arg_result.val } else { incoming }
    { val: arg_val, state: if has_arg { arg_result["state"] } else { s } }
  }

  --- Helpers for dependent array.take type.
  math_min_proj :: unit ~> make_type("RecordProj", set(set({}, "record", make_type("Const", set({}, "value", "math"))), "field", "min"))

  array_len_proj :: unit ~> make_type("RecordProj", set(set({}, "record", make_type("Const", set({}, "value", "array"))), "field", "len"))

  build_take_type :: [t_meta, n_meta, xs_name, n_name]~> do {
    param1 :: make_type("List", set(set({}, "element", t_meta), "length", null))
    param2 :: n_meta
    len_term :: make_type("App", set(set({}, "callee", math_min_proj()), "args", [make_type("var", set({}, "name", n_name)), make_type("App", set(set({}, "callee", array_len_proj()), "args", [make_type("var", set({}, "name", xs_name))]))]))
    output :: make_type("List", set(set({}, "element", t_meta), "length", len_term))
    inner :: make_type("type.function", set(set(set({}, "param", param2), "body", output), "param_name", n_name))
    make_type("type.function", set(set(set({}, "param", param1), "body", inner), "param_name", xs_name))
  }

  array_take_type :: [s]~> do {
    t :: tc_fresh_meta(s)
    n :: tc_fresh_meta(t["state"])
    typ :: build_take_type(meta_value(t.id), meta_value(n.id), "xs", "n")
    { typ: typ, state: n["state"] }
  }

  --- Substitute a parameter name with an argument term inside a type-level term.
  subst_term_ :: [self, term, name, replacement]~> if type_of(term) == "obj" {
    do {
      tag :: type_tag(term)
      if tag == "var" {
        if get_or(term, "name", "") == name { replacement } else { term }
      } else {
        if tag == "App" {
          do {
            new_callee :: self(self, get_or(term, "callee", term), name, replacement)
            new_args :: while { result: [], remaining: get_or(term, "args", []), state: null } {
              [st]~> if is_empty(st.remaining) {
                { out: st.result }
              } else {
                do {
                  a :: first_value(st.remaining)
                  new_a :: self(self, a, name, replacement)
                  { state: { result: [...st.result, new_a], remaining: drop(st.remaining, 1), state: null } }
                }
              }
            }
            make_type("App", set(set({}, "callee", new_callee), "args", new_args))
          }
        } else {
          if tag == "List" || tag == "list" {
            do {
              new_element :: self(self, get_or(term, "element", term), name, replacement)
              new_length :: self(self, get_or(term, "length", null), name, replacement)
              make_type("List", set(set({}, "element", new_element), "length", new_length))
            }
          } else {
            if tag == "type.function" {
              do {
                new_param :: self(self, get_or(term, "param", null), name, replacement)
                new_body :: self(self, get_or(term, "body", null), name, replacement)
                make_type("type.function", set(set(set({}, "param", new_param), "body", new_body), "param_name", get_or(term, "param_name", "")))
              }
            } else {
              --- Generic field walk for every other tagged record
              --- (`type.family_app`, `Bin`, `Un`, `Comp`, `If`, ...):
              --- substituting inside index terms lets a constructor
              --- result like `Foo(x)` pick up the applied argument.
              --- `var`/`App`/`List`/`type.function` are handled by the
              --- earlier cases; non-JSON fields pass through untouched.
              while { result: term, remaining: keys(term) } {
                [st]~> if is_empty(st.remaining) {
                  { out: st.result }
                } else {
                  do {
                    k :: first_value(st.remaining)
                    new_v :: self(self, get_or(term, k, null), name, replacement)
                    { state: { result: set(st.result, k, new_v), remaining: drop(st.remaining, 1) } }
                  }
                }
              }
            }
          }
        }
      }
    }
  } else {
    if type_of(term) == "arr" {
      while { result: [], remaining: term } {
        [st]~> if is_empty(st.remaining) {
          { out: st.result }
        } else {
          do {
            a :: first_value(st.remaining)
            new_a :: self(self, a, name, replacement)
            { state: { result: [...st.result, new_a], remaining: drop(st.remaining, 1) } }
          }
        }
      }
    } else {
      term
    }
  }

  --- Build a concrete term from an argument AST node for dependent substitution.
  arg_term_from_node :: [s, node_idx]~> do {
    node :: ast_node(s.ast, node_idx)
    kind :: node_kind(node)
    payload :: node_payload(node)
    if kind == "value" {
      if type_of(payload) == "obj" { get_or(payload, "value", null) } else { payload }
    } else {
      if kind == "var" {
        do {
          name :: if type_of(payload) == "str" { payload } else { get_or(payload, "name", "") }
          make_type("var", set({}, "name", name))
        }
      } else {
        if kind == "array" {
          do {
            children :: node_children(node)
            vals :: while { result: [], remaining: children } {
              [st]~> if is_empty(st.remaining) {
                { out: st.result }
              } else {
                do {
                  child_idx :: first_value(st.remaining)
                  child_node :: ast_node(s.ast, child_idx)
                  v :: if node_kind(child_node) == "value" { do { p :: node_payload(child_node) if type_of(p) == "obj" { get_or(p, "value", null) } else { p } } } else { null }
                  { state: { result: if v == null { st.result } else { [...st.result, v] }, remaining: drop(st.remaining, 1) } }
                }
              }
            }
            vals
          }
        } else {
          null
        }
      }
    }
  }

  merge_obj :: [obj, base]~> while { result: base, remaining: keys(obj) } {
    [st]~> if is_empty(st.remaining) {
      { out: st.result }
    } else {
      do {
        k :: first_value(st.remaining)
        v :: get_or(obj, k, null)
        { state: { result: set(st.result, k, v), remaining: drop(st.remaining, 1) } }
      }
    }
  }

  tc_sanitize :: s ~> if is_obj(s) {
    do {
      raw_ast :: get_or(s, "ast", [])
      raw_type_index :: get_or(s, "type_index", {})
      raw_ast_index :: get_or(s, "ast_index", {})
      raw_gamma :: get_or(s, "gamma", [])
      raw_metas :: get_or(s, "metas", [null])
      raw_results :: get_or(s, "results", {})
      raw_node_types :: get_or(s, "node_types", [])
      raw_diagnostics :: get_or(s, "diagnostics", [])
      raw_fuel :: get_or(s, "fuel", 50000)
      raw_exhausted :: get_or(s, "exhausted", false)
      raw_prelude :: get_or(s, "prelude", [])
      raw_globals :: get_or(s, "globals", {})
      ast :: if type_of(raw_ast) == "arr" { raw_ast } else { [] }
      type_index :: if is_obj(raw_type_index) { raw_type_index } else { {} }
      ast_index :: if is_obj(raw_ast_index) { raw_ast_index } else { {} }
      gamma :: if type_of(raw_gamma) == "arr" { raw_gamma } else { [] }
      metas :: if type_of(raw_metas) == "arr" { raw_metas } else { [null] }
      results :: if is_obj(raw_results) { raw_results } else { {} }
      node_types :: if type_of(raw_node_types) == "arr" { raw_node_types } else { [] }
      diagnostics :: if type_of(raw_diagnostics) == "arr" { raw_diagnostics } else { [] }
      fuel :: if type_of(raw_fuel) == "num" { raw_fuel } else { 50000 }
      exhausted :: if type_of(raw_exhausted) == "bool" { raw_exhausted } else { false }
      prelude :: if type_of(raw_prelude) == "arr" { raw_prelude } else { [] }
      globals :: if is_obj(raw_globals) { raw_globals } else { {} }
      set(set(set(set(set(set(set(set(set(set(set(set({}, "ast", ast), "type_index", type_index), "ast_index", ast_index), "gamma", gamma), "metas", metas), "results", results), "node_types", node_types), "diagnostics", diagnostics), "fuel", fuel), "exhausted", exhausted), "prelude", prelude), "globals", globals)
    }
  } else {
    do {
      fallback :: { ast: [], type_index: {}, ast_index: {}, gamma: [], metas: [null], results: {}, node_types: [], diagnostics: [], fuel: 50000, exhausted: false, prelude: [], globals: {} }
      if s == null {
        fallback
      } else {
        tc_add_diagnostic(fallback, "warning", "typecheck state was not a plain record: " + type_of(s))
      }
    }
  }

  --- Mutually recursive functions (funcs record breaks the cycle) ---

  import_bound_names_ :: [s, node_idx]~> do {
    node :: ast_node(s.ast, node_idx)
    payload :: node_payload(node)
    children :: node_children(node)
    child_names :: if is_empty(children) {
      []
    } else {
      do {
        child_node :: ast_node(s.ast, first_value(children))
        if node_kind(child_node) == "var" {
          do {
            cp :: node_payload(child_node)
            n :: if type_of(cp) == "str" { cp } else { if type_of(cp) == "obj" { get_or(cp, "name", "") } else { "" } }
            if n == "" { [] } else { [n] }
          }
        } else {
          []
        }
      }
    }
    alias :: get_or(payload, "alias", "")
    names_val :: get_or(payload, "names", null)
    path :: get_or(payload, "path", "")
    from_names :: if type_of(names_val) == "arr" {
      while { result: [], remaining: names_val } {
        [st]~> if is_empty(st.remaining) {
          { out: st.result }
        } else {
          do {
            item :: first_value(st.remaining)
            n :: if type_of(item) == "str" {
              item
            } else {
              if type_of(item) == "obj" {
                do {
                  a :: get_or(item, "as", "")
                  if a != "" { a } else { get_or(item, "name", "") }
                }
              } else {
                ""
              }
            }
            { state: { result: if n == "" { st.result } else { [...st.result, n] }, remaining: drop(st.remaining, 1) } }
          }
        }
      }
    } else {
      if type_of(names_val) == "str" {
        if names_val == "*" {
          if type_of(path) == "str" && path != "" { [path] } else { [] }
        } else {
          [names_val]
        }
      } else {
        []
      }
    }
    imported :: if alias != "" { [alias] } else { from_names }
    concat(child_names, imported)
  }

  bind_imports_ :: [funcs, s, node_idx]~> while { state: s, remaining: import_bound_names_(s, node_idx) } {
    [st]~> if is_empty(st.remaining) {
      { out: st["state"] }
    } else {
      do {
        n :: first_value(st.remaining)
        extended :: tc_extend(st["state"], n, funcs.make_type("type.unknown", {}))
        bound :: tc_bind_result(extended, n, funcs.make_type("var", set({}, "name", n)))
        { state: { state: bound, remaining: drop(st.remaining, 1) } }
      }
    }
  }

  collect_var_names_ :: [funcs, s, node_idx]~> do {
    node :: ast_node(s.ast, node_idx)
    kind :: node_kind(node)
    payload :: node_payload(node)
    children :: node_children(node)
    own :: if kind == "var" {
      n :: if type_of(payload) == "str" { payload } else { if type_of(payload) == "obj" { get_or(payload, "name", "") } else { "" } }
      if n == "" { [] } else { [n] }
    } else {
      []
    }
    child_names :: while { result: [], remaining: children } {
      [st]~> if is_empty(st.remaining) {
        { out: st.result }
      } else {
        { state: { result: concat(st.result, funcs.collect_var_names_(funcs, s, first_value(st.remaining))), remaining: drop(st.remaining, 1) } }
      }
    }
    body_name :: if type_of(payload) == "obj" { get_or(payload, "body", null) } else { null }
    body_names :: if type_of(body_name) == "num" { funcs.collect_var_names_(funcs, s, body_name) } else { [] }
    concat(own, concat(child_names, body_names))
  }

  bind_pattern_vars_ :: [funcs, s, node_idx]~> while { state: s, remaining: funcs.collect_var_names_(funcs, s, node_idx) } {
    [st]~> if is_empty(st.remaining) {
      { out: st["state"] }
    } else {
      do {
        n :: first_value(st.remaining)
        already :: tc_lookup(st["state"], n)
        in_prelude :: prelude_contains(get_or(st["state"], "prelude", []), n)
        st2 :: if already != null || in_prelude {
          st["state"]
        } else {
          do {
            meta :: tc_fresh_meta(st["state"])
            tc_extend(meta["state"], n, meta_value(meta.id))
          }
        }
        { state: { state: st2, remaining: drop(st.remaining, 1) } }
      }
    }
  }

  synth_node_impl_ :: [funcs, s, node_idx]~> do {
    s :: tc_sanitize(s)
    node :: ast_node(s.ast, node_idx)
    kind :: node_kind(node)
    target_role :: child_role_index(s, kind, "target")
    field_role :: child_role_index(s, kind, "field")
    callee_role :: child_role_index(s, kind, "callee")
    args_role :: child_role_index(s, kind, "args")
    statements_role :: child_role_index(s, kind, "statements")
    condition_role :: child_role_index(s, kind, "condition")
    then_role :: child_role_index(s, kind, "then")
    value_role :: child_role_index(s, kind, "value")
    is_field_access :: target_role != null && field_role != null
    is_call :: callee_role != null && args_role != null
    is_block :: statements_role != null
    is_assign :: target_role != null && value_role != null
    is_if :: condition_role != null && then_role != null
    is_return :: value_role != null && target_role == null
    payload :: node_payload(node)
    body_role :: child_role_index(s, kind, "body")
    is_module :: kind == "module"
    is_paren :: kind == "paren"
    is_var :: kind == "var"
    is_value :: kind == "value"
    is_export :: kind == "stmt.export"
    is_canonical :: is_field_access || is_call || is_block || is_assign || is_if || is_return || is_module || is_paren || is_var || is_value || is_export
    op_name :: if is_field_access { "field_access" } else { if is_call { "call" } else { if is_block { "synth_block" } else { if is_module { "synth_last_child" } else { if is_paren { "synth_child" } else { if is_var { "lookup" } else { if is_value { "value" } else { if is_export { "export" } else { kind } } } } } } } }
    op_lit :: if is_paren { body_role } else { if is_var { payload } else { null } }
    op_incoming :: if is_value { payload } else { null }
    if is_canonical {
      do {
        result :: funcs.eval_judgment_(funcs, s, node_idx, op_name, [], op_lit, op_incoming)
        new_state :: tc_record_node_type(result["state"], node_idx, result.val)
        if result.val == null {
          { typ: funcs.make_type("type.unknown", {}), state: tc_add_diagnostic(new_state, "error", "synth canonical returned null for kind: " + kind) }
        } else {
          { typ: result.val, state: new_state }
        }
      }
    } else {
      do {
        s :: if kind == "dim_arrow" { funcs.bind_pattern_vars_(funcs, s, node_idx) } else { s }
        rule :: lang_type_rule(s, kind)
        if rule == null {
          if is_empty(s.ast) {
            { typ: funcs.make_type("type.unknown", {}), state: s }
          } else {
            { typ: funcs.make_type("type.unknown", {}), state: tc_add_diagnostic(s, "warning", "no type rule for kind: " + kind) }
          }
        } else {
          do {
            synth_scheme :: get_or(rule, "synth", null)
            if synth_scheme == null {
              { typ: funcs.make_type("type.unknown", {}), state: tc_add_diagnostic(s, "error", "no synth scheme for kind: " + kind) }
            } else {
              do {
                result :: funcs.eval_scheme_(funcs, s, node_idx, synth_scheme, null)
                new_state :: tc_record_node_type(result["state"], node_idx, result.val)
                bound_state :: if kind == "stmt.import" {
                  bind_imports_(funcs, new_state, node_idx)
                } else {
                  new_state
                }
                if result.val == null {
                  { typ: funcs.make_type("type.unknown", {}), state: tc_add_diagnostic(bound_state, "error", "synth rule returned null for kind: " + kind) }
                } else {
                  { typ: result.val, state: bound_state }
                }
              }
            }
          }
        }
      }
    }
  }

  check_node_impl_ :: [funcs, s, node_idx, expected]~> do {
    is_value_ann :: expected != null && type_tag(expected) == "" && !is_meta(expected)
    if is_value_ann {
      do {
        eval_result :: funcs.eval_node_(funcs, s, node_idx)
        if eval_result.val == expected {
          { ok: true, state: eval_result["state"] }
        } else {
          { ok: false, state: tc_add_diagnostic(eval_result["state"], "error", "check: value does not equal the annotation") }
        }
      }
    } else {
    is_arrow_ann :: expected != null && funcs.is_applicable_(funcs, expected)
    if is_arrow_ann {
      --- Fiber membership (ADR-0120 Phase 4): `v : P` where `P`
      --- evaluated to an arrow value — e.g. the `Bool`-valued
      --- characteristic function `Vec(3, a)` of an indexed data
      --- family — checks `P(v)`, not `v == P`. A literal `false`
      --- rejects; `true` accepts; an undecidable (opaque/null) result
      --- accepts with a warning because `desugar.data` predicates are
      --- `loop` fold machines outside the model's evaluable fragment
      --- (hand-written predicates reduce fully).
      do {
        eval_result :: funcs.eval_node_(funcs, s, node_idx)
        applied :: funcs.apply_val_(funcs, eval_result["state"], expected, [eval_result.val])
        if applied.val == false {
          { ok: false, state: tc_add_diagnostic(applied["state"], "error", "check: value is not a member of the indexed family") }
        } else {
          undecidable :: applied.val == null || type_tag(applied.val) != ""
          if undecidable {
            { ok: true, state: tc_add_diagnostic(applied["state"], "warning", "check: family membership is symbolic — the predicate did not decide") }
          } else {
            { ok: true, state: applied["state"] }
          }
        }
      }
    } else {
    dep_tag :: if expected == null { "" } else { type_tag(expected) }
    is_dep_intro :: dep_tag == "type.pi" || dep_tag == "type.sigma" || dep_tag == "type.family" || dep_tag == "type.forall" || dep_tag == "Path"
    if is_dep_intro {
      funcs.check_dependent_(funcs, s, node_idx, expected)
    } else {
    do {
    node :: ast_node(s.ast, node_idx)
    kind :: node_kind(node)
    rule :: lang_type_rule(s, kind)
    if rule == null {
      { ok: false, state: tc_add_diagnostic(s, "error", "no type rule for kind: " + kind) }
    } else {
      do {
        check_scheme :: get_or(rule, "check", null)
        if check_scheme != null {
          do {
            result :: funcs.eval_scheme_(funcs, s, node_idx, check_scheme, expected)
            new_state :: tc_record_node_type(result["state"], node_idx, expected)
            { ok: true, state: new_state }
          }
        } else {
          do {
            synth_result :: funcs.synth_node_(funcs, s, node_idx)
            dep_u :: funcs.unify_dependent_(funcs, synth_result.typ, expected, synth_result["state"])
            if dep_u.ok {
              do {
                recorded :: tc_record_node_type(dep_u["state"], node_idx, synth_result.typ)
                { ok: true, state: recorded }
              }
            } else {
              { ok: false, state: tc_add_diagnostic(dep_u["state"], "error", "type mismatch") }
            }
          }
        }
      }
    }
    }
    }
    }
    }
  }

  --- ------------------------------------------------------------------
  --- ADR-0120 Phase 4: dependent structure
  --- ------------------------------------------------------------------
  ---
  --- `Family(A)`, `Pi(A, f)`, `Sigma(A, f)`, `Forall(K, f)` are the
  --- surface call-forms of the dependent type formers:
  ---   Π (x:A). B(x)   ≡   Pi(A, x ~> B(x))
  ---   Σ (x:A). P(x)   ≡   Sigma(A, x ~> P(x))
  ---   ∀ (x:K). B(x)   ≡   Forall(K, x ~> B(x))
  ---   A ↝ Type        ≡   Family(A)   (multi-index: Family(A, B, …))
  --- They mint `type.pi`/`type.sigma`/`type.forall`/`type.family` type
  --- values whose `body_closure` keeps the binder name and the body
  --- child's arena index — the body is only synthesized when the
  --- closure is applied (same lazy discipline as `construct_pi`'s
  --- canonical `pi` nodes).
  ---
  --- Checking is structural, not full dependent elaboration:
  ---   * `function` vs `type.pi`    — Π-intro: bind each parameter to
  ---     the Pi's `param`, apply the body closure with the bound
  ---     variable as its own term, check the body against the residual;
  ---   * `[a, p]` vs `type.sigma`   — Σ-intro: check `a` against
  ---     `param`, bind `a`'s term so `P(a)` uses the actual first
  ---     component (value-level dependency), then check `p`;
  ---   * arrow vs `type.family`     — Family-intro: an inhabitant of
  ---     `Family(A₁,…,Aₙ)` is an arrow `A₁ ~> … ~> Aₙ ~> *`; the
  ---     codomain (`Type`, or the `Bool`-valued predicate encoding that
  ---     `desugar.data` generates) is intentionally unconstrained —
  ---     Prop ≈ Bool ≈ Type₀.

  --- Parameter names + body child index of a `function` node (shared by
  --- Π-intro; mirrors `synth_function`'s extraction).
  function_params_ :: [funcs, s, node_idx]~> do {
    node :: ast_node(s.ast, node_idx)
    children :: node_children(node)
    payload :: node_payload(node)
    payload_params :: get_or(payload, "params", null)
    payload_body :: get_or(payload, "body", null)
    use_payload :: len(children) < 2 && type_of(payload_params) == "arr" && type_of(payload_body) == "num"
    if use_payload {
      { names: payload_params, body_idx: payload_body }
    } else {
      do {
        params_node :: ast_node(s.ast, at(children, 0))
        params_kind :: node_kind(params_node)
        param_children :: if params_kind == "paren" { node_children(params_node) } else { [at(children, 0)] }
        names :: while { result: [], remaining: param_children } {
          [st]~> if is_empty(st.remaining) {
            { out: st.result }
          } else {
            do {
              p_idx :: first_value(st.remaining)
              p_node :: ast_node(s.ast, p_idx)
              p_kind :: node_kind(p_node)
              p_payload :: node_payload(p_node)
              p_name :: if p_kind == "var" {
                if type_of(p_payload) == "str" { p_payload } else { get_or(p_payload, "name", "") }
              } else {
                if p_kind == "type-annot" {
                  do {
                    subj_role :: child_role_index(s, p_kind, "subject")
                    if subj_role == null {
                      ""
                    } else {
                      do {
                        subj_node :: ast_node(s.ast, child_ref(s.ast, p_idx, subj_role))
                        subj_payload :: node_payload(subj_node)
                        if type_of(subj_payload) == "str" { subj_payload } else { get_or(subj_payload, "name", "") }
                      }
                    }
                  }
                } else {
                  ""
                }
              }
              { state: { result: [...st.result, p_name], remaining: drop(st.remaining, 1) } }
            }
          }
        }
        { names: names, body_idx: at(children, 1) }
      }
    }
  }

  --- Extract a `{var_name, body_child_idx}` closure from a `Pi`/`Sigma`/
  --- `Forall` body argument. A `function` (or paren-wrapped `function`)
  --- contributes its first parameter name and body child; anything else
  --- is a non-dependent body (`var_name == ""` applies without binding).
  dep_closure_from_ :: [funcs, s, arg_idx]~> do {
    n :: ast_node(s.ast, arg_idx)
    kind :: node_kind(n)
    if kind == "paren" {
      do {
        inner_children :: node_children(n)
        if is_empty(inner_children) {
          set(set({}, "var_name", ""), "body_child_idx", arg_idx)
        } else {
          funcs.dep_closure_from_(funcs, s, first_value(inner_children))
        }
      }
    } else {
      if kind == "function" {
        do {
          pinfo :: funcs.function_params_(funcs, s, arg_idx)
          vname :: if is_empty(pinfo.names) { "" } else { first_value(pinfo.names) }
          set(set({}, "var_name", vname), "body_child_idx", pinfo.body_idx)
        }
      } else {
        set(set({}, "var_name", ""), "body_child_idx", arg_idx)
      }
    }
  }

  --- Surface former application `Former(args...)` in annotation position.
  synth_dep_former_ :: [funcs, st, node_idx, former_name]~> do {
    node :: ast_node(st.ast, node_idx)
    children :: node_children(node)
    args_role :: child_role_index(st, "call", "args")
    if args_role == null || args_role >= len(children) {
      { val: funcs.make_type("type.unknown", {}), state: tc_add_diagnostic(st, "warning", "synth_type: " + former_name + " needs a domain argument") }
    } else {
      if former_name == "Family" {
        do {
          acc :: while { result: [], state: st, idx: args_role } {
            [w]~> if w.idx >= len(children) {
              { out: { vals: w.result, state: w["state"] } }
            } else {
              do {
                t :: funcs.synth_type_(funcs, w["state"], at(children, w.idx))
                { state: { result: [...w.result, t.val], state: t["state"], idx: w.idx + 1 } }
              }
            }
          }
          base :: if len(acc.vals) == 1 {
            first_value(acc.vals)
          } else {
            funcs.make_type("type.array", set({}, "elements", acc.vals))
          }
          { val: funcs.make_type("type.family", set({}, "base", base)), state: acc["state"] }
        }
      } else {
        do {
          dom_result :: funcs.synth_type_(funcs, st, at(children, args_role))
          body_idx :: if args_role + 1 < len(children) { at(children, args_role + 1) } else { null }
          closure :: if body_idx == null {
            set(set({}, "var_name", ""), "body_child_idx", null)
          } else {
            funcs.dep_closure_from_(funcs, dom_result["state"], body_idx)
          }
          tag_name :: if former_name == "Pi" {
            "type.pi"
          } else {
            if former_name == "Sigma" { "type.sigma" } else { "type.forall" }
          }
          field_name :: if former_name == "Forall" { "kind" } else { "param" }
          payload :: set(set({}, field_name, dom_result.val), "body_closure", closure)
          { val: funcs.make_type(tag_name, payload), state: dom_result["state"] }
        }
      }
    }
  }

  --- Apply a dependent `body_closure` to an argument *type* and *term*:
  --- the binder's gamma entry carries `arg_type` while its result entry
  --- carries `arg_term`, so a `Vec(n, a)` body both binds `n` at type
  --- level and substitutes the argument at value level (the indexed-
  --- family predicate evaluates through `synth_type_`'s bound-callee →
  --- `eval_node_` path). `synth_type_` is used for the body — the
  --- call-form body is annotation position (unlike `apply_type_closure`
  --- on canonical `pi` nodes, where child 1 is a term).
  apply_dep_closure_ :: [funcs, type_val, arg_type, arg_term, s]~> do {
    closure :: get_or(type_val, "body_closure", {})
    var_name :: get_or(closure, "var_name", "")
    body_idx :: get_or(closure, "body_child_idx", null)
    mark :: tc_mark(s)
    old_results :: get_or(s, "results", {})
    extended :: if var_name == "" { s } else { tc_extend(s, var_name, arg_type) }
    bound :: if var_name == "" || arg_term == null { extended } else { tc_bind_result(extended, var_name, arg_term) }
    body_result :: if body_idx == null {
      { val: funcs.make_type("type.unknown", {}), state: bound }
    } else {
      funcs.synth_type_(funcs, bound, body_idx)
    }
    restored :: set(tc_restore(body_result["state"], mark), "results", old_results)
    { val: body_result.val, state: restored }
  }

  --- Π-introduction: check a `function` node against `type.pi`. Each
  --- parameter binds the Pi's domain; the body closure is applied with
  --- the bound variable as its own term (`var p_name`), so the residual
  --- type mentions the parameter symbolically. A `Pi` nest is consumed
  --- one binder per function parameter; extra parameters get fresh
  --- metas (a plain function tail).
  check_pi_intro_ :: [funcs, s, node_idx, expected]~> do {
    pinfo :: funcs.function_params_(funcs, s, node_idx)
    mark :: tc_mark(s)
    old_results :: get_or(s, "results", {})
    walk :: while { cur: expected, state: s, remaining: pinfo.names } {
      [st]~> if is_empty(st.remaining) {
        { out: { cur: st.cur, state: st["state"] } }
      } else {
        do {
          p_name :: first_value(st.remaining)
          if type_tag(st.cur) == "type.pi" {
            do {
              ptype :: get_or(st.cur, "param", null)
              extended :: if p_name == "" { st["state"] } else { tc_extend(st["state"], p_name, ptype) }
              arg_term :: if p_name == "" { null } else { funcs.make_type("var", set({}, "name", p_name)) }
              applied :: funcs.apply_dep_closure_(funcs, st.cur, ptype, arg_term, extended)
              { state: { cur: applied.val, state: applied["state"], remaining: drop(st.remaining, 1) } }
            }
          } else {
            do {
              m :: tc_fresh_meta(st["state"])
              extended :: if p_name == "" { m["state"] } else { tc_extend(m["state"], p_name, meta_value(m.id)) }
              { state: { cur: st.cur, state: extended, remaining: drop(st.remaining, 1) } }
            }
          }
        }
      }
    }
    if pinfo.body_idx == null {
      { ok: false, state: tc_add_diagnostic(set(tc_restore(walk["state"], mark), "results", old_results), "error", "check: function has no body to check against the Pi type") }
    } else {
      do {
        res :: funcs.check_node_(funcs, walk["state"], pinfo.body_idx, walk.cur)
        restored :: set(tc_restore(res["state"], mark), "results", old_results)
        { ok: res.ok, state: restored }
      }
    }
  }

  --- Σ-introduction: check a pair literal `[a, p]` against `type.sigma`.
  --- The first component's term binds the closure variable so `P(a)`
  --- is the fiber at the actual `a`; right-nested pairs `[a, [b, p]]`
  --- cover iterated Σ.
  check_sigma_intro_ :: [funcs, s, node_idx, expected]~> do {
    node :: ast_node(s.ast, node_idx)
    children :: node_children(node)
    e0 :: first_value(children)
    e1 :: at(children, 1)
    param_type :: get_or(expected, "param", null)
    c0 :: funcs.check_node_(funcs, s, e0, param_type)
    if !c0.ok {
      { ok: false, state: c0["state"] }
    } else {
      do {
        t0 :: funcs.synth_node_(funcs, c0["state"], e0)
        closure :: get_or(expected, "body_closure", {})
        var_name :: get_or(closure, "var_name", "")
        body_idx :: get_or(closure, "body_child_idx", null)
        mark :: tc_mark(t0["state"])
        old_results :: get_or(t0["state"], "results", {})
        extended :: if var_name == "" { t0["state"] } else { tc_extend(t0["state"], var_name, t0.typ) }
        bound :: if var_name == "" { extended } else { tc_bind_result(extended, var_name, funcs.node_term_(funcs, t0["state"], e0)) }
        body_result :: if body_idx == null {
          { val: funcs.make_type("type.unknown", {}), state: bound }
        } else {
          funcs.synth_type_(funcs, bound, body_idx)
        }
        c1 :: funcs.check_node_(funcs, body_result["state"], e1, body_result.val)
        restored :: set(tc_restore(c1["state"], mark), "results", old_results)
        { ok: c1.ok, state: restored }
      }
    }
  }

  --- Family-introduction: `type.family{base}` accepts an arrow whose
  --- parameter chain matches the index list `base` (a single type, or
  --- `type.array{elements}` for multi-index families). A same-tag
  --- `type.family` unifies bases. Any other shape is not a family
  --- inhabitant.
  check_family_arrow_ :: [funcs, s, typ, expected]~> do {
    base :: get_or(expected, "base", null)
    elems :: if type_tag(base) == "type.array" { get_or(base, "elements", []) } else { [base] }
    walk :: while { cur: typ, state: s, remaining: elems, ok: true } {
      [st]~> if is_empty(st.remaining) || !st.ok {
        { out: { state: st["state"], ok: st.ok } }
      } else {
        do {
          e :: first_value(st.remaining)
          ctag :: type_tag(st.cur)
          if ctag == "type.function" {
            do {
              u :: unify(funcs, get_or(st.cur, "param", null), e, st["state"].metas)
              if u.ok {
                { state: { cur: get_or(st.cur, "body", null), state: set(st["state"], "metas", u.metas), remaining: drop(st.remaining, 1), ok: true } }
              } else {
                { state: { cur: st.cur, state: tc_add_diagnostic(st["state"], "error", "check: family index domain mismatch"), remaining: drop(st.remaining, 1), ok: false } }
              }
            }
          } else {
            if ctag == "type.pi" {
              do {
                u :: unify(funcs, get_or(st.cur, "param", null), e, st["state"].metas)
                if u.ok {
                  do {
                    m :: tc_fresh_meta(set(st["state"], "metas", u.metas))
                    applied :: funcs.apply_dep_closure_(funcs, st.cur, meta_value(m.id), null, m["state"])
                    { state: { cur: applied.val, state: applied["state"], remaining: drop(st.remaining, 1), ok: true } }
                  }
                } else {
                  { state: { cur: st.cur, state: tc_add_diagnostic(st["state"], "error", "check: family index domain mismatch"), remaining: drop(st.remaining, 1), ok: false } }
                }
              }
            } else {
              if ctag == "type.family" {
                do {
                  u :: unify(funcs, get_or(st.cur, "base", null), base, st["state"].metas)
                  { state: { cur: st.cur, state: set(st["state"], "metas", u.metas), remaining: [], ok: u.ok } }
                }
              } else {
                if is_meta(st.cur) {
                  { state: { cur: st.cur, state: st["state"], remaining: [], ok: true } }
                } else {
                  { state: { cur: st.cur, state: tc_add_diagnostic(st["state"], "error", "check: family inhabitant is not an arrow"), remaining: [], ok: false } }
                }
              }
            }
          }
        }
      }
    }
    { ok: walk.ok, state: walk["state"] }
  }

  --- Dispatch on the expected dependent former (ADR-0120 Phase 4).
  check_dependent_ :: [funcs, s, node_idx, expected]~> do {
    node :: ast_node(s.ast, node_idx)
    kind :: node_kind(node)
    tag :: type_tag(expected)
    if tag == "type.pi" {
      if kind == "function" {
        funcs.check_pi_intro_(funcs, s, node_idx, expected)
      } else {
        funcs.check_dependent_fallback_(funcs, s, node_idx, expected)
      }
    } else {
    if tag == "type.sigma" {
      do {
        children :: node_children(node)
        if kind == "array" && len(children) >= 2 {
          funcs.check_sigma_intro_(funcs, s, node_idx, expected)
        } else {
          funcs.check_dependent_fallback_(funcs, s, node_idx, expected)
        }
      }
    } else {
    if tag == "type.family" {
      do {
        r :: funcs.synth_node_(funcs, s, node_idx)
        fam :: funcs.check_family_arrow_(funcs, r["state"], r.typ, expected)
        if fam.ok {
          { ok: true, state: tc_record_node_type(fam["state"], node_idx, r.typ) }
        } else {
          { ok: false, state: fam["state"] }
        }
      }
    } else {
    if tag == "Path" {
      --- `Path(a, b)` is the identity type (ADR-0120): its
      --- introductions are `refl` and in-scope `Path` witnesses
      --- (`eq_<name>` bindings, `p : Path` hypotheses).
      funcs.check_path_intro_(funcs, s, node_idx, expected)
    } else {
      --- `type.forall` has no term-level introduction form yet —
      --- synthesis + dependent unification only.
      funcs.check_dependent_fallback_(funcs, s, node_idx, expected)
    }
    }
    }
    }
  }

  check_dependent_fallback_ :: [funcs, s, node_idx, expected]~> do {
    synth_result :: funcs.synth_node_(funcs, s, node_idx)
    u :: funcs.unify_dependent_(funcs, synth_result.typ, expected, synth_result["state"])
    if u.ok {
      { ok: true, state: tc_record_node_type(u["state"], node_idx, synth_result.typ) }
    } else {
      { ok: false, state: tc_add_diagnostic(u["state"], "error", "type mismatch") }
    }
  }

  --- Dependent unification: `unify` extended across the dependent
  --- formers. Same-tag Pi/Sigma/Forall bodies are compared under a
  --- shared fresh metavariable (`body_closure` indices are arena
  --- positions — field-wise equality would wrongly compare node
  --- indices, not types); a `type.function` matches a `type.pi` by
  --- applying the closure at the function's domain; an arrow matches
  --- `type.family` by the Family-intro walk; a tuple `type.array`
  --- matches `type.sigma` component-wise.
  unify_dependent_ :: [funcs, a, b, s]~> do {
    tag_a :: type_tag(a)
    tag_b :: type_tag(b)
    if tag_a == "type.pi" && tag_b == "type.pi" {
      funcs.unify_dep_bodies_(funcs, a, b, s, "param")
    } else {
    if tag_a == "type.sigma" && tag_b == "type.sigma" {
      funcs.unify_dep_bodies_(funcs, a, b, s, "param")
    } else {
    if tag_a == "type.forall" && tag_b == "type.forall" {
      funcs.unify_dep_bodies_(funcs, a, b, s, "kind")
    } else {
    if tag_a == "type.family" && tag_b == "type.family" {
      do {
        u :: unify(funcs, get_or(a, "base", null), get_or(b, "base", null), s.metas)
        { ok: u.ok, state: set(s, "metas", u.metas) }
      }
    } else {
    if tag_a == "type.family_app" && tag_b == "type.family_app" {
      --- Saturated family applications: same head name and pairwise-
      --- unifiable index arguments. Each index arg is zonked against
      --- the current meta solution and re-evaluated before comparison
      --- — `Bin{add, ?n, 1}` with `?n` solved to `0` normalizes to `1`,
      --- so `Vec(n + 1)` with `n := 0` is definitionally `Vec(1)`. The
      --- surviving opaque shapes (`Bin` with a symbolic head, `var`
      --- terms, metavariables) then unify by the ordinary rules —
      --- metas solve, syntactically-equal terms match, and
      --- `Bin{add, X, c}` against a literal solves `X` linearly.
      if get_or(a, "name", "") != get_or(b, "name", "") {
        { ok: false, state: tc_add_diagnostic(s, "error", "type mismatch: " + get_or(a, "name", "?") + " is not " + get_or(b, "name", "?")) }
      } else {
        do {
          args_a :: get_or(a, "args", [])
          args_b :: get_or(b, "args", [])
          walk :: while { state: s, ok: true, i: 0 } {
            [st]~> if st.i >= len(args_a) || st.i >= len(args_b) || !st.ok {
              { out: { ok: st.ok && st.i >= len(args_a) && st.i >= len(args_b), state: st["state"] } }
            } else {
              do {
                na :: funcs.eval_term_(funcs, st["state"], zonk(zonk, at(args_a, st.i), st["state"].metas))
                nb :: funcs.eval_term_(funcs, na["state"], zonk(zonk, at(args_b, st.i), na["state"].metas))
                --- Index unification consumes in-scope `Path` witnesses:
                --- `unify_via_paths_` retries a failed equation by
                --- transporting either side along a `Path{frm,to}`
                --- bound in `results` (`eq_<name>` and aliases) — the
                --- J eliminator's content, applied at unification.
                u :: funcs.unify_via_paths_(funcs, na.val, nb.val, nb["state"])
                { state: { state: set(nb["state"], "metas", u.metas), ok: u.ok, i: st.i + 1 } }
              }
            }
          }
          walk
        }
      }
    } else {
    if tag_a == "type.function" && tag_b == "type.pi" {
      funcs.unify_fn_pi_(funcs, a, b, s)
    } else {
    if tag_a == "type.pi" && tag_b == "type.function" {
      funcs.unify_fn_pi_(funcs, b, a, s)
    } else {
    if tag_a == "type.function" && tag_b == "type.family" {
      funcs.check_family_arrow_(funcs, s, a, b)
    } else {
    if tag_a == "type.array" && tag_b == "type.sigma" {
      do {
        elems :: get_or(a, "elements", [])
        if len(elems) < 2 {
          { ok: false, state: tc_add_diagnostic(s, "error", "type mismatch: tuple is not a dependent pair") }
        } else {
          do {
            u :: unify(funcs, first_value(elems), get_or(b, "param", null), s.metas)
            if u.ok {
              do {
                s2 :: set(s, "metas", u.metas)
                applied :: funcs.apply_dep_closure_(funcs, b, first_value(elems), null, s2)
                u2 :: unify(funcs, at(elems, 1), applied.val, applied["state"].metas)
                { ok: u2.ok, state: set(applied["state"], "metas", u2.metas) }
              }
            } else {
              { ok: false, state: set(s, "metas", u.metas) }
            }
          }
        }
      }
    } else {
      do {
        u :: unify(funcs, a, b, s.metas)
        { ok: u.ok, state: set(s, "metas", u.metas) }
      }
    }
    }
    }
    }
    }
    }
    }
    }
    }
  }

  unify_fn_pi_ :: [funcs, fn_t, pi_t, s]~> do {
    u :: unify(funcs, get_or(fn_t, "param", null), get_or(pi_t, "param", null), s.metas)
    if u.ok {
      do {
        s2 :: set(s, "metas", u.metas)
        pname :: get_or(fn_t, "param_name", "")
        arg_term :: if pname == "" { null } else { funcs.make_type("var", set({}, "name", pname)) }
        applied :: funcs.apply_dep_closure_(funcs, pi_t, get_or(fn_t, "param", null), arg_term, s2)
        u2 :: unify(funcs, get_or(fn_t, "body", null), applied.val, applied["state"].metas)
        { ok: u2.ok, state: set(applied["state"], "metas", u2.metas) }
      }
    } else {
      { ok: false, state: set(s, "metas", u.metas) }
    }
  }

  unify_dep_bodies_ :: [funcs, a, b, s, dom_field]~> do {
    u :: unify(funcs, get_or(a, dom_field, null), get_or(b, dom_field, null), s.metas)
    if u.ok {
      do {
        m :: tc_fresh_meta(set(s, "metas", u.metas))
        ba :: funcs.apply_dep_closure_(funcs, a, meta_value(m.id), null, m["state"])
        bb :: funcs.apply_dep_closure_(funcs, b, meta_value(m.id), null, ba["state"])
        u2 :: unify(funcs, ba.val, bb.val, bb["state"].metas)
        { ok: u2.ok, state: set(bb["state"], "metas", u2.metas) }
      }
    } else {
      { ok: false, state: set(s, "metas", u.metas) }
    }
  }

  --- Constructor names of a `data` declaration: walk the `alt` tree (or
  --- single/`call`/`paren`/`type-annot` leaf) collecting bindable names.
  collect_ctor_names_ :: [funcs, s, node_idx, acc]~> do {
    n :: ast_node(s.ast, node_idx)
    kind :: node_kind(n)
    children :: node_children(n)
    if kind == "alt" {
      do {
        l_acc :: funcs.collect_ctor_names_(funcs, s, first_value(children), acc)
        funcs.collect_ctor_names_(funcs, s, at(children, 1), l_acc)
      }
    } else {
    if kind == "paren" {
      if is_empty(children) {
        acc
      } else {
        funcs.collect_ctor_names_(funcs, s, first_value(children), acc)
      }
    } else {
    if kind == "type-annot" {
      do {
        subj_role :: child_role_index(s, "type-annot", "subject")
        if subj_role == null {
          acc
        } else {
          funcs.collect_ctor_names_(funcs, s, at(children, subj_role), acc)
        }
      }
    } else {
    if kind == "call" {
      do {
        callee_role :: child_role_index(s, "call", "callee")
        if callee_role == null {
          acc
        } else {
          funcs.collect_ctor_names_(funcs, s, at(children, callee_role), acc)
        }
      }
    } else {
    if kind == "var" {
      do {
        p :: node_payload(n)
        nm :: if type_of(p) == "str" { p } else { get_or(p, "name", "") }
        if nm == "" { acc } else { [...acc, nm] }
      }
    } else {
      acc
    }
    }
    }
    }
    }
  }

  --- Family parameters of a `data` declaration, from its `type` child:
  --- `call(var F, p…)` yields one `{name, node, nat}` descriptor per
  --- parameter — `node` is the `n : Nat`-style annotation child (or
  --- `null` for a bare `var`), `nat` marks an annotation spelled
  --- exactly `Nat` (the canonical base index the desugar assigns to
  --- result-less `var` constructors). A bare `var F` head yields `[]`.
  data_params_from_ :: [s, type_idx]~> do {
    n :: ast_node(s.ast, type_idx)
    kind :: node_kind(n)
    if kind == "call" {
      do {
        children :: node_children(n)
        args_role :: child_role_index(s, "call", "args")
        if args_role == null {
          []
        } else {
          while { result: [], idx: args_role } {
            [st]~> if st.idx >= len(children) {
              { out: st.result }
            } else {
              do {
                p_idx :: at(children, st.idx)
                p_node :: ast_node(s.ast, p_idx)
                p_kind :: node_kind(p_node)
                p :: if p_kind == "type-annot" {
                  do {
                    p_children :: node_children(p_node)
                    subj_role :: child_role_index(s, "type-annot", "subject")
                    annot_role :: child_role_index(s, "type-annot", "annot")
                    if subj_role == null || annot_role == null {
                      { name: "", node: null, nat: false }
                    } else {
                      do {
                        s_node :: ast_node(s.ast, at(p_children, subj_role))
                        s_payload :: node_payload(s_node)
                        nm :: if type_of(s_payload) == "str" { s_payload } else { get_or(s_payload, "name", "") }
                        an_idx :: at(p_children, annot_role)
                        an_node :: ast_node(s.ast, an_idx)
                        an_payload :: node_payload(an_node)
                        an_name :: if node_kind(an_node) == "var" {
                          if type_of(an_payload) == "str" { an_payload } else { get_or(an_payload, "name", "") }
                        } else {
                          ""
                        }
                        { name: nm, node: an_idx, nat: an_name == "Nat" }
                      }
                    }
                  }
                } else {
                  if p_kind == "var" {
                    do {
                      p_payload :: node_payload(p_node)
                      nm :: if type_of(p_payload) == "str" { p_payload } else { get_or(p_payload, "name", "") }
                      { name: nm, node: null, nat: false }
                    }
                  } else {
                    { name: "", node: null, nat: false }
                  }
                }
                { state: { result: [...st.result, p], idx: st.idx + 1 } }
              }
            }
          }
        }
      }
    } else {
      []
    }
  }

  --- Constructor signatures of a `data` declaration: walk the `alt`
  --- tree (or a single/`paren`/`type-annot` leaf) collecting
  --- `{name, args, result, bare}` specs. `args` is a list of
  --- `{name, node}` domain descriptors — `name` is the bound argument
  --- name (from `x : T`; `""` for a bare domain) and `node` the domain
  --- AST child; `result` is the `C : Fam(idx…)` annotation child or
  --- `null`; `bare` marks a `var` leaf (desugar's canonical-base-index
  --- convention applies). Each spec is stored verbatim in gamma and
  --- re-elaborated per use by `instantiate_ctor_`, so every lookup
  --- gets fresh index metas.
  collect_ctor_specs_ :: [funcs, s, node_idx, acc]~> do {
    n :: ast_node(s.ast, node_idx)
    kind :: node_kind(n)
    children :: node_children(n)
    if kind == "alt" {
      do {
        l_acc :: funcs.collect_ctor_specs_(funcs, s, first_value(children), acc)
        funcs.collect_ctor_specs_(funcs, s, at(children, 1), l_acc)
      }
    } else {
    if kind == "paren" {
      if is_empty(children) {
        acc
      } else {
        funcs.collect_ctor_specs_(funcs, s, first_value(children), acc)
      }
    } else {
    if kind == "type-annot" {
      do {
        subj_role :: child_role_index(s, "type-annot", "subject")
        annot_role :: child_role_index(s, "type-annot", "annot")
        if subj_role == null {
          acc
        } else {
          do {
            result_idx :: if annot_role == null { null } else { at(children, annot_role) }
            leaf_specs :: funcs.collect_ctor_specs_(funcs, s, at(children, subj_role), [])
            while { result: acc, remaining: leaf_specs } {
              [st]~> if is_empty(st.remaining) {
                { out: st.result }
              } else {
                do {
                  spec :: first_value(st.remaining)
                  { state: { result: [...st.result, set(spec, "result", result_idx)], remaining: drop(st.remaining, 1) } }
                }
              }
            }
          }
        }
      }
    } else {
    if kind == "call" {
      do {
        callee_role :: child_role_index(s, "call", "callee")
        args_role :: child_role_index(s, "call", "args")
        if callee_role == null || args_role == null {
          acc
        } else {
          do {
            callee_node :: ast_node(s.ast, at(children, callee_role))
            callee_payload :: node_payload(callee_node)
            cname :: if node_kind(callee_node) == "var" {
              if type_of(callee_payload) == "str" { callee_payload } else { get_or(callee_payload, "name", "") }
            } else {
              ""
            }
            args :: while { result: [], idx: args_role } {
              [st]~> if st.idx >= len(children) {
                { out: st.result }
              } else {
                do {
                  a_idx :: at(children, st.idx)
                  a_node :: ast_node(s.ast, a_idx)
                  a_kind :: node_kind(a_node)
                  desc :: if a_kind == "type-annot" {
                    do {
                      a_children :: node_children(a_node)
                      subj_role :: child_role_index(s, "type-annot", "subject")
                      annot_role :: child_role_index(s, "type-annot", "annot")
                      if subj_role == null || annot_role == null {
                        { name: "", node: a_idx }
                      } else {
                        do {
                          sn :: ast_node(s.ast, at(a_children, subj_role))
                          sp :: node_payload(sn)
                          nm :: if type_of(sp) == "str" { sp } else { get_or(sp, "name", "") }
                          { name: nm, node: at(a_children, annot_role) }
                        }
                      }
                    }
                  } else {
                    { name: "", node: a_idx }
                  }
                  { state: { result: [...st.result, desc], idx: st.idx + 1 } }
                }
              }
            }
            if cname == "" {
              acc
            } else {
              [...acc, { name: cname, args: args, result: null, bare: false }]
            }
          }
        }
      }
    } else {
    if kind == "var" {
      do {
        p :: node_payload(n)
        nm :: if type_of(p) == "str" { p } else { get_or(p, "name", "") }
        if nm == "" {
          acc
        } else {
          [...acc, { name: nm, args: [], result: null, bare: true }]
        }
      }
    } else {
      acc
    }
    }
    }
    }
    }
  }

  --- Instantiate a `type.ctor_sig` spec into a fresh `type.function`
  --- chain ending in `type.family_app`. One index metavariable is
  --- minted per family parameter and bound to the parameter name in
  --- *both* gamma (so `xs : Vec(n, a)` synthesizes `Vec(?n, ?a)`) and
  --- results (so a result index like `n + 1` evaluates to
  --- `Bin{add, ?n, 1}` — the same meta, so unifying the argument
  --- determines the result index). Constructor argument names
  --- self-bind to `var{name}` terms so later domains can mention
  --- earlier arguments (`p : P(x)` → `App{P, [var{x}]}`, which
  --- `subst_term_` rewrites with the applied term). The env is
  --- restored afterwards — only the freshly minted metas escape.
  instantiate_ctor_ :: [funcs, s, spec]~> do {
    mark :: tc_mark(s)
    old_results :: get_or(s, "results", {})
    params :: get_or(spec, "params", [])
    p_acc :: while { state: s, remaining: params, metas: [] } {
      [st]~> if is_empty(st.remaining) {
        { out: { state: st["state"], metas: st.metas } }
      } else {
        do {
          p :: first_value(st.remaining)
          pname :: get_or(p, "name", "")
          m :: tc_fresh_meta(st["state"])
          st1 :: if pname == "" { m["state"] } else { tc_extend(m["state"], pname, meta_value(m.id)) }
          st2 :: if pname == "" { st1 } else { tc_bind_result(st1, pname, meta_value(m.id)) }
          { state: { state: st2, metas: [...st.metas, meta_value(m.id)], remaining: drop(st.remaining, 1) } }
        }
      }
    }
    spec_args :: get_or(spec, "args", [])
    a_env :: while { state: p_acc["state"], remaining: spec_args } {
      [st]~> if is_empty(st.remaining) {
        { out: st["state"] }
      } else {
        do {
          a :: first_value(st.remaining)
          aname :: get_or(a, "name", "")
          st1 :: if aname == "" { st["state"] } else { tc_bind_result(st["state"], aname, funcs.make_type("var", set({}, "name", aname))) }
          { state: { state: st1, remaining: drop(st.remaining, 1) } }
        }
      }
    }
    d_acc :: while { state: a_env, remaining: spec_args, tys: [] } {
      [st]~> if is_empty(st.remaining) {
        { out: { state: st["state"], tys: st.tys } }
      } else {
        do {
          a :: first_value(st.remaining)
          a_node :: get_or(a, "node", null)
          ty :: if a_node == null {
            { val: funcs.make_type("type.unknown", {}), state: st["state"] }
          } else {
            funcs.synth_type_(funcs, st["state"], a_node)
          }
          { state: { state: ty["state"], tys: [...st.tys, ty.val], remaining: drop(st.remaining, 1) } }
        }
      }
    }
    result_idx :: get_or(spec, "result", null)
    res :: if result_idx == null {
      if get_or(spec, "bare", false) && !is_empty(params) {
        --- Result-less `var` constructor: `0` for the first `Nat`
        --- parameter (canonical base index), param metas elsewhere —
        --- mirrors `desugar.data`'s bootstrap convention.
        do {
          idx_args :: while { result: [], i: 0, used: false } {
            [st]~> if st.i >= len(params) {
              { out: st.result }
            } else {
              do {
                p :: at(params, st.i)
                v :: if get_or(p, "nat", false) && !st.used { 0 } else { at(p_acc.metas, st.i) }
                { state: { result: [...st.result, v], i: st.i + 1, used: st.used || get_or(p, "nat", false) } }
              }
            }
          }
          { val: funcs.make_type("type.family_app", set(set({}, "name", get_or(spec, "family", "")), "args", idx_args)), state: d_acc["state"] }
        }
      } else {
        { val: funcs.make_type("type.family_app", set(set({}, "name", get_or(spec, "family", "")), "args", p_acc.metas)), state: d_acc["state"] }
      }
    } else {
      funcs.synth_type_(funcs, d_acc["state"], result_idx)
    }
    fn_ty :: while { idx: len(spec_args), body: res.val } {
      [st]~> if st.idx == 0 {
        { out: st.body }
      } else {
        do {
          a :: at(spec_args, st.idx - 1)
          ty :: at(d_acc.tys, st.idx - 1)
          new_body :: funcs.make_type("type.function", set(set(set({}, "param", ty), "body", st.body), "param_name", get_or(a, "name", "")))
          { state: { idx: st.idx - 1, body: new_body } }
        }
      }
    }
    restored :: set(tc_restore(res["state"], mark), "results", old_results)
    { val: fn_ty, state: restored }
  }

  --- Composition `f >>> g` in `type.function` coordinates (used by the
  --- `synth_flow` judgment): unify the boundary `f.body ~ g.param` and
  --- synthesize `type.function{param: f.param, body: g.body}`. A
  --- `type.pi`/`type.forall` operand contributes its domain and its
  --- body closure applied at that domain; the composite flattens to
  --- `type.function` because a `body_closure` needs an AST body the
  --- composite does not have — the documented structural
  --- approximation. Non-arrow operands yield `type.unknown` with a
  --- warning (matching the old placeholder's permissiveness).
  flow_cod_ :: [funcs, t, s]~> do {
    tag :: type_tag(t)
    dom :: get_or(t, "param", get_or(t, "kind", null))
    if tag == "type.pi" || tag == "type.forall" {
      funcs.apply_dep_closure_(funcs, t, dom, null, s)
    } else {
      { val: get_or(t, "body", null), state: s }
    }
  }

  flow_compose_ :: [funcs, f, g, s]~> do {
    ft :: type_tag(f)
    gt :: type_tag(g)
    f_arrow :: ft == "type.function" || ft == "type.pi" || ft == "type.forall"
    g_arrow :: gt == "type.function" || gt == "type.pi" || gt == "type.forall" || gt == "type.family"
    f_open :: is_meta(f) || ft == "type.unknown"
    g_open :: is_meta(g) || gt == "type.unknown"
    if f_open || g_open {
      --- Underdetermined operand — no boundary evidence either way.
      { val: funcs.make_type("type.unknown", {}), state: s }
    } else {
    if !f_arrow || !g_arrow {
      { val: funcs.make_type("type.unknown", {}), state: tc_add_diagnostic(s, "warning", "flow: operand is not an arrow") }
    } else {
      do {
        f_dom :: get_or(f, "param", get_or(f, "kind", null))
        g_dom :: if gt == "type.family" { get_or(g, "base", null) } else { get_or(g, "param", get_or(g, "kind", null)) }
        f_cod_res :: funcs.flow_cod_(funcs, f, s)
        boundary :: funcs.unify_dependent_(funcs, f_cod_res.val, g_dom, f_cod_res["state"])
        if boundary.ok {
          if gt == "type.family" {
            --- Reindexing is ordinary composition: `f >>> P` is the
            --- pullback family `f* P : A ↝ Type` — no dedicated
            --- primitive; the composite is a family over `f`'s source.
            { val: funcs.make_type("type.family", set({}, "base", f_dom)), state: boundary["state"] }
          } else {
            do {
              g_cod_res :: funcs.flow_cod_(funcs, g, boundary["state"])
              { val: funcs.make_type("type.function", set(set({}, "param", f_dom), "body", g_cod_res.val)), state: g_cod_res["state"] }
            }
          }
        } else {
          { val: funcs.make_type("type.unknown", {}), state: tc_add_diagnostic(boundary["state"], "error", "flow: composition boundary mismatch (tgt of left does not match src of right)") }
        }
      }
    }
    }
  }

  --- ------------------------------------------------------------------
  --- Globular boundaries for `a >>>[k] b` (ADR-0120 Phase 2 follow-up).
  ---
  --- A morphism type `A ~[N]~> B` synthesizes `Arrow{inputs, grade,
  --- output, dim}` (`synth_dim_arrow`): an n-cell whose top (n-1)-
  --- boundaries are the *types* of the endpoint expressions —
  --- `inputs` is `src_{n-1}`, `output` is `tgt_{n-1}`, and `dim` is the
  --- literal bracket dimension (`null` when the dimension expression is
  --- not a literal — the record's declared boundaries are then the only
  --- ones the projection can see, at every level). A `type.function`
  --- (and its dependent kin `type.pi`/`type.forall`/`type.family`) is a
  --- 1-cell: only 0-boundaries exist — `param`/`kind`/`base` for src,
  --- `body`/the applied closure/`Type` for tgt. Every other type is a
  --- degenerate cell — the whole type stands for every boundary,
  --- mirroring the runtime rule that a non-`Cell2` value is its own src
  --- and tgt — and any cell viewed above its own dimension is the
  --- iterated identity on itself, the degenerate lift.
  --- ------------------------------------------------------------------

  --- Domain/codomain readers shared by `cell_boundary_` — the same
  --- coordinate choice `flow_compose_` makes (`param`/`kind` for the
  --- domain, `base` for a family; the dependent formers' codomain needs
  --- the closure applied at their own domain, so `flow_cod_` is reused).
  cell_dom_ :: [funcs, t]~> if type_tag(t) == "type.family" {
    get_or(t, "base", null)
  } else {
    get_or(t, "param", get_or(t, "kind", null))
  }

  cell_cod_ :: [funcs, t, s]~> if type_tag(t) == "type.family" {
    { val: funcs.make_type("type.universe", set({}, "level", 0)), state: s }
  } else {
    funcs.flow_cod_(funcs, t, s)
  }

  --- `cell_boundary_(t, k, side)` — the type-level `src_k`/`tgt_k`
  --- projection. For an `Arrow` with a literal `dim`: `k = dim-1`
  --- projects `inputs`/`output` (the top boundaries); `k < dim-1`
  --- recurses into `inputs` — globularity shares every lower boundary
  --- between the two top cells, so the `output` side needs no separate
  --- walk (the globe condition `src_j(inputs) = src_j(output)` is
  --- assumed, not verified — documented approximation); `k >= dim` is
  --- the degenerate lift — the whole cell stands for the boundary.
  --- For a literal-free `dim` the record carries no level information,
  --- so `inputs`/`output` project at every `k` — the only boundaries
  --- the representation holds (the value model's only cell shape is
  --- `Cell2`, whose boundaries sit at level 1).
  cell_boundary_ :: [funcs, t, k, side, s]~> do {
    tag :: type_tag(t)
    if tag == "Arrow" {
      do {
        field :: if side == "src" { "inputs" } else { "output" }
        dim :: get_or(t, "dim", null)
        if type_of(dim) == "num" {
          if k == dim - 1 {
            { val: get_or(t, field, null), state: s }
          } else {
          if k < dim - 1 {
            funcs.cell_boundary_(funcs, get_or(t, "inputs", null), k, side, s)
          } else {
            { val: t, state: s }
          }
          }
        } else {
          { val: get_or(t, field, null), state: s }
        }
      }
    } else {
    if tag == "type.function" || tag == "type.pi" || tag == "type.forall" || tag == "type.family" {
      if k == 0 {
        if side == "src" {
          { val: funcs.cell_dom_(funcs, t), state: s }
        } else {
          funcs.cell_cod_(funcs, t, s)
        }
      } else {
        { val: t, state: s }
      }
    } else {
      { val: t, state: s }
    }
    }
  }

  --- `cell_paste_(a, b, k)` — the type-level `∘ₖ` composite once
  --- `tgt_k(a) = src_k(b)` has unified. An `Arrow` operand with
  --- `dim = k+1` pastes at its top level: the composite keeps the left
  --- `inputs` and takes the right `output` (`cell2(src_a, tgt_b)`).
  --- An `Arrow` with `dim > k+1` pastes pairwise through its
  --- boundaries — `inputs: src∘src`, `output: tgt∘tgt`, the runtime
  --- `∘₀`-on-`Cell2` shape. Every other operand is a degenerate cell
  --- at level `k` and contributes its whole type. The composite is
  --- always a `dim-(k+1)` `Arrow`, matching the runtime's unconditional
  --- `Cell2` lift: `a >>>[k] b` evaluates to a
  --- `{__tag__: "Cell2", __src__, __tgt__}` record — a (k+1)-cell whose
  --- boundaries are the operands.
  cell_paste_ :: [funcs, a, b, k]~> do {
    tag_a :: type_tag(a)
    tag_b :: type_tag(b)
    dim_a :: get_or(a, "dim", null)
    dim_b :: get_or(b, "dim", null)
    a_arr :: tag_a == "Arrow" && type_of(dim_a) == "num"
    b_arr :: tag_b == "Arrow" && type_of(dim_b) == "num"
    --- `&&`/`||` evaluate both sides — guard the `>` comparisons so a
    --- literal-free `dim` (or a non-`Arrow` type) never reaches `binary.gt`.
    a_deep :: if a_arr { dim_a > k + 1 } else { false }
    b_deep :: if b_arr { dim_b > k + 1 } else { false }
    if a_deep || b_deep {
      do {
        out_dim :: if a_deep { dim_a } else { dim_b }
        a_src :: if a_deep { get_or(a, "inputs", null) } else { a }
        a_tgt :: if a_deep { get_or(a, "output", null) } else { a }
        b_src :: if b_deep { get_or(b, "inputs", null) } else { b }
        b_tgt :: if b_deep { get_or(b, "output", null) } else { b }
        new_inputs :: funcs.cell_paste_(funcs, a_src, b_src, k)
        new_output :: funcs.cell_paste_(funcs, a_tgt, b_tgt, k)
        funcs.make_type("Arrow", set(set(set(set({}, "inputs", new_inputs), "grade", funcs.make_type("type.number", {})), "output", new_output), "dim", out_dim))
      }
    } else {
      do {
        new_inputs :: if a_arr && dim_a == k + 1 { get_or(a, "inputs", null) } else { a }
        new_output :: if b_arr && dim_b == k + 1 { get_or(b, "output", null) } else { b }
        grade_t :: if a_arr {
          get_or(a, "grade", funcs.make_type("type.number", {}))
        } else {
          if b_arr { get_or(b, "grade", funcs.make_type("type.number", {})) } else { funcs.make_type("type.number", {}) }
        }
        funcs.make_type("Arrow", set(set(set(set({}, "inputs", new_inputs), "grade", grade_t), "output", new_output), "dim", k + 1))
      }
    }
  }

  --- Short diagnostic name for a projected boundary type: `?n` for an
  --- unsolved metavariable, the `__tag__` otherwise.
  cell_type_name_ :: t ~> if is_meta(t) {
    "meta?" + typeof.to_string(meta_id(t))
  } else {
    do {
      tag :: type_tag(t)
      if tag == "" { type_of(t) } else { tag }
    }
  }

  --- `axis_flow_compose_` — the `synth_axis_flow` worker. `axis_lit` is
  --- the literal axis (`null` for a non-literal axis child):
  ---   * `null` or `0` — the exact axis-0 rule the old scheme expressed
  ---     (`unify(f.body, g.param)` → `type.function{param, body}`);
  ---     a non-literal axis keeps that approximation and warns, since
  ---     the runtime picks `k` dynamically and the 0-boundary is the
  ---     only statically-known bound;
  ---   * `1` — the globular 1-boundary law `tgt_1(f) = src_1(g)`;
  ---   * `>= 2` — the dimension diagnostic. The runtime lifts every
  ---     `>>>[k]` operand to declared dimension 2 (`Cell2` is the only
  ---     cell shape the value model carries), so `k >= 2` always
  ---     violates `k < dim` regardless of the operands.
  axis_flow_compose_ :: [funcs, f, g, axis_lit, s]~> do {
    if axis_lit == null || axis_lit == 0 {
      do {
        s1 :: if axis_lit == null {
          tc_add_diagnostic(s, "warning", "axis_flow: non-literal axis — checked the 0-boundary only (k-indexed boundaries need a literal axis)")
        } else {
          s
        }
        u :: unify(funcs, get_or(f, "body", null), get_or(g, "param", null), s1.metas)
        if u.ok {
          { val: funcs.make_type("type.function", set(set({}, "param", get_or(f, "param", null)), "body", get_or(g, "body", null))), state: set(s1, "metas", u.metas) }
        } else {
          { val: funcs.make_type("type.unknown", {}), state: tc_add_diagnostic(s1, "error", "unification failed") }
        }
      }
    } else {
    if axis_lit >= 2 {
      { val: funcs.make_type("type.unknown", {}), state: tc_add_diagnostic(s, "error", "axis_flow: axis-" + typeof.to_string(axis_lit) + " composition requires cells of dimension > " + typeof.to_string(axis_lit) + " (fst has dim 2)") }
    } else {
      do {
        f_open :: is_meta(f) || type_tag(f) == "type.unknown"
        g_open :: is_meta(g) || type_tag(g) == "type.unknown"
        if f_open || g_open {
          --- Underdetermined operand — no boundary evidence either way
          --- (the `synth_flow` convention).
          { val: funcs.make_type("type.unknown", {}), state: s }
        } else {
        do {
          tb :: funcs.cell_boundary_(funcs, f, 1, "tgt", s)
          sb :: funcs.cell_boundary_(funcs, g, 1, "src", tb["state"])
          boundary :: funcs.unify_dependent_(funcs, tb.val, sb.val, sb["state"])
          if boundary.ok {
            { val: funcs.cell_paste_(funcs, f, g, 1), state: boundary["state"] }
          } else {
            { val: funcs.make_type("type.unknown", {}), state: tc_add_diagnostic(boundary["state"], "error", "axis_flow: cell composition along axis 1: boundary mismatch — tgt of the first cell does not equal src of the second (got " + funcs.cell_type_name_(tb.val) + " vs " + funcs.cell_type_name_(sb.val) + ")") }
          }
        }
        }
      }
    }
    }
  }

  eval_scheme_impl_ :: [funcs, s, node_idx, term, incoming]~> match tget(term, "__tag__") {
    "Arr": { val: tget(term, "value"), state: s },
    "Const": { val: tget(term, "value"), state: s },
    "Op": do {
      op_name :: tget(term, "name")
      source :: tget(term, "source")
      op_lit :: tget(term, "lit")
      op_args :: tget(term, "args")
      is_judgment :: source == "Judgment"
      is_native :: source == "Native"
      is_const_op :: if is_native { op_name == "const" } else { false }
      is_id_op :: if is_native { op_name == "id" } else { false }
      native_result :: if is_const_op {
        { val: op_lit, state: s }
      } else {
        if is_id_op {
          { val: incoming, state: s }
        } else {
          { val: funcs.make_type("TypeError", set({}, "message", "native op not supported: " + op_name)), state: s }
        }
      }
      foreign_result :: { val: funcs.make_type("TypeError", set({}, "message", "foreign op in type rule: " + op_name)), state: s }
      native_or_foreign :: if is_native { native_result } else { foreign_result }
      if is_judgment {
        funcs.eval_judgment_(funcs, s, node_idx, op_name, op_args, op_lit, incoming)
      } else {
        native_or_foreign
      }
    },
    "Seq": do {
      fst_term :: tget(term, "fst")
      snd_term :: tget(term, "snd")
      fst_result :: funcs.eval_scheme_(funcs, s, node_idx, fst_term, incoming)
      funcs.eval_scheme_(funcs, fst_result["state"], node_idx, snd_term, fst_result.val)
    },
    "First": do {
      inner :: tget(term, "inner")
      inc :: if incoming == null { null } else { incoming }
      is_p :: is_pair(inc)
      is_a :: type_of(inc) == "arr"
      pair_arr :: if is_p { get_or(inc, "__pair__", []) } else { if is_a { inc } else { [inc, null] } }
      a :: first_value(pair_arr)
      b :: at(pair_arr, 1)
      result :: funcs.eval_scheme_(funcs, s, node_idx, inner, a)
      { val: pair(result.val, b), state: result["state"] }
    },
    "Choice": do {
      l_term :: tget(term, "l")
      r_term :: tget(term, "r")
      is_left :: if is_either(incoming) { get_or(incoming, "__either__", "") == "left" } else { false }
      is_valid :: is_either(incoming)
      chosen :: if is_valid {
        if is_left {
          funcs.eval_scheme_(funcs, s, node_idx, l_term, either_value(incoming))
        } else {
          funcs.eval_scheme_(funcs, s, node_idx, r_term, either_value(incoming))
        }
      } else {
        { val: funcs.make_type("TypeError", set({}, "message", "Choice: incoming is not an Either")), state: s }
      }
      chosen
    },
    "Iter": do {
      initial :: tget(term, "initial")
      funcs.eval_scheme_(funcs, s, node_idx, initial, incoming)
    },
    "Child": { val: funcs.make_type("TypeError", set({}, "message", "Child: AST recursion is the driver's job")), state: s },
    "Handle": do {
      impl_term :: tget(term, "impl_")
      body_term :: tget(term, "body")
      impl_result :: funcs.eval_scheme_(funcs, s, node_idx, impl_term, incoming)
      body_result :: funcs.eval_scheme_(funcs, impl_result["state"], node_idx, body_term, incoming)
      is_fn :: type_tag(body_result.val) == "type.function"
      effects :: get_or(impl_result.val, "grades", [])
      new_val :: if is_fn { set(body_result.val, "effects", effects) } else { body_result.val }
      { val: new_val, state: body_result["state"] }
    },
    "RecordProj": do {
      record_term :: tget(term, "record")
      field :: tget(term, "field")
      record_result :: funcs.eval_scheme_(funcs, s, node_idx, record_term, incoming)
      proj_val :: if is_obj(record_result.val) { get_or(record_result.val, field, null) } else { null }
      { val: proj_val, state: record_result["state"] }
    },
    "RecordWith": do {
      record_term :: tget(term, "record")
      field :: tget(term, "field")
      value_term :: tget(term, "value")
      record_result :: funcs.eval_scheme_(funcs, s, node_idx, record_term, incoming)
      value_result :: funcs.eval_scheme_(funcs, record_result["state"], node_idx, value_term, incoming)
      base :: if is_obj(record_result.val) { record_result.val } else { {} }
      { val: set(base, field, value_result.val), state: value_result["state"] }
    },
    "Tag": do {
      tag_name :: tget(term, "tag")
      value_term :: tget(term, "value")
      value_result :: funcs.eval_scheme_(funcs, s, node_idx, value_term, incoming)
      { val: funcs.make_type(tag_name, value_result.val), state: value_result["state"] }
    },
    _: defer_to_type_model(s, term, incoming)
  }

  --- Result type of an instantiated constructor signature: peel the
  --- `type.function` chain down to the `type.family_app` it ends in
  --- (`VCons(x : a, xs : Vec(n, a)) : Vec(n + 1, a)` → `Vec(n + 1, a)`
  --- at the fresh parameter metas). Used by `collect_pattern_bindings`
  --- to hand the scrutinee-refinement equation to `synth_match_arms`.
  peel_ctor_result_ :: [self, t]~> if type_tag(t) == "type.function" {
    self(self, get_or(t, "body", null))
  } else {
    t
  }

  --- Meta ids occurring anywhere inside a type/term value — used to
  --- roll back branch-local index refinement so a scrutinee
  --- metavariable solved under one arm stays flexible for its
  --- siblings (dependent elimination is per-branch).
  meta_ids_in_ :: [self, v, acc]~> if is_meta(v) {
    [meta_id(v), ...acc]
  } else {
    if type_of(v) == "arr" {
      while { result: acc, remaining: v } {
        [st]~> if is_empty(st.remaining) {
          { out: st.result }
        } else {
          { state: { result: self(self, first_value(st.remaining), st.result), remaining: drop(st.remaining, 1) } }
        }
      }
    } else {
      if type_of(v) == "obj" {
        while { result: acc, remaining: keys(v) } {
          [st]~> if is_empty(st.remaining) {
            { out: st.result }
          } else {
            do {
              k :: first_value(st.remaining)
              { state: { result: self(self, get_or(v, k, null), st.result), remaining: drop(st.remaining, 1) } }
            }
          }
        }
      } else {
        acc
      }
    }
  }

  --- Does `var{name}` occur anywhere inside a term/type value?
  --- Guards the rigid-index rewrite in `refine_scrutinee_` against a
  --- cyclic `results` binding (`n ↦ n + 1` would recurse forever in
  --- `eval_term_`, burning fuel on every lookup).
  var_occurs_ :: [self, name, v]~> if type_tag(v) == "var" {
    get_or(v, "name", "") == name
  } else {
    if type_of(v) == "arr" {
      while { found: false, remaining: v } {
        [st]~> if is_empty(st.remaining) || st.found {
          { out: st.found }
        } else {
          { state: { found: st.found || self(self, name, first_value(st.remaining)), remaining: drop(st.remaining, 1) } }
        }
      }
    } else {
      if type_of(v) == "obj" {
        while { found: false, remaining: keys(v) } {
          [st]~> if is_empty(st.remaining) || st.found {
            { out: st.found }
          } else {
            { state: { found: st.found || self(self, name, get_or(v, first_value(st.remaining), null)), remaining: drop(st.remaining, 1) } }
          }
        }
      } else {
        false
      }
    }
  }

  --- Restore each meta id's pre-branch solution (`null` re-opens an id
  --- the branch solved): `metas` is append-only so slot values, not
  --- the array itself, are rolled back — ids minted inside the branch
  --- keep their slots and are never reused by siblings.
  metas_restore_ids_ :: [metas, old_metas, ids]~> while { result: metas, remaining: ids } {
    [st]~> if is_empty(st.remaining) {
      { out: st.result }
    } else {
      do {
        id :: first_value(st.remaining)
        restored :: if type_of(id) == "num" && id < len(st.result) {
          metas_solve(st.result, id, at(old_metas, id))
        } else {
          st.result
        }
        { state: { result: restored, remaining: drop(st.remaining, 1) } }
      }
    }
  }

  --- Dependent elimination (ADR-0120 Phase 4 deepening): refine the
  --- scrutinee's family index with a constructor's result type for
  --- the duration of one match branch. `ctor_result` is the
  --- instantiated `type.family_app` the pattern's constructor ends in
  --- (`peel_ctor_result_`); `null`/non-family results refine nothing.
  ---
  --- Per index argument pair `s_i`/`c_i` (zonked, then evaluated):
  ---   * a rigid `var{name}` scrutinee index binds `name ↦ c_i` in
  ---     `results` — the equation `n ≡ c_i` is a rewrite the branch's
  ---     unification reads through `eval_term_`'s result bindings —
  ---     witnessed by a proof-relevant `Path{frm, to}` term bound
  ---     under `eq_<name>`;
  ---   * otherwise `unify` handles it — metavariables solve and
  ---     `Bin` index terms solve linearly (`?n + 1 ≡ 2` → `?n := 1`);
  ---   * a decided mismatch — two different numeric indices, or a
  ---     `decided` failure out of `solve_index_` (a non-divisible
  ---     product, an absent integer root) — marks the arm `impossible`
  ---     (the constructor cannot produce the scrutinee's index); a
  ---     different family name is impossible outright. Anything else is
  ---     *stuck* — no full arithmetic solver — and the arm proceeds
  ---     unrefined without a diagnostic.
  ---
  --- A decided-impossible arm is *auto-discharged* — the caller skips
  --- its body with no diagnostic: coverage never requires the arm and
  --- `absurd` is not needed. `absurd` stays legal as explicit
  --- documentation; a reachable arm marked `absurd` is rejected by the
  --- caller (`synth_match_arms`).
  ---
  --- Returns `{state, impossible, idx_args}` — `idx_args` are the
  --- evaluated constructor result indices, for `apply_motive_`.
  refine_scrutinee_ :: [funcs, s, scrutinee_type, ctor_result, arm_absurd]~> do {
    c_tag :: type_tag(ctor_result)
    if c_tag != "type.family_app" {
      { state: s, impossible: false, idx_args: [] }
    } else {
      if type_tag(scrutinee_type) == "type.family_app" {
        if get_or(scrutinee_type, "name", "") != get_or(ctor_result, "name", "") {
          { state: if arm_absurd { s } else { tc_add_diagnostic(s, "error", "match arm: constructor builds " + get_or(ctor_result, "name", "?") + ", not the scrutinee's " + get_or(scrutinee_type, "name", "?")) }, impossible: true, idx_args: [] }
        } else {
          do {
            s_args :: get_or(scrutinee_type, "args", [])
            c_args :: get_or(ctor_result, "args", [])
            walk :: while { state: s, impossible: false, vals: [], i: 0 } {
              [st]~> if st.i >= len(s_args) || st.i >= len(c_args) || st.impossible {
                { out: { state: st["state"], impossible: st.impossible, vals: st.vals } }
              } else {
                do {
                  ea :: funcs.eval_term_(funcs, st["state"], zonk(zonk, at(s_args, st.i), st["state"].metas))
                  eb :: funcs.eval_term_(funcs, ea["state"], zonk(zonk, at(c_args, st.i), ea["state"].metas))
                  if type_tag(ea.val) == "var" {
                    do {
                      pname :: get_or(ea.val, "name", "")
                      cyclic :: pname == "" || var_occurs_(var_occurs_, pname, eb.val)
                      bound :: if cyclic { eb["state"] } else { tc_bind_result(eb["state"], pname, eb.val) }
                      proofed :: if cyclic { bound } else { tc_bind_result(bound, "eq_" + pname, funcs.make_type("Path", set(set({}, "frm", ea.val), "to", eb.val))) }
                      { state: { state: proofed, impossible: st.impossible, vals: [...st.vals, eb.val], i: st.i + 1 } }
                    }
                  } else {
                    do {
                      u :: unify(funcs, ea.val, eb.val, eb["state"].metas)
                      s1 :: set(eb["state"], "metas", u.metas)
                      decided :: if u.ok { false } else { (type_of(ea.val) == "num" && type_of(eb.val) == "num") || get_or(u, "decided", false) == true }
                      { state: { state: s1, impossible: st.impossible || decided, vals: [...st.vals, eb.val], i: st.i + 1 } }
                    }
                  }
                }
              }
            }
            { state: walk["state"], impossible: walk.impossible, idx_args: walk.vals }
          }
        }
      } else {
        --- Non-family scrutinee (metavariable, builtin, unknown):
        --- ordinary dependent unification refines metas in place; a
        --- failure is soft — the arm cannot be proven impossible.
        do {
          u :: funcs.unify_dependent_(funcs, scrutinee_type, ctor_result, s)
          { state: u["state"], impossible: false, idx_args: get_or(ctor_result, "args", []) }
        }
      }
    }
  }

  --- Motive application for `match s return (i, w) ~> T with`: bind
  --- the motive's parameters to the index terms (then the scrutinee's
  --- term) in `results`, then synthesize the body in type position —
  --- `Vec(k, Bool)` with `k ↦ 0` gives `type.family_app{Vec, [0, …]}`.
  --- Extra parameters self-bind (`var{name}` stays rigid); a
  --- non-function motive is a constant expected type.
  apply_motive_ :: [funcs, s, motive_idx, arg_vals]~> do {
    mnode :: ast_node(s.ast, motive_idx)
    inner_idx :: if node_kind(mnode) == "paren" {
      do {
        mc :: node_children(mnode)
        if is_empty(mc) { motive_idx } else { first_value(mc) }
      }
    } else {
      motive_idx
    }
    inner_node :: ast_node(s.ast, inner_idx)
    if node_kind(inner_node) == "function" {
      do {
        pinfo :: funcs.function_params_(funcs, s, inner_idx)
        bound :: while { state: s, remaining: pinfo.names, i: 0 } {
          [st]~> if is_empty(st.remaining) {
            { out: st["state"] }
          } else {
            do {
              pname :: first_value(st.remaining)
              aval :: if st.i < len(arg_vals) { at(arg_vals, st.i) } else { funcs.make_type("var", set({}, "name", pname)) }
              bound_st :: if pname == "" { st["state"] } else { tc_bind_result(st["state"], pname, aval) }
              { state: { state: bound_st, remaining: drop(st.remaining, 1), i: st.i + 1 } }
            }
          }
        }
        if pinfo.body_idx == null {
          { val: funcs.make_type("type.unknown", {}), state: tc_add_diagnostic(bound, "warning", "match: motive has no body") }
        } else {
          funcs.synth_type_(funcs, bound, pinfo.body_idx)
        }
      }
    } else {
      funcs.synth_type_(funcs, s, inner_idx)
    }
  }

  --- ------------------------------------------------------------------
  --- Transport / the J eliminator (ADR-0120): consuming `Path` witnesses
  --- ------------------------------------------------------------------
  ---
  --- A `Path{frm, to}` is a 2-cell — the proof-relevant witness that
  --- the index terms `frm` and `to` are equal. `refine_scrutinee_`
  --- binds one under `eq_<name>` per rigid scrutinee index for the
  --- duration of a match arm, and `unify` constructs one per successful
  --- equation. These helpers make the witness *usable* — J is the
  --- eliminator for 2-cells:
  ---
  ---   * `transport_term_`/`subst_index_` realize transport as
  ---     substitution: `p : Path{frm, to}` rewrites `frm ↦ to` inside
  ---     index terms and inside a type's index positions (`family_app`
  ---     args, `List` lengths, nested codomains) — `T[frm]` becomes
  ---     `T[to]`.
  ---   * `paths_in_scope_`/`unify_via_paths_` let unification consume
  ---     an in-scope `Path` when direct equality fails — `P[frm]`
  ---     against `P[to]` succeeds by rewriting either side along the
  ---     path.
  ---   * `resolve_path_` classifies a path *operand* (the `p` in
  ---     `p # v` / `j p, P, base`): a `Path`/`type.eq` value, the
  ---     identity `refl`, a `var` naming a gamma-bound Path, a stuck
  ---     metavariable, or a decided non-path.
  ---   * `check_path_intro_`/`synth_transport_`/`synth_j_` are the
  ---     introduction and elimination judgments — `check_path_intro_`
  ---     is dispatched from `check_dependent_`, the eliminators from
  ---     `eval_judgment_impl_` (`transport`/`synth_transport`/`synth_j`).

  --- `t[to/frm]` over the index-term vocabulary (`var`, `Bin`, `App`,
  --- `Un`, `Comp`, `If`, `ArrLit`, arrays thereof). `frm` compares by
  --- structural equality, so both a rigid `var{n}` and a compound term
  --- like `Bin{add, ?k, 1}` rewrite. Fields that are spelling,
  --- identity, provenance, or arena positions — `name`, `op`,
  --- `__meta__`, `body` (a `Lam`'s arena index), `body_closure`,
  --- `env`, `via` — are not term positions and are never rewritten.
  transport_term_ :: [self, frm, to, t]~> if frm == null {
    t
  } else {
    if t == frm {
      to
    } else {
      if type_of(t) == "arr" {
        while { result: [], remaining: t } {
          [st]~> if is_empty(st.remaining) {
            { out: st.result }
          } else {
            { state: { result: [...st.result, self(self, frm, to, first_value(st.remaining))], remaining: drop(st.remaining, 1) } }
          }
        }
      } else {
        if type_of(t) == "obj" {
          while { result: t, remaining: keys(t) } {
            [st]~> if is_empty(st.remaining) {
              { out: st.result }
            } else {
              do {
                k :: first_value(st.remaining)
                skip :: k == "__tag__" || k == "__registry__" || k == "__meta__" || k == "name" || k == "op" || k == "body" || k == "body_closure" || k == "env" || k == "via"
                { state: { result: if skip { st.result } else { set(st.result, k, self(self, frm, to, get_or(st.result, k, null))) }, remaining: drop(st.remaining, 1) } }
              }
            }
          }
        } else {
          t
        }
      }
    }
  }

  --- `T[to/frm]` over a *type* value — transport as substitution. Index
  --- terms live in `family_app` args (rewritten via `transport_term_`)
  --- and `List.length`; other structure is descended field-wise so
  --- `Nat ~> Vec(n, Bool)` transports to `Nat ~> Vec(0, Bool)`.
  --- `type.ctor_sig`/`Path`/`type.eq` objects and closures
  --- (`Lam`/`LamVal`/`CompVal`) are left untouched — they hold arena
  --- positions and environments, not transport subjects — and a
  --- recorded `via` witness is provenance, never rewritten.
  subst_index_ :: [self, frm, to, v]~> if frm == null {
    v
  } else {
    if v == frm {
      to
    } else {
      if type_tag(v) == "type.family_app" {
        do {
          args :: get_or(v, "args", [])
          new_args :: while { result: [], remaining: args } {
            [st]~> if is_empty(st.remaining) {
              { out: st.result }
            } else {
              { state: { result: [...st.result, transport_term_(transport_term_, frm, to, first_value(st.remaining))], remaining: drop(st.remaining, 1) } }
            }
          }
          set(v, "args", new_args)
        }
      } else {
        if type_of(v) == "arr" {
          while { result: [], remaining: v } {
            [st]~> if is_empty(st.remaining) {
              { out: st.result }
            } else {
              { state: { result: [...st.result, self(self, frm, to, first_value(st.remaining))], remaining: drop(st.remaining, 1) } }
            }
          }
        } else {
          if type_of(v) == "obj" {
            do {
              vtag :: type_tag(v)
              if vtag == "type.ctor_sig" || vtag == "Path" || vtag == "type.eq" || vtag == "Lam" || vtag == "LamVal" || vtag == "CompVal" {
                v
              } else {
                while { result: v, remaining: keys(v) } {
                  [st]~> if is_empty(st.remaining) {
                    { out: st.result }
                  } else {
                    do {
                      k :: first_value(st.remaining)
                      skip :: k == "__tag__" || k == "__registry__" || k == "__meta__" || k == "name" || k == "op" || k == "body" || k == "body_closure" || k == "env" || k == "via" || k == "param_name" || k == "ctor"
                      { state: { result: if skip { st.result } else { set(st.result, k, self(self, frm, to, get_or(st.result, k, null))) }, remaining: drop(st.remaining, 1) } }
                    }
                  }
                }
              }
            }
          } else {
            v
          }
        }
      }
    }
  }

  --- `Path` witnesses bound in `results` — the `eq_<name>` bindings of
  --- `refine_scrutinee_`, plus aliases: a `q := eq_n` assignment stores
  --- the *term* `var{eq_n}`, so each binding is evaluated before the
  --- `Path` tag is checked.
  paths_in_scope_ :: [funcs, s]~> do {
    rs :: get_or(s, "results", {})
    ks :: if type_of(rs) == "obj" { keys(rs) } else { [] }
    while { result: [], remaining: ks } {
      [st]~> if is_empty(st.remaining) {
        { out: st.result }
      } else {
        do {
          raw :: get_or(rs, first_value(st.remaining), null)
          v :: funcs.eval_term_(funcs, s, raw).val
          { state: { result: if type_tag(v) == "Path" { [...st.result, v] } else { st.result }, remaining: drop(st.remaining, 1) } }
        }
      }
    }
  }

  --- Unification consumes in-scope paths: `unify` plus a transport
  --- retry — for each `Path{frm,to}` bound in `results`, rewrite
  --- `frm ↦ to` (or `to ↦ frm`) on either side and retry. `P[frm]`
  --- against `P[to]` thereby succeeds exactly when a path justifies
  --- it; the successful witness is reported in `path`, so the equation
  --- is derived, not silently decided.
  unify_via_paths_ :: [funcs, a, b, s]~> do {
    metas :: get_or(s, "metas", [])
    u :: unify(funcs, a, b, metas)
    if u.ok {
      u
    } else {
      while { result: u, remaining: paths_in_scope_(funcs, s) } {
        [st]~> if is_empty(st.remaining) || st.result.ok {
          { out: st.result }
        } else {
          do {
            p :: first_value(st.remaining)
            frm :: get_or(p, "frm", null)
            to :: get_or(p, "to", null)
            a_fwd :: transport_term_(transport_term_, frm, to, a)
            b_fwd :: transport_term_(transport_term_, frm, to, b)
            a_rev :: transport_term_(transport_term_, to, frm, a)
            b_rev :: transport_term_(transport_term_, to, frm, b)
            r1 :: if a_fwd != a { unify(funcs, a_fwd, b, metas) } else { { ok: false, metas: metas, path: null } }
            r2 :: if r1.ok { r1 } else { if b_fwd != b { unify(funcs, a, b_fwd, metas) } else { r1 } }
            r3 :: if r2.ok { r2 } else { if a_rev != a { unify(funcs, a_rev, b, metas) } else { r2 } }
            r4 :: if r3.ok { r3 } else { if b_rev != b { unify(funcs, a, b_rev, metas) } else { r3 } }
            { state: { result: if r4.ok { { ok: true, metas: r4.metas, path: p } } else { st.result }, remaining: drop(st.remaining, 1) } }
          }
        }
      }
    }
  }

  --- Classify a path operand (the `p` in `p # v` / `j p, P, base`):
  ---   * "path"  — a `Path{frm,to}` (or `type.eq{left,right}`) value,
  ---     or a `var` whose *gamma type* is one (`p : Path(a, b) = …`);
  ---   * "refl"  — the identity path: the `refl` term or a `type.refl`
  ---     value;
  ---   * "stuck" — a metavariable or unknown operand: not provably a
  ---     path, not provably not — proceed without an error (the same
  ---     no-diagnostic-on-stuck discipline as index refinement);
  ---   * "bad"   — a decided non-path (a number, an application, an
  ---     indexed family, an unbound name) — the eliminators reject it.
  resolve_path_ :: [funcs, s, path_idx]~> do {
    ev :: funcs.eval_node_(funcs, s, path_idx)
    pv :: zonk(zonk, ev.val, ev["state"].metas)
    ptag :: type_tag(pv)
    pname :: if ptag == "var" { get_or(pv, "name", "") } else { "" }
    is_refl_tm :: ptag == "type.refl" || pname == "refl"
    if ptag == "Path" {
      { verdict: "path", frm: get_or(pv, "frm", null), to: get_or(pv, "to", null), witness: pv, state: ev["state"] }
    } else {
    if ptag == "type.eq" {
      { verdict: "path", frm: get_or(pv, "left", null), to: get_or(pv, "right", null), witness: pv, state: ev["state"] }
    } else {
    if is_refl_tm {
      { verdict: "refl", frm: null, to: null, witness: pv, state: ev["state"] }
    } else {
      --- A `var` operand that stayed symbolic may still *name* a
      --- gamma-bound Path (`p : Path(a, b) = …`); fall back to its
      --- declared type. An unbound operand names an absent path — a
      --- decided failure, not a stuck one.
      gt :: if pname != "" { tc_lookup(ev["state"], pname) } else { null }
      gtag :: type_tag(gt)
      if gtag == "Path" {
        { verdict: "path", frm: get_or(gt, "frm", null), to: get_or(gt, "to", null), witness: gt, state: ev["state"] }
      } else {
      if gtag == "type.eq" {
        { verdict: "path", frm: get_or(gt, "left", null), to: get_or(gt, "right", null), witness: gt, state: ev["state"] }
      } else {
        verdict :: if ptag == "var" && gt == null {
          "bad"
        } else {
          if is_meta(pv) || is_meta(gt) || gtag == "type.unknown" { "stuck" } else { "bad" }
        }
        { verdict: verdict, frm: null, to: null, witness: pv, state: ev["state"] }
      }
      }
    }
    }
    }
  }

  --- Path introduction (ADR-0120): checking a term against
  --- `Path{frm,to}`. `refl` inhabits `Path(a, a)` — the expected
  --- endpoints must unify — and a `Path`-tagged value (the `eq_<name>`
  --- witness bound by `refine_scrutinee_`, an alias stored by
  --- assignment, or a `var` whose gamma type is a `Path`) inhabits
  --- `Path(frm, to)` when its endpoints unify with the expected ones.
  --- Anything else is not a path.
  check_path_intro_ :: [funcs, s, node_idx, expected]~> do {
    ev :: funcs.eval_node_(funcs, s, node_idx)
    pv :: zonk(zonk, ev.val, ev["state"].metas)
    ptag :: type_tag(pv)
    pname :: if ptag == "var" { get_or(pv, "name", "") } else { "" }
    is_refl_tm :: ptag == "type.refl" || pname == "refl"
    efrm :: zonk(zonk, get_or(expected, "frm", null), ev["state"].metas)
    eto :: zonk(zonk, get_or(expected, "to", null), ev["state"].metas)
    gt :: if pname != "" { tc_lookup(ev["state"], pname) } else { null }
    gtag :: type_tag(gt)
    path_of :: if ptag == "Path" { pv } else { if gtag == "Path" { gt } else { null } }
    if path_of != null {
      do {
        uf :: unify(funcs, get_or(path_of, "frm", null), efrm, ev["state"].metas)
        ut :: if uf.ok { unify(funcs, get_or(path_of, "to", null), eto, uf.metas) } else { uf }
        if ut.ok {
          { ok: true, state: tc_record_node_type(set(ev["state"], "metas", ut.metas), node_idx, expected) }
        } else {
          { ok: false, state: tc_add_diagnostic(set(ev["state"], "metas", ut.metas), "error", "check: path endpoints do not match the expected Path") }
        }
      }
    } else {
      if is_refl_tm {
        do {
          u :: unify(funcs, efrm, eto, ev["state"].metas)
          if u.ok {
            { ok: true, state: tc_record_node_type(set(ev["state"], "metas", u.metas), node_idx, expected) }
          } else {
            { ok: false, state: tc_add_diagnostic(ev["state"], "error", "check: refl proves only a reflexive Path") }
          }
        }
      } else {
        { ok: false, state: tc_add_diagnostic(ev["state"], "error", "check: term is not a Path witness") }
      }
    }
  }

  --- `synth_transport_` — `p # v` is the transport eliminator for the
  --- 2-cell `p : Path{frm,to}` (ADR-0120): `v : T[frm]` yields `T[to]`,
  --- computed by `subst_index_` (transport IS the substitution). The
  --- path operand is *resolved*, not synthesized — the `eq_<name>`
  --- witnesses of `refine_scrutinee_` live in `results`, not gamma, so
  --- the child is evaluated through the term evaluator; a `var` that
  --- stays symbolic falls back to its gamma type
  --- (`p : Path(a, b) = …`). `refl` is the identity transport; a
  --- metavariable operand is *stuck* (warning, value passes through
  --- unrefined); a decided non-path is an error. The result type
  --- records the consumed witness under `via` — proof-relevant, never
  --- erased.
  synth_transport_ :: [funcs, s, node_idx]~> do {
    node :: ast_node(s.ast, node_idx)
    children :: node_children(node)
    path_role :: child_role_index(s, "transport", "path")
    value_role :: child_role_index(s, "transport", "value")
    if len(children) < 2 {
      { val: funcs.make_type("type.unknown", {}), state: tc_add_diagnostic(s, "error", "transport: needs a path and a value operand") }
    } else {
      do {
        p_role :: if path_role == null { 0 } else { path_role }
        v_role :: if value_role == null { 1 } else { value_role }
        path_idx :: at(children, p_role)
        value_idx :: at(children, v_role)
        rp :: resolve_path_(funcs, s, path_idx)
        if rp.verdict == "bad" {
          { val: funcs.make_type("type.unknown", {}), state: tc_add_diagnostic(rp["state"], "error", "transport: path operand is not a Path") }
        } else {
          do {
            vres :: funcs.synth_node_(funcs, rp["state"], value_idx)
            transported :: if rp.verdict == "path" {
              subst_index_(subst_index_, rp.frm, rp.to, vres.typ)
            } else {
              vres.typ
            }
            out_state :: if rp.verdict == "stuck" {
              tc_add_diagnostic(vres["state"], "warning", "transport: path operand is not yet known to be a Path — stuck")
            } else {
              vres["state"]
            }
            tagged :: if rp.verdict == "stuck" {
              transported
            } else {
              if type_of(transported) == "obj" { set(transported, "via", rp.witness) } else { transported }
            }
            { val: tagged, state: out_state }
          }
        }
      }
    }
  }

  --- `synth_j_` — the J eliminator `j p, P, base` (ADR-0120):
  --- `J : P a refl ~> (b : A) ~> (p : a ~Path~ b) ~> P b p`, with the
  --- surface order `j <path>, <motive>, <base>` (children
  --- `path`/`motive`/`base`). For `p : Path{frm,to}` the base is
  --- *checked* against the motive applied at `[frm, p]` and the result
  --- is the motive applied at `[to, p]` — `apply_motive_` composes it,
  --- and the motive's `results` bindings are rolled back afterwards
  --- (they are local to the elimination). At `refl` the endpoints are
  --- unidentified, so J computes on the base's own fibre: the motive is
  --- applied at the base's family indices plus the base term — the
  --- same convention `synth_match_arms` uses for the scrutinee — and
  --- the base is checked against it.
  synth_j_ :: [funcs, s, node_idx]~> do {
    node :: ast_node(s.ast, node_idx)
    children :: node_children(node)
    path_role :: child_role_index(s, "j", "path")
    motive_role :: child_role_index(s, "j", "motive")
    base_role :: child_role_index(s, "j", "base")
    if len(children) < 3 {
      { val: funcs.make_type("type.unknown", {}), state: tc_add_diagnostic(s, "error", "j: needs path, motive, and base operands") }
    } else {
      do {
        p_role :: if path_role == null { 0 } else { path_role }
        m_role :: if motive_role == null { 1 } else { motive_role }
        b_role :: if base_role == null { 2 } else { base_role }
        path_idx :: at(children, p_role)
        motive_idx :: at(children, m_role)
        base_idx :: at(children, b_role)
        rp :: resolve_path_(funcs, s, path_idx)
        old_results :: get_or(rp["state"], "results", {})
        if rp.verdict == "bad" {
          { val: funcs.make_type("type.unknown", {}), state: tc_add_diagnostic(rp["state"], "error", "j: path operand is not a Path") }
        } else {
        if rp.verdict == "stuck" {
          do {
            bres :: funcs.synth_node_(funcs, rp["state"], base_idx)
            { val: bres.typ, state: tc_add_diagnostic(bres["state"], "warning", "j: path operand is not yet known to be a Path — stuck") }
          }
        } else {
        if rp.verdict == "refl" {
          do {
            bres :: funcs.synth_node_(funcs, rp["state"], base_idx)
            idx_acc :: if type_tag(bres.typ) == "type.family_app" {
              while { state: bres["state"], vals: [], remaining: get_or(bres.typ, "args", []) } {
                [w]~> if is_empty(w.remaining) {
                  { out: { vals: w.vals, state: w["state"] } }
                } else {
                  do {
                    e :: funcs.eval_term_(funcs, w["state"], zonk(zonk, first_value(w.remaining), w["state"].metas))
                    { state: { vals: [...w.vals, e.val], state: e["state"], remaining: drop(w.remaining, 1) } }
                  }
                }
              }
            } else {
              { vals: [], state: bres["state"] }
            }
            bterm :: funcs.node_term_(funcs, idx_acc["state"], base_idx)
            m_res :: apply_motive_(funcs, idx_acc["state"], motive_idx, concat(idx_acc.vals, [bterm]))
            s_m :: set(m_res["state"], "results", old_results)
            chk :: funcs.check_node_(funcs, s_m, base_idx, m_res.val)
            if chk.ok {
              { val: if type_of(m_res.val) == "obj" { set(m_res.val, "via", rp.witness) } else { m_res.val }, state: chk["state"] }
            } else {
              { val: funcs.make_type("type.unknown", {}), state: tc_add_diagnostic(chk["state"], "error", "j: base does not inhabit the motive at refl") }
            }
          }
        } else {
          --- "path": check `base : P frm p`, yield `P to p`.
          do {
            m_frm :: apply_motive_(funcs, rp["state"], motive_idx, [rp.frm, rp.witness])
            s1 :: set(m_frm["state"], "results", old_results)
            chk :: funcs.check_node_(funcs, s1, base_idx, m_frm.val)
            if chk.ok {
              do {
                m_to :: apply_motive_(funcs, chk["state"], motive_idx, [rp.to, rp.witness])
                s2 :: set(m_to["state"], "results", old_results)
                { val: if type_of(m_to.val) == "obj" { set(m_to.val, "via", rp.witness) } else { m_to.val }, state: s2 }
              }
            } else {
              { val: funcs.make_type("type.unknown", {}), state: tc_add_diagnostic(chk["state"], "error", "j: base does not inhabit the motive at the path's source") }
            }
          }
        }
        }
        }
      }
    }
  }

  --- Pattern binding collection for match arms ---
  collect_pattern_bindings :: [funcs, s, pattern_idx, expected_type]~> do {
    initial_task :: [pattern_idx, expected_type, true]
    while { stack: [initial_task], bindings: [], ctor_result: null, state: s } {
      [st]~> if is_empty(st.stack) {
        { out: { bindings: st.bindings, ctor_result: st.ctor_result, state: st["state"] } }
      } else {
        do {
          task :: first_value(st.stack)
          rest_stack :: drop(st.stack, 1)
          pat_idx :: first_value(task)
          expected :: at(task, 1)
          --- The first task is the scrutinee's own pattern — only it
          --- contributes a `ctor_result` for index refinement; nested
          --- patterns (pushed below) carry `false`.
          is_top :: at(task, 2) == true
          pat_node :: ast_node(s.ast, pat_idx)
          pat_kind :: node_kind(pat_node)
          pat_payload :: node_payload(pat_node)
          if pat_kind == "var" {
            do {
              pattern_name :: if type_of(pat_payload) == "str" { pat_payload } else { get_or(pat_payload, "name", "") }
              --- A `var` naming a `data` constructor is a nullary
              --- constructor *pattern*, not a binder — `match n { Zero:
              --- ... }` must not bind a variable `Zero`. Anything else
              --- binds at the expected type.
              is_ctor :: type_tag(tc_lookup(st["state"], pattern_name)) == "type.ctor_sig"
              new_bindings :: if pattern_name != "" && !is_ctor { [...st.bindings, set(set({}, "name", pattern_name), "type", expected)] } else { st.bindings }
              --- Dependent elimination: instantiate the nullary
              --- constructor at the top level so `synth_match_arms`
              --- can unify its result (`Vec(0, a)`) with the
              --- scrutinee's index.
              inst :: if is_ctor && is_top {
                funcs.instantiate_ctor_(funcs, st["state"], tc_lookup(st["state"], pattern_name))
              } else {
                { val: null, state: st["state"] }
              }
              new_ctor_result :: if inst.val == null { st.ctor_result } else { peel_ctor_result_(peel_ctor_result_, inst.val) }
              { state: { stack: rest_stack, bindings: new_bindings, ctor_result: new_ctor_result, state: inst["state"] } }
            }
          } else {
          if pat_kind == "paren" {
            do {
              p_children :: node_children(pat_node)
              --- `paren` is transparent — the scrutinee's own pattern
              --- stays the top-level one through the wrapper.
              new_stack :: if is_empty(p_children) { rest_stack } else { [[first_value(p_children), expected, is_top], ...rest_stack] }
              { state: { stack: new_stack, bindings: st.bindings, ctor_result: st.ctor_result, state: st["state"] } }
            }
          } else {
          if pat_kind == "call" {
            --- Constructor pattern `C(a0, …)`: instantiate the stored
            --- `type.ctor_sig` (fresh index metas per arm) and bind
            --- each argument pattern at the corresponding domain.
            --- This gives `Succ(p)` → `p : Nat` and `VCons(x, xs)` →
            --- `x : ?a, xs : Vec(?n, ?a)` — the domains the
            --- constructor declares. The top-level pattern also hands
            --- the instantiated *result* (`Vec(?n + 1, ?a)`) to
            --- `synth_match_arms`, which unifies it with the
            --- scrutinee's index for the branch (dependent
            --- elimination); the instantiated metas stay flexible and
            --- solve on use.
            do {
              callee_role :: child_role_index(st["state"], "call", "callee")
              args_role :: child_role_index(st["state"], "call", "args")
              if callee_role == null || args_role == null {
                { state: { stack: rest_stack, bindings: st.bindings, ctor_result: st.ctor_result, state: st["state"] } }
              } else {
                do {
                  pat_children :: node_children(pat_node)
                  callee_node :: ast_node(s.ast, at(pat_children, callee_role))
                  callee_payload :: node_payload(callee_node)
                  cname :: if node_kind(callee_node) == "var" {
                    if type_of(callee_payload) == "str" { callee_payload } else { get_or(callee_payload, "name", "") }
                  } else {
                    ""
                  }
                  sig :: if cname == "" { null } else { tc_lookup(st["state"], cname) }
                  if type_tag(sig) != "type.ctor_sig" {
                    { state: { stack: rest_stack, bindings: st.bindings, ctor_result: st.ctor_result, state: st["state"] } }
                  } else {
                    do {
                      inst :: funcs.instantiate_ctor_(funcs, st["state"], sig)
                      peeled :: while { cur: inst.val, result: [], idx: args_role } {
                        [inner]~> if inner.idx >= len(pat_children) {
                          { out: { pairs: inner.result, cur: inner.cur } }
                        } else {
                          do {
                            arg_idx :: at(pat_children, inner.idx)
                            dom :: if type_tag(inner.cur) == "type.function" { get_or(inner.cur, "param", make_type("type.unknown", {})) } else { make_type("type.unknown", {}) }
                            nxt :: if type_tag(inner.cur) == "type.function" { get_or(inner.cur, "body", null) } else { null }
                            { state: { cur: nxt, result: [...inner.result, [arg_idx, dom]], idx: inner.idx + 1 } }
                          }
                        }
                      }
                      new_ctor_result :: if is_top { peel_ctor_result_(peel_ctor_result_, peeled.cur) } else { st.ctor_result }
                      { state: { stack: concat(peeled.pairs, rest_stack), bindings: st.bindings, ctor_result: new_ctor_result, state: inst["state"] } }
                    }
                  }
                }
              }
            }
          } else {
            if pat_kind == "rest" || pat_kind == "optional" {
              do {
                subject_idx :: child_ref(s.ast, pat_idx, 0)
                subj_node :: ast_node(s.ast, subject_idx)
                subj_payload :: node_payload(subj_node)
                name :: if type_of(subj_payload) == "str" { subj_payload } else { get_or(subj_payload, "name", "") }
                new_bindings :: if name != "" { [...st.bindings, set(set({}, "name", name), "type", expected)] } else { st.bindings }
                { state: { stack: rest_stack, bindings: new_bindings, ctor_result: st.ctor_result, state: st["state"] } }
              }
            } else {
              if pat_kind == "array" {
                do {
                  el_type :: if type_tag(expected) == "type.array" { get_or(expected, "element", make_type("type.unknown", {})) } else { make_type("type.unknown", {}) }
                  arr_children :: node_children(pat_node)
                  new_stack :: while { result: rest_stack, remaining: arr_children } {
                    [inner]~> if is_empty(inner.remaining) {
                      { out: inner.result }
                    } else {
                      do {
                        child_idx :: first_value(inner.remaining)
                        child_node :: ast_node(s.ast, child_idx)
                        child_type :: if node_kind(child_node) == "rest" || node_kind(child_node) == "optional" { expected } else { el_type }
                        { state: { result: [[child_idx, child_type], ...inner.result], remaining: drop(inner.remaining, 1) } }
                      }
                    }
                  }
                  { state: { stack: new_stack, bindings: st.bindings, ctor_result: st.ctor_result, state: st["state"] } }
                }
              } else {
                if pat_kind == "object" {
                  do {
                    fields :: if type_tag(expected) == "type.record" { get_or(expected, "fields", {}) } else { {} }
                    obj_children :: node_children(pat_node)
                    new_stack :: while { result: rest_stack, remaining: obj_children } {
                      [inner]~> if is_empty(inner.remaining) {
                        { out: inner.result }
                      } else {
                        do {
                          entry_idx :: first_value(inner.remaining)
                          entry_node :: ast_node(s.ast, entry_idx)
                          entry_kind :: node_kind(entry_node)
                          is_rest :: entry_kind == "rest" || entry_kind == "optional"
                          new_task :: if is_rest {
                            [entry_idx, expected]
                          } else {
                            do {
                              entry_children :: node_children(entry_node)
                              key_idx :: first_value(entry_children)
                              value_idx :: at(entry_children, 1)
                              key_node :: ast_node(s.ast, key_idx)
                              key_payload :: node_payload(key_node)
                              key :: if type_of(key_payload) == "str" { key_payload } else { get_or(key_payload, "name", get_or(key_payload, "value", "")) }
                              field_type :: get_or(fields, key, make_type("type.unknown", {}))
                              [value_idx, field_type]
                            }
                          }
                          { state: { result: [new_task, ...inner.result], remaining: drop(inner.remaining, 1) } }
                        }
                      }
                    }
                    { state: { stack: new_stack, bindings: st.bindings, ctor_result: st.ctor_result, state: st["state"] } }
                  }
                } else {
                  { state: { stack: rest_stack, bindings: st.bindings, ctor_result: st.ctor_result, state: st["state"] } }
                }
              }
            }
          }
          }
          }
        }
      }
    }
  }

  eval_judgment_impl_ :: [funcs, s, node_idx, op_name, args, lit, incoming]~> do {
    s :: tc_sanitize(s)
    kind :: node_kind(ast_node(s.ast, node_idx))
    match op_name {
    "synth_child": do {
      idx :: lit
      child_idx :: child_ref(s.ast, node_idx, idx)
      result :: funcs.synth_node_(funcs, s, child_idx)
      { val: result.typ, state: result["state"] }
    },
    "synth_type_child": do {
      idx :: lit
      child_idx :: child_ref(s.ast, node_idx, idx)
      result :: funcs.synth_node_(funcs, s, child_idx)
      { val: result.typ, state: result["state"] }
    },
    "synth_child_or": do {
      idx :: lit
      maybe_child :: try_child_ref(s.ast, node_idx, idx)
      if maybe_child == null {
        if is_empty(args) {
          { val: funcs.make_type("type.unknown", {}), state: s }
        } else {
          funcs.eval_scheme_(funcs, s, node_idx, first_value(args), incoming)
        }
      } else {
        do {
          result :: funcs.synth_node_(funcs, s, maybe_child)
          { val: result.typ, state: result["state"] }
        }
      }
    },
    "check_child": do {
      idx :: lit
      expected :: if is_empty(args) { incoming } else { eval_first_arg(funcs, s, node_idx, args, incoming).val }
      child_idx :: child_ref(s.ast, node_idx, idx)
      result :: funcs.check_node_(funcs, s, child_idx, expected)
      { val: null, state: result["state"] }
    },
    "check_child_or": do {
      idx :: lit
      maybe_child :: try_child_ref(s.ast, node_idx, idx)
      if maybe_child == null {
        { val: null, state: s }
      } else {
        do {
          expected :: if is_empty(args) { incoming } else { eval_first_arg(funcs, s, node_idx, args, incoming).val }
          result :: funcs.check_node_(funcs, s, maybe_child, expected)
          { val: null, state: result["state"] }
        }
      }
    },
    "eval_child": do {
      idx :: lit
      child_idx :: child_ref(s.ast, node_idx, idx)
      result :: funcs.synth_node_(funcs, s, child_idx)
      { val: result.typ, state: result["state"] }
    },
    "proj_child": do {
      idx :: lit
      child_idx :: child_ref(s.ast, node_idx, idx)
      result :: funcs.synth_node_(funcs, s, child_idx)
      { val: result.typ, state: result["state"] }
    },
    "unify": if len(args) >= 2 {
      do {
        a_result :: funcs.eval_scheme_(funcs, s, node_idx, at(args, 0), incoming)
        b_result :: funcs.eval_scheme_(funcs, a_result["state"], node_idx, at(args, 1), incoming)
        unify_result :: unify(funcs, a_result.val, b_result.val, b_result["state"].metas)
        if unify_result.ok {
          { val: null, state: set(b_result["state"], "metas", unify_result.metas) }
        } else {
          { val: null, state: tc_add_diagnostic(b_result["state"], "error", "unification failed") }
        }
      }
    } else {
      do {
        inc :: if incoming == null { null } else { incoming }
        expected :: lit
        unify_result :: unify(funcs, inc, expected, s.metas)
        if unify_result.ok {
          { val: null, state: set(s, "metas", unify_result.metas) }
        } else {
          { val: null, state: tc_add_diagnostic(s, "error", "unification failed") }
        }
      }
    },
    "subtype": do {
      sub_result :: funcs.eval_scheme_(funcs, s, node_idx, at(args, 0), incoming)
      sup_result :: funcs.eval_scheme_(funcs, sub_result["state"], node_idx, at(args, 1), incoming)
      sub_chain :: sym_chain(sub_result.val)
      sup_chain :: sym_chain(sup_result.val)
      if sub_chain != null && sup_chain != null {
        --- Both sides are well-formed sym-nominals (ADR-0106 §2/§14): the
        --- `sym` parent graph *is* the subtyping relation, so `sub <: sup`
        --- holds iff the sub chain contains the sup's own handle. Runtime
        --- `instanceof` walks this same chain.
        if chain_has(sub_chain, first_value(sup_chain)) {
          { val: null, state: sup_result["state"] }
        } else {
          { val: null, state: tc_add_diagnostic(sup_result["state"], "error", "subtype check failed") }
        }
      } else {
        --- Legacy tagged type values (and any non-nominal / malformed
        --- input) keep the pre-ADR-0106 behavior: delegate to unification.
        unify_result :: unify(funcs, sub_result.val, sup_result.val, sup_result["state"].metas)
        if unify_result.ok {
          { val: null, state: set(sup_result["state"], "metas", unify_result.metas) }
        } else {
          { val: null, state: tc_add_diagnostic(sup_result["state"], "error", "subtype check failed") }
        }
      }
    },
    "extend": do {
      name :: if lit != null { lit } else { incoming }
      typ :: if is_empty(args) { incoming } else { eval_first_arg(funcs, s, node_idx, args, incoming).val }
      { val: incoming, state: tc_extend(s, name, typ) }
    },
    "lookup": do {
      raw_name :: if lit != null { lit } else { incoming }
      name :: if type_of(raw_name) == "str" { raw_name } else { get_or(raw_name, "name", "") }
      typ :: tc_lookup(s, name)
      if typ != null {
        --- A `data` constructor is stored as a `type.ctor_sig` spec;
        --- each use re-elaborates it so the index metas are fresh
        --- (`Succ(Zero)` and a second `Succ` call do not share
        --- solutions).
        if type_tag(typ) == "type.ctor_sig" {
          funcs.instantiate_ctor_(funcs, s, typ)
        } else {
          { val: typ, state: s }
        }
      } else {
        do {
          --- Language globals (`lang.globals`) carry runtime values, so a
          --- global `var` gets the type of its bound value (same JSON-type
          --- mapping as `json_type_construct`) instead of `type.unknown`.
          gval :: get_or(get_or(s, "globals", {}), name, null)
          in_prelude :: prelude_contains(s.prelude, name)
          if gval != null {
            do {
              tag :: match type_of(gval) {
                "num": "type.number",
                "str": "type.string",
                "bool": "type.bool",
                "null": "type.null",
                "arr": "type.array",
                "obj": "type.object",
                _: "type.unknown"
              }
              { val: funcs.make_type(tag, {}), state: s }
            }
          } else if in_prelude {
            if name == "array" {
              do {
                take_result :: array_take_type(s)
                { val: funcs.make_type("type.record", set({}, "fields", set({}, "take", take_result.typ))), state: take_result["state"] }
              }
            } else {
              { val: funcs.make_type("type.unknown", {}), state: s }
            }
          } else {
            do {
              meta :: tc_fresh_meta(s)
              { val: meta_value(meta.id), state: tc_add_diagnostic(meta["state"], "error", "unbound variable: " + name) }
            }
          }
        }
      }
    },
    "lookup_var": do {
      idx :: lit
      typ :: gamma_lookup_index(s.gamma, idx)
      { val: typ, state: s }
    },
    "fresh_meta": do {
      result :: tc_fresh_meta(s)
      { val: meta_value(result.id), state: result["state"] }
    },
    "fresh_row_meta": do {
      result :: tc_fresh_meta(s)
      { val: meta_value(result.id), state: result["state"] }
    },
    "solve_meta": do {
      id :: if is_empty(args) { lit } else { eval_first_arg(funcs, s, node_idx, args, incoming).val }
      val :: if len(args) >= 2 {
        eval_arg_at(funcs, s, node_idx, args, incoming, 1).val
      } else {
        incoming
      }
      { val: null, state: tc_solve_meta(s, id, val) }
    },
    "quote": if is_empty(args) {
      { val: incoming, state: s }
    } else {
      funcs.eval_scheme_(funcs, s, node_idx, first_value(args), incoming)
    },
    "normalize": if is_empty(args) {
      { val: incoming, state: s }
    } else {
      funcs.eval_scheme_(funcs, s, node_idx, first_value(args), incoming)
    },
    "construct": do {
      tag_name :: lit
      payload_result :: while { result: {}, remaining: args, state: s } {
        [st]~> if is_empty(st.remaining) {
          { out: { payload: st.result, state: st["state"] } }
        } else {
          do {
            arg :: first_value(st.remaining)
            val_result :: funcs.eval_scheme_(funcs, st["state"], node_idx, arg, incoming)
            new_payload :: if is_obj(val_result.val) {
              merge_obj(val_result.val, st.result)
            } else {
              if val_result.val != null {
                set(st.result, "value", val_result.val)
              } else {
                st.result
              }
            }
            { state: { result: new_payload, remaining: drop(st.remaining, 1), state: val_result["state"] } }
          }
        }
      }
      { val: funcs.make_type(tag_name, payload_result.payload), state: payload_result["state"] }
    },
    "match_type": do {
      value_result :: funcs.eval_scheme_(funcs, s, node_idx, at(args, 0), incoming)
      cases_result :: funcs.eval_scheme_(funcs, value_result["state"], node_idx, at(args, 1), incoming)
      { val: cases_result.val, state: cases_result["state"] }
    },
    "bind": do {
      name :: lit
      val :: if incoming == null { null } else { incoming }
      { val: val, state: tc_bind_result(s, name, val) }
    },
    "result": do {
      name :: lit
      val :: tc_lookup_result(s, name)
      { val: val, state: s }
    },
    "node_payload": do {
      node :: ast_node(s.ast, node_idx)
      { val: node_payload(node), state: s }
    },
    "payload_field": do {
      field :: lit
      node :: ast_node(s.ast, node_idx)
      payload :: node_payload(node)
      { val: get_or(payload, field, null), state: s }
    },
    "json_type_construct": do {
      inc :: incoming
      tag :: match type_of(inc) {
        "num": "type.number",
        "str": "type.string",
        "bool": "type.bool",
        "null": "type.null",
        "arr": "type.array",
        "obj": "type.object",
        _: "type.unknown"
      }
      { val: funcs.make_type(tag, {}), state: s }
    },
    "field": do {
      field_name :: lit
      val_result :: funcs.eval_scheme_(funcs, s, node_idx, first_value(args), incoming)
      { val: set({}, field_name, val_result.val), state: val_result["state"] }
    },
    "make_array": while { result: [], remaining: args, state: s } {
      [st]~> if is_empty(st.remaining) {
        { out: { val: st.result, state: st["state"] } }
      } else {
        do {
          arg :: first_value(st.remaining)
          val_result :: funcs.eval_scheme_(funcs, st["state"], node_idx, arg, incoming)
          { state: { result: [...st.result, val_result.val], remaining: drop(st.remaining, 1), state: val_result["state"] } }
        }
      }
    },
    "type_field": do {
      field_name :: lit
      type_result :: funcs.eval_scheme_(funcs, s, node_idx, first_value(args), incoming)
      { val: get_or(type_result.val, field_name, null), state: type_result["state"] }
    },
    "synth_last_child": do {
      node :: ast_node(s.ast, node_idx)
      children :: node_children(node)
      if is_empty(children) {
        { val: funcs.make_type("type.unit", {}), state: s }
      } else {
        do {
          last_idx :: last(children)
          result :: funcs.synth_node_(funcs, s, last_idx)
          { val: result.typ, state: result["state"] }
        }
      }
    },
    "synth_block": do {
      node :: ast_node(s.ast, node_idx)
      children :: node_children(node)
      if is_empty(children) {
        { val: funcs.make_type("type.unit", {}), state: s }
      } else {
        do {
          last_idx :: last(children)
          block_result :: while { state: s, remaining: take(children, len(children) - 1) } {
            [st]~> if is_empty(st.remaining) {
              { out: st["state"] }
            } else {
              do {
                child_idx :: first_value(st.remaining)
                result :: funcs.synth_node_(funcs, st["state"], child_idx)
                { state: { state: result["state"], remaining: drop(st.remaining, 1) } }
              }
            }
          }
          result :: funcs.synth_node_(funcs, block_result, last_idx)
          { val: result.typ, state: result["state"] }
        }
      }
    },
    "check_block": do {
      node :: ast_node(s.ast, node_idx)
      children :: node_children(node)
      if is_empty(children) {
        { val: null, state: s }
      } else {
        do {
          expected :: if is_empty(args) { incoming } else { eval_first_arg(funcs, s, node_idx, args, incoming).val }
          last_idx :: last(children)
          block_state :: while { state: s, remaining: take(children, len(children) - 1) } {
            [st]~> if is_empty(st.remaining) {
              { out: st["state"] }
            } else {
              do {
                child_idx :: first_value(st.remaining)
                result :: funcs.synth_node_(funcs, st["state"], child_idx)
                { state: { state: result["state"], remaining: drop(st.remaining, 1) } }
              }
            }
          }
          check_result :: funcs.check_node_(funcs, block_state, last_idx, expected)
          { val: null, state: check_result["state"] }
        }
      }
    },
    "check_all_children": do {
      expected :: if is_empty(args) { incoming } else { eval_first_arg(funcs, s, node_idx, args, incoming).val }
      node :: ast_node(s.ast, node_idx)
      children :: node_children(node)
      check_result :: while { state: s, remaining: children } {
        [st]~> if is_empty(st.remaining) {
          { out: { val: null, state: st["state"] } }
        } else {
          do {
            child_idx :: first_value(st.remaining)
            result :: funcs.check_node_(funcs, st["state"], child_idx, expected)
            { state: { state: result["state"], remaining: drop(st.remaining, 1) } }
          }
        }
      }
      { val: null, state: check_result["state"] }
    },
    "synth_match_arms": do {
      node :: ast_node(s.ast, node_idx)
      children :: node_children(node)
      if len(children) < 2 {
        { val: funcs.make_type("type.unknown", {}), state: s }
      } else {
        do {
          scrutinee_idx :: first_value(children)
          scrutinee_result :: funcs.synth_node_(funcs, s, scrutinee_idx)
          scrutinee_type :: scrutinee_result.typ
          s0 :: scrutinee_result["state"]
          --- Optional `return <motive> with` clause: the `motive` role
          --- is declared optional in `ast.match`, so it is present
          --- exactly when the node has 3 children (the grammar splices
          --- it in as the middle child). When present, each arm body is
          --- *checked* against the motive applied at the constructor's
          --- refined result indices, and the match's type is the motive
          --- at the scrutinee's own indices (the dependent motive,
          --- ADR-0120).
          motive_role :: child_role_index(s0, "match", "motive")
          motive_idx :: if motive_role == null || len(children) != 3 { null } else { at(children, motive_role) }
          arms_idx :: last(children)
          arms_node :: ast_node(s0.ast, arms_idx)
          arms :: node_children(arms_node)
          scrut_term :: funcs.node_term_(funcs, s0, scrutinee_idx)
          --- The scrutinee's own index terms — for the
          --- motive-applied result type. `ok: false` when the
          --- scrutinee is not a family application.
          scrut_idx :: if type_tag(scrutinee_type) == "type.family_app" {
            do {
              ev :: while { state: s0, vals: [], remaining: get_or(scrutinee_type, "args", []) } {
                [w]~> if is_empty(w.remaining) {
                  { out: { vals: w.vals, state: w["state"] } }
                } else {
                  do {
                    e :: funcs.eval_term_(funcs, w["state"], zonk(zonk, first_value(w.remaining), w["state"].metas))
                    { state: { vals: [...w.vals, e.val], state: e["state"], remaining: drop(w.remaining, 1) } }
                  }
                }
              }
              { vals: ev.vals, state: ev["state"], ok: true }
            }
          } else {
            { vals: [], state: s0, ok: false }
          }
          s0 :: scrut_idx["state"]
          if is_empty(arms) {
            { val: funcs.make_type("type.unknown", {}), state: s0 }
          } else {
            do {
              arms_result :: while { state: s0, result: null, failed: false, remaining: arms } {
                [st]~> if is_empty(st.remaining) {
                  { out: { typ: st.result, state: st["state"] } }
                } else {
                  do {
                    arm_idx :: first_value(st.remaining)
                    arm_node :: ast_node(st["state"].ast, arm_idx)
                    arm_children :: node_children(arm_node)
                    pattern_idx :: first_value(arm_children)
                    body_idx :: at(arm_children, 1)
                    --- `impossible` auto-discharges the arm — its body
                    --- is skipped with no diagnostic (coverage never
                    --- required it). `absurd` remains legal
                    --- documentation of the dead branch; `absurd` on a
                    --- reachable OR merely-stuck arm is rejected below
                    --- ("absurd arm is reachable").
                    body_node :: ast_node(st["state"].ast, body_idx)
                    is_absurd :: node_kind(body_node) == "absurd"
                    mark :: tc_mark(st["state"])
                    metas_mark :: get_or(st["state"], "metas", [null])
                    old_results :: get_or(st["state"], "results", {})
                    --- Dependent elimination (ADR-0120): the
                    --- constructor's instantiated result type is
                    --- unified with the scrutinee's *inside this
                    --- branch* — `?n + 1 ≡ 2` solves `?n := 1`, and a
                    --- rigid `var{n}` index binds `n` to the
                    --- constructor's index in `results` (witnessed by
                    --- a `Path` under `eq_n`). A decided index
                    --- mismatch auto-discharges the arm: its body
                    --- is skipped and it contributes nothing to the
                    --- join.
                    scrut_ids :: concat(meta_ids_in_(meta_ids_in_, scrutinee_type, []), meta_ids_in_(meta_ids_in_, zonk(zonk, scrutinee_type, metas_mark), []))
                    pat_res :: collect_pattern_bindings(funcs, st["state"], pattern_idx, scrutinee_type)
                    bindings :: pat_res.bindings
                    ctor_result :: get_or(pat_res, "ctor_result", null)
                    refined :: refine_scrutinee_(funcs, pat_res["state"], scrutinee_type, ctor_result, is_absurd)
                    extended :: while { state: refined["state"], remaining: bindings } {
                      [est]~> if is_empty(est.remaining) {
                        { out: est["state"] }
                      } else {
                        do {
                          entry :: first_value(est.remaining)
                          next_state :: tc_extend(est["state"], get_or(entry, "name", ""), get_or(entry, "type", funcs.make_type("type.unknown", {})))
                          { state: { state: next_state, remaining: drop(est.remaining, 1) } }
                        }
                      }
                    }
                    body_out :: if refined.impossible {
                      { typ: null, state: extended }
                    } else {
                      if is_absurd {
                        --- `absurd` claims decided unsatisfiability; a
                        --- reachable (or merely stuck) branch does not
                        --- justify it — the body is skipped and the
                        --- claim rejected.
                        { typ: null, state: tc_add_diagnostic(extended, "error", "match arm marked absurd is reachable — its index equations are not decided-unsatisfiable") }
                      } else {
                        if motive_idx == null {
                          do {
                            r :: funcs.synth_node_(funcs, extended, body_idx)
                            { typ: r.typ, state: r["state"] }
                          }
                        } else {
                          do {
                            m_res :: apply_motive_(funcs, extended, motive_idx, concat(refined.idx_args, [scrut_term]))
                            chk :: funcs.check_node_(funcs, m_res["state"], body_idx, m_res.val)
                            { typ: m_res.val, state: chk["state"] }
                          }
                        }
                      }
                    }
                    --- Branch-local environment: gamma and `results`
                    --- restore wholesale (pattern binders and the
                    --- rigid-index rewrite are branch-local); the
                    --- scrutinee's metavariables unsolve back to
                    --- their pre-arm solutions so sibling arms
                    --- re-derive the refinement — metas minted
                    --- inside the arm keep their slots, so the arm's
                    --- own pattern types stay precise.
                    restored :: if type_tag(ctor_result) == "type.family_app" {
                      set(set(tc_restore(body_out["state"], mark), "results", old_results), "metas", metas_restore_ids_(get_or(body_out["state"], "metas", [null]), metas_mark, scrut_ids))
                    } else {
                      tc_restore(body_out["state"], mark)
                    }
                    pat_node :: ast_node(st["state"].ast, pattern_idx)
                    pat_kind :: node_kind(pat_node)
                    pat_name :: if pat_kind == "var" {
                      do {
                        pp :: node_payload(pat_node)
                        if type_of(pp) == "str" { pp } else { get_or(pp, "name", "") }
                      }
                    } else {
                      ""
                    }
                    --- A `var` that names a `data` constructor is a
                    --- nullary ctor pattern, not a catchall — `Zero` in
                    --- `match n { Zero: …, Succ(p): … }` must not
                    --- terminate arm unification.
                    is_catchall :: pat_kind == "var" && type_tag(tc_lookup(st["state"], pat_name)) != "type.ctor_sig"
                    next :: if refined.impossible || body_out.typ == null {
                      { result: st.result, failed: st.failed, state: restored }
                    } else {
                      if is_catchall {
                        { result: body_out.typ, failed: true, state: restored }
                      } else {
                        if st.result == null {
                          { result: body_out.typ, failed: st.failed, state: restored }
                        } else {
                          if st.failed {
                            { result: st.result, failed: st.failed, state: restored }
                          } else {
                            do {
                              u :: funcs.unify_dependent_(funcs, st.result, body_out.typ, restored)
                              if u.ok {
                                { result: st.result, failed: st.failed, state: u["state"] }
                              } else {
                                { result: funcs.make_type("type.unknown", {}), failed: true, state: tc_add_diagnostic(u["state"], "warning", "match arm type mismatch") }
                              }
                            }
                          }
                        }
                      }
                    }
                    { state: { state: next["state"], result: next["result"], failed: next["failed"], remaining: drop(st.remaining, 1) } }
                  }
                }
              }
              if arms_result.typ == null {
                { val: funcs.make_type("type.unknown", {}), state: arms_result["state"] }
              } else {
                if motive_idx == null || !scrut_idx.ok {
                  { val: arms_result.typ, state: arms_result["state"] }
                } else {
                  do {
                    --- The match's type is the motive at the
                    --- scrutinee's own indices (`Vec(n, Bool)`), not
                    --- at any one branch's refinement.
                    applied :: apply_motive_(funcs, arms_result["state"], motive_idx, concat(scrut_idx.vals, [scrut_term]))
                    { val: applied.val, state: applied["state"] }
                  }
                }
              }
            }
          }
        }
      }
    },
    "synth_rec": do {
      node :: ast_node(s.ast, node_idx)
      children :: node_children(node)
      if is_empty(children) {
        { val: funcs.make_type("type.unit", {}), state: s }
      } else {
        do {
          last_idx :: last(children)
          result :: funcs.synth_node_(funcs, s, last_idx)
          { val: result.typ, state: result["state"] }
        }
      }
    },
    "synth_function": do {
      s_orig :: s
      s :: tc_sanitize(s)
      node :: ast_node(s.ast, node_idx)
      kind :: node_kind(node)
      if kind != "function" {
        do {
          diagnostic_payload :: set(set(set(set({}, "synth_function_kind", kind), "synth_function_s_type", type_of(s_orig)), "synth_function_s_tag", type_tag(s_orig)), "synth_function_node_idx", node_idx)
          { val: funcs.make_type("type.unknown", diagnostic_payload), state: tc_add_diagnostic(s, "error", "synth_function called for kind: " + kind) }
        }
      } else {
        do {
          children :: node_children(node)
          payload :: node_payload(node)
          payload_params :: get_or(payload, "params", null)
          payload_body :: get_or(payload, "body", null)
          use_payload :: len(children) < 2 && type_of(payload_params) == "arr" && type_of(payload_body) == "num"
          if len(children) < 2 && !use_payload {
            { val: funcs.make_type("type.unknown", {}), state: tc_add_diagnostic(s, "error", "function needs params and body") }
          } else {
            do {
              params_node :: if use_payload { null } else { ast_node(s.ast, at(children, 0)) }
              params_kind :: if use_payload { "" } else { node_kind(params_node) }
              param_children :: if use_payload { [] } else { if params_kind == "paren" { node_children(params_node) } else { [at(children, 0)] } }
              param_items :: if use_payload { payload_params } else { param_children }
              body_idx :: if use_payload { payload_body } else { at(children, 1) }
              params_info :: while { result: [], remaining: param_items, state: s } {
                [st]~> if is_empty(st.remaining) {
                  { out: { params: st.result, state: st["state"] } }
                } else {
                  do {
                    p_item :: first_value(st.remaining)
                    p_idx :: if type_of(p_item) == "str" { null } else { p_item }
                    p_node :: if p_idx == null { null } else { ast_node(st["state"].ast, p_idx) }
                    p_kind :: if p_idx == null { "var" } else { node_kind(p_node) }
                    p_payload :: if p_idx == null { p_item } else { node_payload(p_node) }
                    p_name :: if p_kind == "var" {
                      if type_of(p_payload) == "str" { p_payload } else { get_or(p_payload, "name", "") }
                    } else {
                      if p_kind == "type-annot" {
                        do {
                          p_subject_role :: child_role_index(st["state"], p_kind, "subject")
                          if p_subject_role == null {
                            ""
                          } else {
                            do {
                              p_subject_node :: ast_node(st["state"].ast, child_ref(st["state"].ast, p_idx, p_subject_role))
                              p_subject_payload :: node_payload(p_subject_node)
                              if type_of(p_subject_payload) == "str" { p_subject_payload } else { get_or(p_subject_payload, "name", "") }
                            }
                          }
                        }
                      } else {
                        ""
                      }
                    }
                    p_meta :: tc_fresh_meta(st["state"])
                    p_state :: if p_name != "" { tc_extend(p_meta["state"], p_name, meta_value(p_meta.id)) } else { p_meta["state"] }
                    { state: { result: [...st.result, {name: p_name, meta: meta_value(p_meta.id)}], remaining: drop(st.remaining, 1), state: p_state } }
                  }
                }
              }
              body_result :: funcs.synth_node_(funcs, params_info["state"], body_idx)
              fn_type :: while { idx: len(params_info.params), body: body_result.typ, state: body_result["state"] } {
                [st]~> if st.idx == 0 {
                  { out: st.body }
                } else {
                  do {
                    p :: at(params_info.params, st.idx - 1)
                    zonked_param :: zonk(zonk, p.meta, st.state.metas)
                    new_body :: funcs.make_type("type.function", set(set(set({}, "param", zonked_param), "body", st.body), "param_name", p.name))
                    { state: { idx: st.idx - 1, body: new_body, state: st.state } }
                  }
                }
              }
              { val: fn_type, state: body_result["state"] }
            }
          }
        }
      }
    },
    "synth_type_annot": do {
      node :: ast_node(s.ast, node_idx)
      children :: node_children(node)
      if len(children) < 2 {
        { val: funcs.make_type("type.unknown", {}), state: s }
      } else {
        do {
          expr_idx :: first_value(children)
          annot_idx :: at(children, 1)
          expr_result :: funcs.synth_node_(funcs, s, expr_idx)
          ann :: funcs.synth_type_(funcs, expr_result["state"], annot_idx)
          --- Field projections stay symbolic post-Phase-1: `type.F`
          --- evaluates to `RecordProj{record: "type", field: F}` rather
          --- than the `type.F` record. Resolve the projection here.
          ann_tag :: type_tag(ann.val)
          rec_term :: get_or(ann.val, "record", null)
          rec_name :: if type_of(rec_term) == "str" { rec_term } else { if type_tag(rec_term) == "Const" { get_or(rec_term, "value", "") } else { if type_tag(rec_term) == "var" { get_or(rec_term, "name", "") } else { "" } } }
          is_type_proj :: ann_tag == "RecordProj" && rec_name == "type"
          ann_resolved :: if is_type_proj { funcs.make_type("type." + get_or(ann.val, "field", ""), {}) } else { ann.val }
          if funcs.is_applicable_(funcs, ann_resolved) {
            --- Predicate annotation (ADR-0068 graduated guarantees):
            --- `v : P` where `P` is an arrow applies `P(v)`. Proven
            --- accepts silently; symbolic (Blocked) accepts with a
            --- `runtime_assert` warning so the eval pipeline rewrites
            --- the node to a runtime check; refuted is a hard error.
            do {
              eval_result :: funcs.eval_node_(funcs, ann["state"], expr_idx)
              applied :: funcs.apply_val_(funcs, eval_result["state"], ann_resolved, [eval_result.val])
              if applied.val == false {
                { val: expr_result.typ, state: tc_add_diagnostic(applied["state"], "error", "type annotation mismatch: value does not satisfy the predicate") }
              } else {
                undecidable :: applied.val == null || type_tag(applied.val) != ""
                if undecidable {
                  { val: expr_result.typ, state: tc_add_diagnostic(applied["state"], "warning", "runtime_assert: predicate is symbolic — deferred to runtime") }
                } else {
                  { val: expr_result.typ, state: applied["state"] }
                }
              }
            }
          } else {
            do {
              --- `unify_dependent_` (not shallow `unify`) so indexed
              --- annotations get index-term normalization — `v : Vec(2)`
              --- accepts a `Vec(1 + 1)` synthesized type.
              unify_result :: funcs.unify_dependent_(funcs, expr_result.typ, ann_resolved, ann["state"])
              if unify_result.ok {
                { val: ann_resolved, state: unify_result["state"] }
              } else {
                { val: ann_resolved, state: tc_add_diagnostic(unify_result["state"], "error", "type annotation mismatch: expected " + type_tag(ann_resolved) + ", got " + type_tag(expr_result.typ)) }
              }
            }
          }
        }
      }
    },
    "synth_first_child_or_unknown": do {
      node :: ast_node(s.ast, node_idx)
      children :: node_children(node)
      if is_empty(children) {
        { val: funcs.make_type("type.unknown", {}), state: s }
      } else {
        do {
          first_idx :: first_value(children)
          result :: funcs.synth_node_(funcs, s, first_idx)
          { val: result.typ, state: result["state"] }
        }
      }
    },
    "record_field_type": do {
      field_value :: if lit != null { lit } else { incoming }
      container_result :: funcs.eval_scheme_(funcs, s, node_idx, first_value(args), incoming)
      container :: container_result.val
      if type_tag(container) == "type.array" {
        { val: get_or(container, "element", null), state: container_result["state"] }
      } else {
        do {
          field_name :: field_value
          fields :: get_or(container, "fields", {})
          { val: get_or(fields, field_name, null), state: container_result["state"] }
        }
      }
    },
    "array_element_type": do {
      array_type :: if is_empty(args) { incoming } else { eval_first_arg(funcs, s, node_idx, args, incoming).val }
      { val: get_or(array_type, "element", null), state: s }
    },
    "synth_object_record": do {
      node :: ast_node(s.ast, node_idx)
      children :: node_children(node)
      collected :: while { result: {}, remaining: children, state: s } {
        [st]~> if is_empty(st.remaining) {
          { out: { fields: st.result, state: st["state"] } }
        } else {
          do {
            entry_idx :: first_value(st.remaining)
            entry :: ast_node(s.ast, entry_idx)
            entry_children :: node_children(entry)
            key_node :: ast_node(s.ast, first_value(entry_children))
            key_payload :: node_payload(key_node)
            key_kind :: node_kind(key_node)
            key :: if type_of(key_payload) == "str" { key_payload } else { get_or(key_payload, "name", get_or(key_payload, "value", "")) }
            value_idx :: at(entry_children, 1)
            value_result :: funcs.synth_node_(funcs, st["state"], value_idx)
            { state: { result: funcs.set(st.result, key, value_result.typ), remaining: drop(st.remaining, 1), state: value_result["state"] } }
          }
        }
      }
      { val: funcs.make_type("type.record", funcs.set({}, "fields", collected["fields"])), state: collected["state"] }
    },
    "check_object_record": do {
      expected :: if is_empty(args) { incoming } else { eval_first_arg(funcs, s, node_idx, args, incoming).val }
      { val: null, state: s }
    },
    "construct_pi": do {
      var_name :: if lit != null { lit } else { "x" }
      param :: if is_empty(args) { incoming } else { eval_first_arg(funcs, s, node_idx, args, incoming).val }
      body_child_idx :: child_ref(s.ast, node_idx, 1)
      closure :: set(set({}, "var_name", var_name), "body_child_idx", body_child_idx)
      payload :: set(set({}, "param", param), "body_closure", closure)
      { val: funcs.make_type("type.pi", payload), state: s }
    },
    "pi_apply": do {
      pi_result :: funcs.eval_scheme_(funcs, s, node_idx, first_value(args), incoming)
      pi_val :: pi_result.val
      arg_type_result :: eval_arg_type(funcs, pi_result["state"], node_idx, args, incoming)
      body_result :: apply_type_closure(funcs, pi_val, arg_type_result.val, arg_type_result["state"])
      { val: body_result.val, state: body_result["state"] }
    },
    "unify_pi": do {
      pi_a_result :: funcs.eval_scheme_(funcs, s, node_idx, at(args, 0), incoming)
      pi_b_result :: funcs.eval_scheme_(funcs, pi_a_result["state"], node_idx, at(args, 1), incoming)
      param_a :: get_or(pi_a_result.val, "param", null)
      param_b :: get_or(pi_b_result.val, "param", null)
      unify_param :: unify(funcs, param_a, param_b, pi_b_result["state"].metas)
      if unify_param.ok {
        do {
          fresh_state :: set(pi_b_result["state"], "metas", unify_param.metas)
          fresh :: tc_fresh_meta(fresh_state)
          body_a :: apply_type_closure(funcs, pi_a_result.val, meta_value(fresh.id), fresh["state"])
          body_b :: apply_type_closure(funcs, pi_b_result.val, meta_value(fresh.id), body_a["state"])
          unify_body :: unify(funcs, body_a.val, body_b.val, body_b["state"].metas)
          if unify_body.ok {
            { val: null, state: set(body_b["state"], "metas", unify_body.metas) }
          } else {
            { val: null, state: tc_add_diagnostic(body_b["state"], "error", "unify_pi: body unification failed") }
          }
        }
      } else {
        { val: null, state: tc_add_diagnostic(pi_b_result["state"], "error", "unify_pi: param unification failed") }
      }
    },
    "check_pi_body": do {
      pi_result :: funcs.eval_scheme_(funcs, s, node_idx, first_value(args), incoming)
      pi_val :: pi_result.val
      param_type :: get_or(pi_val, "param", null)
      closure :: get_or(pi_val, "body_closure", {})
      var_name :: get_or(closure, "var_name", "x")
      mark :: tc_mark(pi_result["state"])
      extended :: tc_extend(pi_result["state"], var_name, param_type)
      expected_body :: apply_type_closure(funcs, pi_val, param_type, extended)
      body_child_idx :: child_ref(s.ast, node_idx, 1)
      check_result :: funcs.check_node_(funcs, expected_body["state"], body_child_idx, expected_body.val)
      restored :: tc_restore(check_result["state"], mark)
      { val: null, state: restored }
    },
    "construct_sigma": do {
      var_name :: if lit != null { lit } else { "x" }
      param :: if is_empty(args) { incoming } else { eval_first_arg(funcs, s, node_idx, args, incoming).val }
      body_child_idx :: child_ref(s.ast, node_idx, 1)
      closure :: set(set({}, "var_name", var_name), "body_child_idx", body_child_idx)
      payload :: set(set({}, "param", param), "body_closure", closure)
      { val: funcs.make_type("type.sigma", payload), state: s }
    },
    "construct_forall": do {
      var_name :: if lit != null { lit } else { "x" }
      kind :: if is_empty(args) { incoming } else { eval_first_arg(funcs, s, node_idx, args, incoming).val }
      body_child_idx :: child_ref(s.ast, node_idx, 1)
      closure :: set(set({}, "var_name", var_name), "body_child_idx", body_child_idx)
      payload :: set(set({}, "kind", kind), "body_closure", closure)
      { val: funcs.make_type("type.forall", payload), state: s }
    },
    --- `construct_family` — mint `type.family{base}` from a `family`
    --- node (single child: the index/base type expression). Mirrors the
    --- `Family(A)` surface former in `synth_dep_former_` for the internal
    --- `family` node kind.
    "construct_family": do {
      base :: if is_empty(args) { incoming } else { eval_first_arg(funcs, s, node_idx, args, incoming).val }
      { val: funcs.make_type("type.family", set({}, "base", base)), state: s }
    },
    "forall_apply": do {
      forall_result :: funcs.eval_scheme_(funcs, s, node_idx, first_value(args), incoming)
      forall_val :: forall_result.val
      arg_type_result :: eval_arg_type(funcs, forall_result["state"], node_idx, args, incoming)
      body_result :: apply_type_closure(funcs, forall_val, arg_type_result.val, arg_type_result["state"])
      { val: body_result.val, state: body_result["state"] }
    },
    "unify_forall": do {
      fa_a_result :: funcs.eval_scheme_(funcs, s, node_idx, at(args, 0), incoming)
      fa_b_result :: funcs.eval_scheme_(funcs, fa_a_result["state"], node_idx, at(args, 1), incoming)
      kind_a :: get_or(fa_a_result.val, "kind", null)
      kind_b :: get_or(fa_b_result.val, "kind", null)
      unify_kind :: unify(funcs, kind_a, kind_b, fa_b_result["state"].metas)
      if unify_kind.ok {
        do {
          fresh_state :: set(fa_b_result["state"], "metas", unify_kind.metas)
          fresh :: tc_fresh_meta(fresh_state)
          body_a :: apply_type_closure(funcs, fa_a_result.val, meta_value(fresh.id), fresh["state"])
          body_b :: apply_type_closure(funcs, fa_b_result.val, meta_value(fresh.id), body_a["state"])
          unify_body :: unify(funcs, body_a.val, body_b.val, body_b["state"].metas)
          if unify_body.ok {
            { val: null, state: set(body_b["state"], "metas", unify_body.metas) }
          } else {
            { val: null, state: tc_add_diagnostic(body_b["state"], "error", "unify_forall: body unification failed") }
          }
        }
      } else {
        { val: null, state: tc_add_diagnostic(fa_b_result["state"], "error", "unify_forall: kind unification failed") }
      }
    },
    "construct_vau": { val: funcs.make_type("type.vau", {}), state: s },
    "vau_apply": do {
      vau_result :: funcs.eval_scheme_(funcs, s, node_idx, first_value(args), incoming)
      { val: vau_result.val, state: vau_result["state"] }
    },
    "unify_vau": do {
      vau_a_result :: funcs.eval_scheme_(funcs, s, node_idx, at(args, 0), incoming)
      vau_b_result :: funcs.eval_scheme_(funcs, vau_a_result["state"], node_idx, at(args, 1), incoming)
      param_a :: get_or(vau_a_result.val, "param", null)
      param_b :: get_or(vau_b_result.val, "param", null)
      unify_param :: unify(funcs, param_a, param_b, vau_b_result["state"].metas)
      if unify_param.ok {
        do {
          fresh_state :: set(vau_b_result["state"], "metas", unify_param.metas)
          fresh :: tc_fresh_meta(fresh_state)
          body_a :: apply_type_closure(funcs, vau_a_result.val, meta_value(fresh.id), fresh["state"])
          body_b :: apply_type_closure(funcs, vau_b_result.val, meta_value(fresh.id), body_a["state"])
          unify_body :: unify(funcs, body_a.val, body_b.val, body_b["state"].metas)
          if unify_body.ok {
            { val: null, state: set(body_b["state"], "metas", unify_body.metas) }
          } else {
            { val: null, state: tc_add_diagnostic(body_b["state"], "error", "unify_vau: body unification failed") }
          }
        }
      } else {
        { val: null, state: tc_add_diagnostic(vau_b_result["state"], "error", "unify_vau: param unification failed") }
      }
    },
    "construct_eq": do {
      left_result :: funcs.eval_scheme_(funcs, s, node_idx, at(args, 0), incoming)
      right_result :: funcs.eval_scheme_(funcs, left_result["state"], node_idx, at(args, 1), incoming)
      payload :: set(set({}, "left", left_result.val), "right", right_result.val)
      { val: funcs.make_type("type.eq", payload), state: right_result["state"] }
    },
    "construct_empty": { val: funcs.make_type("type.empty", {}), state: s },
    "check_refl": do {
      expected :: if is_empty(args) { incoming } else { eval_first_arg(funcs, s, node_idx, args, incoming).val }
      lhs :: get_or(expected, "left", null)
      rhs :: get_or(expected, "right", null)
      if lhs == rhs {
        { val: null, state: s }
      } else {
        { val: null, state: tc_add_diagnostic(s, "error", "check_refl: cannot prove equality") }
      }
    },
    "eq_reduce": do {
      eq_val :: if is_empty(args) { incoming } else { eval_first_arg(funcs, s, node_idx, args, incoming).val }
      lhs :: get_or(eq_val, "left", null)
      rhs :: get_or(eq_val, "right", null)
      if lhs == rhs {
        { val: funcs.make_type("type.refl", {}), state: s }
      } else {
        { val: funcs.make_type("type.empty", {}), state: s }
      }
    },
    --- `p # v` — transport along a `Path` 2-cell (ADR-0120). A real
    --- `transport` node dispatches here by kind: its `value` child role
    --- makes `synth_node_impl_` route it through the canonical path
    --- with `op_name == "transport"`. The `type.transport` type rule's
    --- `synth_transport` op name hits the same arm for completeness.
    "transport": synth_transport_(funcs, s, node_idx),
    "synth_transport": synth_transport_(funcs, s, node_idx),
    --- `j p, P, base` — the J eliminator for `Path` 2-cells
    --- (ADR-0120). `j` nodes are not canonical, so they reach here via
    --- the `type.j` rule's `synth_j` op.
    "synth_j": synth_j_(funcs, s, node_idx),
    "j": synth_j_(funcs, s, node_idx),
    "construct_universe": do {
      level :: if lit != null { lit } else { if is_empty(args) { 0 } else { eval_first_arg(funcs, s, node_idx, args, incoming).val } }
      { val: funcs.make_type("type.universe", set({}, "level", level)), state: s }
    },
    "universe_level": do {
      type_val :: if is_empty(args) { incoming } else { eval_first_arg(funcs, s, node_idx, args, incoming).val }
      if type_tag(type_val) == "type.universe" {
        { val: get_or(type_val, "level", 0), state: s }
      } else {
        { val: 0, state: s }
      }
    },
    "universe_max": do {
      level_a_result :: funcs.eval_scheme_(funcs, s, node_idx, at(args, 0), incoming)
      level_b_result :: funcs.eval_scheme_(funcs, level_a_result["state"], node_idx, at(args, 1), incoming)
      max_level :: if level_a_result.val > level_b_result.val { level_a_result.val } else { level_b_result.val }
      { val: max_level, state: level_b_result["state"] }
    },
    "construct_membership": do {
      value_result :: funcs.eval_scheme_(funcs, s, node_idx, at(args, 0), incoming)
      collection_result :: funcs.eval_scheme_(funcs, value_result["state"], node_idx, at(args, 1), incoming)
      payload :: set(set({}, "value", value_result.val), "collection", collection_result.val)
      { val: funcs.make_type("type.membership", payload), state: collection_result["state"] }
    },
    "check_membership": do {
      value :: if is_empty(args) { incoming } else { eval_first_arg(funcs, s, node_idx, args, incoming).val }
      collection :: if len(args) > 1 {
        eval_arg_at(funcs, s, node_idx, args, incoming, 1).val
      } else {
        if lit != null { funcs.make_type(lit, {}) } else { null }
      }
      col_tag :: type_tag(collection)
      is_member :: match col_tag {
        "type.number": type_of(value) == "num",
        "type.string": type_of(value) == "str",
        "type.bool": type_of(value) == "bool",
        "type.null": type_of(value) == "null",
        "type.array": type_of(value) == "arr",
        "type.object": type_of(value) == "obj",
        _: false
      }
      if is_member {
        { val: funcs.make_type("type.is_evidence", {}), state: s }
      } else {
        { val: funcs.make_type("type.empty", {}), state: s }
      }
    },
    "eval_membership": do {
      membership_val :: if is_empty(args) { incoming } else { eval_first_arg(funcs, s, node_idx, args, incoming).val }
      value :: get_or(membership_val, "value", null)
      collection :: get_or(membership_val, "collection", null)
      col_tag :: type_tag(collection)
      is_member :: match col_tag {
        "type.number": type_of(value) == "num",
        "type.string": type_of(value) == "str",
        "type.bool": type_of(value) == "bool",
        "type.null": type_of(value) == "null",
        "type.array": type_of(value) == "arr",
        "type.object": type_of(value) == "obj",
        _: false
      }
      if is_member {
        { val: funcs.make_type("type.is_evidence", {}), state: s }
      } else {
        { val: funcs.make_type("type.empty", {}), state: s }
      }
    },
    "construct_collection": do {
      name :: lit
      { val: funcs.make_type("type.collection", set({}, "name", name)), state: s }
    },
    "marshalable": do {
      ty :: incoming
      tag :: type_tag(ty)
      is_marshal :: match tag {
        "type.cstr": true,
        "type.i32": true,
        "type.i64": true,
        "type.f64": true,
        "type.buf": true,
        "type.ptr": true,
        "type.void": true,
        "type.handle": true,
        _: false
      }
      if is_marshal {
        { val: true, state: s }
      } else {
        { val: false, state: tc_add_diagnostic(s, "error", "type is not FFI-marshalable: " + tag) }
      }
    },
    "block": do {
      node :: ast_node(s.ast, node_idx)
      children :: node_children(node)
      if is_empty(children) {
        { val: funcs.make_type("type.unit", {}), state: s }
      } else {
        do {
          last_idx :: last(children)
          prefix_len :: len(children) - 1
          prefix :: take(children, prefix_len)
          prefix_state :: while { state: s, remaining: prefix } {
            [st]~> if is_empty(st.remaining) {
              { out: st["state"] }
            } else {
              do {
                child_idx :: first_value(st.remaining)
                step :: funcs.synth_node_(funcs, st["state"], child_idx)
                { state: { state: step["state"], remaining: drop(st.remaining, 1) } }
              }
            }
          }
          result :: funcs.synth_node_(funcs, prefix_state, last_idx)
          { val: result.typ, state: result["state"] }
        }
      }
    },
    "assign": do {
      target_idx :: child_role_index(s, kind, "target")
      value_idx :: child_role_index(s, kind, "value")
      if target_idx == null || value_idx == null {
        { val: funcs.make_type("type.unknown", {}), state: tc_add_diagnostic(s, "error", "assign: missing target or value role") }
      } else {
        do {
          target_node_idx :: child_ref(s.ast, node_idx, target_idx)
          target_node :: ast_node(s.ast, target_node_idx)
          target_kind :: node_kind(target_node)
          target_payload :: node_payload(target_node)
          value_node_idx :: child_ref(s.ast, node_idx, value_idx)
          target_name :: if target_kind == "var" {
            if type_of(target_payload) == "str" { target_payload } else { get_or(target_payload, "name", "") }
          } else {
            if target_kind == "type-annot" {
              do {
                subject_role :: child_role_index(s, target_kind, "subject")
                if subject_role == null {
                  ""
                } else {
                  do {
                    subject_node :: ast_node(s.ast, child_ref(s.ast, target_node_idx, subject_role))
                    subject_payload :: node_payload(subject_node)
                    if type_of(subject_payload) == "str" { subject_payload } else { get_or(subject_payload, "name", "") }
                  }
                }
              }
            } else {
              ""
            }
          }
          if target_name == "" {
            { val: funcs.make_type("type.unit", {}), state: tc_add_diagnostic(s, "warning", "assign: could not determine target name") }
          } else {
            if target_kind == "type-annot" {
              do {
                annot_role :: child_role_index(s, target_kind, "annot")
                if annot_role == null {
                  do {
                    value_result :: funcs.synth_node_(funcs, s, value_node_idx)
                    extended :: tc_extend(value_result["state"], target_name, value_result.typ)
                    bound :: tc_bind_result(extended, target_name, funcs.node_term_(funcs, s, value_node_idx))
                    { val: funcs.make_type("type.unit", {}), state: bound }
                  }
                } else {
                  do {
                    annot_idx :: child_ref(s.ast, target_node_idx, annot_role)
                    ann :: funcs.synth_type_(funcs, s, annot_idx)
                    check_result :: funcs.check_node_(funcs, ann["state"], value_node_idx, ann.val)
                    if check_result.ok {
                      do {
                        extended :: tc_extend(check_result["state"], target_name, ann.val)
                        bound :: tc_bind_result(extended, target_name, funcs.node_term_(funcs, s, value_node_idx))
                        { val: funcs.make_type("type.unit", {}), state: bound }
                      }
                    } else {
                      { val: funcs.make_type("type.unit", {}), state: tc_add_diagnostic(check_result["state"], "error", "assign: type annotation mismatch for " + target_name) }
                    }
                  }
                }
              }
            } else {
              do {
                value_result :: funcs.synth_node_(funcs, s, value_node_idx)
                extended :: tc_extend(value_result["state"], target_name, value_result.typ)
                bound :: tc_bind_result(extended, target_name, funcs.node_term_(funcs, s, value_node_idx))
                { val: funcs.make_type("type.unit", {}), state: bound }
              }
            }
          }
        }
      }
    },
    "if": do {
      cond_idx :: child_role_index(s, kind, "condition")
      then_idx :: child_role_index(s, kind, "then")
      else_idx :: child_role_index(s, kind, "else")
      if cond_idx == null || then_idx == null {
        { val: funcs.make_type("type.unknown", {}), state: funcs.add_diagnostic(s, "error", "if: missing condition or then role") }
      } else {
        do {
          cond_result :: funcs.synth_node_(funcs, s, child_ref(s.ast, node_idx, cond_idx))
          cond_unify :: unify(funcs, cond_result.typ, funcs.make_type("type.bool", {}), funcs.sanitize(cond_result["state"]).metas)
          cond_state :: if cond_unify.ok {
            funcs.set(funcs.sanitize(cond_result["state"]), "metas", cond_unify.metas)
          } else {
            funcs.add_diagnostic(funcs.sanitize(cond_result["state"]), "error", "if: condition is not boolean")
          }
          then_result :: funcs.synth_node_(funcs, cond_state, child_ref(s.ast, node_idx, then_idx))
          then_state :: funcs.sanitize(then_result["state"])
          else_result :: if else_idx == null {
            { typ: then_result.typ, state: then_state }
          } else {
            do {
              r :: funcs.synth_node_(funcs, then_state, child_ref(s.ast, node_idx, else_idx))
              { typ: r.typ, state: funcs.sanitize(r["state"]) }
            }
          }
          else_state :: funcs.sanitize(else_result["state"])
          --- Branch join goes through `unify_dependent_` so family
          --- applications compare index terms with normalization, not
          --- shallow field equality.
          unified :: funcs.unify_dependent_(funcs, then_result.typ, else_result.typ, else_state)
          if unified.ok {
            { val: then_result.typ, state: unified["state"] }
          } else {
            { val: funcs.make_type("type.unknown", {}), state: funcs.add_diagnostic(unified["state"], "error", "if: then and else branches do not unify") }
          }
        }
      }
    },
    "return": do {
      value_idx :: child_role_index(s, kind, "value")
      if value_idx == null {
        { val: funcs.make_type("type.unit", {}), state: tc_add_diagnostic(s, "error", "return: missing value role") }
      } else {
        do {
          result :: funcs.synth_node_(funcs, s, child_ref(s.ast, node_idx, value_idx))
          { val: result.typ, state: result["state"] }
        }
      }
    },
    "call": do {
      callee_idx :: child_role_index(s, kind, "callee")
      args_idx :: child_role_index(s, kind, "args")
      if callee_idx == null || args_idx == null {
        { val: funcs.make_type("type.unknown", {}), state: tc_add_diagnostic(s, "error", "call: missing callee or args role") }
      } else {
        do {
          node :: ast_node(s.ast, node_idx)
          children :: node_children(node)
          callee_result :: funcs.synth_node_(funcs, s, child_ref(s.ast, node_idx, callee_idx))
          call_state :: while { current: callee_result.typ, state: callee_result["state"], idx: args_idx } {
            [st]~> if st.idx >= len(children) {
              { out: { current: st["current"], state: st["state"] } }
            } else {
              do {
              cur_tag :: type_tag(st["current"])
              if cur_tag == "type.pi" || cur_tag == "type.forall" {
                --- Dependent application (ADR-0120 Phase 4): `f(a)` with
                --- `f : Π (x:A). B(x)` checks `a : A` and yields `B(a)`
                --- — the body closure is applied with the argument's
                --- term so value-level dependency is preserved.
                do {
                  param :: get_or(st["current"], "param", get_or(st["current"], "kind", null))
                  arg_idx :: at(children, st.idx)
                  arg_check :: funcs.check_node_(funcs, st["state"], arg_idx, param)
                  arg_term :: arg_term_from_node(arg_check["state"], arg_idx)
                  applied :: funcs.apply_dep_closure_(funcs, st["current"], param, arg_term, arg_check["state"])
                  { state: { current: applied.val, state: applied["state"], idx: st.idx + 1 } }
                }
              } else {
              if is_obj(st["current"]) || cur_tag == "type.function" {
                do {
                  param :: get_or(st["current"], "param", null)
                  body :: get_or(st["current"], "body", null)
                  if param == null || body == null {
                    { out: { current: funcs.make_type("type.unknown", {}), state: tc_add_diagnostic(st["state"], "warning", "call: callee is not a function") } }
                  } else {
                    do {
                      arg_idx :: at(children, st.idx)
                      arg_check :: funcs.check_node_(funcs, st["state"], arg_idx, param)
                      param_name :: get_or(st["current"], "param_name", "")
                      arg_term :: arg_term_from_node(arg_check["state"], arg_idx)
                      new_body :: if param_name != "" && arg_term != null {
                        subst_term_(subst_term_, body, param_name, arg_term)
                      } else {
                        body
                      }
                      { state: { current: new_body, state: arg_check["state"], idx: st.idx + 1 } }
                    }
                  }
                }
              } else {
                { out: { current: funcs.make_type("type.unknown", {}), state: tc_add_diagnostic(st["state"], "warning", "call: callee is not a function type") } }
              }
              }
              }
            }
          }
          final_state :: call_state["state"]
          final_typ :: call_state["current"]
          zonked :: zonk(zonk, final_typ, final_state.metas)
          norm :: normalize_type_(normalize_type_, funcs, final_state, zonked)
          { val: norm, state: final_state }
        }
      }
    },
    "field_access": do {
      target_idx :: child_role_index(s, kind, "target")
      field_idx :: child_role_index(s, kind, "field")
      if target_idx == null || field_idx == null {
        { val: funcs.make_type("type.unknown", {}), state: tc_add_diagnostic(s, "error", "field_access: missing target or field role") }
      } else {
        do {
          target_result :: funcs.synth_node_(funcs, s, child_ref(s.ast, node_idx, target_idx))
          field_node :: ast_node(s.ast, child_ref(s.ast, node_idx, field_idx))
          field_payload :: node_payload(field_node)
          field_name :: if type_of(field_payload) == "str" { field_payload } else { get_or(field_payload, "name", "") }
          if field_name == "" {
            { val: funcs.make_type("type.unknown", {}), state: tc_add_diagnostic(target_result["state"], "warning", "field_access: could not determine field name") }
          } else {
            do {
              target_tag :: type_tag(target_result.typ)
              if target_tag == "type.record" {
                do {
                  fields :: get_or(target_result.typ, "fields", {})
                  field_type :: get_or(fields, field_name, null)
                  if field_type == null {
                    { val: funcs.make_type("type.unknown", {}), state: tc_add_diagnostic(target_result["state"], "warning", "field_access: record has no field " + field_name) }
                  } else {
                    { val: field_type, state: target_result["state"] }
                  }
                }
              } else {
                do {
                  fresh :: tc_fresh_meta(target_result["state"])
                  { val: meta_value(fresh.id), state: fresh["state"] }
                }
              }
            }
          }
        }
      }
    },
    "value": do {
      actual :: if is_obj(incoming) { get_or(incoming, "value", incoming) } else { incoming }
      tag :: type_of(actual)
      name :: if tag == "str" { "type.string" } else { if tag == "num" { "type.number" } else { if tag == "bool" { "type.bool" } else { if tag == "null" { "type.null" } else { if tag == "arr" { "type.array" } else { if tag == "obj" { "type.object" } else { "type.unknown" } } } } } }
      { val: funcs.make_type(name, {}), state: s }
    },
    "foreign_type": do {
      op_name :: lit
      { val: funcs.make_type("type.unknown", {}), state: funcs.add_diagnostic(s, "error", "foreign_type: no module registry available for: " + op_name) }
    },
    --- `export` — a module-level `export name := value` is an ordinary
    --- binding whose child is an `assign`: delegate to the same judgment
    --- (which extracts the target name, checks any annotation, and binds
    --- it into gamma). The earlier `take`-shaped special case forced
    --- every export to unify with `List(T,N) -> N -> List(T)` — a demo
    --- path, not a general rule.
    "export": do {
      node :: ast_node(s.ast, node_idx)
      children :: node_children(node)
      if len(children) < 1 {
        { val: funcs.make_type("type.unit", {}), state: tc_add_diagnostic(s, "error", "export: missing value") }
      } else {
        do {
          child_idx :: first_value(children)
          child_node :: ast_node(s.ast, child_idx)
          child_kind :: node_kind(child_node)
          if child_kind != "assign" {
            { val: funcs.make_type("type.unit", {}), state: tc_add_diagnostic(s, "warning", "export: expected an assignment for local export") }
          } else {
            do {
              child_result :: funcs.synth_node_(funcs, s, child_idx)
              { val: funcs.make_type("type.unit", {}), state: child_result["state"] }
            }
          }
        }
      }
    },
    "check_json_value": do {
      node :: ast_node(s.ast, node_idx)
      payload :: node_payload(node)
      actual :: if is_obj(payload) { get_or(payload, "value", payload) } else { payload }
      expected :: incoming
      tag :: type_tag(expected)
      ok :: if is_meta(expected) {
        true
      } else {
        if tag == "type.number" {
          type_of(actual) == "num"
        } else {
          if tag == "type.string" {
            type_of(actual) == "str"
          } else {
            if tag == "type.bool" {
              type_of(actual) == "bool"
            } else {
              if tag == "type.unit" || tag == "type.null" {
                actual == null
              } else {
                if tag == "type.array" {
                  type_of(actual) == "arr"
                } else {
                  if tag == "type.object" {
                    type_of(actual) == "obj"
                  } else {
                    if tag == "type.unknown" {
                      true
                    } else {
                      if tag == "" {
                        actual == expected
                      } else {
                        false
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
      if ok {
        { val: expected, state: s }
      } else {
        { val: expected, state: tc_add_diagnostic(s, "error", "check_json_value: literal does not satisfy the expected annotation") }
      }
    },
    --- `synth_flow` — categorical composition `f >>> g` (ADR-0119 /
    --- ADR-0120 Phase 4). Boundary condition `tgt(f) = src(g)` in
    --- `type.function` coordinates is `unify(f.body, g.param)`; the
    --- composite is `type.function{param: f.param, body: g.body}` — the
    --- same axis-0 rule `type.axis_flow` expresses in the scheme
    --- vocabulary. When an operand is a `type.pi`/`type.forall` its
    --- body closure is applied at its own domain to read the boundary;
    --- the composite flattens to `type.function` (the dependent form is
    --- not reconstructible — there is no body node for the composite —
    --- so this is the documented structural approximation). Reindexing
    --- needs no rule here: `P >>> f` is exactly this composition.
    "synth_flow": do {
      node :: ast_node(s.ast, node_idx)
      children :: node_children(node)
      if len(children) < 2 {
        { val: funcs.make_type("type.unknown", {}), state: tc_add_diagnostic(s, "error", "flow: missing operands") }
      } else {
        do {
          f_result :: funcs.synth_node_(funcs, s, first_value(children))
          g_result :: funcs.synth_node_(funcs, f_result["state"], at(children, 1))
          funcs.flow_compose_(funcs, f_result.typ, g_result.typ, g_result["state"])
        }
      }
    },
    --- `synth_axis_flow` — axis-parameterized composition `a >>>[k] b`
    --- (ADR-0120 Phase 2 follow-up). The axis child is checked against
    --- `type.number`, then a literal axis selects the boundary law in
    --- `axis_flow_compose_`: `>>>[0]` (and the non-literal fallback)
    --- runs the axis-0 rule the old scheme expressed; `>>>[1]` enforces
    --- the globular `tgt_1(f) = src_1(g)` via `cell_boundary_` and
    --- synthesizes the `∘₁` composite `Arrow` via `cell_paste_`;
    --- `>>>[k≥2]` fails the dimension check the runtime's dim-2 lift
    --- makes unconditional. A single parenthesized axis literal
    --- (`a >>>[(1)] b`) still counts as a literal.
    "synth_axis_flow": do {
      node :: ast_node(s.ast, node_idx)
      children :: node_children(node)
      if len(children) < 3 {
        { val: funcs.make_type("type.unknown", {}), state: tc_add_diagnostic(s, "error", "axis_flow: missing operands") }
      } else {
        do {
          axis_idx :: at(children, 1)
          axis_node0 :: ast_node(s.ast, axis_idx)
          axis_node :: if node_kind(axis_node0) == "paren" {
            ast_node(s.ast, first_value(node_children(axis_node0)))
          } else {
            axis_node0
          }
          axis_payload :: node_payload(axis_node)
          axis_val :: if type_of(axis_payload) == "obj" { get_or(axis_payload, "value", null) } else { axis_payload }
          axis_lit :: if node_kind(axis_node) == "value" && type_of(axis_val) == "num" { axis_val } else { null }
          axis_check :: funcs.check_node_(funcs, s, axis_idx, funcs.make_type("type.number", {}))
          f_result :: funcs.synth_node_(funcs, axis_check["state"], first_value(children))
          g_result :: funcs.synth_node_(funcs, f_result["state"], at(children, 2))
          funcs.axis_flow_compose_(funcs, f_result.typ, g_result.typ, axis_lit, g_result["state"])
        }
      }
    },
    --- `synth_dim_arrow` — N-dimensional arrow `A ~[N]~> B`
    --- (ADR-0119/0120). The same `Arrow{inputs, grade, output}` record
    --- the old `construct` scheme produced, plus `dim` carrying the
    --- literal bracket dimension so `cell_boundary_` can project
    --- k-indexed globular boundaries for `a >>>[k] b` (`null` when the
    --- dimension child is not a literal — the projection then assumes
    --- the only boundaries the record carries). The dimension literal
    --- is read from the child payload: the scheme vocabulary can only
    --- synth the dimension's *type*, not its value.
    "synth_dim_arrow": do {
      node :: ast_node(s.ast, node_idx)
      children :: node_children(node)
      if len(children) < 3 {
        { val: funcs.make_type("type.unknown", {}), state: tc_add_diagnostic(s, "error", "dim_arrow: missing operands") }
      } else {
        do {
          src_result :: funcs.synth_node_(funcs, s, first_value(children))
          dim_idx :: at(children, 1)
          dim_node0 :: ast_node(s.ast, dim_idx)
          dim_node :: if node_kind(dim_node0) == "paren" {
            ast_node(s.ast, first_value(node_children(dim_node0)))
          } else {
            dim_node0
          }
          dim_payload :: node_payload(dim_node)
          dim_val :: if type_of(dim_payload) == "obj" { get_or(dim_payload, "value", null) } else { dim_payload }
          dim_lit :: if node_kind(dim_node) == "value" && type_of(dim_val) == "num" { dim_val } else { null }
          grade_result :: funcs.synth_node_(funcs, src_result["state"], dim_idx)
          tgt_result :: funcs.synth_node_(funcs, grade_result["state"], at(children, 2))
          { val: funcs.make_type("Arrow", set(set(set(set({}, "inputs", src_result.typ), "grade", grade_result.typ), "output", tgt_result.typ), "dim", dim_lit)), state: tgt_result["state"] }
        }
      }
    },
    --- `synth_data` — inductive family declaration `data Name(params)
    --- :: ctors` (ADR-0082 / ADR-0120 Phase 4). The `type` child gives
    --- the parameter list (`call(var Name, p…)`: `n : Nat`, `a : Type`,
    --- or a bare `var`): `Name` binds to `type.family{name, base}` with
    --- `base` a `type.array` of the declared parameter *sorts* (the
    --- annotation synthesized, a fresh meta for a bare `var`). Each
    --- constructor binds to a `type.ctor_sig` spec — its domain and
    --- result-index AST children, plus the parameter names — which
    --- `instantiate_ctor_` re-elaborates on every lookup into a
    --- `type.function` chain ending in `type.family_app`. Applying a
    --- constructor therefore *checks* its arguments against the
    --- declared domains and produces the family at the result indices,
    --- with parameter metas shared between the two. Strict positivity
    --- remains the native `desugar.data` pass's concern; dependent
    --- elimination — `match` refining the scrutinee's family index per
    --- branch — lives in `refine_scrutinee_`/`synth_match_arms` and is
    --- documented in `handl-packages/type/dependent.hnl`.
    "synth_data": do {
      node :: ast_node(s.ast, node_idx)
      payload :: node_payload(node)
      children :: node_children(node)
      name :: get_or(payload, "name", "")
      type_role :: child_role_index(s, "data", "type")
      cons_role :: child_role_index(s, "data", "constructors")
      --- (`&&`/`||` evaluate eagerly — keep the null check structural.)
      type_idx :: if type_role == null {
        if len(children) >= 2 { first_value(children) } else { null }
      } else {
        if type_role < len(children) { at(children, type_role) } else { if len(children) >= 2 { first_value(children) } else { null } }
      }
      cons_idx :: if cons_role == null {
        if len(children) >= 2 { at(children, 1) } else { if len(children) == 1 { first_value(children) } else { null } }
      } else {
        if cons_role < len(children) { at(children, cons_role) } else { if len(children) >= 2 { at(children, 1) } else { null } }
      }
      params :: if type_idx == null { [] } else { data_params_from_(s, type_idx) }
      base_acc :: while { elems: [], state: s, remaining: params } {
        [st]~> if is_empty(st.remaining) {
          { out: { elems: st.elems, state: st["state"] } }
        } else {
          do {
            p :: first_value(st.remaining)
            p_node :: get_or(p, "node", null)
            el :: if p_node == null {
              do {
                m :: tc_fresh_meta(st["state"])
                { val: meta_value(m.id), state: m["state"] }
              }
            } else {
              funcs.synth_type_(funcs, st["state"], p_node)
            }
            { state: { elems: [...st.elems, el.val], state: el["state"], remaining: drop(st.remaining, 1) } }
          }
        }
      }
      base :: funcs.make_type("type.array", set({}, "elements", base_acc.elems))
      fam_type :: funcs.make_type("type.family", set(set({}, "name", name), "base", base))
      extended :: if name == "" { base_acc["state"] } else { tc_extend(base_acc["state"], name, fam_type) }
      ctor_specs :: if cons_idx == null {
        []
      } else {
        funcs.collect_ctor_specs_(funcs, extended, cons_idx, [])
      }
      bound :: while { state: extended, remaining: ctor_specs } {
        [st]~> if is_empty(st.remaining) {
          { out: st["state"] }
        } else {
          do {
            spec :: first_value(st.remaining)
            cname :: get_or(spec, "name", "")
            sig :: set(set(set(set(set(set({}, "__tag__", "type.ctor_sig"), "ctor", true), "family", name), "params", params), "args", get_or(spec, "args", [])), "result", get_or(spec, "result", null))
            sig_bare :: set(sig, "bare", get_or(spec, "bare", false))
            { state: { state: if cname == "" { st["state"] } else { tc_extend(st["state"], cname, sig_bare) }, remaining: drop(st.remaining, 1) } }
          }
        }
      }
      { val: funcs.make_type("type.unit", {}), state: bound }
    },
    _: { val: funcs.make_type("type.unknown", {}), state: funcs.add_diagnostic(s, "warning", "unknown judgment op: " + op_name) }
  }
  }

  synth_type_impl_ :: [funcs, st, node_idx]~> do {
    node :: ast_node(st.ast, node_idx)
    kind :: node_kind(node)
    payload :: node_payload(node)
    if kind == "value" {
      { val: if type_of(payload) == "obj" { get_or(payload, "value", null) } else { payload }, state: st }
    } else {
      if kind == "var" {
        do {
          name :: if type_of(payload) == "str" { payload } else { get_or(payload, "name", "") }
          --- A `data`-declared family or constructor shadows the
          --- builtin spelling — after `data Nat :: Zero | Succ`, the
          --- `Nat` in `Succ(pred : Nat)` means the declared family,
          --- not `type.number`. When nothing is declared, the builtin
          --- chain below handles `Nat`/`Bool`/… as before.
          found_first :: tc_lookup(st, name)
          --- `if`, not `&&`: `&&` evaluates both operands eagerly, and
          --- `get_or` on a null/non-object lookup result is a type error.
          shadow_family :: if type_tag(found_first) == "type.family" { get_or(found_first, "name", "") != "" } else { false }
          if type_tag(found_first) == "type.ctor_sig" {
            funcs.instantiate_ctor_(funcs, st, found_first)
          } else {
          if shadow_family {
            do {
              base_elems :: get_or(get_or(found_first, "base", {}), "elements", [])
              app_acc :: while { args: [], state: st, remaining: base_elems } {
                [w]~> if is_empty(w.remaining) {
                  { out: { args: w.args, state: w["state"] } }
                } else {
                  do {
                    m :: tc_fresh_meta(w["state"])
                    { state: { args: [...w.args, meta_value(m.id)], state: m["state"], remaining: drop(w.remaining, 1) } }
                  }
                }
              }
              { val: funcs.make_type("type.family_app", set(set({}, "name", name), "args", app_acc.args)), state: app_acc["state"] }
            }
          } else {
          if name == "List" {
            { val: funcs.make_type("type.constructor", set(set({}, "name", "List"), "make", [element, length]~> funcs.make_type("List", set(set({}, "element", element), "length", length)))), state: st }
          } else {
            if name == "Type" || name == "Universe" || name == "Type0" {
              --- `Type` is the lowest type universe (Prop ≈ Bool ≈ Type₀ —
              --- the predicate encoding used by `desugar.data` lives here).
              { val: funcs.make_type("type.universe", set({}, "level", 0)), state: st }
            } else {
            if name == "Family" || name == "Pi" || name == "Sigma" || name == "Forall" {
              --- Bare dependent former names (ADR-0120 Phase 4): opaque
              --- constructors. `Family(A)` / `Pi(A, f)` / `Sigma(A, f)` /
              --- `Forall(K, f)` applications are handled in the `call`
              --- branch, which needs the argument AST nodes (a body
              --- closure captures the binder and its arena index).
              { val: funcs.make_type("type.constructor", set({}, "name", name)), state: st }
            } else {
            if name == "Int" || name == "Nat" || name == "Number" {
              { val: funcs.make_type("type.number", {}), state: st }
            } else {
              if name == "Bool" {
                { val: funcs.make_type("type.bool", {}), state: st }
              } else {
                if name == "String" || name == "Str" {
                  { val: funcs.make_type("type.string", {}), state: st }
                } else {
                  if name == "Unit" {
                    { val: funcs.make_type("type.unit", {}), state: st }
                  } else {
                    found :: tc_lookup(st, name)
                    if found == null {
                      do {
                        bound :: tc_lookup_result(st, name)
                        if bound == null {
                          { val: funcs.make_type("type.unknown", {}), state: tc_add_diagnostic(st, "warning", "synth_type: unbound type variable: " + name) }
                        } else {
                          funcs.eval_term_(funcs, st, bound)
                        }
                      }
                    } else {
                      --- A `data` constructor in type position
                      --- (`x : Succ` is unusual but legal) instantiates
                      --- its signature like a term-position lookup.
                      if type_tag(found) == "type.ctor_sig" {
                        funcs.instantiate_ctor_(funcs, st, found)
                      } else {
                      --- A `data`-declared name in type position is the
                      --- saturated family — `Vec` alone means `Vec` at
                      --- unknown indices (`type.family_app` with fresh
                      --- metavariables). The `type.family` former itself
                      --- (`Family(A)`, or `f : Family(A)`) stays a former.
                      named_family :: if type_tag(found) == "type.family" { get_or(found, "name", "") != "" } else { false }
                      if named_family {
                        do {
                          base_elems :: get_or(get_or(found, "base", {}), "elements", [])
                          app_acc :: while { args: [], state: st, remaining: base_elems } {
                            [w]~> if is_empty(w.remaining) {
                              { out: { args: w.args, state: w["state"] } }
                            } else {
                              do {
                                m :: tc_fresh_meta(w["state"])
                                { state: { args: [...w.args, meta_value(m.id)], state: m["state"], remaining: drop(w.remaining, 1) } }
                              }
                            }
                          }
                          { val: funcs.make_type("type.family_app", set(set({}, "name", name), "args", app_acc.args)), state: app_acc["state"] }
                        }
                      } else {
                        { val: found, state: st }
                      }
                      }
                    }
                  }
                }
              }
            }
          }
        }
        }
          }
          }
      }
      } else {
        if kind == "field-access" {
          do {
            field_role :: child_role_index(st, kind, "field")
            if field_role == null {
              { val: funcs.make_type("type.unknown", {}), state: tc_add_diagnostic(st, "warning", "synth_type: field-access missing field role") }
            } else {
              do {
                field_node :: ast_node(st.ast, child_ref(st.ast, node_idx, field_role))
                field_payload :: node_payload(field_node)
                field_name :: if type_of(field_payload) == "str" { field_payload } else { get_or(field_payload, "name", "") }
                if field_name == "Int" || field_name == "Nat" {
                  { val: funcs.make_type("type.number", {}), state: st }
                } else {
                  if field_name == "Bool" {
                    { val: funcs.make_type("type.bool", {}), state: st }
                  } else {
                    if field_name == "String" || field_name == "Str" {
                      { val: funcs.make_type("type.string", {}), state: st }
                    } else {
                      if field_name == "Unit" {
                        { val: funcs.make_type("type.unit", {}), state: st }
                      } else {
                        if field_name == "List" {
                          { val: funcs.make_type("type.constructor", set(set({}, "name", "List"), "make", [element, length]~> funcs.make_type("List", set(set({}, "element", element), "length", length)))), state: st }
                        } else {
                          target_role :: child_role_index(st, kind, "target")
                          target_name :: if target_role == null { "" } else {
                            do {
                              target_node :: ast_node(st.ast, child_ref(st.ast, node_idx, target_role))
                              target_payload :: node_payload(target_node)
                              if type_of(target_payload) == "str" { target_payload } else { get_or(target_payload, "name", "") }
                            }
                          }
                          { val: funcs.make_type("RecordProj", set(set({}, "record", funcs.make_type("Const", set({}, "value", target_name))), "field", field_name)), state: st }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        } else {
          if kind == "call" {
            do {
              callee_role :: child_role_index(st, kind, "callee")
              args_role :: child_role_index(st, kind, "args")
              if callee_role == null || args_role == null {
                { val: funcs.make_type("type.unknown", {}), state: tc_add_diagnostic(st, "warning", "synth_type: call missing callee/args role") }
              } else {
                do {
                  children :: node_children(node)
                  callee_idx :: at(children, callee_role)
                  callee_node :: ast_node(st.ast, callee_idx)
                  callee_payload :: node_payload(callee_node)
                  callee_name :: if node_kind(callee_node) == "var" {
                    if type_of(callee_payload) == "str" { callee_payload } else { get_or(callee_payload, "name", "") }
                  } else {
                    ""
                  }
                  bound_callee :: if callee_name != "" { tc_lookup_result(st, callee_name) } else { null }
                  --- Dependent former application (ADR-0120 Phase 4):
                  --- `Family(A)`, `Pi(A, f)`, `Sigma(A, f)`, `Forall(K, f)`
                  --- — plus the `type.`-namespaced spellings — mint
                  --- `type.family`/`type.pi`/`type.sigma`/`type.forall`
                  --- type values with a lazy `body_closure`.
                  former_name :: if callee_name == "Family" || callee_name == "Pi" || callee_name == "Sigma" || callee_name == "Forall" {
                    callee_name
                  } else {
                    if node_kind(callee_node) == "field-access" {
                      do {
                        fa_role :: child_role_index(st, "field-access", "field")
                        if fa_role == null {
                          ""
                        } else {
                          do {
                            fa_node :: ast_node(st.ast, child_ref(st.ast, callee_idx, fa_role))
                            fa_payload :: node_payload(fa_node)
                            fa_name :: if type_of(fa_payload) == "str" { fa_payload } else { get_or(fa_payload, "name", "") }
                            if fa_name == "Family" || fa_name == "Pi" || fa_name == "Sigma" || fa_name == "Forall" { fa_name } else { "" }
                          }
                        }
                      }
                    } else {
                      ""
                    }
                  }
                  if former_name != "" {
                    funcs.synth_dep_former_(funcs, st, node_idx, former_name)
                  } else {
                  if callee_name == "Path" {
                    --- `Path(a, b)` — the proof-relevant identity type
                    --- `a ~Path~ b` (ADR-0120). The endpoints are index
                    --- *terms*, evaluated through `results` like
                    --- `family_app` args, so `Path(n, 0)` under a
                    --- `VNil` arm is `Path(var n, 0)`. Its
                    --- introductions are `refl` and in-scope `Path`
                    --- witnesses (`check_path_intro_`); its eliminators
                    --- are `#` (transport) and `j` (J) — see
                    --- `synth_transport_`/`synth_j_`.
                    do {
                      frm_arg :: if args_role < len(children) {
                        funcs.eval_node_(funcs, st, at(children, args_role))
                      } else {
                        { val: null, state: st }
                      }
                      to_arg :: if args_role + 1 < len(children) {
                        funcs.eval_node_(funcs, frm_arg["state"], at(children, args_role + 1))
                      } else {
                        { val: null, state: frm_arg["state"] }
                      }
                      { val: funcs.make_type("Path", set(set({}, "frm", frm_arg.val), "to", to_arg.val)), state: to_arg["state"] }
                    }
                  } else {
                  if bound_callee != null {
                    funcs.eval_node_(funcs, st, node_idx)
                  } else {
                  do {
                  callee_type :: funcs.synth_type_(funcs, st, callee_idx)
                  arg_acc :: while { result: [], state: callee_type["state"], idx: args_role } {
                    [inner]~> if inner.idx >= len(children) {
                      { out: { vals: inner.result, state: inner["state"] } }
                    } else {
                      do {
                        arg_t :: funcs.synth_type_(funcs, inner["state"], at(children, inner.idx))
                        { state: { result: [...inner.result, arg_t.val], state: arg_t["state"], idx: inner.idx + 1 } }
                      }
                    }
                  }
                  callee_tag :: type_tag(callee_type.val)
                  if callee_tag == "type.family" || callee_tag == "type.family_app" {
                    --- Indexed-family application in type position
                    --- (ADR-0120 Phase 4): `Vec(3, Bool)` is the
                    --- saturated fiber `type.family_app{name, args}`.
                    { val: funcs.make_type("type.family_app", set(set({}, "name", get_or(callee_type.val, "name", "")), "args", arg_acc.vals)), state: arg_acc["state"] }
                  } else {
                  if callee_tag == "type.constructor" {
                    do {
                      cname :: get_or(callee_type.val, "name", "")
                      make :: get_or(callee_type.val, "make", null)
                      if cname == "List" && len(arg_acc.vals) == 2 {
                        do {
                          applied :: make(at(arg_acc.vals, 0), at(arg_acc.vals, 1))
                          { val: applied, state: arg_acc["state"] }
                        }
                      } else {
                        if make != null && len(arg_acc.vals) <= 3 {
                          do {
                            applied :: if len(arg_acc.vals) == 0 {
                              make()
                            } else {
                              if len(arg_acc.vals) == 1 {
                                make(at(arg_acc.vals, 0))
                              } else {
                                if len(arg_acc.vals) == 2 {
                                  make(at(arg_acc.vals, 0), at(arg_acc.vals, 1))
                                } else {
                                  make(at(arg_acc.vals, 0), at(arg_acc.vals, 1), at(arg_acc.vals, 2))
                                }
                              }
                            }
                            { val: applied, state: arg_acc["state"] }
                          }
                        } else {
                          { val: funcs.make_type("type.unknown", {}), state: tc_add_diagnostic(arg_acc["state"], "warning", "synth_type: cannot apply constructor " + cname) }
                        }
                      }
                    }
                  } else {
                    { val: funcs.make_type("App", set(set({}, "callee", callee_type.val), "args", arg_acc.vals)), state: arg_acc["state"] }
                  }
                  }
                  }
                  }
                }
              }
            }
            }
            }
          } else {
            do {
              left_role :: child_role_index(st, kind, "left")
              is_evaluable :: kind == "paren" || kind == "if" || kind == "array" || left_role != null
              if is_evaluable {
                funcs.eval_node_(funcs, st, node_idx)
              } else {
                { val: funcs.make_type("type.unknown", {}), state: tc_add_diagnostic(st, "warning", "synth_type: unsupported annotation kind: " + kind) }
              }
            }
          }
        }
      }
    }
  }

  synth_type_ :: [funcs, st, node_idx]~> synth_type_impl_(funcs, st, node_idx)

  --- Fuel wrappers: ensure the main typecheck driver and every
  --- recursive fixpoint step burns a little fuel, and return a
  --- graceful diagnostic instead of looping forever.

  synth_node_ :: [funcs, s, node_idx]~> do {
    s :: tc_sanitize(s)
    s :: tc_burn_fuel(s)
    if tc_fuel_exhausted(s) {
      { typ: funcs.make_type("type.unknown", {}), state: tc_add_diagnostic(s, "error", "typecheck fuel exhausted") }
    } else {
      do {
        res :: synth_node_impl_(funcs, s, node_idx)
        { typ: res.typ, state: funcs.sanitize(res["state"]) }
      }
    }
  }

  check_node_ :: [funcs, s, node_idx, expected]~> do {
    s :: tc_sanitize(s)
    s :: tc_burn_fuel(s)
    if tc_fuel_exhausted(s) {
      { ok: false, state: tc_add_diagnostic(s, "error", "typecheck fuel exhausted") }
    } else {
      do {
        res :: check_node_impl_(funcs, s, node_idx, expected)
        { ok: res.ok, state: funcs.sanitize(res["state"]) }
      }
    }
  }

  eval_scheme_ :: [funcs, s, node_idx, term, incoming]~> do {
    s :: tc_sanitize(s)
    s :: tc_burn_fuel(s)
    if tc_fuel_exhausted(s) {
      { val: funcs.make_type("type.unknown", {}), state: tc_add_diagnostic(s, "error", "typecheck fuel exhausted") }
    } else {
      do {
        res :: eval_scheme_impl_(funcs, s, node_idx, term, incoming)
        { val: res.val, state: funcs.sanitize(res["state"]) }
      }
    }
  }

  eval_judgment_ :: [funcs, s, node_idx, op_name, args, lit, incoming]~> do {
    s :: tc_sanitize(s)
    s :: tc_burn_fuel(s)
    if tc_fuel_exhausted(s) {
      { val: funcs.make_type("type.unknown", {}), state: tc_add_diagnostic(s, "error", "typecheck fuel exhausted") }
    } else {
      do {
        res :: eval_judgment_impl_(funcs, s, node_idx, op_name, args, lit, incoming)
        { val: res.val, state: funcs.sanitize(res["state"]) }
      }
    }
  }

  --- Ordered value annotations (ADR-0103): `x : T := v` treats `T` as a
  --- normal expression evaluated against the bound-value environment
  --- (`s.results`, populated by `assign` via `tc_bind_result`). A type
  --- result means membership (`5 : Number`); a value result means
  --- equality (`f : inc(4) := 5` checks `5 == inc(4)`). Evaluation is
  --- fuel-bounded through `tc_burn_fuel`, so annotation evaluation is
  --- guaranteed to terminate like every other checker recursion.
  ---
  --- `node_term_` lowers an AST node to a closed term; `eval_term_`
  --- reduces terms; `apply_val_` applies `LamVal`/`CompVal` closures and
  --- host `__arrow__` values; `eval_node_` composes the two.

  node_term_ :: [funcs, s, node_idx]~> do {
    node :: ast_node(s.ast, node_idx)
    kind :: node_kind(node)
    payload :: node_payload(node)
    children :: node_children(node)
    if kind == "value" {
      if type_of(payload) == "obj" { get_or(payload, "value", null) } else { payload }
    } else {
      if kind == "var" {
        do {
          name :: if type_of(payload) == "str" { payload } else { get_or(payload, "name", "") }
          funcs.make_type("var", set({}, "name", name))
        }
      } else {
        if kind == "paren" {
          if is_empty(children) {
            null
          } else {
            funcs.node_term_(funcs, s, first_value(children))
          }
        } else {
          if kind == "call" {
            do {
              callee_role :: child_role_index(s, kind, "callee")
              args_role :: child_role_index(s, kind, "args")
              if callee_role == null || args_role == null {
                null
              } else {
                do {
                  callee_t :: funcs.node_term_(funcs, s, at(children, callee_role))
                  arg_ts :: while { result: [], idx: args_role } {
                    [st]~> if st.idx >= len(children) {
                      { out: st.result }
                    } else {
                      { state: { result: [...st.result, funcs.node_term_(funcs, s, at(children, st.idx))], idx: st.idx + 1 } }
                    }
                  }
                  funcs.make_type("App", set(set({}, "callee", callee_t), "args", arg_ts))
                }
              }
            }
          } else {
            if kind == "function" {
              do {
                payload_params :: get_or(payload, "params", null)
                payload_body :: get_or(payload, "body", null)
                if type_of(payload_params) == "arr" && type_of(payload_body) == "num" {
                  funcs.make_type("Lam", set(set({}, "params", payload_params), "body", payload_body))
                } else {
                do {
                params_role :: child_role_index(s, kind, "params")
                body_role :: child_role_index(s, kind, "body")
                if params_role == null || body_role == null {
                  null
                } else {
                  do {
                    params_idx :: at(children, params_role)
                    params_node :: ast_node(s.ast, params_idx)
                    param_children :: if node_kind(params_node) == "paren" { node_children(params_node) } else { [params_idx] }
                    names :: while { result: [], remaining: param_children } {
                      [st]~> if is_empty(st.remaining) {
                        { out: st.result }
                      } else {
                        do {
                          p_idx :: first_value(st.remaining)
                          p_node :: ast_node(s.ast, p_idx)
                          p_kind :: node_kind(p_node)
                          p_payload :: node_payload(p_node)
                          p_name :: if p_kind == "var" {
                            if type_of(p_payload) == "str" { p_payload } else { get_or(p_payload, "name", "") }
                          } else {
                            if p_kind == "type-annot" {
                              do {
                                subj_role :: child_role_index(s, p_kind, "subject")
                                if subj_role == null {
                                  ""
                                } else {
                                  do {
                                    subj_node :: ast_node(s.ast, child_ref(s.ast, p_idx, subj_role))
                                    subj_payload :: node_payload(subj_node)
                                    if type_of(subj_payload) == "str" { subj_payload } else { get_or(subj_payload, "name", "") }
                                  }
                                }
                              }
                            } else {
                              ""
                            }
                          }
                          { state: { result: [...st.result, p_name], remaining: drop(st.remaining, 1) } }
                        }
                      }
                    }
                    funcs.make_type("Lam", set(set({}, "params", names), "body", at(children, body_role)))
                  }
                }
                }
                }
              }
            } else {
              if kind == "if" {
                do {
                  cond_role :: child_role_index(s, kind, "condition")
                  then_role :: child_role_index(s, kind, "then")
                  else_role :: child_role_index(s, kind, "else")
                  if cond_role == null || then_role == null {
                    null
                  } else {
                    do {
                      cond_t :: funcs.node_term_(funcs, s, at(children, cond_role))
                      then_t :: funcs.node_term_(funcs, s, at(children, then_role))
                      else_t :: if else_role == null || else_role >= len(children) {
                        null
                      } else {
                        funcs.node_term_(funcs, s, at(children, else_role))
                      }
                      funcs.make_type("If", set(set(set({}, "cond", cond_t), "then", then_t), "else", else_t))
                    }
                  }
                }
              } else {
                if kind == "array" {
                  do {
                    element_terms :: while { result: [], remaining: children } {
                      [st]~> if is_empty(st.remaining) {
                        { out: st.result }
                      } else {
                        { state: { result: [...st.result, funcs.node_term_(funcs, s, first_value(st.remaining))], remaining: drop(st.remaining, 1) } }
                      }
                    }
                    funcs.make_type("ArrLit", set({}, "elements", element_terms))
                  }
                } else {
                  do {
                    left_role :: child_role_index(s, kind, "left")
                    right_role :: child_role_index(s, kind, "right")
                    operand_role :: child_role_index(s, kind, "operand")
                    if left_role == null || right_role == null {
                      if operand_role == null {
                        null
                      } else {
                        funcs.make_type("Un", set(set({}, "op", kind), "operand", funcs.node_term_(funcs, s, at(children, operand_role))))
                      }
                    } else {
                      do {
                        l_t :: funcs.node_term_(funcs, s, at(children, left_role))
                        r_t :: funcs.node_term_(funcs, s, at(children, right_role))
                        if kind == "flow" {
                          funcs.make_type("Comp", set(set({}, "l", l_t), "r", r_t))
                        } else {
                          funcs.make_type("Bin", set(set(set({}, "op", kind), "l", l_t), "r", r_t))
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  is_applicable_ :: [funcs, v]~> if type_tag(v) == "LamVal" || type_tag(v) == "CompVal" {
    true
  } else {
    is_host_arrow_(v)
  }

  apply_val_ :: [funcs, s, f, args]~> do {
    tag :: type_tag(f)
    if tag == "LamVal" {
      do {
        params :: get_or(f, "params", [])
        body_idx :: get_or(f, "body", 0)
        env :: get_or(f, "env", {})
        bound_env :: while { result: env, idx: 0 } {
          [st]~> if st.idx >= len(args) || st.idx >= len(params) {
            { out: st.result }
          } else {
            { state: { result: set(st.result, at(params, st.idx), at(args, st.idx)), idx: st.idx + 1 } }
          }
        }
        s2 :: set(s, "results", bound_env)
        body_result :: funcs.eval_node_(funcs, s2, body_idx)
        { val: body_result.val, state: set(body_result["state"], "results", get_or(s, "results", {})) }
      }
    } else {
      if tag == "CompVal" {
        do {
          inner :: funcs.apply_val_(funcs, s, get_or(f, "l", null), args)
          funcs.apply_val_(funcs, inner["state"], get_or(f, "r", null), [inner.val])
        }
      } else {
        if is_host_arrow_(f) {
          do {
            raw :: if len(args) == 0 {
              f()
            } else {
              if len(args) == 1 {
                f(at(args, 0))
              } else {
                if len(args) == 2 {
                  f(at(args, 0), at(args, 1))
                } else {
                  f(at(args, 0), at(args, 1), at(args, 2))
                }
              }
            }
            { val: raw, state: s }
          }
        } else {
          { val: funcs.make_type("App", set(set({}, "callee", f), "args", args)), state: s }
        }
      }
    }
  }

  --- Merge `(<X op₁ c> op₂ k)` into `<X op' c'>` when the inner right
  --- operand is a literal — keeps iterated index arithmetic (`(n-1)+1`,
  --- `n+1+1`) in a canonical two-level form so unification sees equal
  --- terms. Returns `{op, l, r}` or `null` when no merge applies.
  merge_bin_ :: [bin_op, l, r]~> do {
    inner_op :: get_or(l, "op", "")
    inner_l :: get_or(l, "l", null)
    inner_r :: get_or(l, "r", null)
    --- `l` is only passed when its tag is `Bin`, but the inner right
    --- operand can still be symbolic (`(1 - n) + 1`) — bail without a
    --- numeric inner literal. (`&&` evaluates eagerly here, so the
    --- guard must be structural, not conjunctive.)
    if type_of(inner_r) != "num" {
      null
    } else {
    if bin_op == "binary.add" {
      if inner_op == "binary.add" {
        set(set(set({}, "op", "binary.add"), "l", inner_l), "r", inner_r + r)
      } else {
        if inner_op == "binary.sub" {
          set(set(set({}, "op", "binary.sub"), "l", inner_l), "r", inner_r - r)
        } else {
          null
        }
      }
    } else {
      if bin_op == "binary.sub" {
        if inner_op == "binary.add" {
          set(set(set({}, "op", "binary.add"), "l", inner_l), "r", inner_r - r)
        } else {
          if inner_op == "binary.sub" {
            set(set(set({}, "op", "binary.sub"), "l", inner_l), "r", inner_r + r)
          } else {
            null
          }
        }
      } else {
        null
      }
    }
    }
  }

  eval_bin_ :: [funcs, s, bin_op, l_term, r_term]~> do {
    l_result :: funcs.eval_term_(funcs, s, l_term)
    r_result :: funcs.eval_term_(funcs, l_result["state"], r_term)
    lv :: l_result.val
    rv :: r_result.val
    both_num :: type_of(lv) == "num" && type_of(rv) == "num"
    both_bool :: type_of(lv) == "bool" && type_of(rv) == "bool"
    both_lit :: type_tag(lv) == "" && type_tag(rv) == ""
    --- Index-term normalization (ADR-0120 Phase 4 deepening): opaque
    --- `Bin` terms are put in a canonical form before construction so
    --- computationally-equal index terms compare equal — this is the
    --- model's numeric definitional-equality fragment (`+`/`*` only
    --- compute on numbers in this evaluator, so reordering is sound;
    --- string concatenation is not modeled):
    ---   * commutative ops put a numeric literal on the right, so
    ---     `1 + n` and `n + 1` share the normal form `Bin{add, n, 1}`;
    ---   * ring identities reduce outright — `n+0`/`0+n`/`n*1`/`1*n`
    ---     → `n`, `n*0`/`0*n` → `0`, `n-0` → `n`, `n-n` → `0`,
    ---     `n/1` → `n`, `n==n` → `true`, `n!=n` → `false`;
    ---   * a nested `Bin` with a literal right merges — `(n-1)+1` →
    ---     `Bin{sub, n, 0}` → `n`, `n+1+1` → `Bin{add, n, 2}`.
    commutative :: bin_op == "binary.add" || bin_op == "binary.mul" || bin_op == "binary.eq" || bin_op == "binary.neq"
    canon :: commutative && !both_num && type_of(lv) == "num" && type_of(rv) != "num"
    cl :: if canon { rv } else { lv }
    cr :: if canon { lv } else { rv }
    simp :: if both_num || both_bool {
      null
    } else {
      if bin_op == "binary.add" {
        if cr == 0 { cl } else { null }
      } else {
        if bin_op == "binary.sub" {
          if cr == 0 { cl } else { if cl == cr { 0 } else { null } }
        } else {
          if bin_op == "binary.mul" {
            if cr == 1 { cl } else { if cr == 0 { 0 } else { null } }
          } else {
            if bin_op == "binary.div" {
              if cr == 1 { cl } else { null }
            } else {
              if bin_op == "binary.eq" {
                if cl == cr { true } else { null }
              } else {
                if bin_op == "binary.neq" {
                  if cl == cr { false } else { null }
                } else {
                  null
                }
              }
            }
          }
        }
      }
    }
    merged :: if type_of(cr) == "num" && type_tag(cl) == "Bin" {
      --- `merge_bin_` itself guards the inner-right literal — `&&`
      --- evaluates eagerly in this model, so `get_or(cl, "r")` must not
      --- appear in the condition (it would hit a non-object `cl`).
      merge_bin_(bin_op, cl, cr)
    } else {
      null
    }
    merged_val :: if merged == null {
      null
    } else {
      if get_or(merged, "r", 1) == 0 && (get_or(merged, "op", "") == "binary.add" || get_or(merged, "op", "") == "binary.sub") {
        get_or(merged, "l", null)
      } else {
        funcs.make_type("Bin", merged)
      }
    }
    opaque :: if simp != null { simp } else { if merged_val != null { merged_val } else { funcs.make_type("Bin", set(set(set({}, "op", bin_op), "l", cl), "r", cr)) } }
    val :: if bin_op == "binary.add" {
      if both_num { lv + rv } else { opaque }
    } else {
      if bin_op == "binary.sub" {
        if both_num { lv - rv } else { opaque }
      } else {
        if bin_op == "binary.mul" {
          if both_num { lv * rv } else { opaque }
        } else {
          if bin_op == "binary.div" {
            if both_num && rv != 0 { lv / rv } else { opaque }
          } else {
            if bin_op == "binary.mod" {
              if both_num && rv != 0 { lv % rv } else { opaque }
            } else {
              if bin_op == "binary.eq" {
                if both_lit { lv == rv } else { opaque }
              } else {
                if bin_op == "binary.neq" {
                  if both_lit { lv != rv } else { opaque }
                } else {
                  if bin_op == "binary.lt" {
                    if both_num { lv < rv } else { opaque }
                  } else {
                    if bin_op == "binary.lte" {
                      if both_num { lv <= rv } else { opaque }
                    } else {
                      if bin_op == "binary.gt" {
                        if both_num { lv > rv } else { opaque }
                      } else {
                        if bin_op == "binary.gte" {
                          if both_num { lv >= rv } else { opaque }
                        } else {
                          if bin_op == "binary.and" {
                            if both_bool { lv && rv } else { opaque }
                          } else {
                            if bin_op == "binary.or" {
                              if both_bool { lv || rv } else { opaque }
                            } else {
                              opaque
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
    { val: val, state: r_result["state"] }
  }

  eval_term_ :: [funcs, s, term]~> do {
    s :: tc_sanitize(s)
    s :: tc_burn_fuel(s)
    if tc_fuel_exhausted(s) {
      { val: term, state: s }
    } else {
      do {
        tag :: type_tag(term)
        if tag == "var" {
          do {
            bound :: tc_lookup_result(s, get_or(term, "name", ""))
            --- A self-referential binding (`x ↦ var{x}` — the symbolic
            --- parameter binding used by `check_pi_intro_` and by
            --- `instantiate_ctor_` for dependent constructor domains)
            --- must stay symbolic: recursing on it would spin until the
            --- fuel breaker trips, poisoning every later judgment.
            if bound == null || bound == term {
              { val: term, state: s }
            } else {
              funcs.eval_term_(funcs, s, bound)
            }
          }
        } else {
          if tag == "Lam" {
            { val: funcs.make_type("LamVal", set(set(set({}, "params", get_or(term, "params", [])), "body", get_or(term, "body", 0)), "env", s.results)), state: s }
          } else {
            if tag == "App" {
              do {
                callee_result :: funcs.eval_term_(funcs, s, get_or(term, "callee", null))
                arg_result :: while { result: [], state: callee_result["state"], remaining: get_or(term, "args", []) } {
                  [st]~> if is_empty(st.remaining) {
                    { out: { vals: st.result, state: st["state"] } }
                  } else {
                    do {
                      av :: funcs.eval_term_(funcs, st["state"], first_value(st.remaining))
                      { state: { result: [...st.result, av.val], state: av["state"], remaining: drop(st.remaining, 1) } }
                    }
                  }
                }
                funcs.apply_val_(funcs, arg_result["state"], callee_result.val, arg_result.vals)
              }
            } else {
              if tag == "Comp" {
                do {
                  l_result :: funcs.eval_term_(funcs, s, get_or(term, "l", null))
                  r_result :: funcs.eval_term_(funcs, l_result["state"], get_or(term, "r", null))
                  l_val :: l_result.val
                  r_val :: r_result.val
                  if funcs.is_applicable_(funcs, r_val) && !funcs.is_applicable_(funcs, l_val) {
                    funcs.apply_val_(funcs, r_result["state"], r_val, [l_val])
                  } else {
                    if funcs.is_applicable_(funcs, l_val) && funcs.is_applicable_(funcs, r_val) {
                      { val: funcs.make_type("CompVal", set(set({}, "l", l_val), "r", r_val)), state: r_result["state"] }
                    } else {
                      { val: funcs.make_type("Comp", set(set({}, "l", l_val), "r", r_val)), state: r_result["state"] }
                    }
                  }
                }
              } else {
                if tag == "Bin" {
                  funcs.eval_bin_(funcs, s, get_or(term, "op", ""), get_or(term, "l", null), get_or(term, "r", null))
                } else {
                  if tag == "Un" {
                    do {
                      operand_result :: funcs.eval_term_(funcs, s, get_or(term, "operand", null))
                      v :: operand_result.val
                      un_op :: get_or(term, "op", "")
                      if un_op == "unary.neg" && type_of(v) == "num" {
                        { val: 0 - v, state: operand_result["state"] }
                      } else {
                        if un_op == "unary.not" && type_of(v) == "bool" {
                          { val: !v, state: operand_result["state"] }
                        } else {
                          { val: funcs.make_type("Un", set(set({}, "op", un_op), "operand", v)), state: operand_result["state"] }
                        }
                      }
                    }
                  } else {
                  if tag == "If" {
                    do {
                      cond_result :: funcs.eval_term_(funcs, s, get_or(term, "cond", null))
                      if cond_result.val == true {
                        funcs.eval_term_(funcs, cond_result["state"], get_or(term, "then", null))
                      } else {
                        if cond_result.val == false {
                          funcs.eval_term_(funcs, cond_result["state"], get_or(term, "else", null))
                        } else {
                          { val: term, state: cond_result["state"] }
                        }
                      }
                    }
                  } else {
                    if tag == "ArrLit" {
                      do {
                        element_result :: while { result: [], state: s, remaining: get_or(term, "elements", []), ok: true } {
                          [st]~> if is_empty(st.remaining) {
                            { out: { vals: st.result, state: st["state"], ok: st.ok } }
                          } else {
                            do {
                              ev :: funcs.eval_term_(funcs, st["state"], first_value(st.remaining))
                              { state: { result: [...st.result, ev.val], state: ev["state"], remaining: drop(st.remaining, 1), ok: st.ok && type_tag(ev.val) == "" } }
                            }
                          }
                        }
                        if element_result.ok {
                          { val: element_result.vals, state: element_result["state"] }
                        } else {
                          { val: funcs.make_type("ArrLit", set({}, "elements", element_result.vals)), state: element_result["state"] }
                        }
                      }
                    } else {
                      { val: term, state: s }
                    }
                  }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  eval_node_ :: [funcs, s, node_idx]~> do {
    term :: funcs.node_term_(funcs, s, node_idx)
    funcs.eval_term_(funcs, s, term)
  }

  --- funcs record: resolves the mutual recursion cycle ---
  --- Created after all four functions are defined so each can look ---
  --- up its siblings via funcs.fn_name(funcs, ...) at call time. ---
  funcs :: ({
    synth_node_: synth_node_,
    check_node_: check_node_,
    eval_scheme_: eval_scheme_,
    eval_judgment_: eval_judgment_,
    synth_type_: synth_type_,
    node_term_: node_term_,
    collect_var_names_: collect_var_names_,
    bind_pattern_vars_: bind_pattern_vars_,
    is_applicable_: is_applicable_,
    apply_val_: apply_val_,
    eval_bin_: eval_bin_,
    eval_term_: eval_term_,
    eval_node_: eval_node_,
    function_params_: function_params_,
    dep_closure_from_: dep_closure_from_,
    synth_dep_former_: synth_dep_former_,
    apply_dep_closure_: apply_dep_closure_,
    check_pi_intro_: check_pi_intro_,
    check_sigma_intro_: check_sigma_intro_,
    check_family_arrow_: check_family_arrow_,
    check_dependent_: check_dependent_,
    check_dependent_fallback_: check_dependent_fallback_,
    unify_dependent_: unify_dependent_,
    unify_fn_pi_: unify_fn_pi_,
    unify_dep_bodies_: unify_dep_bodies_,
    paths_in_scope_: paths_in_scope_,
    unify_via_paths_: unify_via_paths_,
    resolve_path_: resolve_path_,
    check_path_intro_: check_path_intro_,
    synth_transport_: synth_transport_,
    synth_j_: synth_j_,
    collect_ctor_names_: collect_ctor_names_,
    collect_ctor_specs_: collect_ctor_specs_,
    instantiate_ctor_: instantiate_ctor_,
    flow_cod_: flow_cod_,
    flow_compose_: flow_compose_,
    cell_dom_: cell_dom_,
    cell_cod_: cell_cod_,
    cell_boundary_: cell_boundary_,
    cell_paste_: cell_paste_,
    cell_type_name_: cell_type_name_,
    axis_flow_compose_: axis_flow_compose_,
    make_type: make_type,
    sanitize: tc_sanitize,
    add_diagnostic: tc_add_diagnostic,
    set: set
  })

  --- Wrapper functions (public API) ---

  synth_node :: [s, node_idx]~> funcs.synth_node_(funcs, s, node_idx)

  synth_type :: [s, node_idx]~> funcs.synth_type_(funcs, s, node_idx)

  check_node :: [s, node_idx, expected]~> funcs.check_node_(funcs, s, node_idx, expected)

  eval_scheme :: [s, node_idx, term, incoming]~> funcs.eval_scheme_(funcs, s, node_idx, term, incoming)

  typecheck_ :: [self, lang, ast, prelude]~> if is_empty(ast) {
    { typ: null, diagnostics: [], node_types: [] }
  } else {
    do {
      root_idx :: len(ast) - 1
      types_arr :: get_or(lang, "types", [])
      ast_arr :: get_or(lang, "ast", [])
      type_index :: index_type_rules(types_arr)
      ast_index :: index_type_rules(ast_arr)
      s :: tc_new(ast, type_index, ast_index, prelude, get_or(lang, "globals", {}))
      result :: funcs.synth_node_(funcs, s, root_idx)
      zonked :: zonk(zonk, result.typ, result["state"].metas)
      final_state :: if zonked == null { funcs.add_diagnostic(result["state"], "warning", "typecheck result was null; defaulting to type.unknown") } else { result["state"] }
      final_typ :: if zonked == null { funcs.make_type("type.unknown", {}) } else { zonked }
      { typ: final_typ, diagnostics: final_state.diagnostics, node_types: final_state.node_types }
    }
  }

  typecheck :: [lang, ast, prelude]~> typecheck_(typecheck_, lang, ast, prelude)

  --- Public record. `eval_scheme` drives a scheme term through the same
  --- dispatch the typechecker uses (`eval_scheme_` -> `eval_scheme_impl_` ->
  --- `eval_judgment_impl_`). Exported alongside the other inspection helpers
  --- so judgment rules (e.g. `subtype`) can be exercised directly.
  {
    typecheck: typecheck,
    synth: [s, node_idx]~> funcs.synth_node_(funcs, s, node_idx),
    synth_type: [s, node_idx]~> funcs.synth_type_(funcs, s, node_idx),
    check: [s, node_idx, expected]~> funcs.check_node_(funcs, s, node_idx, expected),
    unify: [a, b, metas]~> unify_(unify_, funcs, a, b, metas),
    extend: [s, name, typ]~> tc_extend(s, name, typ),
    lookup: [s, name]~> tc_lookup(s, name),
    eval_scheme: eval_scheme
  }
}
