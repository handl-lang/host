{
  is_number: 42 is type.num,
  is_not_number: 42 is type.str,
  is_string: "hello" is type.str,
  is_bool: true is type.bool,
  is_array: [1, 2] is type.arr,
  is_object: {a: 1} is type.obj,
  is_field: {name: "alice"} is field.name,
  not_number: 42 not type.str,
  may_number: "oops" may type.num,
  must_number: 42 must type.num,
  when_number: "x" when type.num else 0
}
