// Axioms for list primitives.
//
// These carry conditional contracts with real semantic content so that
// inference can derive non-trivial guarantees like Sorted and LengthEq.

// -- Constructors ----------------------------------------------------

axiom list.cons : (a * List a) -> List a
  requires:  Sorted(tail) && Le(head, head_of_tail)
  guarantee: Sorted(output) && LengthPlusOne(output, tail) && IsPerm(output, output)

axiom cons : (a * List a) -> List a
  requires:  Sorted(tail) && Le(head, head_of_tail)
  guarantee: Sorted(output) && LengthPlusOne(output, tail) && IsPerm(output, output)

// -- Accessors -------------------------------------------------------

axiom list.head : List a -> a
  requires:  Sorted(input)
  guarantee: True

axiom list.tail : List a -> List a
  requires:  Sorted(input)
  guarantee: Sorted(output) && LengthSubOne(output, input) && IsPerm(output, output)

axiom list.is_empty : List a -> Bool
  guarantee: True

axiom list.length : List a -> Int
  guarantee: True

axiom list.nth : (List a * Int) -> a
  guarantee: True

// -- Transformations -------------------------------------------------

axiom list.append : (List a * List a) -> List a
  requires:  True
  guarantee: True

axiom list.reverse : List a -> List a
  guarantee: LengthEq(output, input)

// -- Identity & application ------------------------------------------

axiom id : a -> a
  guarantee: True

axiom fn.apply : (a * a) -> a
  guarantee: True

// -- Loop-step atoms (used by fn/* and collection/* arrows) ----------

axiom filter_step : List a -> List a
  guarantee: AllSatisfy(output, predicate) && LengthLe(output, input)

axiom fold_step : (a * a) -> a
  guarantee:  True
  termination: decrements_length
