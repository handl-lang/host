-- Axioms for irreducible Rust primitives.
-- These are the foundation -- everything else is derived.

axiom prim.add : (Int × Int) -> Int
  guarantee: True

axiom prim.compare : (α × β) -> Int
  guarantee: Le(output, 1)

axiom prim.alloc : Int -> List α
  guarantee: LengthEq(output, 0)

axiom prim.sub : (Int × Int) -> Int
  guarantee: True

axiom prim.mul : (Int × Int) -> Int
  guarantee: True

axiom prim.le : (Int × Int) -> Bool
  guarantee: True

axiom prim.eq : (α × α) -> Bool
  guarantee: True
