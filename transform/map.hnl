--- Map a function over a list, preserving order
export map :: do {
  rev :: xs ~> {
    while { xs: xs, acc: [] } {
      [xs, acc] ~> match xs {
        []: { out: acc },
        [h, ...t]: { state: { xs: t, acc: [h, ...acc] } }
      }
    }
  }
  [xs, f] ~> {
    while { xs: xs, acc: [] } {
      [xs, acc] ~> match xs {
        []: { out: rev(acc) },
        [h, ...t]: { state: { xs: t, acc: [f(h), ...acc] } }
      }
    }
  }
}
