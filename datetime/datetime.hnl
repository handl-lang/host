--- datetime -- pure-handl date/time module (proleptic Gregorian calendar).
---
--- Pure handl implementation of the `datetime` contract:
--- `handl-packages/datetime/datetime.hnl` loads helpers from
--- `handl-packages/datetime/helpers.hnl` and exports a single record of
--- functions. No `cap`/`op`/`handle` lines are needed — the whole module is
--- effect-free handl code using only `math`, `str`, `char`, `typeof`, and
--- `error` (no clock access, no host dispatch).
---
cap "datetime.from_unix"
cap "datetime.to_unix"
cap "datetime.from_components"
cap "datetime.format"
cap "datetime.parse"
cap "datetime.to_timezone"
cap "datetime.to_utc"
cap "datetime.year"
cap "datetime.month"
cap "datetime.day"
cap "datetime.hour"
cap "datetime.minute"
cap "datetime.second"
cap "datetime.weekday"
cap "datetime.day_of_year"
cap "datetime.week_of_year"
cap "datetime.quarter"
cap "datetime.is_leap_year"
cap "datetime.is_weekend"
cap "datetime.add_seconds"
cap "datetime.add_minutes"
cap "datetime.add_hours"
cap "datetime.add_days"
cap "datetime.add_weeks"
cap "datetime.add_months"
cap "datetime.add_years"
cap "datetime.compare"
cap "datetime.is_before"
cap "datetime.is_after"
cap "datetime.is_equal"
cap "datetime.is_between"
cap "datetime.is_between_inclusive"
cap "datetime.duration_between"
cap "datetime.duration_seconds"
cap "datetime.duration_minutes"
cap "datetime.duration_hours"
cap "datetime.duration_days"
cap "datetime.start_of_day"
cap "datetime.end_of_day"
cap "datetime.start_of_hour"
cap "datetime.end_of_hour"
cap "datetime.start_of_month"
cap "datetime.end_of_month"
cap "datetime.start_of_year"
cap "datetime.end_of_year"
cap "datetime.is_valid"
op "datetime.from_unix" : Number -> String
  guarantee: IsString(output)
op "datetime.to_unix" : String -> Number
  guarantee: True
op "datetime.from_components" : (Number, Number, Number, Number, Number, Number) -> String
  guarantee: IsString(output)
op "datetime.format" : (String, String) -> String
  guarantee: IsString(output)
op "datetime.parse" : (String, String) -> String
  guarantee: IsString(output)
op "datetime.to_timezone" : (String, String) -> String
  guarantee: IsString(output)
op "datetime.to_utc" : String -> String
  guarantee: IsString(output)
op "datetime.year" : String -> Number
  guarantee: True
op "datetime.month" : String -> Number
  guarantee: NonNeg(output)
op "datetime.day" : String -> Number
  guarantee: NonNeg(output)
op "datetime.hour" : String -> Number
  guarantee: NonNeg(output)
op "datetime.minute" : String -> Number
  guarantee: NonNeg(output)
op "datetime.second" : String -> Number
  guarantee: NonNeg(output)
op "datetime.weekday" : String -> Number
  guarantee: NonNeg(output)
op "datetime.day_of_year" : String -> Number
  guarantee: NonNeg(output)
op "datetime.week_of_year" : String -> Number
  guarantee: NonNeg(output)
op "datetime.quarter" : String -> Number
  guarantee: NonNeg(output)
op "datetime.is_leap_year" : String -> Bool
  guarantee: True
op "datetime.is_weekend" : String -> Bool
  guarantee: True
op "datetime.add_seconds" : (String, Number) -> String
  guarantee: IsString(output)
op "datetime.add_minutes" : (String, Number) -> String
  guarantee: IsString(output)
op "datetime.add_hours" : (String, Number) -> String
  guarantee: IsString(output)
op "datetime.add_days" : (String, Number) -> String
  guarantee: IsString(output)
op "datetime.add_weeks" : (String, Number) -> String
  guarantee: IsString(output)
op "datetime.add_months" : (String, Number) -> String
  guarantee: IsString(output)
op "datetime.add_years" : (String, Number) -> String
  guarantee: IsString(output)
op "datetime.compare" : (String, String) -> Number
  guarantee: Le(output, 1)
op "datetime.is_before" : (String, String) -> Bool
  guarantee: True
op "datetime.is_after" : (String, String) -> Bool
  guarantee: True
op "datetime.is_equal" : (String, String) -> Bool
  guarantee: True
op "datetime.is_between" : (String, String, String) -> Bool
  guarantee: True
op "datetime.is_between_inclusive" : (String, String, String) -> Bool
  guarantee: True
op "datetime.duration_between" : (String, String) -> Number
  guarantee: True
op "datetime.duration_seconds" : (String, String) -> Number
  guarantee: True
op "datetime.duration_minutes" : (String, String) -> Number
  guarantee: True
op "datetime.duration_hours" : (String, String) -> Number
  guarantee: True
op "datetime.duration_days" : (String, String) -> Number
  guarantee: True
op "datetime.start_of_day" : String -> String
  guarantee: IsString(output)
op "datetime.end_of_day" : String -> String
  guarantee: IsString(output)
op "datetime.start_of_hour" : String -> String
  guarantee: IsString(output)
op "datetime.end_of_hour" : String -> String
  guarantee: IsString(output)
op "datetime.start_of_month" : String -> String
  guarantee: IsString(output)
op "datetime.end_of_month" : String -> String
  guarantee: IsString(output)
op "datetime.start_of_year" : String -> String
  guarantee: IsString(output)
op "datetime.end_of_year" : String -> String
  guarantee: IsString(output)
op "datetime.is_valid" : String -> Bool
  guarantee: True

from "./helpers" import * as H

do {
  from_unix: ([ts]) ~> do {
    frac_ns :: (ts - H.math.floor_div(ts, 1)) * 1000000000
    en :: H.math.floor_div(frac_ns, 1)
    ns :: if en >= 0 { en } else { en + 1000000000 }
    ref :: H.stamp_of(1970, 1, 1, 0, 0, 0, 0, 0)
    sec :: H.days_in_sec(ref.sec + ts)
    ns2 :: ref.ns + ns
    if ns2 >= 1000000000 { sec + 1 } else { sec }
    H.fmt_stamp(sec, ns2)
  }

  to_unix: ([s]) ~> do {
    p :: H.parse_stamp(s)
    if p != null { H.stamp_seconds(p) } else { null }
  }

  from_components: ([y, m, d]) ~> do {
    yy :: y
    mm :: m
    dd :: d
    p :: H.parse_stamp(H.pad4(yy) + "-" + H.pad2(mm) + "-" + H.pad2(dd) + "T00:00:00")
    if p != null { H.fmt_stamp(p.sec, p.ns) } else { null }
  }

  format: ([s, fmt]) ~> do {
    p :: H.parse_stamp(s)
    if p != null { H.strftime(fmt, p.sec, p.ns) } else { null }
  }

  parse: ([s, fmt]) ~> do {
    p :: H.parse_stamp(s)
    if p != null { H.strftime(fmt, p.sec, p.ns) } else { null }
  }

  to_timezone: ([s, offstr]) ~> do {
    p :: H.parse_stamp(s)
    if p != null { H.fmt_stamp(p.sec + H.off_seconds(1, offstr), p.ns) } else { null }
  }

  to_utc: ([s]) ~> do {
    p :: H.parse_stamp(s)
    if p != null { H.fmt_stamp(p.sec, p.ns) } else { null }
  }

  year: ([s]) ~> do {
    p :: H.parse_stamp(s)
    if p != null { p.y } else { null }
  }

  month: ([s]) ~> do {
    p :: H.parse_stamp(s)
    if p != null { p.m } else { null }
  }

  day: ([s]) ~> do {
    p :: H.parse_stamp(s)
    if p != null { p.d } else { null }
  }

  hour: ([s]) ~> do {
    p :: H.parse_stamp(s)
    sod :: H.sec_of_day(p.sec)
    if p != null { H.math.floor_div(sod, 3600) } else { null }
  }

  minute: ([s]) ~> do {
    p :: H.parse_stamp(s)
    sod :: H.sec_of_day(p.sec)
    hh :: H.math.floor_div(sod, 3600)
    if p != null { H.math.floor_div(sod - hh * 3600, 60) } else { null }
  }

  second: ([s]) ~> do {
    p :: H.parse_stamp(s)
    sod :: H.sec_of_day(p.sec)
    hh :: H.math.floor_div(sod, 3600)
    mi :: H.math.floor_div(sod - hh * 3600, 60)
    if p != null { sod - hh * 3600 - mi * 60 } else { null }
  }

  day_of_year: ([s]) ~> do {
    p :: H.parse_stamp(s)
    if p != null { H.day_of_year(p.y, p.m, p.d) } else { null }
  }

  weekday: ([s]) ~> do {
    p :: H.parse_stamp(s)
    if p != null { H.math.mod(p.sec + 3, 7) + 1 } else { null }
  }

  week_of_year: ([s]) ~> do {
    p :: H.parse_stamp(s)
    d :: H.days_in_sec(p.sec)
    c :: H.civil_from_days(d)
    first :: H.days_from_civil(c.y, 1, 1)
    adjust :: H.math.floor_div(6 - H.weekday_mon1(first), 7)
    mon :: H.days_from_civil(c.y, 1, adjust + 4)
    if d < mon { 1 } else { H.math.floor_div(d - mon, 7) + 1 }
  }

  quarter: ([s]) ~> do {
    p :: H.parse_stamp(s)
    if p != null { H.math.floor_div(p.m - 1, 3) + 1 } else { null }
  }

  is_leap_year: ([s]) ~> do {
    p :: H.parse_stamp(s)
    if p != null { H.is_leap(p.y) } else { null }
  }

  is_weekend: ([s]) ~> do {
    p :: H.parse_stamp(s)
    wd :: H.math.mod(p.sec + 3, 7) + 1
    if p != null { wd == 6 || wd == 7 } else { null }
  }
  add_seconds: ([s, amt]) ~> do {
    p :: H.parse_stamp(s)
    if p != null { H.fmt_stamp(p.sec + H.math.floor_div(amt, 1), (amt - H.math.floor_div(amt, 1)) * 1000000000) } else { null }
  }

  add_minutes: ([s, amt]) ~> add_seconds(s, amt * 60)

  add_hours: ([s, amt]) ~> add_seconds(s, amt * 3600)

  add_days: ([s, amt]) ~> add_seconds(s, amt * 86400)

  add_weeks: ([s, amt]) ~> add_seconds(s, amt * 604800)

  add_months: ([s, amt]) ~> do {
    p :: H.parse_stamp(s)
    if p != null {
      d :: H.days_in_sec(p.sec)
      c :: H.civil_from_days(d)
      tot :: (c.y - if c.m <= 2 then 1 else 0) * 12 + (c.m - 1) + amt
      ny :: H.math.floor_div(tot, 12)
      nm :: (tot - ny * 12) % 12 + 1
      dd2 :: if p.d > H.days_in_month(ny, nm) then H.days_in_month(ny, nm) else p.d
      nd :: H.days_from_civil(ny, nm, dd2)
      sec :: nd * 86400 + H.sec_of_day(p.sec)
      H.fmt_stamp(sec, p.ns)
    } else { null }
  }

  add_years: ([s, amt]) ~> add_months(s, amt * 12)

  compare: ([a, b]) ~> do {
    pa :: H.parse_stamp(a)
    pb :: H.parse_stamp(b)
    if pa != null && pb != null {
      if pa.sec < pb.sec then -1 else {
        if pa.sec > pb.sec then 1 else 0
      }
    } else { null }
  }

  is_before: ([a, b]) ~> do {
    pa :: H.parse_stamp(a)
    pb :: H.parse_stamp(b)
    if pa != null && pb != null { pa.sec < pb.sec } else { null }
  }

  is_after: ([a, b]) ~> do {
    pa :: H.parse_stamp(a)
    pb :: H.parse_stamp(b)
    if pa != null && pb != null { pa.sec > pb.sec } else { null }
  }

  is_equal: ([a, b]) ~> do {
    pa :: H.parse_stamp(a)
    pb :: H.parse_stamp(b)
    if pa != null && pb != null { pa.sec == pb.sec && pa.ns == pb.ns } else { null }
  }

  is_between: ([x, a, b]) ~> do {
    px :: H.parse_stamp(x)
    pa :: H.parse_stamp(a)
    pb :: H.parse_stamp(b)
    if px != null && pa != null && pb != null { pa.sec < px.sec && px.sec < pb.sec } else { null }
  }

  is_between_inclusive: ([x, a, b]) ~> do {
    px :: H.parse_stamp(x)
    pa :: H.parse_stamp(a)
    pb :: H.parse_stamp(b)
    if px != null && pa != null && pb != null { pa.sec <= px.sec && px.sec <= pb.sec } else { null }
  }

  duration_between: ([a, b]) ~> do {
    pa :: H.parse_stamp(a)
    pb :: H.parse_stamp(b)
    if pa != null && pb != null {
      secs :: pb.sec - pa.sec
      { seconds: secs, minutes: secs / 60, hours: secs / 3600, days: secs / 86400 }
    } else { null }
  }

  duration_seconds: ([a, b]) ~> do {
    pa :: H.parse_stamp(a)
    pb :: H.parse_stamp(b)
    if pa != null && pb != null { pb.sec - pa.sec } else { null }
  }

  duration_minutes: ([a, b]) ~> do {
    pa :: H.parse_stamp(a)
    pb :: H.parse_stamp(b)
    if pa != null && pb != null { (pb.sec - pa.sec) / 60 } else { null }
  }

  duration_hours: ([a, b]) ~> do {
    pa :: H.parse_stamp(a)
    pb :: H.parse_stamp(b)
    if pa != null && pb != null { (pb.sec - pa.sec) / 3600 } else { null }
  }

  duration_days: ([a, b]) ~> do {
    pa :: H.parse_stamp(a)
    pb :: H.parse_stamp(b)
    if pa != null && pb != null { (pb.sec - pa.sec) / 86400 } else { null }
  }

  start_of_day: ([s]) ~> do {
    p :: H.parse_stamp(s)
    if p != null { H.fmt_stamp(H.days_in_sec(p.sec) * 86400, 0) } else { null }
  }

  end_of_day: ([s]) ~> do {
    p :: H.parse_stamp(s)
    if p != null { H.fmt_stamp(H.days_in_sec(p.sec) * 86400 + 86399, 0) } else { null }
  }

  start_of_hour: ([s]) ~> do {
    p :: H.parse_stamp(s)
    if p != null { H.fmt_stamp(p.sec - H.sec_of_day(p.sec) % 3600, 0) } else { null }
  }

  end_of_hour: ([s]) ~> do {
    p :: H.parse_stamp(s)
    if p != null { H.fmt_stamp(p.sec - H.sec_of_day(p.sec) % 3600 + 3599, 0) } else { null }
  }

  start_of_month: ([s]) ~> do {
    p :: H.parse_stamp(s)
    if p != null {
      c :: H.civil_from_days(H.days_in_sec(p.sec))
      nd :: H.days_from_civil(c.y, c.m, 1)
      H.fmt_stamp(nd * 86400, 0)
    } else { null }
  }

  end_of_month: ([s]) ~> do {
    p :: H.parse_stamp(s)
    if p != null {
      c :: H.civil_from_days(H.days_in_sec(p.sec))
      nxt :: H.days_from_civil(if c.m == 12 then c.y + 1 else c.y, 1, 1)
      ed :: nxt - 1
      H.fmt_stamp(ed * 86400 + 86399, 0)
    } else { null }
  }

  start_of_year: ([s]) ~> do {
    p :: H.parse_stamp(s)
    if p != null {
      c :: H.civil_from_days(H.days_in_sec(p.sec))
      nd :: H.days_from_civil(c.y, 1, 1)
      H.fmt_stamp(nd * 86400, 0)
    } else { null }
  }

  end_of_year: ([s]) ~> do {
    p :: H.parse_stamp(s)
    if p != null {
      c :: H.civil_from_days(H.days_in_sec(p.sec))
      nxt :: H.days_from_civil(c.y + 1, 1, 1)
      ed :: nxt - 1
      H.fmt_stamp(ed * 86400 + 86399, 0)
    } else { null }
  }

  is_valid: ([s]) ~> do {
    H.parse_stamp(s) != null
  }
}
