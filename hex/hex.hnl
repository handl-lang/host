--- hex.encode -- encode a string to hexadecimal.
--- hex.decode -- decode a hexadecimal string.
cap "hex.encode"
cap "hex.decode"
op "hex.encode" : String -> String
  guarantee: IsHex(output)
op "hex.decode" : String -> String
  guarantee: True

handle "hex.encode" with rust_hex_encode
handle "hex.decode" with rust_hex_decode
