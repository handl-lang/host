--- intl -- internationalization library for the handl runtime, backed by ICU4X.
---
--- Provides locale-aware functions for formatting numbers, selecting
--- plural categories, formatting lists, relative time, dates, durations,
--- comparing strings, display names, and text segmentation.
---
--- All locale data is provided by ICU4X's compiled_data feature,
--- which bundles CLDR data at compile time (600+ locales).
---
--- ## number formatting
--- intl.format_number -- format a number for a locale with optional options.
--- intl.format_number_to_parts -- format a number into parts array for a locale.
---
--- ## plural selection
--- intl.select_plural -- select the plural category for a number in a locale.
---
--- ## list formatting
--- intl.format_list -- format an array of items as a list for a locale.
---
--- ## relative time formatting
--- intl.format_relative_time -- format a value and unit as relative time for a locale.
---
--- ## date formatting
--- intl.format_date -- format a date string for a locale with optional options.
--- intl.format_date_to_parts -- format a date into parts array for a locale.
---
--- ## duration formatting
--- intl.format_duration -- format a duration in seconds for a locale.
---
--- ## string comparison
--- intl.compare_strings -- compare two strings using locale-aware collation.
---
--- ## display names
--- intl.display_name -- get a display name for a code (language, region, script) in a locale.
---
--- ## text segmentation
--- intl.segment -- segment text by granularity (grapheme, word, sentence, line) for a locale.
---
--- ## locale utilities
--- intl.locale -- parse a BCP 47 locale tag and return its components.
--- intl.get_canonical_locales -- canonicalize a locale or list of locales.
--- intl.supported_locales_of -- filter requested locales to those supported by the data provider.
cap "intl.format_number"
cap "intl.format_number_to_parts"
cap "intl.select_plural"
cap "intl.format_list"
cap "intl.format_relative_time"
cap "intl.format_date"
cap "intl.format_date_to_parts"
cap "intl.format_duration"
cap "intl.compare_strings"
cap "intl.display_name"
cap "intl.segment"
cap "intl.locale"
cap "intl.get_canonical_locales"
cap "intl.supported_locales_of"

op "intl.format_number" : Value -> Value
  guarantee: True
op "intl.format_number_to_parts" : Value -> Value
  guarantee: True
op "intl.select_plural" : Value -> Value
  guarantee: True
op "intl.format_list" : Value -> Value
  guarantee: True
op "intl.format_relative_time" : Value -> Value
  guarantee: True
op "intl.format_date" : Value -> Value
  guarantee: True
op "intl.format_date_to_parts" : Value -> Value
  guarantee: True
op "intl.format_duration" : Value -> Value
  guarantee: True
op "intl.compare_strings" : Value -> Value
  guarantee: True
op "intl.display_name" : Value -> Value
  guarantee: True
op "intl.segment" : Value -> Value
  guarantee: True
op "intl.locale" : Value -> Value
  guarantee: True
op "intl.get_canonical_locales" : Value -> Value
  guarantee: True
op "intl.supported_locales_of" : Value -> Value
  guarantee: True

handle "intl.format_number" with rust_intl_format_number
handle "intl.format_number_to_parts" with rust_intl_format_number_to_parts
handle "intl.select_plural" with rust_intl_select_plural
handle "intl.format_list" with rust_intl_format_list
handle "intl.format_relative_time" with rust_intl_format_relative_time
handle "intl.format_date" with rust_intl_format_date
handle "intl.format_date_to_parts" with rust_intl_format_date_to_parts
handle "intl.format_duration" with rust_intl_format_duration
handle "intl.compare_strings" with rust_intl_compare_strings
