--- Internationalization contract for the handl runtime.
---
--- This package is the *abstraction*: it declares the arrow types of the
--- `intl` surface. Backends (`intl-c` over system ICU4C, the Rust
--- `lib.intl` plugin, a future pure-handl backend, ...) export arrows of
--- these types; a backend conforms by exporting the same names at these
--- signatures.
---
--- Locale arguments are `Value` (a `String` BCP-47 tag, or `null` for the
--- host default locale) until the contract grows a `Locale` record type.
--- Trailing `Value` params are option records — `null`/absent fields mean
--- "backend default" (e.g. `{ style: "currency", currency: "EUR" }` for
--- FormatNumber, `{ sensitivity: "base" }` for CompareStrings).
--- All backends return `Result` values — expected backend failures
--- (missing data, bad locale, library error) are `err`, never raises.
---
--- `~[1]~>` marks the surface as effectful: every current backend reaches
--- a native library or host process.

from "result" import { Result }

-- collation ------------------------------------------------------------------

--- Compare two strings under locale-aware collation.
--- `ok -1 | 0 | 1`, or `err msg`.
export CompareStrings := (String, String, Value, Value) ~[1]~> Result<Int, String>

-- number formatting ----------------------------------------------------------

--- Format a number for a locale.
--- `ok "1,234.5"`, or `err msg`.
export FormatNumber := (Value, Value, Value) ~[1]~> Result<String, String>

--- Format a number into named parts (integer, fraction, group, ...).
export FormatNumberToParts := (Value, Value, Value) ~[1]~> Result<Value, String>

-- plural selection -----------------------------------------------------------

--- Select the plural category of a number in a locale.
--- `ok "one" | "few" | "other" | ...`, or `err msg`.
export SelectPlural := (Value, Value, Value) ~[1]~> Result<String, String>

-- list / relative-time / date / duration formatting ----------------------------

--- Format a list of strings for a locale (`"a, b, and c"`).
export FormatList := (Value, Value, Value) ~[1]~> Result<String, String>

--- Format a value + unit as relative time (`"3 days ago"`).
export FormatRelativeTime := (Value, Value, Value, Value) ~[1]~> Result<String, String>

--- Format a date for a locale with options.
export FormatDate := (Value, Value, Value) ~[1]~> Result<String, String>

--- Format a date into named parts.
export FormatDateToParts := (Value, Value, Value) ~[1]~> Result<Value, String>

--- Format a duration in seconds for a locale.
export FormatDuration := (Value, Value, Value) ~[1]~> Result<String, String>

-- display names / segmentation / locale utilities ------------------------------

--- Display name for a code (language, region, script) in a locale.
export DisplayName := (Value, Value, Value, Value) ~[1]~> Result<String, String>

--- Segment text by granularity (grapheme, word, sentence, line).
export Segment := (String, Value, Value, Value) ~[1]~> Result<Value, String>

--- Parse a BCP-47 locale tag into its components.
export Locale := (String, Value) ~[1]~> Result<Value, String>

--- Canonicalize a locale or list of locales.
export GetCanonicalLocales := (Value) ~[1]~> Result<Value, String>

--- Filter requested locales to those the backend's data supports.
export SupportedLocalesOf := (Value, Value) ~[1]~> Result<Value, String>
