--- Round-trip tests for the gzip-format `compress` backend.

from "./compress-gzip-c" import * as gzip_c
from "bytes" import * as bytes

payload := bytes.utf8_encode("hello hello hello, gzip me please")

--- A gzip stream starts with the 1f 8b magic bytes.
test_gzip_magic := assert bytes.to_list(bytes.slice(gzip_c.compress(payload), 0, 2)) = [31, 139]

test_gzip_roundtrip := assert bytes.utf8_decode(gzip_c.decompress(gzip_c.compress(payload))) = "hello hello hello, gzip me please"

test_gzip_compresses := assert bytes.len(gzip_c.compress(payload)) < bytes.len(payload) + 64
