--- Deterministic, no-effect environment stubs for tests and benchmarks.

--- Always returns null.
--- @param {_name} - ignored; present for contract compatibility
--- @returns {Value - always null}
export get: String ~> Value := (_name) ~> null

--- Always returns false.
--- @param {_name} - ignored; present for contract compatibility
--- @returns {Bool - always false}
export has: String ~> Bool := (_name) ~> false
