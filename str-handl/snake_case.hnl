--- `str.snake_case` — part of `str-handl`, the pure-Handl `str` implementation over `char`.

from "./internal/split_words.hnl" import split_words
from "./join.hnl" import join

--- Converts `s` to `snake_case`.
---
--- @details
--- Splits on `-`, `_`, ` `, lowercase -> uppercase transitions, and
--- acronym -> word boundaries (see `internal/split_words.hnl`), then
--- joins the lowercase words with `_`.
---
--- @param {s} - the input string
--- @returns {String - `s` in snake_case}
--- @example
--- `str.snake_case("helloWorld-again")`
--- -- => "hello_world_again"
---
export snake_case := (s) ~> do {
  join(split_words(s), "_")
}
