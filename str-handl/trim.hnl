--- `str.trim` — part of `str-handl`, the pure-Handl `str` implementation over `char`.

from "char" import * as char

--- Removes leading and trailing whitespace.
---
--- @param {s} - the input string
--- @returns {String - `s` with whitespace stripped from both ends}
--- @example
--- `str.trim("  hi  ")`
--- -- => "hi"
---
--- @details Two index scans and one `char.slice`. The previous form ran
--- three list rebuilds (`drop_while`, `rev`, `drop_while`) whose per-element
--- prepends are quadratic — a 1000-char `trim` cost ~138ms.
export trim := (s) ~> do {
  n :: char.length(s)
  i :: while { s: s, i: 0, n: n } {
    (st) ~> if st.i >= st.n {
      { out: st.i }
    } else if char.is_whitespace(char.at(st.s, st.i)) {
      { state: { s: st.s, i: st.i + 1, n: st.n } }
    } else {
      { out: st.i }
    }
  }
  j :: while { s: s, j: n, lo: i } {
    (st) ~> if st.j <= st.lo {
      { out: st.lo }
    } else if char.is_whitespace(char.at(st.s, st.j - 1)) {
      { state: { s: st.s, j: st.j - 1, lo: st.lo } }
    } else {
      { out: st.j }
    }
  }
  char.slice(s, i, j)
}
