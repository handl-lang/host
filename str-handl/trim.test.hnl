from "./trim" import * as m

test_trim_both := assert m.trim("  hi  ") = "hi"

test_trim_empty := assert m.trim("") = ""

test_trim_none := assert m.trim("hi") = "hi"

test_trim_all_ws := assert m.trim("   ") = ""

test_trim_tabs := assert m.trim("\thi\t") = "hi"

test_trim_inner_kept := assert m.trim("  a  b  ") = "a  b"

test_trim_newlines := assert m.trim("\n hi \n") = "hi"
