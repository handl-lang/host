--- `str.trim_start` — part of `str-handl`, the pure-Handl `str` implementation over `char`.

from "char" import * as char

--- Removes leading whitespace.
---
--- @param {s} - the input string
--- @returns {String - `s` with leading whitespace stripped}
--- @example
--- `str.trim_start("  hi  ")`
--- -- => "hi  "
---
--- @details Scans for the first non-whitespace char index and takes one
--- `char.slice`. The previous form rebuilt the char list per element
--- (`drop_while` prepends then `rev`s), which is quadratic in the run
--- length and made every `trim_start` on a source line cost ~1ms per
--- character.
export trim_start := (s) ~> do {
  n :: char.length(s)
  i :: while { s: s, i: 0, n: n } {
    (st) ~> if st.i >= st.n {
      { out: st.i }
    } else if char.is_whitespace(char.at(st.s, st.i)) {
      { state: { s: st.s, i: st.i + 1, n: st.n } }
    } else {
      { out: st.i }
    }
  }
  char.slice(s, i, n)
}
