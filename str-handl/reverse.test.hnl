from "./reverse" import * as m

test_reverse_basic := assert m.reverse("abc") = "cba"

test_reverse_empty := assert m.reverse("") = ""

test_reverse_single := assert m.reverse("a") = "a"

test_reverse_spaces := assert m.reverse("ab cd") = "dc ba"

test_reverse_unicode := assert m.reverse("héllo") = "olléh"
