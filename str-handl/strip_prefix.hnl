--- `str.strip_prefix` — part of `str-handl`, the pure-Handl `str` implementation over `char`.

from "char" import * as char
from "./internal/len.hnl" import len
from "./internal/drop.hnl" import drop
from "./internal/prefix_match.hnl" import prefix_match

--- Removes the prefix `p` from `s` when present.
---
--- @param {s} - the input string
--- @param {p} - the prefix to strip
--- @returns {String - `s` without `p`, or `s` unchanged}
--- @example
--- `str.strip_prefix("hello", "he")`
--- -- => "llo"
---
export strip_prefix := (s, p) ~> do {
  cs := char.chars(s)
  ps := char.chars(p)
  if prefix_match(cs, ps) { char.from_chars(drop(cs, len(ps))) } else { s }
}
