from "./split" import * as m

test_split_basic := assert m.split("a,b,c", ",") = ["a", "b", "c"]

test_split_empty_sep := assert m.split("ab", "") = ["", "a", "b", ""]

test_split_empty_s := assert m.split("", ",") = [""]

test_split_empty_field := assert m.split("a,,b", ",") = ["a", "", "b"]

test_split_whole_sep := assert m.split("abc", "abc") = ["", ""]

test_split_dash := assert m.split("a-b-c", "-") = ["a", "b", "c"]

test_split_miss := assert m.split("x", "y") = ["x"]

test_split_two := assert m.split("a,b", ",") = ["a", "b"]

test_split_trailing := assert m.split("a,b,", ",") = ["a", "b", ""]
