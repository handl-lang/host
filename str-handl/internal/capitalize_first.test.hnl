from "./capitalize_first" import * as m

test_capitalize_first_basic := assert m.capitalize_first("hello") = "Hello"

test_capitalize_first_empty := assert m.capitalize_first("") = ""

test_capitalize_first_caps_kept := assert m.capitalize_first("HELLO") = "HELLO"

test_capitalize_first_single := assert m.capitalize_first("a") = "A"

test_capitalize_first_digit := assert m.capitalize_first("1x") = "1x"
