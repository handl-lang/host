--- Internal helper for `str-handl` — not part of the `str` contract surface.

from "char" import * as char
from "./rev.hnl" import rev

--- Pads `s` to `n` chars by cycling the chars of `p`.
---
--- `is_left` selects the side the pad is applied to;
--- an empty `p` or an already-long-enough `s` is a no-op.
---
--- @example
--- `pad_to("ab", 5, "0", true)`
--- -- => "000ab"
---
export pad_to := (s, n, p, is_left) ~> do {
  c := char.length(s)
  if c >= n { s } else {
    if char.length(p) == 0 { s } else {
      orig := char.chars(p)
      pad := while { need: n - c, pcs: orig, acc: [] } {
        [need, pcs, acc] ~> if need <= 0 {
          { out: rev(acc) }
        } else {
          match pcs {
            []: { state: { need: need, pcs: orig, acc: acc } },
            [h, ...t]: { state: { need: need - 1, pcs: t, acc: [h, ...acc] } }
          }
        }
      }
      pad_str := char.from_chars(pad)
      if is_left { pad_str + s } else { s + pad_str }
    }
  }
}
