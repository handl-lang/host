--- Internal helper for `str-handl` — not part of the `str` contract surface.

-- `char` is imported so this module's runtime can resolve `char.*` host
-- calls made by caller-supplied `p` arrows (host calls resolve in the
-- invoking runtime's module chain, not the closure's).
from "char" import * as char

--- `true` when `p` holds for every element of `xs` (vacuously on `[]`).
---
--- @example
--- `all([2, 4, 6], x ~> x % 2 == 0)`
--- -- => true
---
export all := (xs, p) ~> do {
  ok := true
  for x in xs { do {
    if ok {
      if !p(x) {
        ok := false
      }
    }
  } }
  ok
}
