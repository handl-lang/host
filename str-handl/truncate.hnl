--- `str.truncate` — part of `str-handl`, the pure-Handl `str` implementation over `char`.

from "char" import * as char
from "./internal/len.hnl" import len
from "./internal/take.hnl" import take

--- Truncates `s` to at most `m` chars, appending `"..."` when cut.
---
--- @details
--- When `m < 3` the suffix does not fit and the result is a bare
--- `m`-char prefix. Strings already within `m` are returned unchanged.
---
--- @param {s} - the input string
--- @param {m} - the maximum output length in chars
--- @returns {String - `s` truncated to `m` chars}
--- @example
--- `str.truncate("hello world", 8)`
--- -- => "hello..."
---
export truncate := (s, m) ~> do {
  c := char.length(s)
  if c <= m { s } else {
    suf := "..."
    sl := char.length(suf)
    cs := char.chars(s)
    if m < sl {
      char.from_chars(take(cs, m))
    } else {
      char.concat(char.from_chars(take(cs, m - sl)), suf)
    }
  }
}
