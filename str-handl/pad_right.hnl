--- `str.pad_right` — part of `str-handl`, the pure-Handl `str` implementation over `char`.

from "./internal/pad_to.hnl" import pad_to

--- Right-pads `s` to `n` chars by cycling the chars of `p`.
---
--- @param {s} - the input string
--- @param {n} - the target length
--- @param {p} - the pad pattern (empty `p` is a no-op)
--- @returns {String - `s` right-padded to at least `n` chars}
--- @example
--- `str.pad_right("ab", 5, "0")`
--- -- => "ab000"
---
export pad_right := (s, n, p) ~> do {
  pad_to(s, n, p, false)
}
