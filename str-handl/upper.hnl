--- `str.upper` — part of `str-handl`, the pure-Handl `str` implementation over `char`.

from "char" import * as char
from "./internal/map.hnl" import map

--- Uppercases every character of `s`.
---
--- @details
--- Per-char case map over the whole string (`char.to_upper` is a
--- single-char atom; this lifts it to strings). Length-preserving.
---
--- @param {s} - the input string
--- @returns {String - `s` uppercased}
--- @example
--- `str.upper("Hello")`
--- -- => "HELLO"
---
export upper := (s) ~> do {
  char.from_chars(map(char.chars(s), c ~> char.to_upper(c)))
}
