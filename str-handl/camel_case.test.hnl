from "./camel_case" import * as m

test_camel_case_basic := assert m.camel_case("hello_world now") = "helloWorldNow"

test_camel_case_empty := assert m.camel_case("") = ""

test_camel_case_acronym := assert m.camel_case("ABCDef-foo_bar") = "abcDefFooBar"

test_camel_case_single := assert m.camel_case("hello") = "hello"

test_camel_case_spaces := assert m.camel_case("hello world") = "helloWorld"
