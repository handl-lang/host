--- `str.kebab_case` — part of `str-handl`, the pure-Handl `str` implementation over `char`.

from "./internal/split_words.hnl" import split_words
from "./join.hnl" import join

--- Converts `s` to `kebab-case`.
---
--- @details
--- Splits via `internal/split_words.hnl` and joins the lowercase words
--- with `-`.
---
--- @param {s} - the input string
--- @returns {String - `s` in kebab-case}
--- @example
--- `str.kebab_case("helloWorld_again")`
--- -- => "hello-world-again"
---
export kebab_case := (s) ~> do {
  join(split_words(s), "-")
}
