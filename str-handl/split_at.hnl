--- `str.split_at` — part of `str-handl`, the pure-Handl `str` implementation over `char`.

from "char" import * as char

--- Splits `s` at char index `i` into `[head, tail]`.
---
--- @details
--- `i` is clamped to `len(s)`, so `i > len(s)` yields `[s, ""]`.
---
--- @param {s} - the input string
--- @param {i} - the split char index
--- @returns {List String - the two halves}
--- @example
--- `str.split_at("hello", 2)`
--- -- => ["he", "llo"]
---
export split_at := (s, i) ~> do {
  n := char.length(s)
  mid := if i > n { n } else { i };
  [char.slice(s, 0, mid), char.slice(s, mid, n)]
}
