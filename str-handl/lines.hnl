--- `str.lines` — part of `str-handl`, the pure-Handl `str` implementation over `char`.

from "char" import * as char
from "./internal/rev.hnl" import rev
from "./internal/len.hnl" import len
from "./internal/last.hnl" import last
from "./internal/take.hnl" import take
from "./internal/map.hnl" import map

--- Splits `s` into lines.
---
--- @details
--- Rust `str::lines` semantics: `\r\n` is a single terminator and a
--- trailing `\n` does not produce a trailing empty line. An empty `s`
--- yields `[""]`.
---
--- @param {s} - the input string
--- @returns {List String - the lines of `s`}
--- @example
--- `str.lines("a\nb\n")`
--- -- => ["a", "b"]
---
export lines := (s) ~> do {
  if char.length(s) == 0 { [""] } else {
    cs := char.chars(s)
    cur := []
    pieces_rev := []
    for h in cs { do {
      if h == "\n" {
        pieces_rev := [char.from_chars(rev(cur)), ...pieces_rev]
        cur := []
      } else {
        cur := [h, ...cur]
      }
    } }
    pieces := rev([char.from_chars(rev(cur)), ...pieces_rev])
    -- drop a trailing "" produced by a trailing '\n'
    pieces2 := if last(cs) == "\n" { take(pieces, len(pieces) - 1) } else { pieces }
    -- strip a trailing '\r' from each piece (CRLF handling)
    map(pieces2, w ~> do {
      wc := char.chars(w)
      if len(wc) == 0 { w } else {
        if last(wc) == "\r" { char.from_chars(take(wc, len(wc) - 1)) } else { w }
      }
    })
  }
}
