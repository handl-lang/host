from "./str-handl" import * as str

test_str_handl_upper := assert str.upper("a") = "A"

test_str_handl_lower := assert str.lower("A") = "a"

test_str_handl_trim := assert str.trim(" a ") = "a"

test_str_handl_trim_start := assert str.trim_start(" a") = "a"

test_str_handl_trim_end := assert str.trim_end("a ") = "a"

test_str_handl_trim_matches := assert str.trim_matches("xax", "x") = "a"

test_str_handl_reverse := assert str.reverse("ab") = "ba"

test_str_handl_length := assert str.length("ab") = 2

test_str_handl_concat := assert str.concat("a", "b") = "ab"

test_str_handl_is_empty := assert str.is_empty("") = true

test_str_handl_equals := assert str.equals("a", "a") = true

test_str_handl_is_alpha := assert str.is_alpha("a") = true

test_str_handl_is_numeric := assert str.is_numeric("1") = true

test_str_handl_is_alphanumeric := assert str.is_alphanumeric("a1") = true

test_str_handl_capitalize := assert str.capitalize("ab") = "Ab"

test_str_handl_title_case := assert str.title_case("a b") = "A B"

test_str_handl_snake_case := assert str.snake_case("aB") = "a_b"

test_str_handl_camel_case := assert str.camel_case("a_b") = "aB"

test_str_handl_pascal_case := assert str.pascal_case("a_b") = "AB"

test_str_handl_kebab_case := assert str.kebab_case("a_b") = "a-b"

test_str_handl_contains := assert str.contains("ab", "b") = true

test_str_handl_starts_with := assert str.starts_with("ab", "a") = true

test_str_handl_ends_with := assert str.ends_with("ab", "b") = true

test_str_handl_count := assert str.count("aba", "a") = 2

test_str_handl_find := assert str.find("abc", "b") = 1

test_str_handl_rfind := assert str.rfind("abcb", "b") = 3

test_str_handl_levenshtein := assert str.levenshtein("ab", "ac") = 1

test_str_handl_similarity := assert str.similarity("ab", "ab") = 1.0

test_str_handl_split := assert str.split("a,b", ",") = ["a", "b"]

test_str_handl_join := assert str.join(["a", "b"], "-") = "a-b"

test_str_handl_replace := assert str.replace("aa", "a", "b") = "bb"

test_str_handl_replace_first := assert str.replace_first("aa", "a", "b") = "ba"

test_str_handl_repeat := assert str.repeat("a", 2) = "aa"

test_str_handl_char_at := assert str.char_at("ab", 1) = "b"

test_str_handl_slice := assert str.slice("abc", 0, 2) = "ab"

test_str_handl_pad_left := assert str.pad_left("a", 3, "x") = "xxa"

test_str_handl_pad_right := assert str.pad_right("a", 3, "x") = "axx"

test_str_handl_strip_prefix := assert str.strip_prefix("ab", "a") = "b"

test_str_handl_strip_suffix := assert str.strip_suffix("ab", "b") = "a"

test_str_handl_lines := assert str.lines("a\nb") = ["a", "b"]

test_str_handl_split_at := assert str.split_at("ab", 1) = ["a", "b"]

test_str_handl_split_whitespace := assert str.split_whitespace("a b") = ["a", "b"]

test_str_handl_truncate := assert str.truncate("abcd", 3) = "..."

test_str_handl_slugify := assert str.slugify("A B") = "a-b"

test_str_handl_word_wrap := assert str.word_wrap("a b", 3) = "a b"
