--- `str.is_alpha` — part of `str-handl`, the pure-Handl `str` implementation over `char`.

from "char" import * as char
from "./internal/len.hnl" import len
from "./internal/all.hnl" import all

--- Whether every character of `s` is alphabetic.
---
--- @details
--- An empty `s` returns `false` (matching the former native
--- `str.is_alpha` semantics, not a vacuous truth).
---
--- @param {s} - the input string
--- @returns {Bool - `true` iff `s` is non-empty and all-alphabetic}
--- @example
--- `str.is_alpha("abc")`
--- -- => true
---
export is_alpha := (s) ~> do {
  cs := char.chars(s)
  if len(cs) == 0 { false } else { all(cs, c ~> char.is_alpha(c)) }
}
