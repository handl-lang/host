--- `str.ends_with` — part of `str-handl`, the pure-Handl `str` implementation over `char`.

from "char" import * as char
from "./internal/rev.hnl" import rev
from "./internal/prefix_match.hnl" import prefix_match

--- Whether `s` ends with `pat`.
---
--- @param {s} - the input string
--- @param {pat} - the suffix to test
--- @returns {Bool - `true` iff `pat` is a suffix of `s`}
--- @example
--- `str.ends_with("hello", "lo")`
--- -- => true
---
export ends_with := (s, pat) ~> do {
  prefix_match(rev(char.chars(s)), rev(char.chars(pat)))
}
