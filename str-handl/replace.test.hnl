from "./replace" import * as m

test_replace_basic := assert m.replace("aaa", "a", "b") = "bbb"

test_replace_empty_pat := assert m.replace("abc", "", "-") = "-a-b-c-"

test_replace_empty_s := assert m.replace("", "a", "b") = ""

test_replace_wider := assert m.replace("aaa", "a", "bb") = "bbbbbb"

test_replace_partial := assert m.replace("hello", "l", "L") = "heLLo"

test_replace_miss := assert m.replace("abc", "z", "x") = "abc"

test_replace_word := assert m.replace("a-b-a", "a", "x") = "x-b-x"
