--- str-handl — the pure-handl implementation of the `str` contract.
---
--- Every string *algorithm* in the `str` contract
--- (`handl-packages/str/str.hnl`) is implemented here as handl code over
--- the `char` floor (`handl-packages/char/char.hnl`): `char.chars`/
--- `char.from_chars` for O(n) string <-> char-list conversion, `char.at`/
--- `char.slice`/`char.length`/`char.concat` for char-sequence access, and
--- the semantic category/case atoms `char.is_whitespace`/`is_alpha`/
--- `is_numeric`/`is_alnum`/`is_uppercase`/`is_lowercase`/`to_upper`/
--- `to_lower`/`to_title`. No string algorithm is written in Rust here.
---
--- Portability: `str-handl` calls only `char.*` semantic ops, so it runs
--- over ANY `char` backend — `char-native` (Rust `std::char`), `char-ascii`
--- (no-Unicode runtimes), `char-js` (JS built-ins), or a future `char-icu`
--- (ICU4X). The source never references Unicode, UTF-8, or codepoint
--- semantics directly.
---
--- Complexity: `chars`/`from_chars` are O(n), so list-based algorithms are
--- O(n) or O(n*m) (search/replace use a straightforward scan; `str-native`/
--- `str-js` remain the per-runtime fast paths). `levenshtein` is O(n*m)
--- with O(m) space via the two-row DP.
---
--- Registered as the `"str"` module (see `kit-canonical`), satisfying the
--- `str` contract's interface. Replaces the former all-FFI `StrModule`.
from "char" import * as char

do {
  -- ---------------------------------------------------------------------
  -- Internal helpers (not exported)
  -- ---------------------------------------------------------------------

  id = x ~> x

  rev = xs ~> {
    while { xs: xs, acc: [] } {
      [xs, acc] ~> match xs {
        []: { out: acc },
        [h, ...t]: { state: { xs: t, acc: [h, ...acc] } }
      }
    }
  }

  list_len = xs ~> {
    while { xs: xs, n: 0 } {
      [xs, n] ~> match xs {
        []: { out: n },
        [h, ...t]: { state: { xs: t, n: n + 1 } }
      }
    }
  }

  head = xs ~> match xs {
    [h, ...t]: h
  }

  last = xs ~> head(rev(xs))

  -- drop the first n elements
  drop = [xs, n] ~> {
    while { xs: xs, n: n } {
      [xs, n] ~> if n <= 0 {
        { out: xs }
      } else {
        match xs {
          []: { out: [] },
          [h, ...t]: { state: { xs: t, n: n - 1 } }
        }
      }
    }
  }

  -- take the first n elements
  take = [xs, n] ~> {
    while { xs: xs, n: n, acc: [] } {
      [xs, n, acc] ~> if n <= 0 {
        { out: rev(acc) }
      } else {
        match xs {
          []: { out: rev(acc) },
          [h, ...t]: { state: { xs: t, n: n - 1, acc: [h, ...acc] } }
        }
      }
    }
  }

  -- drop leading elements satisfying p
  drop_while = [xs, p] ~> {
    while xs {
      st ~> match st {
        []: { out: [] },
        [h, ...t]: if p(h) { { state: t } } else { { out: st } }
      }
    }
  }

  map = [xs, f] ~> {
    while { xs: xs, acc: [] } {
      [xs, acc] ~> match xs {
        []: { out: rev(acc) },
        [h, ...t]: { state: { xs: t, acc: [f(h), ...acc] } }
      }
    }
  }

  -- per-char case map over a whole string (char.to_lower/to_upper are
  -- single-char atoms; these lift them to strings)
  lower_str = s ~> char.from_chars(map(char.chars(s), c ~> char.to_lower(c)))
  upper_str = s ~> char.from_chars(map(char.chars(s), c ~> char.to_upper(c)))

  all = [xs, p] ~> {
    while xs {
      st ~> match st {
        []: { out: true },
        [h, ...t]: if p(h) { { state: t } } else { { out: false } }
      }
    }
  }

  member = [x, xs] ~> {
    while xs {
      st ~> match st {
        []: { out: false },
        [h, ...t]: if h == x { { out: true } } else { { state: t } }
      }
    }
  }

  -- append a onto the front of b's tail: append([1,2],[3]) = [1,2,3]
  append = [a, b] ~> {
    while { xs: rev(a), acc: b } {
      [xs, acc] ~> match xs {
        []: { out: acc },
        [h, ...t]: { state: { xs: t, acc: [h, ...acc] } }
      }
    }
  }

  -- is ps a prefix of xs? (both char lists)
  prefix_match = [xs, ps] ~> {
    while { xs: xs, ps: ps } {
      [xs, ps] ~> match ps {
        []: { out: true },
        [ph, ...pt]: match xs {
          []: { out: false },
          [xh, ...xt]: if xh == ph {
            { state: { xs: xt, ps: pt } }
          } else {
            { out: false }
          }
        }
      }
    }
  }

  -- first index where ps matches xs, else -1 (empty ps matches at 0)
  find_idx = [xs, ps] ~> {
    m = list_len(ps)
    if m == 0 { 0 } else {
      n = list_len(xs)
      if m > n { 0 - 1 } else {
        while { xs: xs, i: 0, limit: n - m } {
          [xs, i, limit] ~> if prefix_match(xs, ps) {
            { out: i }
          } else {
            if i >= limit {
              { out: 0 - 1 }
            } else {
              match xs {
                []: { out: 0 - 1 },
                [h, ...t]: { state: { xs: t, i: i + 1, limit: limit } }
              }
            }
          }
        }
      }
    }
  }

  -- join a list of strings with a separator
  join_impl = [xs, sep] ~> {
    match xs {
      []: "",
      [h, ...t]: do {
        while { xs: t, acc: h } {
          [xs, acc] ~> match xs {
            []: { out: acc },
            [h2, ...t2]: { state: { xs: t2, acc: acc + sep + h2 } }
          }
        }
      }
    }
  }

  -- split a string into words for case conversion (ported from the
  -- former Rust `split_words`: separators '-', '_', ' '; splits on
  -- lowercase->uppercase boundaries and acronym->word boundaries).
  is_sep = c ~> if c == "-" { true } else { if c == "_" { true } else { c == " " } }

  -- `cur` is a REVERSED char list (head = last char pushed).
  push_word = [cur, words] ~> {
    if list_len(cur) == 0 { words } else {
      [char.from_chars(rev(cur)), ...words]
    }
  }

  split_words = s ~> {
    r = while { xs: char.chars(s), cur: [], words: [] } {
      [xs, cur, words] ~> match xs {
        []: { out: { cur: cur, words: words } },
        [h, ...t]: if is_sep(h) {
          { state: { xs: t, cur: [], words: push_word(cur, words) } }
        } else {
          if char.is_uppercase(h) {
            if list_len(cur) == 0 {
              { state: { xs: t, cur: [h], words: words } }
            } else {
              last_c = head(cur)
              if char.is_lowercase(last_c) {
                -- lowercase -> uppercase boundary: start a new word
                { state: { xs: t, cur: [h], words: push_word(cur, words) } }
              } else {
                { state: { xs: t, cur: [h, ...cur], words: words } }
              }
            }
          } else {
            if list_len(cur) == 0 {
              { state: { xs: t, cur: [h], words: words } }
            } else {
              last_c2 = head(cur)
              if char.is_uppercase(last_c2) {
                if list_len(cur) > 1 {
                  -- acronym -> word boundary: "ABCDef" -> "ABC" + "Def"
                  last_ch = head(cur)
                  rest_cur = drop(cur, 1)
                  { state: { xs: t, cur: [h, last_ch], words: push_word(rest_cur, words) } }
                } else {
                  { state: { xs: t, cur: [h, ...cur], words: words } }
                }
              } else {
                { state: { xs: t, cur: [h, ...cur], words: words } }
              }
            }
          }
        }
      }
    }
    words2 = push_word(r.cur, r.words)
    map(rev(words2), w ~> lower_str(w))
  }

  capitalize_first = w ~> {
    wc = char.chars(w)
    match wc {
      []: "",
      [h, ...t]: char.to_upper(h) + char.from_chars(t)
    }
  }

  -- split on '\n' with Rust `str::lines` semantics: '\r\n' is a single
  -- terminator and a trailing '\n' does not produce a trailing empty line.
  lines_impl = s ~> {
    if char.length(s) == 0 { [""] } else {
      cs = char.chars(s)
      pieces_rev = while { xs: cs, cur: [], pieces: [] } {
        [xs, cur, pieces] ~> match xs {
          []: { out: [char.from_chars(rev(cur)), ...pieces] },
          [h, ...t]: if h == "\n" {
            { state: { xs: t, cur: [], pieces: [char.from_chars(rev(cur)), ...pieces] } }
          } else {
            { state: { xs: t, cur: [h, ...cur], pieces: pieces } }
          }
        }
      }
      pieces = rev(pieces_rev)
      -- drop a trailing "" produced by a trailing '\n'
      pieces2 = if last(cs) == "\n" { take(pieces, list_len(pieces) - 1) } else { pieces }
      -- strip a trailing '\r' from each piece (CRLF handling)
      map(pieces2, w ~> {
        wc = char.chars(w)
        if list_len(wc) == 0 { w } else {
          if last(wc) == "\r" { char.from_chars(take(wc, list_len(wc) - 1)) } else { w }
        }
      })
    }
  }

  -- split on whitespace runs (Rust `split_whitespace` semantics)
  split_ws_impl = s ~> {
    cs = drop_while(char.chars(s), c ~> char.is_whitespace(c));
    while { xs: cs, cur: [], pieces: [] } {
      [xs, cur, pieces] ~> match xs {
        []: if list_len(cur) == 0 {
          { out: rev(pieces) }
        } else {
          { out: rev([char.from_chars(rev(cur)), ...pieces]) }
        },
        [h, ...t]: if char.is_whitespace(h) {
          if list_len(cur) == 0 {
            { state: { xs: t, cur: cur, pieces: pieces } }
          } else {
            { state: { xs: t, cur: [], pieces: [char.from_chars(rev(cur)), ...pieces] } }
          }
        } else {
          { state: { xs: t, cur: [h, ...cur], pieces: pieces } }
        }
      }
    }
  }

  -- Levenshtein edit distance over char lists, two-row DP, O(m) space.
  min3 = [a, b, c] ~> {
    ab = if a < b { a } else { b }
    if ab < c { ab } else { c }
  }

  -- iota(n) = [0, 1, ..., n] — the Levenshtein DP "row 0" (n+1 entries).
  iota = n ~> {
    while { n: n, acc: [] } {
      [n, acc] ~> if n < 0 {
        { out: acc }
      } else {
        { state: { n: n - 1, acc: [n, ...acc] } }
      }
    }
  }

  -- One DP row for a fixed `ach`: iterate `bcs` (with prev row and the
  -- reversed current row) producing the next row in forward order.
  -- `pr` is prev[j-1..], `currev` is the reversed current row (head = c[j-1]).
  lev_row = [ach, bcs, prev, i] ~> {
    while { ys: bcs, pr: prev, currev: [i + 1] } {
      [ys, pr, currev] ~> match ys {
        []: { out: rev(currev) },
        [bch, ...bt]: match pr {
          [pjm1, ...pr1]: match pr1 {
            [pj, ...prest]: do {
              cost = if ach == bch { 0 } else { 1 }
              cj = min3(pj + 1, head(currev) + 1, pjm1 + cost)
              { state: { ys: bt, pr: pr1, currev: [cj, ...currev] } }
            }
          }
        }
      }
    }
  }

  lev_impl = [a, b] ~> {
    acs = char.chars(a);
    bcs = char.chars(b);
    m = list_len(bcs);
    prev0 = iota(m);
    r = while { xs: acs, i: 0, prev: prev0 } {
      [xs, i, prev] ~> match xs {
        []: { out: prev },
        [ach, ...at]: { state: { xs: at, i: i + 1, prev: lev_row(ach, bcs, prev, i) } }
      }
    }
    last(r)
  }

  -- pad `s` to `n` chars by cycling the chars of `p` (empty p is a no-op).
  pad_to = [s, n, p, left] ~> {
    c = char.length(s)
    if c >= n { s } else {
      if char.length(p) == 0 { s } else {
        orig = char.chars(p)
        pad = while { need: n - c, pcs: orig, acc: [] } {
          [need, pcs, acc] ~> if need <= 0 {
            { out: rev(acc) }
          } else {
            match pcs {
              []: { state: { need: need, pcs: orig, acc: acc } },
              [h, ...t]: { state: { need: need - 1, pcs: t, acc: [h, ...acc] } }
            }
          }
        }
        pad_str = char.from_chars(pad)
        if left { pad_str + s } else { s + pad_str }
      }
    }
  }

  truncate_impl = [s, max_len, suf] ~> {
    c = char.length(s)
    if c <= max_len { s } else {
      sl = char.length(suf)
      cs = char.chars(s)
      if max_len < sl {
        char.from_chars(take(cs, max_len))
      } else {
        char.from_chars(take(cs, max_len - sl)) + suf
      }
    }
  }

  -- ---------------------------------------------------------------------
  -- Exported `str` functions (the `str` contract)
  -- ---------------------------------------------------------------------

  {
    -- ---- basic transforms ----

    upper: s ~> upper_str(s),

    lower: s ~> lower_str(s),

    trim: s ~> {
      a = drop_while(char.chars(s), c ~> char.is_whitespace(c))
      b = drop_while(rev(a), c ~> char.is_whitespace(c))
      char.from_chars(rev(b))
    },

    trim_start: s ~> {
      char.from_chars(drop_while(char.chars(s), c ~> char.is_whitespace(c)))
    },

    trim_end: s ~> {
      char.from_chars(rev(drop_while(rev(char.chars(s)), c ~> char.is_whitespace(c))))
    },

    trim_matches: [s, set] ~> {
      if char.length(set) == 0 { s } else {
        setc = char.chars(set)
        in_set = c ~> member(c, setc)
        a = drop_while(char.chars(s), in_set)
        b = drop_while(rev(a), in_set)
        char.from_chars(rev(b))
      }
    },

    reverse: s ~> char.from_chars(rev(char.chars(s))),

    length: s ~> char.length(s),

    concat: [a, b] ~> a + b,

    is_empty: s ~> s == "",

    equals: [a, b] ~> a == b,

    is_alpha: s ~> {
      cs = char.chars(s)
      if list_len(cs) == 0 { false } else { all(cs, c ~> char.is_alpha(c)) }
    },

    is_numeric: s ~> {
      cs = char.chars(s)
      if list_len(cs) == 0 { false } else { all(cs, c ~> char.is_numeric(c)) }
    },

    is_alphanumeric: s ~> {
      cs = char.chars(s)
      if list_len(cs) == 0 { false } else { all(cs, c ~> char.is_alnum(c)) }
    },

    -- ---- case conversion ----

    capitalize: s ~> {
      cs = char.chars(s)
      match cs {
        []: "",
        [h, ...t]: char.to_upper(h) + char.from_chars(map(t, c ~> char.to_lower(c)))
      }
    },

    title_case: s ~> {
      out = while { xs: char.chars(s), new_word: true, acc: [] } {
        [xs, new_word, acc] ~> match xs {
          []: { out: rev(acc) },
          [h, ...t]: if char.is_whitespace(h) {
            { state: { xs: t, new_word: true, acc: [h, ...acc] } }
          } else {
            if new_word {
              { state: { xs: t, new_word: false, acc: [char.to_upper(h), ...acc] } }
            } else {
              { state: { xs: t, new_word: false, acc: [char.to_lower(h), ...acc] } }
            }
          }
        }
      }
      char.from_chars(out)
    },

    snake_case: s ~> join_impl(split_words(s), "_"),

    camel_case: s ~> {
      ws = split_words(s)
      match ws {
        []: "",
        [h, ...t]: h + join_impl(map(t, w ~> capitalize_first(w)), "")
      }
    },

    pascal_case: s ~> {
      join_impl(map(split_words(s), w ~> capitalize_first(w)), "")
    },

    kebab_case: s ~> join_impl(split_words(s), "-"),

    -- ---- search ----

    contains: [s, pat] ~> {
      find_idx(char.chars(s), char.chars(pat)) >= 0
    },

    starts_with: [s, pat] ~> {
      prefix_match(char.chars(s), char.chars(pat))
    },

    ends_with: [s, pat] ~> {
      prefix_match(rev(char.chars(s)), rev(char.chars(pat)))
    },

    count: [s, pat] ~> {
      ps = char.chars(pat)
      cs = char.chars(s)
      m = list_len(ps)
      if m == 0 { list_len(cs) + 1 } else {
        while { xs: cs, c: 0 } {
          [xs, c] ~> match xs {
            []: { out: c },
            [h, ...t]: if prefix_match(xs, ps) {
              { state: { xs: drop(xs, m), c: c + 1 } }
            } else {
              { state: { xs: t, c: c } }
            }
          }
        }
      }
    },

    find: [s, pat] ~> find_idx(char.chars(s), char.chars(pat)),

    rfind: [s, pat] ~> {
      ps = char.chars(pat)
      cs = char.chars(s)
      m = list_len(ps)
      n = list_len(cs)
      if m == 0 { n } else {
        if m > n { 0 - 1 } else {
          while { xs: cs, i: 0, limit: n - m, last_hit: 0 - 1 } {
            [xs, i, limit, last_hit] ~> {
              hit = if prefix_match(xs, ps) { i } else { last_hit }
              if i >= limit { { out: hit } } else {
                match xs {
                  []: { out: hit },
                  [h, ...t]: { state: { xs: t, i: i + 1, limit: limit, last_hit: hit } }
                }
              }
            }
          }
        }
      }
    },

    levenshtein: [a, b] ~> lev_impl(a, b),

    similarity: [a, b] ~> {
      la = char.length(a)
      lb = char.length(b)
      mx = if la > lb { la } else { lb }
      if mx == 0 { 1.0 } else {
        d = lev_impl(a, b)
        1.0 - (d / (mx + 0.0))
      }
    },

    -- ---- transform ----

    split: [s, sep] ~> {
      cs = char.chars(s)
      ss = char.chars(sep)
      m = list_len(ss)
      if m == 0 {
        -- "abc".split("") -> ["", "a", "b", "c", ""]  (Rust semantics)
        append(["", ...cs], [""])
      } else {
        rev_out = while { xs: cs, cur: [], pieces: [] } {
          [xs, cur, pieces] ~> match xs {
            []: { out: [char.from_chars(rev(cur)), ...pieces] },
            [h, ...t]: if prefix_match(xs, ss) {
              { state: { xs: drop(xs, m), cur: [], pieces: [char.from_chars(rev(cur)), ...pieces] } }
            } else {
              { state: { xs: t, cur: [h, ...cur], pieces: pieces } }
            }
          }
        }
        rev(rev_out)
      }
    },

    join: [xs, sep] ~> join_impl(xs, sep),

    replace: [s, old, to] ~> {
      cs = char.chars(s)
      fs = char.chars(old)
      m = list_len(fs)
      if m == 0 {
        -- "abc".replace("", "-") -> "-a-b-c-"  (insert at each boundary)
        s2 = while { xs: cs, acc: "" } {
          [xs, acc] ~> match xs {
            []: { out: acc },
            [h, ...t]: { state: { xs: t, acc: acc + h + to } }
          }
        }
        to + s2
      } else {
        while { xs: cs, acc: "" } {
          [xs, acc] ~> match xs {
            []: { out: acc },
            [h, ...t]: if prefix_match(xs, fs) {
              { state: { xs: drop(xs, m), acc: acc + to } }
            } else {
              { state: { xs: t, acc: acc + h } }
            }
          }
        }
      }
    },

    replace_first: [s, old, to] ~> {
      cs = char.chars(s)
      fs = char.chars(old)
      m = list_len(fs)
      if m == 0 {
        -- Rust: replacen("", to, 1) inserts `to` at position 0.
        to + s
      } else {
        idx = find_idx(cs, fs)
        if idx < 0 { s } else {
          char.from_chars(take(cs, idx)) + to + char.from_chars(drop(cs, idx + m))
        }
      }
    },

    repeat: [s, n] ~> {
      while { n: n, acc: "" } {
        [n, acc] ~> if n <= 0 {
          { out: acc }
        } else {
          { state: { n: n - 1, acc: acc + s } }
        }
      }
    },

    char_at: [s, i] ~> char.at(s, i),

    slice: [s, a, b] ~> char.slice(s, a, b),

    pad_left: [s, n, p] ~> pad_to(s, n, p, true),

    pad_right: [s, n, p] ~> pad_to(s, n, p, false),

    strip_prefix: [s, p] ~> {
      cs = char.chars(s)
      ps = char.chars(p)
      if prefix_match(cs, ps) { char.from_chars(drop(cs, list_len(ps))) } else { s }
    },

    strip_suffix: [s, p] ~> {
      cs = char.chars(s)
      ps = char.chars(p)
      rcs = rev(cs)
      rps = rev(ps)
      if prefix_match(rcs, rps) { char.from_chars(rev(drop(rcs, list_len(ps)))) } else { s }
    },

    lines: s ~> lines_impl(s),

    split_at: [s, i] ~> {
      n = char.length(s)
      mid = if i > n { n } else { i };
      [char.slice(s, 0, mid), char.slice(s, mid, n)]
    },

    split_whitespace: s ~> split_ws_impl(s),

    truncate: [s, m] ~> truncate_impl(s, m, "..."),

    slugify: s ~> {
      cs = char.chars(lower_str(s))
      mapped = while { xs: cs, acc: [] } {
        [xs, acc] ~> match xs {
          []: { out: rev(acc) },
          [h, ...t]: if char.is_alnum(h) {
            { state: { xs: t, acc: [h, ...acc] } }
          } else {
            if char.is_whitespace(h) {
              { state: { xs: t, acc: ["-", ...acc] } }
            } else {
              if h == "-" {
                { state: { xs: t, acc: ["-", ...acc] } }
              } else {
                if h == "_" {
                  { state: { xs: t, acc: ["-", ...acc] } }
                } else {
                  { state: { xs: t, acc: acc } }
                }
              }
            }
          }
        }
      }
      t1 = drop_while(mapped, c ~> c == "-")
      t2 = rev(drop_while(rev(t1), c ~> c == "-"))
      out = while { xs: t2, prev_dash: false, acc: [] } {
        [xs, prev_dash, acc] ~> match xs {
          []: { out: rev(acc) },
          [h, ...t]: if h == "-" {
            if prev_dash {
              { state: { xs: t, prev_dash: true, acc: acc } }
            } else {
              { state: { xs: t, prev_dash: true, acc: [h, ...acc] } }
            }
          } else {
            { state: { xs: t, prev_dash: false, acc: [h, ...acc] } }
          }
        }
      }
      char.from_chars(out)
    },

    word_wrap: [s, w] ~> {
      if w < 1 { "" } else {
        ls = lines_impl(s)
        out = while { xs: ls, acc: "" } {
          [xs, acc] ~> match xs {
            []: { out: acc },
            [ln, ...t]: if ln == "" {
              { state: { xs: t, acc: acc + "\n" } }
            } else {
              ws = split_ws_impl(ln)
              line_out = while { ys: ws, cur_len: 0, buf: "" } {
                [ys, cur_len, buf] ~> match ys {
                  []: { out: buf },
                  [word, ...wt]: do {
                    wl = char.length(word)
                    if cur_len == 0 {
                      { state: { ys: wt, cur_len: wl, buf: buf + word } }
                    } else {
                      if cur_len + 1 + wl <= w {
                        { state: { ys: wt, cur_len: cur_len + 1 + wl, buf: buf + " " + word } }
                      } else {
                        { state: { ys: wt, cur_len: wl, buf: buf + "\n" + word } }
                      }
                    }
                  }
                }
              }
              { state: { xs: t, acc: acc + line_out + "\n" } }
            }
          }
        }
        -- strip the trailing '\n' appended per line
        ocs = char.chars(out)
        if list_len(ocs) == 0 { "" } else {
          if last(ocs) == "\n" { char.from_chars(take(ocs, list_len(ocs) - 1)) } else { out }
        }
      }
    }
  }
}
