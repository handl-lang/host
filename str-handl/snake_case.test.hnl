from "./snake_case" import * as m

test_snake_case_camel := assert m.snake_case("helloWorld now") = "hello_world_now"

test_snake_case_acronym := assert m.snake_case("ABCDef") = "abc_def"

test_snake_case_empty := assert m.snake_case("") = ""

test_snake_case_already := assert m.snake_case("already_snake") = "already_snake"

test_snake_case_dashes := assert m.snake_case("hello-world") = "hello_world"

test_snake_case_pascal := assert m.snake_case("HelloWorld") = "hello_world"

test_snake_case_all_caps := assert m.snake_case("ABC") = "abc"
