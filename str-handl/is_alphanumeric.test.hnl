from "./is_alphanumeric" import * as m

test_is_alphanumeric_mixed := assert m.is_alphanumeric("a1") = true

test_is_alphanumeric_punct := assert m.is_alphanumeric("a!") = false

test_is_alphanumeric_empty := assert m.is_alphanumeric("") = false

test_is_alphanumeric_alpha := assert m.is_alphanumeric("abc") = true

test_is_alphanumeric_digits := assert m.is_alphanumeric("123") = true

test_is_alphanumeric_space := assert m.is_alphanumeric("a b") = false
