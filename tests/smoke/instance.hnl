--- tests/smoke/instance.hnl — `instance` declarations and implicit
--- evidence arguments. Driven by `hnl typecheck` (see `ci.sh smoke`).
---
--- `instance <C(i⃗)> := <dict>` registers a dictionary; an `<ev : Eq(a)>`
--- implicit binder discharges by dictionary search at the call site.
--- Members are projected by matching the `mkEq` constructor out of the
--- dictionary (`ev.eq` field access does not typecheck — the binder's
--- type is the `Eq(a)` former-app, not a record).
---
--- Runtime caveat (kept check-side): evidence args live in the implicit
--- erasure class — `match ev` has no dict value to dispatch on under
--- `hnl run` today.

data Nat :: Zero | Succ(pred : Nat)

data Eq(a : Type) :: mkEq(f : a ~> a ~> Bool)

instance Eq(Nat) := { eq: (x, y) ~> x == y }

--- `<a, ev : Eq(a)>` — the sorted binder carries the type index plus the
--- evidence argument in one `<>` bracket.
export eqv<a, ev : Eq(a)> : a ~> a ~> Bool = x ~> y ~> match ev { mkEq(f): f(x, y) }

--- `eqv(Zero)` resolves `Eq(Nat)` by search — no explicit dict argument.
nat_eq_refl : Bool = eqv(Zero)(Zero)
nat_eq_succ : Bool = eqv(Zero)(Succ(Zero))
