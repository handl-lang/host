--- tests/smoke/cubical.hnl — cubical forms end-to-end through the
--- PRODUCTION `hnl typecheck` path (NBE checker), ADR-0208 P1–P4.
---
--- Covers: the interval sort `I`/`Interval` with `i0`/`i1` endpoints —
--- usable directly as `transp`/`hcomp`/`Comp` dimension operands, with
--- bound `e0 : I := i0`-style variables exercised alongside; the
--- `Path(A, x, y)` / `PathP(F, x, y)` interval-function type formers
--- with `refl`, lambda-path, and path-alias introductions; `#`
--- transport (annotated and unannotated, over index and homogeneous
--- term endpoints) and its `transport(p, v)` call-form alias, and the
--- capital `J` eliminator; the P2 judgments
--- `transp`/`hcomp`/`Comp`/`trans`/`symm` over face formulas
--- (`f0`/`f1`/`fnot`/`f_or`/`f_and`/`fT`/`fF`); the P3 glue/fibrant
--- surface — `Glue(A, φ, T̂)`/`isFibrant(A)`/`unglue(G)` in type
--- position and `fibrant A` witnesses; and the P4 computing
--- univalence surface — `Equiv(A, B)` records, the `ua(e)` /
--- `Univalence(e)` / `univalence(e)` path formers, `#` transport
--- along the recorded equivalence, and `symm`/`trans` path algebra.
---
--- Production-surface notes (verified against `hnl typecheck`, which
--- runs the unbound-wire scope pass the Rust NBE fixtures bypass):
---   * Cubical type-former/judgment names (`Pi`, `Sigma`, `Forall`,
---     `Family`, `I`, `Interval`, `Type`, `Path`, `PathP`, `Glue`,
---     `Equiv`, `ua`, `Univalence`, `isFibrant`, `unglue`, `transport`,
---     and the
---     face ops `f0`/`f1`/`fT`/`fF`/`fnot`/`f_and`/`f_or`) are checker
---     primitives carried on the wire prelude — the scope pass admits
---     them in every wire position, and the judge's builtin-name /
---     call-form dispatch overrides their `type.unknown` seeds.
---   * `i0`/`i1` literals synthesize `type.interval` even though they
---     arrive as `type.unknown` placeholder seeds — the judge's
---     endpoint arms run before the generic seed return.
---   * `refl` remains a judge-resolved introduction, not a seeded
---     wire — the scope pass binds it through its own exemption list.

Nat := new Inductive {
  zero : Nat,
  succ : (pred : Nat) ~> Nat
}

Vec<n : Nat, a : Type> := new Inductive {
  vnil : Vec(0, a),
  vcons : (x : a, xs : Vec(n, a)) ~> Vec(n + 1, a)
}

v2 : Vec<2, Bool> := Vec.vcons(true, Vec.vcons(false, Vec.vnil))

-- ---------------------------------------------------------------------
-- P1 — interval sort, dimension binders, Path/PathP, refl, eliminators.
-- ---------------------------------------------------------------------

--- `i0`/`i1` are closed terms of the interval sort; `Interval` is the
--- same sort under its long name. The bindings double as coverage for
--- dimension *variables* — the P2 judgments below take both literals
--- and bound names.
e0 : I := i0
e1 : Interval := i1

--- A `Pi(I, i ~> T)` binder introduces a dimension variable `i : I`.
fI : Pi(I, i ~> Bool) := i ~> true
gI : Pi(I, i ~> Nat) := i ~> Nat.zero

--- `Path(A, x, y)` is the homogeneous interval function `(i:I) → A`:
--- both a lambda path and `refl` (reflexive endpoints) inhabit it.
cp : Path(Bool, true, true) := i ~> true
cr : Path(Bool, true, true) := refl
cn : Path(Nat, Nat.zero, Nat.zero) := refl

--- `PathP(F, x, y)` is the heterogeneous path `(i:I) → F i` for
--- `F : I → Type`; `refl` inhabits the reflexive endpoint pair.
pp : PathP(Pi(I, i ~> Bool), true, true) := refl

--- `#` transport along a cubical path over index endpoints — the
--- `Path(2, 2)` witness justifies rewriting the `Vec` index (the
--- types.hnl `p # v` discipline, now over the interval `type.pi`).
p22 : Path(2, 2) := refl
moved : Vec<2, Bool> := p22 # v2

--- A path-typed variable is itself a witness; `#` also synthesizes
--- over homogeneous term endpoints — annotated (`wc`) and bare
--- (`wb`).
q22 : Path(2, 2) := p22
wb := cp # true
wc : Bool := cp # true

--- Call-form parity: `transport(p, v)` is the `#` transport under a
--- plain identifier — intercepted by callee name like `ua`/`Glue`
--- (project/design/apply-forms-unification.md §9: both spellings
--- exist). `transport` stays an ordinary identifier outside call
--- position, so these produce the same types as the `#` twins above.
moved_c : Vec<2, Bool> := transport(p22, v2)
wbc := transport(cp, true)
wcc : Bool := transport(cp, true)

--- `J p, motive, base` — the capital-J eliminator over a cubical
--- path: checks `base` against the motive at the source endpoint and
--- synthesizes the motive at the target.
jv : Vec<2, Bool> := J p22, (i, w) ~> Vec(i, Bool), v2

--- `J refl, motive, base` — the refl iota: the endpoints are
--- unidentified, so J computes on the base's own fibre — `Vec.vnil`'s
--- `Vec(0, Bool)`, not any path endpoint.
jr : Vec<0, Bool> := J refl, (i, w) ~> Vec(i, Bool), Vec.vnil

-- ---------------------------------------------------------------------
-- P2 — transp / hcomp / Comp / trans / symm.
-- ---------------------------------------------------------------------

--- `transp A, i, φ, u` — transport in the family `A : I → Type` along
--- dimension `i`, partial on face `φ`; CCHM direction `A(i1) → A(i0)`.
--- Dimension operands may be `i0`/`i1` literals or bound `I` variables
--- (`e0`/`e1` above); `fF` is the empty face and faces may mention
--- *other* dimensions.
t1 := transp Pi(I, i ~> Bool), i0, fF, true
t2 := transp Pi(I, i ~> Bool), i1, fF, true
t3 := transp Pi(I, i ~> Bool), e0, f_and(fF, f0(i1)), true
t4 := transp Pi(I, i ~> Bool), e0, f_or(fF, fT), true
t5 := transp Pi(I, i ~> Bool), e1, fnot(fF), true

--- `hcomp A, i, φ, u, cap` — homogeneous composition over a single
--- type; `cap : A` is the `i = 0` face, result `: A`.
h1 : Bool := hcomp Bool, i0, fF, true, false

--- `Comp F, i, φ, u, cap` — heterogeneous composition over
--- `F : I → Type`; `cap : F(i0)`, result `: F(i1)`.
c1 : Bool := Comp Pi(I, i ~> Bool), i0, fF, true, false

--- `trans p, q` / `symm p` — derived path algebra over decided-distinct
--- endpoints; the results are themselves path witnesses.
pt : Path(Nat, Nat.zero, Nat.succ(Nat.zero)) := i ~> Nat.zero
qt : Path(Nat, Nat.succ(Nat.zero), Nat.succ(Nat.succ(Nat.zero))) := i ~> Nat.succ(Nat.zero)
tt : Path(Nat, Nat.zero, Nat.succ(Nat.succ(Nat.zero))) := trans pt, qt
st : Path(Nat, Nat.succ(Nat.succ(Nat.zero)), Nat.zero) := symm tt
--- Call-form parity: unary prefix keywords already accept `f(x)` —
--- the `(x)` parses as a transparent `paren` child (project/design/
--- apply-forms-unification.md §1.1/§7). Multi-arg comma forms
--- (`trans(p, q)`, `J(p, m, b)`) do NOT parse call-form yet.
stc : Path(Nat, Nat.succ(Nat.succ(Nat.zero)), Nat.zero) := symm(tt)

-- ---------------------------------------------------------------------
-- P3 — Glue / isFibrant / unglue / fibrant (type-position surface).
-- ---------------------------------------------------------------------

--- `Glue(A, φ, T̂)` — the call-form glue type former — inside type
--- expressions: a Pi codomain, a Pi domain under a dimension face
--- (`f0(i)` — `φ` neither `tt` nor `ff`), and the `isFibrant` type
--- itself. `fF` is the degenerate empty face.
FG : Pi(I, i ~> Glue(Bool, fF, Pi(I, j ~> Bool))) ~> Bool := f ~> true
FD : Pi(I, i ~> Glue(Bool, f0(i), Pi(I, j ~> Bool))) ~> Bool := f ~> true
FI : isFibrant(Glue(Bool, fF, Pi(I, i ~> Bool))) ~> Bool := pf ~> true

--- `unglue(G)` — the type-level projection back to the underlying
--- family: `unglue(Glue(Bool, …))` is `Bool`, so `true` inhabits it.
y : unglue(Glue(Bool, fF, Pi(I, i ~> Bool))) := true

--- `isFibrant(A)` / `fibrant A` — the fibrancy type and its witness.
--- Base sorts derive yes; a bound `A : Type` checks the witness
--- judgment generically (undecided fibrancy warns, never errors).
pfB : isFibrant(Bool) := fibrant Bool
pfBc : isFibrant(Bool) := fibrant(Bool)
fib : Pi(Type, A ~> isFibrant(A)) := A ~> fibrant A

-- ---------------------------------------------------------------------
-- P4 — computing univalence: Equiv / ua / Univalence / univalence.
-- ---------------------------------------------------------------------

--- `Equiv(A, B)` — the equivalence type: an inhabitant is the record
--- `{to : A ~> B, fro : B ~> A}` checked by the `type.equiv`
--- unification arm. `ua(e)` / `Univalence(e)` / `univalence(e)` mint
--- the path `A ~ B` — a `type.pi` over `I` carrying the recorded
--- equivalence (`path.equiv`).
eBN : Equiv(Bool, Nat) := { to: x ~> Nat.zero, fro: y ~> true }
eNB : Equiv(Nat, Bool) := { to: n ~> true, fro: b ~> Nat.zero }
pu := ua(eBN)
pv := Univalence(eBN)
pw := univalence(eBN)

--- `#` along a univalence path applies the recorded equivalence at
--- the type level: `pu : Bool ~ Nat`, so `true : Bool` transports to
--- `Nat` — and the result does *not* inhabit `Bool`.
bv : Bool := true
tv : Nat := pu # bv
nv : Nat := Nat.zero
spu := symm pu
tb : Bool := spu # nv

--- `transport(p, v)` along a univalence path — the call-form twin of
--- `pu # bv`: `true : Bool` transports to `Nat` through the recorded
--- equivalence.
tvc : Nat := transport(pu, bv)

--- `trans` composes recorded equivalences: `ua(eBN) : Bool ~ Nat` and
--- `ua(eNB) : Nat ~ Bool` compose to `Bool ~ Bool`.
qu := ua(eNB)
ptu := trans pu, qu
ttu : Bool := ptu # true
