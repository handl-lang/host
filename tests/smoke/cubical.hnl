--- tests/smoke/cubical.hnl — cubical forms end-to-end through the
--- PRODUCTION `hnl typecheck` path (NBE checker), ADR-0208 P1–P3.
---
--- Covers: the interval sort `I`/`Interval` with `i0`/`i1` endpoints
--- and `Pi(I, i ~> …)` dimension binders; the `Path(A, x, y)` /
--- `PathP(F, x, y)` interval-function type formers with `refl`,
--- lambda-path, and path-alias introductions; `#` transport and the
--- capital `J` eliminator; the P2 judgments `transp`/`hcomp`/`Comp`/
--- `trans`/`symm` over face formulas (`f0`/`f1`/`fnot`/`f_or`/`f_and`/
--- `fT`/`fF`); and the P3 glue/fibrant surface reachable in production
--- — `Glue(A, φ, T̂)`/`isFibrant(A)`/`unglue(G)` in type position and
--- `fibrant A` witnesses.
---
--- Production-surface notes (verified against `hnl typecheck`, which
--- runs the unbound-wire scope pass the Rust NBE fixtures bypass):
---   * `i0`/`i1` literals are NOT accepted as `transp`/`hcomp`/`Comp`
---     dimension operands — bind them first (`e0 : I := i0`) and pass
---     the variable. (NBE parity gap vs the Rust fixtures.)
---   * `p # v` transports only when the result stays unannotated or
---     the path endpoints are index terms — `w : Bool := p # true`
---     over `Path(Bool, true, true)` fails "expected null" while
---     `w := p # true` checks. The annotated `Vec`-index form below
---     (the types.hnl convention) is the supported spelling.
---   * The `glue A, φ, T̂` KEYWORD former and term-position
---     `fibrant`/`Glue`/`transp`-family operands mentioning `Pi`/`I`/
---     `Glue`/`fF`/`f0`/`Sigma` are rejected by the scope pass as
---     unbound wires — those names are type-position-only. The `Glue`
---     CALL form works inside type expressions (annotations, Pi
---     domains), which is what this file exercises.
---   * Univalence (`univalence(e)`/`ua(e)`/`Univalence(e)`/`Equiv`,
---     ADR-0208 P4) is NOT covered: the NBE port is still in flight
---     (`ua`/`Univalence` are unbound wires in the shipped cdylib) —
---     follow-up once P4 lands.

Nat := {
  Zero : Nat,
  Succ : (pred : Nat) ~> Nat
}

Vec<n : Nat, a : Type> := {
  VNil : Vec(0, a),
  VCons : (x : a, xs : Vec(n, a)) ~> Vec(n + 1, a)
}

v2 : Vec<2, Bool> := VCons(true, VCons(false, VNil))

-- ---------------------------------------------------------------------
-- P1 — interval sort, dimension binders, Path/PathP, refl, eliminators.
-- ---------------------------------------------------------------------

--- `i0`/`i1` are closed terms of the interval sort; `Interval` is the
--- same sort under its long name. Bound once here because the P2
--- judgments below take dimension *variables*, not literals.
e0 : I := i0
e1 : Interval := i1

--- A `Pi(I, i ~> T)` binder introduces a dimension variable `i : I`.
fI : Pi(I, i ~> Bool) := i ~> true
gI : Pi(I, i ~> Nat) := i ~> Zero

--- `Path(A, x, y)` is the homogeneous interval function `(i:I) → A`:
--- both a lambda path and `refl` (reflexive endpoints) inhabit it.
cp : Path(Bool, true, true) := i ~> true
cr : Path(Bool, true, true) := refl
cn : Path(Nat, Zero, Zero) := refl

--- `PathP(F, x, y)` is the heterogeneous path `(i:I) → F i` for
--- `F : I → Type`; `refl` inhabits the reflexive endpoint pair.
pp : PathP(Pi(I, i ~> Bool), true, true) := refl

--- `#` transport along a cubical path over index endpoints — the
--- `Path(2, 2)` witness justifies rewriting the `Vec` index (the
--- types.hnl `p # v` discipline, now over the interval `type.pi`).
p22 : Path(2, 2) := refl
moved : Vec<2, Bool> := p22 # v2

--- A path-typed variable is itself a witness; `#` also synthesizes
--- (unannotated) over homogeneous term endpoints.
q22 : Path(2, 2) := p22
wb := cp # true

--- `J p, motive, base` — the capital-J eliminator over a cubical
--- path: checks `base` against the motive at the source endpoint and
--- synthesizes the motive at the target.
jv : Vec<2, Bool> := J p22, (i, w) ~> Vec(i, Bool), v2

-- ---------------------------------------------------------------------
-- P2 — transp / hcomp / Comp / trans / symm.
-- ---------------------------------------------------------------------

--- `transp A, i, φ, u` — transport in the family `A : I → Type` along
--- dimension `i`, partial on face `φ`; CCHM direction `A(i1) → A(i0)`.
--- `fF` is the empty face; faces may mention *other* dimensions.
t1 := transp Pi(I, i ~> Bool), e0, fF, true
t2 := transp Pi(I, i ~> Bool), e0, f0(e1), true
t3 := transp Pi(I, i ~> Bool), e0, f_and(fF, f0(e1)), true
t4 := transp Pi(I, i ~> Bool), e0, f_or(fF, fT), true
t5 := transp Pi(I, i ~> Bool), e0, fnot(fF), true

--- `hcomp A, i, φ, u, cap` — homogeneous composition over a single
--- type; `cap : A` is the `i = 0` face, result `: A`.
h1 : Bool := hcomp Bool, e0, fF, true, false

--- `Comp F, i, φ, u, cap` — heterogeneous composition over
--- `F : I → Type`; `cap : F(i0)`, result `: F(i1)`.
c1 : Bool := Comp Pi(I, i ~> Bool), e0, fF, true, false

--- `trans p, q` / `symm p` — derived path algebra over decided-distinct
--- endpoints; the results are themselves path witnesses.
pt : Path(Nat, Zero, Succ(Zero)) := i ~> Zero
qt : Path(Nat, Succ(Zero), Succ(Succ(Zero))) := i ~> Succ(Zero)
tt : Path(Nat, Zero, Succ(Succ(Zero))) := trans pt, qt
st : Path(Nat, Succ(Succ(Zero)), Zero) := symm tt

-- ---------------------------------------------------------------------
-- P3 — Glue / isFibrant / unglue / fibrant (type-position surface).
-- ---------------------------------------------------------------------

--- `Glue(A, φ, T̂)` — the call-form glue type former — inside type
--- expressions: a Pi codomain, a Pi domain under a dimension face
--- (`f0(i)` — `φ` neither `tt` nor `ff`), and the `isFibrant` type
--- itself. `fF` is the degenerate empty face.
FG : Pi(I, i ~> Glue(Bool, fF, Pi(I, j ~> Bool))) ~> Bool := f ~> true
FD : Pi(I, i ~> Glue(Bool, f0(i), Pi(I, j ~> Bool))) ~> Bool := f ~> true
FI : isFibrant(Glue(Bool, fF, Pi(I, i ~> Bool))) ~> Bool := pf ~> true

--- `unglue(G)` — the type-level projection back to the underlying
--- family: `unglue(Glue(Bool, …))` is `Bool`, so `true` inhabits it.
y : unglue(Glue(Bool, fF, Pi(I, i ~> Bool))) := true

--- `isFibrant(A)` / `fibrant A` — the fibrancy type and its witness.
--- Base sorts derive yes; a bound `A : Type` checks the witness
--- judgment generically (undecided fibrancy warns, never errors).
pfB : isFibrant(Bool) := fibrant Bool
fib : Pi(Type, A ~> isFibrant(A)) := A ~> fibrant A
