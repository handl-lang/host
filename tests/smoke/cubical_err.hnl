--- tests/smoke/cubical_err.hnl — expected-failure smoke: `hnl typecheck`
--- MUST exit nonzero on this file (`ci.sh smoke` asserts it).
---
--- `refl` proves only reflexive path endpoints: `Nat.zero`/`Nat.succ(Nat.zero)`
--- are decided-distinct `Nat` terms, so `Path(Nat, Nat.zero, Nat.succ(Nat.zero))`
--- cannot be inhabited by `refl` (ADR-0208 P1).

Nat := new Inductive {
  zero : Nat,
  succ : (pred : Nat) ~> Nat
}

bad : Path(Nat, Nat.zero, Nat.succ(Nat.zero)) := refl
