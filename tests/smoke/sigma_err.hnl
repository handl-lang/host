--- tests/smoke/sigma_err.hnl — expected-failure smoke: the Σ-intro pair
--- checks the payload against the family at the *actual* witness, so
--- `[Succ(Zero), VNil]` is `Vec(0, Bool)` where `Vec(1, Bool)` is owed:
--- `cannot unify — expected Vec(1, Bool), got Vec(0, ?m)`.

data Nat :: Zero | Succ(pred : Nat)

data Vec(n : Nat, a : Type) :: VNil : Vec(0, a) | VCons(x : a, xs : Vec(n, a)) : Vec(n + 1, a)

bad : Sigma(Nat, m ~> Vec(m, Bool)) = [Succ(Zero), VNil]
