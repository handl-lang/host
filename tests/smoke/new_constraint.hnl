--- tests/smoke/new_constraint.hnl — `X := new Constraint(S…) { shape }`
--- constraint declarations (design/instance-unified-registry.md §2,
--- MTT migration). Driven by `hnl typecheck` (see `ci.sh smoke`).
---
--- `new Constraint(Type)` binds `Eq` as a `type.family` — the same
--- head the record-spelling `Eq<a : Type>` inductive-family form
--- produces — so `instance Eq(Nat) := dict` registers and implicit
--- `<ev : Eq(a)>` evidence binders discharge by the unchanged
--- dictionary search (`synth_instance`/`resolve_instance`). The `{…}`
--- child is the evidence *shape* — a signature record kept as
--- `Eq.shape`/`Eq.shape.vars` — which is also what `ev.<field>`
--- projects through: `ev.evidence` on an `Eq(a)`-typed binder yields
--- the shape's field type with the schematic vars substituted by the
--- goal's index args (`a` ↦ the `family_app`'s arg). The shape is
--- never registered as an instance entry itself.
---
--- Check-side only: `hnl run` has no evidence values to dispatch on
--- (the same erasure caveat as instance.hnl).

Nat := {
  Zero : Nat,
  Succ : (pred : Nat) ~> Nat
}

Bool := {
  True : Bool,
  False : Bool
}

--- The `Constraint` schema stub — `new Constraint(S…)` is
--- checker-native (the unified registry's constraint kind); the stub
--- only binds the schema head as a wire for the scope pass, the same
--- role the `Algebra` stub plays in new_decl.hnl.
Constraint<s : Type> := {
  mkConstraint : (shape : Type) ~> Constraint
}

--- The `Constraint` schema: `Type` is the index sort; the dict child
--- is the evidence shape (`a` implicitly generalizes over the index).
Eq := new Constraint(Type) {
  evidence : a ~> a ~> Bool
}

instance Eq(Nat) := { evidence: (x, y) ~> x == y }

--- `<a, ev : Eq(a)>` — the evidence binder discharges `Eq(Nat)` by
--- dictionary search at the call site; no explicit dict argument.
eq_refl<a, ev : Eq(a)> : a ~> a := v ~> v

r := eq_refl(Zero)

--- The learn-doc example (docs/learn "Instances and evidence"): the
--- dict field name matches the shape's `evidence` declaration, and
--- `ev.evidence` projects the shape field type — `eqv(Zero)(Zero)`
--- typechecks end to end.
eqv<a, ev : Eq(a)> : a ~> a ~> Bool :=
  x ~> y ~> ev.evidence(x, y)

nat_eq : Bool := eqv(Zero)(Zero)
