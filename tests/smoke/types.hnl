--- tests/smoke/types.hnl — indexed `data` families, dependent `match`,
--- `F.rec`, and paths. Driven by `hnl typecheck` (see `ci.sh smoke`).
---
--- Syntax note: implicit index binders / index application are spelled
--- `<…>` (`vhead<n, a>`, `Vec<1, Bool>`) — the `{…}` surface migrated to
--- `<>` (a dimension IS an index; phase-2 WS-C). `Vec<Nat.succ n, a>` folds
--- whitespace into `call` inside the bracket.

Nat := new Inductive {
  zero : Nat,
  succ : (pred : Nat) ~> Nat
}

Vec<n : Nat, a : Type> := new Inductive {
  vnil : Vec(0, a),
  vcons : (x : a, xs : Vec(n, a)) ~> Vec(n + 1, a)
}

v1 : Vec<2, Bool> := Vec.vcons(true, Vec.vcons(false, Vec.vnil))

-- ---------------------------------------------------------------------
-- match — dependent elimination: each ctor pattern refines the
-- scrutinee's family index for the duration of the arm.
-- ---------------------------------------------------------------------

--- `Vec<Nat.succ n, a>` is definitionally `Vec<n + 1, a>` (WS-D bridge), so a
--- Vec.vcons-only match is *provably* exhaustive — no catchall, and a stray
--- Vec.vnil arm is decided-impossible (auto-discharged, or `Vec.vnil: absurd`).
export vhead<n, a> : Vec<Nat.succ n, a> ~> a := v ~> match v { Vec.vcons(x, xs): x }

export vtail<n, a> : Vec<n + 1, a> ~> Vec<n, a> := v ~> match v { Vec.vcons(x, xs): xs }

--- Two-arm match: under Vec.vnil the index refines `n ≡ 0`; under Vec.vcons,
--- `n ≡ ?k + 1` with `xs : Vec<?k, a>`.
export is_nil<n, a> : Vec<n, a> ~> Bool :=
  v ~> match v { Vec.vnil: true, Vec.vcons(x, xs): false }

-- ---------------------------------------------------------------------
-- `F.rec` — the family eliminator is visible to the checker:
-- `Vec.rec(motive, vnil_case, vcons_case)(indices…, scrutinee)`.
-- ---------------------------------------------------------------------

step : Bool ~> Vec<1, Bool> ~> Nat ~> Nat := x ~> xs ~> ih ~> Nat.succ(ih)
len_via_rec : Nat := Vec.rec(null, Nat.zero, step)(2, Bool, v1)

-- ---------------------------------------------------------------------
-- Path / refl / transport / J — equality is paths (proof-relevant).
-- ---------------------------------------------------------------------

p : Path(1, 1) := refl

--- `p # v` transports `v` along `p`; a `Path` bound in the environment
--- justifies the rewrite.
moved : Nat := p # Nat.zero

--- `match … return (i, w) ~> T with {…}` binds the branch-local `eq_*`
--- witnesses: the Vec.vnil arm eliminates `eq_n` through `J`, the Vec.vcons arm
--- transports `v` along it.
id_vec : Pi(Nat, n ~> Pi(Vec(n + 0, Bool), v ~> Vec(n + 0, Bool))) :=
  n ~> v ~> match v return (i, w) ~> Vec(i, Bool) with {
    Vec.vnil: J eq_n, (i2, w2) ~> Vec(i2, Bool), v,
    Vec.vcons(x, xs): eq_n # v
  }
