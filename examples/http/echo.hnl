--- echo -- a Handl HTTP + WebSocket server on the epoll scheduler.
---
--- Run it:
---   target/debug/hnl run examples/http/echo.hnl
---
--- Then, from another shell:
---   curl http://127.0.0.1:8080/hello
---   curl -X POST -d 'ping' http://127.0.0.1:8080/echo
---   websocat ws://127.0.0.1:8080/ws        # or any WS client
---
--- Everything below is Handl: the listener, the HTTP/1.1 codec, the
--- WebSocket upgrade and frame loop, and the scheduler that multiplexes
--- them. Rust only provides the kernel syscalls the scheduler calls
--- through the generated libc bindings.

from "../../handl-packages/serve-epoll/serve-epoll" import { serve }

--- Plain HTTP handler: a small router. Handlers are ordinary arrows, so
--- they can be tested by calling them with a request record.
handler := (req) ~> do {
  if req.path == "/hello" {
    { status: 200, headers: { "content-type": "text/plain" }, body: "hello" }
  } else if req.path == "/echo" {
    { status: 200, body: req.body }
  } else {
    { status: 404, body: "no route for " + req.path }
  }
}

--- WebSocket handler: echo the message back. `msg` is
--- `{ op: "text"|"binary", text: String, bytes: Bytes }`; a null reply
--- sends nothing.
ws_echo := (req, msg) ~> do { "ws echo: " + msg.text }

--- serve() blocks: the accept loop *is* the process main loop. HTTP
--- requests go to `handler`, upgrades to `on_ws`.
serve(handler, { port: 8080, on_ws: ws_echo })
