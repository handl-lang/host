{
  apply_twice: ([f, n]~> f(f(n)))(n ~> n + 1, 5),
  compose: ([f, g, x]~> f(g(x)))(
    n ~> n + 1,
    n ~> n * 2,
    5
  ),
  thrice: ([f, x]~> f(f(f(x))))(n ~> n * 2, 1),
  add: ([x, y]~> x + y)(3, 4),
  first: [(n ~> n + 1), (n ~> n * 2), (n ~> n * n)].0(10),
  second: [(n ~> n + 1), (n ~> n * 2), (n ~> n * n)].1(10),
  third: [(n ~> n + 1), (n ~> n * 2), (n ~> n * n)].2(10)
}
