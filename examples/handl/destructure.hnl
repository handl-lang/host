{
  head: match [1, 2, 3] { []: 0, [h, ...t]: h },
  tail_len: (proc (self) -> self(self, [10, 20, 30, 40]))(
    proc (self, xs) -> match xs {
      []: 0,
      [h, ...t]: 1 + self(self, t)
    }
  ),
  empty: match [] { []: "empty", [h, ...t]: "nonempty" },
  object: match { name: "alice", age: 30 } { { name: n, age: a }: n },
  pair: match [3, 4] { [a, b]: a + b },
  first_of: match ["x", "y", "z"] { [first, ...rest]: first }
}
