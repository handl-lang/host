--- option — Option type and constructors.
--- @details
--- The `option` contract declares the `Option<T>` type and the `some`
--- / `none` constructors. Backends implement these pure, total arrows.

--- @template T - the value type
--- The `Option<T>` type.
--- @details
--- An `Option<T>` is either `None` or `Some(value: T)`.
export Option < T >: Type

--- Construct a Some option wrapping a value.
--- @param {value} - the value of type T
--- @returns {Option<T>}
export some < T >: T ~ [Total] ~> Option < T >

--- Construct a None option.
--- @returns {Option<T>}
export none < T >: () ~ [Total] ~> Option < T >
