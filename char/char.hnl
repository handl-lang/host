--- Axioms and laws for the character library.
---
--- This is the abstraction contract for `char`: the irreducible floor that
--- every character backend (`char-native` on Rust `std::char`, `char-ascii`,
--- `char-js`, or a future `char-icu`) must satisfy. All `str-handl`
--- algorithms are written on top of this contract, so swapping the `char`
--- backend changes semantics (e.g. ASCII-only vs full Unicode) without
--- touching a single string algorithm.
---
--- Names are *semantic*, not implementation-specific: `is_whitespace`,
--- `is_alpha`, `to_upper` — never `is_unicode_whitespace` or `utf8_at`.
--- The contract deliberately says nothing about encoding (UTF-8/16/32) or
--- about Unicode vs ASCII vs locale: each backend defines what counts as
--- "whitespace", "alphabetic", "uppercase", etc. A backend that documents
--- itself as Unicode-capable interprets these per the Unicode Character
--- Database; `char-ascii` interprets them per ASCII.
---
--- Indices are always character indices (logical positions in the char
--- sequence), never byte offsets — `at(s, i)` returns the i-th character.
--- Characters are represented as 1-char strings; there is no separate char
--- type in handl. `code_point`/`from_code_point` are the only ops that
--- expose scalar values; backends without Unicode may limit the range.
---
--- Predicate vocabulary is the same as `str/str.hnl`
--- (`plugin-ext-refinement`'s `Pred`): LengthEq, LengthLe, Le, IsPerm,
--- AllSatisfy, True/False, &&, ||, ==>. Char-specific predicates
--- (IsChar, IsWhitespace, IsAlpha, IsUpper, IsLower, CodePointEq,
--- IsValidIndex) are documented inline as `-- LAW:` comments; the
--- `guarantee:` line carries the strongest parseable approximation.

-- ---------------------------------------------------------------------------
-- Character classification atoms
-- ---------------------------------------------------------------------------

axiom char.is_whitespace : String -> Bool
-- LAW: output <=> IsWhitespace(input)  (backend-defined "whitespace")
guarantee: True

axiom char.is_alpha : String -> Bool
-- LAW: output <=> IsAlpha(input)  (backend-defined "alphabetic")
guarantee: True

axiom char.is_numeric : String -> Bool
-- LAW: output <=> IsNumeric(input)  (backend-defined "numeric")
guarantee: True

axiom char.is_alnum : String -> Bool
-- LAW: output <=> IsAlpha(input) || IsNumeric(input)
guarantee: True

axiom char.is_uppercase : String -> Bool
-- LAW: output <=> IsUpper(input)
guarantee: True

axiom char.is_lowercase : String -> Bool
-- LAW: output <=> IsLower(input)
guarantee: True

-- ---------------------------------------------------------------------------
-- Case-mapping atoms
-- ---------------------------------------------------------------------------
--
-- Case maps may expand: `to_upper("ß")` is "SS" under Unicode, so these
-- take a string (1 char) and return a string (possibly multi-char).

axiom char.to_upper : String -> String
-- LAW: IsUpper(output)  (backend-defined case map; may expand e.g. ß→SS)
guarantee: True

axiom char.to_lower : String -> String
-- LAW: IsLower(output)
guarantee: True

axiom char.to_title : String -> String
-- LAW: IsTitle(output); backends without titlecase use to_upper
guarantee: True

-- ---------------------------------------------------------------------------
-- Scalar-value conversion atoms
-- ---------------------------------------------------------------------------

axiom char.code_point : String -> Int
-- LAW: output = CodePoint(input); requires input is a single char
requires: LengthEq(input, 1)
guarantee: Le(0, output)

axiom char.from_code_point : Int -> String
-- LAW: output is the char whose scalar value is input; fails if input is
-- not a valid scalar value in the backend's character set
requires: Le(0, input)
-- LAW: LengthEq(output, 1) && code_point(output) = input
guarantee: True

-- ---------------------------------------------------------------------------
-- Char-sequence access atoms (indices are char indices, not bytes)
-- ---------------------------------------------------------------------------

axiom char.at : (String * Int) -> String
-- LAW: output = input[input.1] as a 1-char string
requires: Le(0, input.1) && LengthLe(input.1, input.0)
-- LAW: LengthEq(output, 1)
guarantee: True

axiom char.slice : (String * Int * Int) -> String
-- LAW: output = input[input.1 .. input.2] (char indices)
requires: Le(0, input.1) && Le(input.1, input.2) && LengthLe(input.2, input.0)
guarantee: LengthLe(output, input.0)

axiom char.length : String -> Int
-- LAW: output = number of chars in input
guarantee: Le(0, output)

axiom char.concat : (String * String) -> String
-- LAW: LengthEq(output, input.0 + input.1)
guarantee: LengthLe(input.0, output) && LengthLe(input.1, output)

axiom char.code_point_at : (String * Int) -> Int
requires: Le(0, input.1) && LengthLe(input.1, input.0)
-- LAW: output = code_point(at(input.0, input.1))
guarantee: Le(0, output)

-- ---------------------------------------------------------------------------
-- Bulk char-sequence conversion atoms (O(n) split/join)
-- ---------------------------------------------------------------------------
--
-- `char.at` is O(i) per call in most backends, so iterating a string via
-- `at` is O(n^2) — not prod-ready. `chars`/`from_chars` let `str-handl`
-- algorithms iterate char lists in O(n) total. The list element type is a
-- 1-char string, keeping the contract encoding-agnostic.

axiom char.chars : String -> List String
-- LAW: LengthEq(output, input) && forall c in output, IsChar(c)
--      && from_chars(chars(s)) = s  (round-trip)
guarantee: True

axiom char.from_chars : List String -> String
-- LAW: from_chars(chars(s)) = s  (round-trip)
guarantee: True
