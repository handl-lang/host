--- Axioms and laws for the unicode library.
---
--- `unicode` sits above `char`: `char` knows scalar values and character
--- categories; `unicode` knows *text-level* structure that requires Unicode
--- data tables -- grapheme clusters (UAX #29), canonical normalization
--- (UAX #15), full case folding (CaseFolding.txt), and display width
--- (UAX #11, East Asian Width).
---
--- This is the abstraction contract: every `unicode` backend
--- (`unicode-c` on system ICU4C via `ffi`, a future `unicode-js` on
--- `Intl`/`String.prototype`, ...) must satisfy these laws. Names are
--- *semantic*, not implementation-specific -- never `nfc_icu4x` or
--- `graphemes_utf16`.
---
--- Because the algorithms need Unicode tables, backends differ in
--- *coverage*, not in *meaning*. The canonical backend is
--- `handl-packages/unicode-c`, which splits by need: code-point interop
--- (`code_points`, `from_code_points`, `is_ascii`, `code_point_at`) and
--- `decode` are pure handl and exact on any host, while the
--- table-dependent ops (`graphemes`/`grapheme_count`, `width`,
--- `casefold`, `nfc`/`nfd`, the XID predicates) call the host's ICU4C.
--- Where the host lacks ICU those ops *raise* rather than approximating:
--- a coarse fallback (`grapheme` = code point, `width` = code-point
--- count) is silently wrong off ASCII, so this contract prefers a loud
--- failure to plausible-looking wrong data.
---
--- Text is `String`; code points are `Int` scalar values; grapheme and
--- code-point lists are `List String`/`List Int`. Indices are grapheme
--- indices unless stated otherwise. `graphemes(s)` must satisfy
--- `concat(graphemes(s)) == s` and `LengthEq(graphemes(s), grapheme_count(s))`.
---
--- Predicate vocabulary is the same as `str/str.hnl`/`char/char.hnl`
--- (`plugin-ext-refinement`'s `Pred`): LengthEq, LengthLe, Le, IsPerm,
--- AllSatisfy, True/False, &&, ||, ==>. Unicode-specific predicates
--- (IsNormalized, IsGraphemeCluster, WidthEq, IsAscii) are documented
--- inline as `-- LAW:` comments; the `guarantee:` line carries the
--- strongest parseable approximation.

-- ---------------------------------------------------------------------------
-- Code-point interop (char-level; pure-handl implementable)
-- ---------------------------------------------------------------------------

axiom unicode.code_points : String -> List Int
-- LAW: output = map char.code_point (char.chars input)
--      && LengthEq(output, char.length input)
  guarantee: True

axiom unicode.from_code_points : List Int -> String
-- LAW: output = char.from_chars (map char.from_code_point input);
--      fails if any element is not a valid scalar value
-- LAW: code_points(from_code_points(input)) = input  (round-trip)
  guarantee: True

axiom unicode.is_ascii : String -> Bool
-- LAW: output <=> forall c in char.chars(input), code_point(c) < 128
  guarantee: True

-- ---------------------------------------------------------------------------
-- Code-point access + UTF-8 decode -- `unicode.code_point_at` and
-- `unicode.decode` are the current `plugin-lib-unicode` surface
-- ---------------------------------------------------------------------------

axiom unicode.code_point_at : (String * Int) -> Int
-- LAW: output = char.code_point_at(input.0, input.1); out-of-range index
--      yields a backend-defined null/0 sentinel
  requires: Le(0, input.1) && LengthLe(input.1, input.0)
  guarantee: Le(0, output)

axiom unicode.decode : String -> List Int
-- LAW: output = [byte_offset, code_point] pairs decoding input's UTF-8
--      bytes; LengthEq(output, 2 * char.length input) for ASCII
  guarantee: True

-- ---------------------------------------------------------------------------
-- Identifier categories (UAX #31) -- backend-required
-- ---------------------------------------------------------------------------
--
-- XID_Start/XID_Continue and identifier validity need the DerivedCore
-- properties table -- not computable from `char.*` atoms. Provided by
-- `unicode-c` (ICU4C `u_hasBinaryProperty`) / `unicode-js` (regex
-- `\p{ID_Start}` / `\p{ID_Continue}`).

axiom unicode.is_valid_identifier : String -> Bool
-- LAW: output <=> input is a valid Unicode identifier (UAX #31:
--      XID_Start followed by XID_Continue*)
  guarantee: True

axiom unicode.is_xid_start : String -> Bool
-- LAW: output <=> first char of input is in XID_Start
  guarantee: True

axiom unicode.is_xid_continue : String -> Bool
-- LAW: output <=> first char of input is in XID_Continue
  guarantee: True

-- ---------------------------------------------------------------------------
-- Grapheme clusters (UAX #29) -- table-dependent
-- ---------------------------------------------------------------------------
--
-- A grapheme cluster is a user-perceived "character": base + combining
-- marks, emoji sequences, CRLF, regional-indicator pairs. A code-point
-- fallback would be *conservatively correct* for ASCII/single-scalar text
-- but silently under-segments real cluster text (a ZWJ family emoji is one
-- cluster, not five), so this contract requires the real segmentation
-- rather than a fallback: `unicode-c` calls ICU4C's `ubrk_*` (UAX #29);
-- `unicode-js` would use `Intl.Segmenter`.

axiom unicode.graphemes : String -> List String
-- LAW: concat(graphemes(input)) = input  (covering)
--      && LengthEq(output, grapheme_count(input))
  guarantee: True

axiom unicode.grapheme_count : String -> Int
-- LAW: output = LengthEq(graphemes(input))
  guarantee: Le(0, output)

-- ---------------------------------------------------------------------------
-- Display width (UAX #11) -- table-dependent
-- ---------------------------------------------------------------------------
--
-- `width` is the terminal column count: full-width/wide chars count 2,
-- combining marks 0, control/ASCII 1. A code-point-count fallback is
-- conservatively correct for ASCII but under-counts wide chars and
-- over-counts combining marks.

axiom unicode.width : String -> Int
-- LAW: output = sum of per-grapheme display widths (UAX #11)
--      && Le(grapheme_count(input), output) for ASCII-visible text
  guarantee: Le(0, output)

-- ---------------------------------------------------------------------------
-- Case folding (CaseFolding.txt) -- table-dependent
-- ---------------------------------------------------------------------------
--
-- Full case folding maps "ß"->"ss", ligatures, etc. -- stronger than
-- lowercasing (which `char.to_lower`/`str.lower` provide). A lowercasing
-- fallback is conservatively correct for ASCII but misses fold-only
-- mappings.

axiom unicode.casefold : String -> String
-- LAW: output = full case fold (CaseFolding.txt); casefold(casefold(s))
--      = casefold(s) (idempotent) && IsLower(output) under Unicode
  guarantee: True

-- ---------------------------------------------------------------------------
-- Normalization (UAX #15) -- backend-required
-- ---------------------------------------------------------------------------
--
-- Canonical composition/decomposition require the normalization tables.
-- These are declared in the contract but are *not* implementable in pure
-- handl over `char.*`, so a backend must supply them: `unicode-c` calls
-- ICU4C's `unorm2_*`, and on a host without ICU the call fails loudly
-- rather than silently returning un-normalized text. `unicode-js` would
-- use `String.prototype.normalize`.

axiom unicode.nfc : String -> String
-- LAW: IsNormalized(output, NFC) && nfc(nfc(s)) = nfc(s) (idempotent)
--      && nfc(char.concat(a, nfc(b))) = nfc(char.concat(a, b))
  guarantee: True

axiom unicode.nfd : String -> String
-- LAW: IsNormalized(output, NFD) && nfd(nfd(s)) = nfd(s) (idempotent)
--      && nfc(nfd(s)) = nfc(s)  (round-trip through composition)
  guarantee: True
