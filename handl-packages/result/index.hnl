--- Result type and constructors.
--- @details
--- The `result` package provides the `Result<T, E>` type and the `ok`
--- / `err` constructors over the host tag system (ADR-0055/0077).

--- @template T - the success value type
--- @template E - the error value type
--- The `Result<T, E>` type.
--- @details
--- A `Result<T, E>` is either `Ok(value: T)` or `Err(error: E)`.
export Result<T, E> := Type

--- Construct an Ok result wrapping a success value.
--- @param {value} - the success value of type T
--- @returns {Result<T, E>}
export ok<T, E>: T ~[1]~> Result<T, E> := (value: T) ~> do {
  tag.tag("ok", { value: value })
}

--- Construct an Err result wrapping an error value.
--- @param {error} - the error value of type E
--- @returns {Result<T, E>}
export err<T, E>: E ~[1]~> Result<T, E> := (error: E) ~> do {
  tag.tag("err", { value: error })
}
