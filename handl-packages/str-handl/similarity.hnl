--- `str.similarity` — part of `str-handl`, the pure-Handl `str` implementation over `char`.

from "char" import * as char
from "./levenshtein.hnl" import levenshtein

--- A similarity score between `a` and `b` in `[0.0, 1.0]`.
---
--- @details
--- `1.0 - levenshtein(a, b) / max(len(a), len(b))`; two empty strings
--- score `1.0`.
---
--- @param {a} - the first string
--- @param {b} - the second string
--- @returns {Float - similarity ratio}
--- @example
--- `str.similarity("kitten", "sitting")`
--- -- => 0.5714...
---
export similarity := (a, b) ~> do {
  la := char.length(a)
  lb := char.length(b)
  mx := if la > lb { la } else { lb }
  if mx == 0 { 1.0 } else {
    d := levenshtein(a, b)
    1.0 - (d / (mx + 0.0))
  }
}
