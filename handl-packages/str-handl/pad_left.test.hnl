from "./pad_left" import * as m

test_pad_left_basic := assert m.pad_left("hi", 5, "*") = "***hi"

test_pad_left_cycle := assert m.pad_left("hi", 5, "ab") = "abahi"

test_pad_left_enough := assert m.pad_left("hi", 2, "*") = "hi"

test_pad_left_empty_pad := assert m.pad_left("hi", 5, "") = "hi"

test_pad_left_short := assert m.pad_left("hi", 1, "*") = "hi"

test_pad_left_zeros := assert m.pad_left("42", 5, "0") = "00042"

test_pad_left_empty_s := assert m.pad_left("", 3, "x") = "xxx"
