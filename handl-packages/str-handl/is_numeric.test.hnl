from "./is_numeric" import * as m

test_is_numeric_digits := assert m.is_numeric("123") = true

test_is_numeric_letter := assert m.is_numeric("1a") = false

test_is_numeric_empty := assert m.is_numeric("") = false

test_is_numeric_dot := assert m.is_numeric("1.5") = false

test_is_numeric_zero := assert m.is_numeric("0") = true

test_is_numeric_space := assert m.is_numeric("1 2") = false
