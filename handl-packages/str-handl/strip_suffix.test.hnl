from "./strip_suffix" import * as m

test_strip_suffix_basic := assert m.strip_suffix("hello", "lo") = "hel"

test_strip_suffix_miss := assert m.strip_suffix("abc", "z") = "abc"

test_strip_suffix_whole := assert m.strip_suffix("abc", "abc") = ""

test_strip_suffix_empty_pat := assert m.strip_suffix("abc", "") = "abc"

test_strip_suffix_llo := assert m.strip_suffix("hello", "llo") = "he"

test_strip_suffix_empty_s := assert m.strip_suffix("", "a") = ""
