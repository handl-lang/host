--- `str.is_alphanumeric` — part of `str-handl`, the pure-Handl `str` implementation over `char`.

from "char" import * as char
from "./internal/len.hnl" import len
from "./internal/all.hnl" import all

--- Whether every character of `s` is alphanumeric.
---
--- @details
--- An empty `s` returns `false`.
---
--- @param {s} - the input string
--- @returns {Bool - `true` iff `s` is non-empty and all-alphanumeric}
--- @example
--- `str.is_alphanumeric("abc123")`
--- -- => true
---
export is_alphanumeric := (s) ~> do {
  cs := char.chars(s)
  if len(cs) == 0 { false } else { all(cs, c ~> char.is_alnum(c)) }
}
