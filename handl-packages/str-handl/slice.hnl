--- `str.slice` — part of `str-handl`, the pure-Handl `str` implementation over `char`.

from "char" import * as char

--- The substring of `s` between char indices `a` (inclusive) and `b`
--- (exclusive).
---
--- @details
--- Delegates to `char.slice` (char-indexed).
---
--- @param {s} - the input string
--- @param {a} - the start char index
--- @param {b} - the end char index
--- @returns {String - `s[a..b]`}
--- @example
--- `str.slice("hello", 1, 4)`
--- -- => "ell"
---
export slice := (s, a, b) ~> do {
  char.slice(s, a, b)
}
