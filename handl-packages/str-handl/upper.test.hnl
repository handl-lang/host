from "./upper" import * as m

test_upper_basic := assert m.upper("hEllO") = "HELLO"

test_upper_empty := assert m.upper("") = ""

test_upper_already := assert m.upper("ABC") = "ABC"

test_upper_digits_punct := assert m.upper("a1!") = "A1!"

test_upper_spaces := assert m.upper("hello world") = "HELLO WORLD"

test_upper_unicode := assert m.upper("héllo") = "HÉLLO"
