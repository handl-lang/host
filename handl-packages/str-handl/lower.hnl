--- `str.lower` — part of `str-handl`, the pure-Handl `str` implementation over `char`.

from "char" import * as char
from "./internal/map.hnl" import map

--- Lowercases every character of `s`.
---
--- @details
--- Per-char case map over the whole string (`char.to_lower` is a
--- single-char atom; this lifts it to strings). Length-preserving.
---
--- @param {s} - the input string
--- @returns {String - `s` lowercased}
--- @example
--- `str.lower("Hello")`
--- -- => "hello"
---
export lower := (s) ~> do {
  char.from_chars(map(char.chars(s), c ~> char.to_lower(c)))
}
