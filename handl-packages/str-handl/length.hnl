--- `str.length` — part of `str-handl`, the pure-Handl `str` implementation over `char`.

from "char" import * as char

--- The number of characters in `s`.
---
--- @details
--- Delegates to `char.length`: length is counted in characters
--- (Unicode scalar values for the `char-native` backend), not bytes.
---
--- @param {s} - the input string
--- @returns {Nat - character count}
--- @example
--- `str.length("hello")`
--- -- => 5
---
export length := (s) ~> do {
  char.length(s)
}
