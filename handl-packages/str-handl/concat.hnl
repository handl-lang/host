--- `str.concat` — part of `str-handl`, the pure-Handl `str` implementation over `char`.

--- Concatenates `a` and `b`.
---
--- @param {a} - the left string
--- @param {b} - the right string
--- @returns {String - `a` followed by `b`}
--- @example
--- `str.concat("foo", "bar")`
--- -- => "foobar"
---
export concat := (a, b) ~> do {
  a + b
}
