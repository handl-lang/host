--- `str.rfind` — part of `str-handl`, the pure-Handl `str` implementation over `char`.

from "char" import * as char
from "./internal/len.hnl" import len
from "./internal/drop.hnl" import drop
from "./internal/prefix_match.hnl" import prefix_match

--- The char index of the last occurrence of `pat` in `s`, or `-1`.
---
--- @details
--- An empty `pat` matches at `len(s)` (Rust `str::rfind("")`
--- semantics).
---
--- @param {s} - the haystack
--- @param {pat} - the needle
--- @returns {Int - last match index, `-1` when absent}
--- @example
--- `str.rfind("aXbXc", "X")`
--- -- => 3
---
export rfind := (s, pat) ~> do {
  ps := char.chars(pat)
  cs := char.chars(s)
  m := len(ps)
  if m == 0 { len(cs) } else {
    last_hit := 0 - 1
    i := 0
    ys := cs
    for _ in cs { do {
      if len(ys) > 0 {
        if prefix_match(ys, ps) {
          last_hit := i
        }
        ys := drop(ys, 1)
        i := i + 1
      }
    } }
    last_hit
  }
}
