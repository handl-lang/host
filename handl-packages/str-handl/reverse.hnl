--- `str.reverse` — part of `str-handl`, the pure-Handl `str` implementation over `char`.

from "char" import * as char
from "./internal/rev.hnl" import rev

--- Reverses `s` by character.
---
--- @param {s} - the input string
--- @returns {String - `s` with chars in reverse order}
--- @example
--- `str.reverse("abc")`
--- -- => "cba"
---
export reverse := (s) ~> do {
  char.from_chars(rev(char.chars(s)))
}
