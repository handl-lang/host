from "./lower" import * as m

test_lower_basic := assert m.lower("hEllO") = "hello"

test_lower_empty := assert m.lower("") = ""

test_lower_already := assert m.lower("abc") = "abc"

test_lower_digits_punct := assert m.lower("A1!") = "a1!"

test_lower_spaces := assert m.lower("HELLO WORLD") = "hello world"
