--- `str.replace_first` — part of `str-handl`, the pure-Handl `str` implementation over `char`.

from "char" import * as char
from "./internal/len.hnl" import len
from "./internal/drop.hnl" import drop
from "./internal/take.hnl" import take
from "./internal/find_idx.hnl" import find_idx

--- Replaces the first occurrence of `old` in `s` with `to`.
---
--- @details
--- An empty `old` inserts `to` at position 0 (Rust `replacen("", to, 1)`
--- semantics). No occurrence leaves `s` unchanged.
---
--- @param {s} - the input string
--- @param {old} - the substring to replace
--- @param {to} - the replacement
--- @returns {String - `s` with the first occurrence replaced}
--- @example
--- `str.replace_first("aXbXc", "X", "-")`
--- -- => "a-bXc"
---
export replace_first := (s, old, to) ~> do {
  cs := char.chars(s)
  fs := char.chars(old)
  m := len(fs)
  if m == 0 {
    to + s
  } else {
    idx := find_idx(cs, fs)
    if idx < 0 { s } else {
      char.from_chars(take(cs, idx)) + to + char.from_chars(drop(cs, idx + m))
    }
  }
}
