--- `str.find` — part of `str-handl`, the pure-Handl `str` implementation over `char`.

from "char" import * as char
from "./internal/find_idx.hnl" import find_idx

--- The char index of the first occurrence of `pat` in `s`, or `-1`.
---
--- @details
--- An empty `pat` matches at index 0.
---
--- @param {s} - the haystack
--- @param {pat} - the needle
--- @returns {Int - first match index, `-1` when absent}
--- @example
--- `str.find("hello", "ll")`
--- -- => 2
---
export find := (s, pat) ~> do {
  find_idx(char.chars(s), char.chars(pat))
}
