from "./contains" import * as m

test_contains_hit := assert m.contains("hello", "ell") = true

test_contains_miss := assert m.contains("hello", "z") = false

test_contains_empty_pat := assert m.contains("abc", "") = true

test_contains_empty_s := assert m.contains("", "a") = false

test_contains_both_empty := assert m.contains("", "") = false

test_contains_whole := assert m.contains("abc", "abc") = true
