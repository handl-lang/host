--- `str.replace` — part of `str-handl`, the pure-Handl `str` implementation over `char`.

from "char" import * as char
from "./internal/rev.hnl" import rev
from "./internal/len.hnl" import len
from "./internal/head.hnl" import head
from "./internal/drop.hnl" import drop
from "./internal/append.hnl" import append
from "./internal/prefix_match.hnl" import prefix_match

--- Replaces every non-overlapping occurrence of `old` in `s` with `to`.
---
--- @details
--- An empty `old` inserts `to` at every char boundary:
--- `"abc".replace("", "-")` -> `"-a-b-c-"` (Rust semantics).
---
--- @param {s} - the input string
--- @param {old} - the substring to replace
--- @param {to} - the replacement
--- @returns {String - `s` with replacements applied}
--- @example
--- `str.replace("aXbXc", "X", "-")`
--- -- => "a-b-c"
---
export replace := (s, old, to) ~> do {
  cs := char.chars(s)
  fs := char.chars(old)
  ts := char.chars(to)
  m := len(fs)
  if m == 0 {
    racc := []
    for h in cs { do {
      racc := [h, ...racc]
      for tc in rev(ts) { do {
        racc := [tc, ...racc]
      } }
    } }
    char.from_chars(append(ts, rev(racc)))
  } else {
    racc := []
    ys := cs
    for _ in cs { do {
      if len(ys) > 0 {
        if prefix_match(ys, fs) {
          for tc in rev(ts) { do {
            racc := [tc, ...racc]
          } }
          ys := drop(ys, m)
        } else {
          racc := [head(ys), ...racc]
          ys := drop(ys, 1)
        }
      }
    } }
    char.from_chars(rev(racc))
  }
}
