--- `str.strip_suffix` — part of `str-handl`, the pure-Handl `str` implementation over `char`.

from "char" import * as char
from "./internal/rev.hnl" import rev
from "./internal/len.hnl" import len
from "./internal/drop.hnl" import drop
from "./internal/prefix_match.hnl" import prefix_match

--- Removes the suffix `p` from `s` when present.
---
--- @param {s} - the input string
--- @param {p} - the suffix to strip
--- @returns {String - `s` without `p`, or `s` unchanged}
--- @example
--- `str.strip_suffix("hello", "lo")`
--- -- => "hel"
---
export strip_suffix := (s, p) ~> do {
  cs := char.chars(s)
  ps := char.chars(p)
  rcs := rev(cs)
  rps := rev(ps)
  if prefix_match(rcs, rps) { char.from_chars(rev(drop(rcs, len(ps)))) } else { s }
}
