from "./split_whitespace" import * as m

test_split_whitespace_basic := assert m.split_whitespace("  a  b\tc ") = ["a", "b", "c"]

test_split_whitespace_empty := assert m.split_whitespace("") = []

test_split_whitespace_single := assert m.split_whitespace("a") = ["a"]

test_split_whitespace_all_ws := assert m.split_whitespace("   ") = []

test_split_whitespace_newline := assert m.split_whitespace("a\nb") = ["a", "b"]

test_split_whitespace_two := assert m.split_whitespace("x  y") = ["x", "y"]
