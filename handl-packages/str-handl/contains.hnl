--- `str.contains` — part of `str-handl`, the pure-Handl `str` implementation over `char`.

from "char" import * as char
from "./internal/find_idx.hnl" import find_idx

--- Whether `pat` occurs anywhere in `s`.
---
--- @param {s} - the haystack
--- @param {pat} - the needle
--- @returns {Bool - `true` iff `pat` is a substring of `s`}
--- @example
--- `str.contains("hello", "ell")`
--- -- => true
---
export contains := (s, pat) ~> do {
  find_idx(char.chars(s), char.chars(pat)) >= 0
}
