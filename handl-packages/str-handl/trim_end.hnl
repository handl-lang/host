--- `str.trim_end` — part of `str-handl`, the pure-Handl `str` implementation over `char`.

from "char" import * as char

--- Removes trailing whitespace.
---
--- @param {s} - the input string
--- @returns {String - `s` with trailing whitespace stripped}
--- @example
--- `str.trim_end("  hi  ")`
--- -- => "  hi"
---
--- @details Scans back from the end for the last non-whitespace char index
--- and takes one `char.slice`. The previous form reversed the char list,
--- dropped the prefix, and reversed again — quadratic per element.
export trim_end := (s) ~> do {
  n :: char.length(s)
  j :: while { s: s, j: n } {
    (st) ~> if st.j <= 0 {
      { out: 0 }
    } else if char.is_whitespace(char.at(st.s, st.j - 1)) {
      { state: { s: st.s, j: st.j - 1 } }
    } else {
      { out: st.j }
    }
  }
  char.slice(s, 0, j)
}
