--- `str.capitalize` — part of `str-handl`, the pure-Handl `str` implementation over `char`.

from "char" import * as char
from "./internal/map.hnl" import map

--- Uppercases the first character of `s` and lowercases the rest.
---
--- @param {s} - the input string
--- @returns {String - `s` capitalized, or `""` on empty input}
--- @example
--- `str.capitalize("hELLO")`
--- -- => "Hello"
---
export capitalize := (s) ~> do {
  cs := char.chars(s)
  match cs {
    []: "",
    [h, ...t]: char.to_upper(h) + char.from_chars(map(t, c ~> char.to_lower(c)))
  }
}
