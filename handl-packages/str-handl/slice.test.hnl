from "./slice" import * as m

test_slice_basic := assert m.slice("hello", 1, 3) = "el"

test_slice_clamped := assert m.slice("hello", 3, 99) = "lo"

test_slice_whole := assert m.slice("abc", 0, 3) = "abc"

test_slice_reversed := assert m.slice("abc", 2, 1) = ""

test_slice_empty_range := assert m.slice("abc", 3, 3) = ""

test_slice_mid := assert m.slice("abcdef", 2, 4) = "cd"

test_slice_zero := assert m.slice("abc", 0, 0) = ""
