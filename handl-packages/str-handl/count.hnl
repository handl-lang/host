--- `str.count` — part of `str-handl`, the pure-Handl `str` implementation over `char`.

from "char" import * as char
from "./internal/len.hnl" import len
from "./internal/drop.hnl" import drop
from "./internal/prefix_match.hnl" import prefix_match

--- The number of non-overlapping occurrences of `pat` in `s`.
---
--- @details
--- An empty `pat` returns `len(s) + 1` (Rust `str::matches("")`
--- semantics: the empty pattern matches at every boundary).
---
--- @param {s} - the haystack
--- @param {pat} - the needle
--- @returns {Nat - occurrence count}
--- @example
--- `str.count("aXbXc", "X")`
--- -- => 2
---
export count := (s, pat) ~> do {
  ps := char.chars(pat)
  cs := char.chars(s)
  m := len(ps)
  if m == 0 { len(cs) + 1 } else {
    c := 0
    ys := cs
    for _ in cs { do {
      if len(ys) > 0 {
        if prefix_match(ys, ps) {
          ys := drop(ys, m)
          c := c + 1
        } else {
          ys := drop(ys, 1)
        }
      }
    } }
    c
  }
}
