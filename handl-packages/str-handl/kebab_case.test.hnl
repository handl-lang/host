from "./kebab_case" import * as m

test_kebab_case_basic := assert m.kebab_case("helloWorld now") = "hello-world-now"

test_kebab_case_empty := assert m.kebab_case("") = ""

test_kebab_case_single := assert m.kebab_case("hello") = "hello"

test_kebab_case_seps := assert m.kebab_case("a_b-c d") = "a-b-c-d"

test_kebab_case_caps := assert m.kebab_case("ABC") = "abc"
