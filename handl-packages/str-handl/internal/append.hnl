--- Internal helper for `str-handl` — not part of the `str` contract surface.

from "./rev.hnl" import rev

--- `a` followed by `b` as one list.
---
--- @example
--- `append([1, 2], [3])`
--- -- => [1, 2, 3]
---
export append := (a, b) ~> do {
  acc := b
  for x in rev(a) { do {
    acc := [x, ...acc]
  } }
  acc
}
