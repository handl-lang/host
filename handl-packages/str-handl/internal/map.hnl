--- Internal helper for `str-handl` — not part of the `str` contract surface.

-- `char` is imported so this module's runtime can resolve `char.*` host
-- calls made by caller-supplied `f` arrows (host calls resolve in the
-- invoking runtime's module chain, not the closure's).
from "char" import * as char
from "./rev.hnl" import rev

--- `[f(x) for x in xs]`, preserving order.
---
--- @example
--- `map([1, 2, 3], x ~> x * 2)`
--- -- => [2, 4, 6]
---
export map := (xs, f) ~> do {
  acc := []
  for x in xs { do {
    acc := [f(x), ...acc]
  } }
  rev(acc)
}
