--- `str.title_case` — part of `str-handl`, the pure-Handl `str` implementation over `char`.

from "char" import * as char
from "./internal/rev.hnl" import rev

--- Titlecases `s`: uppercase after whitespace, lowercase elsewhere.
---
--- @param {s} - the input string
--- @returns {String - `s` in title case}
--- @example
--- `str.title_case("hello world")`
--- -- => "Hello World"
---
export title_case := (s) ~> do {
  acc := []
  new_word := true
  for h in char.chars(s) { do {
    if char.is_whitespace(h) {
      new_word := true
      acc := [h, ...acc]
    } else {
      if new_word {
        acc := [char.to_upper(h), ...acc]
      } else {
        acc := [char.to_lower(h), ...acc]
      }
      new_word := false
    }
  } }
  char.from_chars(rev(acc))
}
