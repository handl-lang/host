--- `str.join` — part of `str-handl`, the pure-Handl `str` implementation over `char`.

from "char" import * as char

--- Joins the strings of `xs` with `sep` between each pair.
---
--- @param {xs} - the strings to join
--- @param {sep} - the separator
--- @returns {String - the joined string}
--- @example
--- `str.join(["a", "b", "c"], "-")`
--- -- => "a-b-c"
---
export join := (xs, sep) ~> do {
  match xs {
    []: "",
    [h, ...t]: do {
      acc := h
      for x in t { do {
        acc := char.concat(acc, char.concat(sep, x))
      } }
      acc
    }
  }
}
