from "./capitalize" import * as m

test_capitalize_lower := assert m.capitalize("hello") = "Hello"

test_capitalize_shout := assert m.capitalize("hELLO") = "Hello"

test_capitalize_empty := assert m.capitalize("") = ""

test_capitalize_already := assert m.capitalize("Hello") = "Hello"

test_capitalize_single := assert m.capitalize("a") = "A"

test_capitalize_digit_first := assert m.capitalize("1abc") = "1abc"
