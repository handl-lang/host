--- `str.trim_matches` — part of `str-handl`, the pure-Handl `str` implementation over `char`.

from "char" import * as char
from "./internal/rev.hnl" import rev
from "./internal/drop_while.hnl" import drop_while
from "./internal/member.hnl" import member

--- Removes leading and trailing characters that appear in `set`.
---
--- @details
--- An empty `set` returns `s` unchanged.
---
--- @param {s} - the input string
--- @param {set} - the characters to strip
--- @returns {String - `s` with `set` chars stripped from both ends}
--- @example
--- `str.trim_matches("xxhixx", "x")`
--- -- => "hi"
---
export trim_matches := (s, set) ~> do {
  if char.length(set) == 0 { s } else {
    setc := char.chars(set)
    in_set := (c) ~> member(c, setc)
    a := drop_while(char.chars(s), in_set)
    b := drop_while(rev(a), in_set)
    char.from_chars(rev(b))
  }
}
