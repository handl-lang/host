--- `str.char_at` — part of `str-handl`, the pure-Handl `str` implementation over `char`.

from "char" import * as char

--- The character of `s` at index `i`.
---
--- @details
--- Delegates to `char.at` (char-indexed).
---
--- @param {s} - the input string
--- @param {i} - the char index
--- @returns {String - the single char at `i`}
--- @example
--- `str.char_at("hello", 1)`
--- -- => "e"
---
export char_at := (s, i) ~> do {
  char.at(s, i)
}
