from "./starts_with" import * as m

test_starts_with_hit := assert m.starts_with("hello", "he") = true

test_starts_with_miss := assert m.starts_with("hello", "lo") = false

test_starts_with_empty_pat := assert m.starts_with("abc", "") = true

test_starts_with_empty_s := assert m.starts_with("", "a") = false

test_starts_with_both_empty := assert m.starts_with("", "") = true

test_starts_with_longer := assert m.starts_with("abc", "abcd") = false
