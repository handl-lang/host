--- `str.split` — part of `str-handl`, the pure-Handl `str` implementation over `char`.

from "char" import * as char
from "./internal/rev.hnl" import rev
from "./internal/len.hnl" import len
from "./internal/head.hnl" import head
from "./internal/drop.hnl" import drop
from "./internal/append.hnl" import append
from "./internal/prefix_match.hnl" import prefix_match

--- Splits `s` on every non-overlapping occurrence of `sep`.
---
--- @details
--- An empty `sep` splits at every char boundary with empty edges:
--- `"abc".split("")` -> `["", "a", "b", "c", ""]` (Rust semantics).
---
--- @param {s} - the input string
--- @param {sep} - the separator
--- @returns {List String - the pieces}
--- @example
--- `str.split("a,b,c", ",")`
--- -- => ["a", "b", "c"]
---
export split := (s, sep) ~> do {
  cs := char.chars(s)
  ss := char.chars(sep)
  m := len(ss)
  if m == 0 {
    append(["", ...cs], [""])
  } else {
    cur := []
    rev_out := []
    ys := cs
    for _ in cs { do {
      if len(ys) > 0 {
        if prefix_match(ys, ss) {
          rev_out := [char.from_chars(rev(cur)), ...rev_out]
          cur := []
          ys := drop(ys, m)
        } else {
          cur := [head(ys), ...cur]
          ys := drop(ys, 1)
        }
      }
    } }
    rev([char.from_chars(rev(cur)), ...rev_out])
  }
}
