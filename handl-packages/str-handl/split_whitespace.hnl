--- `str.split_whitespace` — part of `str-handl`, the pure-Handl `str` implementation over `char`.

from "char" import * as char
from "./internal/rev.hnl" import rev
from "./internal/len.hnl" import len
from "./internal/drop_while.hnl" import drop_while

--- Splits `s` on whitespace runs.
---
--- @details
--- Rust `str::split_whitespace` semantics: leading/trailing whitespace
--- produces no empty pieces and runs collapse to one boundary.
---
--- @param {s} - the input string
--- @returns {List String - the whitespace-separated words}
--- @example
--- `str.split_whitespace("  a  b \n c ")`
--- -- => ["a", "b", "c"]
---
export split_whitespace := (s) ~> do {
  cs := drop_while(char.chars(s), c ~> char.is_whitespace(c))
  cur := []
  pieces := []
  for h in cs { do {
    if char.is_whitespace(h) {
      if len(cur) > 0 {
        pieces := [char.from_chars(rev(cur)), ...pieces]
        cur := []
      }
    } else {
      cur := [h, ...cur]
    }
  } }
  if len(cur) > 0 {
    pieces := [char.from_chars(rev(cur)), ...pieces]
  }
  rev(pieces)
}
