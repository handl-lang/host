from "./similarity" import * as m

test_similarity_same := assert m.similarity("kitten", "kitten") = 1.0

test_similarity_empty_b := assert m.similarity("abc", "") = 0.0

test_similarity_both_empty := assert m.similarity("", "") = 1.0

test_similarity_classic := assert m.similarity("kitten", "sitting") = 0.5714285714285714

test_similarity_same2 := assert m.similarity("abc", "abc") = 1.0
