--- ffi -- grades, types and arrows for foreign function calls.
--- @details
--- `call`, `bind`, and `errno` are injected by the Rust runtime.
--- This package exposes the typed FFI surface that SDK-generated adapters
--- import.

from "../grade" import { Grade }
from "../type" import { Obj, Int }

--- Grade for foreign-function calls.
--- @details
--- Every arrow that calls or binds a C symbol carries the `FFI` grade,
--- making the foreign effect visible to the type system.
export FFI := Grade

--- C `errno` value as a Handl Int.
--- @details
--- This is the integer `errno` read from the current thread immediately
--- after a failing C call.
export Errno := Int

--- Opaque foreign handle (file descriptor, socket, pointer, etc.).
export Handle := Obj

--- Call a C symbol immediately.
--- @details
--- `call` marshals the provided Handl values to C according to the
--- descriptor strings, invokes the symbol, and unmarshals the return.
--- @param {lib} - shared library name or path
--- @param {sym} - C symbol name
--- @param {all_args} - Handl values to pass to the C function
--- @param {descriptors} - marshalling descriptor for each argument and the return
--- @param {ret_kind} - return kind descriptor
--- @param {errno?} - if `true`, negative integer returns are treated as errors
--- @returns {Value - the C call's return, unmarshalled from `ret_kind`}
export call: (String, String, Array, Array, String, Bool) ~[FFI]~> Value

--- Bind a C symbol to a first-class Handl arrow.
--- @details
--- `bind` captures a prefix of arguments and returns a Handl arrow that
--- calls the C symbol with the bound prefix followed by the caller's
--- remaining arguments.
--- @param {lib} - shared library name or path
--- @param {sym} - C symbol name
--- @param {bound_args} - Handl values to prepend on every call
--- @param {descriptors} - marshalling descriptor for each argument and the return
--- @param {ret_kind} - return kind descriptor
--- @param {errno?} - if `true`, negative integer returns are treated as errors
--- @returns {Value - a Handl arrow that dispatches to the C symbol}
export bind: (String, String, Array, Array, String, Bool) ~[FFI]~> Value

--- Read the current thread's C `errno` value.
--- @details
--- This must be called synchronously, immediately after the failing C
--- call whose error is being checked, before any other operation can
--- overwrite `errno`.
--- @returns {Errno - the current C `errno`}
export errno: () ~[FFI]~> Errno
