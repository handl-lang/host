--- ffi -- grades, types and arrows for foreign function calls.
--- @details
--- `call`, `bind`, and `errno` are injected by the Rust runtime.
--- This package exposes the typed FFI surface that SDK-generated adapters
--- import.

from "../grade" import { Grade }
from "../type" import { Obj, Int }

--- Grade for foreign-function calls.
--- @details
--- Every arrow that calls or binds a C symbol carries the `FFI` grade,
--- making the foreign effect visible to the type system.
export FFI := Grade

--- C `errno` value as a Handl Int.
--- @details
--- This is the integer `errno` read from the current thread immediately
--- after a failing C call.
export Errno := Int

--- Opaque foreign handle (file descriptor, socket, pointer, etc.).
export Handle := Obj

-- TODO(n-dim): was ~[(Op, FFI)]~>
call = (String, String, Array, Array, String, Bool) ~[1]~> Value
-- TODO(n-dim): was ~[(Op, FFI)]~>
bind = (String, String, Array, Array, String, Bool) ~[1]~> Value
-- TODO(n-dim): was ~[(Op, FFI)]~>
errno = () ~[1]~> Errno

export call
export bind
export errno
