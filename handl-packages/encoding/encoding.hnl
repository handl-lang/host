--- encoding -- encoding abstractions for the handl runtime.
---
--- This is a trait-abstraction library: the Encoder, Decoder, Encoding,
--- and EncodingRegistry traits live in Rust (plugin-lib-encoding) and
--- are implemented by concrete encoding crates (base64, hex). The .hnl
--- file declares the library's capability surface for the plugin system;
--- unlike serialize.hnl, the ops below are callable — encoding.encode /
--- encoding.decode dispatch to a named codec in the EncodingRegistry,
--- with handls provided by the concrete impl crates.
cap "encoding.encode"
cap "encoding.decode"
op "encoding.encode" : Value -> Value
  guarantee: True
op "encoding.decode" : Value -> Value
  guarantee: True
