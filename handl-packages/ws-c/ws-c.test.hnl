--- ws-c tests: the libcurl WebSocket client driven as a task on the
--- concurrent-epoll scheduler, against a canned RFC 6455 echo server
--- (test_server.py -- stdlib only).

from "./ws-c" import { prepare, active_socket, close, curle_again }
from "../concurrent-epoll/concurrent-epoll" import { run }
from "../generated/libc-c-linux-x86_64/stdlib" import { system }
from "bytes" import * as bytes

CURLWS_TEXT := 1

is_err := (r) ~> tag.tag_of(r) == "err"

val_of := (r) ~> tag.untag(r).value

--- poll for the server's readiness sentinel. The budget is generous
--- (30s) because the gate runs several test files at once.
wait_ready := (_u) ~> do {
  while { n: 0 } {
    (st) ~> do {
      r := system("test -f /tmp/ws-c-test-ready")
      if st.n > 300 {
        { out: false }
      } else if is_err(r) {
        { state: { n: st.n + 1 } }
      } else if val_of(r) == 0 {
        { out: true }
      } else {
        _ := system("sleep 0.1")
        { state: { n: st.n + 1 } }
      }
    }
  }
}

start_server := (_u) ~> do {
  _ := system("rm -f /tmp/ws-c-test-ready")
  _ := system("python3 handl-packages/ws-c/test_server.py >/dev/null 2>&1 &")
  wait_ready(null)
}

--- open -> upgrade (`ws_open`) -> send text -> recv echo -> close.
--- Every socket step is a scheduler op; the client parks on the
--- connection fd whenever curl reports CURLE_AGAIN.
main := (s) ~> match s.phase {
  "open": do {
    h := prepare(s.url, {})
    { call: { name: "ws_open", h: h },
      state: hash_map.merge(s, { phase: "conn", h: h }) }
  },
  "conn": do {
    fd := active_socket(s.h)
    { call: { name: "ws_send", h: s.h, fd: fd,
              buf: bytes.utf8_encode(s.msg), flags: CURLWS_TEXT },
      state: hash_map.merge(s, { phase: "sent", fd: fd }) }
  },
  "sent": {
    call: { name: "ws_recv", h: s.h, fd: s.fd },
    state: hash_map.merge(s, { phase: "got" })
  },
  "got": do {
    frame := s.result
    { call: { name: "ws_close", h: s.h, fd: s.fd },
      state: hash_map.merge(s, { phase: "closed", frame: frame }) }
  },
  "closed": { out: s.frame },
  _: { out: null }
}

--- one echo round-trip against the fixture.
echo_once := (msg) ~> do {
  r := run(main, { phase: "open", url: "ws://127.0.0.1:18360/",
                   msg: msg })
  r.main
}

test_ws_echo_text := assert do {
  _ := start_server(null)
  f := echo_once("hello")
  f.op + "|" + bytes.utf8_decode(f.payload)
} := "text|hello"

test_ws_echo_binary := assert do {
  f := echo_once("bytes!")
  type.to_string(bytes.len(f.payload)) + "|" + f.op
} := "6|text"

test_ws_frame_flags := assert do {
  f := echo_once("x")
  type.to_string(f.flags != 0)
} := "true"
