--- ws-c -- WebSocket client for the concurrent-epoll scheduler.
---
--- libcurl does the transport: DNS, TCP, TLS with SNI and chain/hostname
--- verification, proxies, and the RFC 6455 upgrade. `prepare` builds an
--- easy handle in `CURLOPT_CONNECT_ONLY = 2` mode; the scheduler drives
--- the upgrade with its existing `curl_perform` op (the same CURLM +
--- epoll machinery `fetch-c` uses), and the handle then speaks frames
--- through `recv_step`/`send_step`.
---
--- Steps never block: a step performs one attempt and reports `{ again }`
--- for `CURLE_AGAIN`, which the scheduler turns into an epoll park on the
--- connection's socket (`active_socket`). Frame metadata comes from the
--- `curl_ws_frame` struct curl hands back, read with `ffi.read`.
---
---   prepare(url, init)      -> easy handle (Int), CONNECT_ONLY=2
---   active_socket(h)        -> the fd curl is using
---   recv_step(h)            -> { frame: { op, payload, flags } } | { again } | { err }
---   send_step(h, buf, flags)-> { sent: Int } | { again } | { err }
---   close(h)                -> close frame (best effort) + cleanup
---
--- `op` is the opcode class from the frame flags: "text", "binary",
--- "cont" (a continuation piece), "ping", "pong" or "close". `flags`
--- keeps curl's raw `CURLWS_*` bits for callers that need them.

from "../generated/curl-c-linux-x86_64/curl" import * as curlm

CONNECT_ONLY_WS := 2

CURLE_OK := 0

--- CURLE_AGAIN -- no complete frame yet (or the send buffer is full).
--- Not an error: the caller waits for the socket.
export curle_again := 81

--- struct curl_ws_frame on x86_64 (curl's own frame metadata).
WS_FRAME_DESC := "rec:{age:i32@0:4,flags:i32@4:4,offset:i64@8:8,bytesleft:i64@16:8,len:u64@24:8}"

val_of := (r) ~> tag.untag(r).value

--- first element of a list, or 0 (the adapters hand back out-slot lists)
head := (xs) ~> match xs {
  []: 0,
  [h, ...t]: h
}

--- decode a little-endian u64 at byte offset `o`
u32le := (buf, o) ~> do {
  bytes.at(buf, o) + bytes.at(buf, o + 1) * 256 +
  bytes.at(buf, o + 2) * 65536 + bytes.at(buf, o + 3) * 16777216
}

u64le := (buf, o) ~> do { u32le(buf, o) + u32le(buf, o + 4) * 4294967296 }

--- curl_easy_setopt is variadic: per-type fixed signatures via ffi.call
--- (same convention as fetch-c).
setopt_str := (h, opt, v) ~> do {
  ffi.call("libcurl.so.4", "curl_easy_setopt",
    [h, opt, v], ["ptr", "i32", "cstr"], "i32", false)
}

setopt_long := (h, opt, v) ~> do {
  ffi.call("libcurl.so.4", "curl_easy_setopt",
    [h, opt, v], ["ptr", "i32", "i64"], "i32", false)
}

--- whether a single power-of-two flag is set (`flags mod 2*bit` lands in
--- `[0, 2*bit)`, so the bit is set exactly when the remainder reaches it).
has_bit := (flags, bit) ~> do { flags % (bit * 2) >= bit }

--- opcode class from `curl_ws_frame.flags`.
frame_op := (flags) ~> do {
  if has_bit(flags, curlm.CURLWS_CLOSE) {
    "close"
  } else if has_bit(flags, curlm.CURLWS_PING) {
    "ping"
  } else if has_bit(flags, curlm.CURLWS_PONG) {
    "pong"
  } else if has_bit(flags, curlm.CURLWS_TEXT) {
    "text"
  } else if has_bit(flags, curlm.CURLWS_BINARY) {
    "binary"
  } else if has_bit(flags, curlm.CURLWS_CONT) {
    "cont"
  } else {
    "unknown"
  }
}

--- the `curl_ws_frame` pointer curl wrote: the second out-slot, holding
--- the 8 raw pointer bytes (`outs` is [buffer, meta] in descriptor
--- order), or 0 when curl reported no metadata.
meta_ptr := (outs) ~> match outs {
  [_, p, ...t]: u64le(p, 0),
  _: 0
}

--- frame metadata flags from that pointer (0 when curl reported none).
meta_flags := (p) ~> if p == 0 {
  0
} else {
  ffi.read(p, WS_FRAME_DESC).flags
}

--- prepare(url, init) -> easy handle in WebSocket mode.
--- init: { insecure?: Bool } -- skip TLS peer/host verification.
export prepare := (url, init) ~> do {
  h := val_of(curlm.curl_easy_init())
  _ := setopt_str(h, curlm.CURLOPT_URL, url)
  _ := setopt_long(h, curlm.CURLOPT_CONNECT_ONLY, CONNECT_ONLY_WS)
  _ := setopt_long(h, curlm.CURLOPT_NOSIGNAL, 1)
  _ := if hash_map.get_or(init, "insecure", false) {
    do {
      _ := setopt_long(h, curlm.CURLOPT_SSL_VERIFYPEER, 0)
      setopt_long(h, curlm.CURLOPT_SSL_VERIFYHOST, 0)
    }
  } else {
    null
  }
  h
}

--- the fd curl uses for this connection (CURLINFO_ACTIVESOCKET) -- what
--- the scheduler parks on.
export active_socket := (h) ~> do {
  r := ffi.call("libcurl.so.4", "curl_easy_getinfo",
    [h, curlm.CURLINFO_ACTIVESOCKET, 0], ["ptr", "i32", "io_scalar:i32"],
    "i32", false)
  head(r.vals)
}

--- one non-blocking frame read. `again` = no complete frame buffered.
export recv_step := (h) ~> do {
  r := val_of(curlm.curl_ws_recv(h, 0))
  if r.ret == curle_again {
    { again: true }
  } else if r.ret != CURLE_OK {
    { err: r.ret }
  } else {
    do {
      n := head(r.vals)
      flags := meta_flags(meta_ptr(r.outs))
      { frame: { op: frame_op(flags),
                 payload: bytes.slice(r.buf, 0, n), flags: flags } }
    }
  }
}

--- one non-blocking frame write. `flags` is `CURLWS_TEXT`/`CURLWS_BINARY`/
--- `CURLWS_CLOSE`/...; `again` = the socket is not writable yet.
export send_step := (h, buf, flags) ~> do {
  r := val_of(curlm.curl_ws_send(h, buf, 0, 0, flags))
  if r.ret == curle_again {
    { again: true }
  } else if r.ret != CURLE_OK {
    { err: r.ret }
  } else {
    { sent: head(r.vals) }
  }
}

--- send a text frame.
export send_text := (h, s) ~> do {
  send_step(h, bytes.utf8_encode(s), curlm.CURLWS_TEXT)
}

--- send a binary frame.
export send_binary := (h, b) ~> do { send_step(h, b, curlm.CURLWS_BINARY) }

--- close frame (best effort) then release the handle.
export close := (h) ~> do {
  _ := curlm.curl_ws_send(h, bytes.from_list([]), 0, 0, curlm.CURLWS_CLOSE)
  curlm.curl_easy_cleanup(h)
}
