--- Property-based testing (ADR-0092).
---
--- `property.for_all` runs the predicate function `count` times with
--- deterministic seeded floats.  The predicate must return `true` to
--- pass and an `err`-tagged result to fail.

from "serialize" import { serialize }

cap "property.for_all"

op "property.for_all" : (Function, Number, Number) -> Value

handl "property.for_all" = for_all

do {
  generate_inputs :: [f, s, i] ~> {
    while { j: 0, acc: [] } {
      [j, acc] ~> if j == array.len(f.params) {
        { out: acc }
      } else {
        { state: {
          j: j + 1,
          acc: [...acc, rand.seeded_float(s + i * 1000 + j, 0, 1)]
        }}
      }
    }
  }

  {
    for_all: [f, count, seed] ~> {
      s :: if seed == null { 0 } else { seed }
      if count <= 0 {
        tag.tag("err", { value: { message: "count must be positive" } })
      } else {
        while { i: 0 } {
          [i] ~> {
            inputs :: generate_inputs(f, s, i)
            r :: combinators.apply(f, inputs)
            t :: tag.tag_of(r)
            if i == count {
              { out: tag.tag("ok", { value: true }) }
            } else if t == "err" {
              { out: tag.tag("err", { value: {
                message: "property failed",
                counterexample: inputs,
                cause: serialize(tag.untag(r).value, "json")
              }})}
            } else if r != true {
              { out: tag.tag("err", { value: {
                message: "property returned false",
                counterexample: inputs
              }})}
            } else {
              { state: { i: i + 1 } }
            }
          }
        }
      }
    }
  }
}