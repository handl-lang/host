--- compress-gzip-c -- gzip-format (RFC 1952) backend for the `compress`
--- contract.
---
--- zlib's `deflate`/`inflate` streaming API needs a persistent `z_stream`
--- that the ffi descriptor vocabulary cannot round-trip across calls, so
--- this backend drives the `gz*` file API over an anonymous `memfd`
--- instead: bytes are piped through `gzdopen`/`gzwrite`/`gzread`, and
--- zlib itself produces and verifies the real gzip framing (header,
--- DEFLATE stream, CRC32 + ISIZE trailer) — no hand-rolled framing.
---
--- The memfd is created via `libc.syscall(SYS_memfd_create, ...)` since
--- `memfd_create(2)` lives in `bits/mman-shared.h`, outside the headers
--- sdkgen can collect from directly.

from "../compress" import { Compress, Decompress }
from "bytes" import * as bytes
from "../generated/libz-c-linux-x86_64/zlib" import * as zlib
from "../generated/libc-c-linux-x86_64/unistd" import * as unistd

--- x86_64 syscall number for memfd_create.
SYS_MEMFD_CREATE := 319

--- zlib flush constant Z_FINISH.
Z_FINISH := 4

--- libc SEEK_SET.
SEEK_SET := 0

--- Unwrap a generated `Result` — every ffi binding returns
--- `Result<payload, Errno>`; on `err` we raise with the op name.
unwrap := (r, what) ~> do {
  if tag.tag_of(r) == "err" {
    error.raise("compress-gzip-c: " + what + " failed")
  } else {
    tag.untag(r).value
  }
}

--- Concatenate a list of Bytes chunks.
cat := (chunks) ~> while { xs: chunks, acc: bytes.from_list([]) } {
  (xs, acc) ~> match xs {
    []: { out: acc },
    [h, ...t]: { state: { xs: t, acc: bytes.concat(acc, h) } }
  }
}

--- Read an fd to EOF in 64 KiB chunks (`unistd.read` returns one chunk
--- per call, trimmed by the byte count it read).
drain_fd := (fd) ~> do {
  while { fd: fd, chunks: [] } {
    (fd, chunks) ~> do {
      chunk = unwrap(unistd.read(fd), "read")
      if bytes.len(chunk) == 0 {
        { out: cat(chunks) }
      } else {
        { state: { fd: fd, chunks: [...chunks, chunk] } }
      }
    }
  }
}

--- Read a gzFile to end-of-stream in 64 KiB chunks (`zlib.gzread`
--- returns one chunk per call; an empty Bytes means end-of-stream).
drain_gz := (gz) ~> do {
  while { gz: gz, chunks: [] } {
    (gz, chunks) ~> do {
      chunk = unwrap(zlib.gzread(gz), "gzread")
      if bytes.len(chunk) == 0 {
        { out: cat(chunks) }
      } else {
        { state: { gz: gz, chunks: [...chunks, chunk] } }
      }
    }
  }
}

--- A fresh anonymous in-memory fd. `memfd_create` is reached through the
--- generic `syscall` binding; flags = 0 (no CLOEXEC/SEALING needed — the
--- fd lives only for the call).
memfd := () ~> unwrap(unistd.syscall(SYS_MEMFD_CREATE, "handl-gzip", 0), "memfd_create")

export compress: Compress := (input) ~> do {
  fd = memfd()
  gz = unwrap(zlib.gzdopen(fd, "wb"), "gzdopen")
  _ = unwrap(zlib.gzwrite(gz, input), "gzwrite")
  _ = unwrap(zlib.gzflush(gz, Z_FINISH), "gzflush")
  _ = unwrap(unistd.lseek(fd, 0, SEEK_SET), "lseek")
  out = drain_fd(fd)
  _ = zlib.gzclose(gz)
  out
}

export decompress: Decompress := (input) ~> do {
  fd = memfd()
  _ = unwrap(unistd.write(fd, input), "write")
  _ = unwrap(unistd.lseek(fd, 0, SEEK_SET), "lseek")
  gz = unwrap(zlib.gzdopen(fd, "rb"), "gzdopen")
  out = drain_gz(gz)
  _ = zlib.gzclose(gz)
  out
}
