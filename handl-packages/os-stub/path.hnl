--- Deterministic, pure path manipulation stubs.
---
--- @details
--- These use the same pure string logic as `os-c/path` so tests can
--- validate the contract without touching the filesystem.

from "str" import * as str

--- Join path components with a forward slash.
export join: (List(String)) ~> String := (parts) ~> str.join(parts, "/")

--- Resolve a sequence of path components to a single path.
--- @details
--- Stub implementation: simply joins the components.
export resolve: (List(String)) ~> String := (parts) ~> str.join(parts, "/")

--- Return the last component of a path.
export basename: String ~> String := (p) ~> do {
  i = str.rfind(p, "/");
  if i > -1 {
    str.slice(p, i + 1, str.length(p))
  } else {
    p
  }
}

--- Return the directory component of a path.
export dirname: String ~> String := (p) ~> do {
  i = str.rfind(p, "/");
  if i > -1 {
    str.slice(p, 0, i)
  } else {
    "."
  }
}

--- Return the file extension, including the leading dot, or the empty string.
export extname: String ~> String := (p) ~> do {
  base = basename(p);
  i = str.rfind(base, ".");
  if i > -1 {
    str.slice(base, i, str.length(base))
  } else {
    ""
  }
}
