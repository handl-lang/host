--- base64.encode -- encode a string to base64.
--- base64.decode -- decode a base64 string.
cap "base64.encode"
cap "base64.decode"
op "base64.encode" : String -> String
  guarantee: IsBase64(output)
op "base64.decode" : String -> String
  guarantee: True

handle "base64.encode" with rust_base64_encode
handle "base64.decode" with rust_base64_decode
