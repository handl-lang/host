--- gzip.compress -- compress a string to a base64-encoded gzip string.
--- gzip.decompress -- decompress a base64-encoded gzip string back to the original.
cap "gzip.compress"
cap "gzip.decompress"
op "gzip.compress" : String -> String
  guarantee: IsBase64(output)
op "gzip.decompress" : String -> String
  guarantee: True

handle "gzip.compress" with rust_gzip_compress
handle "gzip.decompress" with rust_gzip_decompress
