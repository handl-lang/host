--- js -- grades, types and arrows for JavaScript interop.
--- @details
--- `call` and `error` are injected by the JS runtime.
--- This package exposes the typed JS surface that SDK-generated adapters
--- import.

from "../grade" import { Grade }
from "../type" import { Obj }

--- Grade for JavaScript calls.
--- @details
--- Every arrow that calls a JS function or method carries the `JS` grade,
--- making the foreign effect visible to the type system.
export JS := Grade

--- JavaScript error value.
--- @details
--- This is the exception object thrown by the most recent failing JS call.
export JsError := Obj

--- Call a JS function or method immediately.
--- @details
--- `call` marshals the provided Handl values to JS according to the
--- descriptor strings, invokes the function, and unmarshals the return.
--- @param {obj} - JS global object or namespace name
--- @param {method} - method name on the object
--- @param {all_args} - Handl values to pass to the JS function
--- @param {descriptors} - marshalling descriptor for each argument and the return
--- @param {ret_kind} - return kind descriptor
--- @param {throws?} - if `true`, thrown exceptions are treated as errors
--- @returns {Value - the JS call's return, unmarshalled from `ret_kind`}
-- TODO(n-dim): effect row
export call: (String, String, Array, Array, String, Bool) ~[1]~> Value

--- Call a method on a receiver object.
--- @details
--- `invoke` is the receiver-aware counterpart of `call`: where `call`
--- names a global object or namespace, `invoke` dispatches `method` on
--- an object value obtained from an earlier call (a `Response`, a
--- `ReadableStream` reader, ...). Thrown exceptions are recorded for
--- `error`, exactly as `call` does. The sdkgen WebIDL adapters are
--- receiver-less today (`call("fetch", "text", [], ...)` dispatches with
--- no `this`), so hand-written adapters that need a method on a value
--- use `invoke` until the emitter passes the receiver through.
--- @param {receiver} - the JS object the method is dispatched on
--- @param {method} - method name on the receiver
--- @param {all_args} - Handl values to pass to the JS method
--- @param {descriptors} - marshalling descriptor for each argument and the return
--- @param {ret_kind} - return kind descriptor
--- @param {throws?} - if `true`, thrown exceptions are treated as errors
--- @returns {Value - the JS method's return, unmarshalled from `ret_kind`}
-- TODO(n-dim): effect row
export invoke: (Value, String, Array, Array, String, Bool) ~[1]~> Value

--- Read the most recent JS exception.
--- @details
--- This must be called synchronously, immediately after the failing JS
--- call whose error is being checked, before any other operation can
--- overwrite the stored exception.
--- @returns {JsError - the current JS exception}
-- TODO(n-dim): effect row
export error: () ~[1]~> JsError

--- Await a JS Promise.
--- @details
--- `await` resolves a promise produced by a `call` (fetch, Response
--- methods, timers, ...) and returns the settled value. The JS host owns
--- the event loop, so only it can settle a promise — this op is the
--- general interop bridge every Promise-returning API goes through, not
--- a fetch-specific hook.
--- @param {promise} - the Promise value returned by a previous `call`
--- @returns {Value - the resolved value, unmarshalled}
-- TODO(n-dim): effect row
export await: (Value) ~[1]~> Value
