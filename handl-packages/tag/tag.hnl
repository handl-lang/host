--- tag.tag -- mint a tagged value (host capability, ADR-0055).
--- tag.untag -- return the payload of a tagged value (inspection).
--- tag.tag_of -- return the tag name of a tagged value (inspection).
--- tag.is_tag -- test whether a value is a tagged value (inspection).
--- tag.construct -- mint a registry-scoped type value (ADR-0054).
--- tag.match_type -- dispatch on the type tag of a value (ADR-0054).
cap "tag.tag"
cap "tag.untag"
cap "tag.tag_of"
cap "tag.is_tag"
cap "tag.construct"
cap "tag.match_type"
op "tag.tag" : (String, Value) -> Value
  guarantee: True
op "tag.untag" : Value -> Value
  guarantee: True
op "tag.tag_of" : Value -> Value
  guarantee: True
op "tag.is_tag" : Value -> Bool
  guarantee: True
op "tag.construct" : (String, Value) -> Value
  guarantee: True
op "tag.match_type" : (Value, Value) -> Value
  guarantee: True

handle "tag.tag" with rust_tag_tag
handle "tag.untag" with rust_tag_untag
handle "tag.tag_of" with rust_tag_tag_of
handle "tag.is_tag" with rust_tag_is_tag
handle "tag.construct" with rust_tag_construct
handle "tag.match_type" with rust_tag_match_type
