--- ws_frame -- WebSocket frame codec contract (RFC 6455 §5.2).
---
--- Wire-format signatures plus the laws every implementation must
--- satisfy. Implementations (the pure-handl `ws_frame-handl`, a future
--- native backend, ...) export `encode`/`decode` arrows of these types;
--- an implementation conforms to the contract by instantiating the laws.
---
--- Both arrows are pure `~>`: masking is caller-driven. `encode` takes
--- an explicit `mask_key` -- the empty buffer for an unmasked frame,
--- exactly 4 key bytes for a masked one -- instead of drawing entropy
--- itself; callers that need masking pull key material from an entropy
--- capability (generated `libc/random.hnl` `Getrandom`) outside this
--- contract.
---
--- `decode` is incremental: `option.none` signals *need more bytes*
--- (the input is a strict prefix of a frame) and is never a protocol
--- error -- `option.some` carries the decoded `frame` plus `rest`, the
--- bytes following it, so a buffer of coalesced frames is drained by
--- feeding `rest` back to `decode`. Protocol validation (reserved bits,
--- the opcode registry, control-frame rules) is out of scope: `Frame`
--- is the decoded wire record and nothing more.

from "type" import { Nat }
from "option" import { Option }
from "bytes" import { Bytes }

--- A decoded frame. `fin` is 1 (final fragment) or 0 (continuation);
--- `op` is the 4-bit opcode -- use the `Op*` constants; `payload` is
--- always unmasked (the wire mask bit and key do not surface here).
export Frame := { fin: Nat, op: Nat, payload: Bytes }

--- The `encode` input record: a `Frame` plus `mask_key` -- empty to
--- emit an unmasked frame, 4 bytes to emit a masked one (the caller
--- owns key entropy and length). Named separately because an arrow
--- parameter must be a (possibly annotated) var, so the record shape
--- cannot appear inline in `Encode`.
export EncodeIn := { fin: Nat, op: Nat, payload: Bytes, mask_key: Bytes }

--- encode -- serialize a frame.
export Encode := (input: EncodeIn) ~> Bytes

--- The `decode` success record: the decoded `frame` plus `rest`, the
--- unconsumed bytes trailing it. Named separately so the `Option`
--- application in `Decode` takes a var (a record literal does not
--- round-trip through the formatter in generic-argument position).
export DecodeOut := { frame: Frame, rest: Bytes }

--- decode -- read one frame off the front of a buffer. `None` means the
--- buffer holds only a strict prefix (need more bytes); `Some` returns
--- the frame and the unconsumed `rest`.
export Decode := (Bytes) ~> Option<DecodeOut>

--- RFC 6455 §5.2 opcode constants.
export OpContinuation := 0
export OpText := 1
export OpBinary := 2
export OpClose := 8
export OpPing := 9
export OpPong := 10

--- frame_in -- the `Frame` an `Encode` input describes (`mask_key` is
--- encode-only; it does not survive a decode round-trip).
export frame_in := (r) ~> { fin: r.fin, op: r.op, payload: r.payload }

--- frame_of -- project the frame out of a `Some` decode result.
export frame_of := (o) ~> o.value.frame

--- rest_of -- project the unconsumed tail out of a `Some` decode
--- result.
export rest_of := (o) ~> o.value.rest

--- empty -- the constantly-empty-buffer arrow, named so `complete` can
--- mention it.
export empty := (x) ~> bytes.from_list([])

--- prefixes -- every strict prefix of a buffer, shortest first. The
--- `prefix` law quantifies over all truncations through this helper.
export prefixes := (b) ~> while { i: 0, acc: [] } {
  [i, acc] ~> if i >= bytes.len(b) {
    { out: acc }
  } else {
    { state: { i: i + 1, acc: [...acc, bytes.slice(b, 0, i)] } }
  }
}

--- all_need_more -- decode every buffer in `bs`; `true` when each one
--- comes back `None`.
export all_need_more := (decode: Decode, bs) ~> while { xs: bs, ok: true } {
  [xs, ok] ~> match xs {
    []: { out: ok },
    [h, ...t]: { state: { xs: t, ok: ok && tag.tag_of(decode(h)) == "None" } }
  }
}

--- decode is a left inverse of encode up to the mask: decoding what a
--- conforming encoder produced returns the input frame (the mask key is
--- consumed on the wire). Quantified over the contract signatures so
--- any implementation can be checked against it.
export roundtrip := (encode: Encode, decode: Decode) ~> (encode >>> decode >>> frame_of) ~[2]~> frame_in

--- decode consumes exactly one frame: a lone encoded frame leaves an
--- empty rest. Coalesced frames are therefore peeled one at a time by
--- feeding `rest` back to `decode`.
export complete := (encode: Encode, decode: Decode) ~> (encode >>> decode >>> rest_of) ~[2]~> empty

--- need_more on every strict prefix: no proper truncation of an encoded
--- frame decodes to a frame -- incremental decoding is honest.
export prefix := (encode: Encode, decode: Decode) ~> (encode >>> prefixes >>> (bs) ~> all_need_more(decode, bs)) ~[2]~> (x) ~> true
