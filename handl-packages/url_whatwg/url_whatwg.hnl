--- url_whatwg.parse -- parse a WHATWG URL Standard string into a Value.
--- url_whatwg.url_whatwg -- return the parser token for url_whatwg.
cap "url_whatwg.parse"
cap "url_whatwg.url_whatwg"
op "url_whatwg.parse" : String -> Value
  guarantee: True
op "url_whatwg.url_whatwg" : () -> Value
  guarantee: True

handle "url_whatwg.parse" with rust_url_whatwg_parse
handle "url_whatwg.url_whatwg" with rust_url_whatwg_name
