--- Deterministic, pure-Handl backend for random values.
---
--- @details
--- Returns fixed, reproducible values so tests and benchmarks stay
--- deterministic. This is a no-effect backend; it does not call any
--- FFI library.

from "char" import { at }

do {
  -- Internal list helpers

  arr_len :: (xs) ~> do {
    while { xs: xs, n: 0 } {
      [xs, n] ~> match xs {
        []: { out: n },
        [_, ...t]: { state: { xs: t, n: n + 1 } }
      }
    }
  }

  arr_rev :: (xs) ~> do {
    while { xs: xs, acc: [] } {
      [xs, acc] ~> match xs {
        []: { out: acc },
        [h, ...t]: { state: { xs: t, acc: [h, ...acc] } }
      }
    }
  }

  arr_take :: (xs, n) ~> do {
    while { xs: xs, n: n, acc: [] } {
      [xs, n, acc] ~> if n <= 0 {
        { out: arr_rev(acc) }
      } else {
        match xs {
          []: { out: arr_rev(acc) },
          [h, ...t]: { state: { xs: t, n: n - 1, acc: [h, ...acc] } }
        }
      }
    }
  }

  {
    -- Always returns 4.
    int: (_max) ~> 4,

    -- Always returns 0.5.
    float: (_max) ~> 0.5,

    -- Always returns `true`.
    bool: () ~> true,

    -- Always returns the first element.
    pick: (xs) ~> xs[0],

    -- Always returns the first weighted element.
    weighted_pick: (_weights, items) ~> items[0],

    -- Cycles through `count` elements, wrapping around the input.
    choice: (xs, count) ~> do {
      while { n: count, acc: [] } {
        [n, acc] ~> if n <= 0 {
          { out: arr_rev(acc) }
        } else {
          { state: { n: n - 1, acc: [xs[math.mod(n - 1, arr_len(xs))], ...acc] } }
        }
      }
    },

    -- Always returns the first `count` elements.
    sample: (xs, count) ~> arr_take(xs, count),

    -- Always returns the reverse as a deterministic permutation.
    shuffle: (xs) ~> arr_rev(xs),

    -- Always returns `n` bytes of value `4`.
    bytes: (n) ~> do {
      while { n: n, acc: [] } {
        [n, acc] ~> if n <= 0 {
          { out: arr_rev(acc) }
        } else {
          { state: { n: n - 1, acc: [4, ...acc] } }
        }
      }
    },

    -- Always returns a string of `len` copies of `charset[0]`.
    string: (len, charset) ~> do {
      c = at(charset, 0);
      while { n: len, acc: "" } {
        [n, acc] ~> if n <= 0 {
          { out: acc }
        } else {
          { state: { n: n - 1, acc: acc + c } }
        }
      }
    },

    -- Always returns `mean`.
    gauss: (mean, _stddev) ~> mean,

    -- Always returns `0.0`.
    exponential: (_lambda) ~> 0.0,

    -- Always returns 0.
    poisson: (_lambda) ~> 0,

    -- Always returns 0.
    binomial: (_n, _p) ~> 0
  }
}
