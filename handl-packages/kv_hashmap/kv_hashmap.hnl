--- kv_hashmap -- in-memory HashMap-backed KeyValueStore implementation.
---
--- This is an impl crate: the HashKeyValueStore implements the
--- KeyValueStore trait from plugin-lib-kv. The kv.* ops are declared
--- here and bound to Rust handls that delegate to HashKeyValueStore.
cap "kv.get"
cap "kv.set"
cap "kv.remove"
cap "kv.clear"
cap "kv.has"
cap "kv.size"
op "kv.get" : String -> String?
  guarantee: True
op "kv.set" : (String * String) -> Unit
  guarantee: True
op "kv.remove" : String -> Unit
  guarantee: True
op "kv.clear" : Unit -> Unit
  guarantee: True
op "kv.has" : String -> Bool
  guarantee: True
op "kv.size" : Unit -> Int
  guarantee: NonNeg(output)

handle "kv.get" with rust_kv_get
handle "kv.set" with rust_kv_set
handle "kv.remove" with rust_kv_remove
handle "kv.clear" with rust_kv_clear
handle "kv.has" with rust_kv_has
handle "kv.size" with rust_kv_size
