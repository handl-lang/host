--- Deterministic, pure-Handl backend for `time`.
--- @details
--- Returns fixed, reproducible values so tests and benchmarks stay
--- deterministic. This is a no-effect backend; it does not read any clock.

from "../time" import { NowMs, InstantNs, ElapsedNs }

--- Always returns 0.
--- @returns {Nat - always 0}
--- @example
--- ```hnl
--- from "time" import { now_ms }
--- now_ms()
--- -- 0
--- ```
export now_ms: NowMs := () ~> 0

--- Always returns 0.
--- @returns {Nat - always 0}
--- @example
--- ```hnl
--- from "time" import { instant_ns }
--- instant_ns()
--- -- 0
--- ```
export instant_ns: InstantNs := () ~> 0

--- Always returns 0.
--- @details
--- The `start` parameter is ignored; it exists only for contract
--- compatibility.
--- @param {start} - ignored; present for contract compatibility
--- @returns {Nat - always 0}
--- @example
--- ```hnl
--- from "time" import { instant_ns, elapsed_ns }
--- start = instant_ns()
--- elapsed_ns(start)
--- -- 0
--- ```
export elapsed_ns: ElapsedNs := (start) ~> 0
