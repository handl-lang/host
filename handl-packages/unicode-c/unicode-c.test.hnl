--- Tests for `unicode-c` -- the `unicode` contract implemented over system
--- ICU4C (`libicuuc`).
--- @details
--- Every table-backed test is gated on `unicode_c.available`: on a host
--- without ICU the gated checks fall back to a sentinel expectation, so the
--- suite stays green. The `char.*`/`bytes.*`-only fields (`code_points`,
--- `from_code_points`, `is_ascii`, `code_point_at`, `decode`) are exact
--- without ICU and are asserted unconditionally.

from "./unicode-c" import * as unicode_c

-- probing -------------------------------------------------------------------

-- `available` must be a well-defined bool either way.
test_probe := assert(unicode_c.available == true || unicode_c.available == false) = true

test_version_nonneg := assert(unicode_c.icu_version >= 0) = true

-- code-point interop (exact without ICU) -------------------------------------

test_code_points_ascii := assert(unicode_c.code_points("abc") == [97, 98, 99]) = true

test_code_points_utf8 := assert(unicode_c.code_points("é") == [233]) = true

test_code_points_astral := assert(unicode_c.code_points("😀") == [128512]) = true

test_from_code_points := assert(unicode_c.from_code_points([97, 98, 99]) == "abc") = true

test_code_points_round_trip := assert(unicode_c.from_code_points(unicode_c.code_points("héllo😀")) == "héllo😀") = true

test_is_ascii_true := assert(unicode_c.is_ascii("abc") == true) = true

test_is_ascii_false := assert(unicode_c.is_ascii("é") == false) = true

test_code_point_at := assert(unicode_c.code_point_at("abc", 1) == 98) = true

-- past the end -> null (the native op's sentinel)
test_code_point_at_oob := assert(unicode_c.code_point_at("abc", 9) == null) = true

-- decode: [byte_offset, code_point] pairs ------------------------------------

test_decode_ascii := assert(unicode_c.decode("abc") == [[0, 97], [1, 98], [2, 99]]) = true

test_decode_two_byte := assert(unicode_c.decode("é") == [[0, 233]]) = true

test_decode_astral := assert(unicode_c.decode("😀") == [[0, 128512]]) = true

-- byte offsets advance by UTF-8 length, not code-point index
test_decode_offsets := assert(unicode_c.decode("aé") == [[0, 97], [1, 233]]) = true

test_decode_astral_offset := assert(unicode_c.decode("😀x") == [[0, 128512], [4, 120]]) = true

-- identifier categories (UAX #31) --------------------------------------------

test_ident_ascii := assert(if unicode_c.available {
  unicode_c.is_valid_identifier("abc")
} else {
  true
}) = true

test_ident_underscore := assert(if unicode_c.available {
  unicode_c.is_valid_identifier("_a")
} else {
  true
}) = true

test_ident_leading_digit := assert(if unicode_c.available {
  unicode_c.is_valid_identifier("1a")
} else {
  false
}) = false

test_ident_hyphen := assert(if unicode_c.available {
  unicode_c.is_valid_identifier("a-b")
} else {
  false
}) = false

test_ident_empty := assert(if unicode_c.available {
  unicode_c.is_valid_identifier("")
} else {
  false
}) = false

test_ident_non_ascii := assert(if unicode_c.available {
  unicode_c.is_valid_identifier("héllo")
} else {
  true
}) = true

test_ident_cjk := assert(if unicode_c.available {
  unicode_c.is_valid_identifier("日本")
} else {
  true
}) = true

test_xid_start := assert(if unicode_c.available {
  unicode_c.is_xid_start("a") && !unicode_c.is_xid_start("1")
} else {
  true
}) = true

test_xid_continue := assert(if unicode_c.available {
  unicode_c.is_xid_continue("1") && !unicode_c.is_xid_continue("-")
} else {
  true
}) = true

-- grapheme clusters (UAX #29) -------------------------------------------------

test_graphemes_ascii := assert(if unicode_c.available {
  unicode_c.graphemes("abc")
} else {
  ["a", "b", "c"]
}) == ["a", "b", "c"]

test_grapheme_count_ascii := assert(if unicode_c.available {
  unicode_c.grapheme_count("abc")
} else {
  3
}) = 3

test_graphemes_empty := assert(if unicode_c.available {
  unicode_c.grapheme_count("")
} else {
  0
}) = 0

-- covering law: concat(graphemes(s)) = s
test_graphemes_covering := assert(if unicode_c.available {
  str.join(unicode_c.graphemes("héllo😀"), "")
} else {
  "héllo😀"
}) = "héllo😀"

-- base + combining acute (U+0301) is one cluster
test_graphemes_combining := assert(if unicode_c.available {
  unicode_c.grapheme_count(unicode_c.from_code_points([101, 769]))
} else {
  1
}) = 1

-- family emoji: man + ZWJ + woman + ZWJ + girl is one cluster
test_graphemes_zwj := assert(if unicode_c.available {
  unicode_c.grapheme_count(unicode_c.from_code_points([128104, 8205, 128105, 8205, 128103]))
} else {
  1
}) = 1

-- CRLF is one cluster
test_graphemes_crlf := assert(if unicode_c.available {
  unicode_c.grapheme_count(unicode_c.from_code_points([13, 10]))
} else {
  1
}) = 1

-- regional-indicator pair (flag) is one cluster
test_graphemes_flag := assert(if unicode_c.available {
  unicode_c.grapheme_count(unicode_c.from_code_points([127482, 127480]))
} else {
  1
}) = 1

-- length law: LengthEq(graphemes(s), grapheme_count(s))
test_graphemes_length_law := assert(if unicode_c.available {
  list.len(unicode_c.graphemes("a😀日本")) == unicode_c.grapheme_count("a😀日本")
} else {
  true
}) = true

-- display width (UAX #11) -----------------------------------------------------

test_width_ascii := assert(if unicode_c.available {
  unicode_c.width("abc")
} else {
  3
}) = 3

test_width_empty := assert(if unicode_c.available {
  unicode_c.width("")
} else {
  0
}) = 0

-- CJK ideographs are East Asian Wide -> 2 columns each
test_width_cjk := assert(if unicode_c.available {
  unicode_c.width("日本")
} else {
  4
}) = 4

-- combining marks contribute 0
test_width_combining := assert(if unicode_c.available {
  unicode_c.width(unicode_c.from_code_points([101, 769]))
} else {
  1
}) = 1

-- case folding (CaseFolding.txt) ----------------------------------------------

test_casefold_ascii := assert(if unicode_c.available {
  unicode_c.casefold("ABC")
} else {
  "abc"
}) = "abc"

-- fold-only mapping: sharp s folds to "ss" (lowercasing alone would not)
test_casefold_sharp_s := assert(if unicode_c.available {
  unicode_c.casefold("ß")
} else {
  "ss"
}) = "ss"

test_casefold_idempotent := assert(if unicode_c.available {
  unicode_c.casefold(unicode_c.casefold("ß"))
} else {
  "ss"
}) = "ss"

-- normalization (UAX #15) -----------------------------------------------------

test_nfd_decomposes := assert(if unicode_c.available {
  unicode_c.nfd("é")
} else {
  unicode_c.from_code_points([101, 769])
}) == unicode_c.from_code_points([101, 769])

test_nfc_composes := assert(if unicode_c.available {
  unicode_c.nfc(unicode_c.from_code_points([101, 769]))
} else {
  "é"
}) = "é"

test_nfc_idempotent := assert(if unicode_c.available {
  unicode_c.nfc(unicode_c.nfc("é")) == unicode_c.nfc("é")
} else {
  true
}) = true

-- Hangul: NFD decomposes to jamo, NFC recomposes (round-trip law)
test_norm_hangul_round_trip := assert(if unicode_c.available {
  unicode_c.nfc(unicode_c.nfd("한"))
} else {
  "한"
}) = "한"

test_nfd_ascii_unchanged := assert(if unicode_c.available {
  unicode_c.nfd("abc")
} else {
  "abc"
}) = "abc"
