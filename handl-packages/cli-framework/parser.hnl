Flag :: {
  name: String,
  short: String,
  description: String,
  default: String,
  required: Bool
}

ParsedArgs :: {
  command: String,
  flags: Object,
  positional: List
}

make_flag :: (name: String, short: String, desc: String, default: String) ~> {
   name: name, short: short, description: desc, default: default, required: false }

make_required :: (flag: Flag) ~> {
   name: flag.name, short: flag.short, description: flag.description, default: flag.default, required: true }

is_flag_token :: (token: String) ~> str.starts_with(token, "--")

is_short_flag_token :: (token: String) ~> bool.and(str.starts_with(token, "-"), bool.not(str.starts_with(token, "--")))

extract_flag_name :: (token: String) ~> str.replace_first(token, "--", "")

extract_short_name :: (token: String) ~> str.replace_first(token, "-", "")

find_flag_by_name :: (flags: List, name: String) ~> option.unwrap_or(array.find(flags, (f: Object) ~> cmp.eq(f.name, name)), { default: "" })

find_flag_by_short :: (flags: List, short: String) ~> option.unwrap_or(array.find(flags, (f: Object) ~> cmp.eq(f.short, short)), { default: "" })

parse_flags :: (args: List, flag_defs: List) ~> array.fold_left(
    array.map(
      array.filter(args, (token: String) ~> is_flag_token(token)),
      (token: String) ~> extract_flag_name(token)
    ),
    {},
    (acc: Object, name: String) ~> acc
  )

parse_positional :: (args: List) ~> array.filter(args, (token: String) ~> bool.and(
      bool.not(str.starts_with(token, "--")),
      bool.not(bool.and(str.starts_with(token, "-"), str.length(token) > 1))
    )
  )

parse_args :: (args: List, flag_defs: List) ~> {
  
    command: option.unwrap_or(array.first(parse_positional(args)), ""),
    flags: parse_flags(args, flag_defs),
    positional: parse_positional(args)
  }

{
  make_flag: make_flag,
  make_required: make_required,
  is_flag_token: is_flag_token,
  is_short_flag_token: is_short_flag_token,
  extract_flag_name: extract_flag_name,
  extract_short_name: extract_short_name,
  find_flag_by_name: find_flag_by_name,
  find_flag_by_short: find_flag_by_short,
  parse_flags: parse_flags,
  parse_positional: parse_positional,
  parse_args: parse_args
}
