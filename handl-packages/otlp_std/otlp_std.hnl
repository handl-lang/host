--- otlp.configure -- set endpoint, service name, headers and resource attributes.
--- otlp.start_span -- start a span and return its id.
--- otlp.end_span -- end a span by id.
--- otlp.set_attribute -- set a span attribute.
--- otlp.add_event -- add a named event to a span.
--- otlp.record_log -- record a log entry.
--- otlp.record_metric -- record a numeric metric.
--- otlp.flush -- export all buffered telemetry via OTLP/HTTP.
--- otlp.shutdown -- end all spans, flush and release the exporter.
cap "otlp.configure"
cap "otlp.start_span"
cap "otlp.end_span"
cap "otlp.set_attribute"
cap "otlp.add_event"
cap "otlp.record_log"
cap "otlp.record_metric"
cap "otlp.flush"
cap "otlp.shutdown"
op "otlp.configure": Value -> Value
  guarantee: True
op "otlp.start_span": String -> String
  guarantee: IsString(output)
op "otlp.end_span": String -> Value
  guarantee: True
op "otlp.set_attribute": String -> Value
  guarantee: True
op "otlp.add_event": String -> Value
  guarantee: True
op "otlp.record_log": String -> Value
  guarantee: True
op "otlp.record_metric": String -> Value
  guarantee: True
op "otlp.flush": -> Value
  guarantee: True
op "otlp.shutdown": -> Value
  guarantee: True

handle "otlp.configure" with rust_otlp_configure
handle "otlp.start_span" with rust_otlp_start_span
handle "otlp.end_span" with rust_otlp_end_span
handle "otlp.set_attribute" with rust_otlp_set_attribute
handle "otlp.add_event" with rust_otlp_add_event
handle "otlp.record_log" with rust_otlp_record_log
handle "otlp.record_metric" with rust_otlp_record_metric
handle "otlp.flush" with rust_otlp_flush
handle "otlp.shutdown" with rust_otlp_shutdown
