--- The `rand-c` backed deterministic noise backend.
--- @details
--- Produces deterministic value noise in a `[-1, 1]` range by hashing
--- integer lattice coordinates with `rand-c.seeded_int`, then smoothing
--- and linearly interpolating between neighbours. This is intentionally a
--- simple value-noise implementation for the current phase, not full
--- gradient Perlin/Simplex noise.

from "../rand-c" import { seeded_int }

do {
  HASH_MAX = 2147483646

  smooth :: (t) ~> math.mul(t, math.mul(t, math.sub(3, math.mul(2, t))))

  noise1 :: (i) ~> math.map_range(
    seeded_int(math.add(math.abs(i), 1000003), HASH_MAX),
    0, HASH_MAX, -1, 1
  )

  noise2 :: (i, j) ~> math.map_range(
    seeded_int(
      math.add(
        math.add(math.mul(math.abs(i), 374761393), math.mul(math.abs(j), 668265295)),
        1000003
      ),
      HASH_MAX
    ),
    0, HASH_MAX, -1, 1
  )

  noise3 :: (i, j, k) ~> math.map_range(
    seeded_int(
      math.add(
        math.add(
          math.add(math.mul(math.abs(i), 374761393), math.mul(math.abs(j), 668265295)),
          math.mul(math.abs(k), 1207296579)
        ),
        1000003
      ),
      HASH_MAX
    ),
    0, HASH_MAX, -1, 1
  )

  perlin_1d :: (x) ~> do {
    i = math.floor(x)
    f = math.fract(x)
    t = smooth(f)
    a = noise1(i)
    b = noise1(math.add(i, 1))
    math.lerp(a, b, t)
  }

  perlin_2d :: (x, y) ~> do {
    i = math.floor(x)
    j = math.floor(y)
    u = math.fract(x)
    v = math.fract(y)
    sx = smooth(u)
    sy = smooth(v)
    n00 = noise2(i, j)
    n10 = noise2(math.add(i, 1), j)
    n01 = noise2(i, math.add(j, 1))
    n11 = noise2(math.add(i, 1), math.add(j, 1))
    x0 = math.lerp(n00, n10, sx)
    x1 = math.lerp(n01, n11, sx)
    math.lerp(x0, x1, sy)
  }

  perlin_3d :: (x, y, z) ~> do {
    i = math.floor(x)
    j = math.floor(y)
    k = math.floor(z)
    u = math.fract(x)
    v = math.fract(y)
    w = math.fract(z)
    sx = smooth(u)
    sy = smooth(v)
    sz = smooth(w)
    n000 = noise3(i, j, k)
    n100 = noise3(math.add(i, 1), j, k)
    n010 = noise3(i, math.add(j, 1), k)
    n110 = noise3(math.add(i, 1), math.add(j, 1), k)
    n001 = noise3(i, j, math.add(k, 1))
    n101 = noise3(math.add(i, 1), j, math.add(k, 1))
    n011 = noise3(i, math.add(j, 1), math.add(k, 1))
    n111 = noise3(math.add(i, 1), math.add(j, 1), math.add(k, 1))
    x00 = math.lerp(n000, n100, sx)
    x01 = math.lerp(n010, n110, sx)
    x10 = math.lerp(n001, n101, sx)
    x11 = math.lerp(n011, n111, sx)
    y0 = math.lerp(x00, x01, sy)
    y1 = math.lerp(x10, x11, sy)
    math.lerp(y0, y1, sz)
  }

  simplex_2d :: (x, y) ~> perlin_2d(math.add(x, y), math.sub(math.mul(1.5, x), y))

  simplex_3d :: (x, y, z) ~> perlin_3d(math.add(x, y), math.add(y, z), math.add(z, x))

  {
    perlin_1d: perlin_1d,
    perlin_2d: perlin_2d,
    perlin_3d: perlin_3d,
    simplex_2d: simplex_2d,
    simplex_3d: simplex_3d
  }
}
