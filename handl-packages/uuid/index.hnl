--- Universally unique identifier generation contract.
--- @details
--- The `uuid` contract abstracts v4 UUID generation. Backends such as
--- `uuid-c` and `uuid-stub` implement the same interface, selected by
--- platform configuration.

from "../grade" import { Grade }

--- @template Uuid
--- Grade for effectful v4 UUID generation.
--- @details
--- `Uuid` tags arrows that generate fresh v4 UUIDs. Backends such as
--- `uuid-c` combine it with `Effect` to grade effectful generation.
export Uuid<T>: Grade

--- Generate a random v4 UUID string.
--- @returns {String - 36-character UUID in 8-4-4-4-12 lowercase hex}
export v4: () - > String
