from "../str-handl" import * as str
from "../transform" import { map, reduce }

export dedent :: (text: String) ~> do {
  indent_of :: (line: String) ~> do {
    str.length(line) - str.length(str.trim_start(line))
  }
  is_blank :: (line: String) ~> do {
    str.is_empty(str.trim(line))
  }
  prefix_of :: (line: String) ~> do {
    str.slice(line, 0, indent_of(line))
  }

  shrink :: (p: String, line: String) ~> do {
    result :: p
    i :: str.length(p)

    while !str.starts_with(line, result) && i > 0 {
      result = str.slice(result, 0, str.length(result) - 1);
      i = i - 1
    }

    result
  }

  update_common :: (acc, line) ~> do {
    if is_blank(line) {
      acc
    } else {
      if !acc.seen {
        { common: prefix_of(line), seen: true }
      } else {
        { common: shrink(acc.common, line), seen: true }
      }
    }
  }

  normalized :: str.replace(
    str.replace(text, "\r\n", "\n"),
    "\r",
    "\n"
  )
  trimmed :: str.trim_matches(normalized, "\n")

  if str.is_empty(str.trim(trimmed)) {
    return ""
  }

  lines :: str.lines(trimmed)

  state :: reduce([lines, { common: "", seen: false }, update_common])
  common :: state.common

  strip_line :: (line: String) ~> do {
    if is_blank(line) {
      return ""
    }

    str.strip_prefix(line, common)
  }

  str.join(map(lines, strip_line), "\n")
}
