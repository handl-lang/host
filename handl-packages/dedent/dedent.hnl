--- Dedent multi-line text by removing a shared leading whitespace prefix.
---
--- @details
--- The `dedent` package provides a single arrow that normalizes line
--- endings, strips surrounding blank lines, finds the largest leading
--- whitespace prefix common to all non-blank lines, and removes it while
--- keeping relative indentation intact.

from "../type" import { String }
from "../str-handl" import * as str
from "../transform" import { map, filter, reduce }

--- Remove the largest common leading whitespace prefix from `text`.
---
--- @param {text} - the multi-line string to dedent
--- @returns {String - the dedented text, or the empty string for blank input}
--- @details
--- Blank and whitespace-only lines are ignored when computing the shared
--- prefix. They are output as empty lines so no trailing whitespace remains.
export dedent := (text: String) ~> do {
  build_prefixes := (s: String) ~> do {
    n := str.length(s)
    reduce([str.split(s, ""), { i: 0, p: "", ps: [] }, [state, part] ~> do {
          p := state.p + part
          ps := state.ps
          if state.i <= n {
            ps := [p, ...ps]
          }
          i := state.i + 1
          { i: i, p: p, ps: ps }
        }]).ps
  }

  is_blank := (line: String) ~> str.is_empty(str.trim(line))

  common_prefix := (a: String, b: String) ~> do {
    reduce([build_prefixes(a), "", [result, p] ~> do {
          if result == "" && str.starts_with(b, p) {
            result := p
          }
          result
        }])
  }

  prefix_of := (line: String) ~> do {
    reduce([build_prefixes(line), "", [result, p] ~> do {
          if result == "" && is_blank(p) {
            result := p
          }
          result
        }])
  }

  normalized := str.replace(
    str.replace(text, "\r\n", "\n"),
    "\r",
    "\n"
  )
  trimmed := str.trim_matches(normalized, "\n")

  if str.is_empty(str.trim(trimmed)) {
    return ""
  }

  lines := str.lines(trimmed)
  non_blank := filter(lines, line ~> !is_blank(line))

  common_full := reduce([non_blank, "", [acc, line] ~> do {
        result := line
        if acc != "" {
          result := common_prefix(acc, line)
        }
        result
      }])
  common := prefix_of(common_full)

  strip_line := (line: String) ~> do {
    if is_blank(line) {
      return ""
    }
    str.strip_prefix(line, common)
  }

  str.join(map(lines, strip_line), "\n")
}
