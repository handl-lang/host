--- Dedents a multi-line string by removing its common indentation.
---
--- @details
--- CRLF line endings are normalized to LF. Leading and trailing newlines
--- are removed. Blank lines do not contribute to the common indentation.
--- Spaces and tabs are treated as leading whitespace.
---
--- The relative indentation between non-blank lines is preserved.
---
--- @example
--- `
---     Hello
---     World
--- ` >>> dedent
--- -- => `
--- Hello
--- World
--- `
---
--- @example
--- `
---         Hello
---
---         World
--- ` >>> dedent
--- -- => `
--- Hello
---
--- World
--- `
---
--- @example
--- "    Hello\r\n    World" >>> dedent
--- -- => "Hello\nWorld"
---
from "str" import * as str
from "comb" import * as comb

export dedent :: (text: String) ~> {
  indent_of :: (line: String) ~> {
    (line >>> str.length) - ((line >>> str.trim_start) >>> str.length)
  }

  is_blank :: (line: String) ~> (line >>> str.trim >>> str.is_empty)

  strip_indent :: (line: String, n: Number) ~> {
    if (line >>> indent_of) >= n {
      (line *** n *** (line >>> str.length)) >>> str.slice
    } else {
      line
    }
  }

  normalized :: (text *** "\r\n" *** "\n") >>> str.replace
  trimmed :: (normalized *** "\n") >>> str.trim_matches

  if (trimmed >>> str.is_empty) {
    ""
  } else {
    lines :: trimmed >>> str.lines;

    common :: while { lines: lines, min: 0, seen: false } {
      [lines, min, seen] ~> match lines {
        []: { out: min },
        [h, ...t]: if (h >>> is_blank) {
          { state: { lines: t, min: min, seen: seen } }
        } else {
          { state: { lines: t, min: if seen { if (h >>> indent_of) < min { h >>> indent_of } else { min } } else { h >>> indent_of }, seen: true } }
        }
      }
    };

    (((((line: String) ~> (line *** common) >>> strip_indent) *** lines) >>> comb.map) *** "\n") >>> str.join
  }
}
