--- option — Option type constructors and operations for the handl runtime.
---
--- Single source of truth for the `option` stdlib interface: 15 functions
--- covering constructors, predicates, unwrapping, transformation, and
--- combinators for `Option` values. The Rust bridge in `plugin-lib-utils`
--- loads this file via `include_str!`, parses the `cap` declarations for the
--- plugin capability surface, and registers the Rust handls (handlers) in an
--- `OpRegistry` that dispatches each `op` to its native Rust impl.
---
--- An `Option` is represented as `{"_tag": "Some", "value": <T>}` or
--- `{"_tag": "None"}`.
---
--- All 15 functions are FFI atoms (they manipulate `serde_json::Value`
--- option values and call `apply_fn` from `crate::shared` and cannot be
--- expressed as pure handl arrows without losing the exact `TypeMismatch`
--- error messages the tests rely on). The `op`/`handl` declaration form
--- (ADR-0077 Phase 2) declares the interface; the Rust `Function` impls
--- in `ops.rs` provide the logic.
---
--- ## Capability declarations (ADR-0077 Phase 4)
--- option.some — wrap a value in a Some option.
--- option.none — construct a None option.
--- option.is_some — test whether an option is Some.
--- option.is_none — test whether an option is None.
--- option.unwrap — extract the value from a Some option, error on None.
--- option.unwrap_or — extract the value or return a default.
--- option.unwrap_or_else — extract the value or call a function for a default.
--- option.map — apply a function to the value inside a Some option.
--- option.flat_map — apply a function that returns an option to a Some option.
--- option.and_then — alias for flat_map.
--- option.filter — keep a Some option only if a predicate holds.
--- option.map_or — apply a function to a Some option or return a default.
--- option.or — return the first option if Some, otherwise the second.
--- option.or_else — return the first option if Some, otherwise call a function.
--- option.and — return the second option if the first is Some, otherwise None.
--- option.xor — return the Some option if exactly one of two options is Some.
cap "option.some"
cap "option.none"
cap "option.is_some"
cap "option.is_none"
cap "option.unwrap"
cap "option.unwrap_or"
cap "option.unwrap_or_else"
cap "option.map"
cap "option.flat_map"
cap "option.and_then"
cap "option.filter"
cap "option.map_or"
cap "option.or"
cap "option.or_else"
cap "option.and"
cap "option.xor"
op "option.some" : Value -> Value
  guarantee: True
op "option.none" : Value -> Value
  guarantee: True
op "option.is_some" : Value -> Bool
  guarantee: True
op "option.is_none" : Value -> Bool
  guarantee: True
op "option.unwrap" : Value -> Value
  guarantee: True
op "option.unwrap_or" : (Value * Value) -> Value
  guarantee: True
op "option.unwrap_or_else" : (Value * Value) -> Value
  guarantee: True
op "option.map" : (Value * Value) -> Value
  guarantee: True
op "option.flat_map" : (Value * Value) -> Value
  guarantee: True
op "option.and_then" : (Value * Value) -> Value
  guarantee: True
op "option.filter" : (Value * Value) -> Value
  guarantee: True
op "option.map_or" : (Value * Value * Value) -> Value
  guarantee: True
op "option.or" : (Value * Value) -> Value
  guarantee: True
op "option.or_else" : (Value * Value) -> Value
  guarantee: True
op "option.and" : (Value * Value) -> Value
  guarantee: True
op "option.xor" : (Value * Value) -> Value
  guarantee: True
handl "option.some" = rust_option_some
handl "option.none" = rust_option_none
handl "option.is_some" = rust_option_is_some
handl "option.is_none" = rust_option_is_none
handl "option.unwrap" = rust_option_unwrap
handl "option.unwrap_or" = rust_option_unwrap_or
handl "option.unwrap_or_else" = rust_option_unwrap_or_else
handl "option.map" = rust_option_map
handl "option.flat_map" = rust_option_flat_map
handl "option.and_then" = rust_option_and_then
handl "option.filter" = rust_option_filter
handl "option.map_or" = rust_option_map_or
handl "option.or" = rust_option_or
handl "option.or_else" = rust_option_or_else
handl "option.and" = rust_option_and
handl "option.xor" = rust_option_xor
