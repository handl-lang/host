--- Tests for the bitwise integer ops of the `math` stdlib module
--- (`utils/math.hnl`): `math.bit_and`, `math.bit_xor`, `math.bit_not`,
--- `math.rotl32`, and `math.u32`. `math` is a host module on the
--- stdlib chain, so no import is needed (same convention as
--- `perlin.test.hnl`).

test_bit_and_both_set := assert math.bit_and(1, 1) = 1

test_bit_and_clears := assert math.bit_and(12, 10) = 8

test_bit_and_mask_low7 := assert math.bit_and(129, 127) = 1

test_bit_and_negative := assert math.bit_and(-1, 255) = 255

test_bit_xor_differs := assert math.bit_xor(1, 0) = 1

test_bit_xor_self := assert math.bit_xor(12, 12) = 0

test_bit_xor_mask_byte := assert math.bit_xor(72, 55) = 127

test_bit_not_zero := assert math.bit_not(0) = -1

test_bit_not_neg_one := assert math.bit_not(-1) = 0

test_rotl32_zero := assert math.rotl32(305419896, 0) = 305419896

test_rotl32_five := assert math.rotl32(305419896, 5) = 1183502082

test_rotl32_high_bit := assert math.rotl32(2147483648, 1) = 1

test_rotl32_wraps_at_32 := assert math.rotl32(3735928559, 32) = 3735928559

test_rotl32_thirty_three := assert math.rotl32(1, 33) = 2

test_rotl32_negative_input := assert math.rotl32(-1, 1) = 4294967295

test_u32_zero := assert math.u32(0) = 0

test_u32_negative_one := assert math.u32(-1) = 4294967295

test_u32_wraps_above_range := assert math.u32(4294967296) = 0

test_u32_wraps_remainder := assert math.u32(4294967303) = 7
