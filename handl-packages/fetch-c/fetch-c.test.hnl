--- fetch-c tests: libcurl backend against a local canned HTTP server
--- (test_server.py — serves exactly one GET and one POST then exits).

from "./fetch-c" import { fetch }
from "../generated/libc-c-linux-x86_64/stdlib" import { system }

is_err := (r) ~> tag.tag_of(r) == "err"

val_of := (r) ~> tag.untag(r).value

--- poll for the server's readiness sentinel via system("test -f")
wait_ready := (_u) ~> do {
  while { n: 0 } {
    (st) ~> do {
      r := system("test -f /tmp/fetch-c-test-ready")
      if st.n > 50 {
        { out: false }
      } else if is_err(r) {
        { state: { n: st.n + 1 } }
      } else if val_of(r) == 0 {
        { out: true }
      } else {
        _ := system("sleep 0.1")
        { state: { n: st.n + 1 } }
      }
    }
  }
}

start_server := (_u) ~> do {
  _ := system("rm -f /tmp/fetch-c-test-ready")
  _ := system("python3 handl-packages/fetch-c/test_server.py >/dev/null 2>&1 &")
  wait_ready(null)
}

test_get := assert do {
  _ := start_server(null)
  r := fetch("http://127.0.0.1:18347/", {})
  r.status
} := 200

test_get_body := assert do {
  _ := wait_ready(null)
  r := fetch("http://127.0.0.1:18347/", {})
  r.body
} := "{\"hello\":\"handl\"}"

test_get_headers := assert do {
  _ := wait_ready(null)
  r := fetch("http://127.0.0.1:18347/", {})
  hash_map.get_or(r.headers, "x-test", "missing")
} := "yes"

test_post_echo := assert do {
  _ := wait_ready(null)
  r := fetch("http://127.0.0.1:18347/echo",
    { method: "POST", body: "hndl", headers: { "Content-Type": "text/plain" } })
  r.body
} := "{\"echo\":\"hndl\"}"

test_done := assert do {
  r := fetch("http://127.0.0.1:18347/done", {})
  r.status
} := 200
