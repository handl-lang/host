--- fetch-c -- `fetch` backed by libcurl (sdkgen bindings).
---
--- Capture design: libcurl's default writer streams the response body
--- into a tmpfile() via CURLOPT_WRITEDATA and the header block into a
--- second tmpfile() via CURLOPT_HEADERDATA -- no C callback trampolines
--- needed. After the transfer completes we rewind both streams and
--- drain them with libc read().
---
--- Two forms:
---   fetch(url, init)      synchronous -- curl_easy_perform blocks.
---   fetch_task            step-arrow for concurrent-epoll -- suspends
---                         on `curl_perform`; the scheduler drives the
---                         transfer via a shared CURLM + epoll.
---
--- fetch(url, init) where init (all fields optional):
---   method      "GET" default; "HEAD" via NOBODY, others via CUSTOMREQUEST
---   headers     { name: value } record, appended via curl_slist
---   body        String, sent verbatim via COPYPOSTFIELDS (+ size)
---   timeout_ms  Int
---   follow      Bool, default true (FOLLOWLOCATION)
---   user_agent  String
--- returns { status: Int, headers: {...}, body: String, body_bytes: Bytes }
--- and raises on transport failure (CURLE_*).

from "../generated/curl-c-linux-x86_64/curl" import * as curlm
from "../generated/libc-c-linux-x86_64/stdio" import * as stdiom
from "../generated/libc-c-linux-x86_64/unistd" import * as unistdm
from "str" import * as strm
from "bytes" import * as bytesm

--- local aliases: a task arrow's serialized env keeps ` := ` bindings
--- but drops `import` bindings, so the step-arrow path must reach
--- imported names through a local binding (runtime limitation).
cm := curlm

fiom := stdiom

iom := unistdm

sm := strm

bm := bytesm

is_err := (r) ~> tag.tag_of(r) == "err"

val_of := (r) ~> tag.untag(r).value

unwrap := (r, what) ~> do {
  if is_err(r) {
    error.raise("fetch-c: " + what + " failed")
  } else {
    val_of(r)
  }
}

--- curl_easy_setopt / curl_easy_getinfo are variadic: call ffi.call with
--- a per-type fixed signature (SysV passes int/ptr varargs identically).

setopt_str := (h, opt, v) ~> do {
  ffi.call("libcurl.so.4", "curl_easy_setopt", [h, opt, v],
    ["ptr", "i32", "cstr"], "i32", false)
}

setopt_ptr := (h, opt, v) ~> do {
  ffi.call("libcurl.so.4", "curl_easy_setopt", [h, opt, v],
    ["ptr", "i32", "ptr"], "i32", false)
}

setopt_long := (h, opt, v) ~> do {
  ffi.call("libcurl.so.4", "curl_easy_setopt", [h, opt, v],
    ["ptr", "i32", "i64"], "i32", false)
}

--- cm.CURLINFO_RESPONSE_CODE writes a long into a cell we seed with 0;
--- the value comes back in `vals`.
getinfo_long := (h, info) ~> do {
  ffi.call("libcurl.so.4", "curl_easy_getinfo", [h, info, 0],
    ["ptr", "i32", "io_scalar:i64"], "i32", false)
}

check_setopt := (code, what) ~> do {
  if code != cm.CURLE_OK {
    error.raise("fetch-c: curl_easy_setopt " + what + ": " +
      val_of(cm.curl_easy_strerror(code)))
  } else {
    null
  }
}

--- drain a rewound FILE* into Bytes via fileno+read (64KiB chunks).
read_all := (fd) ~> while { fd: fd, acc: bm.from_list([]) } {
  (fd, acc) ~> do {
    r := iom.read(fd)
    if is_err(r) {
      { out: acc }
    } else if bm.len(val_of(r)) == 0 {
      { out: acc }
    } else {
      { state: { fd: fd, acc: bm.concat(acc, val_of(r)) } }
    }
  }
}

--- last response block wins (redirects stack header blocks);
--- status line resets the accumulator.
parse_headers := (b) ~> while { lines: sm.split(bm.utf8_decode(b), "\r\n"), acc: {} } {
  (lines, acc) ~> match lines {
    []: { out: acc },
    [h, ...t]: if sm.starts_with(h, "HTTP/") {
      { state: { lines: t, acc: {} } }
    } else {
      do {
        i := sm.find(h, ":")
        if i > 0 {
          { state: { lines: t, acc: hash_map.set(acc,
              sm.lower(sm.trim(sm.slice(h, 0, i))),
              sm.trim(sm.slice(h, i + 1, sm.length(h)))) } }
        } else {
          { state: { lines: t, acc: acc } }
        }
      }
    }
  }
}

set_method := (h, method) ~> do {
  if method == "HEAD" {
    check_setopt(setopt_long(h, cm.CURLOPT_NOBODY, 1), "NOBODY")
  } else if method != "GET" {
    check_setopt(setopt_str(h, cm.CURLOPT_CUSTOMREQUEST, method), "CUSTOMREQUEST")
  } else {
    null
  }
}

set_body := (h, body) ~> do {
  if body == null {
    null
  } else {
    do {
      _ := check_setopt(setopt_long(h, cm.CURLOPT_POSTFIELDSIZE, bm.len(bm.utf8_encode(body))), "POSTFIELDSIZE")
      check_setopt(setopt_str(h, cm.CURLOPT_COPYPOSTFIELDS, body), "COPYPOSTFIELDS")
    }
  }
}

set_opt_str := (h, opt, v, what) ~> do {
  if v == null {
    null
  } else {
    check_setopt(setopt_str(h, opt, v), what)
  }
}

set_opt_long := (h, opt, v, what) ~> do {
  if v == null {
    null
  } else {
    check_setopt(setopt_long(h, opt, v), what)
  }
}

fold_headers := (ks, headers, slist) ~> do {
  while { ks: ks, slist: slist } {
    (ks, slist) ~> match ks {
      []: { out: slist },
      [k, ...t]: do {
        line := k + ": " + hash_map.get_or(headers, k, "")
        { state: { ks: t, slist: val_of(cm.curl_slist_append(slist, line)) } }
      }
    }
  }
}

build_slist := (init) ~> do {
  headers := hash_map.get_or(init, "headers", {})
  fold_headers(obj.keys(headers), headers, 0)
}

--- wire a fresh easy handle + its two tmpfile captures for `init`.
--- Returns { easy, bodyf, hdrf, slist } — ownership passes to
--- finish_request (or the caller on raise).
build_request := (url, init) ~> do {
  h := unwrap(cm.curl_easy_init(), "curl_easy_init")
  bodyf := unwrap(fiom.tmpfile(), "tmpfile(body)")
  hdrf := unwrap(fiom.tmpfile(), "tmpfile(headers)")
  _ := check_setopt(setopt_long(h, cm.CURLOPT_NOSIGNAL, 1), "NOSIGNAL")
  _ := check_setopt(setopt_str(h, cm.CURLOPT_URL, url), "URL")
  _ := check_setopt(setopt_ptr(h, cm.CURLOPT_WRITEDATA, bodyf), "WRITEDATA")
  _ := check_setopt(setopt_ptr(h, cm.CURLOPT_HEADERDATA, hdrf), "HEADERDATA")
  _ := set_method(h, hash_map.get_or(init, "method", "GET"))
  _ := set_body(h, hash_map.get_or(init, "body", null))
  _ := set_opt_str(h, cm.CURLOPT_USERAGENT,
      hash_map.get_or(init, "user_agent", null), "USERAGENT")
  _ := set_opt_long(h, cm.CURLOPT_TIMEOUT_MS,
      hash_map.get_or(init, "timeout_ms", null), "TIMEOUT_MS")
  _ := if hash_map.get_or(init, "follow", true) {
    check_setopt(setopt_long(h, cm.CURLOPT_FOLLOWLOCATION, 1), "FOLLOWLOCATION")
  } else {
    null
  }
  slist := build_slist(init)
  _ := if slist != 0 {
    check_setopt(setopt_ptr(h, cm.CURLOPT_HTTPHEADER, slist), "HTTPHEADER")
  } else {
    null
  }
  { easy: h, bodyf: bodyf, hdrf: hdrf, slist: slist }
}

--- after perform (sync) or curl_perform completion (async, `rc` =
--- CURLcode): read status, drain both tmpfiles, release every resource,
--- then raise on transport error or return the response record.
finish_request := (r, rc) ~> do {
  status := if rc == cm.CURLE_OK {
    do {
      g := getinfo_long(r.easy, cm.CURLINFO_RESPONSE_CODE)
      g.vals[0]
    }
  } else {
    0
  }
  _ := fiom.rewind(r.bodyf)
  _ := fiom.rewind(r.hdrf)
  body := read_all(unwrap(fiom.fileno(r.bodyf), "fileno"))
  hdrraw := read_all(unwrap(fiom.fileno(r.hdrf), "fileno"))
  _ := fiom.fclose(r.bodyf)
  _ := fiom.fclose(r.hdrf)
  _ := if r.slist != 0 { cm.curl_slist_free_all(r.slist) } else { null }
  _ := cm.curl_easy_cleanup(r.easy)
  if rc != cm.CURLE_OK {
    error.raise("fetch-c: curl_easy_perform: " +
      val_of(cm.curl_easy_strerror(rc)))
  } else {
    { status: status, headers: parse_headers(hdrraw),
      body: bm.utf8_decode(body), body_bytes: body }
  }
}

export fetch := (url, init) ~> do {
  r := build_request(url, init)
  finish_request(r, val_of(cm.curl_easy_perform(r.easy)))
}

--- step-arrow task form for concurrent-epoll:
---   run(fetch_task, { url: "...", init: { method: "POST", ... } })
--- or `enter`/`spawn` it from another task. The task suspends on
--- `curl_perform`; the scheduler drives the transfer through a shared
--- CURLM + epoll and resumes it with `{ code: CURLcode }`.
export fetch_task := (s) ~> match hash_map.get_or(s, "phase", "start") {
  "start": do {
    r := build_request(s.url, hash_map.get_or(s, "init", {}))
    { call: { name: "curl_perform", easy: r.easy },
      state: { phase: "finish", req: r } }
  },
  "finish": do {
    { out: finish_request(s.req, s.result.code) }
  }
}
