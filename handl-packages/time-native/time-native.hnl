--- time-native — the Rust `std::time` backend for the `time` contract.
---
--- Implements every `time.*` axiom in `handl-packages/time/time.hnl` using
--- Rust's standard-library clock facilities:
---
---   time.now_ms     -> SystemTime::now() since UNIX_EPOCH (wall clock)
---   time.instant_ns -> a process-lifetime monotonic Instant base
---                      (`Instant::now()` captured on first use; readings
---                      are nanoseconds elapsed since that base, so only
---                      differences are meaningful — matching the contract)
---   time.elapsed_ns -> saturating difference `instant_ns() - input`
---
--- All three reads are effectful and sit behind `cap` declarations
--- (ADR-0055): a host that does not register the `time` module offers no
--- clock at all.

cap "time.now_ms"
cap "time.instant_ns"
cap "time.elapsed_ns"

op "time.now_ms" : () -> Int
  guarantee: Le(0, output)
op "time.instant_ns" : () -> Int
  guarantee: Le(0, output)
op "time.elapsed_ns" : Int -> Int
  guarantee: Le(0, output)

handl "time.now_ms" = rust_time_now_ms
handl "time.instant_ns" = rust_time_instant_ns
handl "time.elapsed_ns" = rust_time_elapsed_ns
