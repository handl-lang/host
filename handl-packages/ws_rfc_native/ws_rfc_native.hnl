--- ws_rfc_native -- native RFC 6455 WebSocket client/server (tokio-tungstenite backend).
---
--- This is the native implementation of the ws_rfc interface, backed by
--- tokio-tungstenite for real TCP/TLS WebSocket connections.
---
--- ## client API
--- ws_rfc.client -- create a native WebSocket client.
--- ws_rfc.connect -- connect a client to a URL via tokio-tungstenite.
--- ws_rfc.send -- send a message on a client.
--- ws_rfc.recv -- receive the next message on a client, or null if empty.
--- ws_rfc.close -- close a client connection.
---
--- ## server API
--- ws_rfc.server -- create a native WebSocket server.
--- ws_rfc.listen -- start a server listening on an address with a handler.
--- ws_rfc.stop -- stop a running server.
---
--- ## frame codec
--- ws_rfc.frame.encode -- encode a frame object into base64 frame bytes.
--- ws_rfc.frame.decode -- decode base64 frame bytes into a frame object.
---
--- ## message codec
--- ws_rfc.message.from_frame -- construct a message object from a frame.
--- ws_rfc.message.to_frame -- encode a message object into base64 frame bytes.
cap "ws_rfc.client"
cap "ws_rfc.connect"
cap "ws_rfc.send"
cap "ws_rfc.recv"
cap "ws_rfc.close"
cap "ws_rfc.server"
cap "ws_rfc.listen"
cap "ws_rfc.stop"
cap "ws_rfc.frame.encode"
cap "ws_rfc.frame.decode"
cap "ws_rfc.message.from_frame"
cap "ws_rfc.message.to_frame"
op "ws_rfc.client" : () -> Value
  guarantee: True
op "ws_rfc.connect" : (Value, String) -> Value
  guarantee: True
op "ws_rfc.send" : (Value, Value) -> Value
  guarantee: True
op "ws_rfc.recv" : Value -> Value
  guarantee: True
op "ws_rfc.close" : Value -> Value
  guarantee: True
op "ws_rfc.server" : () -> Value
  guarantee: True
op "ws_rfc.listen" : (Value, String, Function) -> Value
  guarantee: True
op "ws_rfc.stop" : Value -> Value
  guarantee: True
op "ws_rfc.frame.encode" : Value -> String
  guarantee: IsBase64(output)
op "ws_rfc.frame.decode" : String -> Value
  guarantee: True
op "ws_rfc.message.from_frame" : Value -> Value
  guarantee: True
op "ws_rfc.message.to_frame" : Value -> String
  guarantee: IsBase64(output)

handle "ws_rfc.client" with rust_ws_rfc_native_client
handle "ws_rfc.connect" with rust_ws_rfc_native_connect
handle "ws_rfc.send" with rust_ws_rfc_native_send
handle "ws_rfc.recv" with rust_ws_rfc_native_recv
handle "ws_rfc.close" with rust_ws_rfc_native_close
handle "ws_rfc.server" with rust_ws_rfc_native_server
handle "ws_rfc.listen" with rust_ws_rfc_native_listen
handle "ws_rfc.stop" with rust_ws_rfc_native_stop
handle "ws_rfc.frame.encode" with rust_ws_rfc_frame_encode
handle "ws_rfc.frame.decode" with rust_ws_rfc_frame_decode
handle "ws_rfc.message.from_frame" with rust_ws_rfc_message_from_frame
handle "ws_rfc.message.to_frame" with rust_ws_rfc_message_to_frame
