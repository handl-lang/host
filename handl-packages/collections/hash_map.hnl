--- hash_map — the `hash_map` module contract.
---
--- The op-backed surface (constructors, access, mutation, selection,
--- combination, and deep operations) stays native. The field-enumeration
--- surface (`keys`, `values`, `entries`) is now pure handl over the `obj`
--- introspection primitives.
from "obj" import * as obj

{
  keys: m ~> obj.keys(m),
  values: m ~> obj.values(m),
  entries: m ~> obj.entries(m)
}
