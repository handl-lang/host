--- hash_map — the `hash_map` module contract.
---
--- The op-backed surface (constructors, access, mutation, selection,
--- combination, and deep operations) stays native. The field-enumeration
--- surface (`keys`, `values`, `entries`) and the simple inspection/membership
--- surface (`len`, `is_empty`, `has`, `has_key`, `clone_deep`) are now pure
--- handl over the `obj` introspection primitives and the leaf `array`
--- helpers (`len`, `contains`).
---
--- NOTE: the `array` aggregator itself depends on `hash_map`, so importing
--- it here would form a dependency cycle; the leaf `collections/array/len`
--- and `collections/array/contains` submodules are used instead.
from "obj" import keys
from "obj" import values
from "obj" import entries
from "len" import len
from "contains" import contains

{
  keys: m ~> keys(m),
  values: m ~> values(m),
  entries: m ~> entries(m),
  len: m ~> len(keys(m)),
  is_empty: m ~> len(keys(m)) == 0,
  has: (m, k) ~> contains(keys(m), k),
  has_key: (m, k) ~> contains(keys(m), k),
  clone_deep: x ~> x
}
