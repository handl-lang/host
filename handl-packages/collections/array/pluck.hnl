--- Pick the value at `key` from each object element of `xs`.
---
--- For each element, returns `null` if it is not an object or lacks `key`.
---
--- @example
--- `array.pluck([{ name: "a" }, { name: "b" }, 7], "name")`
--- -- => ["a", "b", null]
---
from "./_reflect.hnl" import * as _reflect
from "./reverse.hnl" import * as reverse
from "hash_map" import * as hash_map

export pluck<T>: (List(T), String) ~[Total]~> List(T) := (xs, key) ~> do {
  out :: []
  for x in xs {
    do {
      v :: if _reflect.is_obj(x) { hash_map.get(x, key) } else { null }
      out = [v, ...out]
    }
  }
  reverse.reverse(out)
}
