--- Remove consecutive duplicate elements of `xs`.
---
--- Only adjacent equal elements are collapsed into one.
---
--- @example
--- `array.dedupe([1, 1, 2, 2, 2, 3])`
--- -- => [1, 2, 3]
---
export dedupe :: (xs) ~> do {
  rev :: (ys) ~> do {
    r :: []
    for x in ys {
      r = [x, ...r]
    }
    r
  }
  out :: []
  last :: null
  seen :: false
  for x in xs {
    if seen {
      if x != last {
        out = [x, ...out]
        last = x
      }
    } else {
      out = [x, ...out]
      last = x
      seen = true
    }
  }
  rev(out)
}