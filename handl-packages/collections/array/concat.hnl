--- Concatenate two arrays into one.
---
--- Returns `[...a, ...b]`. The original arrays are unchanged.
---
--- @example
--- `array.concat([1, 2], [3, 4])`
--- -- => [1, 2, 3, 4]
---
from "./reverse.hnl" import * as reverse

export concat<T>: (List(T), List(T)) ~[Total]~> List(T) := (a, b) ~> do {
  r :: []
  for x in a {
    r = [x, ...r]
  }
  for y in b {
    r = [y, ...r]
  }
  reverse.reverse(r)
}
