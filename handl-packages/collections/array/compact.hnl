from "./reverse.hnl" import reverse

--- Remove all `null` elements from `xs`.
---
--- @example
--- `array.compact([1, null, 2, null, 3])`
--- -- => [1, 2, 3]
---
export compact<T>: List(T) ~[Total]~> List(T) := (xs) ~> do {
  out := []
  for x in xs {
    if x != null { out := [x, ...out] }
  }
  reverse(out)
}
