--- Join the elements of `xs` with `sep`.
---
--- Each element that is an array is spread as-is; `sep` is spread between
--- consecutive elements.
---
--- @example
--- `array.intercalate(["a", "b", "c"], "-")`
--- -- => ["a", "-", "b", "-", "c"]
---
from "./_reflect.hnl" import * as _reflect
from "./concat.hnl" import * as concat

export intercalate<T>: (List(T), T) ~[Total]~> List(T) := (xs, sep) ~> do {
  out :: []
  is_first :: true
  for x in xs {
    do {
      hv :: if _reflect.is_arr(x) { x } else { [x] }
      if is_first {
        is_first = false
      } else {
        out = concat.concat(out, sep)
      };
      out = concat.concat(out, hv)
    }
  }
  out
}
