from "./len.hnl" import len
from "./take.hnl" import take
from "./drop.hnl" import drop
from "./concat.hnl" import concat

--- Return a copy of `xs` with `v` inserted at index `i`.
---
--- Returns `null` if `i` is negative. If `i` exceeds the length, `v` is
--- appended to the end.
---
--- @example
--- `array.insert_at([1, 2, 3], 1, 99)`
--- -- => [1, 99, 2, 3]
---
export insert_at<T>: (List(T), Nat, T) ~[Total]~> List(T) := (xs, i, v) ~> do {
  if i < 0 {
    null
  } else {
    do {
      idx := if i > len(xs) { len(xs) } else { i }
      concat(take(xs, idx), [v, ...drop(xs, idx)])
    }
  }
}
