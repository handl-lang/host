--- Return a copy of `xs` with `v` inserted at index `i`.
---
--- Returns `null` if `i` is negative. If `i` exceeds the length, `v` is
--- appended to the end.
---
--- @example
--- `array.insert_at([1, 2, 3], 1, 99)`
--- -- => [1, 99, 2, 3]
---
export insert_at<T>: (List(T), Nat, T) ~[Total]~> List(T) := (xs, i, v) ~> do {
  if i < 0 {
    null
  } else {
    do {
      length :: (ys) ~> do {
        n :: 0
        for x in ys {
          n = n + 1
        }
        n
      }
      rev :: (ys) ~> do {
        r :: []
        for x in ys {
          r = [x, ...r]
        }
        r
      }
      take_ :: (ys, n) ~> do {
        out :: []
        k :: 0
        for x in ys {
          if k < n { out = [x, ...out] };
          k = k + 1
        }
        rev(out)
      }
      drop_ :: (ys, n) ~> do {
        out :: []
        k :: 0
        for x in ys {
          if k >= n { out = [x, ...out] };
          k = k + 1
        }
        rev(out)
      }
      cat :: (a, b) ~> do {
        r :: []
        for x in a {
          r = [x, ...r]
        }
        for y in b {
          r = [y, ...r]
        }
        out :: []
        for w in r {
          out = [w, ...out]
        }
        out
      }
      idx :: if i > length(xs) { length(xs) } else { i }
      cat(take_(xs, idx), [v, ...drop_(xs, idx)])
    }
  }
}