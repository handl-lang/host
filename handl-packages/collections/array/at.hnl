--- Return the element at index `i`.
---
--- Returns `null` if `i` is negative or out of bounds.
---
--- @example
--- `array.at([1, 2, 3], 2)`
--- -- => 3
---
export at<T>: (List(T), Nat) ~[1]~> T := (xs, i) ~> do {
  if i < 0 {
    null
  } else {
    do {
      out := null
      k := 0
      for x in xs {
        do {
          if k == i { out := x };
          k := k + 1
        }
      }
      out
    }
  }
}
