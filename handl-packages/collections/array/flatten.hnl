--- Flatten a single level of nested arrays.
---
--- Each element of `xs` that is itself an array has its elements appended
--- directly; non-array elements are kept as-is.
---
--- @example
--- `array.flatten([[1, 2], 3, [4]])`
--- -- => [1, 2, 3, 4]
---
from "./_reflect.hnl" import * as _reflect
from "./concat.hnl" import * as concat

export flatten<T>: List(T) ~[Total]~> List(T) := (xs) ~> do {
  out :: []
  for x in xs {
    if _reflect.is_arr(x) {
      out = concat.concat(out, x)
    } else {
      out = concat.concat(out, [x])
    }
  }
  out
}
