--- Return an array of `n` copies of `v`.
---
--- Returns `null` if `n` is negative.
---
--- Count-driven (there is no source collection to iterate), so this is the
--- one member that keeps a bounded `while` countdown instead of `for`.
---
--- @example
--- `array.fill(3, 0)`
--- -- => [0, 0, 0]
---
export fill :: (n, v) ~> do {
  if n < 0 {
    null
  } else {
    while { i: n, acc: [] } {
      (st) ~> if st.i <= 0 {
        { out: st.acc }
      } else {
        { state: { i: st.i - 1, acc: [v, ...st.acc] } }
      }
    }
  }
}