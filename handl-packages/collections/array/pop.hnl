--- Return a copy of `xs` without its last element.
---
--- Returns `[]` if `xs` is empty.
---
--- @example
--- `array.pop([1, 2, 3])`
--- -- => [1, 2]
---
from "./len.hnl" import * as len
from "./take.hnl" import * as take

export pop<T>: List(T) ~[Total]~> List(T) := (xs) ~> do {
  match xs {
    []: [],
    [h, ...t]: take.take(xs, len.len(xs) - 1)
  }
}
