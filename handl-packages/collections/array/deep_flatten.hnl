--- Flatten all levels of nesting in `xs`.
---
--- Recursively flattens nested arrays into a single flat array.
---
--- @example
--- `array.deep_flatten([[1, [2]], 3, [[[4]]]])`
--- -- => [1, 2, 3, 4]
---
from "typeof" import * as typeof

export deep_flatten<T>: List(T) ~[Total]~> List(T) := (xs) ~> do {
  is_arr :: (x) ~> typeof.type_of(x) == "arr"
  cat :: (a, b) ~> do {
    r :: []
    for x in a {
      r = [x, ...r]
    }
    for y in b {
      r = [y, ...r]
    }
    out :: []
    for v in r {
      out = [v, ...out]
    }
    out
  }
  go :: (self, ys) ~> do {
    out :: []
    for x in ys {
      if is_arr(x) {
        out = cat(out, self(self, x))
      } else {
        out = cat(out, [x])
      }
    }
    out
  }
  go(go, xs)
}