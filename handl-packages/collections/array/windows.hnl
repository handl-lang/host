--- Return every contiguous sub-array of `size` elements.
---
--- Returns `null` if `size` is less than 1. Returns `[]` if `size` exceeds
--- the array length.
---
--- @example
--- `array.windows([1, 2, 3, 4], 2)`
--- -- => [[1, 2], [2, 3], [3, 4]]
---
export windows :: (xs, size) ~> do {
  if size < 1 {
    null
  } else {
    do {
      length :: (ys) ~> do {
        n :: 0
        for x in ys {
          n = n + 1
        }
        n
      }
      rev :: (ys) ~> do {
        r :: []
        for x in ys {
          r = [x, ...r]
        }
        r
      }
      take_ :: (ys, n) ~> do {
        out :: []
        k :: 0
        for x in ys {
          do {
            if k < n { out = [x, ...out] }
            k = k + 1
          }
        }
        rev(out)
      }
      drop_ :: (ys, n) ~> do {
        out :: []
        k :: 0
        for x in ys {
          do {
            if k >= n { out = [x, ...out] }
            k = k + 1
          }
        }
        rev(out)
      }
      l :: length(xs)
      if size > l {
        []
      } else {
        do {
          out :: []
          start :: 0
          for x in xs {
            do {
              if start + size <= l {
                out = [take_(drop_(xs, start), size), ...out]
              };
              start = start + 1
            }
          }
          rev(out)
        }
      }
    }
  }
}