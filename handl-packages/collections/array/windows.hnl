from "./len.hnl" import len
from "./take.hnl" import take
from "./drop.hnl" import drop
from "./reverse.hnl" import reverse

--- Return every contiguous sub-array of `size` elements.
---
--- Returns `null` if `size` is less than 1. Returns `[]` if `size` exceeds
--- the array length.
---
--- @example
--- `array.windows([1, 2, 3, 4], 2)`
--- -- => [[1, 2], [2, 3], [3, 4]]
---
export windows<T>: (List(T), Nat) ~[1]~> List(List(T)) := (xs, size) ~> do {
  if size < 1 {
    null
  } else {
    do {
      l := len(xs)
      if size > l {
        []
      } else {
        do {
          out := []
          start := 0
          for x in xs {
            do {
              if start + size <= l {
                out := [take(drop(xs, start), size), ...out]
              };
              start := start + 1
            }
          }
          reverse(out)
        }
      }
    }
  }
}
