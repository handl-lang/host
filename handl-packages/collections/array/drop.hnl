--- Return `xs` without its first `n` elements.
---
--- Returns `null` if `n` is negative.
---
--- @example
--- `array.drop([1, 2, 3, 4], 2)`
--- -- => [3, 4]
---
export drop :: (xs, n) ~> do {
  if n < 0 {
    null
  } else {
    do {
      rev :: (ys) ~> do {
        r :: []
        for x in ys {
          r = [x, ...r]
        }
        r
      }
      out :: []
      k :: 0
      for x in xs {
        do {
          if k >= n { out = [x, ...out] };
          k = k + 1
        }
      }
      rev(out)
    }
  }
}