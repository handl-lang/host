--- Return a copy of `xs` with the element at index `i` removed.
---
--- Returns `null` if `i` is negative. Returns `xs` unchanged if `i` is out of
--- bounds.
---
--- @example
--- `array.remove_at([1, 2, 3], 1)`
--- -- => [1, 3]
---
from "./len.hnl" import * as len
from "./take.hnl" import * as take
from "./drop.hnl" import * as drop
from "./concat.hnl" import * as concat

export remove_at<T>: (List(T), Nat) ~[Total]~> List(T) := (xs, i) ~> do {
  if i < 0 {
    null
  } else {
    if i >= len.len(xs) {
      xs
    } else {
      concat.concat(take.take(xs, i), drop.drop(xs, i + 1))
    }
  }
}
