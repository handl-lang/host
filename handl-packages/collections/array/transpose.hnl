--- Transpose a matrix (array of rows) into columns.
---
--- Rows may be shorter than others; missing cells become absent. Returns `[]`
--- when `xs` is empty.
---
--- @example
--- `array.transpose([[1, 2, 3], [4, 5, 6]])`
--- -- => [[1, 4], [2, 5], [3, 6]]
---
from "./_reflect.hnl" import * as _reflect
from "./len.hnl" import * as len
from "./at.hnl" import * as at
from "./reverse.hnl" import * as reverse

export transpose<T>: List(T) ~[Total]~> List(T) := (xs) ~> do {
  if len.len(xs) == 0 {
    []
  } else {
    do {
      rows :: do {
        r :: []
        for h in xs {
          do {
            row :: if _reflect.is_arr(h) { h } else { [h] }
            r = [row, ...r]
          }
        }
        reverse.reverse(r)
      }
      max_cols :: do {
        m :: 0
        for row in rows {
          do {
            rl :: len.len(row);
            if rl > m { m = rl }
          }
        }
        m
      }
      if max_cols == 0 {
        []
      } else {
        do {
          driver :: do {
            pick :: []
            for row in rows {
              if len.len(row) == max_cols { pick = row }
            }
            pick
          }
          cols :: []
          c :: 0
          for pad in driver {
            do {
              col :: do {
                out :: []
                for h in rows {
                  if c < len.len(h) { out = [at.at(h, c), ...out] }
                }
                reverse.reverse(out)
              }
              cols = [col, ...cols]
              c = c + 1
            }
          }
          reverse.reverse(cols)
        }
      }
    }
  }
}
