--- Pair up the elements of two arrays.
---
--- Returns `[[a0, b0], [a1, b1], ...]`. The shorter array determines the length.
---
--- @example
--- `array.zip([1, 2], ["x", "y", "z"])`
--- -- => [[1, "x"], [2, "y"]]
---
from "./len.hnl" import * as len
from "./at.hnl" import * as at
from "./reverse.hnl" import * as reverse

export zip<A,B>: (List(A), List(B)) ~[Total]~> List(Pair(A,B)) := (a, b) ~> do {
  blen :: len.len(b)
  out :: []
  k :: 0
  for x in a {
    if k < blen { out = [[x, at.at(b, k)], ...out] };
    k = k + 1
  }
  reverse.reverse(out)
}
