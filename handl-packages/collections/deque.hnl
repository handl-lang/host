--- deque — pure-handl implementation of the `deque` container ops.
---
--- A double-ended queue is a plain array; `push_back`/`push_front` are
--- expressible directly. `new` and the `pop_*`/`peek_*` ops stay native
--- (see `ops/collections/seq.rs`): `new` is nullary and the pops/peeks
--- must raise `collection is empty` on an empty deque — the language has
--- no error-raising primitive.
do {
  len_ :: xs ~> {
    while { xs: xs, n: 0 } {
      [xs, n] ~> match xs {
        []: { out: n },
        [h, ...t]: { state: { xs: t, n: n + 1 } }
      }
    }
  }

  {
    len: xs ~> len_(xs),
    is_empty: xs ~> match xs {
      []: true,
      [h, ...t]: false
    },
    push_back: [c, v] ~> [...c, v],
    push_front: [c, v] ~> [v, ...c]
  }
}
