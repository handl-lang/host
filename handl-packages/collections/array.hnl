--- array — pure-handl implementation of the `array` functional ops.
---
--- This file is now an **aggregator**: each arrow lives in its own
--- `collections/array/<name>.hnl` file (one arrow per file, `export
--- <name> = ...`, with its own doc comment). This file imports them and
--- assembles the `array.*` record that the runtime exposes.
---
--- The arrow-taking members (`take_while`, `drop_while`, `scan`, `foldr`,
--- `find_index`, `find_last`, `find_last_index`) and the variadic/rest
--- members (`push`, `range`) stay native ops (see `ops::collections`).
---
--- Semantic notes vs. the former Rust ops (invalid-input edge cases):
--- - `slice`/`at`/`take`/`drop`/`fill`/`windows`/`insert_at`/`remove_at`
---   return `null` on negative/non-positive numeric arguments; `chunk`
---   returns `null` on a non-positive size (no error primitive yet).
--- - `at`/`first`/`last` return `null` out-of-bounds / on empty;
---   `pop`/`shift` return `[]` on empty.
---
from "len" import len
from "is_empty" import is_empty
from "reverse" import reverse
from "concat" import concat
from "contains" import contains
from "index_of" import index_of
from "slice" import slice
from "first" import first as first_v
from "last" import last
from "at" import at
from "pop" import pop
from "shift" import shift
from "fill" import fill
from "flatten" import flatten
from "deep_flatten" import deep_flatten
from "take" import take
from "drop" import drop
from "enumerate" import enumerate
from "unzip" import unzip
from "intersperse" import intersperse
from "intercalate" import intercalate
from "dedupe" import dedupe
from "prepend" import prepend
from "windows" import windows
from "transpose" import transpose
from "insert_at" import insert_at
from "remove_at" import remove_at
from "zip" import zip
from "chunk" import chunk
from "compact" import compact
from "pluck" import pluck

{
  len: len,
  is_empty: is_empty,
  reverse: reverse,
  concat: concat,
  contains: contains,
  index_of: index_of,
  slice: slice,
  first: first_v,
  last: last,
  at: at,
  pop: pop,
  shift: shift,
  fill: fill,
  flatten: flatten,
  deep_flatten: deep_flatten,
  take: take,
  drop: drop,
  enumerate: enumerate,
  unzip: unzip,
  intersperse: intersperse,
  intercalate: intercalate,
  dedupe: dedupe,
  prepend: prepend,
  windows: windows,
  transpose: transpose,
  insert_at: insert_at,
  remove_at: remove_at,
  zip: zip,
  chunk: chunk,
  compact: compact,
  pluck: pluck,
}