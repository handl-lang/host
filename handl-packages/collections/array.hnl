--- array — pure-handl implementation of the `array` functional ops.
---
--- This file is now an **aggregator**: each arrow lives in its own
--- `collections/array/<name>.hnl` file (one arrow per file, `export
--- <name> = ...`, with its own doc comment). This file imports them and
--- assembles the `array.*` record that the runtime exposes.
---
--- The arrow-taking members (`take_while`, `drop_while`, `scan`, `foldr`,
--- `find_index`, `find_last`, `find_last_index`) and the variadic/rest
--- members (`push`, `range`) stay native ops (see `ops::collections`).
---
--- Semantic notes vs. the former Rust ops (invalid-input edge cases):
--- - `slice`/`at`/`take`/`drop`/`fill`/`windows`/`insert_at`/`remove_at`
---   return `null` on negative/non-positive numeric arguments; `chunk`
---   returns `null` on a non-positive size (no error primitive yet).
--- - `at`/`first`/`last` return `null` out-of-bounds / on empty;
---   `pop`/`shift` return `[]` on empty.
---
from "len" import * as len
from "is_empty" import * as is_empty
from "reverse" import * as reverse
from "concat" import * as concat
from "contains" import * as contains
from "index_of" import * as index_of
from "slice" import * as slice
from "first" import * as first_value
from "last" import * as last
from "at" import * as at
from "pop" import * as pop
from "shift" import * as shift
from "fill" import * as fill
from "flatten" import * as flatten
from "deep_flatten" import * as deep_flatten
from "take" import * as take
from "drop" import * as drop
from "enumerate" import * as enumerate
from "unzip" import * as unzip
from "intersperse" import * as intersperse
from "intercalate" import * as intercalate
from "dedupe" import * as dedupe
from "prepend" import * as prepend
from "windows" import * as windows
from "transpose" import * as transpose
from "insert_at" import * as insert_at
from "remove_at" import * as remove_at
from "zip" import * as zip
from "chunk" import * as chunk
from "compact" import * as compact
from "pluck" import * as pluck

{
  len: len.len,
  is_empty: is_empty.is_empty,
  reverse: reverse.reverse,
  concat: concat.concat,
  contains: contains.contains,
  index_of: index_of.index_of,
  slice: slice.slice,
  first: first_value.first_value,
  last: last.last,
  at: at.at,
  pop: pop.pop,
  shift: shift.shift,
  fill: fill.fill,
  flatten: flatten.flatten,
  deep_flatten: deep_flatten.deep_flatten,
  take: take.take,
  drop: drop.drop,
  enumerate: enumerate.enumerate,
  unzip: unzip.unzip,
  intersperse: intersperse.intersperse,
  intercalate: intercalate.intercalate,
  dedupe: dedupe.dedupe,
  prepend: prepend.prepend,
  windows: windows.windows,
  transpose: transpose.transpose,
  insert_at: insert_at.insert_at,
  remove_at: remove_at.remove_at,
  zip: zip.zip,
  chunk: chunk.chunk,
  compact: compact.compact,
  pluck: pluck.pluck,
}