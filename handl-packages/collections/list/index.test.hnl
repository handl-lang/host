from "../index" import * as list

test_list_len := assert list.len([1, 2, 3]) = 3

test_list_is_empty := assert list.is_empty([]) = true

test_list_push := assert list.push([2, 3], 1) = [1, 2, 3]

test_list_pop := assert list.pop([1, 2, 3]) = [2, 3]

test_list_peek := assert list.peek([1, 2, 3]) = 1
