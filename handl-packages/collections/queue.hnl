--- queue — pure-handl implementation of the `queue` container ops.
---
--- A FIFO queue is a plain array; `enqueue` appends to the back.
--- `new`/`dequeue`/`peek` stay native ops (see `ops/collections/seq.rs`):
--- `new` is nullary and `dequeue`/`peek` must raise `collection is empty`
--- on an empty queue — the language has no error-raising primitive.
do {
  len_ :: xs ~> {
    while { xs: xs, n: 0 } {
      [xs, n] ~> match xs {
        []: { out: n },
        [h, ...t]: { state: { xs: t, n: n + 1 } }
      }
    }
  }

  {
    len: xs ~> len_(xs),
    is_empty: xs ~> match xs {
      []: true,
      [h, ...t]: false
    },
    enqueue: [c, v] ~> [...c, v]
  }
}
