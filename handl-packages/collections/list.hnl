--- list — pure-handl implementation of the `list` container ops.
---
--- A list is a plain array with front-end operations; `push` prepends
--- and `pop` drops the front. `pop`/`peek` raise `collection is empty`
--- on an empty list via the `error.raise` primitive (the ADR-0092
--- error-raising gap is closed). `new`/`from`/`to_array` stay native
--- (see `ops/collections/seq.rs`): `new` is nullary and `from` is a
--- reserved word (cannot be a record field).
do {
  len_ :: xs ~> {
    while { xs: xs, n: 0 } {
      [xs, n] ~> match xs {
        []: { out: n },
        [h, ...t]: { state: { xs: t, n: n + 1 } }
      }
    }
  }

  {
    len: xs ~> len_(xs),
    is_empty: xs ~> match xs {
      []: true,
      [h, ...t]: false
    },
    push: [c, v] ~> [v, ...c],
    pop: c ~> match c {
      []: error.raise("collection is empty"),
      [h, ...t]: t
    },
    peek: c ~> match c {
      []: error.raise("collection is empty"),
      [h, ...t]: h
    }
  }
}
