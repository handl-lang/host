from "./intl-c" import * as intl_c

test_en_decimal_positive_0 := assert(if intl_c.available {
  tag.untag(intl_c.format_number(1234.56, "en")).value
} else {
  "1,234.56"
}) = "1,234.56"

test_en_decimal_positive_1 := assert(if intl_c.available {
  tag.untag(intl_c.format_number(1000000, "en")).value
} else {
  "1,000,000"
}) = "1,000,000"

test_en_decimal_positive_2 := assert(if intl_c.available {
  tag.untag(intl_c.format_number(0.001, "en")).value
} else {
  "0.001"
}) = "0.001"

test_en_decimal_negative_0 := assert(if intl_c.available {
  tag.untag(intl_c.format_number(-1234.56, "en")).value
} else {
  "-1,234.56"
}) = "-1,234.56"

test_de_decimal_0 := assert(if intl_c.available {
  tag.untag(intl_c.format_number(1234.56, "de")).value
} else {
  "1.234,56"
}) = "1.234,56"

