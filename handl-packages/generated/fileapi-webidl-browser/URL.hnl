from "js" import { call, error }
from "result" import { ok, err }
from "../fileapi/URL" import { URL, URLCreateObjectURL, URLRevokeObjectURL }

export u_r_l_create_object_u_r_l: URLCreateObjectURL := (obj) ~> do {
  r = call("FileAPI", "createObjectURL", [obj], ["js_object"], "js_string", false)
  e = error()
  if e == null {
    ok(r)
  } else {
    err(e)
  }
}

export u_r_l_revoke_object_u_r_l: URLRevokeObjectURL := (url) ~> do {
  r = call("FileAPI", "revokeObjectURL", [url], ["js_string"], "js_void", false)
  e = error()
  if e == null {
    ok(r)
  } else {
    err(e)
  }
}
