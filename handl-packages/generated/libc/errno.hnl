--- Generated port for libc.errno
--- ffi target: x86_64-unknown-linux-gnu

from "ffi" import { Errno }
from "result" import { Result }

--- Interrupted system call
export EINTR: Int
--- Bad file number
export EBADF: Int
--- Try again
export EAGAIN: Int
--- Broken pipe
export EPIPE: Int
--- Operation would block
export EWOULDBLOCK: Int
--- Cannot assign requested address
export EADDRNOTAVAIL: Int
--- Software caused connection abort
export ECONNABORTED: Int
--- Connection reset by peer
export ECONNRESET: Int
--- Transport endpoint is not connected
export ENOTCONN: Int
--- Connection refused
export ECONNREFUSED: Int
--- Operation now in progress
export EINPROGRESS: Int
