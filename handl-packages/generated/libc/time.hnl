--- Generated port for libc.time
--- ffi target: x86_64-unknown-linux-gnu

from "ffi" import { Errno }
from "result" import { Result }
from "types/c/time" import { ClockId, Time }

export timespec := {
  tv_sec: Int,
  tv_nsec: Int
}

--- Identifier for system-wide realtime clock.
export CLOCK_REALTIME: Int
--- Monotonic system-wide clock.
export CLOCK_MONOTONIC: Int

--- Time used by the program so far (user time + system time).
--- The result / CLOCKS_PER_SEC is program time in seconds.
--- ffi: clock_t (void)
export Clock: () ~[1]~> Result<Int, Errno>

--- Return the current time and put it in *TIMER if TIMER is not NULL.
export TimeResult := {
  ret: Int,
  buf: Bytes,
  outs: [Bytes]
}

--- ffi:
export Time: () ~[1]~> Result<TimeResult, Errno>

--- Return the difference between TIME1 and TIME0.
--- ffi: double (time_t, time_t)
export Difftime: (Time, Time) ~[1]~> Result<Float, Errno>

--- Pause execution for a number of nanoseconds.
--- This function is a cancellation point and therefore not marked with
--- __THROW.
export NanosleepResult := {
  ret: Int,
  buf: timespec
}

--- ffi: int (const struct timespec *, struct timespec *)
export Nanosleep: (timespec) ~[1]~> Result<NanosleepResult, Errno>

--- Get resolution of clock CLOCK_ID.
export ClockGetresResult := {
  ret: Int,
  buf: timespec
}

--- ffi: int (clockid_t, struct timespec *)
export ClockGetres: (ClockId) ~[1]~> Result<ClockGetresResult, Errno>

--- Get current value of clock CLOCK_ID and store it in TP.
export ClockGettimeResult := {
  ret: Int,
  buf: timespec
}

--- ffi: int (clockid_t, struct timespec *)
export ClockGettime: (ClockId) ~[1]~> Result<ClockGettimeResult, Errno>

--- Set clock CLOCK_ID to value TP.
--- ffi: int (clockid_t, const struct timespec *)
export ClockSettime: (ClockId, timespec) ~[1]~> Result<Int, Errno>
