--- Create a new socket of type TYPE in domain DOMAIN, using
--- protocol PROTOCOL.  If PROTOCOL is zero, one is chosen automatically.
--- Returns a file descriptor for the new socket, or -1 for errors.
--- ffi: int (int, int, int)
export Socket: (Int, Int, Int) ~[1]~> Result<Int, Errno>

--- Create two new sockets, of type TYPE in domain DOMAIN and using
--- protocol PROTOCOL, which are connected to each other, and put file
--- descriptors for them in FDS[0] and FDS[1].  If PROTOCOL is zero,
--- one will be chosen automatically.  Returns 0 on success, -1 for errors.
export SocketpairResult := {
  ret: Int,
  buf: Bytes,
  outs: List<Bytes>
}

--- ffi:
export Socketpair: (Int, Int, Int) ~[1]~> Result<SocketpairResult, Errno>

--- Give the socket FD the local address ADDR (which is LEN bytes long).
--- ffi:
export Bind: (Int, Bytes) ~[1]~> Result<Int, Errno>

--- Put the local address of FD into *ADDR and its length in *LEN.
export GetsocknameResult := {
  ret: Int,
  buf: Bytes,
  outs: List<Bytes>
}

--- ffi:
export Getsockname: (Int) ~[1]~> Result<GetsocknameResult, Errno>

--- Open a connection on socket FD to peer at ADDR (which LEN bytes long).
--- For connectionless socket types, just set the default address to send to
--- and the only address from which to accept transmissions.
--- Return 0 on success, -1 for errors.
--- This function is a cancellation point and therefore not marked with
--- __THROW.
--- ffi:
export Connect: (Int, Bytes) ~[1]~> Result<Int, Errno>

--- Put the address of the peer connected to socket FD into *ADDR
--- (which is *LEN bytes long), and its actual length into *LEN.
export GetpeernameResult := {
  ret: Int,
  buf: Bytes,
  outs: List<Bytes>
}

--- ffi:
export Getpeername: (Int) ~[1]~> Result<GetpeernameResult, Errno>

--- Send N bytes of BUF to socket FD.  Returns the number sent or -1.
--- This function is a cancellation point and therefore not marked with
--- __THROW.
--- ffi: ssize_t (int, const void *, size_t, int)
export Send: (Int, Bytes, Int) ~[1]~> Result<SSize, Errno>

--- Read N bytes into BUF from socket FD.
--- Returns the number read or -1 for errors.
--- This function is a cancellation point and therefore not marked with
--- __THROW.
--- ffi: ssize_t (int, void *, size_t, int)
export Recv: (Int, Int) ~[1]~> Result<Bytes, Errno>

--- Read N bytes into BUF through socket FD.
--- If ADDR is not NULL, fill in *ADDR_LEN bytes of it with the address of
--- the sender, and store the actual size of the address in *ADDR_LEN.
--- Returns the number of bytes read or -1 for errors.
--- This function is a cancellation point and therefore not marked with
--- __THROW.
export RecvfromResult := {
  ret: Int,
  buf: Bytes,
  outs: List<Bytes>
}

--- ffi:
export Recvfrom: (Int, Int) ~[1]~> Result<RecvfromResult, Errno>

--- send a message on a socket
export SendmsgMsg := {
  msg_name: Bytes,
  msg_namelen: Nat,
  msg_iov: List<Bytes>,
  msg_iovlen: Nat,
  msg_control: Bytes,
  msg_controllen: Nat,
  msg_flags: Int
}

--- ffi: ssize_t (int, const struct msghdr *, int)
export Sendmsg: (Int, SendmsgMsg, Int) ~[1]~> Result<SSize, Errno>

--- receive a message from a socket
export RecvmsgResult := {
  ret: Int,
  buf: RecvmsgMsg
}

export RecvmsgMsg := {
  msg_name: Bytes,
  msg_namelen: Nat,
  msg_iov: List<Bytes>,
  msg_iovlen: Nat,
  msg_control: Bytes,
  msg_controllen: Nat,
  msg_flags: Int
}

--- ffi: ssize_t (int, struct msghdr *, int)
export Recvmsg: (Int, Int) ~[1]~> Result<RecvmsgResult, Errno>

--- get and set options on sockets
export GetsockoptResult := {
  ret: Int,
  buf: Bytes,
  outs: List<Bytes>
}

--- ffi:
export Getsockopt: (Int, Int, Int) ~[1]~> Result<GetsockoptResult, Errno>

--- get and set options on sockets
--- ffi: int (int, int, int, const void *, socklen_t)
export Setsockopt: (Int, Int, Int, Bytes) ~[1]~> Result<Int, Errno>

--- Prepare to accept connections on socket FD.
--- N connection requests will be queued before further requests are refused.
--- Returns 0 on success, -1 for errors.
--- ffi: int (int, int)
export Listen: (Int, Int) ~[1]~> Result<Int, Errno>

--- Await a connection on socket FD.
--- When a connection arrives, open a new socket to communicate with it,
--- set *ADDR (which is *ADDR_LEN bytes long) to the address of the connecting
--- peer and *ADDR_LEN to the address's actual length, and return the
--- new socket's descriptor, or -1 for errors.
--- This function is a cancellation point and therefore not marked with
--- __THROW.
export AcceptResult := {
  ret: Int,
  buf: Bytes,
  outs: List<Bytes>
}

--- ffi:
export Accept: (Int) ~[1]~> Result<AcceptResult, Errno>

--- Similar to 'accept' but takes an additional parameter to specify flags.
--- This function is a cancellation point and therefore not marked with
--- __THROW.
export Accept4Result := {
  ret: Int,
  buf: Bytes,
  outs: List<Bytes>
}

--- ffi:
export Accept4: (Int, Int) ~[1]~> Result<Accept4Result, Errno>

--- Shut down all or part of the connection open on socket FD.
--- HOW determines what to shut down:
--- SHUT_RD   = No more receptions;
--- SHUT_WR   = No more transmissions;
--- SHUT_RDWR = No more receptions or transmissions.
--- Returns 0 on success, -1 for errors.
--- ffi: int (int, int)
export Shutdown: (Int, Int) ~[1]~> Result<Int, Errno>

--- Determine whether socket is at a out-of-band mark.
--- ffi: int (int)
export Sockatmark: (Int) ~[1]~> Result<Int, Errno>

--- FDTYPE is S_IFSOCK or another S_IF* macro defined in <sys/stat.h>;
--- returns 1 if FD is open on an object of the indicated type, 0 if not,
--- or -1 for errors (setting errno).
--- ffi: int (int, int)
export Isfdtype: (Int, Int) ~[1]~> Result<Int, Errno>
