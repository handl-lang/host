--- Generated port for libc.fcntl
--- ffi target: x86_64-unknown-linux-gnu

from "ffi" import { Errno }
from "result" import { Result }

export O_NONBLOCK: Int
--- Set close_on_exec.
export O_CLOEXEC: Int
--- Get file descriptor flags.
export F_GETFD: Int
--- Set file descriptor flags.
export F_SETFD: Int
--- Get file status flags.
export F_GETFL: Int
--- Set file status flags.
export F_SETFL: Int
--- Actually anything with low bit set goes
export FD_CLOEXEC: Int

--- manipulate file descriptor
--- ffi: int (int, int, ...)
export Fcntl: (Int, Int, Int) ~[1]~> Result<Int, Errno>
