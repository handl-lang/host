--- Generated port for libc.epoll
--- ffi target: x86_64-unknown-linux-gnu

from "ffi" import { Errno }
from "result" import { Result }

export EPOLL_CLOEXEC: Int
export EPOLLIN: Int
export EPOLLPRI: Int
export EPOLLOUT: Int
export EPOLLERR: Int
export EPOLLHUP: Int
export EPOLLRDHUP: Int
export EPOLLONESHOT: Int
export EPOLLET: Int
--- Add a file descriptor to the interface.
export EPOLL_CTL_ADD: Int
--- Remove a file descriptor from the interface.
export EPOLL_CTL_DEL: Int
--- Change file descriptor epoll_event structure.
export EPOLL_CTL_MOD: Int

--- Same as epoll_create but with an FLAGS parameter.  The unused SIZE
--- parameter has been dropped.
--- ffi: int (int)
export EpollCreate1: (Int) ~[1]~> Result<Int, Errno>

--- Manipulate an epoll instance "epfd". Returns 0 in case of success,
--- -1 in case of error ( the "errno" variable will contain the
--- specific error code ) The "op" parameter is one of the EPOLL_CTL_*
--- constants defined above. The "fd" parameter is the target of the
--- operation. The "event" parameter describes which events the caller
--- is interested in and any associated user data.
export EpollCtlMsg := {
  events: Nat,
  data: Nat
}

--- ffi: int (int, int, int, struct epoll_event *)
export EpollCtl: (Int, Int, Int, EpollCtlMsg) ~[1]~> Result<Int, Errno>

--- Wait for events on an epoll instance "epfd". Returns the number of
--- triggered events returned in "events" buffer. Or -1 in case of
--- error with the "errno" variable set to the specific error code. The
--- "events" parameter is a buffer that will contain triggered
--- events. The "maxevents" is the maximum number of events to be
--- returned ( usually size of "events" ). The "timeout" parameter
--- specifies the maximum wait time in milliseconds (-1 == infinite).
--- This function is a cancellation point and therefore not marked with
--- __THROW.
export EpollWaitResult := {
  ret: Int,
  buf: Bytes,
  outs: List<Bytes>
}

--- ffi: int (int, struct epoll_event *, int, int)
export EpollWait: (Int, Int, Int) ~[1]~> Result<EpollWaitResult, Errno>
