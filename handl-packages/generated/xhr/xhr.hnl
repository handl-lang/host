--- Generated port for xhr.xhr
--- js target: browser
--- source: https://raw.githubusercontent.com/w3c/webref/19e2457df856a43ec749c0fd4e88ae1edc4f6cb8/ed/idl/xhr.idl

from "js" import { JsError }
from "result" import { Result }

--- The FormData interface provides a way to construct a set of key/value pairs representing form fields and their values, which can be sent using the fetch(), XMLHttpRequest.send() or navigator.sendBeacon() methods. It uses the same format a form would use if the encoding type were set to "multipart/form-data".
export FormData := {
}

--- The ProgressEvent interface represents events that measure the progress of an underlying process, like an HTTP request (e.g., an XMLHttpRequest, or the loading of the underlying resource of an <img>, <audio>, <video>, <style> or <link>).
export ProgressEvent := {
  --- The
  --- ProgressEvent.lengthComputable read-only property is a
  --- boolean flag indicating if the resource concerned by the
  --- ProgressEvent has a length that can be calculated. If not, the
  --- ProgressEvent.total property has no significant value.
  lengthComputable: Bool,
  --- The ProgressEvent.loaded read-only property is a number indicating the size of the data already transmitted or processed.
  --- The progress ratio can be calculated by dividing the value of this property by ProgressEvent.total.
  loaded: Float,
  --- The ProgressEvent.total read-only property is a number indicating the total size of the data being transmitted or processed.
  total: Float
}

export ProgressEventInit := {
  lengthComputable: Bool,
  loaded: Float,
  total: Float
}

--- XMLHttpRequest (XHR) objects are used to interact with servers. You can retrieve data from a URL without having to do a full page refresh. This enables a Web page to update just part of a page without disrupting what the user is doing.
export XMLHttpRequest := {
  --- event handler
  onreadystatechange: Handle,
  --- The XMLHttpRequest.readyState property returns the state an XMLHttpRequest client is in. An XHR client exists in one of the following states:
  readyState: Nat,
  --- The XMLHttpRequest.timeout property is an unsigned long representing the number of milliseconds a request can take before automatically being terminated. The default value is 0, which means there is no timeout. Timeout shouldn't be used for synchronous XMLHttpRequests requests used in a document environment or it will throw an InvalidAccessError exception. When a timeout happens, a timeout event is fired.
  timeout: Nat,
  --- The XMLHttpRequest.withCredentials property is a boolean value that indicates whether or not cross-site Access-Control requests should be made using credentials such as cookies, authentication headers or TLS client certificates. Setting withCredentials has no effect on same-origin requests.
  withCredentials: Bool,
  --- The XMLHttpRequest upload property returns an XMLHttpRequestUpload object that can be observed to monitor an upload's progress.
  upload: Handle,
  --- response
  responseURL: String,
  --- The read-only XMLHttpRequest.status property returns the numerical HTTP status code of the XMLHttpRequest's response.
  status: Nat,
  --- The read-only XMLHttpRequest.statusText property returns a string containing the response's status message as returned by the HTTP server. Unlike XMLHttpRequest.status which indicates a numerical status code, this property contains the text of the response status, such as "OK" or "Not Found". If the request's readyState is in UNSENT or OPENED state, the value of statusText will be an empty string.
  statusText: String,
  --- The XMLHttpRequest property
  --- responseType is an enumerated string value specifying
  --- the type of data contained in the response.
  responseType: Handle,
  --- The XMLHttpRequest
  --- response property returns the response's body content as
  --- an ArrayBuffer, a Blob, a Document,
  --- a JavaScript Object, or a string, depending on the value
  --- of the request's responseType
  --- property.
  response: Handle,
  --- The read-only XMLHttpRequest property
  --- responseText returns the text received from a server
  --- following a request being sent.
  responseText: String,
  --- The XMLHttpRequest.responseXML read-only property returns
  --- a Document containing the HTML or XML retrieved by the request; or
  --- null if the request was unsuccessful, has not yet been sent, or if the data
  --- can't be parsed as XML or HTML.
  responseXML: Handle
}

--- XMLHttpRequestEventTarget is the interface that describes the event handlers shared on XMLHttpRequest and XMLHttpRequestUpload.
export XMLHttpRequestEventTarget := {
  --- event handlers
  onloadstart: Handle,
  --- The progress event is fired periodically when a request receives more data.
  onprogress: Handle,
  --- The abort event is fired when a request has been aborted, for example because the program called XMLHttpRequest.abort().
  onabort: Handle,
  --- The error event is fired when the request encountered an error.
  onerror: Handle,
  --- The load event is fired when an XMLHttpRequest transaction completes successfully.
  onload: Handle,
  ontimeout: Handle,
  onloadend: Handle
}

--- The XMLHttpRequestUpload interface represents the upload process for a specific XMLHttpRequest. It is an opaque object that represents the underlying, browser-dependent, upload process. It is an XMLHttpRequestEventTarget and can be obtained by calling XMLHttpRequest.upload.
export XMLHttpRequestUpload := {
}

export FormDataEntryValue := Handle

export XMLHttpRequestResponseType_: Int
export XMLHttpRequestResponseType_Arraybuffer: Int
export XMLHttpRequestResponseType_Blob: Int
export XMLHttpRequestResponseType_Document: Int
export XMLHttpRequestResponseType_Json: Int
export XMLHttpRequestResponseType_Text: Int

--- The append() method of the FormData interface appends a new value onto an existing key inside a FormData object, or adds the key if it does not already exist.
--- js: FormData.append
export FormDataAppend: (String, Handle, String) ~[1]~> Result<(), JsError>

--- The FormData() constructor creates a new FormData object.
--- js: FormData.constructor
export FormDataConstructor: (Handle, Handle) ~[1]~> Result<(), JsError>

--- The delete() method of the FormData interface deletes a key and its value(s) from a FormData object.
--- js: FormData.delete
export FormDataDelete: (String) ~[1]~> Result<(), JsError>

--- The get() method of the FormData interface
--- returns the first value associated with a given key from within a FormData
--- object. If you expect multiple values and want all of them, use the
--- getAll() method instead.
--- js: FormData.get
export FormDataGet: (String) ~[1]~> Result<Handle, JsError>

--- The getAll() method of the FormData interface returns all the values associated with a given key from within a FormData object.
--- js: FormData.getAll
export FormDataGetAll: (String) ~[1]~> Result<Handle, JsError>

--- The has() method of the FormData interface returns whether a FormData object contains a certain key.
--- js: FormData.has
export FormDataHas: (String) ~[1]~> Result<Bool, JsError>

--- The set() method of the FormData interface sets a new value for an existing key inside a FormData object, or adds the key/value if it does not already exist.
--- js: FormData.set
export FormDataSet: (String, Handle, String) ~[1]~> Result<(), JsError>

--- The ProgressEvent() constructor returns a new ProgressEvent object, representing the current completion of a long process.
--- js: ProgressEvent.constructor
export ProgressEventConstructor: (String, Handle) ~[1]~> Result<(), JsError>

--- The XMLHttpRequest.abort() method aborts the request if
--- it has already been sent. When a request is aborted, its
--- readyState is changed to
--- XMLHttpRequest.UNSENT (0) and the request's
--- status code is set to 0.
--- js: XMLHttpRequest.abort
export XMLHttpRequestAbort: () ~[1]~> Result<(), JsError>

--- The XMLHttpRequest() constructor
--- creates a new XMLHttpRequest.
--- js: XMLHttpRequest.constructor
export XMLHttpRequestConstructor: () ~[1]~> Result<(), JsError>

--- The XMLHttpRequest method
--- getAllResponseHeaders() returns all the response
--- headers, separated by CRLF, as a string, or returns null
--- if no response has been received.
--- js: XMLHttpRequest.getAllResponseHeaders
export XMLHttpRequestGetAllResponseHeaders: () ~[1]~> Result<String, JsError>

--- The XMLHttpRequest method
--- getResponseHeader() returns the string containing the
--- text of a particular header's value.
--- js: XMLHttpRequest.getResponseHeader
export XMLHttpRequestGetResponseHeader: (String) ~[1]~> Result<Handle, JsError>

--- The XMLHttpRequest method open()
--- initializes a newly-created request, or re-initializes an existing one.
--- js: XMLHttpRequest.open
export XMLHttpRequestOpen: (String, String, Bool, Handle, Handle) ~[1]~> Result<(), JsError>

--- The XMLHttpRequest method
--- overrideMimeType() specifies a MIME type other than the
--- one provided by the server to be used instead when interpreting the data being
--- transferred in a request.
--- js: XMLHttpRequest.overrideMimeType
export XMLHttpRequestOverrideMimeType: (String) ~[1]~> Result<(), JsError>

--- The XMLHttpRequest method
--- send() sends the request to the server.
--- js: XMLHttpRequest.send
export XMLHttpRequestSend: (Handle) ~[1]~> Result<(), JsError>

--- The XMLHttpRequest method setRequestHeader() sets the value of an HTTP request header.
--- When using setRequestHeader(), you must call it after calling open(), but before calling send().
--- If this method is called several times with the same header, the values are merged into one single request header.
--- js: XMLHttpRequest.setRequestHeader
export XMLHttpRequestSetRequestHeader: (String, String) ~[1]~> Result<(), JsError>
