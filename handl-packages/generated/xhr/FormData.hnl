--- The FormData interface provides a way to construct a set of key/value pairs representing form fields and their values, which can be sent using the fetch(), XMLHttpRequest.send() or navigator.sendBeacon() methods. It uses the same format a form would use if the encoding type were set to "multipart/form-data".
export FormData := {
}

--- The append() method of the FormData interface appends a new value onto an existing key inside a FormData object, or adds the key if it does not already exist.
--- js: FormData.append
export FormDataAppend: (String, Handle, String) ~[1]~> Result<(), JsError>

--- The FormData() constructor creates a new FormData object.
--- js: FormData.constructor
export FormDataConstructor: (Handle, Handle) ~[1]~> Result<(), JsError>

--- The delete() method of the FormData interface deletes a key and its value(s) from a FormData object.
--- js: FormData.delete
export FormDataDelete: (String) ~[1]~> Result<(), JsError>

--- The get() method of the FormData interface
--- returns the first value associated with a given key from within a FormData
--- object. If you expect multiple values and want all of them, use the
--- getAll() method instead.
--- js: FormData.get
export FormDataGet: (String) ~[1]~> Result<Handle, JsError>

--- The getAll() method of the FormData interface returns all the values associated with a given key from within a FormData object.
--- js: FormData.getAll
export FormDataGetAll: (String) ~[1]~> Result<Handle, JsError>

--- The has() method of the FormData interface returns whether a FormData object contains a certain key.
--- js: FormData.has
export FormDataHas: (String) ~[1]~> Result<Bool, JsError>

--- The set() method of the FormData interface sets a new value for an existing key inside a FormData object, or adds the key/value if it does not already exist.
--- js: FormData.set
export FormDataSet: (String, Handle, String) ~[1]~> Result<(), JsError>
