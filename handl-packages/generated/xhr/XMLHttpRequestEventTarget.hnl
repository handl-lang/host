--- Generated port for xhr.XMLHttpRequestEventTarget
--- js target: browser
--- source: https://raw.githubusercontent.com/w3c/webref/19e2457df856a43ec749c0fd4e88ae1edc4f6cb8/ed/idl/xhr.idl

from "js" import { JsError }
from "result" import { Result }

--- XMLHttpRequestEventTarget is the interface that describes the event handlers shared on XMLHttpRequest and XMLHttpRequestUpload.
export XMLHttpRequestEventTarget := {
  --- event handlers
  onloadstart: Handle,
  --- The progress event is fired periodically when a request receives more data.
  onprogress: Handle,
  --- The abort event is fired when a request has been aborted, for example because the program called XMLHttpRequest.abort().
  onabort: Handle,
  --- The error event is fired when the request encountered an error.
  onerror: Handle,
  --- The load event is fired when an XMLHttpRequest transaction completes successfully.
  onload: Handle,
  ontimeout: Handle,
  onloadend: Handle
}
