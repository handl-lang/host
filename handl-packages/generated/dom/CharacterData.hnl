--- The insertData() method of the CharacterData interface
--- inserts the provided data into this CharacterData node's current data,
--- at the provided offset from the start of the existing data.
--- The provided data is spliced into the existing data.
--- js: CharacterData.insertData
export CharacterDataInsertData: (Nat, String) ~[1]~> Result<(), JsError>

--- The remove() method of the CharacterData removes it from its parent node.
--- If it has no parent node, calling remove() does nothing.
--- js: CharacterData.remove
export CharacterDataRemove: () ~[1]~> Result<(), JsError>

--- The replaceData() method of the CharacterData interface removes a certain number of characters of the existing text in a given CharacterData node and replaces those characters with the text provided.
--- js: CharacterData.replaceData
export CharacterDataReplaceData: (Nat, Nat, String) ~[1]~> Result<(), JsError>

--- The replaceWith() method of the CharacterData interface
--- replaces this node in the children list of its parent
