--- Generated port for dom.dom
--- js target: browser
--- source: https://raw.githubusercontent.com/w3c/webref/19e2457df856a43ec749c0fd4e88ae1edc4f6cb8/ed/idl/dom.idl

from "js" import { JsError }
from "result" import { Result }

--- The AbortController interface represents a controller object that allows you to abort one or more Web requests as and when desired.
export AbortController := {
  --- The signal read-only property of the AbortController interface returns an AbortSignal object instance, which can be used to communicate with/abort an asynchronous operation as desired.
  signal: Handle
}

--- The AbortSignal interface represents a signal object that allows you to communicate with an asynchronous operation (such as a fetch request) and abort it if required via an AbortController object.
export AbortSignal := {
  --- The aborted read-only property returns a value that indicates whether the asynchronous operations the signal is communicating with are aborted (true) or not (false).
  aborted: Bool,
  --- The reason read-only property returns a JavaScript value that indicates the abort reason.
  reason: Handle,
  --- The abort event of the AbortSignal is fired when the associated request is aborted, i.e., using AbortController.abort().
  onabort: Handle
}

--- The AbstractRange abstract interface is the base class upon which all DOM range types are defined. A range is an object that indicates the start and end points of a section of content within the document.
export AbstractRange := {
  --- The read-only startContainer property of the AbstractRange interface returns the Node in which the start of the range is located.
  startContainer: Handle,
  --- The read-only startOffset property of the AbstractRange interface returns the offset into the start node of the range's start position.
  startOffset: Nat,
  --- The read-only endContainer property of the AbstractRange interface returns the Node in which the end of the range is located.
  endContainer: Handle,
  --- The endOffset property of the AbstractRange interface returns the offset into the end node of the range's end position.
  endOffset: Nat,
  --- The read-only collapsed property of the AbstractRange interface returns true if the range's start position and end position are the same.
  collapsed: Bool
}

export AddEventListenerOptions := {
  passive: Bool,
  once: Bool,
  signal: Handle
}

--- The Attr interface represents one of an element's attributes as an object. In most situations, you will directly retrieve the attribute value as a string (e.g., Element.getAttribute()), but some cases may require interacting with Attr instances (e.g., Element.getAttributeNode()).
export Attr := {
  --- The read-only namespaceURI property of the Attr interface returns the namespace URI of the attribute,
  --- or null if the element is not in a namespace.
  namespaceURI: Handle,
  --- The read-only prefix property of the Attr returns the namespace prefix of the attribute, or null if no prefix is specified.
  prefix: Handle,
  --- The read-only localName property of the Attr interface returns the local part of the qualified name of an attribute, that is the name of the attribute, stripped from any namespace in front of it. For example, if the qualified name is xml:lang, the returned local name is lang, if the element supports that namespace.
  localName: String,
  --- The read-only name property of the Attr interface returns the qualified name of an attribute, that is the name of the attribute, with the namespace prefix, if any, in front of it. For example, if the local name is lang and the namespace prefix is xml, the returned qualified name is xml:lang.
  name: String,
  --- The value property of the Attr interface contains the value of the attribute.
  value: String,
  --- The read-only ownerElement property of the Attr interface returns the Element the attribute belongs to.
  ownerElement: Handle,
  --- historical; always returns true
  specified: Bool
}

--- The CDATASection interface represents a CDATA section
--- that can be used within XML to include extended portions of unescaped text.
--- When inside a CDATA section, the symbols < and & don't need escaping
--- as they normally do.
export CDATASection := {
}

--- The CharacterData abstract interface represents a Node object that contains characters. This is an abstract interface, meaning there aren't any objects of type CharacterData: it is implemented by other interfaces like Text, Comment, CDATASection, or ProcessingInstruction, which aren't abstract.
export CharacterData := {
  --- The data property of the CharacterData interface represents the value of the current object's data.
  data: String,
  --- The read-only CharacterData.length property
  --- returns the number of characters in the contained data, as a positive integer.
  length: Nat
}

export ChildNode := {
}

--- The Comment interface represents textual notations within markup; although it is generally not visually shown, such comments are available to be read in the source view.
export Comment := {
}

--- The CustomEvent interface can be used to attach custom data to an event generated by an application.
export CustomEvent := {
  --- The read-only detail property of the CustomEvent interface returns any data passed when initializing the event.
  detail: Handle
}

export CustomEventInit := {
  detail: Handle
}

--- The DOMImplementation interface represents an object providing methods which are not dependent on any particular document. Such an object is returned by the Document.implementation property.
export DOMImplementation := {
}

--- The DOMTokenList interface represents a set of space-separated tokens. Such a set is returned by Element.classList or HTMLLinkElement.relList, and many others.
export DOMTokenList := {
  --- The read-only length property of the DOMTokenList interface is an integer representing the number
  --- of objects stored in the object.
  length: Nat,
  --- The value property of the DOMTokenList
  --- interface is a stringifier that returns the value of the list serialized as a
  --- string, or clears and sets the list to the given value.
  value: String
}

--- The Document interface represents any web page loaded in the browser and serves as an entry point into the web page's content, which is the DOM tree.
export Document := {
  --- The Document.implementation property returns a
  --- DOMImplementation object associated with the current document.
  implementation: Handle,
  --- The URL read-only property of the Document
  --- interface returns the document location as a string.
  URL: String,
  --- The documentURI read-only property of the
  --- Document interface returns the document location as a string.
  documentURI: String,
  --- The Document.compatMode read-only property indicates
  --- whether the document is rendered in Quirks mode or
  --- Standards mode.
  compatMode: String,
  --- The Document.characterSet
  --- read-only property returns the character encoding of the
  --- document that it's currently rendered with.
  characterSet: String,
  --- legacy alias of .characterSet
  charset: String,
  --- legacy alias of .characterSet
  inputEncoding: String,
  --- The Document.contentType read-only property returns the
  --- MIME type that the document is being rendered as. This may come from HTTP headers or
  --- other sources of MIME information, and might be affected by automatic type conversions
  --- performed by either the browser or extensions.
  contentType: String,
  --- The doctype read-only property of the Document interface is a DocumentType object representing the Document Type Declaration (DTD) associated with the current document.
  doctype: Handle,
  --- The documentElement read-only property of the Document interface returns the
  --- Element that is the root element of the document (for
  --- example, the <html> element for HTML documents).
  documentElement: Handle
}

--- The DocumentFragment interface represents a minimal document object that has no parent.
export DocumentFragment := {
}

export DocumentOrShadowRoot := {
  customElementRegistry: Handle
}

--- The DocumentType interface represents a Node containing a doctype.
export DocumentType := {
  --- The read-only name property of the DocumentType returns the type of the document.
  name: String,
  --- The read-only publicId property of the DocumentType returns a formal identifier of the document.
  publicId: String,
  --- The read-only systemId property of the DocumentType returns the URL of the associated DTD.
  systemId: String
}

--- Element is the most general base class from which all element objects (i.e., objects that represent elements) in a Document inherit. It only has methods and properties common to all kinds of elements. More specific classes inherit from Element.
export Element := {
  --- The Element.namespaceURI read-only property returns the namespace URI of the element, or null if the element is not in a namespace.
  namespaceURI: Handle,
  --- The Element.prefix read-only property returns the
  --- namespace prefix of the specified element, or null if no prefix is
  --- specified.
  prefix: Handle,
  --- The Element.localName read-only property returns the
  --- local part of the qualified name of an element.
  localName: String,
  --- The tagName read-only property
  --- of the Element interface returns the tag name of the element on which
  --- it's called.
  tagName: String,
  --- The id property of the Element interface reflects the element's id content attribute.
  id: String,
  --- The className property of the Element interface reflects the element's class content attribute.
  className: String,
  --- The read-only classList property of the Element interface contains a live DOMTokenList collection representing the class attribute of the element. This can then be used to manipulate the class list.
  classList: Handle,
  --- The slot property of the Element interface returns the name of the shadow DOM slot the element is inserted in. It reflects the element's slot content attribute.
  slot: String,
  --- The Element.attributes property returns a live collection
  --- of all attribute nodes registered to the specified node. It is a
  --- NamedNodeMap, not an Array, so it has no Array
  --- methods and the Attr nodes' indexes may differ among browsers. To be more
  --- specific, attributes is a key/value pair of strings that represents any
  --- information regarding that attribute.
  attributes: Handle,
  --- The Element.shadowRoot read-only property
  --- represents the shadow root hosted by the element.
  shadowRoot: Handle,
  --- The customElementRegistry read-only property of the Element interface returns the CustomElementRegistry object associated with this element, or null if one has not been set.
  customElementRegistry: Handle
}

export ElementCreationOptions := {
  customElementRegistry: Handle,
  is: String
}

--- The Event interface represents an event which takes place on an EventTarget.
export Event := {
  --- The type read-only property of the Event
  --- interface returns a string containing the event's type. It is set when the event is
  --- constructed and is the name commonly used to refer to the specific event, such as
  --- click, load, or error.
  type: String,
  --- The read-only target property of the
  --- Event interface is a reference to the object onto which the event was
  --- dispatched. It is different from Event.currentTarget when the event
  --- handler is called during the bubbling or capturing phase of the event.
  target: Handle,
  --- legacy
  srcElement: Handle,
  --- The currentTarget read-only property of the Event interface identifies the element to which the event handler has been attached.
  currentTarget: Handle,
  --- The eventPhase read-only property of the
  --- Event interface indicates which phase of the event flow is currently
  --- being evaluated.
  eventPhase: Nat,
  --- legacy alias of .stopPropagation()
  cancelBubble: Bool,
  --- The bubbles read-only property of the Event interface indicates whether the event bubbles up through the DOM tree or not.
  bubbles: Bool,
  --- The cancelable read-only property of the Event interface indicates whether the event
  --- can be canceled, and therefore prevented as if the event never happened.
  cancelable: Bool,
  --- legacy
  returnValue: Bool,
  --- The defaultPrevented read-only property of the Event interface returns a boolean value indicating whether or not the call to Event.preventDefault() canceled the event.
  defaultPrevented: Bool,
  --- The read-only composed property of the
  --- Event interface returns a boolean value which indicates whether
  --- or not the event will propagate across the shadow DOM boundary into the standard DOM.
  composed: Bool,
  --- The isTrusted read-only property of the Event interface is a boolean value that is true when the event was generated by the user agent (including via user actions and programmatic methods such as HTMLElement.focus()), and false when the event was dispatched via EventTarget.dispatchEvent(). The click event fired through HTMLElement.click() sets the isTrusted property to false.
  isTrusted: Bool,
  --- The timeStamp read-only property of the Event interface returns the time (in milliseconds) at which the event was created.
  timeStamp: Handle
}

export EventInit := {
  bubbles: Bool,
  cancelable: Bool,
  composed: Bool
}

--- The addEventListener() method of the EventTarget interface
--- sets up a function that will be called whenever the specified event is delivered to the target.
export EventListener := {
}

export EventListenerOptions := {
  capture: Bool
}

--- The EventTarget interface is implemented by objects that can receive events and may have listeners for them.
--- In other words, any target of events implements the three methods associated with this interface.
export EventTarget := {
}

export GetRootNodeOptions := {
  composed: Bool
}

--- The HTMLCollection interface represents a generic collection (array-like object similar to arguments) of elements (in document order) and offers methods and properties for selecting from the list.
export HTMLCollection := {
  --- The HTMLCollection.length property returns the number of
  --- items in a HTMLCollection.
  length: Nat
}

export ImportNodeOptions := {
  customElementRegistry: Handle,
  selfOnly: Bool
}

--- The MutationObserver interface provides the ability to watch for changes being made to the DOM tree. It is designed as a replacement for the older Mutation Events feature, which was part of the DOM3 Events specification.
export MutationObserver := {
}

--- The MutationObserver method observe() configures the MutationObserver
--- callback to begin receiving notifications of changes to the DOM that match the given options.
export MutationObserverInit := {
  --- The MutationObserver method observe() configures the MutationObserver
  --- callback to begin receiving notifications of changes to the DOM that match the given options.
  childList: Bool,
  --- The MutationObserver method observe() configures the MutationObserver
  --- callback to begin receiving notifications of changes to the DOM that match the given options.
  attributes: Bool,
  --- The MutationObserver method observe() configures the MutationObserver
  --- callback to begin receiving notifications of changes to the DOM that match the given options.
  characterData: Bool,
  --- The MutationObserver method observe() configures the MutationObserver
  --- callback to begin receiving notifications of changes to the DOM that match the given options.
  subtree: Bool,
  --- The MutationObserver method observe() configures the MutationObserver
  --- callback to begin receiving notifications of changes to the DOM that match the given options.
  attributeOldValue: Bool,
  --- The MutationObserver method observe() configures the MutationObserver
  --- callback to begin receiving notifications of changes to the DOM that match the given options.
  characterDataOldValue: Bool,
  --- The MutationObserver method observe() configures the MutationObserver
  --- callback to begin receiving notifications of changes to the DOM that match the given options.
  attributeFilter: Handle
}

--- The MutationRecord is a read-only interface that represents an individual DOM mutation observed by a MutationObserver. It is the object inside the array passed to the callback of a MutationObserver.
export MutationRecord := {
  --- The MutationRecord read-only property type is the type of the MutationRecord observed by a MutationObserver.
  type: String,
  --- The MutationRecord read-only property target is the target (i.e., the mutated/changed node) of a mutation observed with a MutationObserver.
  target: Handle,
  --- The MutationRecord read-only property addedNodes is a NodeList of nodes added to a target node by a mutation observed with a MutationObserver.
  addedNodes: Handle,
  --- The MutationRecord read-only property removedNodes is a NodeList of nodes removed from a target node by a mutation observed with a MutationObserver.
  removedNodes: Handle,
  --- The MutationRecord read-only property previousSibling is the previous sibling of an added or removed child node of the target of a MutationObserver.
  previousSibling: Handle,
  --- The MutationRecord read-only property nextSibling is the next sibling of an added or removed child node of the target of a MutationObserver.
  nextSibling: Handle,
  --- The MutationRecord read-only property attributeName contains the name of a changed attribute belonging to a node that is observed by a MutationObserver.
  attributeName: Handle,
  --- The MutationRecord read-only property attributeNamespace is the namespace of the mutated attribute in the MutationRecord observed by a MutationObserver.
  attributeNamespace: Handle,
  --- The MutationRecord read-only property oldValue contains the character data or attribute value of an observed node before it was changed.
  oldValue: Handle
}

--- The NamedNodeMap interface represents a collection of Attr objects. Objects inside a NamedNodeMap are not in any particular order, unlike NodeList, although they may be accessed by an index as in an array.
export NamedNodeMap := {
  --- The read-only length property of the NamedNodeMap interface
  --- is the number of objects stored in the map.
  length: Nat
}

--- The DOM Node interface is an abstract base
--- class upon which many other DOM API objects are based, thus letting those object types
--- be used similarly and often interchangeably. As an abstract class, there is
--- no such thing as a plain Node object. All objects that implement
--- Node functionality are based on one of its subclasses. Most notable are
--- Document, Element, and DocumentFragment.
export Node := {
  --- The read-only nodeType property of a Node interface is an integer
  --- that identifies what the node is. It distinguishes different kinds of nodes from each other,
  --- such as elements, text, and comments.
  nodeType: Nat,
  --- The read-only nodeName property of Node returns the name of the current node as a string.
  nodeName: String,
  --- The read-only baseURI property of the Node interface
  --- returns the absolute base URL of the document containing the node.
  baseURI: String,
  --- The read-only isConnected property of the Node interface returns a boolean indicating whether the node is connected (directly or indirectly) to a Document object.
  isConnected: Bool,
  --- The read-only ownerDocument property of the Node interface
  --- returns the top-level document object of the node.
  ownerDocument: Handle,
  --- The read-only parentNode property of the Node interface
  --- returns the parent of the specified node in the DOM tree.
  parentNode: Handle,
  --- The read-only parentElement property of Node interface
  --- returns the DOM node's parent Element, or null if the node either has no
  --- parent, or its parent isn't a DOM Element. Node.parentNode on the other hand returns any kind of parent, regardless of its type.
  parentElement: Handle,
  --- The read-only childNodes property of the Node interface returns a live
  --- NodeList of child nodes of the given element where
  --- the first child node is assigned index 0. Child nodes include elements, text and
  --- comments.
  childNodes: Handle,
  --- The read-only firstChild property of the Node interface
  --- returns the node's first child in the tree,
  --- or null if the node has no children.
  firstChild: Handle,
  --- The read-only lastChild property of the Node interface
  --- returns the last child of the node, or null if there are no child nodes.
  lastChild: Handle,
  --- The read-only previousSibling property of the Node interface
  --- returns the node immediately preceding the specified one in its parent's
  --- childNodes list,
  --- or null if the specified node is the first in that list.
  previousSibling: Handle,
  --- The read-only nextSibling property of the Node interface
  --- returns the node immediately following the specified one in their
  --- parent's childNodes, or returns null
  --- if the specified node is the last child in the parent element.
  nextSibling: Handle,
  --- The nodeValue property of the Node interface returns or sets the value of the current node.
  nodeValue: Handle,
  --- The textContent property of the Node interface represents the text content of the node and its descendants.
  textContent: Handle
}

--- The Document.createNodeIterator() method returns a new NodeIterator object.
export NodeFilter := {
}

--- The NodeIterator interface represents an iterator to traverse nodes of a DOM subtree in document order.
export NodeIterator := {
  --- The NodeIterator.root read-only property represents the
  --- Node that is the root of what the NodeIterator
  --- traverses.
  root: Handle,
  --- The NodeIterator.referenceNode read-only property returns the
  --- Node to which the iterator is anchored; as new nodes are inserted, the
  --- iterator remains anchored to the reference node as specified by this property.
  referenceNode: Handle,
  --- The NodeIterator.pointerBeforeReferenceNode read-only
  --- property returns a boolean flag that indicates whether the
  --- NodeFilter is anchored before (if this value is true) or
  --- after (if this value is false) the anchor node indicated by the
  --- NodeIterator.referenceNode property.
  pointerBeforeReferenceNode: Bool,
  --- The NodeIterator.whatToShow read-only property represents
  --- an unsigned integer representing a bitmask signifying what types of nodes
  --- should be returned by the NodeIterator.
  whatToShow: Nat,
  --- The NodeIterator.filter read-only property returns a
  --- NodeFilter object, that is an object which implements an
  --- acceptNode(node) method, used to screen nodes.
  filter: Handle
}

--- NodeList objects are collections of nodes, usually returned by properties such as Node.childNodes and methods such as document.querySelectorAll().
export NodeList := {
  --- The NodeList.length property returns the number of items
  --- in a NodeList.
  length: Nat
}

--- Element is the most general base class from which all element objects (i.e., objects that represent elements) in a Document inherit. It only has methods and properties common to all kinds of elements. More specific classes inherit from Element.
export NonDocumentTypeChildNode := {
  --- The Element.previousElementSibling
  --- read-only property returns the Element immediately prior to the specified
  --- one in its parent's children list, or null if the specified element is the first one in the list.
  previousElementSibling: Handle,
  --- The Element.nextElementSibling read-only
  --- property returns the element immediately following the specified one in its parent's
  --- children list, or null if the specified element is the last one in the list.
  nextElementSibling: Handle
}

export NonElementParentNode := {
}

export ParentNode := {
  --- The read-only children property returns a live HTMLCollection
  --- which contains all of the child elements of the element upon which it was called.
  children: Handle,
  --- The Element.firstElementChild read-only property
  --- returns an element's first child Element, or null if there
  --- are no child elements.
  firstElementChild: Handle,
  --- The Element.lastElementChild read-only property
  --- returns an element's last child Element, or null if there
  --- are no child elements.
  lastElementChild: Handle,
  --- The Element.childElementCount read-only property
  --- returns the number of child elements of this element.
  childElementCount: Nat
}

--- The ProcessingInstruction interface represents a processing instruction — a Node that embeds an instruction targeting a specific application, which can be ignored by any application that doesn't recognize the instruction.
export ProcessingInstruction := {
  --- The read-only target property of the ProcessingInstruction interface
  --- represent the application to which the ProcessingInstruction is targeted.
  target: String
}

--- The Range interface represents a fragment of a document that can contain nodes and parts of text nodes.
export Range := {
  --- The Range.commonAncestorContainer read-only property
  --- returns the deepest — or furthest down the document tree — Node that
  --- contains both boundary points of the Range. This means that if
  --- startContainer and endContainer both refer to
  --- the same node, this node is the common ancestor container.
  commonAncestorContainer: Handle
}

--- The ShadowRoot interface of the Shadow DOM API is the root node of a DOM subtree that is rendered separately from a document's main DOM tree.
export ShadowRoot := {
  --- The mode read-only property of the ShadowRoot specifies its mode — either open or closed.
  --- This defines whether or not the shadow root's internal features are accessible from JavaScript.
  mode: Handle,
  --- The delegatesFocus read-only property of the ShadowRoot interface returns true if the shadow root delegates focus, and false otherwise.
  delegatesFocus: Bool,
  --- The serializable read-only property of the ShadowRoot interface returns true if the shadow root is serializable.
  serializable: Bool,
  --- The read-only slotAssignment property of the ShadowRoot interface returns the slot assignment mode for the shadow DOM tree. Nodes are either automatically assigned based on name matching (named) or manually assigned (manual).
  slotAssignment: Handle,
  --- The clonable read-only property of the ShadowRoot interface returns true if the shadow root is clonable, and false otherwise.
  clonable: Bool,
  --- The host read-only property of
  --- the ShadowRoot returns a reference to the DOM element the
  --- ShadowRoot is attached to.
  host: Handle,
  --- The slotchange event is fired on an HTMLSlotElement instance (<slot> element) when the node(s) contained in that slot change.
  onslotchange: Handle
}

export ShadowRootInit := {
  mode: Handle,
  delegatesFocus: Bool,
  serializable: Bool,
  slotAssignment: Handle,
  clonable: Bool,
  customElementRegistry: Handle
}

--- Element is the most general base class from which all element objects (i.e., objects that represent elements) in a Document inherit. It only has methods and properties common to all kinds of elements. More specific classes inherit from Element.
export Slottable := {
  --- The assignedSlot read-only
  --- property of the Element interface returns an
  --- HTMLSlotElement representing the <slot> element the
  --- node is inserted in.
  assignedSlot: Handle
}

--- The DOM StaticRange interface extends AbstractRange to provide a method to specify a range of content in the DOM whose contents don't update to reflect changes which occur within the DOM tree.
export StaticRange := {
}

export StaticRangeInit := {
  startContainer: Handle,
  startOffset: Nat,
  endContainer: Handle,
  endOffset: Nat
}

--- The Text interface represents a text node in a DOM tree.
export Text := {
  --- The read-only wholeText property of the Text interface
  --- returns the full text of all Text nodes logically adjacent to the node.
  --- The text is concatenated in document order.
  --- This allows specifying any text node and obtaining all adjacent text as a single string.
  wholeText: String
}

--- The TreeWalker object represents the nodes of a document subtree and a position within them.
export TreeWalker := {
  --- The TreeWalker.root read-only property returns the root Node that the TreeWalker traverses.
  root: Handle,
  --- The TreeWalker.whatToShow read-only property returns a
  --- bitmask that indicates the types of
  --- nodes to show. Non-matching nodes are skipped, but their
  --- children may be included, if relevant.
  whatToShow: Nat,
  --- The TreeWalker.filter read-only property returns the NodeFilter
  --- associated with the TreeWalker.
  filter: Handle,
  --- The TreeWalker.currentNode property represents the
  --- Node which the TreeWalker is currently pointing at.
  currentNode: Handle
}

--- The Window interface represents a window containing a DOM document; the document property points to the DOM document loaded in that window.
export Window := {
  --- legacy
  event: Handle
}

--- The XMLDocument interface represents an XML document. It inherits from the generic Document and does not add any specific methods or properties to it: nevertheless, several algorithms behave differently with the two types of documents.
export XMLDocument := {
}

--- The XPathEvaluator interface allows you to compile and evaluate XPath expressions.
export XPathEvaluator := {
}

export XPathEvaluatorBase := {
}

--- This interface is a compiled XPath expression that can be evaluated on a document or specific node to return information from its DOM tree.
export XPathExpression := {
}

--- The lookupNamespaceURI() method of the Node interface
--- takes a prefix as parameter and returns the namespace URI associated with it on the given node if found (and
--- null if not). This method's existence allows Node objects to be passed as a namespace resolver to XPathEvaluator.createExpression() and XPathEvaluator.evaluate().
export XPathNSResolver := {
}

--- The XPathResult interface represents the results generated by evaluating an XPath expression within the context of a given node.
export XPathResult := {
  --- The read-only resultType property of the
  --- XPathResult interface represents the type of the result, as defined by
  --- the type constants.
  resultType: Nat,
  --- The read-only numberValue property of the
  --- XPathResult interface returns the numeric value of a result with
  --- XPathResult.resultType being NUMBER_TYPE.
  numberValue: Float,
  --- The read-only stringValue property of the
  --- XPathResult interface returns the string value of a result with
  --- XPathResult.resultType being STRING_TYPE.
  stringValue: String,
  --- The read-only booleanValue property of the
  --- XPathResult interface returns the boolean value of a result with
  --- XPathResult.resultType being BOOLEAN_TYPE.
  booleanValue: Bool,
  --- The read-only singleNodeValue property of the
  --- XPathResult interface returns a Node value or
  --- null in case no node was matched of a result with
  --- XPathResult.resultType being ANY_UNORDERED_NODE_TYPE or
  --- FIRST_ORDERED_NODE_TYPE.
  singleNodeValue: Handle,
  --- The read-only invalidIteratorState property of the
  --- XPathResult interface signifies that the iterator has become invalid. It
  --- is true if XPathResult.resultType is
  --- UNORDERED_NODE_ITERATOR_TYPE or ORDERED_NODE_ITERATOR_TYPE and
  --- the document has been modified since this result was returned.
  invalidIteratorState: Bool,
  --- The read-only snapshotLength property of the
  --- XPathResult interface represents the number of nodes in the result
  --- snapshot.
  snapshotLength: Nat
}

--- An XSLTProcessor applies an XSLT stylesheet transformation to an XML document to
--- produce a new XML document as output. It has methods to load the XSLT stylesheet, to
--- manipulate <xsl:param> parameter values, and to apply the
--- transformation to documents.
export XSLTProcessor := {
}

export ShadowRootMode_Closed: Int
export ShadowRootMode_Open: Int
export SlotAssignmentMode_Manual: Int
export SlotAssignmentMode_Named: Int

--- The abort() method of the AbortController interface aborts an asynchronous operation before it has completed.
--- This is able to abort fetch requests, the consumption of any response bodies, or streams.
