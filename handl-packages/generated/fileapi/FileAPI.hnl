--- Generated port for fileapi.FileAPI
--- js target: browser
--- source: https://raw.githubusercontent.com/w3c/webref/19e2457df856a43ec749c0fd4e88ae1edc4f6cb8/ed/idl/FileAPI.idl

from "js" import { JsError }
from "result" import { Result }

--- The Blob interface represents a blob, which is a file-like object of immutable, raw data; they can be read as text or binary data, or converted into a ReadableStream so its methods can be used for processing the data.
export Blob := {
  --- The size read-only property of the Blob interface returns
  --- the size of the Blob or File in bytes.
  size: Nat,
  --- The type read-only property of the Blob interface returns the MIME type of the file.
  type: String
}

export BlobPropertyBag := {
  type: String,
  endings: Handle
}

--- The File interface provides information about files and allows JavaScript in a web page to access their content.
export File := {
  --- The name read-only property of the File interface returns the name of the file represented by a File object. For security
  --- reasons, the path is excluded from this property.
  name: String,
  --- The lastModified read-only property of the File interface provides the
  --- last modified date of the file as the number of milliseconds since the Unix
  --- epoch (January 1, 1970 at midnight). Files without a known last modified date return the
  --- current date.
  lastModified: Int
}

--- The FileList interface represents an object of this type returned by the files property of the HTML <input> element; this lets you access the list of files selected with the <input type="file"> element. It's also used for a list of files dropped into web content when using the drag and drop API; see the DataTransfer object for details on this usage.
export FileList := {
  --- The length read-only property of the FileList interface returns the number of files in the FileList.
  length: Nat
}

export FilePropertyBag := {
  lastModified: Int
}

--- The FileReader interface lets web applications asynchronously read the contents of files (or raw data buffers) stored on the user's computer, using File or Blob objects to specify the file or data to read.
export FileReader := {
  --- The readyState read-only property of the FileReader interface provides the current state of the reading operation.
  --- This will be one of the states: EMPTY, LOADING, or DONE.
  readyState: Nat,
  --- File or Blob data
  result: Handle,
  --- The error read-only property of the FileReader interface returns the
  --- error that occurred while reading the file.
  error: Handle,
  --- event handler content attributes
  onloadstart: Handle,
  onprogress: Handle,
  --- The load event of the FileReader interface is fired when a file has been read successfully.
  onload: Handle,
  --- The abort event of the FileReader interface is fired when a read has been aborted: for instance because the program called FileReader.abort().
  onabort: Handle,
  --- The error event of the FileReader interface is fired when the read failed due to an error (for example, because the file was not found or not readable).
  onerror: Handle,
  onloadend: Handle
}

--- The FileReaderSync interface allows you to read File or Blob objects synchronously. This interface is only available in workers as it enables synchronous I/O that could potentially block.
export FileReaderSync := {
}

--- The URL interface is used to parse, construct, normalize, and encode URLs. It works by providing properties which allow you to easily read and modify the components of a URL.
export URL := {
}

export BlobPart := Handle

export EndingType_Native: Int
export EndingType_Transparent: Int

--- The arrayBuffer() method of the Blob
--- interface returns a Promise that resolves with the contents of the blob as
--- binary data contained in an ArrayBuffer.
--- js: Blob.arrayBuffer
export BlobArrayBuffer: () ~[1]~> Result<Handle, JsError>

--- The bytes() method of the Blob interface returns a Promise that resolves with a Uint8Array containing the contents of the blob as an array of bytes.
--- js: Blob.bytes
export BlobBytes: () ~[1]~> Result<Handle, JsError>

--- The Blob() constructor returns a
--- new Blob object. The content of the blob consists of the concatenation
--- of the values given in the parameter blobParts.
--- js: Blob.constructor
export BlobConstructor: (Handle, Handle) ~[1]~> Result<(), JsError>

--- slice Blob into byte-ranged chunks
--- js: Blob.slice
export BlobSlice: (Int, Int, String) ~[1]~> Result<Handle, JsError>

--- read from the Blob.
--- js: Blob.stream
export BlobStream: () ~[1]~> Result<Handle, JsError>

--- The text() method of the
--- Blob interface returns a Promise that resolves with a
--- string containing the contents of the blob, interpreted as UTF-8.
--- js: Blob.text
export BlobText: () ~[1]~> Result<Handle, JsError>

--- The textStream() method of the Blob interface returns a ReadableStream that can be used to read the contents of the Blob in chunks of UTF-8.
--- js: Blob.textStream
export BlobTextStream: () ~[1]~> Result<Handle, JsError>

--- The File() constructor creates a new File
--- object instance.
--- js: File.constructor
export FileConstructor: (Handle, String, Handle) ~[1]~> Result<(), JsError>

--- The item() method of the FileList interface returns a File object representing the file at the specified index in the file list.
--- js: FileList.item
export FileListItem: (Nat) ~[1]~> Result<Handle, JsError>

--- The abort() method of the FileReader interface aborts the read operation. Upon return,
--- the readyState will be DONE.
--- js: FileReader.abort
export FileReaderAbort: () ~[1]~> Result<(), JsError>

--- The FileReader() constructor creates a new FileReader.
--- js: FileReader.constructor
export FileReaderConstructor: () ~[1]~> Result<(), JsError>

--- async read methods
--- js: FileReader.readAsArrayBuffer
export FileReaderReadAsArrayBuffer: (Handle) ~[1]~> Result<(), JsError>

--- The readAsBinaryString() method of the FileReader interface is used to start reading the contents of the
--- specified Blob or File. When the read operation is
--- finished, the readyState property becomes
--- DONE, and the loadend event is triggered. At that time, the
--- result property contains the raw binary data from
--- the file.
--- js: FileReader.readAsBinaryString
export FileReaderReadAsBinaryString: (Handle) ~[1]~> Result<(), JsError>

--- The readAsDataURL() method of the FileReader interface is used to read the contents of the specified
--- Blob or File. When the read operation is finished, the
--- readyState property becomes DONE, and the
--- loadend event is triggered. At that time, the
--- result attribute contains the data as a data: URL representing the
--- file's data as a base64 encoded string.
--- js: FileReader.readAsDataURL
export FileReaderReadAsDataURL: (Handle) ~[1]~> Result<(), JsError>

--- The readAsText() method of the FileReader interface is used to read the contents of the specified Blob or File.
--- When the read operation is complete, the readyState property is changed to DONE,
--- the loadend event is triggered, and the result property contains the contents of the file as a text string.
--- js: FileReader.readAsText
export FileReaderReadAsText: (Handle, String) ~[1]~> Result<(), JsError>

--- The FileReaderSync() constructor creates a new FileReaderSync.
--- js: FileReaderSync.constructor
export FileReaderSyncConstructor: () ~[1]~> Result<(), JsError>

--- The readAsArrayBuffer() method of the FileReaderSync interface allows you to read File or Blob objects in a synchronous way into an ArrayBuffer. This interface is only available in workers as it enables synchronous I/O that could potentially block.
--- js: FileReaderSync.readAsArrayBuffer
export FileReaderSyncReadAsArrayBuffer: (Handle) ~[1]~> Result<Bytes, JsError>

--- The readAsBinaryString() method of the FileReaderSync interface allows you to read File or Blob objects in a synchronous way into a string. This interface is only available in workers as it enables synchronous I/O that could potentially block.
--- js: FileReaderSync.readAsBinaryString
export FileReaderSyncReadAsBinaryString: (Handle) ~[1]~> Result<String, JsError>

--- The readAsDataURL() method of the FileReaderSync interface allows you to read File or Blob objects in a synchronous way into a string representing a data URL. This interface is only available in workers as it enables synchronous I/O that could potentially block.
--- js: FileReaderSync.readAsDataURL
export FileReaderSyncReadAsDataURL: (Handle) ~[1]~> Result<String, JsError>

--- The readAsText() method of the FileReaderSync interface allows you to read File or Blob objects in a synchronous way into a string. This interface is only available in workers as it enables synchronous I/O that could potentially block.
--- js: FileReaderSync.readAsText
export FileReaderSyncReadAsText: (Handle, String) ~[1]~> Result<String, JsError>

--- The createObjectURL() static method of the URL interface
--- creates a string containing a blob URL pointing to the object given in the parameter.
--- js: URL.createObjectURL
export URLCreateObjectURL: (Handle) ~[1]~> Result<String, JsError>

--- The revokeObjectURL() static method of the URL interface
--- releases an existing object URL which was previously created by calling
--- URL.createObjectURL().
--- js: URL.revokeObjectURL
export URLRevokeObjectURL: (String) ~[1]~> Result<(), JsError>
