--- Generated port for fetch.Response
--- js target: browser
--- source: https://raw.githubusercontent.com/w3c/webref/19e2457df856a43ec749c0fd4e88ae1edc4f6cb8/ed/idl/fetch.idl

from "js" import { JsError }
from "result" import { Result }

--- The Response interface of the Fetch API represents the response to a request.
export Response := {
  --- The type read-only property of the Response interface contains the type of the response. The type determines whether scripts are able to access the response body and headers.
  type: Handle,
  --- The url read-only property of the Response interface contains the URL of the response.
  --- The value of the url property will be the final URL obtained after any redirects.
  url: String,
  --- The redirected read-only property of the Response interface indicates whether or not the response is the result of a request you made which was redirected.
  redirected: Bool,
  --- The status read-only property of the Response interface contains the HTTP status code of the response.
  status: Nat,
  --- The ok read-only property of the Response interface contains a Boolean stating whether the response was successful (status in the range 200-299) or not.
  ok: Bool,
  --- The statusText read-only property of the Response interface contains the status message corresponding to the HTTP status code in Response.status.
  statusText: String,
  --- The headers read-only property of the
  --- Response interface contains the Headers object associated
  --- with the response.
  headers: Handle,
  --- The body read-only property of the Response interface is a ReadableStream of the body contents.
  body: Handle,
  --- The bodyUsed read-only property of the Response interface is a boolean value that indicates whether the body has been read yet.
  bodyUsed: Bool
}

--- The arrayBuffer() method of the Response interface
--- takes a Response stream and reads it to completion. It returns a promise
--- that resolves with an ArrayBuffer.
--- js: Response.arrayBuffer
export ResponseArrayBuffer: () ~[1]~> Result<Handle, JsError>

--- The blob() method of the Response interface takes
--- a Response stream and reads it to completion. It returns a promise that
--- resolves with a Blob.
--- js: Response.blob
export ResponseBlob: () ~[1]~> Result<Handle, JsError>

--- The bytes() method of the Response interface takes a Response stream and reads it to completion.
--- It returns a promise that resolves with a Uint8Array.
--- js: Response.bytes
export ResponseBytes: () ~[1]~> Result<Handle, JsError>

--- The clone() method of the Response interface creates a clone of a response object, identical in every way, but stored in a different variable.
--- js: Response.clone
export ResponseClone: () ~[1]~> Result<Handle, JsError>

--- The Response() constructor creates a new Response object.
--- js: Response.constructor
export ResponseConstructor: (Handle, Handle) ~[1]~> Result<(), JsError>

--- The error() static method of the Response interface returns a new Response object associated with a network error.
--- js: Response.error
export ResponseError: () ~[1]~> Result<Handle, JsError>

--- The formData() method of the Response interface
--- takes a Response stream and reads it to completion. It returns a promise
--- that resolves with a FormData object.
--- js: Response.formData
export ResponseFormData: () ~[1]~> Result<Handle, JsError>

--- The json() method of the Response interface takes
--- a Response stream and reads it to completion. It returns a promise which
--- resolves with the result of parsing the body text as JSON.
--- js: Response.json
export ResponseJson: (Handle, Handle) ~[1]~> Result<Handle, JsError>

--- The redirect() static method of the Response interface returns a Response resulting in a redirect to the specified URL.
--- js: Response.redirect
export ResponseRedirect: (String, Nat) ~[1]~> Result<Handle, JsError>

--- The text() method of the Response interface takes a Response stream and reads it to completion.
--- It returns a promise that resolves with a String.
--- The response is always decoded using UTF-8.
--- js: Response.text
export ResponseText: () ~[1]~> Result<Handle, JsError>

--- The textStream() method of the Response interface returns a ReadableStream that can be used to read the contents of the response body in chunks of UTF-8.
--- js: Response.textStream
export ResponseTextStream: () ~[1]~> Result<Handle, JsError>
