--- Generated port for encoding.TextEncoder
--- js target: browser
--- source: https://raw.githubusercontent.com/w3c/webref/19e2457df856a43ec749c0fd4e88ae1edc4f6cb8/ed/idl/encoding.idl

from "js" import { JsError }
from "result" import { Result }

--- The TextEncoder interface enables you to encode a JavaScript string using UTF-8.
export TextEncoder := {
  --- The TextEncoder.encoding read-only property returns a string containing the name of the encoding algorithm used by the specific encoder.
  encoding: String
}

--- The TextEncoder() constructor returns a newly created TextEncoder object.
--- js: TextEncoder.constructor
export TextEncoderConstructor: () ~[1]~> Result<(), JsError>

--- The TextEncoder.encode() method takes a string as input, and returns a Uint8Array containing the string encoded using UTF-8.
--- js: TextEncoder.encode
export TextEncoderEncode: (String) ~[1]~> Result<Bytes, JsError>

--- The TextEncoder.encodeInto() method takes a string to encode and a destination Uint8Array to put resulting UTF-8 encoded text into, and returns an object indicating the progress of the encoding.
--- This is potentially more performant than the encode() method — especially when the target buffer is a view into a Wasm heap.
--- js: TextEncoder.encodeInto
export TextEncoderEncodeInto: (String, Bytes) ~[1]~> Result<Handle, JsError>
