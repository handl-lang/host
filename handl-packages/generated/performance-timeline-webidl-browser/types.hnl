from "js" import { call, error }
from "result" import { ok, err }
from "../performance-timeline/types" import { PerformanceObserverCallback }

export performance_observer_callback: PerformanceObserverCallback := (entries, observer, options) ~> do {
  r = call("performance-timeline", "performance_observer_callback", [entries, observer, options], ["js_object", "js_object", "js_object"], "js_void", false)
  e = error()
  if e == null {
    ok(r)
  } else {
    err(e)
  }
}
