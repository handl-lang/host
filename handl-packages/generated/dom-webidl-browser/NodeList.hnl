from "js" import { call, error }
from "result" import { ok, err }
from "../dom/NodeList" import { NodeList, NodeListItem }

export node_list_item: NodeListItem := (index) ~> do {
  r = call("dom", "item", [index], ["js_number"], "js_object", false)
  e = error()
  if e == null {
    ok(r)
  } else {
    err(e)
  }
}
