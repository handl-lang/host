--- Tests for the pure-Handl `ws_frame` codec.
---
--- RFC 6455 §5.7 wire vectors, incremental (need-more) decoding,
--- coalesced frames, and the `ws_frame` contract laws exercised as
--- property tests over this implementation (the `~[2]~>` law terms are
--- cell values, not assertions -- the properties they state are checked
--- here through the contract's own projection/prefix helpers).

from "./frame" import * as frame
from "../ws_frame" import * as ws_frame
from "bytes" import * as bytes

-- -------------------------------------------------------------------
-- RFC 6455 §5.7 vectors: a single-frame unmasked "Hello" text message
-- is 0x81 0x05 + payload; masked with key 0x37fa213d it is
-- 0x81 0x85 37 fa 21 3d + masked payload.
-- -------------------------------------------------------------------

test_decode_unmasked_hello := assert(do {
  d :: frame.decode(bytes.from_list([129, 5, 72, 101, 108, 108, 111]))
  { tag: tag.tag_of(d),
    fin: d.value.frame.fin,
    op: d.value.frame.op,
    payload: bytes.utf8_decode(d.value.frame.payload),
    rest: bytes.len(d.value.rest) }
}) = { tag: "Some", fin: 1, op: 1, payload: "Hello", rest: 0 }

test_decode_masked_hello := assert(do {
  d :: frame.decode(bytes.from_list([129, 133, 55, 250, 33, 61, 127, 159, 77, 81, 88]))
  { tag: tag.tag_of(d),
    fin: d.value.frame.fin,
    op: d.value.frame.op,
    payload: bytes.utf8_decode(d.value.frame.payload),
    rest: bytes.len(d.value.rest) }
}) = { tag: "Some", fin: 1, op: 1, payload: "Hello", rest: 0 }

test_encode_unmasked_hello := assert bytes.to_list(frame.encode({
  fin: 1, op: ws_frame.OpText,
  payload: bytes.utf8_encode("Hello"),
  mask_key: bytes.from_list([])
})) = [129, 5, 72, 101, 108, 108, 111]

test_encode_masked_hello := assert bytes.to_list(frame.encode({
  fin: 1, op: ws_frame.OpText,
  payload: bytes.utf8_encode("Hello"),
  mask_key: bytes.from_list([55, 250, 33, 61])
})) = [129, 133, 55, 250, 33, 61, 127, 159, 77, 81, 88]

-- A fragmented "Hello" (RFC 6455 §5.7): FIN=0 text frame "Hel" then a
-- FIN=1 continuation frame "lo".

test_decode_fragment_first := assert(do {
  d :: frame.decode(bytes.from_list([1, 3, 72, 101, 108]))
  { fin: d.value.frame.fin,
    op: d.value.frame.op,
    payload: bytes.utf8_decode(d.value.frame.payload) }
}) = { fin: 0, op: 1, payload: "Hel" }

test_decode_fragment_last := assert(do {
  d :: frame.decode(bytes.from_list([128, 2, 108, 111]))
  { fin: d.value.frame.fin,
    op: d.value.frame.op,
    payload: bytes.utf8_decode(d.value.frame.payload) }
}) = { fin: 1, op: 0, payload: "lo" }

test_encode_fragment_first := assert bytes.to_list(frame.encode({
  fin: 0, op: ws_frame.OpText,
  payload: bytes.utf8_encode("Hel"),
  mask_key: bytes.from_list([])
})) = [1, 3, 72, 101, 108]

-- Ping / pong control frames (RFC 6455 §5.7): 0x89 / 0x8a + 0x05 + "Hello".

test_decode_ping := assert(do {
  d :: frame.decode(bytes.from_list([137, 5, 72, 101, 108, 108, 111]))
  { op: d.value.frame.op, payload: bytes.utf8_decode(d.value.frame.payload) }
}) = { op: 9, payload: "Hello" }

test_decode_pong := assert(do {
  d :: frame.decode(bytes.from_list([138, 5, 72, 101, 108, 108, 111]))
  { op: d.value.frame.op, payload: bytes.utf8_decode(d.value.frame.payload) }
}) = { op: 10, payload: "Hello" }

test_encode_close := assert bytes.to_list(frame.encode({
  fin: 1, op: ws_frame.OpClose,
  payload: bytes.from_list([]),
  mask_key: bytes.from_list([])
})) = [136, 0]

-- -------------------------------------------------------------------
-- Payload-length tiers: inline (0-125), u16 extended (126-65535),
-- u64 extended (> 65535).
-- -------------------------------------------------------------------

test_encode_empty_payload := assert bytes.to_list(frame.encode({
  fin: 1, op: ws_frame.OpBinary,
  payload: bytes.from_list([]),
  mask_key: bytes.from_list([])
})) = [130, 0]

test_decode_empty_payload := assert(do {
  d :: frame.decode(bytes.from_list([130, 0]))
  { tag: tag.tag_of(d),
    len: bytes.len(d.value.frame.payload),
    rest: bytes.len(d.value.rest) }
}) = { tag: "Some", len: 0, rest: 0 }

-- 125 is the largest inline length: byte1 is the length itself and no
-- extended-length bytes follow.
test_len_125_inline := assert(do {
  pl :: bytes.from_list((while { i: 0, acc: [] } {
    [i, acc] ~> if i >= 125 {
      { out: acc }
    } else {
      { state: { i: i + 1, acc: [...acc, i] } }
    }
  }))
  wire :: frame.encode({ fin: 1, op: ws_frame.OpBinary,
                         payload: pl,
                         mask_key: bytes.from_list([]) })
  d :: frame.decode(wire)
  { b1: bytes.at(wire, 1),
    wire_len: bytes.len(wire),
    decoded: bytes.len(ws_frame.frame_of(d).payload) }
}) = { b1: 125, wire_len: 127, decoded: 125 }

-- 126 is the smallest u16-extended length: byte1 is 126, then u16 BE.
test_len_126_ext := assert(do {
  pl :: bytes.from_list((while { i: 0, acc: [] } {
    [i, acc] ~> if i >= 126 {
      { out: acc }
    } else {
      { state: { i: i + 1, acc: [...acc, i] } }
    }
  }))
  wire :: frame.encode({ fin: 1, op: ws_frame.OpBinary,
                         payload: pl,
                         mask_key: bytes.from_list([]) })
  d :: frame.decode(wire)
  { head: bytes.to_list(bytes.slice(wire, 0, 4)),
    decoded: bytes.len(ws_frame.frame_of(d).payload),
    rest: bytes.len(ws_frame.rest_of(d)) }
}) = { head: [130, 126, 0, 126], decoded: 126, rest: 0 }

-- RFC 6455 §5.7: a 256-byte unmasked binary message starts
-- 0x82 0x7E 0x01 0x00.
test_decode_256_u16 := assert(do {
  pl :: while { v: bytes.from_list([7]), m: 1 } {
    [v, m] ~> if m >= 256 {
      { out: v }
    } else {
      { state: { v: bytes.concat(v, v), m: m * 2 } }
    }
  }
  d :: frame.decode(bytes.concat(bytes.from_list([130, 126, 1, 0]), pl))
  { fin: d.value.frame.fin,
    op: d.value.frame.op,
    len: bytes.len(d.value.frame.payload),
    rest: bytes.len(d.value.rest) }
}) = { fin: 1, op: 2, len: 256, rest: 0 }

-- A 65536-byte payload crosses into u64-extended length: byte1 is 127,
-- then 8 big-endian length bytes 00 00 00 00 00 01 00 00.
test_len_65536_u64 := assert(do {
  pl :: while { v: bytes.from_list([7]), m: 1 } {
    [v, m] ~> if m >= 65536 {
      { out: v }
    } else {
      { state: { v: bytes.concat(v, v), m: m * 2 } }
    }
  }
  wire :: frame.encode({ fin: 1, op: ws_frame.OpBinary,
                         payload: pl,
                         mask_key: bytes.from_list([]) })
  d :: frame.decode(wire)
  { head: bytes.to_list(bytes.slice(wire, 0, 10)),
    decoded: bytes.len(ws_frame.frame_of(d).payload),
    rest: bytes.len(ws_frame.rest_of(d)) }
}) = { head: [130, 127, 0, 0, 0, 0, 0, 1, 0, 0], decoded: 65536, rest: 0 }

-- -------------------------------------------------------------------
-- need_more: every strict truncation of a frame must come back `None`.
-- -------------------------------------------------------------------

test_need_more_empty := assert tag.tag_of(frame.decode(bytes.from_list([]))) = "None"

test_need_more_header := assert tag.tag_of(frame.decode(bytes.from_list([129]))) = "None"

test_need_more_u16_ext := assert(do {
  a :: tag.tag_of(frame.decode(bytes.from_list([130, 126])))
  b :: tag.tag_of(frame.decode(bytes.from_list([130, 126, 0])))
  a + "/" + b
}) = "None/None"

test_need_more_u64_ext := assert tag.tag_of(frame.decode(bytes.from_list([130, 127, 0, 0, 0, 0, 0, 1, 0]))) = "None"

test_need_more_mask_key := assert(do {
  a :: tag.tag_of(frame.decode(bytes.from_list([129, 133, 55])))
  b :: tag.tag_of(frame.decode(bytes.from_list([129, 133, 55, 250, 33])))
  a + "/" + b
}) = "None/None"

test_need_more_payload := assert tag.tag_of(frame.decode(bytes.from_list([129, 5, 72, 101, 108, 108]))) = "None"

-- -------------------------------------------------------------------
-- rest: coalesced frames decode one at a time.
-- -------------------------------------------------------------------

test_coalesced_frames := assert(do {
  w1 :: frame.encode({ fin: 1, op: ws_frame.OpText,
                       payload: bytes.utf8_encode("Hi"),
                       mask_key: bytes.from_list([]) })
  w2 :: frame.encode({ fin: 1, op: ws_frame.OpPing,
                       payload: bytes.from_list([]),
                       mask_key: bytes.from_list([]) })
  d1 :: frame.decode(bytes.concat(w1, w2))
  d2 :: frame.decode(ws_frame.rest_of(d1))
  { f1: bytes.utf8_decode(d1.value.frame.payload),
    f2_op: d2.value.frame.op,
    f2_rest: bytes.len(ws_frame.rest_of(d2)) }
}) = { f1: "Hi", f2_op: 9, f2_rest: 0 }

-- -------------------------------------------------------------------
-- Round-trips and the contract laws instantiated on this impl.
-- -------------------------------------------------------------------

-- A masked frame decodes to the unmasked payload; the mask key itself
-- does not surface in `Frame`.
test_masked_roundtrip := assert(do {
  input :: { fin: 1, op: ws_frame.OpBinary,
             payload: bytes.from_list([0, 1, 2, 255, 128, 64]),
             mask_key: bytes.from_list([222, 173, 190, 239]) }
  ws_frame.frame_of(frame.decode(frame.encode(input)))
}) = { fin: 1, op: 2, payload: bytes.from_list([0, 1, 2, 255, 128, 64]) }

-- `roundtrip`: encode >>> decode >>> frame_of == frame_in.
test_law_roundtrip := assert(do {
  input :: { fin: 1, op: ws_frame.OpText,
             payload: bytes.utf8_encode("law"),
             mask_key: bytes.from_list([]) }
  ws_frame.frame_of(frame.decode(frame.encode(input)))
}) = { fin: 1, op: 1, payload: bytes.utf8_encode("law") }

-- `complete`: encode >>> decode >>> rest_of == empty.
test_law_complete := assert ws_frame.rest_of(frame.decode(frame.encode({
  fin: 1, op: ws_frame.OpText,
  payload: bytes.utf8_encode("law"),
  mask_key: bytes.from_list([])
}))) = ws_frame.empty(null)

-- `prefix`: every strict prefix of an encoded frame decodes to `None`
-- (checked on a masked frame so the truncation spans header, mask key,
-- and payload bytes alike).
test_law_prefix := assert ws_frame.all_need_more(
  frame.decode,
  ws_frame.prefixes(frame.encode({
    fin: 1, op: ws_frame.OpPing,
    payload: bytes.utf8_encode("Hi"),
    mask_key: bytes.from_list([55, 250, 33, 61])
  }))) = true

-- The `~[2]~>` law terms themselves evaluate to `Arrow` cells when
-- instantiated with this impl's arrows (the properties they state are
-- asserted concretely above).
test_laws_instantiate := assert(do {
  r :: tag.tag_of(ws_frame.roundtrip(frame.encode, frame.decode))
  c :: tag.tag_of(ws_frame.complete(frame.encode, frame.decode))
  p :: tag.tag_of(ws_frame.prefix(frame.encode, frame.decode))
  r + "/" + c + "/" + p
}) = "Arrow/Arrow/Arrow"
