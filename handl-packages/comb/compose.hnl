--- Compose a list of functions right-to-left, returning an arrow
export compose :: fs ~> do {
  rev :: xs ~> while { xs: xs, acc: [] } {
    [xs, acc] ~> match xs {
      []: { out: acc },
      [h, ...t]: { state: { xs: t, acc: [h, ...acc] } }
    }
  }
  flow :: gs ~> y ~> while { xs: gs, acc: y } {
    [xs, acc] ~> match xs {
      []: { out: acc },
      [h, ...t]: { state: { xs: t, acc: h(acc) } }
    }
  }
  flow(rev(fs))
}
