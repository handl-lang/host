--- Pipes a value through a sequence of functions, left-to-right.
---
--- @details
--- `pipe` takes `[value, ...fs]` and returns `fn(...f2(f1(value)))`.
--- It is the eager counterpart of `comb.flow`: `pipe` runs the
--- functions now, while `flow` returns an arrow you can reuse.
---
--- An empty `fs` returns `value` unchanged.
---
--- @example
--- `[3, x ~> x + 1, x ~> x * 2] >>> comb.pipe`
--- -- => 8
---
export pipe :: args ~> match args {
  [value, ...fs]: {
    while { xs: fs, acc: value } {
      [xs, acc]~> match xs {
        []: { out: acc },
        [h, ...t]: { state: { xs: t, acc: h(acc) } }
      }
    }
  }
}
