--- Applies several branches to one value and folds the results with a combiner.
---
--- @details
--- `converge` takes `[value, combiner, ...branches]`. Each branch is
--- applied to `value`; the results are folded left with
--- `combiner(acc, branch_result)`. The first branch's result seeds the
--- fold, so `combiner` is never called on an empty accumulator.
---
--- With no branches the result is `null`.
---
--- Related: `comb.fanout` collects the branch results into a list
--- instead of folding them.
---
--- @example
--- `[6, [a, b] ~> a + b, x ~> x * 2, x ~> x * 3] >>> comb.converge`
--- -- => 30
---
export converge :: args ~> match args {
  [value, combiner, ...branches]: match branches {
    []: null,
    [h, ...t]: {
      while { xs: t, acc: h(value) } {
        [xs, acc] ~> match xs {
          []: { out: acc },
          [h2, ...t2]: { state: { xs: t2, acc: combiner(acc, h2(value)) } }
        }
      }
    }
  }
}
