--- Applies a transform to a value only when a predicate holds for it.
---
--- @details
--- `when` takes `[value, pred, fn]`. If `pred(value)` is truthy,
--- `fn(value)` is returned; otherwise the value passes through
--- unchanged. Mirror of `comb.unless`; for a two-sided branch use
--- `comb.choice`.
---
--- @example
--- `[4, x ~> x % 2 == 0, x ~> x * 10] >>> comb.when`
--- -- => 40
---
export when :: [value, pred, fn] ~> {
  if pred(value) {
    fn(value)
  } else {
    value
  }
}
