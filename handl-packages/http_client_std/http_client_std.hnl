--- http.get -- issue an HTTP GET request via ureq.
--- http.post -- issue an HTTP POST request with a body via ureq.
--- http.put -- issue an HTTP PUT request with a body via ureq.
--- http.patch -- issue an HTTP PATCH request with a body via ureq.
--- http.delete -- issue an HTTP DELETE request via ureq.
--- http.head -- issue an HTTP HEAD request via ureq.
--- http.request -- issue a full HTTP request with method, url, body, and headers via ureq.
cap "http.get"
cap "http.post"
cap "http.put"
cap "http.patch"
cap "http.delete"
cap "http.head"
cap "http.request"
op "http.get" : String -> Value
  guarantee: True
op "http.post" : String -> Value
  guarantee: True
op "http.put" : String -> Value
  guarantee: True
op "http.patch" : String -> Value
  guarantee: True
op "http.delete" : String -> Value
  guarantee: True
op "http.head" : String -> Value
  guarantee: True
op "http.request" : String -> Value
  guarantee: True

handle "http.get" with rust_http_get
handle "http.post" with rust_http_post
handle "http.put" with rust_http_put
handle "http.patch" with rust_http_patch
handle "http.delete" with rust_http_delete
handle "http.head" with rust_http_head
handle "http.request" with rust_http_request
