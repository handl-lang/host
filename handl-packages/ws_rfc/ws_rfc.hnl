--- ws_rfc -- WebSocket frame and message codec (RFC 6455) interface.
---
--- This is the interface declaration for the WebSocket RFC 6455 API.
--- It defines the framing protocol and a basic client/server API.
--- Concrete implementations are provided by ws_rfc_memory (in-memory)
--- and ws_rfc_native (tokio-tungstenite).
---
--- ## client API
--- ws_rfc.client -- create a WebSocket client.
--- ws_rfc.connect -- connect a client to a URL.
--- ws_rfc.send -- send a message on a client.
--- ws_rfc.recv -- receive the next message on a client, or null if empty.
--- ws_rfc.close -- close a client connection.
---
--- ## server API
--- ws_rfc.server -- create a WebSocket server.
--- ws_rfc.listen -- start a server listening on an address with a handler.
--- ws_rfc.stop -- stop a running server.
---
--- ## frame codec
--- ws_rfc.frame.encode -- encode a frame object into base64 frame bytes.
--- ws_rfc.frame.decode -- decode base64 frame bytes into a frame object.
---
--- ## message codec
--- ws_rfc.message.from_frame -- construct a message object from a frame.
--- ws_rfc.message.to_frame -- encode a message object into base64 frame bytes.
cap "ws_rfc.client"
cap "ws_rfc.connect"
cap "ws_rfc.send"
cap "ws_rfc.recv"
cap "ws_rfc.close"
cap "ws_rfc.server"
cap "ws_rfc.listen"
cap "ws_rfc.stop"
cap "ws_rfc.frame.encode"
cap "ws_rfc.frame.decode"
cap "ws_rfc.message.from_frame"
cap "ws_rfc.message.to_frame"
