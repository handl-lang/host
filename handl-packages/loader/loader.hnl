--- loader — canonical text transforms for .hnl module loading.
---
--- This is the bootstrap loader: it must contain no `cap`/`op`/`handl`/
--- `import`/`tag`/`export` declaration lines (it is the code that strips
--- those from every other .hnl file).  It operates over the `char` and
--- `str` floors, which are injected into its bridge runtime by the host.
---
--- Design (ADR-0094): the Rust `handl-plugin-lib-handl` crate keeps only
--- the FFI seam (Module/Function trait impls, runtime caching, op
--- dispatch) plus a small bootstrap fallback (`mod bootstrap`) used to
--- build the `str`/`char` floors this file needs before it exists.  Once
--- a host installs a `HandlLoader` (`install_loader`), every text-level
--- transform — declaration stripping, comment stripping, export
--- transformation, binding-separator detection, import/capability/tag
--- parsing, tag expansion — is evaluated here, in pure handl, through
--- `HandlModule`'s cached per-thread runtime.
---
--- All line/offset arithmetic is in *character* units (`char.slice`,
--- `str.find` etc. are char-indexed), matching the Rust bootstrap.

do {
  -- ---------------------------------------------------------------------
  -- Character constants (no escapes needed beyond the canonical set)
  -- ---------------------------------------------------------------------

  nl :: char.from_code_point(10)
  tab :: char.from_code_point(9)
  dq :: char.from_code_point(34)
  sq :: char.from_code_point(39)
  backslash :: char.from_code_point(92)

  -- ---------------------------------------------------------------------
  -- List helpers
  -- ---------------------------------------------------------------------

  rev :: xs ~> do {
    while { xs: xs, acc: [] } {
      [xs, acc] ~> match xs {
        []: { out: acc },
        [h, ...t]: { state: { xs: t, acc: [h, ...acc] } }
      }
    }
  }

  list_len :: xs ~> do {
    while { xs: xs, n: 0 } {
      [xs, n] ~> match xs {
        []: { out: n },
        [h, ...t]: { state: { xs: t, n: n + 1 } }
      }
    }
  }

  head :: xs ~> match xs {
    []: "",
    [h, ...t]: h
  }

  last :: xs ~> head(rev(xs))

  member :: [x, xs] ~> do {
    while xs {
      st ~> match st {
        []: { out: false },
        [h, ...t]: if h == x { { out: true } } else { { state: t } }
      }
    }
  }

  all :: [xs, p] ~> do {
    while xs {
      st ~> match st {
        []: { out: true },
        [h, ...t]: if p(h) { { state: t } } else { { out: false } }
      }
    }
  }

  -- ---------------------------------------------------------------------
  -- String helpers (all indices are char indices)
  -- ---------------------------------------------------------------------

  slen :: s ~> char.length(s)
  atc :: [s, i] ~> char.slice(s, i, i + 1)
  stake :: [s, n] ~> char.slice(s, 0, n)
  sdrop :: [s, n] ~> char.slice(s, n, slen(s))
  trim :: s ~> str.trim(s)
  trim_start :: s ~> str.trim_start(s)
  blank :: s ~> slen(trim(s)) == 0
  indented :: s ~> do {
    c :: atc(s, 0)
    c == " " || c == tab
  }

  -- True when `t` starts with `kw` followed by a delimiter: end of
  -- string, space, tab, or one of the chars in `extras` (e.g. quotes).
  kw_match :: [t, kw, extras] ~> do {
    if str.starts_with(t, kw) {
      r :: sdrop(t, slen(kw))
      slen(r) == 0 || member(atc(r, 0), [" ", tab, ...extras])
    } else {
      false
    }
  }

  -- If `t` starts with `kw` followed by a delimiter, return the text
  -- after `kw`; else null.
  kw_rest :: [t, kw, extras] ~> do {
    if kw_match(t, kw, extras) {
      sdrop(t, slen(kw))
    } else {
      null
    }
  }

  -- Extract a `"..."` or `'...'` quoted string from the start of `s`
  -- (after leading whitespace).  Returns `{text, rest}` or null.
  extract_quoted :: s ~> do {
    t :: trim_start(s)
    q :: atc(t, 0)
    if q == dq || q == sq {
      r :: sdrop(t, 1)
      e :: str.find(r, q)
      if e < 0 {
        null
      } else {
        { text: stake(r, e), rest: sdrop(r, e + 1) }
      }
    } else {
      null
    }
  }

  -- First whitespace-delimited word of `s` (s already trimmed).
  first_word :: s ~> do {
    ws :: str.split_whitespace(s)
    match ws {
      []: "",
      [h, ...t]: h
    }
  }

  -- ---------------------------------------------------------------------
  -- strip_comments — drop `--` comment lines
  -- ---------------------------------------------------------------------

  strip_comments :: s ~> do {
    kept :: while { xs: str.lines(s), acc: [] } {
      [xs, acc] ~> match xs {
        []: { out: rev(acc) },
        [h, ...t]: if str.starts_with(trim_start(h), "--") {
          { state: { xs: t, acc: acc } }
        } else {
          { state: { xs: t, acc: [h, ...acc] } }
        }
      }
    }
    str.join(kept, nl)
  }

  -- ---------------------------------------------------------------------
  -- strip_decls — drop `cap`/`op`/`handl`/`import`/`from` declaration
  -- lines and indented `guarantee:`/`requires:`/`termination:`
  -- continuation lines
  -- ---------------------------------------------------------------------

  is_import_line :: t ~> do {
    kw_match(t, "import", [dq, sq]) || kw_match(t, "from", [])
  }

  is_decl_line :: [line, t] ~> do {
    if indented(line) &&
       (str.starts_with(t, "guarantee") ||
        str.starts_with(t, "requires") ||
        str.starts_with(t, "termination")) {
      true
    } else {
      if kw_match(t, "cap", [dq]) ||
         kw_match(t, "op", [dq]) ||
         kw_match(t, "handl", [dq]) ||
         is_import_line(t) {
        true
      } else {
        false
      }
    }
  }

  strip_decls :: s ~> do {
    kept :: while { xs: str.lines(s), acc: [] } {
      [xs, acc] ~> match xs {
        []: { out: rev(acc) },
        [h, ...t]: if is_decl_line(h, trim_start(h)) {
          { state: { xs: t, acc: acc } }
        } else {
          { state: { xs: t, acc: [h, ...acc] } }
        }
      }
    }
    str.join(kept, nl)
  }

  -- ---------------------------------------------------------------------
  -- find_binding_sep — locate the `::` (canonical) or legacy `=` bind
  -- separator at bracket depth 0, skipping `==`, `=>`, `>=`, `<=`, `!=`.
  -- `::` takes precedence and returns immediately; the first bare `=` is
  -- remembered but the scan continues.  Returns `{pos, len}` or null.
  -- ---------------------------------------------------------------------

  find_binding_sep :: s ~> do {
    while { xs: char.chars(s), i: 0, depth: 0, feq: 0 - 1 } {
      [xs, i, depth, feq] ~> match xs {
        []: if feq >= 0 {
          { out: { pos: feq, len: 1 } }
        } else {
          { out: null }
        },
        [c, ...t]: if c == "(" || c == "[" || c == "{" {
          { state: { xs: t, i: i + 1, depth: depth + 1, feq: feq } }
        } else {
          if c == ")" || c == "]" || c == "}" {
            { state: { xs: t, i: i + 1, depth: depth - 1, feq: feq } }
          } else {
            if c == ":" && depth == 0 {
              if atc(s, i + 1) == ":" {
                { out: { pos: i, len: 2 } }   -- ::  bind
              } else {
                if atc(s, i + 1) == "=" {
                  { out: { pos: i, len: 2 } }   -- :=  graded bind
                } else {
                  { state: { xs: t, i: i + 1, depth: depth, feq: feq } }
                }
              }
            } else {
              if c == "=" && depth == 0 {
                p :: if i > 0 { atc(s, i - 1) } else { "" }
                n :: atc(s, i + 1)
                if n == "=" || p == ">" || p == "<" || p == "!" || n == ">" {
                  { state: { xs: t, i: i + 1, depth: depth, feq: feq } }
                } else {
                  if feq < 0 {
                    { state: { xs: t, i: i + 1, depth: depth, feq: i } }
                  } else {
                    { state: { xs: t, i: i + 1, depth: depth, feq: feq } }
                  }
                }
              } else {
                { state: { xs: t, i: i + 1, depth: depth, feq: feq } }
              }
            }
          }
        }
      }
    }
  }

  -- ---------------------------------------------------------------------
  -- strip_export_name — Strip generics `<...>` and type annotation
  -- `: Type` from an export name portion, returning the bare name.
  -- e.g. `len<T>: List(T) ~[Total]~> Nat ` -> `len`
  -- ---------------------------------------------------------------------

  strip_export_name :: s ~> do {
    while { xs: char.chars(s), i: 0, depth: 0, acc: "" } {
      [xs, i, depth, acc] ~> match xs {
        []: { out: acc },
        [c, ...t]: if depth == 0 && (c == "<" || c == ":") {
          { out: acc }
        } else {
          if c == "(" || c == "[" || c == "{" {
            { state: { xs: t, i: i + 1, depth: depth + 1, acc: acc + c } }
          } else {
            if c == ")" || c == "]" || c == "}" {
              { state: { xs: t, i: i + 1, depth: depth - 1, acc: acc + c } }
            } else {
              { state: { xs: t, i: i + 1, depth: depth, acc: acc + c } }
            }
          }
        }
      }
    }
  }

  -- ---------------------------------------------------------------------
  -- transform_export_to_object — rewrite top-level
  -- `export name : Type ~> Grade := expr` or `export name :: expr`
  -- declarations into an object literal
  -- `{ name: expr, ... }`.  No exports → source unchanged.
  -- ---------------------------------------------------------------------

  is_export_line :: line ~> do {
    !indented(line) && str.starts_with(trim_start(line), "export ")
  }

  -- Emit `{ name: expr, ... }` from a list of `{name, expr}` records.
  emit_object :: entries ~> do {
    while { xs: entries, acc: "{ " } {
      [xs, acc] ~> match xs {
        []: { out: acc + " }" },
        [h, ...t]: if acc == "{ " {
          { state: { xs: t, acc: acc + h.name + ": " + trim(h.expr) } }
        } else {
          { state: { xs: t, acc: acc + ", " + h.name + ": " + trim(h.expr) } }
        }
      }
    }
  }

  -- Scan lines, collecting `{name, expr}` entries.  `cur` is null or the
  -- current `{name, lines}` record under construction (lines reversed).
  transform_export_to_object :: s ~> do {
    scan :: while { xs: str.lines(s), entries: [], cur: null } {
      [xs, entries, cur] ~> match xs {
        []: match cur {
          null: { out: entries },
          c: { out: [{ name: c.name, expr: str.join(rev(c.lines), nl) }, ...entries] }
        },
        [h, ...t]: if is_export_line(h) {
          rest :: sdrop(trim_start(h), 7)
          sep :: find_binding_sep(rest)
          entries2 :: match cur {
            null: entries,
            c: [{ name: c.name, expr: str.join(rev(c.lines), nl) }, ...entries]
          }
          if sep == null {
            { state: { xs: t, entries: entries2, cur: null } }
          } else {
            expr0 :: trim(sdrop(rest, sep.pos + sep.len))
            { state: { xs: t, entries: entries2,
                       cur: { name: trim(strip_export_name(stake(rest, sep.pos))),
                              lines: if slen(expr0) == 0 { [] } else { [expr0] } } } }
          }
        } else {
          match cur {
            null: { state: { xs: t, entries: entries, cur: cur } },
            c: if blank(h) {
              { state: { xs: t, entries: entries, cur: cur } }
            } else {
              { state: { xs: t, entries: entries,
                         cur: { name: c.name, lines: [h, ...c.lines] } } }
            }
          }
        }
      }
    }
    if list_len(scan) == 0 {
      s
    } else {
      emit_object(rev(scan))
    }
  }

  -- ---------------------------------------------------------------------
  -- parse_imports — `from 'path' import * as 'alias'` and
  -- `import "path" as alias` declarations → `[{path, alias}, ...]`
  -- ---------------------------------------------------------------------

  -- Parse the `as 'alias'` / `as alias` tail; returns the alias or null.
  parse_alias :: s ~> do {
    a :: trim_start(s)
    if slen(a) == 0 {
      null
    } else {
      q :: atc(a, 0)
      if q == dq || q == sq {
        e :: extract_quoted(a)
        match e {
          null: null,
          r: r.text
        }
      } else {
        w :: first_word(a)
        if slen(w) == 0 { null } else { w }
      }
    }
  }

  parse_from_import :: t ~> do {
    if str.starts_with(t, "from") {
      r :: sdrop(t, 4)
      if slen(trim(r)) == 0 {
        null
      } else {
        pq :: extract_quoted(r)
        match pq {
          null: null,
          p: do {
            ik :: trim_start(p.rest)
            if str.starts_with(ik, "import") {
              st :: trim_start(sdrop(ik, 6))
              if str.starts_with(st, "*") {
                ak :: trim_start(sdrop(st, 1))
                if str.starts_with(ak, "as") {
                  al :: parse_alias(sdrop(ak, 2))
                  if al == null {
                    null
                  } else {
                    { path: p.text, alias: al }
                  }
                } else {
                  null
                }
              } else {
                null
              }
            } else {
              null
            }
          }
        }
      }
    } else {
      null
    }
  }

  parse_legacy_import :: t ~> do {
    if str.starts_with(t, "import") {
      r :: sdrop(t, 6)
      if slen(trim(r)) == 0 {
        null
      } else {
        pq :: extract_quoted(r)
        match pq {
          null: null,
          p: do {
            a :: trim(p.rest)
            if str.starts_with(a, "as") {
              al :: parse_alias(sdrop(a, 2))
              if al == null {
                null
              } else {
                { path: p.text, alias: al }
              }
            } else {
              segs :: str.split(p.text, "/")
              { path: p.text, alias: last(segs) }
            }
          }
        }
      }
    } else {
      null
    }
  }

  parse_imports :: s ~> do {
    while { xs: str.lines(s), acc: [] } {
      [xs, acc] ~> match xs {
        []: { out: rev(acc) },
        [h, ...t]: do {
          ln :: trim_start(h)
          if str.starts_with(ln, "--") {
            { state: { xs: t, acc: acc } }
          } else {
            d :: parse_from_import(ln)
            d2 :: if d == null { parse_legacy_import(ln) } else { d }
            if d2 == null {
              { state: { xs: t, acc: acc } }
            } else {
              { state: { xs: t, acc: [d2, ...acc] } }
            }
          }
        }
      }
    }
  }

  -- ---------------------------------------------------------------------
  -- parse_caps — `cap "name"` declarations → `[name, ...]`
  -- ---------------------------------------------------------------------

  parse_caps :: s ~> do {
    while { xs: str.lines(s), acc: [] } {
      [xs, acc] ~> match xs {
        []: { out: rev(acc) },
        [h, ...t]: do {
          ln :: trim(h)
          if slen(ln) == 0 || str.starts_with(ln, "--") {
            { state: { xs: t, acc: acc } }
          } else {
            r :: kw_rest(ln, "cap", [])
            if r == null {
              { state: { xs: t, acc: acc } }
            } else {
              q :: extract_quoted(trim_start(r))
              match q {
                null: { state: { xs: t, acc: acc } },
                qq: { state: { xs: t, acc: [qq.text, ...acc] } }
              }
            }
          }
        }
      }
    }
  }

  -- ---------------------------------------------------------------------
  -- parse_tags — `tag name <::|=> Type` declarations →
  -- `[{name, payload}, ...]`.  `::` is preferred over `=` even when a
  -- `=` appears earlier in the line (mirrors the Rust scan).
  -- ---------------------------------------------------------------------

  tag_name_ok :: name ~> do {
    slen(name) > 0 && all(char.chars(name), c ~> char.is_alnum(c) || c == "_")
  }

  tag_sep :: rest ~> do {
    i2 :: str.find(rest, "::")
    if i2 >= 0 {
      { pos: i2, len: 2 }
    } else {
      i1 :: str.find(rest, "=")
      if i1 >= 0 {
        { pos: i1, len: 1 }
      } else {
        null
      }
    }
  }

  parse_tags :: s ~> do {
    while { xs: str.lines(s), acc: [] } {
      [xs, acc] ~> match xs {
        []: { out: rev(acc) },
        [h, ...t]: do {
          ln :: trim(h)
          if slen(ln) == 0 || str.starts_with(ln, "--") {
            { state: { xs: t, acc: acc } }
          } else {
            r :: kw_rest(ln, "tag", [])
            if r == null {
              { state: { xs: t, acc: acc } }
            } else {
              sep :: tag_sep(r)
              if sep == null {
                { state: { xs: t, acc: acc } }
              } else {
                name :: trim(stake(r, sep.pos))
                payload :: trim(sdrop(r, sep.pos + sep.len))
                if tag_name_ok(name) && slen(payload) > 0 {
                  { state: { xs: t, acc: [{ name: name, payload: payload }, ...acc] } }
                } else {
                  { state: { xs: t, acc: acc } }
                }
              }
            }
          }
        }
      }
    }
  }

  -- ---------------------------------------------------------------------
  -- expand_tags — strip `tag` declaration lines and generate constructor
  -- bindings `name :: _0 ~> tag.tag("name", {value: _0})`, wrapping the
  -- remaining source in `do { ... }`.  No tags → source unchanged.
  -- ---------------------------------------------------------------------

  -- True when the trimmed line is a strippable `tag` declaration
  -- (`tag` + separator + alphanumeric name; payload is not checked).
  is_tag_decl_line :: ln ~> do {
    r :: kw_rest(ln, "tag", [])
    if r == null {
      false
    } else {
      sep :: tag_sep(r)
      if sep == null {
        false
      } else {
        tag_name_ok(trim(stake(r, sep.pos)))
      }
    }
  }

  -- Emit the `do { ... }` wrapper: constructor lines, then the remaining
  -- source lines each indented by two spaces (blank lines stay blank).
  emit_tag_block :: [tags, lines] ~> do {
    ctors :: while { xs: tags, acc: "" } {
      [xs, acc] ~> match xs {
        []: { out: acc },
        [h, ...t]: { state: { xs: t,
                     acc: acc + "  " + h.name + " :: _0 ~> tag.tag(" + dq + h.name + dq + ", {value: _0})" + nl } }
      }
    }
    body :: while { xs: lines, acc: ctors } {
      [xs, acc] ~> match xs {
        []: { out: acc },
        [h, ...t]: if blank(h) {
          { state: { xs: t, acc: acc + nl } }
        } else {
          { state: { xs: t, acc: acc + "  " + h + nl } }
        }
      }
    }
    "do {" + nl + body + "}"
  }

  expand_tags :: s ~> do {
    tags :: parse_tags(s)
    if list_len(tags) == 0 {
      s
    } else {
      kept :: while { xs: str.lines(s), acc: [] } {
        [xs, acc] ~> match xs {
          []: { out: rev(acc) },
          [h, ...t]: do {
            ln :: trim(h)
            if slen(ln) == 0 || str.starts_with(ln, "--") {
              { state: { xs: t, acc: [h, ...acc] } }
            } else {
              if is_tag_decl_line(ln) {
                { state: { xs: t, acc: acc } }
              } else {
                { state: { xs: t, acc: [h, ...acc] } }
              }
            }
          }
        }
      }
      emit_tag_block(tags, kept)
    }
  }

  -- ---------------------------------------------------------------------
  -- escape_string — escape `"` and `\` for embedding in a `"..."` literal
  -- ---------------------------------------------------------------------

  escape_string :: s ~> do {
    while { xs: char.chars(s), acc: "" } {
      [xs, acc] ~> match xs {
        []: { out: acc },
        [c, ...t]: if c == dq {
          { state: { xs: t, acc: acc + backslash + c } }
        } else {
          if c == backslash {
            { state: { xs: t, acc: acc + backslash + c } }
          } else {
            { state: { xs: t, acc: acc + c } }
          }
        }
      }
    }
  }

  -- ---------------------------------------------------------------------
  -- Composite pipeline (HandlModule::new order):
  --   strip comments → strip decls → transform exports → expand tags
  -- ---------------------------------------------------------------------

  prepare :: s ~> expand_tags(transform_export_to_object(strip_decls(strip_comments(s))))

  -- One-shot analysis over a raw .hnl source: the prepared (evaluatable)
  -- source plus the declaration scans the host needs (`imports` for
  -- dependency wiring, `caps` for plugin capabilities, `tags`).
  analyze :: s ~> do {
    {
      source: prepare(s),
      imports: parse_imports(s),
      caps: parse_caps(s),
      tags: parse_tags(s)
    }
  }

  -- ---------------------------------------------------------------------
  -- Public record
  -- ---------------------------------------------------------------------

  {
    strip_comments: strip_comments,
    strip_decls: strip_decls,
    transform_export_to_object: transform_export_to_object,
    find_binding_sep: find_binding_sep,
    parse_imports: parse_imports,
    parse_caps: parse_caps,
    parse_tags: parse_tags,
    expand_tags: expand_tags,
    escape_string: escape_string,
    prepare: prepare,
    analyze: analyze
  }
}
