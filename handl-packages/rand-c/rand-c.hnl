--- The libsodium `getrandom` backend for random values.
---
--- @details
--- All values are derived from `entropy.next_u32` so the package is
--- built on a small, cryptographically secure surface. Phase 1 covers
--- `int`, `float`, `bool`; phase 2 adds `pick`, `choice`, `sample`,
--- `shuffle`. Distributions, `bytes`, `string`, `uuid`, and `seeded_*`
--- are in later phases (see `project/adrs/0107-rand-ffi.md`).

do {
  -- -----------------------------------------------------------------------
  -- Internal list helpers
  -- -----------------------------------------------------------------------

  arr_len :: (xs) ~> do {
    while { xs: xs, n: 0 } {
      [xs, n] ~> match xs {
        []: { out: n },
        [_, ...t]: { state: { xs: t, n: n + 1 } }
      }
    }
  }

  arr_rev :: (xs) ~> do {
    while { xs: xs, acc: [] } {
      [xs, acc] ~> match xs {
        []: { out: acc },
        [h, ...t]: { state: { xs: t, acc: [h, ...acc] } }
      }
    }
  }

  arr_take :: (xs, n) ~> do {
    while { xs: xs, n: n, acc: [] } {
      [xs, n, acc] ~> if n <= 0 {
        { out: arr_rev(acc) }
      } else {
        match xs {
          []: { out: arr_rev(acc) },
          [h, ...t]: { state: { xs: t, n: n - 1, acc: [h, ...acc] } }
        }
      }
    }
  }

  arr_drop :: (xs, n) ~> do {
    while { xs: xs, n: n } {
      [xs, n] ~> if n <= 0 {
        { out: xs }
      } else {
        match xs {
          []: { out: [] },
          [_, ...t]: { state: { xs: t, n: n - 1 } }
        }
      }
    }
  }

  arr_concat :: (a, b) ~> do {
    while { xs: arr_rev(a), acc: b } {
      [xs, acc] ~> match xs {
        []: { out: acc },
        [h, ...t]: { state: { xs: t, acc: [h, ...acc] } }
      }
    }
  }

  arr_remove_at :: (xs, i) ~> arr_concat(arr_take(xs, i), arr_drop(xs, i + 1))

  arr_sum :: (xs) ~> do {
    while { xs: xs, acc: 0 } {
      [xs, acc] ~> match xs {
        []: { out: acc },
        [h, ...t]: { state: { xs: t, acc: acc + h } }
      }
    }
  }

  -- Pure-Handl seeded PRNG
  hash :: (seed, salt) ~> math.mod(math.add(math.mul(seed, 12345), math.mul(salt, 6789)), 2147483647)

  -- Core selection primitives shared by other arrows.
  pick :: (xs) ~> do {
    i = math.mod(entropy.next_u32(), arr_len(xs))
    xs[i]
  }

  sample :: (xs, count) ~> do {
    while { xs: xs, n: count, acc: [] } {
      [xs, n, acc] ~> if n <= 0 || arr_len(xs) == 0 {
        { out: arr_rev(acc) }
      } else {
        i = math.mod(entropy.next_u32(), arr_len(xs))
        x = xs[i]
        { state: { xs: arr_remove_at(xs, i), n: n - 1, acc: [x, ...acc] } }
      }
    }
  }

  seeded_sample :: (seed, xs, count) ~> do {
    while { xs: xs, n: count, k: 0, acc: [] } {
      [xs, n, k, acc] ~> if n <= 0 || arr_len(xs) == 0 {
        { out: arr_rev(acc) }
      } else {
        r = hash(seed, k)
        i = math.mod(r, arr_len(xs))
        x = xs[i]
        { state: { xs: arr_remove_at(xs, i), n: n - 1, k: k + 1, acc: [x, ...acc] } }
      }
    }
  }

  -- -----------------------------------------------------------------------
  -- Exports
  -- -----------------------------------------------------------------------

  {
    -- Generate a random integer in `[0, max]`.
    int: (max) ~> do {
      u = entropy.next_u32()
      math.mod(u, max + 1)
    },

    -- Generate a random float in `[0, max)`.
    float: (max) ~> do {
      u = entropy.next_u32()
      math.mul(math.div(u, 4294967296), max)
    },

    -- Generate a random boolean.
    bool: () ~> do {
      u = entropy.next_u32()
      math.mod(u, 2) == 0
    },

    -- Pick one random element from a non-empty array.
    pick: pick,

    -- Pick one random element from weighted arrays.
    weighted_pick: (weights, items) ~> do {
      n = arr_len(weights)
      if n == 0 || n != arr_len(items) {
        null
      } else {
        do {
          total = arr_sum(weights)
          if total <= 0 {
            null
          } else {
            do {
              r = math.mod(entropy.next_u32(), total)
              while { i: 0, cum: 0 } {
                [i, cum] ~> if i >= n {
                  { out: null }
                } else {
                  w = weights[i]
                  c = cum + w
                  if r < c {
                    { out: items[i] }
                  } else {
                    { state: { i: i + 1, cum: c } }
                  }
                }
              }
            }
          }
        }
      }
    },

    -- Choose `count` elements from an array with replacement.
    choice: (xs, count) ~> do {
      while { n: count, acc: [] } {
        [n, acc] ~> if n <= 0 {
          { out: arr_rev(acc) }
        } else {
          { state: { n: n - 1, acc: [pick(xs), ...acc] } }
        }
      }
    },

    -- Sample `count` elements from an array without replacement.
    sample: sample,

    -- Shuffle an array in random order.
    shuffle: (xs) ~> sample(xs, arr_len(xs)),

    -- Generate `n` random bytes in `[0, 255]`.
    bytes: (n) ~> do {
      while { n: n, acc: [] } {
        [n, acc] ~> if n <= 0 {
          { out: arr_rev(acc) }
        } else {
          { state: { n: n - 1, acc: [math.mod(entropy.next_u32(), 256), ...acc] } }
        }
      }
    },

    -- Generate a random string of `len` characters from `charset`.
    string: (len, charset) ~> do {
      cs = char.chars(charset)
      while { n: len, acc: "" } {
        [n, acc] ~> if n <= 0 {
          { out: acc }
        } else {
          { state: { n: n - 1, acc: acc + pick(cs) } }
        }
      }
    },

    -- Generate a normally distributed number with `mean` and `stddev`.
    gauss: (mean, stddev) ~> do {
      u1 = math.div(math.add(entropy.next_u32(), 1), 4294967296)
      u2 = math.div(math.add(entropy.next_u32(), 1), 4294967296)
      r = math.sqrt(math.sub(0, math.mul(2, math.log(u1))))
      theta = math.mul(math.mul(2, math.pi()), u2)
      z = math.mul(r, math.cos(theta))
      math.add(mean, math.mul(stddev, z))
    },

    -- Generate an exponentially distributed non-negative number with `lambda`.
    exponential: (lambda) ~> do {
      u = math.div(math.add(entropy.next_u32(), 1), 4294967296)
      math.div(math.sub(0, math.log(u)), lambda)
    },

    -- Generate a Poisson-distributed non-negative integer with `lambda`.
    poisson: (lambda) ~> do {
      threshold = math.exp(math.sub(0, lambda))
      while { p: 1.0, k: 0 } {
        [p, k] ~> if p <= threshold {
          { out: k }
        } else {
          u = math.div(entropy.next_u32(), 4294967296)
          { state: { p: math.mul(p, u), k: k + 1 } }
        }
      }
    },

    -- Generate a binomial-distributed integer in `[0, n]` with `n` trials and success probability `p`.
    binomial: (n, p) ~> do {
      while { i: 0, successes: 0 } {
        [i, successes] ~> if i >= n {
          { out: successes }
        } else {
          u = math.div(entropy.next_u32(), 4294967296)
          if u < p {
            { state: { i: i + 1, successes: successes + 1 } }
          } else {
            { state: { i: i + 1, successes: successes } }
          }
        }
      }
    },

    -- Seeded variants (pure-Handl, no FFI)
    seeded_int: (seed, max) ~> math.mod(hash(seed, 0), max + 1),

    seeded_float: (seed, max) ~> math.mul(math.div(hash(seed, 0), 2147483647), max),

    seeded_bool: (seed) ~> math.mod(hash(seed, 0), 2) == 0,

    seeded_pick: (seed, xs) ~> do {
      i = math.mod(hash(seed, 0), arr_len(xs))
      xs[i]
    },

    seeded_choice: (seed, xs, count) ~> do {
      n = arr_len(xs)
      if n == 0 {
        []
      } else {
        do {
          while { m: count, k: 0, acc: [] } {
            [m, k, acc] ~> if m <= 0 {
              { out: arr_rev(acc) }
            } else {
              r = hash(seed, k)
              i = math.mod(r, n)
              { state: { m: m - 1, k: k + 1, acc: [xs[i], ...acc] } }
            }
          }
        }
      }
    },

    seeded_sample: seeded_sample,

    seeded_shuffle: (seed, xs) ~> seeded_sample(seed, xs, arr_len(xs)),

    seeded_string: (seed, len, charset) ~> do {
      cs = char.chars(charset)
      m = arr_len(cs)
      if m == 0 {
        ""
      } else {
        do {
          while { n: len, k: 0, acc: "" } {
            [n, k, acc] ~> if n <= 0 {
              { out: acc }
            } else {
              r = hash(seed, k)
              i = math.mod(r, m)
              { state: { n: n - 1, k: k + 1, acc: acc + cs[i] } }
            }
          }
        }
      }
    },

    seeded_gauss: (seed, mean, stddev) ~> do {
      s1 = hash(seed, 0)
      s2 = hash(seed, 1)
      u1 = math.div(math.add(s1, 1), 2147483647)
      u2 = math.div(math.add(s2, 1), 2147483647)
      r = math.sqrt(math.sub(0, math.mul(2, math.log(u1))))
      theta = math.mul(math.mul(2, math.pi()), u2)
      z = math.mul(r, math.cos(theta))
      math.add(mean, math.mul(stddev, z))
    }
  }
}
