--- Read and inspect environment variables through libc.
---
--- @details
--- This is the libc `getenv` backend for the `os` environment contract.
--- It is the only effectful layer; all other `os` operations are built on
--- top of it or are pure string manipulations.

from "../grade" import { Effect }

--- Read an environment variable.
--- @param {name} - the variable name
--- @returns {Value - the variable value, or null if unset}
export get: String ~[Effect]~> Value := (name) ~> do {
  ffi.call(
    "libc.so.6",
    "getenv",
    [name],
    ["cstr"],
    "cstr",
    false
  )
}

--- Check whether an environment variable is set.
--- @param {name} - the variable name
--- @returns {Bool - true if the variable is set}
export has: String ~[Effect]~> Bool := (name) ~> do {
  r = ffi.call(
    "libc.so.6",
    "getenv",
    [name],
    ["cstr"],
    "cstr",
    false
  );
  r != null
}
