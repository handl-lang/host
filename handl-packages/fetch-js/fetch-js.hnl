--- fetch-js -- `fetch` over the generated WebIDL bindings.
---
--- Browser/JS-host counterpart of fetch-c: the heavy lifting is the
--- sdkgen-generated adapter (generated/fetch-webidl-browser), which
--- marshals through the host-injected `js.call`; the returned Promise is
--- settled by the host-injected `js.await` (the JS host owns the event
--- loop, so only it can resolve a promise -- `js.await` is the general
--- interop bridge, not a fetch hook).

from "../generated/fetch-webidl-browser/WindowOrWorkerGlobalScope" import { window_or_worker_global_scope_fetch }
from "js" import { await as js_await }

--- Fetch `input` (a URL string or Request object; `init` follows the
--- WebIDL RequestInit shape), awaiting the promise. Yields `{ ok: resp }`
--- -- the resolved Response value -- or `{ err: JsError }`.
export fetch := (input, init) ~> do {
  r := window_or_worker_global_scope_fetch(input, init)
  if tag.tag_of(r) == "err" {
    r
  } else {
    { ok: js_await(tag.untag(r).value) }
  }
}
