verbose_flag :: {
  name: "verbose",
  short: "v",
  description: "Enable verbose output",
  default: "false",
  required: false
}

output_flag :: {
  name: "output",
  short: "o",
  description: "Output file path",
  default: "stdout",
  required: false
}

config_flag :: {
  name: "config",
  short: "c",
  description: "Path to config file",
  default: ".handl.toml",
  required: false
}

build_cmd :: {
  name: "build",
  description: "Build the project",
  flags: [verbose_flag, output_flag, config_flag],
  subcommands: [],
  handler: "build"
}

init_cmd :: {
  name: "init",
  description: "Initialize a new project",
  flags: [config_flag],
  subcommands: [],
  handler: "init"
}

test_cmd :: {
  name: "test",
  description: "Run tests",
  flags: [verbose_flag],
  subcommands: [],
  handler: "test"
}

root_cmd :: {
  name: "hnl",
  description: "handl language CLI tool",
  flags: [verbose_flag, config_flag],
  subcommands: [build_cmd, init_cmd, test_cmd],
  handler: ""
}

usage_text :: str.concat("Usage: ", str.concat(root_cmd.name, " [options] <command>"))

help_text :: str.concat(
    str.concat(
      str.concat(
        str.concat(
          str.concat(
            str.concat(
              str.concat(usage_text, "\n\n"),
              str.concat(root_cmd.description, "\n\nOptions:\n")
            ),
            "  --verbose, -v    Enable verbose output (default: false)\n"
          ),
          "  --config, -c     Path to config file (default: .handl.toml)\n"
        ),
        "\nCommands:\n"
      ),
      "  build    Build the project\n"
    ),
    str.concat("  init     Initialize a new project\n", "  test     Run tests")
  )

help_text
