Command :: {
  name: String,
  description: String,
  flags: List,
  subcommands: List,
  handler: String
}

find_subcommand :: (cmd: Command, name: String) ~> option.unwrap_or(array.find(cmd.subcommands, (sub: Command) ~> cmp.eq(sub.name, name)), { name: "" })

has_subcommands :: (cmd: Command) ~> bool.not(array.is_empty(cmd.subcommands))

route :: (cmd: Command, args: List) ~> bool.when(
    cmp.eq(option.unwrap_or(array.first(args), ""), ""),
    false,
    { command: cmd.name, matched: cmd, remaining: [] }
  )

resolve_command :: (root: Command, args: List) ~> bool.when(
    cmp.eq(option.unwrap_or(array.first(args), ""), ""),
    false,
    { command: root.name, matched: root, remaining: args }
  )

{
  find_subcommand: find_subcommand,
  has_subcommands: has_subcommands,
  route: route,
  resolve_command: resolve_command
}
