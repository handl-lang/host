Flag :: {
  name: String,
  short: String,
  description: String,
  default: String,
  required: Bool
}

Command :: {
  name: String,
  description: String,
  flags: List,
  subcommands: List,
  handler: String
}

format_flag_line :: (flag: Flag) ~> str.concat(
    str.concat(
      str.concat(str.concat("  --", flag.name), str.concat(", -", flag.short)),
      str.concat("    ", flag.description)
    ),
    str.concat(" (default: ", str.concat(flag.default, ")"))
  )

format_flag_lines :: (flags: List) ~> array.map(flags, (flag: Flag) ~> format_flag_line(flag))

format_subcommand_line :: (cmd: Command) ~> str.concat("  ", str.concat(cmd.name, str.concat("    ", cmd.description)))

format_subcommand_lines :: (cmds: List) ~> array.map(cmds, (cmd: Command) ~> format_subcommand_line(cmd))

build_usage :: (cmd: Command) ~> bool.when(
    array.is_empty(cmd.subcommands),
    false,
    str.concat(str.concat(str.concat("Usage: ", cmd.name), " [options]"), " <command>")
  )

build_help :: (cmd: Command) ~> {
  
    usage: build_usage(cmd),
    description: cmd.description,
    flags: format_flag_lines(cmd.flags),
    subcommands: format_subcommand_lines(cmd.subcommands)
  }

render_help :: (help: Object) ~> bool.when(
    array.is_empty(help.subcommands),
    false,
    str.concat(
      str.concat(
        str.concat(
          str.concat(help.usage, "\n\n"),
          help.description
        ),
        str.concat("\n\nOptions:\n", str.join(help.flags, "\n"))
      ),
      str.concat("\n\nCommands:\n", str.join(help.subcommands, "\n"))
    )
  )

generate_help :: (cmd: Command) ~> render_help(build_help(cmd))

{
  format_flag_line: format_flag_line,
  format_flag_lines: format_flag_lines,
  format_subcommand_line: format_subcommand_line,
  format_subcommand_lines: format_subcommand_lines,
  build_usage: build_usage,
  build_help: build_help,
  render_help: render_help,
  generate_help: generate_help
}
