--- ## Arrow type (function type)
---
--- Arrow(I, O) — function type from input product to output.
--- Use Pair for multi-argument input: Arrow(Pair(Arr(T), Int), Option(T))
--- Single arg: Arrow(Arr(T), Arr(T)) etc.
export Arrow :: (I, O) ~> do {
  { "__tag__": "arrow", "__registry__": "type",
    "input": I,
    "output": O }
}

--- ## Pair type (product arity for Arrow input)
---
--- Pair(A, B) — product of two types, used as Arrow input for multi-arg functions.
export Pair :: (A, B) ~> do {
  { "__tag__": "pair", "__registry__": "type",
    "fst": A,
    "snd": B }
}

--- ## Option type
---
--- Option(T) = T | Null. The "nullable" wrapper.
export Option :: (T) ~> do {
  { "__tag__": "option", "__registry__": "type",
    "of": T }
}