--- Low-level libc `clock_gettime` reader.
--- @details
--- Reads the given `clock_id` through `libc` `clock_gettime` and returns
--- the raw time as an integer number of nanoseconds. Used only by the
--- `time-c` backend.

from "type" import { Nat, Int }
from "../time" import { Clock }
from "ffi" import { FFI, Errno, call, errno }

--- C `struct timespec`.
Timespec := {
  tv_sec: Int,
  tv_nsec: Int
}

-- TODO(n-dim): effect row
read = (Int) ~[1]~> Nat

read_impl = (clock_id) ~> do {
  r = call(
    "libc.so.6",
    "clock_gettime",
    [clock_id],
    ["i32", "out_struct:{tv_sec:i64,tv_nsec:i64}"],
    "i32",
    false
  );
  if r.ret < 0 {
    error.raise("clock_gettime failed")
  } else {
    r.buf.tv_sec * 1000000000 + r.buf.tv_nsec
  }
}

Clock = () ~> ({ read: read_impl })

export read_ns := handle arr read with Clock()
