--- serve-epoll -- `serve` backend on concurrent-epoll.
---
--- A listener task accepts on the listen fd; each connection is a
--- spawned task that accumulates the request bytes, invokes the
--- handler, writes the serialized response, and loops while the peer
--- keeps the connection alive. HTTP/1.1 keep-alive, pipelined requests,
--- chunked request bodies, and optional TLS (`opts.tls` = { cert, key },
--- driven by the scheduler's tls_* ops); no chunked responses (v0).
---
--- Handlers:
---   serve(handler, opts)      plain arrow `req ~> resp`, called inline
---   serve_task(handler, opts) step-arrow handler, invoked via `enter`
---                             so it may suspend on scheduler ops
---
--- Task arrows reach imported names through the local ` := ` aliases
--- below -- serialized task envs drop `import` bindings (runtime
--- limitation, same as fetch-c). The same caveat applies to handler
--- arrows passed in by callers.

from "../concurrent-epoll/concurrent-epoll" import { run, tcp_listen }
from "../http_rfc/http_rfc" import * as rfcm
from "../tls-libssl/tls-libssl" import * as tlsp
from "bytes" import * as bytes
from "str" import * as str

--- task arrows keep their ` := `-bound env when spawned/resumed, so the
--- codec arrows (unregistered module fns) are aliased by name. `bytes.*`
--- and other canonical `mod.fn` names resolve through the wire registry
--- in every context and need no alias (runtime limitation workaround,
--- same pattern as fetch-c).
try_parse := rfcm.try_parse_request

serialize_resp := rfcm.serialize_response

--- exported so callers can build a shared SSL_CTX for `opts.tls`.
export tls_ctx_server := tlsp.ctx_server

tls_wrap_server := tlsp.wrap_server

MAX_REQ := 1048576

--- per-connection op selection: TLS connections use the scheduler's
--- tls_* ops, plain ones the socket ops.
read_call := (s) ~> if hash_map.get_or(s, "tls", false) {
  { name: "tls_recv", ssl: s.ssl, fd: s.fd }
} else {
  { name: "recv", fd: s.fd }
}

send_call := (s, buf) ~> if hash_map.get_or(s, "tls", false) {
  { name: "tls_send", ssl: s.ssl, fd: s.fd, buf: buf }
} else {
  { name: "send", fd: s.fd, buf: buf }
}

close_call := (s) ~> if hash_map.get_or(s, "tls", false) {
  { name: "tls_close", ssl: s.ssl, fd: s.fd }
} else {
  { name: "close", fd: s.fd }
}

--- keep-alive decision: HTTP/1.1 persists unless `connection: close`;
--- HTTP/1.0 closes unless `connection: keep-alive`.
keep_alive := (req) ~> do {
  c := str.lower(hash_map.get_or(req.headers, "connection", ""))
  if req.version == "HTTP/1.0" { c == "keep-alive" } else { c != "close" }
}

--- serialize `resp` and send it; state continues at "sent" to finish
--- any partial write. The connection header reflects s.ka.
reply := (s, resp, head_only) ~> do {
  ka := hash_map.get_or(s, "ka", false)
  hs := hash_map.get_or(resp, "headers", {})
  resp2 := hash_map.merge(resp, { headers: hash_map.set(hs,
    "connection", if ka { "keep-alive" } else { "close" }) })
  buf := serialize_resp(resp2, head_only)
  { call: send_call(s, buf),
    state: hash_map.merge(s, { phase: "sent", out: buf, off: 0 }) }
}

--- dispatch to the handler per mode, then reply. Task-mode handlers
--- get the parsed req as their init; plain handlers get a direct call.
respond := (s, req) ~> do {
  if s.mode == "task" {
    { call: { name: "enter", arrow: s.handler, init: req },
      state: hash_map.merge(s, { phase: "responded", req: req }) }
  } else {
    reply(s, s.handler(req), req.method == "HEAD")
  }
}

--- "read"/"got" accumulate into s.buf; "parse" decodes one request
--- and loops while keep-alive holds. Bytes past `consumed` stay in
--- s.buf so pipelined requests parse without another recv.
conn_task := (s) ~> match s.phase {
  "tls": {
    call: { name: "tls_accept", ssl: s.ssl, fd: s.fd },
    state: hash_map.merge(s, { phase: "hs" })
  },
  "hs": do {
    if s.result == null {
      { call: read_call(s), state: hash_map.merge(s, { phase: "got" }) }
    } else {
      -- handshake failed: drop the connection
      { call: close_call(s), state: hash_map.merge(s, { phase: "done" }) }
    }
  },
  "read": {
    call: read_call(s),
    state: hash_map.merge(s, { phase: "got" })
  },
  "got": do {
    if bytes.len(s.result) == 0 {
      -- peer closed before/without a full request
      { call: close_call(s),
        state: hash_map.merge(s, { phase: "done" }) }
    } else {
      { state: hash_map.merge(s, { phase: "parse",
        buf: bytes.concat(s.buf, s.result) }) }
    }
  },
  "parse": do {
    parsed := try_parse(s.buf)
    if bytes.len(s.buf) > MAX_REQ {
      reply(hash_map.merge(s, { ka: false }),
        { status: 431, body: "request too large" }, false)
    } else if parsed == null {
      { call: read_call(s),
        state: hash_map.merge(s, { phase: "got" }) }
    } else if parsed.req == null {
      reply(hash_map.merge(s, { ka: false }),
        { status: 400, body: "bad request" }, false)
    } else {
      respond(hash_map.merge(s, {
          buf: bytes.slice(s.buf, parsed.consumed,
            bytes.len(s.buf) - parsed.consumed),
          ka: keep_alive(parsed.req) }),
        parsed.req)
    }
  },
  "responded": reply(s, s.result, s.req.method == "HEAD"),
  "sent": do {
    n := s.off + s.result.sent
    if n >= bytes.len(s.out) {
      if hash_map.get_or(s, "ka", false) {
        if bytes.len(s.buf) > 0 {
          -- pipelined bytes already buffered: parse without recv
          { state: hash_map.merge(s, { phase: "parse" }) }
        } else {
          { call: read_call(s),
            state: hash_map.merge(s, { phase: "got" }) }
        }
      } else {
        { call: close_call(s),
          state: hash_map.merge(s, { phase: "done" }) }
      }
    } else {
      { call: send_call(s, bytes.slice(s.out, n, bytes.len(s.out) - n)),
        state: hash_map.merge(s, { phase: "sent", off: n }) }
    }
  },
  "done": { out: null }
}

--- accept forever; spawn a conn_task per connection.
export listener_task := (s) ~> match s.phase {
  "accept": {
    call: { name: "accept", fd: s.lfd },
    state: hash_map.merge(s, { phase: "spawn_conn" })
  },
  "spawn_conn": do {
    fd := s.result
    init := if hash_map.get_or(s, "tls", false) {
      { phase: "tls", fd: fd, ssl: tls_wrap_server(s.ctx, fd), tls: true,
        buf: bytes.from_list([]), handler: s.handler, mode: s.mode }
    } else {
      { phase: "read", fd: fd, tls: false,
        buf: bytes.from_list([]), handler: s.handler, mode: s.mode }
    }
    { call: { name: "spawn", task: conn_task, init: init },
      state: hash_map.merge(s, { phase: "accept" }) }
  },
  _: { out: null }
}

--- listener init shared by serve/serve_task: `opts.tls` = { cert, key }
--- switches every accepted connection to TLS.
listen_init := (handler, mode, opts) ~> do {
  lfd := tcp_listen({ host: hash_map.get_or(opts, "host", "0.0.0.0"),
                      port: opts.port })
  if hash_map.has(opts, "tls") {
    do {
      t := opts.tls
      { phase: "accept", lfd: lfd, handler: handler, mode: mode,
        tls: true, ctx: tls_ctx_server(t.cert, t.key) }
    }
  } else {
    { phase: "accept", lfd: lfd, handler: handler, mode: mode,
      tls: false, ctx: 0 }
  }
}

--- serve(handler, { port, host?, tls?: { cert, key } }) -- listen and
--- run the accept loop forever (blocks; this IS the process main loop).
export serve := (handler, opts) ~> do {
  run(listener_task, listen_init(handler, "plain", opts))
}

--- serve_task(handler, opts) -- handler is a step-arrow: it is
--- `enter`ed per request and may suspend on any scheduler op.
export serve_task := (handler, opts) ~> do {
  run(listener_task, listen_init(handler, "task", opts))
}
