--- serve-epoll tests: the Handl HTTP server and the libcurl async
--- client run as tasks in the same concurrent-epoll scheduler.

from "../concurrent-epoll/concurrent-epoll" import { run, tcp_listen }
from "../serve-epoll/serve-epoll" import { listener_task, tls_ctx_server }
from "../fetch-c/fetch-c" import { fetch_task }
from "../http_rfc/http_rfc" import * as rfc
from "../ws-c/ws-c" import { prepare, active_socket, close }
from "bytes" import * as bytes
from "../generated/libc-c-linux-x86_64/stdlib" import { system }

CURLWS_TEXT := 1

CERT := "/tmp/serve-epoll-test-cert.pem"

KEY := "/tmp/serve-epoll-test-key.pem"

--- self-signed cert for the TLS test (idempotent).
gen_cert := (_u) ~> do {
  _ := system("test -f " + CERT + " || openssl req -x509 -newkey rsa:2048 " +
    "-nodes -keyout " + KEY + " -out " + CERT + " -days 2 " +
    "-subj /CN=localhost >/dev/null 2>&1")
  system("test -f " + CERT)
}

--- plain-arrow handler: echoes method+path, marks a header.
--- `~> {` parses as a block; wrap the record literal in `do`.
handler := (req) ~> do {
  { status: 200,
    headers: { "x-served": "handl" },
    body: "hi " + req.method + " " + req.path }
}

--- step-arrow handler (mode "task"): suspends on sleep before replying.
slow_handler := (s) ~> match hash_map.get_or(s, "phase", "h") {
  "h": { call: { name: "sleep", ms: 1 },
         state: { phase: "r", req: s } },
  "r": { out: { status: 201, body: "slow " + s.req.path } }
}

--- spawn the listener + a fetch_task, await the client, return its
--- response. The listener never finishes; run() ends with the main
--- task.
--- listener init: tls/ctx/on_ws are optional (absent -> plain listener).
listener_init := (s) ~> do {
  base := { phase: "accept", lfd: s.lfd, handler: s.handler, mode: s.mode,
    tls: hash_map.get_or(s, "tls", false),
    ctx: hash_map.get_or(s, "ctx", 0) }
  if hash_map.has(s, "on_ws") {
    hash_map.merge(base, { on_ws: s.on_ws })
  } else {
    base
  }
}

--- WebSocket handler: echo the message back with a prefix.
ws_echo := (req, msg) ~> do { "echo:" + msg.text }

--- WebSocket client task (libcurl ws API driven by the scheduler).
ws_client := (s) ~> match s.phase {
  "open": do {
    h := prepare(s.url, {})
    { call: { name: "ws_open", h: h },
      state: hash_map.merge(s, { phase: "conn", h: h }) }
  },
  "conn": do {
    fd := active_socket(s.h)
    { call: { name: "ws_send", h: s.h, fd: fd,
              buf: bytes.utf8_encode(s.msg), flags: CURLWS_TEXT },
      state: hash_map.merge(s, { phase: "sent", fd: fd }) }
  },
  "sent": {
    call: { name: "ws_recv", h: s.h, fd: s.fd },
    state: hash_map.merge(s, { phase: "got" })
  },
  "got": do {
    frame := s.result
    { call: { name: "ws_close", h: s.h, fd: s.fd },
      state: hash_map.merge(s, { phase: "closed", frame: frame }) }
  },
  "closed": { out: s.frame }
}

--- supervisor: WS listener + WS client, one scheduler.
main_ws := (s) ~> match s.phase {
  "a": {
    call: { name: "spawn", task: listener_task, init: listener_init(s) },
    state: hash_map.merge(s, { phase: "b" })
  },
  "b": {
    call: { name: "spawn", task: ws_client,
            init: { phase: "open", url: s.url, msg: s.msg } },
    state: hash_map.merge(s, { phase: "c" })
  },
  "c": {
    call: { name: "await", task: s.result },
    state: hash_map.merge(s, { phase: "d" })
  },
  "d": { out: s.result }
}

main := (s) ~> match s.phase {
  "a": {
    call: { name: "spawn", task: listener_task, init: listener_init(s) },
    state: hash_map.merge(s, { phase: "b" })
  },
  "b": {
    call: { name: "spawn", task: fetch_task,
            init: { url: s.url, init: s.init } },
    state: hash_map.merge(s, { phase: "c" })
  },
  "c": {
    call: { name: "await", task: s.result },
    state: hash_map.merge(s, { phase: "d" })
  },
  "d": { out: s.result }
}

--- two sequential fetches: curl's CURLM pool reuses the keep-alive
--- connection, so the second request lands on the same conn_task.
main2 := (s) ~> match s.phase {
  "a": {
    call: { name: "spawn", task: listener_task, init: listener_init(s) },
    state: hash_map.merge(s, { phase: "b" })
  },
  "b": {
    call: { name: "spawn", task: fetch_task,
            init: { url: s.url, init: s.init } },
    state: hash_map.merge(s, { phase: "c" })
  },
  "c": {
    call: { name: "await", task: s.result },
    state: hash_map.merge(s, { phase: "d" })
  },
  "d": {
    call: { name: "spawn", task: fetch_task,
            init: { url: s.url2, init: s.init } },
    state: hash_map.merge(s, { phase: "e", r1: s.result })
  },
  "e": {
    call: { name: "await", task: s.result },
    state: hash_map.merge(s, { phase: "f" })
  },
  "f": { out: { r1: s.r1, r2: s.result } }
}

serve_once := (handler, mode, url, init, port) ~> do {
  lfd := tcp_listen({ host: "127.0.0.1", port: port })
  r := run(main, { phase: "a", lfd: lfd, handler: handler,
                   mode: mode, url: url, init: init })
  r.main
}

test_serve_get := assert do {
  r := serve_once(handler, "plain", "http://127.0.0.1:18349/hi", {}, 18349)
  r.body
} := "hi GET /hi"

test_serve_headers := assert do {
  r := serve_once(handler, "plain", "http://127.0.0.1:18350/x", {}, 18350)
  hash_map.get_or(r.headers, "x-served", "missing")
} := "handl"

test_serve_post := assert do {
  r := serve_once(handler, "plain", "http://127.0.0.1:18351/echo",
    { method: "POST", body: "b1" }, 18351)
  r.body
} := "hi POST /echo"

test_serve_task_handler := assert do {
  r := serve_once(slow_handler, "task",
    "http://127.0.0.1:18352/later", {}, 18352)
  r.body + "|" + type.to_string(r.status)
} := "slow /later|201"

--- keep-alive: the server advertises it and a second request on the
--- reused connection succeeds.
test_serve_keepalive := assert do {
  lfd := tcp_listen({ host: "127.0.0.1", port: 18353 })
  r := run(main2, { phase: "a", lfd: lfd, handler: handler,
    mode: "plain", url: "http://127.0.0.1:18353/one",
    url2: "http://127.0.0.1:18353/two", init: {} })
  m := r.main
  hash_map.get_or(m.r1.headers, "connection", "?") + "|" + m.r2.body
} := "keep-alive|hi GET /two"

--- the handler sees the exact request body (Content-Length path).
test_serve_body_echo := assert do {
  lfd := tcp_listen({ host: "127.0.0.1", port: 18354 })
  r := run(main, { phase: "a", lfd: lfd,
    handler: (req) ~> do {
      { status: 200,
        body: req.body + "|" + type.to_string(bytes.len(req.body_bytes)) }
    },
    mode: "plain", url: "http://127.0.0.1:18354/echo",
    init: { method: "POST", body: "b1" } })
  r.main.body
} := "b1|2"

--- TLS: the listener wraps each connection in libssl (driven by the
--- scheduler's tls_* ops) and a curl client fetches over https.
test_serve_tls := assert do {
  _ := gen_cert(null)
  lfd := tcp_listen({ host: "127.0.0.1", port: 18355 })
  r := run(main, { phase: "a", lfd: lfd, handler: handler, mode: "plain",
    tls: true, ctx: tls_ctx_server(CERT, KEY),
    url: "https://127.0.0.1:18355/tls", init: { insecure: true } })
  r.main.body
} := "hi GET /tls"

--- WebSocket: the listener upgrades the request and runs the frame loop
--- while a libcurl ws client task talks to it on the same scheduler.
test_serve_ws_echo := assert do {
  lfd := tcp_listen({ host: "127.0.0.1", port: 18356 })
  r := run(main_ws, { phase: "a", lfd: lfd, handler: handler,
    mode: "plain", on_ws: ws_echo,
    url: "ws://127.0.0.1:18356/ws", msg: "hi" })
  f := r.main
  f.op + "|" + bytes.utf8_decode(f.payload)
} := "text|echo:hi"

--- chunked request bodies decode (chunk extensions ignored).
test_chunked_parse := assert do {
  buf := bytes.utf8_encode(
    "POST /c HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n" +
    "4\r\nWiki\r\n5;ext=x\r\npedia\r\n0\r\n\r\n")
  r := rfc.try_parse_request(buf)
  r.req.body + "|" + type.to_string(r.consumed == bytes.len(buf))
} := "Wikipedia|true"

--- an incomplete chunk stream asks for more bytes.
test_chunked_partial := assert do {
  buf := bytes.utf8_encode(
    "POST /c HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n4\r\nWi")
  type.to_string(rfc.try_parse_request(buf) == null)
} := "true"
