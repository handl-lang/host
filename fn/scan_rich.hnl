-- scan: prefix sums — accumulate and output each intermediate.
-- Rich-loop version of scan, written as an arrow graph over list primitives.
-- Contract: inferred from the step function's guarantee.
--
-- Graph structure:
--   loop (fold_step >>> first(list.cons))
--
-- The loop processes elements one at a time:
--   - apply step function f to (current accumulator, head of remaining)
--   - cons the intermediate accumulator value onto the output list
--   - repeat until input is exhausted

rec {
  remaining: input.0,
  f:         input.1,
  acc:       input.2,
  out:       []
} (
  state ~> match state.remaining {
    []: return state.out,

    [h, ...t]: {
      y :: state.f({ acc: state.acc, h: h })
      {
        state: {
          remaining: t,
          f:         state.f,
          acc:       y,
          out:       [y, ...state.out]
        }
      }
    }
  }
)
