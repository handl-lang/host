cap "rand.seeded_pick"
cap "rand.seeded_choice"
cap "rand.seeded_sample"
cap "rand.seeded_shuffle"
cap "rand.seeded_string"
cap "rand.seeded_gauss"
op "rand.int" : Value... -> Number
op "rand.float" : Value... -> Number
op "rand.bool" : () -> Bool
op "rand.pick" : Array -> Value
op "rand.choice" : (Array, Number) -> Array
op "rand.sample" : (Array, Number) -> Array
op "rand.shuffle" : Array -> Array
op "rand.weighted_pick" : (Array, Array) -> Value
op "rand.string" : Value... -> String
op "rand.bytes" : Number -> Array
op "rand.uuid" : () -> String
op "rand.gauss" : (Number, Number) -> Number
op "rand.exponential" : Number -> Number
op "rand.poisson" : Number -> Number
op "rand.binomial" : (Number, Number) -> Number
op "rand.perlin_1d" : Number -> Number
op "rand.perlin_2d" : (Number, Number) -> Number
op "rand.perlin_3d" : (Number, Number, Number) -> Number
op "rand.simplex_2d" : (Number, Number) -> Number
op "rand.simplex_3d" : (Number, Number, Number) -> Number
op "rand.seeded_int" : (Number, Number, Number) -> Number
op "rand.seeded_float" : (Number, Number, Number) -> Number
op "rand.seeded_bool" : Number -> Bool
op "rand.seeded_pick" : (Number, Array) -> Value
op "rand.seeded_choice" : (Number, Array, Number) -> Array
op "rand.seeded_sample" : (Number, Array, Number) -> Array
op "rand.seeded_shuffle" : (Number, Array) -> Array
op "rand.seeded_string" : (Number, Number) -> String
op "rand.seeded_gauss" : (Number, Number, Number) -> Number

