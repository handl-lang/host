// sort: insertion sort over a list.
// Written as an arrow graph over insert.
// Contract: Sorted(output) — INFERRED from insert's inferred Sorted contract.
//
// Graph structure:
//   loop(comp(insert, first(id)))
//
// The loop processes elements one at a time:
//   - take next element from input
//   - insert it into the accumulator (which is kept sorted)
//   - repeat until input is exhausted

loop { remaining: input, acc: [] }(
  proc (state) -> match state.remaining {
    []: { out: state.acc },
    [h, ...t]: { state: { remaining: t, acc: insert({ elem: h, acc: state.acc }) } }
  }
)
