--- fs.read — read a file via std::fs::read_to_string.
--- fs.write — write content via std::fs::write.
--- fs.exists — check path existence via std::path::Path::exists.
--- fs.remove — remove a file or directory via std::fs.
--- fs.list — list directory entries via std::fs::read_dir.
--- env.get — get an environment variable via std::env::var.
--- env.has — check whether an environment variable is set.
--- env.keys — list all environment variable names via std::env::vars.
--- path.join — join path components via std::path::PathBuf.
--- path.resolve — join and canonicalize via std::path::PathBuf::canonicalize.
--- path.basename — return the file name component via std::path.
--- path.dirname — return the directory component via std::path.
--- path.extname — return the file extension via std::path.
--- time.now — return epoch milliseconds via std::time::SystemTime.
--- time.epoch — return epoch seconds via std::time::SystemTime.
--- cmd.run — run a command via std::process::Command.
--- process.spawn — spawn a child process via std::process::Command.
--- process.kill — kill a managed process via std::process::Child::kill.
--- process.wait — block until a process exits via std::process::Child::wait.
--- process.status — poll a process via std::process::Child::try_wait.
--- tmp.file — return a unique temp file path under std::env::temp_dir.
--- tmp.dir — create and return a unique temp directory.
--- socket.connect — connect to a TCP address via std::net::TcpStream.
--- socket.send — send data on a TCP socket.
--- socket.recv — receive data from a TCP socket.
--- socket.close — close a TCP socket handle.
--- sig.send — send a signal to a process via platform signal APIs.
--- sig.list — list supported signal names.
cap "fs.read"
cap "fs.write"
cap "fs.exists"
cap "fs.remove"
cap "fs.list"
cap "env.get"
cap "env.has"
cap "env.keys"
cap "path.join"
cap "path.resolve"
cap "path.basename"
cap "path.dirname"
cap "path.extname"
cap "time.now"
cap "time.epoch"
cap "cmd.run"
cap "process.spawn"
cap "process.kill"
cap "process.wait"
cap "process.status"
cap "tmp.file"
cap "tmp.dir"
cap "socket.connect"
cap "socket.send"
cap "socket.recv"
cap "socket.close"
cap "sig.send"
cap "sig.list"
