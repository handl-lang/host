op "env.has" : String -> Value
op "env.keys" : -> Value
op "path.join" : String -> String
op "path.resolve" : String -> String
op "path.basename" : String -> String
op "path.dirname" : String -> String
op "path.extname" : String -> String
op "time.now" : -> Value
op "time.epoch" : -> Value
op "cmd.run" : String -> Value
op "process.spawn" : String -> Value
op "process.kill" : Value -> Value
op "process.wait" : Value -> Value
op "process.status" : Value -> Value
op "tmp.file" : -> String
