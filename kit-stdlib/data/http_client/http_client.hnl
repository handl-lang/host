--- http.get — issue an HTTP GET request to a URL, optionally with headers.
--- http.post — issue an HTTP POST request with a body, optionally with headers.
--- http.put — issue an HTTP PUT request with a body, optionally with headers.
--- http.patch — issue an HTTP PATCH request with a body, optionally with headers.
--- http.delete — issue an HTTP DELETE request, optionally with headers.
--- http.head — issue an HTTP HEAD request, optionally with headers.
--- http.request — issue a full HTTP request with method, url, body, and headers.
cap "http.get"
cap "http.post"
cap "http.put"
cap "http.patch"
cap "http.delete"
cap "http.head"
cap "http.request"
op "http.get" : String -> Value
  guarantee: True
op "http.post" : String -> Value
  guarantee: True
op "http.put" : String -> Value
  guarantee: True
op "http.patch" : String -> Value
  guarantee: True
op "http.delete" : String -> Value
  guarantee: True
op "http.head" : String -> Value
  guarantee: True
op "http.request" : String -> Value
  guarantee: True
