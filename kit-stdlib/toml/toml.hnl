--- toml.parse — parse a TOML string into a value.
--- toml.stringify — serialize a value to a TOML string.
cap "toml.parse"
cap "toml.stringify"
op "toml.parse" : String -> Value
  guarantee: True
op "toml.stringify" : Value -> String
  guarantee: IsString(output)

handl "toml.parse" = rust_toml_parse
handl "toml.stringify" = rust_toml_stringify
