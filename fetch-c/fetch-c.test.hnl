--- fetch-c tests: libcurl backend against a local canned HTTP server
--- (test_server.py — serves exactly one GET and one POST then exits).

from "./fetch-c" import { fetch, fetch_task }
from "../concurrent-epoll/concurrent-epoll" import { run }
from "../generated/libc-c-linux-x86_64/stdlib" import { system }

is_err := (r) ~> tag.tag_of(r) == "err"

val_of := (r) ~> tag.untag(r).value

--- poll for the server's readiness sentinel via system("test -f")
wait_ready := (_u) ~> do {
  while { n: 0 } {
    (st) ~> do {
      r := system("test -f /tmp/fetch-c-test-ready")
      if st.n > 50 {
        { out: false }
      } else if is_err(r) {
        { state: { n: st.n + 1 } }
      } else if val_of(r) == 0 {
        { out: true }
      } else {
        _ := system("sleep 0.1")
        { state: { n: st.n + 1 } }
      }
    }
  }
}

start_server := (_u) ~> do {
  _ := system("rm -f /tmp/fetch-c-test-ready")
  _ := system("python3 handl-packages/fetch-c/test_server.py >/dev/null 2>&1 &")
  wait_ready(null)
}

--- bound every transfer: a fixture that fails to bind leaves connections
--- unanswered, and curl_easy_perform has no default timeout — without
--- timeout_ms a wedged port parks the whole `hnl test` run in poll()
--- forever instead of failing the test.
base_init := { timeout_ms: 15000 }

test_get := assert do {
  _ := start_server(null)
  r := fetch("http://127.0.0.1:18347/", base_init)
  r.status
} := 200

test_get_body := assert do {
  _ := wait_ready(null)
  r := fetch("http://127.0.0.1:18347/", base_init)
  r.body
} := "{\"hello\":\"handl\"}"

test_get_headers := assert do {
  _ := wait_ready(null)
  r := fetch("http://127.0.0.1:18347/", base_init)
  hash_map.get_or(r.headers, "x-test", "missing")
} := "yes"

test_post_echo := assert do {
  _ := wait_ready(null)
  r := fetch("http://127.0.0.1:18347/echo",
    { method: "POST", body: "hndl", headers: { "Content-Type": "text/plain" },
      timeout_ms: 15000 })
  r.body
} := "{\"echo\":\"hndl\"}"

--- async: two fetch_task transfers parked on the shared CURLM + epoll,
--- spawned and awaited like any other task.
fetch_pair := (s) ~> match s.phase {
  "a": {
    call: { name: "spawn", task: fetch_task,
            init: { url: "http://127.0.0.1:18347/",
                    init: { timeout_ms: 120000 } } },
    state: { phase: "b" }
  },
  "b": {
    call: { name: "spawn", task: fetch_task,
            init: { url: "http://127.0.0.1:18347/echo",
                    init: { method: "POST", body: "async",
                            timeout_ms: 120000 } } },
    state: { phase: "c", t1: s.result }
  },
  "c": {
    call: { name: "await", task: s.t1 },
    state: { phase: "d", t2: s.result }
  },
  "d": {
    call: { name: "await", task: s.t2 },
    state: { phase: "e", r1: s.result }
  },
  "e": { out: s.result.body + "|" + s.r1.body }
}

test_fetch_async := assert do {
  _ := wait_ready(null)
  r := run(fetch_pair, { phase: "a" })
  r.main
} := "{\"echo\":\"async\"}|{\"hello\":\"handl\"}"

test_done := assert do {
  r := fetch("http://127.0.0.1:18347/done", base_init)
  r.status
} := 200
