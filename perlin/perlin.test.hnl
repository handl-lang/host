from "./perlin" import { perlin_1d, perlin_2d, perlin_3d }

test_perlin_1d_range :: assert math.clamp(perlin_1d(0.5), -1, 1) = perlin_1d(0.5)

test_perlin_1d_stability :: assert perlin_1d(0.5) = perlin_1d(0.5)

test_perlin_1d_boundary :: assert perlin_1d(1.0) = perlin_1d(1.0)

test_perlin_2d_range :: assert math.clamp(perlin_2d(0.5, 0.5), -1, 1) = perlin_2d(0.5, 0.5)

test_perlin_3d_range :: assert math.clamp(perlin_3d(0.5, 0.5, 0.5), -1, 1) = perlin_3d(0.5, 0.5, 0.5)
