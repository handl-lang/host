from "../str-handl" import * as str
from "../transform" import { reduce }

is_blank := (line) ~> str.is_empty(str.trim(line))

test_isblank_true := assert is_blank("   ") = true
test_isblank_false := assert is_blank("abc") = false

test_reduce_blank := assert reduce([[" ", " "], "", [acc, c]~> if is_blank(acc + c) { acc + c } else { acc }]) = "  "
test_reduce_not_blank := assert reduce([[" ", "a"], "", [acc, c]~> if is_blank(acc + c) { acc + c } else { acc }]) = " "
