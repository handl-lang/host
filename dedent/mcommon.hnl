from "../str-handl" import * as str
from "../transform" import { reduce }

export common_prefix := [a, b] ~> do {
  reduce([str.split(a, ""), "", [acc, c]~> do {
    result := acc
    if str.starts_with(b, acc + c) {
      result := acc + c
    }
    result
  }])
}

export prefix_of := (line) ~> do {
  reduce([str.split(line, ""), "", [acc, c]~> do {
    result := acc
    if str.is_empty(str.trim(acc + c)) {
      result := acc + c
    }
    result
  }])
}

test_common := assert common_prefix("Hello", "Hey") = "H"
test_prefix := assert prefix_of("   Hello") = "   "
