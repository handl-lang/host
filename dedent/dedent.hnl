--- Dedent multi-line text by removing a shared leading whitespace prefix.
---
--- @details
--- The `dedent` package provides a single arrow that normalizes line
--- endings, strips surrounding blank lines, finds the largest leading
--- whitespace prefix common to all non-blank lines, and removes it while
--- keeping relative indentation intact.

from "../str-handl" import * as str
from "../transform" import { map, filter, reduce }
from "../char" import * as char

--- Remove the largest common leading whitespace prefix from `text`.
---
--- @param {text} - the multi-line string to dedent
--- @returns {String - the dedented text, or the empty string for blank input}
--- @details
--- Blank and whitespace-only lines are ignored when computing the shared
--- prefix. They are output as empty lines so no trailing whitespace remains.
export dedent := (text) ~> do {
  is_blank := (line) ~> str.is_empty(line) || reduce([char.chars(line), true, [acc, c]~> do {
    result := acc;
    if c != "" {
      if !char.is_whitespace(c) && char.code_point(c) != 160 {
        result := false;
      };
    };
    result
  }]);

  common_prefix := [a, b]~> {
    n := if char.length(a) < char.length(b) { char.length(a) } else { char.length(b) };
    while { i: 0, prefix: "", a: a, b: b, n: n } {
      [state]~> if state.i < state.n {
        if char.at(state.a, state.i) == char.at(state.b, state.i) {
          { state: { i: state.i + 1, prefix: state.prefix + char.at(state.a, state.i), a: state.a, b: state.b, n: state.n } }
        } else {
          { out: state.prefix }
        }
      } else {
        { out: state.prefix }
      }
    }
  };

  prefix_of := (line) ~> do {
    state := reduce([char.chars(line), { prefix: "", done: false }, [state, c]~> do {
      result := state;
      if c != "" {
        if !state.done && (char.is_whitespace(c) || char.code_point(c) == 160) {
          result := { prefix: state.prefix + c, done: false };
        };
        if !state.done && !char.is_whitespace(c) && char.code_point(c) != 160 {
          result := { prefix: state.prefix, done: true };
        };
      };
      result
    }]);
    state.prefix
  };

  normalized := str.replace(
    str.replace(text, "\r\n", "\n"),
    "\r",
    "\n"
  );
  trimmed := str.trim_matches(normalized, "\n");

  result := do {
    lines := str.lines(trimmed);
    non_blank := filter(lines, line ~> !is_blank(line));

    prefixes := map(non_blank, prefix_of);
    common_full := "";
    if prefixes != [] {
      common_full := reduce([prefixes, prefixes[0], [acc, p]~> common_prefix(acc, p)]);
    };

    line_count := reduce([non_blank, 0, [acc, _]~> acc + 1]);
    common := common_full;
    if line_count <= 1 {
      common := prefix_of(common_full);
    };

    strip_line := (line) ~> do {
      line_result := str.strip_prefix(line, common);
      if is_blank(line) {
        line_result := "";
      };
      line_result
    };

    str.join(map(lines, strip_line), "\n")
  };

  if str.is_empty(str.trim(trimmed)) {
    result := "";
  };

  result
}
