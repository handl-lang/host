--- dedent — strips common leading whitespace from multi-line strings.
---
--- Find the minimum indentation across non-blank lines and remove it from every
--- line, preserving relative indentation.
---
--- # dedent.dedent
---
--- `dedent.dedent(text: String) -> String`
---
--- Strips common leading whitespace from all lines of `text`.
---
--- Algorithm:
---   1. Normalize CRLF (`\r\n`) to LF (`\n`).
---   2. Trim leading/trailing newlines.
---   3. If empty after trim, return `""`.
---   4. Split into lines.
---   5. Find the minimum leading-whitespace count across non-blank lines.
---   6. Strip that many leading whitespace chars from each line.
---   7. Re-join with `\n`.
---
--- Blank lines (whitespace-only) are ignored when computing the common
--- indent. Both spaces and tabs count as leading whitespace.
---
--- ## Examples
---
--- ```hnl
--- dedent.dedent("    Hello,\n    World!")
--- -- => "Hello,\nWorld!"
---
--- dedent.dedent("    Hello,\n      World!")
--- -- => "Hello,\n  World!"
---
--- dedent.dedent("  Hello,\r\n  World!")
--- -- => "Hello,\nWorld!"
--- ```
---
--- ## Contract
---
--- IsDedented(output) — output has no common leading whitespace beyond
--- the relative indentation of the input.

from 'str' import * as 'str'
from 'fn' import * as 'fn'

cap "dedent.dedent"
{
  dedent: text ~> {
    indent_of = line ~> str.length(line) - str.length(str.trim_start(line))
    is_blank = line ~> str.trim(line) == ""
    strip_indent = [line, n] ~>

    if indent_of(line) >= n {
      str.slice(line, n, str.length(line))
    } else {
      line
    }

    trimmed = str.trim_matches(str.replace(text, "\r\n", "\n"), "\n")

    if str.is_empty(trimmed) {
      ""
    } else {
      lines = str.lines(trimmed)
      common = while { lines: lines, min: 0, seen: false } {
        [lines, min, seen] ~> match lines {
          []: { out: min },
          [h, ...t]: if is_blank(h) {
            { state: { lines: t, min: min, seen: seen } }
          } else {
            c = indent_of(h)
            { state: {
                lines: t,
                min  : if seen { if c < min { c } else { min } } else { c },
                seen : true
              } }
          }
        }
      }
      str.join(fn.map(line ~> strip_indent(line, common), lines), "\n")
    }
  }
}
