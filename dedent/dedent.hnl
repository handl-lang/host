from "str" import * as str
from "combinators" import * as combinators

--- Dedents a multi-line string by removing its common indentation.
---
--- @details
--- CRLF line endings are normalized to LF. Leading and trailing newlines
--- are removed. Blank lines do not contribute to the common indentation.
--- Spaces and tabs are treated as leading whitespace.
---
--- The relative indentation between non-blank lines is preserved.
---
--- @example
--- ```hnl
--- `
---     Hello
---     World
--- ` >>> dedent
--- -- => `
--- Hello
--- World
--- `
---
--- @example
--- `
---     Hello
---       World
--- ` >>> dedent
--- -- => `
--- Hello
---   World
--- `
--- ```
export dedent = text ~> {
  normalized = str.replace(text, "\r\n", "\n")
  trimmed = str.trim_matches(normalized, "\n")

  if str.is_empty(trimmed) {
    return ""
  }

  lines = str.lines(trimmed)

  indent_of = line ~> {
    length = str.length(line)
    trimmed_length = str.length(str.trim_start(line))

    length - trimmed_length
  }

  is_blank = line ~> str.is_empty(str.trim(line))

  common = while { lines: lines, min: 0, seen: false } {
    [line, ...rest] ~> match lines {
      []: {
        out: min
      }

      [line, ...rest]: {
        if is_blank(line) {
          return {
            state: {
              lines: rest,
              min,
              seen
            }
          }
        }

        indent = indent_of(line)

        if !seen {
          return {
            state: {
              lines: rest,
              min  : indent,
              seen : true
            }
          }
        }

        if indent < min {
          return {
            state: {
              lines: rest,
              min  : indent,
              seen : true
            }
          }
        }

        {
          state: {
            lines: rest,
            min,
            seen: true
          }
        }
      }
    }
  }

  strip_indent = (line, n) ~> {
    indent = indent_of(line)

    if indent < n {
      return line
    }

    length = str.length(line)
    str.slice(line, n, length)
  }

  lines
  >>> combinators.map(strip_indent)
  >>> str.join("\n")
}
