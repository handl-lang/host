--- loader -- canonical text transforms for .hnl module loading.
---
--- This is the bootstrap loader: it must contain no `cap`/`op`/`handl`/
--- `import`/`tag`/`export` declaration lines (it is the code that strips
--- those from every other .hnl file).  It operates over the `char` and
--- `str` floors, which are injected into its bridge runtime by the host.
---
--- Design (ADR-0094): the Rust `handl-plugin-lib-handl` crate keeps only
--- the FFI seam (Module/Function trait impls, runtime caching, op
--- dispatch) plus a small bootstrap fallback (`mod bootstrap`) used to
--- build the `str`/`char` floors this file needs before it exists.  Once
--- a host installs a `HandlLoader` (`install_loader`), every text-level
--- transform -- declaration stripping, comment stripping, export
--- transformation, binding-separator detection, import/capability/tag
--- parsing, tag expansion -- is evaluated here, in pure handl, through
--- `HandlModule`'s cached per-thread runtime.
---
--- All line/offset arithmetic is in *character* units (`char.slice`,
--- `str.find` etc. are char-indexed), matching the Rust bootstrap.

do {
  -- ---------------------------------------------------------------------
  -- Character constants (no escapes needed beyond the canonical set)
  -- ---------------------------------------------------------------------

  nl :: char.from_code_point(10)
  tab :: char.from_code_point(9)
  dq :: char.from_code_point(34)
  sq :: char.from_code_point(39)
  backslash :: char.from_code_point(92)

  -- ---------------------------------------------------------------------
  -- List helpers
  -- ---------------------------------------------------------------------

  rev :: xs ~> do {
    while { xs: xs, acc: [] } {
      [xs, acc] ~> match xs {
        []: { out: acc },
        [h, ...t]: { state: { xs: t, acc: [h, ...acc] } }
      }
    }
  }

  list_len :: xs ~> do {
    while { xs: xs, n: 0 } {
      [xs, n] ~> match xs {
        []: { out: n },
        [h, ...t]: { state: { xs: t, n: n + 1 } }
      }
    }
  }

  head :: xs ~> match xs {
    []: "",
    [h, ...t]: h
  }

  last :: xs ~> head(rev(xs))

  member :: [x, xs] ~> do {
    while xs {
      st ~> match st {
        []: { out: false },
        [h, ...t]: if h == x { { out: true } } else { { state: t } }
      }
    }
  }

  all :: [xs, p] ~> do {
    while xs {
      st ~> match st {
        []: { out: true },
        [h, ...t]: if p(h) { { state: t } } else { { out: false } }
      }
    }
  }

  -- ---------------------------------------------------------------------
  -- String helpers (all indices are char indices)
  -- ---------------------------------------------------------------------

  slen :: s ~> char.length(s)
  atc :: [s, i] ~> char.slice(s, i, i + 1)
  stake :: [s, n] ~> char.slice(s, 0, n)
  sdrop :: [s, n] ~> char.slice(s, n, slen(s))
  trim :: s ~> str.trim(s)
  trim_start :: s ~> str.trim_start(s)
  blank :: s ~> slen(trim(s)) == 0
  indented :: s ~> do {
    c :: atc(s, 0)
    c == " " || c == tab
  }

  -- True when `t` starts with `kw` followed by a delimiter: end of
  -- string, space, tab, or one of the chars in `extras` (e.g. quotes).
  kw_match :: [t, kw, extras] ~> do {
    if str.starts_with(t, kw) {
      r :: sdrop(t, slen(kw))
      slen(r) == 0 || member(atc(r, 0), [" ", tab, ...extras])
    } else {
      false
    }
  }

  -- If `t` starts with `kw` followed by a delimiter, return the text
  -- after `kw`; else null.
  kw_rest :: [t, kw, extras] ~> do {
    if kw_match(t, kw, extras) {
      sdrop(t, slen(kw))
    } else {
      null
    }
  }

  -- Extract a `"..."` or `'...'` quoted string from the start of `s`
  -- (after leading whitespace).  Returns `{text, rest}` or null.
  extract_quoted :: s ~> do {
    t :: trim_start(s)
    q :: atc(t, 0)
    if q == dq || q == sq {
      r :: sdrop(t, 1)
      e :: str.find(r, q)
      if e < 0 {
        null
      } else {
        { text: stake(r, e), rest: sdrop(r, e + 1) }
      }
    } else {
      null
    }
  }

  -- First whitespace-delimited word of `s` (s already trimmed).
  first_word :: s ~> do {
    ws :: str.split_whitespace(s)
    match ws {
      []: "",
      [h, ...t]: h
    }
  }

  -- ---------------------------------------------------------------------
  -- strip_comments -- drop `--` comment lines
  -- ---------------------------------------------------------------------

  strip_comments :: s ~> do {
    kept :: while { xs: str.lines(s), acc: [] } {
      [xs, acc] ~> match xs {
        []: { out: rev(acc) },
        [h, ...t]: if str.starts_with(trim_start(h), "--") {
          { state: { xs: t, acc: acc } }
        } else {
          { state: { xs: t, acc: [h, ...acc] } }
        }
      }
    }
    str.join(kept, nl)
  }

  -- ---------------------------------------------------------------------
  -- strip_decls -- drop `cap`/`op`/`handl` declaration lines and indented
  -- `guarantee:`/`requires:`/`termination:` continuation lines.
  --
  -- NOTE: `import`/`from` lines are deliberately KEPT (byte-for-byte):
  -- the runtime is responsible for evaluating import statements via the
  -- kit grammar (`grammar.stmt-from.prefix` + `prim_import`), so the
  -- loader must not delete them.  `is_import_line` is still defined and
  -- used by `transform_export_to_object` to hoist those lines into the
  -- emitted `do { ... }` block.
  -- ---------------------------------------------------------------------

  is_import_line :: t ~> do {
    kw_match(t, "import", [dq, sq]) || kw_match(t, "from", [])
  }

  -- A top-level (non-indented) import statement line.
  is_top_import_line :: line ~> !indented(line) && is_import_line(trim_start(line))

  is_decl_line :: [line, t] ~> do {
    if indented(line) &&
       (str.starts_with(t, "guarantee") ||
        str.starts_with(t, "requires") ||
        str.starts_with(t, "termination")) {
      true
    } else {
      if kw_match(t, "cap", [dq]) ||
         kw_match(t, "op", [dq]) ||
         kw_match(t, "handl", [dq]) {
        true
      } else {
        false
      }
    }
  }

  strip_decls :: s ~> do {
    kept :: while { xs: str.lines(s), acc: [] } {
      [xs, acc] ~> match xs {
        []: { out: rev(acc) },
        [h, ...t]: if is_decl_line(h, trim_start(h)) {
          { state: { xs: t, acc: acc } }
        } else {
          { state: { xs: t, acc: [h, ...acc] } }
        }
      }
    }
    str.join(kept, nl)
  }

  -- ---------------------------------------------------------------------
  -- find_binding_sep -- locate the `::` (canonical) or legacy `=` bind
  -- separator at bracket depth 0, skipping `==`, `=>`, `>=`, `<=`, `!=`.
  -- `::` takes precedence and returns immediately; the first bare `=` is
  -- remembered but the scan continues.  Returns `{pos, len}` or null.
  -- ---------------------------------------------------------------------

  find_binding_sep :: s ~> do {
    while { xs: char.chars(s), i: 0, depth: 0, feq: 0 - 1 } {
      [xs, i, depth, feq] ~> match xs {
        []: if feq >= 0 {
          { out: { pos: feq, len: 1 } }
        } else {
          { out: null }
        },
        [c, ...t]: if c == "(" || c == "[" || c == "{" {
          { state: { xs: t, i: i + 1, depth: depth + 1, feq: feq } }
        } else {
          if c == ")" || c == "]" || c == "}" {
            { state: { xs: t, i: i + 1, depth: depth - 1, feq: feq } }
          } else {
            if c == ":" && depth == 0 {
              if atc(s, i + 1) == ":" {
                { out: { pos: i, len: 2 } } -- ::  bind
              } else {
                if atc(s, i + 1) == "=" {
                  { out: { pos: i, len: 2 } } -- :=  graded bind
                } else {
                  { state: { xs: t, i: i + 1, depth: depth, feq: feq } }
                }
              }
            } else {
              if c == "=" && depth == 0 {
                p :: if i > 0 { atc(s, i - 1) } else { "" }
                n :: atc(s, i + 1)
                if n == "=" || p == ">" || p == "<" || p == "!" || n == ">" {
                  { state: { xs: t, i: i + 1, depth: depth, feq: feq } }
                } else {
                  if feq < 0 {
                    { state: { xs: t, i: i + 1, depth: depth, feq: i } }
                  } else {
                    { state: { xs: t, i: i + 1, depth: depth, feq: feq } }
                  }
                }
              } else {
                { state: { xs: t, i: i + 1, depth: depth, feq: feq } }
              }
            }
          }
        }
      }
    }
  }

  -- ---------------------------------------------------------------------
  -- strip_export_name -- Strip generics `<...>` and type annotation
  -- `: Type` from an export name portion, returning the bare name.
  -- e.g. `len<T>: List(T) ~[1]~> Nat ` -> `len`
  -- ---------------------------------------------------------------------

  strip_export_name :: s ~> do {
    while { xs: char.chars(s), i: 0, depth: 0, acc: "" } {
      [xs, i, depth, acc] ~> match xs {
        []: { out: acc },
        [c, ...t]: if depth == 0 && (c == "<" || c == ":") {
          { out: acc }
        } else {
          if c == "(" || c == "[" || c == "{" {
            { state: { xs: t, i: i + 1, depth: depth + 1, acc: acc + c } }
          } else {
            if c == ")" || c == "]" || c == "}" {
              { state: { xs: t, i: i + 1, depth: depth - 1, acc: acc + c } }
            } else {
              { state: { xs: t, i: i + 1, depth: depth, acc: acc + c } }
            }
          }
        }
      }
    }
  }

  -- ---------------------------------------------------------------------
  -- transform_export_to_object -- rewrite top-level
  -- `export name : Type ~> Grade := expr` or `export name :: expr`
  -- declarations into an object literal
  -- `{ name: expr, ... }`.  No exports -> source unchanged.
  -- ---------------------------------------------------------------------

  is_export_line :: line ~> do {
    !indented(line) && str.starts_with(trim_start(line), "export ")
  }

  -- Emit `{ name: expr, ... }` from a list of `{name, expr}` records.
  emit_object :: entries ~> do {
    while { xs: entries, acc: "{ " } {
      [xs, acc] ~> match xs {
        []: { out: acc + " }" },
        [h, ...t]: if acc == "{ " {
          { state: { xs: t, acc: acc + h.name + ": " + trim(h.expr) } }
        } else {
          { state: { xs: t, acc: acc + ", " + h.name + ": " + trim(h.expr) } }
        }
      }
    }
  }

  -- ---------------------------------------------------------------------
  -- extract_quoted_path -- the first `"`/`'` quoted spec in a `from` line,
  -- returning { path, rest } or null.
  -- ---------------------------------------------------------------------

  extract_quoted_path :: line ~> do {
    t :: trim_start(line)
    if !str.starts_with(t, "from") { null } else {
      rest0 :: trim_start(sdrop(t, 4))
      q :: if slen(rest0) == 0 { "" } else { atc(rest0, 0) }
      if q != dq && q != sq { null } else {
        rest1 :: sdrop(rest0, 1)
        idx :: str.find(rest1, q)
        if idx < 0 { null } else {
          { path: stake(rest1, idx), rest: sdrop(rest1, idx + 1) }
        }
      }
    }
  }

  -- ---------------------------------------------------------------------
  -- from_export_to_import -- rewrite `from "p" export a, b` to the plain
  -- import `from "p" import a as __a, b as __b`; returns
  -- `{ line, names: [{name, alias}] }` or null when the line is not a
  -- re-export form.  Mirrors `handl_runtime::module_prep`'s handling.
  -- ---------------------------------------------------------------------

  from_export_to_import :: line ~> do {
    ep :: extract_quoted_path(line)
    if ep == null { null } else {
      tail :: trim_start(ep.rest)
      if !str.starts_with(tail, "export") { null } else {
        rest :: sdrop(tail, 6)
        c0 :: if slen(rest) == 0 { "" } else { atc(rest, 0) }
        if slen(rest) > 0 && c0 != " " && c0 != "\t" { null } else {
          scan :: while { xs: str.split(rest, ","), names: [], imps: [] } {
            [xs, names, imps] ~> match xs {
              []: { out: { names: rev(names), imps: str.join(rev(imps), ", ") } },
              [h, ...t]: do {
                n :: trim(h)
                if slen(n) == 0 {
                  { state: { xs: t, names: names, imps: imps } }
                } else {
                  { state: { xs: t, names: [{ name: n, alias: "__" + n }, ...names],
                             imps: [n + " as __" + n, ...imps] } }
                }
              }
            }
          }
          if list_len(scan.names) == 0 { null } else {
            { line: "from \"" + ep.path + "\" import " + scan.imps, names: scan.names }
          }
        }
      }
    }
  }

  -- Collect top-level import statements, in original order.  `from "..."
  -- export x, y` re-export lines are rewritten to plain `import ... as`
  -- statements so the hoisted `do { ... }` block binds the local aliases
  -- the record literal references.
  collect_import_lines :: s ~> do {
    while { xs: str.lines(s), acc: [] } {
      [xs, acc] ~> match xs {
        []: { out: rev(acc) },
        [h, ...t]: if is_top_import_line(h) {
          fe :: from_export_to_import(h)
          -- Inside a `do {}` block, `import <names>` trailing-tokens parsing
          -- does not stop at the newline — terminate each import with `;`
          -- so the following statement can't merge in.
          ln :: if fe == null { h } else { fe.line }
          { state: { xs: t, acc: [ln + ";", ...acc] } }
        } else {
          { state: { xs: t, acc: acc } }
        }
      }
    }
  }

  -- `s` with top-level import statements removed (all other lines kept).
  drop_import_lines :: s ~> do {
    kept :: while { xs: str.lines(s), acc: [] } {
      [xs, acc] ~> match xs {
        []: { out: rev(acc) },
        [h, ...t]: if is_top_import_line(h) {
          { state: { xs: t, acc: acc } }
        } else {
          { state: { xs: t, acc: [h, ...acc] } }
        }
      }
    }
    str.join(kept, nl)
  }

  -- True when `s` is a plausible Handl identifier: starts with an
  -- alphabetic character or underscore, followed by zero or more
  -- alphanumeric characters or underscores.  Mirrors
  -- `handl_runtime::module_prep`'s private-binding check.
  is_valid_ident :: s ~> do {
    if slen(s) == 0 { false } else {
      c0 :: atc(s, 0)
      if !(char.is_alpha(c0) || c0 == "_") { false } else {
        while { i: 1, ok: true } {
          [i, ok] ~> if !ok || i >= slen(s) { { out: ok } } else {
            c :: atc(s, i)
            { state: { i: i + 1, ok: char.is_alnum(c) || c == "_" } }
          }
        }
      }
    }
  }

  -- Scan lines, collecting `{name, expr}` entries.  `cur` is null or the
  -- current `{name, lines}` record under construction (lines reversed);
  -- `cur_priv` marks it as a private (non-exported) top-level binding.
  -- Export entries become object fields (`{ name: expr }`); private
  -- entries become `do`-block assignments (`name := expr;`) emitted
  -- *before* the object so exported closures can reference private
  -- helpers — mirrors `handl_runtime::module_prep`.
  --
  -- When the source contains top-level import statements they are hoisted,
  -- in original order, ahead of the record literal inside a `do { ... }`
  -- block so the runtime can evaluate them (`prim_import`) and bind their
  -- names for the record.  With no imports the bare object literal (or the
  -- untouched source) is returned, exactly as before.
  transform_export_to_object :: s ~> do {
    -- fin :: append the in-flight entry (if any) to its collection.
    fin :: [coll, cur] ~> match cur {
      null: coll,
      c: [{ name: c.name, expr: str.join(rev(c.lines), nl) }, ...coll]
    }
    scan :: while { xs: str.lines(s), entries: [], priv: [], cur: null, cur_priv: false } {
      [xs, entries, priv, cur, cur_priv] ~> match xs {
        []: { out: { entries: if cur_priv { entries } else { fin(entries, cur) },
                     priv: if cur_priv { fin(priv, cur) } else { priv } } },
        [h, ...t]: if is_top_import_line(h) {
          fe :: from_export_to_import(h)
          if fe == null {
            { state: { xs: t, entries: entries, priv: priv, cur: cur, cur_priv: cur_priv } }
          } else {
            entries2 :: if cur_priv { entries } else { fin(entries, cur) }
            priv2 :: if cur_priv { fin(priv, cur) } else { priv }
            entries3 :: while { ys: fe.names, acc: entries2 } {
              [ys, acc] ~> match ys {
                []: { out: acc },
                [p, ...pt]: { state: { ys: pt, acc: [{ name: p.name, expr: p.alias }, ...acc] } }
              }
            }
            { state: { xs: t, entries: entries3, priv: priv2, cur: null, cur_priv: false } }
          }
        } else {
          if is_export_line(h) {
            rest :: sdrop(trim_start(h), 7)
            sep :: find_binding_sep(rest)
            entries2 :: if cur_priv { entries } else { fin(entries, cur) }
            priv2 :: if cur_priv { fin(priv, cur) } else { priv }
            if sep == null {
              { state: { xs: t, entries: entries2, priv: priv2, cur: null, cur_priv: false } }
            } else {
              type_only :: sep.len == 1 && atc(rest, sep.pos) == ":"
              expr0 :: if type_only { "null" } else { trim(sdrop(rest, sep.pos + sep.len)) }
              { state: { xs: t, entries: entries2, priv: priv2,
                         cur: { name: trim(strip_export_name(stake(rest, sep.pos))),
                                lines: if slen(expr0) == 0 { [] } else { [expr0] } },
                         cur_priv: false } }
            }
          } else {
            -- Column-0 line that is not an import or `export`: detect a
            -- *private* top-level binding so helpers survive into the
            -- do-block instead of being dropped or swallowed into the
            -- previous export's expression.
            t0 :: trim_start(h)
            sep0 :: if indented(h) { null } else { find_binding_sep(t0) }
            nm :: if sep0 == null { "" } else { trim(strip_export_name(stake(t0, sep0.pos))) }
            if sep0 != null && is_valid_ident(nm) {
              entries2 :: if cur_priv { entries } else { fin(entries, cur) }
              priv2 :: if cur_priv { fin(priv, cur) } else { priv }
              type_only :: sep0.len == 1 && atc(t0, sep0.pos) == ":"
              expr0 :: if type_only { "null" } else { trim(sdrop(t0, sep0.pos + sep0.len)) }
              { state: { xs: t, entries: entries2, priv: priv2,
                         cur: { name: nm,
                                lines: if slen(expr0) == 0 { [] } else { [expr0] } },
                         cur_priv: true } }
            } else {
              match cur {
                null: { state: { xs: t, entries: entries, priv: priv, cur: cur, cur_priv: cur_priv } },
                c: if blank(h) {
                  { state: { xs: t, entries: entries, priv: priv, cur: cur, cur_priv: cur_priv } }
                } else {
                  { state: { xs: t, entries: entries, priv: priv,
                             cur: { name: c.name, lines: [h, ...c.lines] }, cur_priv: cur_priv } }
                }
              }
            }
          }
        }
      }
    }
    entries :: rev(scan.entries)
    privs :: rev(scan.priv)
    imports :: collect_import_lines(s)
    -- Private bindings as do-block assignments ahead of the record.
    prelude :: while { xs: privs, acc: "" } {
      [xs, acc] ~> match xs {
        []: { out: acc },
        [h, ...t]: { state: { xs: t, acc: acc + h.name + " := " + trim(h.expr) + ";" + nl } }
      }
    }
    if list_len(imports) == 0 {
      if list_len(entries) == 0 {
        s
      } else if list_len(privs) == 0 {
        emit_object(entries)
      } else {
        -- `(source).name` projections evaluate the source as a single
        -- expression — private statements need a `do` block.
        "do {" + nl + prelude + emit_object(entries) + nl + "}"
      }
    } else {
      body :: if list_len(entries) == 0 {
        drop_import_lines(s)
      } else {
        prelude + emit_object(entries)
      }
      "do {" + nl + str.join(imports, nl) + nl + body + nl + "}"
    }
  }

  -- ---------------------------------------------------------------------
  -- parse_caps -- `cap "name"` declarations -> `[name, ...]`
  -- ---------------------------------------------------------------------

  parse_caps :: s ~> do {
    while { xs: str.lines(s), acc: [] } {
      [xs, acc] ~> match xs {
        []: { out: rev(acc) },
        [h, ...t]: do {
          ln :: trim(h)
          if slen(ln) == 0 || str.starts_with(ln, "--") {
            { state: { xs: t, acc: acc } }
          } else {
            r :: kw_rest(ln, "cap", [])
            if r == null {
              { state: { xs: t, acc: acc } }
            } else {
              q :: extract_quoted(trim_start(r))
              match q {
                null: { state: { xs: t, acc: acc } },
                qq: { state: { xs: t, acc: [qq.text, ...acc] } }
              }
            }
          }
        }
      }
    }
  }

  -- ---------------------------------------------------------------------
  -- parse_tags -- `tag name <::|=> Type` declarations ->
  -- `[{name, payload}, ...]`.  `::` is preferred over `=` even when a
  -- `=` appears earlier in the line (mirrors the Rust scan).
  -- ---------------------------------------------------------------------

  tag_name_ok :: name ~> do {
    slen(name) > 0 && all(char.chars(name), c ~> char.is_alnum(c) || c == "_")
  }

  tag_sep :: rest ~> do {
    i2 :: str.find(rest, "::")
    if i2 >= 0 {
      { pos: i2, len: 2 }
    } else {
      i1 :: str.find(rest, "=")
      if i1 >= 0 {
        { pos: i1, len: 1 }
      } else {
        null
      }
    }
  }

  parse_tags :: s ~> do {
    while { xs: str.lines(s), acc: [] } {
      [xs, acc] ~> match xs {
        []: { out: rev(acc) },
        [h, ...t]: do {
          ln :: trim(h)
          if slen(ln) == 0 || str.starts_with(ln, "--") {
            { state: { xs: t, acc: acc } }
          } else {
            r :: kw_rest(ln, "tag", [])
            if r == null {
              { state: { xs: t, acc: acc } }
            } else {
              sep :: tag_sep(r)
              if sep == null {
                { state: { xs: t, acc: acc } }
              } else {
                name :: trim(stake(r, sep.pos))
                payload :: trim(sdrop(r, sep.pos + sep.len))
                if tag_name_ok(name) && slen(payload) > 0 {
                  { state: { xs: t, acc: [{ name: name, payload: payload }, ...acc] } }
                } else {
                  { state: { xs: t, acc: acc } }
                }
              }
            }
          }
        }
      }
    }
  }

  -- ---------------------------------------------------------------------
  -- expand_tags -- strip `tag` declaration lines and generate constructor
  -- bindings `name :: _0 ~> tag.tag("name", {value: _0})`, wrapping the
  -- remaining source in `do { ... }`.  No tags -> source unchanged.
  -- ---------------------------------------------------------------------

  -- True when the trimmed line is a strippable `tag` declaration
  -- (`tag` + separator + alphanumeric name; payload is not checked).
  is_tag_decl_line :: ln ~> do {
    r :: kw_rest(ln, "tag", [])
    if r == null {
      false
    } else {
      sep :: tag_sep(r)
      if sep == null {
        false
      } else {
        tag_name_ok(trim(stake(r, sep.pos)))
      }
    }
  }

  -- Emit the `do { ... }` wrapper: constructor lines, then the remaining
  -- source lines each indented by two spaces (blank lines stay blank).
  emit_tag_block :: [tags, lines] ~> do {
    ctors :: while { xs: tags, acc: "" } {
      [xs, acc] ~> match xs {
        []: { out: acc },
        [h, ...t]: { state: { xs: t,
                     acc: acc + "  " + h.name + " :: _0 ~> tag.tag(" + dq + h.name + dq + ", {value: _0})" + nl } }
      }
    }
    body :: while { xs: lines, acc: ctors } {
      [xs, acc] ~> match xs {
        []: { out: acc },
        [h, ...t]: if blank(h) {
          { state: { xs: t, acc: acc + nl } }
        } else {
          { state: { xs: t, acc: acc + "  " + h + nl } }
        }
      }
    }
    "do {" + nl + body + "}"
  }

  expand_tags :: s ~> do {
    tags :: parse_tags(s)
    if list_len(tags) == 0 {
      s
    } else {
      kept :: while { xs: str.lines(s), acc: [] } {
        [xs, acc] ~> match xs {
          []: { out: rev(acc) },
          [h, ...t]: do {
            ln :: trim(h)
            if slen(ln) == 0 || str.starts_with(ln, "--") {
              { state: { xs: t, acc: [h, ...acc] } }
            } else {
              if is_tag_decl_line(ln) {
                { state: { xs: t, acc: acc } }
              } else {
                { state: { xs: t, acc: [h, ...acc] } }
              }
            }
          }
        }
      }
      emit_tag_block(tags, kept)
    }
  }

  -- ---------------------------------------------------------------------
  -- escape_string -- escape `"` and `\` for embedding in a `"..."` literal
  -- ---------------------------------------------------------------------

  escape_string :: s ~> do {
    while { xs: char.chars(s), acc: "" } {
      [xs, acc] ~> match xs {
        []: { out: acc },
        [c, ...t]: if c == dq {
          { state: { xs: t, acc: acc + backslash + c } }
        } else {
          if c == backslash {
            { state: { xs: t, acc: acc + backslash + c } }
          } else {
            { state: { xs: t, acc: acc + c } }
          }
        }
      }
    }
  }

  -- ---------------------------------------------------------------------
  -- Composite pipeline (HandlModule::new order):
  --   strip comments -> strip decls -> transform exports -> expand tags
  -- ---------------------------------------------------------------------

  prepare :: s ~> expand_tags(transform_export_to_object(strip_decls(strip_comments(s))))

  -- One-shot analysis over a raw .hnl source: the prepared (evaluatable)
  -- source plus the declaration scans the host needs (`caps` for plugin
  -- capabilities, `tags`).
  analyze :: s ~> do {
    {
      source: prepare(s),
      caps: parse_caps(s),
      tags: parse_tags(s)
    }
  }

  -- ---------------------------------------------------------------------
  -- Public record
  -- ---------------------------------------------------------------------

  {
    strip_comments: strip_comments,
    strip_decls: strip_decls,
    transform_export_to_object: transform_export_to_object,
    find_binding_sep: find_binding_sep,
    parse_caps: parse_caps,
    parse_tags: parse_tags,
    expand_tags: expand_tags,
    escape_string: escape_string,
    prepare: prepare,
    analyze: analyze
  }
}
