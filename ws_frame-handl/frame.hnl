--- ws_frame-handl -- the pure-Handl implementation of the `ws_frame`
--- contract (RFC 6455 §5.2).
---
--- `encode`/`decode` are plain `~>` arrows over the `bytes`/`math`/
--- `option` packages: the wire format is a fixed two-byte header plus
--- big-endian extended lengths, expressible with nothing but the
--- byte-buffer and bitwise atoms. Ported from
--- `crates/plugin-lib-ws-rfc/src/frame.rs` with two deliberate
--- divergences, both forced by the contract's `Option`-only decode
--- channel:
---
---   * the Rust `mask: Option<[u8; 4]>` frame field is not surfaced --
---     `Frame` is `{fin, op, payload}` with the payload always
---     unmasked;
---   * the Rust protocol errors (`ReservedBits`, `FragmentedControl`,
---     unknown opcode) are not reproduced -- `option.none` is reserved
---     for *incomplete input* (that is what makes the contract's
---     `prefix` law statable), so reserved bits are ignored and any
---     4-bit opcode passes through. Validation belongs to the layer
---     above.
---
--- The big-endian helpers (`u16_be`, `u64_be`, `be_read`) and the mask
--- XOR are codec-internal; they could be extracted into a shared
--- byte-codec package later if another format needs them.

from "../ws_frame" import { Encode, Decode }
from "bytes" import * as bytes
from "math" import * as math
from "option" import * as option

--- u16_be -- the 2-byte big-endian encoding of `n` (0 <= n <= 65535) as
--- a list of byte ints.
u16_be := (n) ~> do {
  [math.bit_and(math.shr(n, 8), 255), math.bit_and(n, 255)]
}

--- u64_be -- the 8-byte big-endian encoding of `n` as a list of byte
--- ints. Exact for the payload lengths this codec can see (n < 2^53).
u64_be := (n) ~> do {
  [math.bit_and(math.shr(n, 56), 255),
   math.bit_and(math.shr(n, 48), 255),
   math.bit_and(math.shr(n, 40), 255),
   math.bit_and(math.shr(n, 32), 255),
   math.bit_and(math.shr(n, 24), 255),
   math.bit_and(math.shr(n, 16), 255),
   math.bit_and(math.shr(n, 8), 255),
   math.bit_and(n, 255)]
}

--- be_read -- decode the `count`-byte big-endian unsigned integer at
--- offset `off` in `buf`.
be_read := (buf, off, count) ~> while { i: 0, acc: 0 } {
  [i, acc] ~> if i >= count {
    { out: acc }
  } else {
    { state: { i: i + 1, acc: acc * 256 + bytes.at(buf, off + i) } }
  }
}

--- xor_mask -- RFC 6455 §5.3 masking: byte `i` is XORed with
--- `key[i mod keylen]`. Used to mask on encode and to unmask on decode
--- (XOR is an involution). The key index rotates through `j` rather
--- than `math.mod`, so the key may be any positive length -- the
--- contract only ever promises 4.
xor_mask := (payload, key) ~> do {
  ks :: bytes.to_list(key)
  klen :: bytes.len(key)
  masked :: while { i: 0, j: 0, acc: [] } {
    [i, j, acc] ~> if i >= bytes.len(payload) {
      { out: acc }
    } else {
      { state: { i: i + 1,
                 j: if j + 1 >= klen { 0 } else { j + 1 },
                 acc: [...acc, math.bit_xor(bytes.at(payload, i), ks[j])] } }
    }
  }
  bytes.from_list(masked)
}

--- encode -- serialize `{fin, op, payload, mask_key}` to wire bytes.
--- `mask_key` empty emits an unmasked frame; 4 bytes emits a masked one
--- with the payload XORed against the key (RFC 6455 §5.1, §5.3).
export encode: Encode := (input) ~> do {
  plen :: bytes.len(input.payload)
  masked :: bytes.len(input.mask_key) > 0
  b0 :: math.bit_or((if input.fin != 0 { 128 } else { 0 }),
                    math.bit_and(input.op, 15))
  len_tag :: if plen <= 125 { plen } else if plen <= 65535 { 126 } else { 127 }
  b1 :: math.bit_or((if masked { 128 } else { 0 }), len_tag)
  header :: if plen <= 125 {
    [b0, b1]
  } else if plen <= 65535 {
    [b0, b1, ...u16_be(plen)]
  } else {
    [b0, b1, ...u64_be(plen)]
  }
  body :: if masked {
    [...bytes.to_list(input.mask_key),
     ...bytes.to_list(xor_mask(input.payload, input.mask_key))]
  } else {
    bytes.to_list(input.payload)
  }
  bytes.from_list([...header, ...body])
}

--- decode -- read one frame off the front of `buf`. Returns
--- `option.none` (need more bytes) while `buf` is a strict prefix of
--- the frame -- truncated header, extended length, mask key, or
--- payload alike -- and `option.some` with `{frame, rest}` once the
--- whole frame is present, where `rest` is whatever trails it.
export decode: Decode := (buf) ~> do {
  n :: bytes.len(buf)
  if n < 2 {
    option.none()
  } else {
    do {
      b0 :: bytes.at(buf, 0)
      b1 :: bytes.at(buf, 1)
      tag7 :: math.bit_and(b1, 127)
      ext :: if tag7 == 126 { 2 } else if tag7 == 127 { 8 } else { 0 }
      if n < 2 + ext {
        option.none()
      } else {
        do {
          plen :: if ext == 0 { tag7 } else { be_read(buf, 2, ext) }
          masked :: math.bit_and(b1, 128) == 128
          key_len :: if masked { 4 } else { 0 }
          head :: 2 + ext + key_len
          if n < head + plen {
            option.none()
          } else {
            do {
              raw :: bytes.slice(buf, head, plen)
              payload :: if masked {
                xor_mask(raw, bytes.slice(buf, 2 + ext, 4))
              } else {
                raw
              }
              option.some({
                frame: { fin: math.shr(b0, 7),
                         op: math.bit_and(b0, 15),
                         payload: payload },
                rest: bytes.slice(buf, head + plen, n - head - plen)
              })
            }
          }
        }
      }
    }
  }
}
