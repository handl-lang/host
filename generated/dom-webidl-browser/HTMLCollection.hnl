from "js" import { call, error }
from "result" import { ok, err }
from "../dom/HTMLCollection" import { HTMLCollection, HTMLCollectionItem, HTMLCollectionNamedItem }

export h_t_m_l_collection_item: HTMLCollectionItem := (index) ~> do {
  r = call("dom", "item", [index], ["js_number"], "js_object", false)
  e = error()
  if e == null {
    ok(r)
  } else {
    err(e)
  }
}

export h_t_m_l_collection_named_item: HTMLCollectionNamedItem := (name) ~> do {
  r = call("dom", "namedItem", [name], ["js_string"], "js_object", false)
  e = error()
  if e == null {
    ok(r)
  } else {
    err(e)
  }
}
