from "js" import { call, error }
from "result" import { ok, err }
from "../dom/types" import { MutationCallback }

export ShadowRootMode_Closed: Int := 1
export ShadowRootMode_Open: Int := 0
export SlotAssignmentMode_Manual: Int := 0
export SlotAssignmentMode_Named: Int := 1

export mutation_callback: MutationCallback := (mutations, observer) ~> do {
  r = call("dom", "mutation_callback", [mutations, observer], ["js_object", "js_object"], "js_void", false)
  e = error()
  if e == null {
    ok(r)
  } else {
    err(e)
  }
}
