--- Generated port for webcrypto.Crypto
--- js target: browser
--- source: https://raw.githubusercontent.com/w3c/webref/19e2457df856a43ec749c0fd4e88ae1edc4f6cb8/ed/idl/webcrypto.idl

from "js" import { JsError }
from "result" import { Result }

--- The Crypto interface represents basic cryptography features available in the current context.
--- It allows access to a cryptographically strong random number generator and to cryptographic primitives.
export Crypto := {
  --- The Crypto.subtle read-only property returns a
  --- SubtleCrypto which can then be used to perform low-level
  --- cryptographic operations.
  subtle: Handle
}

--- The Crypto.getRandomValues() method lets you get cryptographically strong random values.
--- The array given as the parameter is filled with random numbers (random in its cryptographic meaning).
--- js: Crypto.getRandomValues
export CryptoGetRandomValues: (Bytes) ~[1]~> Result<Bytes, JsError>

--- The randomUUID() method of the Crypto interface is used to generate a v4 UUID using a cryptographically secure random number generator.
--- js: Crypto.randomUUID
export CryptoRandomUUID: () ~[1]~> Result<String, JsError>
