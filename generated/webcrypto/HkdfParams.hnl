--- The HkdfParams dictionary of the Web Crypto API represents the object that should be passed as the algorithm parameter into SubtleCrypto.deriveKey(), when using the HKDF algorithm.
export HkdfParams := {
  hash: Handle,
  salt: Bytes,
  info: Bytes
}
