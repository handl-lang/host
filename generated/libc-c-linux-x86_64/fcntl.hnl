--- Generated adapter for libc-c-linux-x86_64/fcntl

from "result" import { ok, err }
from "../libc/fcntl" import { Fcntl }

export O_NONBLOCK: Int := 2048
export O_CLOEXEC: Int := 524288
export F_GETFD: Int := 1
export F_SETFD: Int := 2
export F_GETFL: Int := 3
export F_SETFL: Int := 4
export FD_CLOEXEC: Int := 1

export fcntl: Fcntl := (fd, cmd, arg) ~> do {
  r = ffi.call("libc.so.6", "fcntl", [fd, cmd, arg], ["i32", "i32", "i32"], "i32", false)
  if r < 0 {
    err(ffi.errno())
  } else {
    ok(r)
  }
}
