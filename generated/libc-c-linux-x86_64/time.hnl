--- Generated adapter for libc-c-linux-x86_64/time

from "ffi" import { call, errno }
from "result" import { ok, err }
from "../libc/time" import { Clock, Difftime, Tzset, Dysize, TimerDelete, TimerGetoverrun }

export clock: Clock := () ~[FFI]~> do {
  r = call("libc.so.6", "clock", [], [], "i64", false)
  if r < 0 {
    err(errno())
  } else {
    ok(r)
  }
}

export difftime: Difftime := (__time1, __time0) ~[FFI]~> do {
  r = call("libc.so.6", "difftime", [__time1, __time0], ["i64", "i64"], "f64", false)
  if r < 0 {
    err(errno())
  } else {
    ok(r)
  }
}

export tzset: Tzset := () ~[FFI]~> do {
  r = call("libc.so.6", "tzset", [], [], "void", false)
  ok(null)
}

export dysize: Dysize := (__year) ~[FFI]~> do {
  r = call("libc.so.6", "dysize", [__year], ["i32"], "i32", false)
  if r < 0 {
    err(errno())
