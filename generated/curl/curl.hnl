--- Generated port for curl.curl
--- ffi target: x86_64-unknown-linux-gnu

from "ffi" import { Errno }
from "result" import { Result }

export CURLE_OK: Int
export CURLOPT_WRITEDATA: Int
export CURLOPT_URL: Int
export CURLOPT_POSTFIELDS: Int
export CURLOPT_USERAGENT: Int
export CURLOPT_HTTPHEADER: Int
export CURLOPT_HEADERDATA: Int
export CURLOPT_CUSTOMREQUEST: Int
export CURLOPT_NOBODY: Int
export CURLOPT_FOLLOWLOCATION: Int
export CURLOPT_POSTFIELDSIZE: Int
export CURLOPT_SSL_VERIFYPEER: Int
export CURLOPT_SSL_VERIFYHOST: Int
export CURLOPT_NOSIGNAL: Int
export CURLOPT_CONNECT_ONLY: Int
export CURLOPT_TIMEOUT_MS: Int
export CURLOPT_COPYPOSTFIELDS: Int
export CURLOPT_WS_OPTIONS: Int
export CURLINFO_EFFECTIVE_URL: Int
export CURLINFO_RESPONSE_CODE: Int
export CURLINFO_ACTIVESOCKET: Int
export CURLM_OK: Int
export CURLMSG_DONE: Int
--- flag bits
export CURLWS_TEXT: Int
export CURLWS_BINARY: Int
export CURLWS_CONT: Int
export CURLWS_CLOSE: Int
export CURLWS_PING: Int
--- flags for curl_ws_send()
export CURLWS_PONG: Int
--- bits for the CURLOPT_WS_OPTIONS bitmask:
export CURLWS_RAW_MODE: Int

--- create an easy handle
--- ffi: CURL *(void)
export CurlEasyInit: () ~[1]~> Result<Handle, Errno>

--- perform a blocking network transfer
--- ffi: CURLcode (CURL *)
export CurlEasyPerform: (Int) ~[1]~> Result<Int, Errno>

--- free an easy handle
--- ffi: void (CURL *)
export CurlEasyCleanup: (Int) ~[1]~> Result<(), Errno>

--- return string describing error code
--- ffi: const char *(CURLcode)
export CurlEasyStrerror: (Int) ~[1]~> Result<String, Errno>

--- add a string to an slist
--- ffi:
export CurlSlistAppend: (Int, String) ~[1]~> Result<Int, Errno>

--- free an entire curl_slist list
--- ffi: void (struct curl_slist *)
export CurlSlistFreeAll: (Int) ~[1]~> Result<CurlSlistFreeAllResult, Errno>

--- multi API — driven by concurrent-epoll via fdset->epoll sync (no
--- socket callbacks: FFI cannot marshal C->handl trampolines).
--- ffi: CURLM *(void)
export CurlMultiInit: () ~[1]~> Result<Handle, Errno>

--- add an easy handle to a multi session
--- ffi: CURLMcode (CURLM *, CURL *)
export CurlMultiAddHandle: (Int, Int) ~[1]~> Result<Int, Errno>

--- remove an easy handle from a multi session
--- ffi: CURLMcode (CURLM *, CURL *)
export CurlMultiRemoveHandle: (Int, Int) ~[1]~> Result<Int, Errno>

--- run all transfers until it would block
export CurlMultiPerformResult := {
  ret: Int,
  vals: [Int]
}

--- ffi:
export CurlMultiPerform: (Int, Int) ~[1]~> Result<CurlMultiPerformResult, Errno>

--- extract file descriptor information from a multi handle
export CurlMultiFdsetResult := {
  ret: Int,
  buf: Bytes,
  outs: [Bytes],
  vals: [Int]
}

--- ffi:
export CurlMultiFdset: (Int, Int) ~[1]~> Result<CurlMultiFdsetResult, Errno>

--- how long to wait for action before proceeding
export CurlMultiTimeoutResult := {
  ret: Int,
  vals: [Int]
}

--- ffi:
export CurlMultiTimeout: (Int, Int) ~[1]~> Result<CurlMultiTimeoutResult, Errno>

--- read multi stack information
export CurlMultiInfoReadResult := {
  ret: Int,
  vals: [Int]
}

--- ffi:
export CurlMultiInfoRead: (Int, Int) ~[1]~> Result<CurlMultiInfoReadResult, Errno>

--- close down a multi session
--- ffi: CURLMcode (CURLM *)
export CurlMultiCleanup: (Int) ~[1]~> Result<Int, Errno>

--- WebSocket API (curl >= 7.86, client side only — libcurl has no WS
--- server). After curl_easy_perform with CURLOPT_CONNECT_ONLY=2 the
--- handle speaks RFC 6455: curl_ws_send/curl_ws_recv move frames, and
--- curl_ws_meta describes the frame just received. Masking, ping/pong,
--- close handshakes and (optionally) permessage-deflate are curl's.
export CurlWsSendResult := {
  ret: Int,
  vals: [Int]
}

--- ffi:
export CurlWsSend: (Int, Bytes, Int, Int, Int) ~[1]~> Result<CurlWsSendResult, Errno>

--- receive WebSocket data
export CurlWsRecvResult := {
  ret: Int,
  buf: Bytes,
  outs: [Bytes],
  vals: [Int]
}

--- ffi:
export CurlWsRecv: (Int, Int) ~[1]~> Result<CurlWsRecvResult, Errno>

--- return string describing error code
--- ffi: const char *(CURLMcode)
export CurlMultiStrerror: (Int) ~[1]~> Result<String, Errno>
