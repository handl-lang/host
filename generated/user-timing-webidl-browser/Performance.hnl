from "js" import { call, error }
from "result" import { ok, err }
from "../user-timing/Performance" import { Performance, PerformanceClearMarks, PerformanceClearMeasures, PerformanceMark, PerformanceMeasure }

export performance_clear_marks: PerformanceClearMarks := (markName) ~> do {
  r = call("user-timing", "clearMarks", [markName], ["js_string"], "js_void", false)
  e = error()
  if e == null {
    ok(r)
  } else {
    err(e)
  }
}

export performance_clear_measures: PerformanceClearMeasures := (measureName) ~> do {
  r = call("user-timing", "clearMeasures", [measureName], ["js_string"], "js_void", false)
  e = error()
  if e == null {
    ok(r)
  } else {
    err(e)
  }
}

export performance_mark: PerformanceMark := (markName, markOptions) ~> do {
  r = call("user-timing", "mark", [markName, markOptions], ["js_string", "js_object"], "js_object", false)
  e = error()
  if e == null {
    ok(r)
  } else {
    err(e)
  }
}

export performance_measure: PerformanceMeasure := (measureName, startOrMeasureOptions, endMark) ~> do {
  r = call("user-timing", "measure", [measureName, startOrMeasureOptions, endMark], ["js_string", "js_object", "js_string"], "js_object", false)
  e = error()
  if e == null {
    ok(r)
  } else {
    err(e)
  }
}
