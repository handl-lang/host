--- Generated adapter for libz-c-linux-x86_64/zlib

from "ffi" import { call, errno }
from "result" import { ok, err }
from "../libz/zlib" import { Compress2, CompressBound, Uncompress, Gzdopen, Gzread, Gzwrite, Gzflush, Gzclose, Gzerror, Adler32, Crc32 }

export compress2: Compress2 := (source, level) ~> do {
  r = call("libz.so.1", "compress2", [source, level], ["io_buf:16777216", "in_buf", "i32"], "i32", false)
  if r.ret < 0 {
    err(errno())
  } else {
    ok(r)
  }
}

export compressBound: CompressBound := (source_len) ~> do {
  r = call("libz.so.1", "compressBound", [source_len], ["u64"], "u64", false)
  if r < 0 {
    err(errno())
  } else {
    ok(r)
  }
}

