export gzdopen: Gzdopen := (fd, mode) ~> do {
  r = call("libz.so.1", "gzdopen", [fd, mode], ["i32", "cstr"], "ptr", false)
  ok(r)
}

export gzread: Gzread := (file) ~> do {
  r = call("libz.so.1", "gzread", [file], ["ptr", "out_buf:65536"], "i32", false)
  if r.ret < 0 {
    err(errno())
  } else {
    ok(r.buf)
