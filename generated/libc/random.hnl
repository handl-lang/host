--- Generated port for libc.random
--- ffi target: x86_64-unknown-linux-gnu

from "ffi" import { Errno }
from "result" import { Result }

--- Flags for use with getrandom.
export GRND_NONBLOCK: Int
export GRND_RANDOM: Int
export GRND_INSECURE: Int

--- Write LENGTH bytes of randomness starting at BUFFER.  Return the
--- number of bytes written, or -1 on error.
--- ffi: ssize_t (void *, size_t, unsigned int)
export Getrandom: (Int) ~[1]~> Result<Bytes, Errno>

--- Write LENGTH bytes of randomness starting at BUFFER.  Return 0 on
--- success or -1 on error.
--- ffi: int (void *, size_t)
export Getentropy: () ~[1]~> Result<Bytes, Errno>
