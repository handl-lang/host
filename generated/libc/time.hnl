export STA_CLOCKERR: Int
export STA_NANO: Int
export STA_MODE: Int
export STA_CLK: Int
export STA_RONLY: Int
export TIME_UTC: Int
export TIME_MONOTONIC: Int
export TIME_ACTIVE: Int
export TIME_THREAD_ACTIVE: Int

--- ffi: clock_t (void)
export Clock: () ~[1]~> Result<Int, Errno>

--- ffi: double (time_t, time_t)
export Difftime: (Int, Int) ~[1]~> Result<Float, Errno>

--- ffi: time_t (struct tm *)
export Mktime: (Handle) ~[1]~> Result<Int, Errno>

--- ffi: char *(const char *restrict, const char *restrict, struct tm *)
export Strptime: (String, String, Handle) ~[1]~> Result<String, Errno>

--- ffi: char *(const char *restrict, const char *restrict, struct tm *, locale_t)
export StrptimeL: (String, String, Handle, Handle) ~[1]~> Result<String, Errno>

--- ffi: void (void)
export Tzset: () ~[1]~> Result<(), Errno>

--- ffi: time_t (struct tm *)
export Timegm: (Handle) ~[1]~> Result<Int, Errno>

--- ffi: time_t (struct tm *)
export Timelocal: (Handle) ~[1]~> Result<Int, Errno>

--- ffi: int (int)
export Dysize: (Int) ~[1]~> Result<Int, Errno>

--- ffi: int (clockid_t, struct timespec *)
export ClockGetres: (Int) ~[1]~> Result<timespec, Errno>

--- ffi: int (clockid_t, struct timespec *)
export ClockGettime: (Int) ~[1]~> Result<timespec, Errno>

--- ffi: int (timer_t)
export TimerDelete: (Handle) ~[1]~> Result<Int, Errno>

--- ffi: int (timer_t, struct itimerspec *)
export TimerGettime: (Handle, Handle) ~[1]~> Result<Int, Errno>

--- ffi: int (timer_t)
export TimerGetoverrun: (Handle) ~[1]~> Result<Int, Errno>

--- ffi: int (struct timespec *, int)
export TimespecGet: (Int) ~[1]~> Result<timespec, Errno>

--- ffi: int (struct timespec *, int)
export TimespecGetres: (Int) ~[1]~> Result<timespec, Errno>

--- ffi: int (const char *restrict, struct tm *restrict)
export GetdateR: (String, Handle) ~[1]~> Result<Int, Errno>

