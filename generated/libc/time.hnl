--- Generated port for libc.time
--- ffi target: x86_64-unknown-linux-gnu

from "ffi" import { Errno }
from "result" import { Result }

export timespec := {
  tv_sec: Int,
  tv_nsec: Int
}

export unix: Int
export linux: Int
export CLOCKS_PER_SEC: Int
export CLOCK_REALTIME: Int
export CLOCK_MONOTONIC: Int
