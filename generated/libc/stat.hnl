--- Generated port for libc.stat
--- ffi target: x86_64-unknown-linux-gnu

from "ffi" import { Errno }
from "result" import { Result }

--- get file status
export stat := {
  st_dev: Nat,
  st_ino: Nat,
  st_nlink: Nat,
  st_mode: Nat,
  st_uid: Nat,
  st_gid: Nat,
  __pad0: Int,
  st_rdev: Nat,
  st_size: Int,
  st_blksize: Int,
  st_blocks: Int,
  st_atim: Handle,
  st_mtim: Handle,
  st_ctim: Handle,
  __glibc_reserved: [Int]
}

export stat64 := {
  st_dev: Nat,
  st_ino: Nat,
  st_nlink: Nat,
  st_mode: Nat,
  st_uid: Nat,
  st_gid: Nat,
  __pad0: Int,
  st_rdev: Nat,
  st_size: Int,
  st_blksize: Int,
  st_blocks: Int,
  st_atim: Handle,
  st_mtim: Handle,
  st_ctim: Handle,
  __glibc_reserved: [Int]
}

export unix: Int
export linux: Int
export UTIME_NOW: Int
export UTIME_OMIT: Int
export S_IFMT: Int
export S_IFDIR: Int
export S_IFCHR: Int
export S_IFBLK: Int
export S_IFREG: Int
export S_IFIFO: Int
export S_IFLNK: Int
export S_IFSOCK: Int
--- Set user ID on execution.
export S_ISUID: Int
--- Set group ID on execution.
export S_ISGID: Int
--- Save swapped text after use (sticky bit).  This is pretty well obsolete.
export S_ISVTX: Int
--- Read by owner.
export S_IRUSR: Int
--- Write by owner.
export S_IWUSR: Int
--- Execute by owner.
export S_IXUSR: Int
--- #define	S_IRUSR	__S_IREAD	/* Read by owner.
--- #define	S_IWUSR	__S_IWRITE	/* Write by owner.
--- #define	S_IXUSR	__S_IEXEC	/* Execute by owner.
--- Read, write, and execute by owner.
export S_IRWXU: Int
export S_IREAD: Int
export S_IWRITE: Int
export S_IEXEC: Int
--- Read by group.
export S_IRGRP: Int
--- Write by group.
export S_IWGRP: Int
--- Execute by group.
export S_IXGRP: Int
--- #define	S_IRGRP	(S_IRUSR >> 3)	/* Read by group.
--- #define	S_IWGRP	(S_IWUSR >> 3)	/* Write by group.
--- #define	S_IXGRP	(S_IXUSR >> 3)	/* Execute by group.
--- Read, write, and execute by group.
export S_IRWXG: Int
--- Read by others.
export S_IROTH: Int
--- Write by others.
export S_IWOTH: Int
--- Execute by others.
export S_IXOTH: Int
--- #define	S_IROTH	(S_IRGRP >> 3)	/* Read by others.
--- #define	S_IWOTH	(S_IWGRP >> 3)	/* Write by others.
--- #define	S_IXOTH	(S_IXGRP >> 3)	/* Execute by others.
--- Read, write, and execute by others.
export S_IRWXO: Int
--- 0777
export ACCESSPERMS: Int
--- 07777
export ALLPERMS: Int
--- 0666
export DEFFILEMODE: Int
--- Block size for `st_blocks'.
export S_BLKSIZE: Int
--- Want/got stx_mode & S_IFMT
export STATX_TYPE: Int
--- Want/got stx_mode & ~S_IFMT
export STATX_MODE: Int
--- Want/got stx_nlink
export STATX_NLINK: Int
--- Want/got stx_uid
export STATX_UID: Int
--- Want/got stx_gid
export STATX_GID: Int
--- Want/got stx_atime
export STATX_ATIME: Int
--- Want/got stx_mtime
export STATX_MTIME: Int
--- Want/got stx_ctime
export STATX_CTIME: Int
--- Want/got stx_ino
export STATX_INO: Int
--- Want/got stx_size
export STATX_SIZE: Int
--- Want/got stx_blocks
export STATX_BLOCKS: Int
--- The stuff in the normal stat struct
export STATX_BASIC_STATS: Int
--- Want/got stx_btime
export STATX_BTIME: Int
--- Got stx_mnt_id
export STATX_MNT_ID: Int
--- Want/got direct I/O alignment info
export STATX_DIOALIGN: Int
--- Want/got extended stx_mount_id
export STATX_MNT_ID_UNIQUE: Int
--- Want/got stx_subvol
export STATX_SUBVOL: Int
--- Want/got atomic_write_* fields
export STATX_WRITE_ATOMIC: Int
--- Want/got dio read alignment info
export STATX_DIO_READ_ALIGN: Int
--- Reserved for future struct statx expansion
export STATX__RESERVED: Int
--- This is deprecated, and shall remain the same value in the future.  To avoid
--- confusion please use the equivalent (STATX_BASIC_STATS | STATX_BTIME)
--- instead.
export STATX_ALL: Int
--- [I] File is compressed by the fs
export STATX_ATTR_COMPRESSED: Int
--- [I] File is marked immutable
export STATX_ATTR_IMMUTABLE: Int
--- [I] File is append-only
export STATX_ATTR_APPEND: Int
--- [I] File is not to be dumped
export STATX_ATTR_NODUMP: Int
--- [I] File requires key to decrypt in fs
export STATX_ATTR_ENCRYPTED: Int
--- Dir: Automount trigger
export STATX_ATTR_AUTOMOUNT: Int
--- Root of a mount
export STATX_ATTR_MOUNT_ROOT: Int
--- [I] Verity protected file
export STATX_ATTR_VERITY: Int
--- File is currently in DAX state
export STATX_ATTR_DAX: Int
--- File supports atomic write operations
export STATX_ATTR_WRITE_ATOMIC: Int

--- Get file attributes for FILE and put them in BUF.
export StatResult := {
  ret: Int,
  buf: stat
}

--- ffi: int (const char *restrict, struct stat *restrict)
export Stat: (String) ~[1]~> Result<StatResult, Errno>

--- Get file attributes for the file, device, pipe, or socket
--- that file descriptor FD is open on and put them in BUF.
export FstatResult := {
  ret: Int,
  buf: stat
}

--- ffi: int (int, struct stat *)
export Fstat: (Int) ~[1]~> Result<FstatResult, Errno>

export Stat64Result := {
  ret: Int,
  buf: stat64
}

--- ffi: int (const char *restrict, struct stat64 *restrict)
export Stat64: (String) ~[1]~> Result<Stat64Result, Errno>

export Fstat64Result := {
  ret: Int,
  buf: stat64
}

--- ffi: int (int, struct stat64 *)
export Fstat64: (Int) ~[1]~> Result<Fstat64Result, Errno>

--- get file status
export FstatatResult := {
  ret: Int,
  buf: stat
}

--- ffi: int (int, const char *restrict, struct stat *restrict, int)
export Fstatat: (Int, String, Int) ~[1]~> Result<FstatatResult, Errno>

export Fstatat64Result := {
  ret: Int,
  buf: stat64
}

--- ffi: int (int, const char *restrict, struct stat64 *restrict, int)
export Fstatat64: (Int, String, Int) ~[1]~> Result<Fstatat64Result, Errno>

--- Get file attributes about FILE and put them in BUF.
--- If FILE is a symbolic link, do not follow it.
export LstatResult := {
  ret: Int,
  buf: stat
}

--- ffi: int (const char *restrict, struct stat *restrict)
export Lstat: (String) ~[1]~> Result<LstatResult, Errno>

export Lstat64Result := {
  ret: Int,
  buf: stat64
}

--- ffi: int (const char *restrict, struct stat64 *restrict)
export Lstat64: (String) ~[1]~> Result<Lstat64Result, Errno>

--- Set file access permissions for FILE to MODE.
--- If FILE is a symbolic link, this affects its target instead.
--- ffi: int (const char *, __mode_t)
export Chmod: (String, Nat) ~[1]~> Result<Int, Errno>

--- Set file access permissions for FILE to MODE.
--- If FILE is a symbolic link, this affects the link itself
--- rather than its target.
--- ffi: int (const char *, __mode_t)
export Lchmod: (String, Nat) ~[1]~> Result<Int, Errno>

--- change permissions of a file
--- ffi: int (int, __mode_t)
export Fchmod: (Int, Nat) ~[1]~> Result<Int, Errno>

--- Set file access permissions of FILE relative to
--- the directory FD is open on.
--- ffi: int (int, const char *, __mode_t, int)
export Fchmodat: (Int, String, Nat, Int) ~[1]~> Result<Int, Errno>

--- Set the file creation mask of the current process to MASK,
--- and return the old creation mask.
--- ffi: __mode_t (__mode_t)
export Umask: (Nat) ~[1]~> Result<Nat, Errno>

--- Get the current `umask' value without changing it.
--- This function is only available under the GNU Hurd.
--- ffi: __mode_t (void)
export Getumask: () ~[1]~> Result<Nat, Errno>

--- Create a new directory named PATH, with permission bits MODE.
--- ffi: int (const char *, __mode_t)
export Mkdir: (String, Nat) ~[1]~> Result<Int, Errno>

--- Like mkdir, create a new directory with permission bits MODE.  But
--- interpret relative PATH names relative to the directory associated
--- with FD.
--- ffi: int (int, const char *, __mode_t)
export Mkdirat: (Int, String, Nat) ~[1]~> Result<Int, Errno>

--- create a special or ordinary file
--- ffi: int (const char *, __mode_t, __dev_t)
export Mknod: (String, Nat, Nat) ~[1]~> Result<Int, Errno>

--- Like mknod, create a new device file with permission bits MODE and
--- device number DEV.  But interpret relative PATH names relative to
--- the directory associated with FD.
--- ffi: int (int, const char *, __mode_t, __dev_t)
export Mknodat: (Int, String, Nat, Nat) ~[1]~> Result<Int, Errno>

--- Create a new FIFO named PATH, with permission bits MODE.
--- ffi: int (const char *, __mode_t)
export Mkfifo: (String, Nat) ~[1]~> Result<Int, Errno>

--- Like mkfifo, create a new FIFO with permission bits MODE.  But
--- interpret relative PATH names relative to the directory associated
--- with FD.
--- ffi: int (int, const char *, __mode_t)
export Mkfifoat: (Int, String, Nat) ~[1]~> Result<Int, Errno>
