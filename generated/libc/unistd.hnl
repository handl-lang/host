--- Generated port for libc.unistd
--- ffi target: x86_64-unknown-linux-gnu

from "ffi" import { Errno }
from "result" import { Result }
from "types/c/sys" import { SSize }

--- ffi: int (int)
export Close: (Int) ~[1]~> Result<Int, Errno>

--- ffi: ssize_t (int, void *, size_t)
export Read: (Int) ~[1]~> Result<Bytes, Errno>

--- ffi: ssize_t (int, const void *, size_t)
export Write: (Int, Bytes) ~[1]~> Result<SSize, Errno>

export PipeResult := {
  ret: Int,
  buf: Bytes,
  outs: List<Bytes>
}

--- ffi: 
export Pipe: () ~[1]~> Result<PipeResult, Errno>

export Pipe2Result := {
  ret: Int,
  buf: Bytes,
  outs: List<Bytes>
}

--- ffi: 
export Pipe2: (Int) ~[1]~> Result<Pipe2Result, Errno>

--- ffi: int (int)
export Dup: (Int) ~[1]~> Result<Int, Errno>

--- ffi: int (int, int)
export Dup2: (Int, Int) ~[1]~> Result<Int, Errno>

