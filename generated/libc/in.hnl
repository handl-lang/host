--- Generated port for libc.in
--- ffi target: x86_64-unknown-linux-gnu

from "ffi" import { Errno }
from "result" import { Result }
from "types/c/netinet" import { InPort }
from "types/c/socket" import { SaFamily, Socklen }
from "types/c/stdint" import { Uint16, Uint32 }

export sockaddr_storage := {
  ss_family: SaFamily,
  __ss_padding: Bytes,
  __ss_align: Nat
}

--- Structure describing an Internet socket address.
export sockaddr_in := {
  sin_family: SaFamily,
  --- Port number.
  sin_port: InPort,
  --- Internet address.
  sin_addr: Handle,
  --- Pad to size of `struct sockaddr'.
  sin_zero: Bytes
}

--- Ditto, for IPv6.
export sockaddr_in6 := {
  sin6_family: SaFamily,
  --- Transport layer port #
  sin6_port: InPort,
  --- IPv6 flow information
  sin6_flowinfo: Uint32,
  --- IPv6 address
  sin6_addr: Handle,
  --- IPv6 scope-id
  sin6_scope_id: Uint32
}

