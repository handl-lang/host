--- 224.0.0.0
export INADDR_UNSPEC_GROUP: Int
--- 224.0.0.1
export INADDR_ALLHOSTS_GROUP: Int
--- 224.0.0.2
export INADDR_ALLRTRS_GROUP: Int
--- 224.0.0.106
export INADDR_ALLSNOOPERS_GROUP: Int
--- 224.0.0.255
export INADDR_MAX_LOCAL_GROUP: Int
export INET_ADDRSTRLEN: Int
export INET6_ADDRSTRLEN: Int

--- Functions to convert between host and network byte order.
--- Please note that these functions normally take `unsigned long int' or
--- `unsigned short int' values as arguments and also return them.  But
--- this was a short-sighted decision since on different systems the types
--- may have different representations but the values are always the same.
--- ffi: uint32_t (uint32_t)
export Ntohl: (Uint32) ~[1]~> Result<Uint32, Errno>

--- convert values between host and
--- ffi: uint16_t (uint16_t)
export Ntohs: (Uint16) ~[1]~> Result<Uint16, Errno>

--- convert values between host and
--- ffi: uint32_t (uint32_t)
export Htonl: (Uint32) ~[1]~> Result<Uint32, Errno>

--- convert values between host and
--- ffi: uint16_t (uint16_t)
export Htons: (Uint16) ~[1]~> Result<Uint16, Errno>

--- Bind socket to a privileged IP port.
export BindresvportResult := {
  ret: Int,
  buf: sockaddr_in
}

--- ffi: int (int, struct sockaddr_in *)
export Bindresvport: (Int) ~[1]~> Result<BindresvportResult, Errno>

--- The IPv6 version of this function.
export Bindresvport6Result := {
  ret: Int,
  buf: sockaddr_in6
}

--- ffi: int (int, struct sockaddr_in6 *)
export Bindresvport6: (Int) ~[1]~> Result<Bindresvport6Result, Errno>

--- Obsolete hop-by-hop and Destination Options Processing (RFC 2292).
--- ffi: int (int)
export Inet6OptionSpace: (Int) ~[1]~> Result<Int, Errno>

--- ffi: int (struct cmsghdr *, const uint8_t *, int, int)
export Inet6OptionAppend: (Handle, String, Int, Int) ~[1]~> Result<Int, Errno>

--- ffi: uint8_t *(struct cmsghdr *, int, int, int)
export Inet6OptionAlloc: (Handle, Int, Int, Int) ~[1]~> Result<String, Errno>

--- Hop-by-Hop and Destination Options Processing (RFC 3542).
--- ffi: int (void *, socklen_t)
export Inet6OptInit: (Handle, Socklen) ~[1]~> Result<Int, Errno>

--- ffi: int (void *, socklen_t, int)
export Inet6OptFinish: (Handle, Socklen, Int) ~[1]~> Result<Int, Errno>

--- ffi: int (void *, int, void *, socklen_t)
export Inet6OptSetVal: (Handle, Int, Handle, Socklen) ~[1]~> Result<Int, Errno>

--- ffi: int (void *, int, void *, socklen_t)
export Inet6OptGetVal: (Handle, Int, Handle, Socklen) ~[1]~> Result<Int, Errno>

--- Routing Header Option (RFC 3542).
--- ffi: socklen_t (int, int)
export Inet6RthSpace: (Int, Int) ~[1]~> Result<Socklen, Errno>

--- ffi: void *(void *, socklen_t, int, int)
export Inet6RthInit: (Handle, Socklen, Int, Int) ~[1]~> Result<Handle, Errno>

--- ffi: int (void *, const struct in6_addr *)
export Inet6RthAdd: (Handle, Handle) ~[1]~> Result<Int, Errno>

--- Set source filter.
--- ffi: int (int, uint32_t, const struct sockaddr *, socklen_t, uint32_t, uint32_t, const struct sockaddr_storage *)
export Setsourcefilter: (Int, Uint32, Bytes, Uint32, Uint32, sockaddr_storage) ~[1]~> Result<Int, Errno>
