--- Generated port for dom.Document
--- js target: browser
--- source: https://raw.githubusercontent.com/w3c/webref/19e2457df856a43ec749c0fd4e88ae1edc4f6cb8/ed/idl/dom.idl

from "js" import { JsError }
from "result" import { Result }

--- The Document interface represents any web page loaded in the browser and serves as an entry point into the web page's content, which is the DOM tree.
export Document := {
  --- The Document.implementation property returns a
  --- DOMImplementation object associated with the current document.
  implementation: Handle,
  --- The URL read-only property of the Document
  --- interface returns the document location as a string.
  URL: String,
  --- The documentURI read-only property of the
  --- Document interface returns the document location as a string.
  documentURI: String,
  --- The Document.compatMode read-only property indicates
  --- whether the document is rendered in Quirks mode or
  --- Standards mode.
  compatMode: String,
  --- The Document.characterSet
  --- read-only property returns the character encoding of the
  --- document that it's currently rendered with.
  characterSet: String,
  --- legacy alias of .characterSet
  charset: String,
  --- legacy alias of .characterSet
  inputEncoding: String,
  --- The Document.contentType read-only property returns the
  --- MIME type that the document is being rendered as. This may come from HTTP headers or
  --- other sources of MIME information, and might be affected by automatic type conversions
  --- performed by either the browser or extensions.
  contentType: String,
  --- The doctype read-only property of the Document interface is a DocumentType object representing the Document Type Declaration (DTD) associated with the current document.
  doctype: Handle,
  --- The documentElement read-only property of the Document interface returns the
  --- Element that is the root element of the document (for
  --- example, the <html> element for HTML documents).
  documentElement: Handle,
  --- The customElementRegistry read-only property of the Document interface returns the CustomElementRegistry object associated with this document, or null if one has not been set.
  customElementRegistry: Handle,
  --- The read-only children property returns a live HTMLCollection
  --- which contains all of the child elements of the document upon which it was called.
  children: Handle,
  --- The Document.firstElementChild read-only property
  --- returns the document's first child Element, or null if there
  --- are no child elements.
  firstElementChild: Handle,
  --- The Document.lastElementChild read-only property
  --- returns the document's last child Element, or null if there
  --- are no child elements.
  lastElementChild: Handle,
  --- The Document.childElementCount read-only property
  --- returns the number of child elements of the document.
  childElementCount: Nat
}

--- Document.adoptNode() transfers a node from another document into the method's document.
--- The adopted node and its subtree are removed from their original document (if any), and their ownerDocument is changed to the current document.
--- The node can then be inserted into the current document.
--- js: Document.adoptNode
export DocumentAdoptNode: (Handle) ~[1]~> Result<Handle, JsError>

--- The Document.append() method
--- inserts a set of Node objects or strings after
--- the last child of the document. Strings
--- are inserted as equivalent Text nodes.
--- js: Document.append
export DocumentAppend: (Handle) ~[1]~> Result<(), JsError>

--- The Document constructor creates a new
--- Document object that is a web page loaded in the browser and serving as
--- an entry point into the page's content.
--- js: Document.constructor
export DocumentConstructor: () ~[1]~> Result<(), JsError>

--- The createAttribute() method of the Document interface creates a new attribute node.
--- js: Document.createAttribute
export DocumentCreateAttribute: (String) ~[1]~> Result<Handle, JsError>

--- The createAttributeNS() method of the Document interface creates a new attribute node with the specified namespace URI and qualified name.
--- js: Document.createAttributeNS
export DocumentCreateAttributeNS: (Handle, String) ~[1]~> Result<Handle, JsError>

--- createCDATASection() creates a new CDATA section node,
--- and returns it.
--- js: Document.createCDATASection
export DocumentCreateCDATASection: (String) ~[1]~> Result<Handle, JsError>

--- createComment() creates a new comment node, and returns
--- it.
--- js: Document.createComment
export DocumentCreateComment: (String) ~[1]~> Result<Handle, JsError>

--- Creates a new empty DocumentFragment into which
--- DOM nodes can be added to build an offscreen DOM tree.
--- js: Document.createDocumentFragment
export DocumentCreateDocumentFragment: () ~[1]~> Result<Handle, JsError>

--- The createElement() method of the Document interface creates a new HTMLElement that has the specified localName.
--- js: Document.createElement
export DocumentCreateElement: (String, Handle) ~[1]~> Result<Handle, JsError>

--- The createElementNS() method of the Document interface creates a new element with the specified namespace URI and qualified name.
--- js: Document.createElementNS
export DocumentCreateElementNS: (Handle, String, Handle) ~[1]~> Result<Handle, JsError>

--- legacy
--- js: Document.createEvent
export DocumentCreateEvent: (String) ~[1]~> Result<Handle, JsError>

--- This method compiles an XPathExpression which can then be used for (repeated) evaluations.
--- js: Document.createExpression
export DocumentCreateExpression: (String, Handle) ~[1]~> Result<Handle, JsError>

--- legacy
--- js: Document.createNSResolver
export DocumentCreateNSResolver: (Handle) ~[1]~> Result<Handle, JsError>

--- NodeFilter.SHOW_ALL = 0xFFFFFFFF
--- js: Document.createNodeIterator
export DocumentCreateNodeIterator: (Handle, Nat, Handle) ~[1]~> Result<Handle, JsError>

--- The createProcessingInstruction() method of the Document interface creates a new ProcessingInstruction object and returns it.
--- js: Document.createProcessingInstruction
export DocumentCreateProcessingInstruction: (String, String) ~[1]~> Result<Handle, JsError>

--- The Document.createRange() method returns a new
--- Range object whose start and end are offset 0 of the Document
--- object on which it was called.
--- js: Document.createRange
export DocumentCreateRange: () ~[1]~> Result<Handle, JsError>

--- Creates a new Text node. This method can be used to escape HTML
--- characters.
--- js: Document.createTextNode
export DocumentCreateTextNode: (String) ~[1]~> Result<Handle, JsError>

--- The Document.createTreeWalker() creator method returns a newly created TreeWalker object.
--- js: Document.createTreeWalker
export DocumentCreateTreeWalker: (Handle, Nat, Handle) ~[1]~> Result<Handle, JsError>

--- XPathResult.ANY_TYPE = 0
--- js: Document.evaluate
export DocumentEvaluate: (String, Handle, Handle, Nat, Handle) ~[1]~> Result<Handle, JsError>

--- The getElementById() method of the Document interface returns an Element object representing the element whose id property matches the specified string. Since element IDs are required to be unique if specified, they're a useful way to get access to a specific element quickly.
--- js: Document.getElementById
export DocumentGetElementById: (String) ~[1]~> Result<Handle, JsError>

--- The getElementsByClassName method of
--- Document interface returns an array-like object
--- of all child elements which have all of the given class name(s).
--- js: Document.getElementsByClassName
export DocumentGetElementsByClassName: (String) ~[1]~> Result<Handle, JsError>

--- The getElementsByTagName method of
--- Document interface returns an
--- HTMLCollection of elements with the given tag name.
--- js: Document.getElementsByTagName
export DocumentGetElementsByTagName: (String) ~[1]~> Result<Handle, JsError>

--- Returns a list of elements with the given tag name belonging to the given namespace.
--- The complete document is searched, including the root node.
--- js: Document.getElementsByTagNameNS
export DocumentGetElementsByTagNameNS: (Handle, String) ~[1]~> Result<Handle, JsError>

--- The importNode() method of the Document interface creates a copy of a Node or DocumentFragment from another document, to be inserted into the current document later.
--- js: Document.importNode
export DocumentImportNode: (Handle, Handle) ~[1]~> Result<Handle, JsError>

--- The moveBefore() method of the Document interface moves a given Node inside the Document DOM node as a direct child, before a given reference node.
--- js: Document.moveBefore
export DocumentMoveBefore: (Handle, Handle) ~[1]~> Result<(), JsError>

--- The Document.prepend() method
--- inserts a set of Node objects or strings before
--- the first child of the document. Strings
--- are inserted as equivalent Text nodes.
--- js: Document.prepend
export DocumentPrepend: (Handle) ~[1]~> Result<(), JsError>

--- The Document method querySelector()
--- returns the first Element within the document that matches the specified
--- CSS selector, or group of CSS selectors. If no matches are found, null is returned.
--- js: Document.querySelector
export DocumentQuerySelector: (String) ~[1]~> Result<Handle, JsError>

--- The Document method querySelectorAll()
--- returns a static (not live) NodeList representing a list of the
--- document's elements that match the specified group of selectors.
--- js: Document.querySelectorAll
export DocumentQuerySelectorAll: (String) ~[1]~> Result<Handle, JsError>

--- The Document.replaceChildren() method replaces the
--- existing children of a Document with a specified new set of children.
--- js: Document.replaceChildren
export DocumentReplaceChildren: (Handle) ~[1]~> Result<(), JsError>
