from "js" import { JsError }
from "result" import { Result }

--- The NamedNodeMap interface represents a collection of Attr objects. Objects inside a NamedNodeMap are not in any particular order, unlike NodeList, although they may be accessed by an index as in an array.
export NamedNodeMap := {
  --- The read-only length property of the NamedNodeMap interface
  --- is the number of objects stored in the map.
  length: Nat
}

--- The getNamedItem() method of the NamedNodeMap interface returns the Attr corresponding to the given name, or null if there is no corresponding attribute.
--- js: NamedNodeMap.getNamedItem
export NamedNodeMapGetNamedItem: (String) ~[1]~> Result<Handle, JsError>

--- The getNamedItemNS() method of the NamedNodeMap interface returns the Attr corresponding to the given local name in the given namespace, or null if there is no corresponding attribute.
--- js: NamedNodeMap.getNamedItemNS
export NamedNodeMapGetNamedItemNS: (Handle, String) ~[1]~> Result<Handle, JsError>

--- The item() method of the NamedNodeMap interface
--- returns the item in the map matching the index.
--- js: NamedNodeMap.item
export NamedNodeMapItem: (Nat) ~[1]~> Result<Handle, JsError>

--- The removeNamedItem() method of the NamedNodeMap interface
--- removes the Attr corresponding to the given name from the map.
--- js: NamedNodeMap.removeNamedItem
export NamedNodeMapRemoveNamedItem: (String) ~[1]~> Result<Handle, JsError>

--- The removeNamedItemNS() method of the NamedNodeMap interface
--- removes the Attr corresponding to the given namespace and local name from the map.
--- js: NamedNodeMap.removeNamedItemNS
export NamedNodeMapRemoveNamedItemNS: (Handle, String) ~[1]~> Result<Handle, JsError>

--- The setNamedItem() method of the NamedNodeMap interface
--- puts the Attr identified by its name in the map.
--- If there is already an Attr with the same name in the map,
--- it is replaced.
--- js: NamedNodeMap.setNamedItem
export NamedNodeMapSetNamedItem: (Handle) ~[1]~> Result<Handle, JsError>

--- The setNamedItemNS() method of the NamedNodeMap interface
--- puts the Attr identified by its name in the map.
--- If there was already an Attr with the same name in the map,
--- it is replaced.
--- js: NamedNodeMap.setNamedItemNS
export NamedNodeMapSetNamedItemNS: (Handle) ~[1]~> Result<Handle, JsError>
