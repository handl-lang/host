--- js target: browser
--- source: https://raw.githubusercontent.com/w3c/webref/19e2457df856a43ec749c0fd4e88ae1edc4f6cb8/ed/idl/dom.idl

from "js" import { JsError }
from "result" import { Result }

--- The DocumentFragment interface represents a minimal document object that has no parent.
export DocumentFragment := {
  --- The read-only children property returns a live HTMLCollection
  --- which contains all of the child elements of the document fragment upon which it was called.
  children: Handle,
  --- The DocumentFragment.firstElementChild read-only property
  --- returns the document fragment's first child Element, or null if there
  --- are no child elements.
  firstElementChild: Handle,
  --- The DocumentFragment.lastElementChild read-only property
  --- returns the document fragment's last child Element, or null if there
  --- are no child elements.
  lastElementChild: Handle,
  --- The DocumentFragment.childElementCount read-only property
  --- returns the number of child elements of a DocumentFragment.
  childElementCount: Nat
}

--- The DocumentFragment.append() method
--- inserts a set of Node objects or strings after
--- the last child of the document fragment. Strings
--- are inserted as equivalent Text nodes.
--- js: DocumentFragment.append
export DocumentFragmentAppend: (Handle) ~[1]~> Result<(), JsError>

--- The DocumentFragment() constructor returns a new, empty
--- DocumentFragment object.
--- js: DocumentFragment.constructor
export DocumentFragmentConstructor: () ~[1]~> Result<(), JsError>

--- The getElementById() method of the DocumentFragment returns an Element object representing the element whose id property matches the specified string. Since element IDs are required to be unique if specified, they're a useful way to get access to a specific element quickly.
--- js: DocumentFragment.getElementById
export DocumentFragmentGetElementById: (String) ~[1]~> Result<Handle, JsError>

--- The moveBefore() method of the DocumentFragment interface moves a given Node inside the invoking DocumentFragment as a direct child, before a given reference node.
--- js: DocumentFragment.moveBefore
export DocumentFragmentMoveBefore: (Handle, Handle) ~[1]~> Result<(), JsError>

--- The DocumentFragment.prepend() method
--- inserts a set of Node objects or strings before
--- the first child of the document fragment. Strings
--- are inserted as equivalent Text nodes.
--- js: DocumentFragment.prepend
export DocumentFragmentPrepend: (Handle) ~[1]~> Result<(), JsError>

--- The DocumentFragment.querySelector() method returns the
--- first element, or null if no matches are found, within the
--- DocumentFragment (using depth-first pre-order traversal of the
--- document's nodes) that matches the specified group of selectors.
--- js: DocumentFragment.querySelector
export DocumentFragmentQuerySelector: (String) ~[1]~> Result<Handle, JsError>

--- The DocumentFragment.querySelectorAll() method returns a
--- NodeList of elements within the DocumentFragment (using
--- depth-first pre-order traversal of the document's nodes) that matches the specified
--- group of selectors.
--- js: DocumentFragment.querySelectorAll
export DocumentFragmentQuerySelectorAll: (String) ~[1]~> Result<Handle, JsError>

--- The DocumentFragment.replaceChildren() method replaces the
--- existing children of a DocumentFragment with a specified new set of children. These
--- can be string or Node objects.
--- js: DocumentFragment.replaceChildren
export DocumentFragmentReplaceChildren: (Handle) ~[1]~> Result<(), JsError>
