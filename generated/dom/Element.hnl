--- The matches() method of the Element interface tests whether the element would be selected by the specified CSS selector.
--- js: Element.matches
export ElementMatches: (String) ~[1]~> Result<Bool, JsError>

--- The moveBefore() method of the Element interface moves a given Node inside the invoking node as a direct child, before a given reference node.
--- js: Element.moveBefore
export ElementMoveBefore: (Handle, Handle) ~[1]~> Result<(), JsError>

--- The Element.prepend() method inserts a set of
--- Node objects or strings before the first child
--- of the Element. Strings are inserted as
--- equivalent Text nodes.
--- js: Element.prepend
export ElementPrepend: (Handle) ~[1]~> Result<(), JsError>

--- The querySelector() method of the Element
--- interface returns the first element that is a descendant of the element on which it is
--- invoked that matches the specified group of selectors.
--- js: Element.querySelector
export ElementQuerySelector: (String) ~[1]~> Result<Handle, JsError>

--- The Element method querySelectorAll()
--- returns a static (not live) NodeList representing a list of elements
--- matching the specified group of selectors which are descendants of the element on which
--- the method was called.
--- js: Element.querySelectorAll
export ElementQuerySelectorAll: (String) ~[1]~> Result<Handle, JsError>

--- The Element.remove() method removes the element from its parent node.
--- If it has no parent node, calling remove() does nothing.
--- js: Element.remove
export ElementRemove: () ~[1]~> Result<(), JsError>

--- The Element method
--- removeAttribute() removes the attribute with the
--- specified name from the element.
--- js: Element.removeAttribute
export ElementRemoveAttribute: (String) ~[1]~> Result<(), JsError>

--- The removeAttributeNS() method of the
--- Element interface removes the specified attribute with the specified namespace from an element.
--- js: Element.removeAttributeNS
export ElementRemoveAttributeNS: (Handle, String) ~[1]~> Result<(), JsError>

--- The removeAttributeNode() method of the Element interface removes the specified Attr node from the element.
--- js: Element.removeAttributeNode
export ElementRemoveAttributeNode: (Handle) ~[1]~> Result<Handle, JsError>

--- The Element.replaceChildren() method replaces the
--- existing children of a Node with a specified new set of children. These
--- can be string or Node objects.
--- js: Element.replaceChildren
export ElementReplaceChildren: (Handle) ~[1]~> Result<(), JsError>

--- The Element.replaceWith() method replaces this
--- Element in the children list of its parent with a set of
--- Node objects or strings. Strings are inserted as equivalent Text nodes.
--- js: Element.replaceWith
export ElementReplaceWith: (Handle) ~[1]~> Result<(), JsError>

--- The setAttribute() method of the Element interface sets the value of an attribute on the specified element.
--- If the attribute already exists, the value is updated; otherwise a new attribute is added with the specified name and value.
--- js: Element.setAttribute
export ElementSetAttribute: (String, Handle) ~[1]~> Result<(), JsError>

--- The setAttributeNS() method of the Element interface adds a new attribute or changes the value of an attribute with the given namespace and name.
--- js: Element.setAttributeNS
export ElementSetAttributeNS: (Handle, String, Handle) ~[1]~> Result<(), JsError>

--- The setAttributeNode() method of the Element interface adds a new Attr node to the specified element.
--- js: Element.setAttributeNode
