--- Generated port for storage.Navigator
--- js target: browser
--- source: https://raw.githubusercontent.com/w3c/webref/19e2457df856a43ec749c0fd4e88ae1edc4f6cb8/ed/idl/storage.idl

from "js" import { JsError }
from "result" import { Result }

--- The Navigator interface represents the state and the identity of the user agent. It allows scripts to query it and to register themselves to carry on some activities.
export Navigator := {
  --- The read-only userActivation property of the Navigator interface returns a UserActivation object which contains information about the current window's user activation state.
  userActivation: Handle,
  --- constant "Mozilla"
  appCodeName: String,
  --- constant "Netscape"
  appName: String,
  --- The Navigator.appVersion read-only property of the Navigator interface returns a string representing version information about the browser.
  appVersion: String,
  --- The platform property read-only property of the Navigator interface returns a string identifying the platform on which the user's browser is running.
  platform: String,
  --- constant "Gecko"
  product: String,
  --- The Navigator.productSub read-only property that returns either the string "20030107", or the string "20100101".
  productSub: String,
  --- The Navigator.userAgent read-only property of the Navigator interface returns the User-Agent (UA) string for the current browser.
  userAgent: String,
  --- The value of the Navigator vendor property is always either "Google Inc.", "Apple Computer, Inc.", or (in Firefox) the empty string.
  vendor: String,
  --- constant ""
  vendorSub: String,
  --- The language read-only property of the Navigator interface returns a string representing the preferred language of the user, usually the language of the browser UI.
  language: String,
  --- The languages read-only property of the Navigator interface
  --- returns an array of strings representing the user's preferred
  --- languages. The language is described using a BCP 47 language tag. In the returned
  --- array they are ordered by preference with the most preferred language first.
  languages: Handle,
  --- The onLine property of the Navigator interface returns whether the device is connected to the network, with true meaning online and false meaning offline. The property's value changes after the browser checks its network connection, usually when the user follows links or when a script requests a remote page. For example, the property should return false when users click links soon after they lose internet connection. When its value changes, an online or offline event is fired on the window.
  onLine: Bool,
  --- navigator.cookieEnabled returns a Boolean value that indicates whether cookies are enabled or not.
  cookieEnabled: Bool,
  --- Returns a PluginArray object, listing the Plugin objects describing the plugins installed in the application.
  --- Named properties of the returned object are not enumerable (except in very old browser versions).
  plugins: Handle,
  --- Returns a MimeTypeArray object, which contains a list of MimeType objects representing the MIME types recognized and supported by the browser.
  --- The array can be queried for information about the enabled plugin that is used to handle a file of the specified type.
  --- Named properties of the returned object are not enumerable (except in very old browser versions).
  mimeTypes: Handle,
  --- The pdfViewerEnabled read-only property of the Navigator interface indicates whether the browser supports inline display of PDF files when navigating to them.
  pdfViewerEnabled: Bool,
  --- The navigator.hardwareConcurrency read-only property
  --- returns the number of logical processors available to run threads on the user's
  --- computer.
  hardwareConcurrency: Nat,
  --- The Navigator.storage
  --- read-only property returns the singleton StorageManager object used to
  --- access the overall storage capabilities of the browser for the current site or app.
  --- The returned object lets you examine and configure persistence of data stores and
  --- learn approximately how much more space your browser has available for local storage
  --- use.
  storage: Handle
}

--- This method always returns false.
--- js: Navigator.javaEnabled
export NavigatorJavaEnabled: () ~[1]~> Result<Bool, JsError>

--- The Navigator method registerProtocolHandler() lets websites register their ability to open or handle particular URL schemes (also known as protocols).
--- js: Navigator.registerProtocolHandler
export NavigatorRegisterProtocolHandler: (String, String) ~[1]~> Result<(), JsError>

--- The Navigator method unregisterProtocolHandler() removes a protocol handler for a given URL scheme.
--- js: Navigator.unregisterProtocolHandler
export NavigatorUnregisterProtocolHandler: (String, String) ~[1]~> Result<(), JsError>
