from "js" import { call, error }
from "result" import { ok, err }
from "../hr-time/Performance" import { Performance, PerformanceNow, PerformanceToJSON }

export performance_now: PerformanceNow := () ~> do {
  r = call("hr-time", "now", [], [], "js_object", false)
  e = error()
  if e == null {
    ok(r)
  } else {
    err(e)
  }
}

export performance_to_j_s_o_n: PerformanceToJSON := () ~> do {
  r = call("hr-time", "toJSON", [], [], "js_object", false)
  e = error()
  if e == null {
    ok(r)
  } else {
    err(e)
  }
}
