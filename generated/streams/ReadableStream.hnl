--- Generated port for streams.ReadableStream
--- js target: browser
--- source: https://raw.githubusercontent.com/w3c/webref/19e2457df856a43ec749c0fd4e88ae1edc4f6cb8/ed/idl/streams.idl

from "js" import { JsError }
from "result" import { Result }

--- The ReadableStream interface of the Streams API represents a readable stream of byte data. The Fetch API offers a concrete instance of a ReadableStream through the body property of a Response object.
export ReadableStream := {
  --- The locked read-only property of the ReadableStream interface returns whether or not the readable stream is locked to a reader.
  locked: Bool
}

--- The cancel() method of the ReadableStream interface returns a Promise that resolves when the stream is canceled.
--- js: ReadableStream.cancel
export ReadableStreamCancel: (Handle) ~[1]~> Result<Handle, JsError>

--- The ReadableStream() constructor creates and returns a readable stream object from the given handlers.
--- js: ReadableStream.constructor
export ReadableStreamConstructor: (Handle, Handle) ~[1]~> Result<(), JsError>

--- The ReadableStream.from() static method returns a ReadableStream from a provided iterable or async iterable object.
--- js: ReadableStream.from
export ReadableStreamFrom: (Handle) ~[1]~> Result<Handle, JsError>

--- The getReader() method of the ReadableStream interface creates a reader and locks the stream to it.
--- While the stream is locked, no other reader can be acquired until this one is released.
--- js: ReadableStream.getReader
export ReadableStreamGetReader: (Handle) ~[1]~> Result<Handle, JsError>

--- The pipeThrough() method of the ReadableStream interface provides a chainable way of piping the current stream through a transform stream or any other writable/readable pair.
--- js: ReadableStream.pipeThrough
export ReadableStreamPipeThrough: (Handle, Handle) ~[1]~> Result<Handle, JsError>

--- The pipeTo() method of the ReadableStream interface pipes the current ReadableStream to a given WritableStream and returns a Promise that fulfills when the piping process completes successfully, or rejects if any errors were encountered.
--- js: ReadableStream.pipeTo
export ReadableStreamPipeTo: (Handle, Handle) ~[1]~> Result<Handle, JsError>

--- The tee() method of the
--- ReadableStream interface tees the current readable stream, returning a
--- two-element array containing the two resulting branches as
--- new ReadableStream instances.
--- js: ReadableStream.tee
export ReadableStreamTee: () ~[1]~> Result<Handle, JsError>
