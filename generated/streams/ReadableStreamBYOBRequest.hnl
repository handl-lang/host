from "js" import { JsError }
from "result" import { Result }

--- The ReadableStreamBYOBRequest interface of the Streams API represents a "pull request" for data from an underlying source that will be made as a zero-copy transfer to a consumer (bypassing the stream's internal queues).
export ReadableStreamBYOBRequest := {
  --- The view getter property of the ReadableStreamBYOBRequest interface returns the current view.
  view: Handle
}

--- The respond() method of the ReadableStreamBYOBRequest interface is used to signal to the associated readable byte stream that the specified number of bytes were written into the ReadableStreamBYOBRequest.view.
--- js: ReadableStreamBYOBRequest.respond
export ReadableStreamBYOBRequestRespond: (Nat) ~[1]~> Result<(), JsError>

--- The respondWithNewView() method of the ReadableStreamBYOBRequest interface specifies a new view that the consumer of the associated readable byte stream should write to instead of ReadableStreamBYOBRequest.view.
--- js: ReadableStreamBYOBRequest.respondWithNewView
export ReadableStreamBYOBRequestRespondWithNewView: (Bytes) ~[1]~> Result<(), JsError>
