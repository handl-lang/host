--- Generated port for streams.streams
--- js target: browser

from "js" import { JsError }
from "result" import { Result }

--- The ByteLengthQueuingStrategy interface of the Streams API provides a built-in byte length queuing strategy that can be used when constructing streams.
export ByteLengthQueuingStrategy := {
  --- The read-only ByteLengthQueuingStrategy.highWaterMark property returns the total number of bytes that can be contained in the internal queue before backpressure is applied.
  highWaterMark: Float,
  --- The size() method of the
  --- ByteLengthQueuingStrategy interface returns the given chunk's
  --- byteLength property.
  size: Handle
}

--- The CountQueuingStrategy interface of the Streams API provides a built-in chunk counting queuing strategy that can be used when constructing streams.
export CountQueuingStrategy := {
  --- The read-only CountQueuingStrategy.highWaterMark property returns the total number of chunks that can be contained in the internal queue before backpressure is applied.
  highWaterMark: Float,
  --- The size() method of the
  --- CountQueuingStrategy interface always returns 1, so that the
  --- total queue size is a count of the number of chunks in the queue.
  size: Handle
}

export GenericTransformStream := {
  readable: Handle,
  writable: Handle
}

export QueuingStrategy := {
  highWaterMark: Float,
  size: Handle
}

export QueuingStrategyInit := {
  highWaterMark: Float
}

--- The ReadableByteStreamController interface of the Streams API represents a controller for a readable byte stream.
--- It allows control of the state and internal queue of a ReadableStream with an underlying byte source, and enables efficient zero-copy transfer of data from the underlying source to a consumer when the stream's internal queue is empty.
export ReadableByteStreamController := {
  --- The byobRequest read-only property of the ReadableByteStreamController interface returns the current BYOB request, or null if there are no pending requests.
  byobRequest: Handle,
  --- The desiredSize read-only property of the ReadableByteStreamController interface returns the number of bytes required to fill the stream's internal queue to its "desired size".
  desiredSize: Handle
}

--- The ReadableStream interface of the Streams API represents a readable stream of byte data. The Fetch API offers a concrete instance of a ReadableStream through the body property of a Response object.
export ReadableStream := {
  --- The locked read-only property of the ReadableStream interface returns whether or not the readable stream is locked to a reader.
  locked: Bool
}

--- The ReadableStreamBYOBReader interface of the Streams API defines a reader for a ReadableStream that supports zero-copy reading from an underlying byte source.
--- It is used for efficient copying from underlying sources where the data is delivered as an "anonymous" sequence of bytes, such as files.
export ReadableStreamBYOBReader := {
}

export ReadableStreamBYOBReaderReadOptions := {
  min: Nat
}

--- The ReadableStreamBYOBRequest interface of the Streams API represents a "pull request" for data from an underlying source that will be made as a zero-copy transfer to a consumer (bypassing the stream's internal queues).
export ReadableStreamBYOBRequest := {
  --- The view getter property of the ReadableStreamBYOBRequest interface returns the current view.
  view: Handle
}

--- The ReadableStreamDefaultController interface of the Streams API represents a controller allowing control of a ReadableStream's state and internal queue. Default controllers are for streams that are not byte streams.
export ReadableStreamDefaultController := {
  --- The desiredSize read-only property of the
  --- ReadableStreamDefaultController interface returns the desired size
  --- required to fill the stream's internal queue.
  desiredSize: Handle
}

--- The ReadableStreamDefaultReader interface of the Streams API represents a default reader that can be used to read stream data supplied from a network (such as a fetch request).
export ReadableStreamDefaultReader := {
}

export ReadableStreamGenericReader := {
  closed: Handle
}

export ReadableStreamGetReaderOptions := {
  mode: Handle
}

export ReadableStreamIteratorOptions := {
  preventCancel: Bool
}

export ReadableStreamReadResult := {
  value: Handle,
  done: Bool
}

export ReadableWritablePair := {
  readable: Handle,
  writable: Handle
}

export StreamPipeOptions := {
  preventClose: Bool,
  preventAbort: Bool,
  preventCancel: Bool,
  signal: Handle
}

--- The TransformStream interface of the Streams API represents a concrete implementation of the pipe chain transform stream concept.
export TransformStream := {
  --- The readable read-only property of the TransformStream interface returns the ReadableStream instance controlled by this TransformStream. This stream emits the transformed output data.
  readable: Handle,
  --- The writable read-only property of the TransformStream interface returns the WritableStream instance controlled by this TransformStream. This stream accepts input data that will be transformed and emitted to the readable stream.
  writable: Handle
}

--- The TransformStreamDefaultController interface of the Streams API provides methods to manipulate the associated ReadableStream and WritableStream.
export TransformStreamDefaultController := {
  --- The desiredSize read-only property of the TransformStreamDefaultController interface returns the desired size to fill the queue of the associated ReadableStream.
  desiredSize: Handle
}

export Transformer := {
  start: Handle,
  transform: Handle,
  flush: Handle,
  cancel: Handle,
  readableType: Handle,
  writableType: Handle
}

export UnderlyingSink := {
  start: Handle,
  write: Handle,
  close: Handle,
  abort: Handle,
  type: Handle
}

export UnderlyingSource := {
  start: Handle,
  pull: Handle,
  cancel: Handle,
  type: Handle,
  autoAllocateChunkSize: Nat
}

--- The WritableStream interface of the Streams API provides a standard abstraction for writing streaming data to a destination, known as a sink.
--- This object comes with built-in backpressure and queuing.
export WritableStream := {
  --- The locked read-only property of the WritableStream interface returns a boolean indicating whether the WritableStream is locked to a writer.
  locked: Bool
}

--- The WritableStreamDefaultController interface of the Streams API represents a controller allowing control of a WritableStream's state. When constructing a WritableStream, the underlying sink is given a corresponding WritableStreamDefaultController instance to manipulate.
export WritableStreamDefaultController := {
  --- The read-only signal property of the WritableStreamDefaultController interface returns the AbortSignal associated with the controller.
  signal: Handle
}

--- The WritableStreamDefaultWriter interface of the Streams API is the object returned by WritableStream.getWriter() and once created locks the writer to the WritableStream ensuring that no other streams can write to the underlying sink.
export WritableStreamDefaultWriter := {
  --- The closed read-only property of the
  --- WritableStreamDefaultWriter interface returns a
  --- Promise that fulfills if the stream becomes closed, or rejects if
  --- the stream errors or the writer's lock is released.
  closed: Handle,
  --- The desiredSize read-only property of the
  --- WritableStreamDefaultWriter interface returns the desired size required
  --- to fill the stream's internal queue.
  desiredSize: Handle,
  --- The ready read-only property of the
  --- WritableStreamDefaultWriter interface returns a Promise
  --- that resolves when the desired size of the stream's internal queue transitions from
  --- non-positive to positive, signaling that it is no longer applying backpressure.
  ready: Handle
}

export ReadableStreamController := Handle

export ReadableStreamReader := Handle

