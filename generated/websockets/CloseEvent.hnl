--- Generated port for websockets.CloseEvent
--- js target: browser
--- source: https://raw.githubusercontent.com/w3c/webref/19e2457df856a43ec749c0fd4e88ae1edc4f6cb8/ed/idl/websockets.idl

from "js" import { JsError }
from "result" import { Result }

--- A CloseEvent is sent to clients using WebSockets when the connection is closed. This is delivered to the listener indicated by the WebSocket object's onclose attribute.
export CloseEvent := {
  --- The wasClean read-only property of the CloseEvent interface returns true if the connection closed cleanly.
  wasClean: Bool,
  --- The code read-only property of the CloseEvent interface returns a WebSocket connection close code indicating the reason the connection was closed.
  code: Nat,
  --- The reason read-only property of the CloseEvent interface returns the WebSocket connection close reason the server gave for closing the connection; that is, a concise human-readable prose explanation for the closure.
  reason: String
}

--- The CloseEvent() constructor creates a new CloseEvent object.
--- js: CloseEvent.constructor
export CloseEventConstructor: (String, Handle) ~[1]~> Result<(), JsError>
