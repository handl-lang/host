--- The arrayBuffer() method of the Response interface
--- takes a Response stream and reads it to completion. It returns a promise
--- that resolves with an ArrayBuffer.
--- js: Body.arrayBuffer
export BodyArrayBuffer: () ~[1]~> Result<Handle, JsError>

--- The blob() method of the Response interface takes
--- a Response stream and reads it to completion. It returns a promise that
--- resolves with a Blob.
--- js: Body.blob
export BodyBlob: () ~[1]~> Result<Handle, JsError>

--- js: Body.bytes
export BodyBytes: () ~[1]~> Result<Handle, JsError>

--- The formData() method of the Response interface
--- takes a Response stream and reads it to completion. It returns a promise
--- that resolves with a FormData object.
--- js: Body.formData
export BodyFormData: () ~[1]~> Result<Handle, JsError>

--- The json() method of the Response interface takes
--- a Response stream and reads it to completion. It returns a promise which
--- resolves with the result of parsing the body text as JSON.
--- js: Body.json
export BodyJson: () ~[1]~> Result<Handle, JsError>

--- The text() method of the Response interface takes a Response stream and reads it to completion.
--- It returns a promise that resolves with a String.
--- The response is always decoded using UTF-8.
--- js: Body.text
export BodyText: () ~[1]~> Result<Handle, JsError>

--- js: Body.textStream
export BodyTextStream: () ~[1]~> Result<Handle, JsError>

--- The append() method of the Headers
--- interface appends a new value onto an existing header inside a Headers
--- object, or adds the header if it does not already exist.
--- js: Headers.append
export HeadersAppend: (String, String) ~[1]~> Result<(), JsError>

--- The Headers() constructor creates a new
--- Headers object.
--- js: Headers.constructor
export HeadersConstructor: (Handle) ~[1]~> Result<(), JsError>

--- The delete() method of the Headers
--- interface deletes a header from the current Headers object.
--- js: Headers.delete
export HeadersDelete: (String) ~[1]~> Result<(), JsError>

--- The get() method of the Headers interface
--- returns a byte string of all the values of a header within a Headers object
--- with a given name. If the requested header doesn't exist in the Headers
--- object, it returns null.
--- js: Headers.get
export HeadersGet: (String) ~[1]~> Result<Handle, JsError>

--- The getSetCookie() method of the Headers interface returns an array containing the values of all Set-Cookie headers associated with a response. This allows Headers objects to handle having multiple Set-Cookie headers, which wasn't possible prior to its implementation.
--- js: Headers.getSetCookie
export HeadersGetSetCookie: () ~[1]~> Result<Handle, JsError>

--- The has() method of the Headers interface
--- returns a boolean stating whether a Headers object contains a certain
--- header.
--- js: Headers.has
export HeadersHas: (String) ~[1]~> Result<Bool, JsError>

--- The set() method of the Headers interface
--- sets a new value for an existing header inside a Headers object, or adds
--- the header if it does not already exist.
--- js: Headers.set
export HeadersSet: (String, String) ~[1]~> Result<(), JsError>

--- The clone() method of the Request interface creates a copy of the current Request object.
--- js: Request.clone
export RequestClone: () ~[1]~> Result<Handle, JsError>

--- The Request() constructor creates a new
--- Request object.
--- js: Request.constructor
export RequestConstructor: (Handle, Handle) ~[1]~> Result<(), JsError>

--- The clone() method of the Response interface creates a clone of a response object, identical in every way, but stored in a different variable.
--- js: Response.clone
export ResponseClone: () ~[1]~> Result<Handle, JsError>

--- The Response() constructor creates a new Response object.
--- js: Response.constructor
export ResponseConstructor: (Handle, Handle) ~[1]~> Result<(), JsError>

--- The error() static method of the Response interface returns a new Response object associated with a network error.
--- js: Response.error
export ResponseError: () ~[1]~> Result<Handle, JsError>

--- The json() method of the Response interface takes
--- a Response stream and reads it to completion. It returns a promise which
--- resolves with the result of parsing the body text as JSON.
--- js: Response.json
export ResponseJson: (Handle, Handle) ~[1]~> Result<Handle, JsError>

--- The redirect() static method of the Response interface returns a Response resulting in a redirect to the specified URL.
--- js: Response.redirect
export ResponseRedirect: (String, Nat) ~[1]~> Result<Handle, JsError>

--- The fetchLater() method of the Window interface creates a deferred fetch.
--- js: Window.fetchLater
export WindowFetchLater: (Handle, Handle) ~[1]~> Result<Handle, JsError>

