--- The RequestInit dictionary of the Fetch API represents the set of options that can be used to configure a fetch request.
export RequestInit := {
  method: String,
  headers: Handle,
  body: Handle,
  referrer: String,
  referrerPolicy: Handle,
  mode: Handle,
  credentials: Handle,
  cache: Handle,
  redirect: Handle,
  integrity: String,
  keepalive: Bool,
  signal: Handle,
  duplex: Handle,
  priority: Handle,
  --- can only be set to null
  window: Handle
}
