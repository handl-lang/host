--- Generated adapter for fileapi-webidl-browser/FileList
--- source: https://raw.githubusercontent.com/w3c/webref/19e2457df856a43ec749c0fd4e88ae1edc4f6cb8/ed/idl/FileAPI.idl

from "js" import { call, error }
from "result" import { ok, err }
from "../fileapi/FileList" import { FileList, FileListItem }

export file_list_item: FileListItem := (index) ~> do {
  r = call("FileAPI", "item", [index], ["js_number"], "js_object", false)
  e = error()
  if e == null {
    ok(r)
  } else {
    err(e)
  }
}
