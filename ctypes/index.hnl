--- ctypes — transparent aliases for the C type vocabulary used by
--- generated SDK ports.
--- @details
--- These aliases keep a generated port's signature faithful to the C
--- header: `Setsockopt: (Fd, Int, Int, Bytes, Socklen)` reads like
--- `setsockopt(2)`. They are transparent — the typechecker sees through
--- to `Nat`/`Int`, so they document intent rather than enforce ranges.
--- Real ABI width is enforced by the adapter's marshal descriptors
--- (`u32`, `i64`, `usize`, ...) at the call boundary.

from "../type" import { Int, Nat }

-- Fixed-width integers (stdint.h). Same width on every target.
export Uint8 := Nat
export Uint16 := Nat
export Uint32 := Nat
export Uint64 := Nat
export Int8 := Int
export Int16 := Int
export Int32 := Int
export Int64 := Int

-- POSIX typedefs. Pointer-width or fixed on all supported targets;
-- genuinely platform-variable C types (long, off_t on 32-bit) stay
-- lowered to Int/Nat in generated ports instead.
export Size := Nat
export SSize := Int
export Off := Int
export Time := Int
export ClockId := Int
export Pid := Int
export Uid := Nat
export Gid := Nat
export Mode := Nat
export Fd := Int

-- Socket API typedefs (sys/socket.h, netinet/in.h).
export Socklen := Nat
export SaFamily := Nat
export InAddr := Nat
export InPort := Nat
